import Mathlib.GroupTheory.Coxeter.Length
import Mathlib.Algebra.Group.Submonoid.Membership

/-!
# A positivity criterion for representations of Coxeter groups

Let `(W, S)` be a Coxeter system with Coxeter matrix `M`, acting additively on `V`, and let
`(αᵢ)_{i ∈ B}` be a family of vectors of `V` ("simple roots"). Write `C` for the additive monoid
generated by the `αᵢ` (the "positive cone"). Suppose that the rank two parabolic subgroups
behave as they should: for `i ≠ j` and every alternating word `u = ⋯ sᵢ sⱼ` of length
`k < mᵢⱼ` ending with `sⱼ`, `u αᵢ` is a nonnegative integral combination of `αᵢ` and `αⱼ`. Then
for all `w ∈ W` and `i ∈ B`,

  `ℓ(w sᵢ) > ℓ(w) → w αᵢ ∈ C`.

This is the key step in the proof that the geometric representation of a Coxeter group is
faithful ([Hum] Thm. 5.4, [Bou] Ch. V §4.4). The proof, by induction on `ℓ(w)`, only uses the
rank two hypothesis, so it applies verbatim to the Weyl group of a Kac–Moody algebra acting on
`𝔥*` (see `LieLean.LinearAlgebra.Matrix.Cartan.WeylGroupCoxeter`). If moreover `sᵢ αᵢ = -αᵢ`,
the cone `C` is pointed and `αᵢ ≠ 0`, one deduces that `ℓ(w sᵢ) < ℓ(w) ↔ -w αᵢ ∈ C` and that an
element of `W` fixing all `αᵢ` is trivial; in particular, the action is faithful.

## Main definitions

* `CoxeterSystem.IsDihedrallyPositive`: the rank two positivity hypothesis.

## Main results

* `CoxeterSystem.smul_mem_closure_of_not_isRightDescent`: if `ℓ(w sᵢ) > ℓ(w)` then `w αᵢ ∈ C`.
* `CoxeterSystem.isRightDescent_iff_neg_smul_mem_closure`: `ℓ(w sᵢ) < ℓ(w) ↔ -(w αᵢ) ∈ C`.
* `CoxeterSystem.eq_one_of_forall_smul_eq`: an element fixing all `αᵢ` is `1`.

## References

* [Hum] J. E. Humphreys, *Reflection groups and Coxeter groups*, CUP 1990, §5.4, Thm. 5.4.
* [Bou] N. Bourbaki, *Lie groups and Lie algebras*, Ch. IV–VI, Ch. V §4.4.
-/

open List

namespace CoxeterSystem

variable {B W V : Type*} [Group W] {M : CoxeterMatrix B} (cs : CoxeterSystem M W)

local prefix:100 "s " => cs.simple
local prefix:100 "π " => cs.wordProd
local prefix:100 "ℓ " => cs.length

section AddCommMonoid

variable [AddCommMonoid V] [DistribMulAction W V] (α : B → V)

/-- The rank two hypothesis of `CoxeterSystem.smul_mem_closure_of_not_isRightDescent`: for
`i ≠ j`, every alternating word `u` ending with `sⱼ` of length `k < mᵢⱼ` maps `αᵢ` to a
nonnegative integral combination of `αᵢ` and `αⱼ` ([Hum] §5.4). -/
def IsDihedrallyPositive : Prop :=
  ∀ i j, i ≠ j → ∀ k, (M i j = 0 ∨ k < M i j) →
    π (alternatingWord i j k) • α i ∈ AddSubmonoid.closure {α i, α j}

variable {cs α}

/-- One step of the proof of `smul_mem_closure_of_not_isRightDescent`: in a factorization
`w = v · u`, with `u` alternating in `sᵢ, sⱼ` and lengths adding up, a right descent `c ∈ {i, j}`
of `v` can be moved into `u`, giving a factorization with a shorter `v`. -/
private lemma exists_shorter_factorization {w v : W} {i j c : B} {k : ℕ} (hij : i ≠ j)
    (hc : c = i ∨ c = j) (hk0 : 0 < k) (hwv : w = v * π (alternatingWord i j k))
    (hlen : ℓ w = ℓ v + k) (hvc : cs.IsRightDescent v c) :
    ∃ v' k', w = v' * π (alternatingWord i j k') ∧ ℓ w = ℓ v' + k' ∧ ℓ v' < ℓ v := by
  rw [isRightDescent_iff] at hvc
  by_cases hd : (if Even k then j else i) = c
  · refine ⟨v * s c, k + 1, ?_, by omega, by omega⟩
    rw [alternatingWord_succ', hd, wordProd_cons, mul_assoc, simple_mul_simple_cancel_left, hwv]
  · exfalso
    obtain ⟨k, rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
    have hd' : (if Even k then j else i) = c := by
      rcases hc with rfl | rfl <;> by_cases hk : Even k <;>
        simp_all [Nat.even_add_one, hij.symm]
    have h1 : w = v * s c * π (alternatingWord i j k) := by
      rw [hwv, alternatingWord_succ', hd', wordProd_cons, mul_assoc]
    have h2 := cs.length_mul_le (v * s c) (π (alternatingWord i j k))
    have h3 := cs.length_wordProd_le (alternatingWord i j k)
    rw [length_alternatingWord, ← h1] at *
    omega

/-- **Positivity** ([Hum] Thm. 5.4, [Bou] Ch. V §4.4 Lemma 1): if the rank two parabolic
subgroups act positively (`CoxeterSystem.IsDihedrallyPositive`), then `ℓ(w sᵢ) > ℓ(w)` implies
that `w αᵢ` lies in the additive monoid generated by the `αⱼ`.

The proof follows [Hum] §5.4: choose a factorization `w = v · u` with `u` alternating in `sᵢ` and
a right descent `sⱼ` of `w`, `ℓ(w) = ℓ(v) + ℓ(u)`, and `ℓ(v)` minimal; then `v` has neither `sᵢ`
nor `sⱼ` as a right descent, `u` is shorter than `mᵢⱼ` and ends with `sⱼ`, and one concludes by
induction applied to `v`. -/
theorem smul_mem_closure_of_not_isRightDescent (hα : cs.IsDihedrallyPositive α) {w : W} {i : B}
    (hw : ¬cs.IsRightDescent w i) : w • α i ∈ AddSubmonoid.closure (Set.range α) := by
  classical
  generalize hn : ℓ w = n
  induction n using Nat.strong_induction_on generalizing w i with
  | _ n ih =>
  by_cases hw1 : w = 1
  · rw [hw1, one_smul]
    exact AddSubmonoid.subset_closure ⟨i, rfl⟩
  obtain ⟨j, hj⟩ := cs.exists_rightDescent_of_ne_one hw1
  have hij : i ≠ j := by rintro rfl; exact hw hj
  -- factorizations `w = v · u` with `u` alternating, ending in `sⱼ`
  let Q : ℕ → Prop := fun m ↦
    ∃ v k, w = v * π (alternatingWord i j k) ∧ ℓ w = ℓ v + k ∧ ℓ v = m
  have hQ : Q (ℓ (w * s j)) := by
    refine ⟨w * s j, 1, ?_, ?_, rfl⟩
    · simp [alternatingWord]
    · rw [isRightDescent_iff] at hj; omega
  obtain ⟨v, k, hwv, hlen, hv⟩ := Nat.find_spec ⟨_, hQ⟩
  have hmin : ∀ m < Nat.find ⟨_, hQ⟩, ¬Q m := fun m hm ↦ Nat.find_min ⟨_, hQ⟩ hm
  have hle : Nat.find ⟨_, hQ⟩ ≤ ℓ (w * s j) := Nat.find_min' ⟨_, hQ⟩ hQ
  have hjw : ℓ (w * s j) < ℓ w := hj
  rw [← hv] at hmin hle
  -- `v` has no right descent in `{sᵢ, sⱼ}`
  have hvdesc : ∀ c, c = i ∨ c = j → ¬cs.IsRightDescent v c := by
    intro c hc hvc
    obtain ⟨v', k', h1, h2, h3⟩ := exists_shorter_factorization hij hc (by omega) hwv hlen hvc
    exact hmin _ h3 ⟨v', k', h1, h2, rfl⟩
  -- `u` is shorter than `mᵢⱼ`
  have hk : M i j = 0 ∨ k < M i j := by
    by_contra! h
    obtain ⟨hM, hk⟩ := h
    have hred := cs.not_isReduced_alternatingWord j i (by rwa [M.symmetric])
      (m := k + 1) (by rw [M.symmetric]; omega)
    have h1 : ℓ (π (alternatingWord j i (k + 1))) < k + 1 := by
      have := cs.length_wordProd_le (alternatingWord j i (k + 1))
      rw [length_alternatingWord] at this
      unfold IsReduced at hred
      rw [length_alternatingWord] at hred
      omega
    have h2 : w * s i = v * π (alternatingWord j i (k + 1)) := by
      rw [alternatingWord_succ, wordProd_concat, hwv, mul_assoc]
    have h3 := cs.length_mul_le v (π (alternatingWord j i (k + 1)))
    rw [← h2] at h3
    rw [not_isRightDescent_iff] at hw
    omega
  -- conclude by induction
  have hvi := ih (ℓ v) (by omega) (hvdesc i (Or.inl rfl)) rfl
  have hvj := ih (ℓ v) (by omega) (hvdesc j (Or.inr rfl)) rfl
  obtain ⟨a, b, hab⟩ := (AddSubmonoid.mem_closure_pair _ _ _).mp (hα i j hij k hk)
  rw [hwv, mul_smul, ← hab, smul_add, smul_comm, smul_comm v b]
  exact add_mem (AddSubmonoid.nsmul_mem _ hvi a) (AddSubmonoid.nsmul_mem _ hvj b)

end AddCommMonoid

section AddCommGroup

variable [AddCommGroup V] [DistribMulAction W V] {α : B → V}

/-- If `ℓ(w sᵢ) < ℓ(w)` then `-w αᵢ` lies in the additive monoid generated by the `αⱼ`
([Hum] Thm. 5.4). -/
theorem neg_smul_mem_closure_of_isRightDescent (hα : cs.IsDihedrallyPositive α)
    (hneg : ∀ i, s i • α i = -α i) {w : W} {i : B} (hw : cs.IsRightDescent w i) :
    -(w • α i) ∈ AddSubmonoid.closure (Set.range α) := by
  rw [isRightDescent_iff_not_isRightDescent_mul] at hw
  have := cs.smul_mem_closure_of_not_isRightDescent hα hw
  rwa [mul_smul, hneg, smul_neg] at this

/-- Under the hypotheses of `CoxeterSystem.smul_mem_closure_of_not_isRightDescent`, if moreover
`sᵢ αᵢ = -αᵢ`, the cone generated by the `αᵢ` is pointed and `αᵢ ≠ 0`, then `sᵢ` is a right
descent of `w` if and only if `-w αᵢ` is positive ([Hum] Thm. 5.4). -/
theorem isRightDescent_iff_neg_smul_mem_closure (hα : cs.IsDihedrallyPositive α)
    (hneg : ∀ i, s i • α i = -α i)
    (hpt : ∀ v ∈ AddSubmonoid.closure (Set.range α), -v ∈ AddSubmonoid.closure (Set.range α) →
      v = 0)
    (hne : ∀ i, α i ≠ 0) {w : W} {i : B} :
    cs.IsRightDescent w i ↔ -(w • α i) ∈ AddSubmonoid.closure (Set.range α) := by
  refine ⟨cs.neg_smul_mem_closure_of_isRightDescent hα hneg, fun h ↦ ?_⟩
  by_contra hw
  have h0 := hpt _ (cs.smul_mem_closure_of_not_isRightDescent hα hw) h
  exact hne i ((smul_eq_zero_iff_eq w).mp (by simpa using h0))

/-- Under the hypotheses of `CoxeterSystem.isRightDescent_iff_neg_smul_mem_closure`, an element
of `W` fixing every `αᵢ` is trivial; in particular, `W` acts faithfully on `V` ([Hum] Cor. 5.4).
-/
theorem eq_one_of_forall_smul_eq (hα : cs.IsDihedrallyPositive α)
    (hneg : ∀ i, s i • α i = -α i)
    (hpt : ∀ v ∈ AddSubmonoid.closure (Set.range α), -v ∈ AddSubmonoid.closure (Set.range α) →
      v = 0)
    (hne : ∀ i, α i ≠ 0) {w : W} (hw : ∀ i, w • α i = α i) : w = 1 := by
  by_contra hw1
  obtain ⟨i, hi⟩ := cs.exists_rightDescent_of_ne_one hw1
  have h := cs.neg_smul_mem_closure_of_isRightDescent hα hneg hi
  rw [hw] at h
  exact hne i (hpt _ (AddSubmonoid.subset_closure ⟨i, rfl⟩) h)

end AddCommGroup

end CoxeterSystem

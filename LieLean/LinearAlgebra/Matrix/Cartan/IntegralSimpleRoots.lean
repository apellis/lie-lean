import LieLean.LinearAlgebra.Matrix.Cartan.IntegralWeylGroupAntidominant
import LieLean.LinearAlgebra.Matrix.Cartan.WeylGroupForm

/-!
# Simple integral roots

Let `A` be a Cartan matrix of finite type with a realization over a field `K` of characteristic
zero, and let `x` be a weight with `⟨x, β^∨⟩ ∈ ℤ_{<0}` for every positive root `β` integral for
`x` (for instance `x = λ + ρ` with `λ` antidominant and regular). The positive roots integral for
`x` form the positive system of the integral root system `Φ_[λ]` (Humphreys, GSM 94, §3.4); a
positive integral root `γ` is called *simple* here if the reflection `s_γ` maps every other
positive integral root to a positive root.

## Main results

* `Matrix.Realization.mul_le_three_of_ne`: for distinct positive real roots `β`, `γ`,
  `⟨γ, β^∨⟩ ⟨β, γ^∨⟩ ≤ 3`, and the two pairings have the same sign (Cauchy–Schwarz for the
  invariant form, plus the fact that `2β` is never a root).
* `Matrix.Realization.exists_isPosRoot_reflectionOf_mul`: every `y ≠ 1` in `W_[λ]` maps a simple
  integral root to a negative root. This is the step of the standard argument that `W_[λ]` is
  generated by its simple reflections used in Humphreys, GSM 94, §7.16. The proof is our own: a
  root `γ` with `y γ < 0` minimizing `-⟨x, γ^∨⟩` is simple, since otherwise `γ^∨` decomposes as a
  sum of two positive integral coroots, one of which is again made negative by `y`.

## References

* J. E. Humphreys, *Representations of semisimple Lie algebras in the BGG category 𝒪*, GSM 94,
  AMS 2008, §3.4, §7.16.
-/

noncomputable section

open Module CoxeterSystem

namespace Matrix

/-- Cauchy–Schwarz for a positive definite symmetric integer matrix, with the equality case. -/
lemma PosDef.dotProduct_mulVec_sq_le {ι : Type*} [Fintype ι] {M : Matrix ι ι ℤ} (hM : M.PosDef)
    (hs : M.IsSymm) (b c : ι → ℤ) :
    (b ⬝ᵥ M *ᵥ c) ^ 2 ≤ (b ⬝ᵥ M *ᵥ b) * (c ⬝ᵥ M *ᵥ c) ∧
      ((b ⬝ᵥ M *ᵥ c) ^ 2 = (b ⬝ᵥ M *ᵥ b) * (c ⬝ᵥ M *ᵥ c) →
        (b ⬝ᵥ M *ᵥ b) • c = (b ⬝ᵥ M *ᵥ c) • b) := by
  have hcb : c ⬝ᵥ M *ᵥ b = b ⬝ᵥ M *ᵥ c := by
    rw [dotProduct_mulVec, dotProduct_comm, ← mulVec_transpose, hs.eq]
  set p := b ⬝ᵥ M *ᵥ b
  set m := b ⬝ᵥ M *ᵥ c
  set q := c ⬝ᵥ M *ᵥ c
  set e := p • c - m • b with he
  have hee : e ⬝ᵥ M *ᵥ e = p * (p * q - m ^ 2) := by
    simp only [he, mulVec_sub, mulVec_smul, sub_dotProduct, dotProduct_sub, smul_dotProduct,
      dotProduct_smul, smul_eq_mul, hcb]
    ring
  have hnn : ∀ f : ι → ℤ, 0 ≤ f ⬝ᵥ M *ᵥ f := fun f ↦ by
    by_cases hf : f = 0
    · simp [hf]
    · simpa using (hM.dotProduct_mulVec_pos hf).le
  by_cases hb : b = 0
  · simp [p, m, hb]
  have hp : 0 < p := by simpa using hM.dotProduct_mulVec_pos hb
  have h1 : 0 ≤ p * q - m ^ 2 := by
    have := hnn e
    rw [hee] at this
    exact nonneg_of_mul_nonneg_right (by linarith) hp
  refine ⟨by linarith, fun h ↦ ?_⟩
  have h0 : e ⬝ᵥ M *ᵥ e = 0 := by rw [hee, h, sub_self, mul_zero]
  have he0 : e = 0 := by
    by_contra hne
    have := hM.dotProduct_mulVec_pos hne
    simp only [star_trivial] at this
    omega
  exact sub_eq_zero.mp he0

end Matrix

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [CharZero K] [AddCommGroup H]
  [Module K H] {A : Matrix ι ι ℤ} {P : Realization A K H} (hF : A.IsFiniteCartan)

omit [DecidableEq ι] in
/-- Every real root lies in the image of the root lattice. -/
lemma exists_apply_root_eq_rootOf {hA : A.IsGeneralizedCartan} (v : P.weylGroup hA) (i : ι) :
    ∃ b : ι → ℤ, (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) = P.rootOf b := by
  rcases P.apply_root_nonneg_or_nonpos hA v.2 i with ⟨k, -, h⟩ | ⟨k, -, h⟩
  · exact ⟨k, h⟩
  · exact ⟨-k, by rw [h, map_neg]⟩

omit [DecidableEq ι] in
/-- Twice a real root is not a real root. -/
lemma apply_root_ne_two_smul {hA : A.IsGeneralizedCartan} (v u : P.weylGroup hA) (i j : ι) :
    (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) ≠
      (2 : K) • (u : Dual K H ≃ₗ[K] Dual K H) (P.root j) := by
  classical
  intro h
  obtain ⟨e, he⟩ := exists_apply_root_eq_rootOf (v⁻¹ * u) j
  have h' : P.root i = (2 : K) • (((v⁻¹ * u : P.weylGroup hA) : Dual K H ≃ₗ[K] Dual K H)
      (P.root j)) := by
    have := congrArg (((v⁻¹ : P.weylGroup hA) : Dual K H ≃ₗ[K] Dual K H)) h
    rw [inv_apply_apply, map_smul] at this
    rw [this, Subgroup.coe_mul, LinearEquiv.mul_apply]
  rw [he, two_smul, ← map_add, ← P.rootOf_single] at h'
  have := congrFun (P.rootOf_injective h') i
  simp at this
  omega

omit [DecidableEq ι] [CharZero K] in
/-- `⟨β, β^∨⟩ = 2` for a real root `β`. -/
lemma corootPairing_apply_root_self {hA : A.IsGeneralizedCartan} (v : P.weylGroup hA) (i : ι) :
    P.corootPairing hA ((v : Dual K H ≃ₗ[K] Dual K H) (P.root i)) v i = 2 := by
  rw [corootPairing, inv_apply_apply, P.root_coroot_self hA]

variable [FiniteDimensional K H]

include hF in
/-- **Rank-two bound.** For distinct positive real roots `β = v αᵢ`, `γ = u αⱼ`, the integers
`k = ⟨γ, β^∨⟩` and `l = ⟨β, γ^∨⟩` satisfy `k l ≤ 3`, and `l > 0` when `k > 0`. -/
lemma mul_le_three_of_ne {hA : A.IsGeneralizedCartan} {v u : P.weylGroup hA} {i j : ι}
    (hv : P.IsPosRoot hA v i) (hu : P.IsPosRoot hA u j)
    (hne : (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) ≠ (u : Dual K H ≃ₗ[K] Dual K H) (P.root j))
    {k l : ℤ} (hk : P.corootPairing hA ((u : Dual K H ≃ₗ[K] Dual K H) (P.root j)) v i = k)
    (hl : P.corootPairing hA ((v : Dual K H ≃ₗ[K] Dual K H) (P.root i)) u j = l) :
    k * l ≤ 3 ∧ (0 < k → 0 < l) := by
  obtain ⟨d, hdpos, hpos⟩ := hF.exists_posDef
  have hsymm : (diagonal d * A).IsSymm := by
    simpa [IsHermitian, IsSymm] using hpos.isHermitian
  set S := Symmetrization.ofDiagonal d hdpos hsymm
  set B := P.dualBilinForm S
  set M := diagonal d * A
  have hQ (b c : ι → ℤ) : B (P.rootOf b) (P.rootOf c) = ((b ⬝ᵥ M *ᵥ c : ℤ) : K) := by
    rw [P.dualBilinForm_ofDiagonal_rootOf d hdpos hsymm]
    simp_rw [rootOf_apply_coroot]
    push_cast
    simp only [M, dotProduct, ← mulVec_mulVec, mulVec_diagonal]
    push_cast
    exact Finset.sum_congr rfl fun t _ ↦ by ring
  have hform (w : P.weylGroup hA) (t : ι) (y : Dual K H) :
      B y ((w : Dual K H ≃ₗ[K] Dual K H) (P.root t)) = P.corootPairing hA y w t * d t := by
    rw [← P.dualBilinForm_weylGroup hA S (w⁻¹).2, inv_apply_apply, dualBilinForm_root_right]
    simp only [S, Symmetrization.ofDiagonal]
    push_cast
    have ht : (d t : K) ≠ 0 := by exact_mod_cast (hdpos t).ne'
    rw [corootPairing]
    field_simp
    rfl
  obtain ⟨b, hb0, hb⟩ := hv
  obtain ⟨c, hc0, hc⟩ := hu
  have hbb : b ⬝ᵥ M *ᵥ b = 2 * d i := by
    have h := hform v i ((v : Dual K H ≃ₗ[K] Dual K H) (P.root i))
    rw [corootPairing_apply_root_self, hb, hQ] at h
    exact_mod_cast h
  have hcc : c ⬝ᵥ M *ᵥ c = 2 * d j := by
    have h := hform u j ((u : Dual K H ≃ₗ[K] Dual K H) (P.root j))
    rw [corootPairing_apply_root_self, hc, hQ] at h
    exact_mod_cast h
  have hcb : c ⬝ᵥ M *ᵥ b = k * d i := by
    have h := hform v i ((u : Dual K H ≃ₗ[K] Dual K H) (P.root j))
    rw [hk, hb, hc, hQ] at h
    exact_mod_cast h
  have hbc : b ⬝ᵥ M *ᵥ c = l * d j := by
    have h := hform u j ((v : Dual K H ≃ₗ[K] Dual K H) (P.root i))
    rw [hl, hb, hc, hQ] at h
    exact_mod_cast h
  have hsym : c ⬝ᵥ M *ᵥ b = b ⬝ᵥ M *ᵥ c := by
    rw [dotProduct_mulVec, dotProduct_comm, ← mulVec_transpose, hsymm.eq]
  have hkl : k * d i = l * d j := by rw [← hcb, ← hbc, hsym]
  have hdi := hdpos i
  have hdj := hdpos j
  obtain ⟨hcs, heq⟩ := hpos.dotProduct_mulVec_sq_le hsymm b c
  rw [hbb, hcc, hbc] at hcs heq
  have hle : k * l ≤ 4 := by
    have h4 : (k * l) * (d i * d j) ≤ 4 * (d i * d j) := by
      have : (l * d j) ^ 2 = (k * l) * (d i * d j) := by
        rw [sq]; nth_rewrite 1 [← hkl]; ring
      linarith
    exact le_of_mul_le_mul_right h4 (mul_pos hdi hdj)
  refine ⟨?_, fun hk0 ↦ ?_⟩
  swap
  · by_contra hl0
    have : k * d i ≤ 0 := by rw [hkl]; nlinarith
    nlinarith
  by_contra h3
  have h4 : k * l = 4 := by omega
  have hsq : (l * d j) ^ 2 = 2 * d i * (2 * d j) := by
    have : (l * d j) ^ 2 = (k * l) * (d i * d j) := by
      rw [sq]; nth_rewrite 1 [← hkl]; ring
    rw [this, h4]; ring
  have hvec := heq hsq
  -- `b ≠ 0`
  obtain ⟨t, ht⟩ : ∃ t, b t ≠ 0 := by
    by_contra hall
    have : b = 0 := funext fun s ↦ not_not.mp fun h ↦ hall ⟨s, h⟩
    rw [this, map_zero] at hb
    exact P.linearIndependent_root.ne_zero i ((LinearEquiv.map_eq_zero_iff _).mp hb)
  have hbt : 0 < b t := lt_of_le_of_ne (hb0 t) (Ne.symm ht)
  have hct := congrFun hvec t
  simp only [Pi.smul_apply, smul_eq_mul] at hct
  have hlpos : 0 < l := by
    by_contra hl0
    have hl0 : l < 0 := lt_of_le_of_ne (not_lt.mp hl0) (by rintro rfl; simp at h4)
    have h1 : l * (d j * b t) < 0 := mul_neg_of_neg_of_pos hl0 (mul_pos hdj hbt)
    have h2 : 0 ≤ 2 * d i * c t := mul_nonneg (by positivity) (hc0 t)
    nlinarith
  have hkpos : 0 < k := by
    by_contra hk0
    have hk0 := not_lt.mp hk0
    nlinarith
  have hk4 : k ≤ 4 := by nlinarith
  interval_cases k
  · -- `k = 1`, `l = 4`: `β = 2 γ`
    have hl4 : l = 4 := by omega
    subst hl4
    have hbc2 : b = 2 • c := funext fun s ↦ by
      have := congrFun hvec s
      simp only [Pi.smul_apply, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat] at this ⊢
      rw [show d i = 4 * d j by linarith] at this
      exact mul_left_cancel₀ (by positivity : 4 * d j ≠ 0) (by linarith)
    refine apply_root_ne_two_smul (K := K) v u i j ?_
    rw [hb, hc, hbc2, two_smul, map_add, two_smul]
  · -- `k = 2`, `l = 2`: `β = γ`
    have hl2 : l = 2 := by omega
    subst hl2
    have hdd : d i = d j := by linarith
    have hbc2 : c = b := funext fun s ↦ by
      have := congrFun hvec s
      simp only [Pi.smul_apply, smul_eq_mul] at this
      rw [hdd] at this
      exact mul_left_cancel₀ (by positivity) this
    exact hne (by rw [hb, hc, hbc2])
  · omega
  · -- `k = 4`, `l = 1`: `γ = 2 β`
    have hl1 : l = 1 := by omega
    subst hl1
    have hcb2 : c = 2 • b := funext fun s ↦ by
      have := congrFun hvec s
      simp only [Pi.smul_apply, smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat] at this ⊢
      rw [show d j = 4 * d i by linarith] at this
      exact mul_left_cancel₀ (by positivity : 2 * d i ≠ 0) (by linarith)
    refine apply_root_ne_two_smul (K := K) u v j i ?_
    rw [hb, hc, hcb2, two_smul, map_add, two_smul]

omit [DecidableEq ι] [CharZero K] [FiniteDimensional K H] in
/-- `(s_γ β)^∨ = β^∨ - ⟨γ, β^∨⟩ γ^∨`, evaluated at a weight `y`. -/
lemma corootPairing_reflectionOf_mul {hA : A.IsGeneralizedCartan} (y : Dual K H)
    (u v : P.weylGroup hA) (j i : ι) :
    P.corootPairing hA y (P.reflectionOf hA u j * v) i = P.corootPairing hA y v i -
      P.corootPairing hA ((u : Dual K H ≃ₗ[K] Dual K H) (P.root j)) v i *
        P.corootPairing hA y u j := by
  have hinv : (P.reflectionOf hA u j)⁻¹ = P.reflectionOf hA u j :=
    inv_eq_of_mul_eq_one_right (reflectionOf_mul_self u j)
  have h := corootPairing_apply (P.reflectionOf hA u j) v y i
  rw [hinv, reflectionOf_apply', corootPairing_sub, corootPairing_smul] at h
  rw [← h]
  ring

omit [DecidableEq ι] [CharZero K] [FiniteDimensional K H] in
/-- `s_γ β = β - ⟨β, γ^∨⟩ γ`. -/
lemma reflectionOf_mul_apply_root {hA : A.IsGeneralizedCartan} (u v : P.weylGroup hA)
    (j i : ι) :
    ((P.reflectionOf hA u j * v : P.weylGroup hA) : Dual K H ≃ₗ[K] Dual K H) (P.root i) =
      (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) -
        P.corootPairing hA ((v : Dual K H ≃ₗ[K] Dual K H) (P.root i)) u j •
          (u : Dual K H ≃ₗ[K] Dual K H) (P.root j) := by
  rw [Subgroup.coe_mul, LinearEquiv.mul_apply, reflectionOf_apply']

omit [DecidableEq ι] [FiniteDimensional K H] in
/-- If `⟨x, β^∨⟩ ∈ ℤ_{<0}` for the positive integral roots, then an integral root is positive
iff its pairing with `x` is negative, and this pairing is never zero. -/
lemma isPosRoot_iff_of_isIntegralRoot {hA : A.IsGeneralizedCartan} {x : Dual K H}
    (hx : ∀ v i, P.IsPosRoot hA v i → ∀ n : ℤ, P.corootPairing hA x v i = n → n < 0)
    {v : P.weylGroup hA} {i : ι} {n : ℤ} (hn : P.corootPairing hA x v i = n) :
    (P.IsPosRoot hA v i ↔ n < 0) ∧ n ≠ 0 := by
  classical
  have hneg : ¬P.IsPosRoot hA v i → 0 < n := fun hv ↦ by
    have h := hx _ i ((isPosRoot_or v i).resolve_left hv) (-n)
      (by rw [corootPairing_mul_simple, hn, Int.cast_neg])
    omega
  refine ⟨⟨fun hv ↦ hx v i hv n hn, fun h ↦ by_contra fun hv ↦ by have := hneg hv; omega⟩, ?_⟩
  by_cases hv : P.IsPosRoot hA v i
  · exact (hx v i hv n hn).ne
  · exact (hneg hv).ne'

include hF in
/-- **A minimal root is simple.** Let `⟨x, β^∨⟩ ∈ ℤ_{<0}` for the positive integral roots, let
`z` be a weight for which every root integral for `x` is integral, and let `γ` be a positive
integral root with `⟨z, γ^∨⟩ > 0` minimizing `-⟨x, γ^∨⟩` among such roots. Then `s_γ` maps every
other positive integral root to a positive root. -/
theorem isPosRoot_reflectionOf_mul_of_minimal {hA : A.IsGeneralizedCartan} {x z : Dual K H}
    (hx : ∀ v i, P.IsPosRoot hA v i → ∀ n : ℤ, P.corootPairing hA x v i = n → n < 0)
    (hz : ∀ v i, P.IsIntegralRoot hA x v i → P.IsIntegralRoot hA z v i)
    {u : P.weylGroup hA} {j : ι} (hu : P.IsPosRoot hA u j) (hux : P.IsIntegralRoot hA x u j)
    {n : ℕ} (hn : P.corootPairing hA x u j = -n) {p : ℤ} (hp : P.corootPairing hA z u j = p)
    (hp0 : 0 < p)
    (hmin : ∀ v i, P.IsPosRoot hA v i → P.IsIntegralRoot hA x v i → ∀ q : ℤ,
      P.corootPairing hA z v i = q → 0 < q → ∀ m : ℕ, P.corootPairing hA x v i = -m → n ≤ m)
    {v : P.weylGroup hA} {i : ι} (hv : P.IsPosRoot hA v i) (hvx : P.IsIntegralRoot hA x v i)
    (hne : (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) ≠ (u : Dual K H ≃ₗ[K] Dual K H) (P.root j)) :
    P.IsPosRoot hA (P.reflectionOf hA u j * v) i := by
  have hcast : ∀ a : ℤ, a ≤ 0 → (a : K) = -(((-a).toNat : ℕ) : K) := fun a ha ↦ by
    rw [← Int.cast_natCast, Int.toNat_of_nonneg (by omega : 0 ≤ -a), Int.cast_neg, neg_neg]
  have hrootQ : ∀ (w : P.weylGroup hA) t, P.IsPosRoot hA w t →
      (w : Dual K H ≃ₗ[K] Dual K H) (P.root t) ∈ P.rootLattice :=
    fun w t ⟨c, _, hc⟩ ↦ hc ▸ P.rootOf_mem_rootLattice c
  have hval : ∀ (w : P.weylGroup hA) (t : ι), P.IsIntegralRoot hA x w t →
      ∃ a : ℤ, P.corootPairing hA x w t = a := fun w t h ↦ h
  have hmulS : ∀ (w : P.weylGroup hA) t, P.IsIntegralRoot hA x w t →
      P.IsIntegralRoot hA x (w * (P.coxeterSystem hA).simple t) t := fun w t ⟨a, ha⟩ ↦
    ⟨-a, by
      change P.corootPairing hA x w t = a at ha
      change P.corootPairing hA x _ t = _
      rw [corootPairing_mul_simple, ha, Int.cast_neg]⟩
  have hrefl : ∀ (w : P.weylGroup hA) t, P.IsIntegralRoot hA x w t →
      ∀ (w' : P.weylGroup hA) t', P.IsIntegralRoot hA x w' t' →
        P.IsIntegralRoot hA x (P.reflectionOf hA w t * w') t' := fun w t h w' t' h' ↦
    P.isIntegralRoot_mul hA ((P.reflectionOf_mem_integralWeylGroup_iff hA w t).mpr h) h'
  have hn1 : 1 ≤ n := by
    have := hx u j hu (-n) (by rw [hn]; push_cast; rfl)
    omega
  -- the decomposition step
  have hdec : ∀ (a : P.weylGroup hA) (ta : ι) (b : P.weylGroup hA) (tb : ι),
      P.IsPosRoot hA a ta → P.IsIntegralRoot hA x a ta →
      P.IsPosRoot hA b tb → P.IsIntegralRoot hA x b tb →
      (∀ y, P.corootPairing hA y a ta + P.corootPairing hA y b tb = P.corootPairing hA y u j) →
        False := by
    intro a ta b tb ha hax hb hbx hsum
    obtain ⟨fa, hfa⟩ := hax
    obtain ⟨fb, hfb⟩ := hbx
    change P.corootPairing hA x a ta = fa at hfa
    change P.corootPairing hA x b tb = fb at hfb
    obtain ⟨ga, hga⟩ := hz a ta ⟨fa, hfa⟩
    obtain ⟨gb, hgb⟩ := hz b tb ⟨fb, hfb⟩
    change P.corootPairing hA z a ta = ga at hga
    change P.corootPairing hA z b tb = gb at hgb
    have hfa0 := hx a ta ha fa hfa
    have hfb0 := hx b tb hb fb hfb
    have hf : fa + fb = -(n : ℤ) := by
      have := hsum x
      rw [hfa, hfb, hn] at this
      exact_mod_cast this
    have hg : ga + gb = p := by
      have := hsum z
      rw [hga, hgb, hp] at this
      exact_mod_cast this
    rcases lt_or_ge 0 ga with hga0 | hga0
    · have := hmin a ta ha ⟨fa, hfa⟩ ga hga hga0 (-fa).toNat
        (by rw [hfa]; exact hcast fa (by omega))
      omega
    · have := hmin b tb hb ⟨fb, hfb⟩ gb hgb (by omega) (-fb).toNat
        (by rw [hfb]; exact hcast fb (by omega))
      omega
  -- induction on `-⟨x, β^∨⟩`
  obtain ⟨m₀, hm₀⟩ := hvx
  change P.corootPairing hA x v i = m₀ at hm₀
  have hm₀' : P.corootPairing hA x v i = -((-m₀).toNat : ℕ) := by
    have := hx v i hv m₀ hm₀
    rw [hm₀]; exact hcast m₀ (by omega)
  clear hm₀
  generalize (-m₀).toNat = m at hm₀'
  have hvx : P.IsIntegralRoot hA x v i :=
    ⟨-m, by change P.corootPairing hA x v i = _; rw [hm₀', Int.cast_neg, Int.cast_natCast]⟩
  induction m using Nat.strong_induction_on generalizing v i with
  | _ m ih =>
  set s := P.reflectionOf hA u j with hs
  by_contra hneg
  obtain ⟨k, hk⟩ := P.exists_int_corootPairing_of_mem_rootLattice (hA := hA)
    (hrootQ u j hu) v i
  have hsv (y : Dual K H) : P.corootPairing hA y (s * v) i =
      P.corootPairing hA y v i - k * P.corootPairing hA y u j := by
    rw [hs, corootPairing_reflectionOf_mul, hk]
  have hsvx : P.IsIntegralRoot hA x (s * v) i := hrefl u j hux v i hvx
  have hm1 : 1 ≤ m := by
    have := hx v i hv (-m) (by rw [hm₀']; push_cast; rfl)
    omega
  -- `s_γ β < 0` forces `k n > m`
  have hkm : (m : ℤ) < k * n := by
    have h := isPosRoot_iff_of_isIntegralRoot hx (n := -m + k * n)
      (by rw [hsv, hm₀', hn]; push_cast; ring)
    have := h.2
    have := mt h.1.mpr hneg
    omega
  have hk1 : 1 ≤ k := by
    by_contra hk1
    have : k * n ≤ 0 := mul_nonpos_of_nonpos_of_nonneg (by omega) (by positivity)
    omega
  -- `b' = -s_γ β` is positive
  set b' := s * v * (P.coxeterSystem hA).simple i with hb'
  have hb'pos : P.IsPosRoot hA b' i := (isPosRoot_or (s * v) i).resolve_left hneg
  have hb'x : P.IsIntegralRoot hA x b' i := hmulS _ i hsvx
  have hb'y (y : Dual K H) : P.corootPairing hA y b' i =
      -(P.corootPairing hA y v i - k * P.corootPairing hA y u j) := by
    rw [hb', corootPairing_mul_simple, hsv]
  rcases eq_or_lt_of_le hk1 with hk1 | hk2
  · -- `k = 1`: `γ^∨ = β^∨ + b'^∨`
    refine hdec v i b' i hv hvx hb'pos hb'x fun y ↦ ?_
    rw [hb'y, ← hk1]
    push_cast
    ring
  -- `k ≥ 2`: then `l = ⟨β, γ^∨⟩ = 1`
  obtain ⟨l, hl⟩ := P.exists_int_corootPairing_of_mem_rootLattice (hA := hA)
    (hrootQ v i hv) u j
  obtain ⟨hkl, hlpos⟩ := mul_le_three_of_ne hF hv hu hne hk hl
  have hl1 : l = 1 := by
    have := hlpos (by omega)
    nlinarith
  subst hl1
  set t := P.reflectionOf hA v i with ht
  set δ := t * u with hδ
  have hδy (y : Dual K H) : P.corootPairing hA y δ j =
      P.corootPairing hA y u j - P.corootPairing hA y v i := by
    rw [hδ, ht, corootPairing_reflectionOf_mul, hl]
    push_cast
    ring
  have hδx : P.IsIntegralRoot hA x δ j := hrefl v i hvx u j hux
  have hfδ : P.corootPairing hA x δ j = ((m : ℤ) - n : ℤ) := by
    rw [hδy, hn, hm₀']; push_cast; ring
  obtain ⟨hδpos, hδ0⟩ := isPosRoot_iff_of_isIntegralRoot hx hfδ
  rcases lt_or_gt_of_ne (show (m : ℤ) ≠ n by omega) with hmn | hmn
  · -- `m < n`: `γ^∨ = β^∨ + δ^∨`
    refine hdec v i δ j hv hvx (hδpos.mpr (by omega)) hδx fun y ↦ ?_
    rw [hδy]
    ring
  -- `m > n`: `β₁ = -δ` is positive with `-⟨x, β₁^∨⟩ = m - n < m`
  set β₁ := δ * (P.coxeterSystem hA).simple j with hβ₁
  have hβ₁pos : P.IsPosRoot hA β₁ j :=
    (isPosRoot_or δ j).resolve_left fun h ↦ by have := hδpos.mp h; omega
  have hβ₁x : P.IsIntegralRoot hA x β₁ j := hmulS _ j hδx
  have hβ₁y (y : Dual K H) : P.corootPairing hA y β₁ j =
      P.corootPairing hA y v i - P.corootPairing hA y u j := by
    rw [hβ₁, corootPairing_mul_simple, hδy]
    ring
  have hβ₁m : P.corootPairing hA x β₁ j = -((m - n : ℕ) : K) := by
    rw [hβ₁y, hm₀', hn, Nat.cast_sub (by omega)]
    ring
  -- `β₁ ≠ γ`, since otherwise `k l = 4`
  have hβ₁ne : (β₁ : Dual K H ≃ₗ[K] Dual K H) (P.root j) ≠
      (u : Dual K H ≃ₗ[K] Dual K H) (P.root j) := by
    intro heq
    have h := congrArg (fun w ↦ P.corootPairing hA w u j) heq
    rw [hβ₁, mul_simple_apply_root, hδ, ht, reflectionOf_mul_apply_root, corootPairing_neg,
      corootPairing_sub, corootPairing_smul, corootPairing_apply_root_self, hk, hl] at h
    have : ((k : ℤ) : K) = 4 := by linear_combination h
    have : k = 4 := by exact_mod_cast this
    omega
  have hsβ₁ := ih (m - n) (by omega) hβ₁pos hβ₁ne hβ₁m hβ₁x
  -- `ε = s_γ β₁` and `b'` decompose `γ^∨`
  have hk₁ : P.corootPairing hA ((u : Dual K H ≃ₗ[K] Dual K H) (P.root j)) β₁ j = k - 2 := by
    rw [hβ₁y, corootPairing_apply_root_self, hk]
  refine hdec (s * β₁) j b' i hsβ₁ (hrefl u j hux β₁ j hβ₁x) hb'pos hb'x fun y ↦ ?_
  rw [hs, corootPairing_reflectionOf_mul, hk₁, hβ₁y, hb'y]
  ring

include hF in
/-- **Simple integral roots.** Let `⟨x, β^∨⟩ ∈ ℤ_{<0}` for every positive root `β` integral
for `x`, and let `1 ≠ y ∈ W_[x]`. Then some positive integral root `γ` is made negative by `y`
and `s_γ` permutes the other positive integral roots: `γ` is a simple root of the integral root
system `Φ_[x]` (Humphreys, GSM 94, §3.4) whose reflection shortens `y`. -/
theorem exists_isPosRoot_reflectionOf_mul {hA : A.IsGeneralizedCartan} {x : Dual K H}
    (hx : ∀ v i, P.IsPosRoot hA v i → ∀ n : ℤ, P.corootPairing hA x v i = n → n < 0)
    {y : P.weylGroup hA} (hy : y ∈ P.integralWeylGroup hA x) (hy1 : y ≠ 1) :
    ∃ (u : P.weylGroup hA) (j : ι), P.IsPosRoot hA u j ∧ P.IsIntegralRoot hA x u j ∧
      ¬P.IsPosRoot hA (y * u) j ∧ ∀ v i, P.IsPosRoot hA v i → P.IsIntegralRoot hA x v i →
        (v : Dual K H ≃ₗ[K] Dual K H) (P.root i) ≠ (u : Dual K H ≃ₗ[K] Dual K H) (P.root j) →
          P.IsPosRoot hA (P.reflectionOf hA u j * v) i := by
  classical
  set z := ((y⁻¹ : P.weylGroup hA) : Dual K H ≃ₗ[K] Dual K H) x with hzdef
  have hzy (v : P.weylGroup hA) (i : ι) :
      P.corootPairing hA z v i = P.corootPairing hA x (y * v) i := by
    rw [hzdef, corootPairing_apply, inv_inv]
  have hyint : ∀ v i, P.IsIntegralRoot hA x v i → P.IsIntegralRoot hA x (y * v) i :=
    fun v i h ↦ P.isIntegralRoot_mul hA hy h
  have hz : ∀ v i, P.IsIntegralRoot hA x v i → P.IsIntegralRoot hA z v i := fun v i h ↦ by
    obtain ⟨a, ha⟩ := hyint v i h
    exact ⟨a, by change P.corootPairing hA z v i = a; rw [hzy]; exact ha⟩
  -- a positive integral root is made negative by `y` iff it pairs positively with `z`
  have hneg_iff : ∀ v i, P.IsIntegralRoot hA x v i → ∀ q : ℤ, P.corootPairing hA z v i = q →
      (¬P.IsPosRoot hA (y * v) i ↔ 0 < q) := fun v i h q hq ↦ by
    rw [hzy] at hq
    obtain ⟨h1, h2⟩ := isPosRoot_iff_of_isIntegralRoot hx hq
    rw [h1]
    omega
  have hcast : ∀ a : ℤ, a ≤ 0 → (a : K) = -(((-a).toNat : ℕ) : K) := fun a ha ↦ by
    rw [← Int.cast_natCast, Int.toNat_of_nonneg (by omega : 0 ≤ -a), Int.cast_neg, neg_neg]
  have hex : ∃ n : ℕ, ∃ (v : P.weylGroup hA) (i : ι), P.IsPosRoot hA v i ∧
      P.IsIntegralRoot hA x v i ∧ ¬P.IsPosRoot hA (y * v) i ∧ P.corootPairing hA x v i = -n := by
    by_contra hcon
    refine hy1 (eq_one_of_forall_isPosRoot_integral hF hy fun v i hv hvx ↦ by_contra fun hyv ↦ ?_)
    obtain ⟨a, ha⟩ := hvx
    change P.corootPairing hA x v i = a at ha
    exact hcon ⟨(-a).toNat, v, i, hv, ⟨a, ha⟩, hyv, by
      rw [ha]; exact hcast a (hx v i hv a ha).le⟩
  obtain ⟨u, j, hu, hux, hyu, hn⟩ := Nat.find_spec hex
  obtain ⟨p, hp⟩ := hz u j hux
  change P.corootPairing hA z u j = p at hp
  refine ⟨u, j, hu, hux, hyu, fun v i hv hvx hne ↦
    isPosRoot_reflectionOf_mul_of_minimal hF hx hz hu hux hn hp
      ((hneg_iff u j hux p hp).mp hyu) ?_ hv hvx hne⟩
  intro w t hw hwx q hq hq0 m hm
  exact Nat.find_min' hex ⟨w, t, hw, hwx, (hneg_iff w t hwx q hq).mpr hq0, hm⟩

end Matrix.Realization

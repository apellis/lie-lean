import LieLean.LinearAlgebra.Matrix.Cartan.AffineWeylGroup

/-!
# The integral Weyl group is generated by reflections

Let `A` be a Cartan matrix of finite type with a realization over a field `K` of characteristic
zero. For every weight `λ ∈ 𝔥*` the integral Weyl group `W_[λ] = {w ∈ W | wλ - λ ∈ Q}` is
generated by the reflections `s_β` in the roots `β` with `⟨λ, β^∨⟩ ∈ ℤ` (Humphreys,
*Representations of semisimple Lie algebras in the BGG category 𝒪*, GSM 94, Thm. 3.4 (b)).

## Proof

The case of rational weights over `ℚ` is
`Matrix.Realization.integralWeylGroup_eq_integralReflectionGroup_of_rat` (via the affine Weyl
group `W ⋉ Q`). For a weight `λ` over `K`, only the finitely many pairings `⟨λ, β^∨⟩` matter.
Choose a `ℚ`-linear map `Ψ : K → ℚ` with `Ψ 1 = 1` such that `Ψ(a) ∉ ℤ` whenever `a ∉ ℤ`, for
these finitely many `a` (`exists_rat_linearMap_of_finset`). Transport `λ` to the weight `λ'` of
the realization `Matrix.Realization.ratRealization` of `A` over `ℚ` with
`⟨λ', αⱼ^∨⟩ = Ψ ⟨λ, αⱼ^∨⟩`. The Weyl groups over `K` and over `ℚ` are identified with the Coxeter
group of `A`, compatibly with the transport (`Matrix.Realization.transport_apply`), so `W_[λ]`
maps into `W_[λ']`, and the roots integral for `λ'` are integral for `λ`. Humphreys reduces to
real weights by separating real and imaginary parts over `ℂ`; the reduction through `Ψ` is our
own.

## Main results

* `Matrix.Realization.ratRealization`: a realization over `ℚ` of a finite-type Cartan matrix.
* `Matrix.Realization.weylGroupEquiv`: the Weyl groups of two realizations (characteristic zero)
  are isomorphic, compatibly with the simple reflections.
* `Matrix.Realization.integralWeylGroup_eq_integralReflectionGroup`: Humphreys, GSM 94,
  Thm. 3.4 (b).

## References

* J. E. Humphreys, *Representations of semisimple Lie algebras in the BGG category 𝒪*, GSM 94,
  AMS 2008, §3.4.
-/

noncomputable section

open Module CoxeterSystem Filter Topology

/-- For a field `K` of characteristic zero and a finite set `S ⊆ K`, there is a `ℚ`-linear map
`Ψ : K → ℚ` with `Ψ 1 = 1` such that `Ψ a ∈ ℤ` implies `a ∈ ℤ` for all `a ∈ S`. -/
theorem exists_rat_linearMap_of_finset {K : Type*} [Field K] [CharZero K] (S : Finset K) :
    ∃ Ψ : K →ₗ[ℚ] ℚ, Ψ 1 = 1 ∧ ∀ a ∈ S, (∃ z : ℤ, Ψ a = z) → ∃ z : ℤ, a = z := by
  classical
  induction S using Finset.induction_on with
  | empty =>
    obtain ⟨Ψ, hΨ⟩ := Projective.exists_dual_eq_one ℚ (one_ne_zero (α := K))
    exact ⟨Ψ, hΨ, by simp⟩
  | insert b S hb ih =>
    obtain ⟨Ψ, hΨ1, hΨ⟩ := ih
    by_cases hgood : (∃ z : ℤ, Ψ b = z) → ∃ z : ℤ, b = z
    · refine ⟨Ψ, hΨ1, fun a ha ↦ ?_⟩
      rcases Finset.mem_insert.mp ha with rfl | ha
      · exact hgood
      · exact hΨ a ha
    push Not at hgood
    obtain ⟨⟨z₀, hz₀⟩, hbz⟩ := hgood
    -- a functional `g` with `g 1 = 0` and `g b ≠ 0`
    have hne : b - Ψ b • (1 : K) ≠ 0 := by
      intro h
      apply hbz z₀
      rw [sub_eq_zero, hz₀] at h
      rw [h]
      simp
    obtain ⟨φ, hφ⟩ := Projective.exists_dual_eq_one ℚ hne
    set g : K →ₗ[ℚ] ℚ := φ - φ 1 • Ψ with hg
    have hg1 : g 1 = 0 := by simp [hg, hΨ1]
    have hgb : g b ≠ 0 := by
      have : g b = φ (b - Ψ b • (1 : K)) := by
        simp only [hg, map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply,
          smul_eq_mul]
        ring
      rw [this, hφ]
      exact one_ne_zero
    have hev : ∀ᶠ ε in 𝓝[>] (0 : ℚ), (¬∃ z : ℤ, Ψ b + ε * g b = z) ∧
        ∀ a ∈ S, (¬∃ z : ℤ, a = z) → ¬∃ z : ℤ, Ψ a + ε * g a = z := by
      refine (Rat.eventually_not_exists_int_add_mul (Or.inr hgb)).and ?_
      rw [eventually_all_finset]
      intro a ha
      by_cases haz : ∃ z : ℤ, a = z
      · exact Eventually.of_forall fun _ h ↦ absurd haz h
      · filter_upwards [Rat.eventually_not_exists_int_add_mul
          (Or.inl fun h ↦ haz (hΨ a ha h)) (b := g a)] with ε hε using fun _ ↦ hε
    obtain ⟨ε, ⟨hεb, hεS⟩, -⟩ := (hev.and self_mem_nhdsWithin).exists
    refine ⟨Ψ + ε • g, by simp [hΨ1, hg1], fun a ha hΨa ↦ ?_⟩
    simp only [LinearMap.add_apply, LinearMap.smul_apply, smul_eq_mul] at hΨa
    rcases Finset.mem_insert.mp ha with rfl | ha
    · exact absurd hΨa hεb
    · by_contra haz
      exact hεS a ha haz hΨa

namespace Matrix.Realization

lemma transport_ext {ι : Type*} [Finite ι] [DecidableEq ι] {f g : Dual ℚ (ι → ℚ)}
    (h : ∀ j, f (Pi.single j 1) = g (Pi.single j 1)) : f = g :=
  (Pi.basisFun ℚ ι).ext fun j ↦ by simpa using h j

variable {ι : Type*} [Fintype ι] [DecidableEq ι] {A : Matrix ι ι ℤ}

/-! ### A realization over `ℚ` -/

/-- The realization of a Cartan matrix of finite type over `ℚ` on `𝔥 = ℚ^ι`, with the standard
basis as simple coroots and `⟨αⱼ, h⟩ = ∑ᵢ aᵢⱼ hᵢ`. -/
def ratRealization (hF : A.IsFiniteCartan) : Realization A ℚ (ι → ℚ) where
  coroot i := Pi.single i 1
  root j := ∑ i, (A i j : ℚ) • LinearMap.proj i
  linearIndependent_coroot := by
    convert (Pi.basisFun ℚ ι).linearIndependent using 1
    funext i
    simp
  linearIndependent_root := by
    rw [Fintype.linearIndependent_iff]
    intro c hc
    have hdet : (A.map (Int.cast : ℤ → ℚ)).det ≠ 0 :=
      ((Matrix.isUnit_iff_isUnit_det _).mp (hF.isUnit_map ℚ)).ne_zero
    have hmul : A.map (Int.cast : ℤ → ℚ) *ᵥ c = 0 := by
      ext i
      have := LinearMap.congr_fun hc (Pi.single i 1)
      simpa [mulVec, dotProduct, Finset.sum_apply, Pi.single_apply, mul_comm] using this
    exact congrFun (Matrix.eq_zero_of_mulVec_eq_zero hdet hmul)
  root_coroot i j := by simp [Pi.single_apply]
  finrank_add_rank := by
    rw [Module.finrank_fintype_fun_eq_card, rank_of_isUnit _ (hF.isUnit_map ℚ)]
    ring

@[simp] lemma ratRealization_coroot (hF : A.IsFiniteCartan) (i : ι) :
    (ratRealization hF).coroot i = Pi.single i 1 := rfl

@[simp] lemma ratRealization_root_single (hF : A.IsFiniteCartan) (i j : ι) :
    (ratRealization hF).root i (Pi.single j 1) = A j i :=
  (ratRealization hF).root_coroot j i

/-! ### Comparing Weyl groups -/

variable {K H K' H' : Type*} [Field K] [CharZero K] [AddCommGroup H] [Module K H]
  [Field K'] [CharZero K'] [AddCommGroup H'] [Module K' H']
  (P : Realization A K H) (Q : Realization A K' H') (hA : A.IsGeneralizedCartan)

/-- The Weyl groups of two realizations of `A` over fields of characteristic zero are
isomorphic, both being identified with the Coxeter group of `A`
(`Matrix.Realization.coxeterSystem`). -/
def weylGroupEquiv : P.weylGroup hA ≃* Q.weylGroup hA :=
  (P.coxeterSystem hA).mulEquiv.trans (Q.coxeterSystem hA).mulEquiv.symm

@[simp] lemma weylGroupEquiv_simple (i : ι) :
    weylGroupEquiv P Q hA ((P.coxeterSystem hA).simple i) = (Q.coxeterSystem hA).simple i := by
  simp only [weylGroupEquiv, MulEquiv.trans_apply, CoxeterSystem.simple]
  exact congrArg _ (MulEquiv.apply_symm_apply _ _)

lemma weylGroupEquiv_wordProd (ω : List ι) :
    weylGroupEquiv P Q hA ((P.coxeterSystem hA).wordProd ω) = (Q.coxeterSystem hA).wordProd ω := by
  induction ω with
  | nil => simp
  | cons i ω ih => rw [wordProd_cons, map_mul, ih, weylGroupEquiv_simple, wordProd_cons]

lemma weylGroupEquiv_reflectionOf (v : P.weylGroup hA) (i : ι) :
    weylGroupEquiv P Q hA (P.reflectionOf hA v i) =
      Q.reflectionOf hA (weylGroupEquiv P Q hA v) i := by
  have hP : (⟨P.reflection hA i, P.reflection_mem_weylGroup hA i⟩ : P.weylGroup hA) =
      (P.coxeterSystem hA).simple i := Subtype.ext (coxeterSystem_simple P hA i).symm
  have hQ : (⟨Q.reflection hA i, Q.reflection_mem_weylGroup hA i⟩ : Q.weylGroup hA) =
      (Q.coxeterSystem hA).simple i := Subtype.ext (coxeterSystem_simple Q hA i).symm
  simp only [reflectionOf, map_mul, map_inv, hP, hQ, weylGroupEquiv_simple]

/-! ### Transport of weights to `ℚ` -/

variable {P} (hF : A.IsFiniteCartan) (Ψ : K →ₗ[ℚ] ℚ)

/-- The weight of `ratRealization hF` with `⟨λ', αⱼ^∨⟩ = Ψ ⟨λ, αⱼ^∨⟩`. -/
def transport (μ : Dual K H) : Dual ℚ (ι → ℚ) :=
  ∑ j, Ψ (μ (P.coroot j)) • LinearMap.proj j

lemma transport_apply_single (μ : Dual K H) (j : ι) :
    transport (P := P) Ψ μ (Pi.single j 1) = Ψ (μ (P.coroot j)) := by
  simp [transport, Pi.single_apply]

omit [DecidableEq ι] in
lemma transport_sub (μ ν : Dual K H) :
    transport (P := P) Ψ (μ - ν) = transport (P := P) Ψ μ - transport (P := P) Ψ ν := by
  classical
  exact transport_ext fun j ↦ by simp [transport_apply_single]

omit [DecidableEq ι] in
lemma map_intCast_mul (n : ℤ) (a : K) : Ψ ((n : K) * a) = n * Ψ a := by
  rw [← zsmul_eq_mul, map_zsmul, zsmul_eq_mul]

lemma transport_rootOf (hΨ : Ψ 1 = 1) (k : ι → ℤ) :
    transport (P := P) Ψ (P.rootOf k) = (ratRealization hF).rootOf k := by
  have hint : ∀ n : ℤ, Ψ (n : K) = n := fun n ↦ by
    simpa [hΨ] using map_intCast_mul Ψ n 1
  refine transport_ext fun j ↦ ?_
  rw [transport_apply_single, rootOf_apply_coroot, hint, ← ratRealization_coroot hF,
    rootOf_apply_coroot]

lemma transport_reflection (i : ι) (μ : Dual K H) :
    transport (P := P) Ψ (P.reflection hA i μ) =
      (ratRealization hF).reflection hA i (transport (P := P) Ψ μ) := by
  refine transport_ext fun j ↦ ?_
  simp only [transport_apply_single, reflection_apply, LinearMap.sub_apply, LinearMap.smul_apply,
    smul_eq_mul, root_coroot, ratRealization_root_single, ratRealization_coroot, map_sub]
  rw [mul_comm, map_intCast_mul, mul_comm]

/-- The transport intertwines the actions of `W` and of its copy over `ℚ`. -/
lemma transport_apply (w : P.weylGroup hA) (μ : Dual K H) :
    transport (P := P) Ψ ((w : Dual K H ≃ₗ[K] Dual K H) μ) =
      (weylGroupEquiv P (ratRealization hF) hA w : Dual ℚ (ι → ℚ) ≃ₗ[ℚ] Dual ℚ (ι → ℚ))
        (transport (P := P) Ψ μ) := by
  obtain ⟨ω, rfl⟩ := (P.coxeterSystem hA).wordProd_surjective w
  rw [weylGroupEquiv_wordProd]
  induction ω generalizing μ with
  | nil => simp
  | cons i ω ih =>
    rw [wordProd_cons, wordProd_cons, Subgroup.coe_mul, Subgroup.coe_mul, LinearEquiv.mul_apply,
      LinearEquiv.mul_apply, coxeterSystem_simple, coxeterSystem_simple, transport_reflection hA hF
      Ψ, ih]

/-- A rational weight attached to `μ`: `W_[μ]` maps into its integral Weyl group, and the roots
integral for it are integral for `μ`. -/
lemma exists_transport_integral (μ : Dual K H) : ∃ μ' : Dual ℚ (ι → ℚ),
    (∀ w ∈ P.integralWeylGroup hF.isGeneralizedCartan μ,
      weylGroupEquiv P (ratRealization hF) hF.isGeneralizedCartan w ∈
        (ratRealization hF).integralWeylGroup hF.isGeneralizedCartan μ') ∧
    ∀ v i, (ratRealization hF).IsIntegralRoot hF.isGeneralizedCartan μ'
        (weylGroupEquiv P (ratRealization hF) hF.isGeneralizedCartan v) i →
      P.IsIntegralRoot hF.isGeneralizedCartan μ v i := by
  classical
  have : Finite (P.weylGroup hF.isGeneralizedCartan) := P.finite_weylGroup hF
  have : Fintype (P.weylGroup hF.isGeneralizedCartan) := Fintype.ofFinite _
  obtain ⟨Ψ, hΨ1, hΨ⟩ := exists_rat_linearMap_of_finset (Finset.univ.image
    fun p : P.weylGroup hF.isGeneralizedCartan × ι ↦
      P.corootPairing hF.isGeneralizedCartan μ p.1 p.2)
  refine ⟨transport (P := P) Ψ μ, fun w hw ↦ ?_, fun v i ⟨z, hz⟩ ↦ ?_⟩
  · rw [mem_integralWeylGroup, ← transport_apply _ hF Ψ, ← transport_sub]
    obtain ⟨k, hk⟩ := (P.mem_rootLattice).mp hw
    rw [← hk, transport_rootOf hF Ψ hΨ1]
    exact (ratRealization hF).rootOf_mem_rootLattice k
  · refine hΨ _ (Finset.mem_image.mpr ⟨(v, i), Finset.mem_univ _, rfl⟩) ⟨z, ?_⟩
    rw [← hz]
    change Ψ ((((v⁻¹ : P.weylGroup hF.isGeneralizedCartan) : Dual K H ≃ₗ[K] Dual K H) μ)
      (P.coroot i)) = _
    rw [← transport_apply_single (P := P) Ψ, transport_apply _ hF Ψ, map_inv]
    rfl

/-! ### Humphreys, GSM 94, Theorem 3.4 (b) -/

/-- **Humphreys, GSM 94, Thm. 3.4 (b).** For a Cartan matrix of finite type, a realization over
a field of characteristic zero and any weight `λ`, the integral Weyl group
`W_[λ] = {w ∈ W | wλ - λ ∈ Q}` is generated by the reflections `s_β` in the roots `β` with
`⟨λ, β^∨⟩ ∈ ℤ`. Humphreys works over `ℂ` (for the Weyl group of a semisimple Lie algebra); the
reduction to rational weights is our own (see the module docstring). -/
theorem integralWeylGroup_eq_integralReflectionGroup (μ : Dual K H) :
    P.integralWeylGroup hF.isGeneralizedCartan μ =
      P.integralReflectionGroup hF.isGeneralizedCartan μ := by
  obtain ⟨μ', hW, hint⟩ := exists_transport_integral (P := P) hF μ
  set e := weylGroupEquiv P (ratRealization hF) hF.isGeneralizedCartan
  refine le_antisymm (fun w hw ↦ ?_) (P.integralReflectionGroup_le _ μ)
  have h2 := integralWeylGroup_le_integralReflectionGroup_of_rat hF _ (hW w hw)
  have h3 : ((ratRealization hF).integralReflectionGroup hF.isGeneralizedCartan μ').map
      e.symm.toMonoidHom ≤ P.integralReflectionGroup hF.isGeneralizedCartan μ := by
    rw [integralReflectionGroup, MonoidHom.map_closure, Subgroup.closure_le]
    rintro _ ⟨_, ⟨v', i, hv', rfl⟩, rfl⟩
    refine Subgroup.subset_closure ⟨e.symm v', i, hint _ i (by rwa [MulEquiv.apply_symm_apply]), ?_⟩
    change P.reflectionOf _ (e.symm v') i = e.symm ((ratRealization hF).reflectionOf _ v' i)
    rw [eq_comm, MulEquiv.symm_apply_eq, weylGroupEquiv_reflectionOf, MulEquiv.apply_symm_apply]
  exact h3 ⟨e w, h2, e.symm_apply_apply w⟩

end Matrix.Realization

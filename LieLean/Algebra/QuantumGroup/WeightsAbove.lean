import LieLean.Algebra.QuantumGroup.CompleteReducibility

/-!
# Integrable modules with finitely many weights above each weight

A `U = U_q(𝔤)`-module `M` *has finitely many weights above each weight*
(`QuantumGroup.HasFiniteWeightsAbove`) if for every `Λ` only finitely many `Λ + ν`, `ν ∈ Q₊`, are
weights of `M`. Modules in `𝒪_int` have this property
(`QuantumGroup.IsCategoryOInt.hasFiniteWeightsAbove`), and so do their restrictions to Levi
subalgebras, which are usually not in `𝒪_int` of the Levi subalgebra (they can have infinitely many
cones of weights).

For an integrable module with finite-dimensional weight spaces and finitely many weights above each
weight, the submodule `U x` generated by a weight vector `x` is in `𝒪_int`
(`QuantumGroup.isCategoryOInt_of_le_span`), so complete reducibility extends to these modules.

## Main results

* `QuantumGroup.isSemisimpleModule_of_hasFiniteWeightsAbove`: such a module is semisimple.
* `QuantumGroup.exists_linearEquiv_dfinsupp_of_hasFiniteWeightsAbove`: such a module is isomorphic
  to a direct sum `⊕ⱼ L_q(Λⱼ)` with dominant `Λⱼ` ([HK] Thm. 3.5.4 beyond `𝒪_int`).

## References

* [HK] J. Hong, S.-J. Kang, *Introduction to quantum groups and crystal bases*, GSM 42, §3.5.
-/

open LieLean Finset

noncomputable section

namespace LieLean.QuantumGroup

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {v : k}
  {M : Type*} [AddCommGroup M] [Module k M] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M]

variable (R v M) in
/-- `M` has finitely many weights above each weight: for every `Λ`, only finitely many `ν ∈ ℕ[I]`
make `Λ + Σᵢ νᵢ αᵢ` a weight of `M`. -/
def HasFiniteWeightsAbove : Prop :=
  ∀ Λ : Y →+ ℤ, {ν : I →₀ ℕ | weightSpace R v M (Λ + R.rootSum ν) ≠ ⊥}.Finite

/-- A module in `𝒪_int` has finitely many weights above each weight. -/
theorem IsCategoryOInt.hasFiniteWeightsAbove (hR : R.IsXRegular) (hM : IsCategoryOInt R v M) :
    HasFiniteWeightsAbove R v M := by
  classical
  obtain ⟨s, hs⟩ := hM.exists_finset
  have hinj : Function.Injective R.rootSum := fun ν ν' h ↦ by
    by_contra hne
    obtain ⟨μ, hμ⟩ := R.exists_rootSum_ne hR hne
    exact hμ (by rw [h])
  intro μ
  refine ((s : Set (Y →+ ℤ)).toFinite.biUnion fun μ' _ ↦
    ((antidiagonal (if h : ∃ ρ, R.rootSum ρ = μ' - μ then h.choose else 0)).image
      Prod.fst).finite_toSet).subset ?_
  intro ν hν
  obtain ⟨μ', hμ', ρ, hρ⟩ := hs _ hν
  have hσ : R.rootSum (ν + ρ) = μ' - μ := by
    rw [R.rootSum_add]
    calc R.rootSum ν + R.rootSum ρ = (μ + R.rootSum ν) + R.rootSum ρ - μ := by abel
      _ = μ' - μ := by rw [hρ]; abel
  have hex : ∃ σ, R.rootSum σ = μ' - μ := ⟨_, hσ⟩
  refine Set.mem_biUnion (Finset.mem_coe.2 hμ') ?_
  refine Finset.mem_coe.2 (Finset.mem_image.2 ⟨(ν, ρ), mem_antidiagonal.2 ?_, rfl⟩)
  simp only [hex, ↓reduceDIte]
  exact (hinj (hex.choose_spec.trans hσ.symm)).symm

variable [NeZero v] (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) (hM : IsIntegrable R v M)
  (hfd : ∀ Λ, FiniteDimensional k (weightSpace R v M Λ)) (hab : HasFiniteWeightsAbove R v M)

include hv' hM hfd hab in
/-- Let `M` be integrable with finite-dimensional weight spaces and finitely many weights above each
weight. Every submodule of the submodule `U x` generated by a weight vector `x` is in `𝒪_int`: its
weights lie below the finitely many weights of `M` above the weight of `x`. -/
theorem isCategoryOInt_of_le_span {Λ₀ : Y →+ ℤ} {x : M} (hx : x ∈ weightSpace R v M Λ₀)
    {N : Submodule (QuantumGroup R v) M} (hN : N ≤ Submodule.span (QuantumGroup R v) {x}) :
    IsCategoryOInt R v N where
  isIntegrable := hM.submodule hv' N
  finiteDimensional_weightSpace Λ := by
    have := hfd Λ
    let f : weightSpace R v N Λ →ₗ[k] weightSpace R v M Λ :=
      { toFun := fun y ↦ ⟨y.1, mem_weightSpace_submodule.1 y.2⟩
        map_add' := fun _ _ ↦ rfl
        map_smul' := fun _ _ ↦ rfl }
    exact Module.Finite.of_injective f fun y z h ↦
      Subtype.ext (Subtype.ext (congrArg (fun w : weightSpace R v M Λ ↦ (w : M)) h))
  exists_finset := by
    classical
    set W : Submodule k M := ⨆ ν : I →₀ ℕ, weightSpace R v M (Λ₀ + R.rootSum ν)
    have hE : ∀ i, ∀ y ∈ W, E R v i • y ∈ W := by
      intro i
      suffices W ≤ W.comap (Algebra.lsmul k k M (E R v i)) from fun y hy ↦ this hy
      refine iSup_le fun ν y hy ↦ ?_
      rw [Submodule.mem_comap, Algebra.lsmul_apply]
      refine Submodule.mem_iSup_of_mem (ν + Finsupp.single i 1) ?_
      have := E_smul_mem_weightSpace hy i
      rwa [R.rootSum_add, R.rootSum_single, one_smul, ← add_assoc]
    have hW : W ≤ ⨆ μ, W ⊓ weightSpace R v M μ := iSup_le fun ν ↦
      le_iSup_of_le (Λ₀ + R.rootSum ν)
        (le_inf (le_iSup (fun ν ↦ weightSpace R v M (Λ₀ + R.rootSum ν)) ν) le_rfl)
    have hxW : x ∈ W := Submodule.mem_iSup_of_mem 0 (by rwa [R.rootSum_zero, add_zero])
    have hWμ : ∀ μ, W ⊓ weightSpace R v M μ ≠ ⊥ →
        ∃ ν ∈ (hab Λ₀).toFinset, μ = Λ₀ + R.rootSum ν := by
      intro μ hμ
      by_contra! hne
      refine hμ (eq_bot_iff.2 fun y hy ↦ ?_)
      have hle : W ≤ ⨆ (j) (_ : j ≠ μ), weightSpace R v M j := iSup_le fun ν ↦ by
        by_cases h : weightSpace R v M (Λ₀ + R.rootSum ν) = ⊥
        · rw [h]
          exact bot_le
        · exact le_iSup₂_of_le (f := fun j (_ : j ≠ μ) ↦ weightSpace R v M j) _
            (fun h' ↦ hne ν ((hab Λ₀).mem_toFinset.2 h) h'.symm) le_rfl
      exact (Submodule.mem_bot k).2
        (Submodule.disjoint_def.1 (iSupIndep_weightSpace hv' μ) y hy.2 (hle hy.1))
    refine ⟨(hab Λ₀).toFinset.image fun ν ↦ Λ₀ + R.rootSum ν, fun Λ hΛ ↦ ?_⟩
    obtain ⟨y, hy, hy0⟩ := (Submodule.ne_bot_iff _).1 hΛ
    by_contra! hne
    refine hy0 (Subtype.ext (eq_zero_of_mem_span_of_mem_weightSpace hv' hE hW ?_
      (Submodule.span_mono (Set.singleton_subset_iff.2 hxW) (hN y.2))
      (mem_weightSpace_submodule.1 hy)))
    intro μ hμ ν he
    obtain ⟨ν', hν', rfl⟩ := hWμ μ hμ
    exact hne _ (Finset.mem_image_of_mem _ hν') ν he.symm

variable [Finite I] [CharZero k] (hvt : Transcendental ℚ v) (hR : R.IsXRegular)

include hv' hM hfd hab hvt hR in
/-- An integrable module with finite-dimensional weight spaces and finitely many weights above each
weight is semisimple: it is the sum of the submodules `U x` generated by weight vectors, which are
in `𝒪_int`. -/
theorem isSemisimpleModule_of_hasFiniteWeightsAbove : IsSemisimpleModule (QuantumGroup R v) M := by
  refine isSemisimpleModule_of_isSemisimpleModule_submodule'
    (p := fun x : Σ Λ, weightSpace R v M Λ ↦ Submodule.span (QuantumGroup R v) {(x.2 : M)})
    (fun x ↦ (isCategoryOInt_of_le_span hv' hM hfd hab x.2.2 le_rfl).isSemisimpleModule hv' hvt hR)
    ?_
  rw [eq_top_iff]
  intro m _
  have hm : m ∈ ⨆ Λ, weightSpace R v M Λ := hM.iSup_weightSpace_eq_top ▸ Submodule.mem_top
  have hle : ⨆ Λ, weightSpace R v M Λ ≤ (⨆ x : Σ Λ, weightSpace R v M Λ,
      Submodule.span (QuantumGroup R v) {(x.2 : M)}).restrictScalars k :=
    iSup_le fun Λ y hy ↦
      Submodule.mem_iSup_of_mem ⟨Λ, ⟨y, hy⟩⟩ (Submodule.mem_span_singleton_self y)
  exact hle hm

include hv' hM hfd hab hvt hR in
/-- **Complete reducibility** ([HK] Thm. 3.5.4) for an integrable module `M` with
finite-dimensional weight spaces and finitely many weights above each weight: `M` is isomorphic to a
direct sum `⊕ⱼ L_q(Λⱼ)` of irreducible highest weight modules with dominant highest weights. The
summands are indexed by a set of submodules of `M`. -/
theorem exists_linearEquiv_dfinsupp_of_hasFiniteWeightsAbove :
    ∃ (s : Set (Submodule (QuantumGroup R v) M)) (Λ : s → Y →+ ℤ),
      (∀ j i, 0 ≤ Λ j (R.coroot i)) ∧
        Nonempty ((Π₀ j : s, IrreducibleModule R v (Λ j)) ≃ₗ[QuantumGroup R v] M) := by
  have := isSemisimpleModule_of_hasFiniteWeightsAbove hv' hM hfd hab hvt hR
  obtain ⟨s, e, -, hsimple⟩ := IsSemisimpleModule.exists_linearEquiv_dfinsupp (QuantumGroup R v) M
  have key : ∀ m : s, ∃ Λ : Y →+ ℤ, (∀ i, 0 ≤ Λ (R.coroot i)) ∧
      Nonempty (IrreducibleModule R v Λ ≃ₗ[QuantumGroup R v] m.1) := fun m ↦ by
    have hs := hsimple m
    have hint := hM.submodule hv' m.1
    have hnt := IsSimpleModule.nontrivial (QuantumGroup R v) m.1
    obtain ⟨Λ₀, y, hy, hy0⟩ : ∃ Λ₀, ∃ y ∈ weightSpace R v m.1 Λ₀, y ≠ 0 := by
      by_contra! h
      obtain ⟨z, hz⟩ := exists_ne (0 : m.1)
      have hz' : z ∈ ⨆ Λ, weightSpace R v m.1 Λ :=
        hint.iSup_weightSpace_eq_top ▸ Submodule.mem_top
      have hbot : ∀ Λ, weightSpace R v m.1 Λ = ⊥ := fun Λ ↦
        eq_bot_iff.2 fun y hy ↦ (Submodule.mem_bot k).2 (h Λ y hy)
      simp only [hbot, iSup_bot] at hz'
      exact hz ((Submodule.mem_bot k).1 hz')
    have hle : Submodule.span (QuantumGroup R v) {(y : M)} ≤ m.1 :=
      (Submodule.span_singleton_le_iff_mem _ _).2 y.2
    have heq := ((isSimpleModule_iff_isAtom.1 hs).le_iff.1 hle).resolve_left fun h ↦
      hy0 (Subtype.ext ((Submodule.span_singleton_eq_bot).1 h))
    exact (isCategoryOInt_of_le_span hv' hM hfd hab (mem_weightSpace_submodule.1 hy)
      heq.ge).exists_nonempty_equiv_of_isSimpleModule hv' hvt hR
  choose Λ hΛ he using key
  exact ⟨s, Λ, hΛ, ⟨(DFinsupp.mapRange.linearEquiv fun m ↦ (he m).some).trans e.symm⟩⟩

end LieLean.QuantumGroup

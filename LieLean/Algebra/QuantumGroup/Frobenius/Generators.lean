import LieLean.Algebra.QuantumGroup.Frobenius.Splitting

/-!
# Generators of `_F f` at a root of `1`

Let `F` be the field of [Lus] 35.2.1: of characteristic zero over `𝒜 = ℤ[v, v⁻¹]`, with the
image `ε` of `v` satisfying `ε^{2l} = 1` and `ε^{2t} ≠ 1` for `0 < t < l`. Then the `F`-algebra
`_F f` is generated by the `θᵢ^{(lᵢ)}` and by the `θᵢ` with `lᵢ ≥ 2` ([Lus] Lemma 35.2.2).

## Main results

* `QuantumGroup.baseGen_mul_baseGen_frobOrder`: `θᵢ^{(a)} θᵢ^{(lᵢb)}` is a nonzero multiple of
  `θᵢ^{(a + lᵢb)}` for `a < lᵢ` ([Lus] 34.1.2).
* `QuantumGroup.adjoin_frobeniusGenerators`: [Lus] Lemma 35.2.2.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, 34.1.2, 34.1.3, 35.2.1,
  35.2.2.
-/

open LieLean Finset LusztigF
open scoped TensorProduct

noncomputable section

namespace LieLean.QuantumGroup

local notation "𝒜" => LaurentPolynomial ℤ

universe u

variable {I : Type u} [DecidableEq I] (D : LusztigCartanDatum I)
variable {F : Type*} [Field F] [Algebra 𝒜 F] [CharZero F] {l : ℕ}

local notation "ε" => algebraMap 𝒜 F (LaurentPolynomial.T 1)

variable (hl0 : 0 < l) (hl : algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * l) = 1)
  (hprim : ∀ t, 0 < t → t < l → algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * t) ≠ 1)
include hl0 hl hprim

omit [CharZero F] in
/-- `θᵢ^{(a)} θᵢ^{(lᵢb)} = c θᵢ^{(a + lᵢb)}` with `c ≠ 0`, for `a < lᵢ` ([Lus] 34.1.2 (b)). -/
lemma baseGen_mul_baseGen_frobOrder (i : I) {a : ℕ} (ha : a < D.frobOrder l i) (b : ℕ) :
    ∃ c : F, c ≠ 0 ∧ baseGen D F i a * baseGen D F i (D.frobOrder l i * b) =
      c • baseGen D F i (a + D.frobOrder l i * b) := by
  set L := D.frobOrder l i
  set q := ε ^ D.d i
  have hq : q ≠ 0 := pow_ne_zero _ (algebraMap_T_one_ne_zero hl0 hl)
  refine ⟨qBinomial q (a + L * b) a, ?_, baseGen_mul_baseGen D F i a (L * b)⟩
  have h := qBinomInt_add_mul_add_mul hq (pow_d_pow_frobOrder D hl0 hl hprim i)
    (pow_d_pow_ne_one D hl0 hl hprim i) (D.frobOrder_pos hl0 i) ha ha (b : ℤ) 0
  rw [Nat.cast_zero, mul_zero, add_zero, ← Nat.cast_mul, ← Nat.cast_add, qBinomInt_natCast,
    Ring.choose_zero_right, Int.cast_one, mul_one, qBinomial_self, mul_one] at h
  rw [h]
  exact zpow_ne_zero _ hq

omit [CharZero F] in
/-- `θᵢ^{(a)} = ([a]ᵢ!)⁻¹ θᵢᵃ` in `_F f` for `a < lᵢ` ([Lus] 35.2.2 (a)). -/
lemma baseGen_eq_smul_pow_of_lt (i : I) {a : ℕ} (ha : a < D.frobOrder l i) :
    baseGen D F i a = (qFactorial (ε ^ D.d i) a)⁻¹ • baseGen D F i 1 ^ a := by
  have hq : ε ^ D.d i ≠ 0 := pow_ne_zero _ (algebraMap_T_one_ne_zero hl0 hl)
  have hF : qFactorial (ε ^ D.d i) a ≠ 0 :=
    qFactorial_ne_zero hq fun m hm hma ↦ pow_d_pow_ne_one D hl0 hl hprim i m hm (by omega)
  rw [baseGen, baseGen, Algebra.TensorProduct.tmul_pow, one_pow, integralGenerator_pow,
    TensorProduct.tmul_smul,
    show ∀ (c : 𝒜) (x : F ⊗[𝒜] quotientIntegralForm D),
      c • x = algebraMap 𝒜 F c • x from fun c x ↦ (algebraMap_smul F c x).symm,
    map_laurentQFactorial, algebraMap_laurentTUnit, smul_smul, inv_mul_cancel₀ hF, one_smul]

/-- The generators of [Lus] Lemma 35.2.2: the `θᵢ^{(lᵢ)}`, and the `θᵢ` with `lᵢ ≥ 2`. -/
def frobeniusGenerators (D : LusztigCartanDatum I) (F : Type*) [Field F] [Algebra 𝒜 F] (l : ℕ) :
    Set (F ⊗[𝒜] quotientIntegralForm D) :=
  Set.range (fun i ↦ baseGen D F i (D.frobOrder l i)) ∪
    {x | ∃ i, 2 ≤ D.frobOrder l i ∧ x = baseGen D F i 1}

/-- **[Lus] Lemma 35.2.2**: the `F`-algebra `_F f` is generated by the `θᵢ^{(lᵢ)}` and by the
`θᵢ` with `lᵢ ≥ 2`. -/
theorem adjoin_frobeniusGenerators :
    Algebra.adjoin F (frobeniusGenerators D F l) = ⊤ := by
  rw [eq_top_iff, ← adjoin_baseChangeGenerator D F, Algebra.adjoin_le_iff]
  rintro _ ⟨⟨i, n⟩, rfl⟩
  dsimp only
  set S := Algebra.adjoin F (frobeniusGenerators D F l)
  set L := D.frobOrder l i
  have hL := D.frobOrder_pos hl0 i
  -- `θᵢ^{(lᵢb)} ∈ S`
  have hfrob : ∀ b, baseGen D F i (L * b) ∈ S := by
    intro b
    have hF := qFactorial_ne_zero_of_sq_eq_one (sq_pow_frobenius_d D hl0 hl hprim i) b
    have h := baseGen_frobOrder_pow D hl0 hl hprim i b
    have : baseGen D F i (L * b) =
        (qFactorial (ε ^ (D.frobenius hl0).d i) b)⁻¹ • baseGen D F i L ^ b := by
      rw [h, smul_smul, inv_mul_cancel₀ hF, one_smul]
    rw [this]
    exact S.smul_mem (S.pow_mem (Algebra.subset_adjoin (Or.inl ⟨i, rfl⟩)) _) _
  -- `θᵢ^{(a)} ∈ S` for `a < lᵢ`
  have hsmall : ∀ a, a < L → baseGen D F i a ∈ S := by
    intro a ha
    rcases Nat.lt_or_ge L 2 with h2 | h2
    · obtain rfl : a = 0 := by omega
      rw [baseGen, integralGenerator_zero, ← Algebra.TensorProduct.one_def]
      exact S.one_mem
    · rw [baseGen_eq_smul_pow_of_lt D hl0 hl hprim i ha]
      exact S.smul_mem (S.pow_mem (Algebra.subset_adjoin (Or.inr ⟨i, h2, rfl⟩)) _) _
  obtain ⟨c, hc, h⟩ := baseGen_mul_baseGen_frobOrder D hl0 hl hprim i (Nat.mod_lt n hL) (n / L)
  rw [Nat.mod_add_div] at h
  have : baseGen D F i n = c⁻¹ • (baseGen D F i (n % L) * baseGen D F i (L * (n / L))) := by
    rw [h, smul_smul, inv_mul_cancel₀ hc, one_smul]
  change baseGen D F i n ∈ S
  rw [this]
  exact S.smul_mem (S.mul_mem (hsmall _ (Nat.mod_lt n hL)) (hfrob _)) _

end LieLean.QuantumGroup

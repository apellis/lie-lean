import LieLean.Algebra.QuantumGroup.Frobenius.Splitting
import Mathlib.RingTheory.Polynomial.Cyclotomic.Roots
import Mathlib.FieldTheory.Minpoly.IsIntegrallyClosed

/-!
# `Fr' : _R f* → _R f` over an arbitrary `𝒜'`-algebra

Let `l ≥ 1` and let `l'` be `2l`, or `l` if `l` is odd ([Lus] 35.1.3). Let
`𝒜' = 𝒜 / (f_{l'})`, where `f_{l'}` is the `l'`-th cyclotomic polynomial in `v`. For every
`𝒜'`-algebra `R` there is a unique `R`-algebra homomorphism `Fr' : _R f* → _R f` with
`θᵢ^{(n)} ↦ θᵢ^{(lᵢn)}` ([Lus] Thm. 35.1.8, in the generality of 35.1.3).

## Main results

* `QuantumGroup.CyclotomicQuotient`: the ring `𝒜'` of [Lus] 35.1.3. It is an integral domain
  (`instIsDomainCyclotomicQuotient`): `v ↦ e^{2πi/l'}` embeds it into `ℂ`
  (`cyclotomicQuotientEval_injective`).
* `QuantumGroup.baseChangeMap_injective`: `_B f → _F f` is injective for an injective
  `B → F` (`𝒜f` is free).
* `QuantumGroup.frobSplitOfInjective`: `Fr'` over a ring `B` embedded in a field `F` as in
  [Lus] 35.2.1, by restriction of `QuantumGroup.frobSplit`.
* `QuantumGroup.frobSplitGeneral`: `Fr'` over any `𝒜'`-algebra `R`, with
  `frobSplitGeneral_integralGenerator` and uniqueness `eq_frobSplitGeneral`.

## Proof

As in [Lus] 35.1.11: `𝒜'` is a domain whose fraction field `K` satisfies the assumptions of
35.2.1, so `Fr'` exists over `K` (`QuantumGroup.frobSplit`); it maps `_{𝒜'}f*` into
`_{𝒜'}f ⊆ _K f`, since both are generated by divided powers. The general case follows by
change of rings `_R f = R ⊗_{𝒜'} _{𝒜'}f`.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, 35.1.3, 35.1.8, 35.1.11,
  35.2.1.
-/

open LieLean LusztigF Polynomial
open scoped TensorProduct

noncomputable section

namespace LieLean.QuantumGroup

local notation "𝒜" => LaurentPolynomial ℤ

universe u

/-! ### The ring `𝒜'` -/

section Cyclotomic

/-- The `l'`-th cyclotomic polynomial `f_{l'}(v) ∈ 𝒜` ([Lus] 35.1.3). -/
def laurentCyclotomic (l' : ℕ) : 𝒜 := toLaurent (cyclotomic l' ℤ)

/-- `𝒜' = 𝒜 / (f_{l'})` ([Lus] 35.1.3). -/
abbrev CyclotomicQuotient (l' : ℕ) := 𝒜 ⧸ Ideal.span {laurentCyclotomic l'}

/-- `e^{2πi/l'} ∈ ℂ`. -/
def cyclotomicZeta (l' : ℕ) : ℂ := Complex.exp (2 * Real.pi * Complex.I / l')

lemma isPrimitiveRoot_cyclotomicZeta {l' : ℕ} (h : 0 < l') :
    IsPrimitiveRoot (cyclotomicZeta l') l' :=
  Complex.isPrimitiveRoot_exp _ h.ne'

/-- `𝒜 → ℂ`, `v ↦ e^{2πi/l'}`. -/
def cyclotomicEval (l' : ℕ) : 𝒜 →+* ℂ :=
  LaurentPolynomial.eval₂ (Int.castRingHom ℂ)
    (Units.mk0 (cyclotomicZeta l') (Complex.exp_ne_zero _))

/-- The kernel of `v ↦ e^{2πi/l'}` is generated by `f_{l'}(v)`. -/
lemma ker_cyclotomicEval {l' : ℕ} (h : 0 < l') :
    RingHom.ker (cyclotomicEval l') = Ideal.span {laurentCyclotomic l'} := by
  apply le_antisymm
  · intro p hp
    rw [RingHom.mem_ker] at hp
    obtain ⟨n, q, hq⟩ := LaurentPolynomial.exists_T_pow p
    have hq0 : aeval (cyclotomicZeta l') q = 0 := by
      have := congrArg (cyclotomicEval l') hq
      rw [map_mul, hp, zero_mul, cyclotomicEval, LaurentPolynomial.eval₂_toLaurent] at this
      rwa [aeval_def]
    have hd : cyclotomic l' ℤ ∣ q := by
      rw [cyclotomic_eq_minpoly (isPrimitiveRoot_cyclotomicZeta h) h]
      exact minpoly.isIntegrallyClosed_dvd ((isPrimitiveRoot_cyclotomicZeta h).isIntegral h) hq0
    obtain ⟨r, rfl⟩ := hd
    have : p = laurentCyclotomic l' * (toLaurent r * LaurentPolynomial.T (-(n : ℤ))) := by
      rw [← mul_assoc, laurentCyclotomic, ← map_mul, hq, mul_assoc, ← LaurentPolynomial.T_add,
        add_neg_cancel, LaurentPolynomial.T_zero, mul_one]
    rw [this]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)
  · rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, RingHom.mem_ker,
      cyclotomicEval, laurentCyclotomic, LaurentPolynomial.eval₂_toLaurent]
    have := (isPrimitiveRoot_cyclotomicZeta h).isRoot_cyclotomic h
    rw [IsRoot.def, ← map_cyclotomic_int, eval_map] at this
    exact this

variable (l' : ℕ) [NeZero l']

/-- `𝒜' → ℂ`, `v ↦ e^{2πi/l'}`. -/
def cyclotomicQuotientEval : CyclotomicQuotient l' →+* ℂ :=
  Ideal.Quotient.lift _ (cyclotomicEval l') fun p hp ↦ by
    rwa [← RingHom.mem_ker, ker_cyclotomicEval (Nat.pos_of_neZero l')]

lemma cyclotomicQuotientEval_injective : Function.Injective (cyclotomicQuotientEval l') := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  rw [Ideal.Quotient.eq_zero_iff_mem, ← ker_cyclotomicEval (Nat.pos_of_neZero l'),
    RingHom.mem_ker]
  exact hx

instance : IsDomain (CyclotomicQuotient l') :=
  (cyclotomicQuotientEval_injective l').isDomain _

/-- The fraction field of `𝒜'` embeds into `ℂ`. -/
def cyclotomicFractionEval : FractionRing (CyclotomicQuotient l') →+* ℂ :=
  IsFractionRing.lift (cyclotomicQuotientEval_injective l')

instance : CharZero (FractionRing (CyclotomicQuotient l')) :=
  RingHom.charZero (cyclotomicFractionEval l')

lemma cyclotomicFractionEval_v :
    cyclotomicFractionEval l'
      (algebraMap 𝒜 (FractionRing (CyclotomicQuotient l')) (LaurentPolynomial.T 1)) =
        cyclotomicZeta l' := by
  rw [IsScalarTower.algebraMap_apply 𝒜 (CyclotomicQuotient l'), cyclotomicFractionEval,
    IsFractionRing.lift_algebraMap]
  simp only [cyclotomicQuotientEval, cyclotomicEval, Ideal.Quotient.algebraMap_eq,
    Ideal.Quotient.lift_mk, LaurentPolynomial.eval₂_T, zpow_one]
  rfl

variable {l'}

/-- In the fraction field of `𝒜'`, `v^{2t} = 1` if and only if `l ∣ t` ([Lus] 35.2.1). -/
lemma cyclotomicFraction_pow_two_mul_eq_one_iff {l : ℕ} (hl' : l' = 2 * l ∨ (Odd l ∧ l' = l))
    (t : ℕ) :
    algebraMap 𝒜 (FractionRing (CyclotomicQuotient l')) (LaurentPolynomial.T 1) ^ (2 * t) = 1 ↔
      l ∣ t := by
  rw [← (cyclotomicFractionEval l').injective.eq_iff, map_pow, map_one, cyclotomicFractionEval_v,
    (isPrimitiveRoot_cyclotomicZeta (Nat.pos_of_neZero l')).pow_eq_one_iff_dvd]
  rcases hl' with rfl | ⟨hodd, rfl⟩
  · exact Nat.mul_dvd_mul_iff_left two_pos
  · exact (Nat.coprime_two_right.2 hodd).dvd_mul_left

end Cyclotomic

variable {I : Type u} [DecidableEq I] (D : LusztigCartanDatum I)

/-! ### Change of rings for `f` -/

section BaseChangeMap

variable (B F : Type*) [CommRing B] [Algebra 𝒜 B] [Field F] [Algebra 𝒜 F] [Algebra B F]
  [IsScalarTower 𝒜 B F]

/-- The map `_B f → _F f` induced by `B → F`. -/
def baseChangeMap : B ⊗[𝒜] quotientIntegralForm D →ₐ[B] F ⊗[𝒜] quotientIntegralForm D :=
  Algebra.TensorProduct.map (Algebra.ofId B F) (AlgHom.id 𝒜 _)

lemma baseChangeMap_tmul (b : B) (x : quotientIntegralForm D) :
    baseChangeMap D B F (b ⊗ₜ x) = algebraMap B F b ⊗ₜ x := rfl

variable [Finite I] {B F}

/-- `_B f → _F f` is injective when `B → F` is: `𝒜f` is free. -/
lemma baseChangeMap_injective (h : Function.Injective (algebraMap B F)) :
    Function.Injective (baseChangeMap D B F) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  refine (baseChangeCanonicalBasis D B).repr.injective ?_
  ext b
  have key : ∀ y : B ⊗[𝒜] quotientIntegralForm D,
      (baseChangeCanonicalBasis D F).repr (baseChangeMap D B F y) b =
        algebraMap B F ((baseChangeCanonicalBasis D B).repr y b) := by
    intro y
    induction y using TensorProduct.inductionOn with
    | tmul c y =>
      rw [baseChangeMap_tmul, baseChangeCanonicalBasis, baseChangeCanonicalBasis,
        Algebra.TensorProduct.basis_repr_tmul, Algebra.TensorProduct.basis_repr_tmul]
      simp only [Finsupp.smul_apply, Finsupp.mapRange_apply, smul_eq_mul, map_mul,
        IsScalarTower.algebraMap_apply 𝒜 B F]
    | add y z hy hz => simp only [map_add, Finsupp.add_apply, hy, hz]
  have := key x
  rw [hx, map_zero, Finsupp.zero_apply, eq_comm, ← map_zero (algebraMap B F)] at this
  simpa using h this

end BaseChangeMap

/-! ### `Fr'` over a subring of the field of 35.2.1 -/

section Restrict

variable [Finite I] {B F : Type*} [CommRing B] [Algebra 𝒜 B] [Field F] [Algebra 𝒜 F]
  [Algebra B F] [IsScalarTower 𝒜 B F] [CharZero F] {l : ℕ} (hl0 : 0 < l)
  (hl : algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * l) = 1)
  (hprim : ∀ t, 0 < t → t < l → algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * t) ≠ 1)

/-- `Fr'` over `F`, precomposed with `_B f* → _F f*`. -/
def frobSplitBase :
    B ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) →ₐ[B] F ⊗[𝒜] quotientIntegralForm D :=
  ((frobSplit D hl0 hl hprim).restrictScalars B).comp (baseChangeMap (D.frobenius hl0) B F)

lemma frobSplitBase_integralGenerator (i : I) (n : ℕ) :
    frobSplitBase D hl0 hl hprim ((1 : B) ⊗ₜ integralGenerator (D.frobenius hl0) i n) =
      baseChangeMap D B F ((1 : B) ⊗ₜ integralGenerator D i (D.frobOrder l i * n)) := by
  rw [frobSplitBase, AlgHom.comp_apply, baseChangeMap_tmul, baseChangeMap_tmul, map_one,
    AlgHom.restrictScalars_apply, frobSplit_integralGenerator]

/-- `Fr'` maps `_B f*` into `_B f ⊆ _F f`. -/
lemma frobSplitBase_mem_range (x : B ⊗[𝒜] quotientIntegralForm (D.frobenius hl0)) :
    frobSplitBase D hl0 hl hprim x ∈ (baseChangeMap D B F).range := by
  have : Algebra.adjoin B (Set.range fun p : I × ℕ ↦
      (1 : B) ⊗ₜ[𝒜] integralGenerator (D.frobenius hl0) p.1 p.2) ≤
      (baseChangeMap D B F).range.comap (frobSplitBase D hl0 hl hprim) := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨⟨i, n⟩, rfl⟩
    exact ⟨_, (frobSplitBase_integralGenerator D hl0 hl hprim i n).symm⟩
  rw [adjoin_baseChangeGenerator] at this
  exact this Algebra.mem_top

variable (hBF : Function.Injective (algebraMap B F))

/-- `Fr' : _B f* → _B f` for a ring `B` embedded in a field `F` as in [Lus] 35.2.1, by
restriction of `Fr'` over `F` ([Lus] 35.1.11). -/
def frobSplitOfInjective :
    B ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) →ₐ[B] B ⊗[𝒜] quotientIntegralForm D :=
  (AlgEquiv.ofInjective _ (baseChangeMap_injective D hBF)).symm.toAlgHom.comp
    ((frobSplitBase D hl0 hl hprim).codRestrict _ (frobSplitBase_mem_range D hl0 hl hprim))

lemma baseChangeMap_frobSplitOfInjective
    (x : B ⊗[𝒜] quotientIntegralForm (D.frobenius hl0)) :
    baseChangeMap D B F (frobSplitOfInjective D hl0 hl hprim hBF x) =
      frobSplitBase D hl0 hl hprim x := by
  rw [frobSplitOfInjective, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
  exact congrArg Subtype.val
    ((AlgEquiv.ofInjective _ (baseChangeMap_injective D hBF)).apply_symm_apply _)

theorem frobSplitOfInjective_integralGenerator (i : I) (n : ℕ) :
    frobSplitOfInjective D hl0 hl hprim hBF
        ((1 : B) ⊗ₜ integralGenerator (D.frobenius hl0) i n) =
      (1 : B) ⊗ₜ integralGenerator D i (D.frobOrder l i * n) :=
  baseChangeMap_injective D hBF (by
    rw [baseChangeMap_frobSplitOfInjective, frobSplitBase_integralGenerator])

end Restrict

/-! ### `Fr'` over an arbitrary `𝒜'`-algebra -/

/-- `T ⊗_S (S ⊗_R X) ≅ T ⊗_R X` for a (not necessarily commutative) `R`-algebra `X`. -/
def cancelBaseChangeRing (R S T : Type*) [CommRing R] [CommRing S] [CommRing T] [Algebra R S]
    [Algebra R T] [Algebra S T] [IsScalarTower R S T] (X : Type*) [Ring X] [Algebra R X] :
    T ⊗[S] (S ⊗[R] X) ≃ₐ[T] T ⊗[R] X :=
  AlgEquiv.symm <| AlgEquiv.ofLinearEquiv
    (TensorProduct.AlgebraTensorModule.cancelBaseChange R S T T X).symm
    (by simp [Algebra.TensorProduct.one_def]) <|
      LinearMap.map_mul_of_map_mul_tmul (fun _ _ _ _ ↦ by simp)

@[simp]
lemma cancelBaseChangeRing_tmul (R S T : Type*) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] (X : Type*) [Ring X]
    [Algebra R X] (t : T) (s : S) (x : X) :
    cancelBaseChangeRing R S T X (t ⊗ₜ (s ⊗ₜ x)) = (s • t) ⊗ₜ x :=
  TensorProduct.AlgebraTensorModule.cancelBaseChange_tmul R S T t x s

@[simp]
lemma cancelBaseChangeRing_symm_tmul (R S T : Type*) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra R T] [Algebra S T] [IsScalarTower R S T] (X : Type*) [Ring X]
    [Algebra R X] (t : T) (x : X) :
    (cancelBaseChangeRing R S T X).symm (t ⊗ₜ x) = t ⊗ₜ (1 ⊗ₜ x) :=
  TensorProduct.AlgebraTensorModule.cancelBaseChange_symm_tmul R S T t x

section General

variable [Finite I] {l l' : ℕ} (hl0 : 0 < l) (hl' : l' = 2 * l ∨ (Odd l ∧ l' = l))

include hl0 hl' in
lemma neZero_of_frobeniusLevel : NeZero l' :=
  ⟨by rcases hl' with rfl | ⟨-, rfl⟩ <;> omega⟩

/-- `Fr' : _{𝒜'} f* → _{𝒜'} f` ([Lus] 35.1.11). -/
def frobSplitCyclotomic :
    CyclotomicQuotient l' ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) →ₐ[CyclotomicQuotient l']
      CyclotomicQuotient l' ⊗[𝒜] quotientIntegralForm D :=
  haveI := neZero_of_frobeniusLevel hl0 hl'
  frobSplitOfInjective (F := FractionRing (CyclotomicQuotient l')) D hl0
    ((cyclotomicFraction_pow_two_mul_eq_one_iff hl' l).2 dvd_rfl)
    (fun t ht htl h ↦ absurd ((cyclotomicFraction_pow_two_mul_eq_one_iff hl' t).1 h)
      (Nat.not_dvd_of_pos_of_lt ht htl))
    (IsFractionRing.injective _ _)

theorem frobSplitCyclotomic_integralGenerator (i : I) (n : ℕ) :
    frobSplitCyclotomic D hl0 hl'
        ((1 : CyclotomicQuotient l') ⊗ₜ integralGenerator (D.frobenius hl0) i n) =
      (1 : CyclotomicQuotient l') ⊗ₜ integralGenerator D i (D.frobOrder l i * n) := by
  have := neZero_of_frobeniusLevel hl0 hl'
  exact frobSplitOfInjective_integralGenerator _ _ _ _ _ _ _

variable (R : Type*) [CommRing R] [Algebra 𝒜 R] [Algebra (CyclotomicQuotient l') R]
  [IsScalarTower 𝒜 (CyclotomicQuotient l') R]

/-- **[Lus] Thm. 35.1.8** (in the generality of 35.1.3): for an `𝒜'`-algebra `R`, the
`R`-algebra homomorphism `Fr' : _R f* → _R f` with `θᵢ ↦ θᵢ^{(lᵢ)}`, obtained from `Fr'` over
`𝒜'` by change of rings ([Lus] 35.1.11). -/
def frobSplitGeneral :
    R ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) →ₐ[R] R ⊗[𝒜] quotientIntegralForm D :=
  (cancelBaseChangeRing 𝒜 (CyclotomicQuotient l') R (quotientIntegralForm D)).toAlgHom.comp
    ((Algebra.TensorProduct.map (AlgHom.id R R) (frobSplitCyclotomic D hl0 hl')).comp
      (cancelBaseChangeRing 𝒜 (CyclotomicQuotient l') R
        (quotientIntegralForm (D.frobenius hl0))).symm.toAlgHom)

/-- **[Lus] Thm. 35.1.8**: `Fr'(θᵢ^{(n)}) = θᵢ^{(lᵢn)}` over any `𝒜'`-algebra. -/
theorem frobSplitGeneral_integralGenerator (i : I) (n : ℕ) :
    frobSplitGeneral D hl0 hl' R ((1 : R) ⊗ₜ integralGenerator (D.frobenius hl0) i n) =
      (1 : R) ⊗ₜ integralGenerator D i (D.frobOrder l i * n) := by
  simp only [frobSplitGeneral, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    cancelBaseChangeRing_symm_tmul, Algebra.TensorProduct.map_tmul,
    frobSplitCyclotomic_integralGenerator, cancelBaseChangeRing_tmul, AlgHom.id_apply]
  rw [Algebra.smul_def, map_one, one_mul]

/-- `Fr'` is the unique `R`-algebra homomorphism `_R f* → _R f` with `θᵢ ↦ θᵢ^{(lᵢ)}`
([Lus] 35.1.8). -/
theorem eq_frobSplitGeneral
    (φ : R ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) →ₐ[R] R ⊗[𝒜] quotientIntegralForm D)
    (hφ : ∀ i n, φ ((1 : R) ⊗ₜ integralGenerator (D.frobenius hl0) i n) =
      (1 : R) ⊗ₜ integralGenerator D i (D.frobOrder l i * n)) :
    φ = frobSplitGeneral D hl0 hl' R := by
  refine AlgHom.ext_of_adjoin_eq_top (adjoin_baseChangeGenerator (D.frobenius hl0) R) ?_
  rintro _ ⟨⟨i, n⟩, rfl⟩
  rw [hφ, frobSplitGeneral_integralGenerator]

end General

end LieLean.QuantumGroup

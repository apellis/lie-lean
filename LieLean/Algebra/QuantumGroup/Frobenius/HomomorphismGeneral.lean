import LieLean.Algebra.QuantumGroup.Frobenius.Homomorphism
import LieLean.Algebra.QuantumGroup.Frobenius.SplittingGeneral

/-!
# `Fr : _R f → _R f*` over an arbitrary `𝒜'`-algebra

Let `l ≥ 1`, let `l'` be `2l`, or `l` if `l` is odd, and let `𝒜' = 𝒜 / (f_{l'})` ([Lus] 35.1.3).
Under [Lus] 35.1.2 (a), for every `𝒜'`-algebra `R` there is a unique `R`-algebra homomorphism
`Fr : _R f → _R f*` with `Fr(θᵢ^{(n)}) = θᵢ^{(n/lᵢ)}` if `lᵢ ∣ n` and `0` otherwise
([Lus] Thm. 35.1.7, in the generality of 35.1.3).

## Main results

* `QuantumGroup.frobOfInjective`: `Fr` over a ring `B` embedded in a field `F` as in
  [Lus] 35.2.1, by restriction of `QuantumGroup.frob`.
* `QuantumGroup.frobGeneral`: `Fr` over any `𝒜'`-algebra `R`, with `frobGeneral_integralGenerator`
  and uniqueness `eq_frobGeneral`.

## Proof

As for `Fr'` (`Frobenius/SplittingGeneral.lean`, [Lus] 35.1.11): `Fr` over the fraction field of
`𝒜'` (`QuantumGroup.frob`) maps `_{𝒜'}f` into `_{𝒜'}f*`, since `_{𝒜'}f` is generated by the
`θᵢ^{(n)}` and their images are divided powers or `0`; then change of rings.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, 35.1.2, 35.1.3, 35.1.7,
  35.1.11, 35.2.1.
-/

open LieLean LusztigF
open scoped TensorProduct

noncomputable section

namespace LieLean.QuantumGroup

local notation "𝒜" => LaurentPolynomial ℤ

universe u

variable {I : Type u} [DecidableEq I] (D : LusztigCartanDatum I)

/-! ### `Fr` over a subring of the field of 35.2.1 -/

section Restrict

variable [Finite I] {B F : Type*} [CommRing B] [Algebra 𝒜 B] [Field F] [Algebra 𝒜 F]
  [Algebra B F] [IsScalarTower 𝒜 B F] [CharZero F] {l : ℕ} (hl0 : 0 < l)
  (hl : algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * l) = 1)
  (hprim : ∀ t, 0 < t → t < l → algebraMap 𝒜 F (LaurentPolynomial.T 1) ^ (2 * t) ≠ 1)
  (hA : ∀ i j, i ≠ j → 2 ≤ D.frobOrder l j → ∀ a : ℕ, D.cartanMatrix i j = -a →
    a < D.frobOrder l i)

/-- The values of `Fr` on divided powers, over any `𝒜`-algebra. -/
def frobValue (R : Type*) [CommRing R] [Algebra 𝒜 R] (i : I) (n : ℕ) :
    R ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) :=
  if D.frobOrder l i ∣ n then
    (1 : R) ⊗ₜ integralGenerator (D.frobenius hl0) i (n / D.frobOrder l i) else 0

/-- `Fr` over `F`, precomposed with `_B f → _F f`. -/
def frobBase :
    B ⊗[𝒜] quotientIntegralForm D →ₐ[B] F ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) :=
  ((frob hl0 hl hprim hA).restrictScalars B).comp (baseChangeMap D B F)

lemma frobBase_integralGenerator (i : I) (n : ℕ) :
    frobBase D hl0 hl hprim hA ((1 : B) ⊗ₜ integralGenerator D i n) =
      baseChangeMap (D.frobenius hl0) B F (frobValue D hl0 B i n) := by
  rw [frobBase, AlgHom.comp_apply, baseChangeMap_tmul, map_one, AlgHom.restrictScalars_apply,
    frob_baseGen, frobValue]
  split_ifs
  · rw [baseChangeMap_tmul, map_one]
  · rw [map_zero]

/-- `Fr` maps `_B f` into `_B f* ⊆ _F f*`. -/
lemma frobBase_mem_range (x : B ⊗[𝒜] quotientIntegralForm D) :
    frobBase D hl0 hl hprim hA x ∈ (baseChangeMap (D.frobenius hl0) B F).range := by
  have : Algebra.adjoin B (Set.range fun p : I × ℕ ↦
      (1 : B) ⊗ₜ[𝒜] integralGenerator D p.1 p.2) ≤
      (baseChangeMap (D.frobenius hl0) B F).range.comap (frobBase D hl0 hl hprim hA) := by
    rw [Algebra.adjoin_le_iff]
    rintro _ ⟨⟨i, n⟩, rfl⟩
    exact ⟨_, (frobBase_integralGenerator D hl0 hl hprim hA i n).symm⟩
  rw [adjoin_baseChangeGenerator] at this
  exact this Algebra.mem_top

variable (hBF : Function.Injective (algebraMap B F))

/-- `Fr : _B f → _B f*` for a ring `B` embedded in a field `F` as in [Lus] 35.2.1, by
restriction of `Fr` over `F`. -/
def frobOfInjective :
    B ⊗[𝒜] quotientIntegralForm D →ₐ[B] B ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) :=
  (AlgEquiv.ofInjective _ (baseChangeMap_injective (D.frobenius hl0) hBF)).symm.toAlgHom.comp
    ((frobBase D hl0 hl hprim hA).codRestrict _ (frobBase_mem_range D hl0 hl hprim hA))

lemma baseChangeMap_frobOfInjective (x : B ⊗[𝒜] quotientIntegralForm D) :
    baseChangeMap (D.frobenius hl0) B F (frobOfInjective D hl0 hl hprim hA hBF x) =
      frobBase D hl0 hl hprim hA x := by
  rw [frobOfInjective, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom]
  exact congrArg Subtype.val
    ((AlgEquiv.ofInjective _ (baseChangeMap_injective (D.frobenius hl0) hBF)).apply_symm_apply _)

theorem frobOfInjective_integralGenerator (i : I) (n : ℕ) :
    frobOfInjective D hl0 hl hprim hA hBF ((1 : B) ⊗ₜ integralGenerator D i n) =
      frobValue D hl0 B i n :=
  baseChangeMap_injective (D.frobenius hl0) hBF (by
    rw [baseChangeMap_frobOfInjective, frobBase_integralGenerator])

end Restrict

/-! ### `Fr` over an arbitrary `𝒜'`-algebra -/

section General

variable [Finite I] {l l' : ℕ} (hl0 : 0 < l) (hl' : l' = 2 * l ∨ (Odd l ∧ l' = l))
  (hA : ∀ i j, i ≠ j → 2 ≤ D.frobOrder l j → ∀ a : ℕ, D.cartanMatrix i j = -a →
    a < D.frobOrder l i)

/-- `Fr : _{𝒜'} f → _{𝒜'} f*`. -/
def frobCyclotomic :
    CyclotomicQuotient l' ⊗[𝒜] quotientIntegralForm D →ₐ[CyclotomicQuotient l']
      CyclotomicQuotient l' ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) :=
  haveI := neZero_of_frobeniusLevel hl0 hl'
  frobOfInjective (F := FractionRing (CyclotomicQuotient l')) D hl0
    ((cyclotomicFraction_pow_two_mul_eq_one_iff hl' l).2 dvd_rfl)
    (fun t ht htl h ↦ absurd ((cyclotomicFraction_pow_two_mul_eq_one_iff hl' t).1 h)
      (Nat.not_dvd_of_pos_of_lt ht htl)) hA
    (IsFractionRing.injective _ _)

theorem frobCyclotomic_integralGenerator (i : I) (n : ℕ) :
    frobCyclotomic D hl0 hl' hA ((1 : CyclotomicQuotient l') ⊗ₜ integralGenerator D i n) =
      frobValue D hl0 (CyclotomicQuotient l') i n := by
  have := neZero_of_frobeniusLevel hl0 hl'
  exact frobOfInjective_integralGenerator _ _ _ _ _ _ _ _

variable (R : Type*) [CommRing R] [Algebra 𝒜 R] [Algebra (CyclotomicQuotient l') R]
  [IsScalarTower 𝒜 (CyclotomicQuotient l') R]

/-- **[Lus] Thm. 35.1.7** (in the generality of 35.1.3): for an `𝒜'`-algebra `R`, the quantum
Frobenius homomorphism `Fr : _R f → _R f*`, obtained from `Fr` over `𝒜'` by change of rings. -/
def frobGeneral :
    R ⊗[𝒜] quotientIntegralForm D →ₐ[R] R ⊗[𝒜] quotientIntegralForm (D.frobenius hl0) :=
  (cancelBaseChangeRing 𝒜 (CyclotomicQuotient l') R
      (quotientIntegralForm (D.frobenius hl0))).toAlgHom.comp
    ((Algebra.TensorProduct.map (AlgHom.id R R) (frobCyclotomic D hl0 hl' hA)).comp
      (cancelBaseChangeRing 𝒜 (CyclotomicQuotient l') R (quotientIntegralForm D)).symm.toAlgHom)

/-- **[Lus] Thm. 35.1.7**: `Fr(θᵢ^{(n)}) = θᵢ^{(n/lᵢ)}` if `lᵢ ∣ n`, and `0` otherwise, over any
`𝒜'`-algebra. -/
theorem frobGeneral_integralGenerator (i : I) (n : ℕ) :
    frobGeneral D hl0 hl' hA R ((1 : R) ⊗ₜ integralGenerator D i n) =
      frobValue D hl0 R i n := by
  simp only [frobGeneral, AlgHom.comp_apply, AlgEquiv.coe_toAlgHom,
    cancelBaseChangeRing_symm_tmul, Algebra.TensorProduct.map_tmul,
    frobCyclotomic_integralGenerator, AlgHom.id_apply, frobValue]
  split_ifs
  · rw [cancelBaseChangeRing_tmul, Algebra.smul_def, map_one, one_mul]
  · rw [TensorProduct.tmul_zero]
    exact (cancelBaseChangeRing 𝒜 (CyclotomicQuotient l') R _).map_zero

/-- `Fr` is the unique `R`-algebra homomorphism `_R f → _R f*` with the values of
[Lus] Thm. 35.1.7 on the `θᵢ^{(n)}`. -/
theorem eq_frobGeneral
    (φ : R ⊗[𝒜] quotientIntegralForm D →ₐ[R] R ⊗[𝒜] quotientIntegralForm (D.frobenius hl0))
    (hφ : ∀ i n, φ ((1 : R) ⊗ₜ integralGenerator D i n) = frobValue D hl0 R i n) :
    φ = frobGeneral D hl0 hl' hA R := by
  refine AlgHom.ext_of_adjoin_eq_top (adjoin_baseChangeGenerator D R) ?_
  rintro _ ⟨⟨i, n⟩, rfl⟩
  rw [hφ, frobGeneral_integralGenerator]

end General

end LieLean.QuantumGroup

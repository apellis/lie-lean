import LieLean.Algebra.QuantumGroup.TriangularRep

/-!
# Triangular decomposition of `U_q(𝔤)`

Let `J ⊆ 'f` be the two-sided ideal generated by the quantum Serre elements, `V = 'f ⊗ k[Y] ⊗ 'f`
the space of `QuantumGroup.TriangularRep` with its operators `Eᵢ, Fᵢ, K_μ`, and
`W = J ⊗ k[Y] ⊗ 'f + 'f ⊗ k[Y] ⊗ J ⊆ V`. For `v` not a root of unity we show that `W` is stable
under the operators, that on `V ⧸ W` they also satisfy the quantum Serre relations, hence define a
representation of `U`, and that evaluating at the class of `1 ⊗ 1 ⊗ 1` inverts the multiplication
map `V ⧸ W → U`, `y ⊗ e^μ ⊗ x ↦ y⁻ K_μ x⁺`. The key point for the Serre relations for the `Eᵢ` is
that the Serre operator `T` commutes with all `Fₗ` (by `rₗ(S) = ₗr(S) = 0` for the Serre element
`S`, [Lus] 1.4.3 (check)), while `V` is generated by `1 ⊗ k[Y] ⊗ 'f` under the `Fₗ`, on which
`T` acts by right multiplication with a twisted copy of `S`. This is our own rendering of the
standard argument ([Jan] 4.21 (check)); the identification of `'f ⧸ J` with Lusztig's `f` is the
quantum Gabber–Kac theorem and is not used.

## Main definitions

* `Submodule.endStab`, `Submodule.endDescend`: endomorphisms preserving a submodule and their
  action on the quotient.
* `QuantumGroup.serreTriSubmodule`: the submodule `W`.
* `QuantumGroup.triRep`: the representation of `U` on `V ⧸ W`.
* `QuantumGroup.triMap`, `QuantumGroup.triQuotMap`: the multiplication maps `V → U`, `V ⧸ W → U`.
* `QuantumGroup.triangularEquiv`: the linear isomorphism `V ⧸ W ≃ U`.

## Main results

* `QuantumGroup.relations_triQuot`: the operators on `V ⧸ W` satisfy the relations of `U`.
* `QuantumGroup.triangularEquiv_mk`: `triangularEquiv (y ⊗ e^μ ⊗ x) = y⁻ K_μ x⁺`
  (triangular decomposition, [Jan] Thm. 4.21 (check), [Lus] Cor. 3.2.5 (check)).
* `QuantumGroup.plusHom_eq_zero_iff`, `QuantumGroup.minusHom_eq_zero_iff`: the kernels of
  `'f → U`, `x ↦ x^±` are the Serre ideal, i.e. `U^± ≅ 'f ⧸ J`.
* `QuantumGroup.zeroHom_injective`: the `K_μ` are linearly independent.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, §3.2.
* [Jan] J. C. Jantzen, *Lectures on quantum groups*, GSM 6, §4.21.
-/

noncomputable section

/-! ### Endomorphisms preserving a submodule -/

namespace Submodule

variable {k M : Type*} [Field k] [AddCommGroup M] [Module k M] (W : Submodule k M)

/-- The subalgebra of endomorphisms `X` with `X(W) ⊆ W`. -/
def endStab : Subalgebra k (Module.End k M) where
  carrier := {X | W ≤ W.comap X}
  mul_mem' {X Y} hX hY w hw := hX (hY hw)
  add_mem' {X Y} hX hY w hw := W.add_mem (hX hw) (hY hw)
  algebraMap_mem' c w hw := by
    simp only [mem_comap, Module.algebraMap_end_apply]
    exact W.smul_mem c hw

instance : Ring W.endStab := Subalgebra.toRing _

instance : Algebra k W.endStab := Subalgebra.algebra _

lemma mem_endStab {X : Module.End k M} : X ∈ W.endStab ↔ ∀ w ∈ W, X w ∈ W := Iff.rfl

/-- Passing to the quotient: the algebra homomorphism `endStab W → End(M ⧸ W)`. -/
def endDescend : W.endStab →ₐ[k] Module.End k (M ⧸ W) where
  toFun X := W.mapQ W X.1 X.2
  map_one' := by ext; simp
  map_mul' X Y := by ext; rfl
  map_zero' := by ext; simp
  map_add' X Y := by ext; rfl
  commutes' c := by ext; simp [Module.algebraMap_end_apply]

@[simp] lemma endDescend_mk (X : W.endStab) (x : M) :
    W.endDescend X (Submodule.Quotient.mk x) = Submodule.Quotient.mk (X.1 x) := rfl

lemma endDescend_eq_zero {X : W.endStab} (h : ∀ x, X.1 x ∈ W) : W.endDescend X = 0 := by
  ext x
  simpa using (Submodule.Quotient.mk_eq_zero W).2 (h x)

end Submodule

namespace QuantumGroup

open LusztigF TensorProduct

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {v : k}

section MapRelations

variable {A B : Type*} [Ring A] [Algebra k A] [Ring B] [Algebra k B] {e f : I → A}
  {κ : Multiplicative Y →* A}

lemma PreRelations.map (h : PreRelations R v e f κ) (φ : A →ₐ[k] B) :
    PreRelations R v (φ ∘ e) (φ ∘ f) (φ.toMonoidHom.comp κ) where
  K_mul_E μ i := by simpa [map_mul, map_smul] using congr_arg φ (h.K_mul_E μ i)
  K_mul_F μ i := by simpa [map_mul, map_smul] using congr_arg φ (h.K_mul_F μ i)
  E_mul_F i j := by
    have := congr_arg φ (h.E_mul_F i j)
    split_ifs at this ⊢ <;> simpa [map_sub, map_mul, map_smul] using this

lemma Relations.map (h : Relations R v e f κ) (φ : A →ₐ[k] B) :
    Relations R v (φ ∘ e) (φ ∘ f) (φ.toMonoidHom.comp κ) :=
  { h.toPreRelations.map φ with
    serre_E := fun i j hij ↦ by simpa [map_qSerre] using congr_arg φ (h.serre_E i j hij)
    serre_F := fun i j hij ↦ by simpa [map_qSerre] using congr_arg φ (h.serre_F i j hij) }

lemma PreRelations.of_injective (φ : A →ₐ[k] B) (hφ : Function.Injective φ)
    (h : PreRelations R v (φ ∘ e) (φ ∘ f) (φ.toMonoidHom.comp κ)) : PreRelations R v e f κ where
  K_mul_E μ i := hφ (by simpa [map_mul, map_smul] using h.K_mul_E μ i)
  K_mul_F μ i := hφ (by simpa [map_mul, map_smul] using h.K_mul_F μ i)
  E_mul_F i j := hφ (by
    have := h.E_mul_F i j
    split_ifs at this ⊢ <;> simpa [map_sub, map_mul, map_smul] using this)

end MapRelations

section Descend

variable {M : Type*} [AddCommGroup M] [Module k M] (W : Submodule k M)

/-- The monoid homomorphism into `End(M ⧸ W)` induced by one into `End(M)` preserving `W`. -/
def descendHom (κ : Multiplicative Y →* Module.End k M) (hκ : ∀ μ, κ μ ∈ W.endStab) :
    Multiplicative Y →* Module.End k (M ⧸ W) where
  toFun μ := W.endDescend ⟨κ μ, hκ μ⟩
  map_one' := by ext x; simp
  map_mul' a b := by ext x; simp

omit [AddCommGroup Y] [DecidableEq I] in
lemma lift_endDescend_mk {e : I → Module.End k M} (he : ∀ i, e i ∈ W.endStab)
    (x : LusztigF k I) (z : M) :
    FreeAlgebra.lift k (fun i ↦ W.endDescend ⟨e i, he i⟩) x (Submodule.Quotient.mk z) =
      Submodule.Quotient.mk (FreeAlgebra.lift k e x z) := by
  induction x using FreeAlgebra.induction generalizing z with
  | grade0 c => simp [Module.algebraMap_end_apply]
  | grade1 i => simp
  | mul a b ha hb => simp only [map_mul, Module.End.mul_apply, hb, ha]
  | add a b ha hb => simp only [map_add, LinearMap.add_apply, ha, hb, Submodule.Quotient.mk_add]

variable {W} {e f : I → Module.End k M} {κ : Multiplicative Y →* Module.End k M}

/-- Relations (b)–(d) descend to a quotient by a stable submodule. -/
theorem PreRelations.descend (h : PreRelations R v e f κ) (he : ∀ i, e i ∈ W.endStab)
    (hf : ∀ i, f i ∈ W.endStab) (hκ : ∀ μ, κ μ ∈ W.endStab) :
    PreRelations R v (fun i ↦ W.endDescend ⟨e i, he i⟩) (fun i ↦ W.endDescend ⟨f i, hf i⟩)
      (descendHom W κ hκ) where
  K_mul_E μ i := by
    ext x
    simpa [descendHom] using congr_arg (Submodule.Quotient.mk (p := W))
      (LinearMap.congr_fun (h.K_mul_E μ i) x)
  K_mul_F μ i := by
    ext x
    simpa [descendHom] using congr_arg (Submodule.Quotient.mk (p := W))
      (LinearMap.congr_fun (h.K_mul_F μ i) x)
  E_mul_F i j := by
    have := h.E_mul_F i j
    ext x
    split_ifs at this ⊢ <;>
    simpa [descendHom] using congr_arg (Submodule.Quotient.mk (p := W))
      (LinearMap.congr_fun this x)

/-- The defining relations of `U` descend to a quotient by a stable submodule, provided the
Serre operators map everything into it. -/
theorem Relations.descend (h : PreRelations R v e f κ) (he : ∀ i, e i ∈ W.endStab)
    (hf : ∀ i, f i ∈ W.endStab) (hκ : ∀ μ, κ μ ∈ W.endStab)
    (hsE : ∀ i j, i ≠ j → ∀ z,
      qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (e i) (e j) z ∈ W)
    (hsF : ∀ i j, i ≠ j → ∀ z,
      qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (f i) (f j) z ∈ W) :
    Relations R v (fun i ↦ W.endDescend ⟨e i, he i⟩) (fun i ↦ W.endDescend ⟨f i, hf i⟩)
      (descendHom W κ hκ) :=
  { h.descend he hf hκ with
    serre_E := fun i j hij ↦ by
      rw [← map_qSerre]
      refine W.endDescend_eq_zero fun z ↦ ?_
      have h1 : ((qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat ⟨e i, he i⟩ ⟨e j, he j⟩ :
          W.endStab) : Module.End k M) =
          qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (e i) (e j) :=
        map_qSerre W.endStab.val _ _ _
      rw [h1]
      exact hsE i j hij z
    serre_F := fun i j hij ↦ by
      rw [← map_qSerre]
      refine W.endDescend_eq_zero fun z ↦ ?_
      have h1 : ((qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat ⟨f i, hf i⟩ ⟨f j, hf j⟩ :
          W.endStab) : Module.End k M) =
          qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (f i) (f j) :=
        map_qSerre W.endStab.val _ _ _
      rw [h1]
      exact hsF i j hij z }

end Descend

/-! ### The submodule `W` and its stability -/

variable (Y D v) in
/-- The submodule `W = J ⊗ k[Y] ⊗ 'f + 'f ⊗ k[Y] ⊗ J` of `V`, `J` the Serre ideal. -/
def serreTriSubmodule : Submodule k (TriSpace k I Y) :=
  Submodule.span k {z | ∃ (y : LusztigF k I) (g : AddMonoidAlgebra k Y) (x : LusztigF k I),
    z = y ⊗ₜ (g ⊗ₜ x) ∧ (y ∈ serreIdeal D v ∨ x ∈ serreIdeal D v)}

omit [AddCommGroup Y] [DecidableEq I] in
lemma tmul_mem_serreTriSubmodule_left {y : LusztigF k I} (hy : y ∈ serreIdeal D v)
    (g : AddMonoidAlgebra k Y) (x : LusztigF k I) :
    y ⊗ₜ (g ⊗ₜ x) ∈ serreTriSubmodule Y D v :=
  Submodule.subset_span ⟨y, g, x, rfl, Or.inl hy⟩

omit [AddCommGroup Y] [DecidableEq I] in
lemma tmul_mem_serreTriSubmodule_right (y : LusztigF k I) (g : AddMonoidAlgebra k Y)
    {x : LusztigF k I} (hx : x ∈ serreIdeal D v) :
    y ⊗ₜ (g ⊗ₜ x) ∈ serreTriSubmodule Y D v :=
  Submodule.subset_span ⟨y, g, x, rfl, Or.inr hx⟩

omit [AddCommGroup Y] [DecidableEq I] in
lemma tmul_mem_serreTriSubmodule_left' {y : LusztigF k I} (hy : y ∈ serreIdeal D v)
    (w : AddMonoidAlgebra k Y ⊗[k] LusztigF k I) : y ⊗ₜ w ∈ serreTriSubmodule Y D v := by
  induction w using TensorProduct.inductionOn with
  | tmul g x => exact tmul_mem_serreTriSubmodule_left hy g x
  | add w w' hw hw' => rw [tmul_add]; exact Submodule.add_mem _ hw hw'

omit [AddCommGroup Y] [DecidableEq I] in
lemma tri_mem_endStab {a c : Module.End k (LusztigF k I)} (b : Module.End k (AddMonoidAlgebra k Y))
    (ha : ∀ y ∈ serreIdeal D v, a y ∈ serreIdeal D v)
    (hc : ∀ x ∈ serreIdeal D v, c x ∈ serreIdeal D v) :
    tri a b c ∈ (serreTriSubmodule Y D v).endStab := by
  rw [Submodule.mem_endStab]
  intro w hw
  induction hw using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨y, g, x, rfl, h⟩ := hz
    rcases h with h | h
    · exact tmul_mem_serreTriSubmodule_left (ha y h) _ _
    · exact tmul_mem_serreTriSubmodule_right _ _ (hc x h)
  | zero => simp
  | add z z' _ _ hz hz' => rw [map_add]; exact Submodule.add_mem _ hz hz'
  | smul c z _ hz => rw [map_smul]; exact Submodule.smul_mem _ _ hz

variable (R v)

omit [AddCommGroup Y] [DecidableEq I] in
lemma opF_mem_endStab (i : I) : opF (k := k) (Y := Y) i ∈ (serreTriSubmodule Y D v).endStab :=
  tri_mem_endStab _ (fun _ hy ↦ TwoSidedIdeal.mul_mem_left _ _ _ hy) (fun _ hx ↦ hx)

omit [DecidableEq I] in
lemma opK_mem_endStab (ν : Y) : opK R v ν ∈ (serreTriSubmodule Y D v).endStab :=
  tri_mem_endStab _ (fun _ hy ↦ diagTwist_mem_serreIdeal _ hy) (fun _ hx ↦ hx)

variable [NeZero v]

lemma opE_mem_endStab (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) (i : I) :
    opE R v i ∈ (serreTriSubmodule Y D v).endStab := by
  have h0 : opE0 R v i ∈ (serreTriSubmodule Y D v).endStab :=
    tri_mem_endStab _ (fun _ hy ↦ hy) (fun _ hx ↦ TwoSidedIdeal.mul_mem_left _ _ _ hx)
  have hp : opEp R v i ∈ (serreTriSubmodule Y D v).endStab :=
    tri_mem_endStab _ (fun _ hy ↦ diagTwist_mem_serreIdeal _
      (lDeriv_mem_serreIdeal (NeZero.ne v) hv' i hy)) (fun _ hx ↦ hx)
  have hm : opEm R v i ∈ (serreTriSubmodule Y D v).endStab :=
    tri_mem_endStab _ (fun _ hy ↦ rDeriv_mem_serreIdeal (NeZero.ne v) hv' i hy) (fun _ hx ↦ hx)
  exact Subalgebra.add_mem _ (Subalgebra.add_mem _ h0 (Subalgebra.smul_mem _ hp _))
    (Subalgebra.smul_mem _ hm _)

/-! ### The Serre operators on `V` -/

omit [AddCommGroup Y] [DecidableEq I] [NeZero v] in
lemma lift_opF_tmul (y z : LusztigF k I) (w : AddMonoidAlgebra k Y ⊗[k] LusztigF k I) :
    FreeAlgebra.lift k (opF (k := k) (Y := Y)) y (z ⊗ₜ w) = (y * z) ⊗ₜ w := by
  induction y using FreeAlgebra.induction generalizing z with
  | grade0 c =>
    simp [Module.algebraMap_end_apply, Algebra.smul_def, TensorProduct.smul_tmul']
  | grade1 l => simp [opF, tri, TensorProduct.map_one]
  | mul a b ha hb => rw [map_mul, Module.End.mul_apply, hb, ha, mul_assoc]
  | add a b ha hb => rw [map_add, LinearMap.add_apply, ha, hb, add_mul, add_tmul]

omit [AddCommGroup Y] [DecidableEq I] [NeZero v] in
lemma lift_opF_mem_endStab (y : LusztigF k I) :
    FreeAlgebra.lift k (opF (k := k) (Y := Y)) y ∈ (serreTriSubmodule Y D v).endStab := by
  induction y using FreeAlgebra.induction with
  | grade0 c => rw [AlgHom.commutes]; exact Subalgebra.algebraMap_mem _ c
  | grade1 l => rw [FreeAlgebra.lift_ι_apply]; exact opF_mem_endStab v l
  | mul a b ha hb => rw [map_mul]; exact Subalgebra.mul_mem _ ha hb
  | add a b ha hb => rw [map_add]; exact Subalgebra.add_mem _ ha hb

omit [AddCommGroup Y] [DecidableEq I] in
lemma qSerre_opF_mem (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) {i j : I} (hij : i ≠ j)
    (z : TriSpace k I Y) :
    qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (opF i) (opF j) z ∈
      serreTriSubmodule Y D v := by
  have hS := qSerre_mem_serreIdeal (D := D) (v := v) (k := k) hij
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i _)
  have h1 : qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (opF (k := k) (Y := Y) i) (opF j) =
      FreeAlgebra.lift k opF
        (qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (θ k i) (θ k j)) := by
    have := map_qSerre (FreeAlgebra.lift k (opF (k := k) (Y := Y))) (v := v ^ D.d i)
      (1 - D.cartanMatrix i j).toNat (θ k i) (θ k j)
    rw [FreeAlgebra.lift_ι_apply, FreeAlgebra.lift_ι_apply] at this
    exact this.symm
  rw [h1]
  induction z using TensorProduct.inductionOn with
  | tmul y w =>
    rw [lift_opF_tmul]
    exact tmul_mem_serreTriSubmodule_left' (TwoSidedIdeal.mul_mem_right _ _ y hS) w
  | add z z' hz hz' => rw [map_add]; exact Submodule.add_mem _ hz hz'

lemma lift_opE_one_tmul (z : LusztigF k I) (μ : Y) (x : LusztigF k I) :
    FreeAlgebra.lift k (opE R v) z (1 ⊗ₜ (AddMonoidAlgebra.single μ 1 ⊗ₜ x)) =
      1 ⊗ₜ (AddMonoidAlgebra.single μ 1 ⊗ₜ (tau R v μ z * x)) := by
  induction z using FreeAlgebra.induction generalizing x with
  | grade0 c =>
    simp only [AlgHom.commutes, Module.algebraMap_end_apply]
    rw [← Algebra.smul_def, TensorProduct.tmul_smul, TensorProduct.tmul_smul]
  | grade1 i =>
    simp [opE, opE0, opEp, opEm, tri, chi_single, tau_apply_θ, TensorProduct.smul_tmul',
      TensorProduct.tmul_smul]
  | mul a b ha hb => rw [map_mul, Module.End.mul_apply, hb, ha, map_mul, mul_assoc]
  | add a b ha hb => rw [map_add, LinearMap.add_apply, ha, hb, map_add, add_mul, tmul_add,
      tmul_add]

lemma qSerre_opE_mem (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) {i j : I} (hij : i ≠ j)
    (z : TriSpace k I Y) :
    qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (opE R v i) (opE R v j) z ∈
      serreTriSubmodule Y D v := by
  set S := qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (θ k i) (θ k j) with hS_def
  have hS : S ∈ serreIdeal D v := qSerre_mem_serreIdeal hij
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i _)
  set T := FreeAlgebra.lift k (opE R v) S with hT_def
  have h1 : qSerre (v ^ D.d i) (1 - D.cartanMatrix i j).toNat (opE R v i) (opE R v j) = T := by
    have := map_qSerre (FreeAlgebra.lift k (opE R v)) (v := v ^ D.d i)
      (1 - D.cartanMatrix i j).toNat (θ k i) (θ k j)
    rw [FreeAlgebra.lift_ι_apply, FreeAlgebra.lift_ι_apply] at this
    exact this.symm
  -- `T` commutes with the `Fₗ`
  have hTF : ∀ l, T * opF l = opF l * T := fun l ↦ by
    have := (preRelations_op R v).lift_mul_sub (NeZero.ne v) l S
    have h0 : FreeAlgebra.lift k (opE R v) (rDeriv D v l S) = 0 := by
      rw [rDeriv_qSerre (NeZero.ne v) hij]; exact map_zero _
    have h0' : FreeAlgebra.lift k (opE R v) (lDeriv D v l S) = 0 := by
      rw [lDeriv_qSerre (NeZero.ne v) hij]; exact map_zero _
    rw [h0, h0', zero_mul, mul_zero] at this
    exact sub_eq_zero.1 (this.trans (by module))
  have hTy : ∀ y : LusztigF k I, T * FreeAlgebra.lift k opF y = FreeAlgebra.lift k opF y * T := by
    intro y
    induction y using FreeAlgebra.induction with
    | grade0 c => rw [AlgHom.commutes, Algebra.commutes]
    | grade1 l => rw [FreeAlgebra.lift_ι_apply, hTF]
    | mul a b ha hb => rw [map_mul, ← mul_assoc, ha, mul_assoc, hb, mul_assoc]
    | add a b ha hb => rw [map_add, mul_add, add_mul, ha, hb]
  rw [h1]
  induction z using TensorProduct.inductionOn with
  | tmul y w =>
    have hyw : y ⊗ₜ[k] w = FreeAlgebra.lift k opF y ((1 : LusztigF k I) ⊗ₜ[k] w) := by
      rw [lift_opF_tmul, mul_one]
    rw [hyw, ← Module.End.mul_apply, hTy, Module.End.mul_apply]
    refine (Submodule.mem_endStab _).1 (lift_opF_mem_endStab v y) _ ?_
    clear hyw
    induction w using TensorProduct.inductionOn with
    | tmul g x =>
      induction g using AddMonoidAlgebra.induction_on with
      | of μ =>
        change T (1 ⊗ₜ (AddMonoidAlgebra.single μ 1 ⊗ₜ x)) ∈ _
        rw [hT_def, lift_opE_one_tmul]
        have hτ : tau R v μ S ∈ serreIdeal D v := diagTwist_mem_serreIdeal _ hS
        exact tmul_mem_serreTriSubmodule_right _ _ (TwoSidedIdeal.mul_mem_right _ _ _ hτ)
      | add g g' hg hg' => rw [add_tmul, tmul_add, map_add]; exact Submodule.add_mem _ hg hg'
      | smul c g hg =>
        rw [← smul_tmul', tmul_smul, map_smul]; exact Submodule.smul_mem _ _ hg
    | add w w' hw hw' => rw [tmul_add, map_add]; exact Submodule.add_mem _ hw hw'
  | add z z' hz hz' => rw [map_add]; exact Submodule.add_mem _ hz hz'

/-! ### The representation of `U` on `V ⧸ W` -/

/-- The operators `Eᵢ, Fᵢ, K_μ` on `V ⧸ W` satisfy the defining relations of `U`. -/
theorem relations_triQuot (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) :
    Relations R v
      (fun i ↦ (serreTriSubmodule Y D v).endDescend ⟨opE R v i, opE_mem_endStab R v hv' i⟩)
      (fun i ↦ (serreTriSubmodule Y D v).endDescend ⟨opF i, opF_mem_endStab v i⟩)
      (descendHom _ (opKHom R v) fun μ ↦ opK_mem_endStab R v μ.toAdd) :=
  Relations.descend (preRelations_op R v) _ _ _ (fun _ _ hij z ↦ qSerre_opE_mem R v hv' hij z)
    (fun _ _ hij z ↦ qSerre_opF_mem v hv' hij z)

/-- The representation of `U` on `V ⧸ W = ('f ⊗ k[Y] ⊗ 'f) ⧸ W`. -/
def triRep (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) :
    QuantumGroup R v →ₐ[k] Module.End k (TriSpace k I Y ⧸ serreTriSubmodule Y D v) :=
  lift (relations_triQuot R v hv')

variable (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)

lemma triRep_plusHom_mk (x : LusztigF k I) (z : TriSpace k I Y) :
    triRep R v hv' (plusHom R v x) (Submodule.Quotient.mk z) =
      Submodule.Quotient.mk (FreeAlgebra.lift k (opE R v) x z) := by
  have h : (triRep R v hv').comp (plusHom R v) = FreeAlgebra.lift k
      (fun i ↦ (serreTriSubmodule Y D v).endDescend ⟨opE R v i, opE_mem_endStab R v hv' i⟩) :=
    FreeAlgebra.hom_ext (funext fun i ↦ by simp [triRep])
  rw [← AlgHom.comp_apply, h, lift_endDescend_mk]

lemma triRep_minusHom_mk (y : LusztigF k I) (z : TriSpace k I Y) :
    triRep R v hv' (minusHom R v y) (Submodule.Quotient.mk z) =
      Submodule.Quotient.mk (FreeAlgebra.lift k opF y z) := by
  have h : (triRep R v hv').comp (minusHom R v) = FreeAlgebra.lift k
      (fun i ↦ (serreTriSubmodule Y D v).endDescend ⟨opF i, opF_mem_endStab v i⟩) :=
    FreeAlgebra.hom_ext (funext fun i ↦ by simp [triRep])
  rw [← AlgHom.comp_apply, h, lift_endDescend_mk]

lemma triRep_zeroHom_mk (g : AddMonoidAlgebra k Y) (x : LusztigF k I) :
    triRep R v hv' (zeroHom R v g) (Submodule.Quotient.mk (1 ⊗ₜ (1 ⊗ₜ x))) =
      Submodule.Quotient.mk (1 ⊗ₜ (g ⊗ₜ x)) := by
  induction g using AddMonoidAlgebra.induction_on with
  | of μ =>
    change triRep R v hv' (zeroHom R v (AddMonoidAlgebra.single μ 1)) _ =
      Submodule.Quotient.mk (1 ⊗ₜ (AddMonoidAlgebra.single μ 1 ⊗ₜ x))
    simp [triRep, descendHom, opKHom_apply, opK, shift]
  | add g g' hg hg' =>
    have key : ∀ (A B : Module.End k (TriSpace k I Y ⧸ serreTriSubmodule Y D v)) q,
        (A + B) q = A q + B q := fun _ _ _ ↦ rfl
    rw [map_add, map_add, key, hg, hg', add_tmul, tmul_add, Submodule.Quotient.mk_add]
  | smul c g hg =>
    have key : ∀ (A : Module.End k (TriSpace k I Y ⧸ serreTriSubmodule Y D v)) q,
        (c • A) q = c • A q := fun _ _ ↦ rfl
    rw [map_smul, map_smul, key, hg, ← Submodule.Quotient.mk_smul, ← smul_tmul', tmul_smul]

/-! ### The multiplication map `V → U` -/

omit [NeZero v] in
variable {R v} in
/-- The linear map `'f ⊗ k[Y] ⊗ 'f → U`, `y ⊗ e^μ ⊗ x ↦ y⁻ K_μ x⁺`. -/
def triMap : TriSpace k I Y →ₗ[k] QuantumGroup R v :=
  TensorProduct.lift (((LinearMap.mul k (QuantumGroup R v)).comp
      (minusHom R v).toLinearMap).compl₂
    (TensorProduct.lift (((LinearMap.mul k (QuantumGroup R v)).comp
      (zeroHom R v).toLinearMap).compl₂ (plusHom R v).toLinearMap)))

omit [NeZero v] in
@[simp] lemma triMap_tmul (y : LusztigF k I) (g : AddMonoidAlgebra k Y) (x : LusztigF k I) :
    triMap (R := R) (v := v) (y ⊗ₜ (g ⊗ₜ x)) = minusHom R v y * (zeroHom R v g * plusHom R v x) :=
  rfl

omit [NeZero v] in
include hv' in
lemma serreTriSubmodule_le_ker (hv : v ≠ 0) :
    serreTriSubmodule Y D v ≤ LinearMap.ker (triMap (R := R) (v := v)) := by
  rw [serreTriSubmodule, Submodule.span_le]
  rintro _ ⟨y, g, x, rfl, h | h⟩
  · have := (TwoSidedIdeal.mem_ker _).1 (serreIdeal_le_ker_minusHom (R := R) hv hv' h)
    simp [this]
  · have := (TwoSidedIdeal.mem_ker _).1 (serreIdeal_le_ker_plusHom (R := R) hv hv' h)
    simp [this]

/-- The map `V ⧸ W → U` induced by `y ⊗ e^μ ⊗ x ↦ y⁻ K_μ x⁺`. -/
def triQuotMap : (TriSpace k I Y ⧸ serreTriSubmodule Y D v) →ₗ[k] QuantumGroup R v :=
  (serreTriSubmodule Y D v).liftQ triMap (serreTriSubmodule_le_ker R v hv' (NeZero.ne v))

@[simp] lemma triQuotMap_mk (z : TriSpace k I Y) :
    triQuotMap R v hv' (Submodule.Quotient.mk z) = triMap z := rfl

lemma triRep_triMap (z : TriSpace k I Y) :
    triRep R v hv' (triMap z) (Submodule.Quotient.mk (1 ⊗ₜ (1 ⊗ₜ 1))) =
      Submodule.Quotient.mk z := by
  induction z using TensorProduct.inductionOn with
  | tmul y w =>
    induction w using TensorProduct.inductionOn with
    | tmul g x =>
      have hx : FreeAlgebra.lift k (opE R v) x (1 ⊗ₜ (1 ⊗ₜ 1)) =
          (1 : LusztigF k I) ⊗ₜ ((1 : AddMonoidAlgebra k Y) ⊗ₜ x) := by
        rw [AddMonoidAlgebra.one_def, lift_opE_one_tmul, mul_one]
        congr 3
        exact LinearMap.congr_fun (tau_zero (R := R) (v := v)) x
      rw [triMap_tmul, map_mul, map_mul, Module.End.mul_apply, Module.End.mul_apply,
        triRep_plusHom_mk, hx, triRep_zeroHom_mk, triRep_minusHom_mk, lift_opF_tmul, mul_one]
    | add w w' hw hw' => rw [tmul_add, map_add, map_add, LinearMap.add_apply, hw, hw',
        Submodule.Quotient.mk_add]
  | add z z' hz hz' => rw [map_add, map_add, LinearMap.add_apply, hz, hz',
      Submodule.Quotient.mk_add]

lemma triRep_triQuotMap (q : TriSpace k I Y ⧸ serreTriSubmodule Y D v) :
    triRep R v hv' (triQuotMap R v hv' q) (Submodule.Quotient.mk (1 ⊗ₜ (1 ⊗ₜ 1))) = q := by
  induction q using Submodule.Quotient.induction_on with
  | H z => exact triRep_triMap R v hv' z

lemma triQuotMap_injective : Function.Injective (triQuotMap R v hv') := fun a b h ↦ by
  rw [← triRep_triQuotMap R v hv' a, ← triRep_triQuotMap R v hv' b, h]

lemma triQuotMap_surjective : Function.Surjective (triQuotMap R v hv') := by
  rw [← LinearMap.range_eq_top, eq_top_iff, ← span_triangular (R := R) (NeZero.ne v),
    triangularSpan, Submodule.span_le]
  rintro _ ⟨w, μ, w', rfl⟩
  refine ⟨Submodule.Quotient.mk (monomial k w ⊗ₜ (AddMonoidAlgebra.single μ 1 ⊗ₜ monomial k w')),
    ?_⟩
  simp [mul_assoc]

/-- **Triangular decomposition** of `U` ([Jan] Thm. 4.21 (check), [Lus] Cor. 3.2.5 (check)):
multiplication `y ⊗ e^μ ⊗ x ↦ y⁻ K_μ x⁺` induces a linear isomorphism
`('f ⊗ k[Y] ⊗ 'f) ⧸ (J ⊗ k[Y] ⊗ 'f + 'f ⊗ k[Y] ⊗ J) ≃ U`, where `J` is the ideal of `'f`
generated by the quantum Serre elements. Requires `v` not a root of unity. -/
def triangularEquiv : (TriSpace k I Y ⧸ serreTriSubmodule Y D v) ≃ₗ[k] QuantumGroup R v :=
  LinearEquiv.ofBijective (triQuotMap R v hv')
    ⟨triQuotMap_injective R v hv', triQuotMap_surjective R v hv'⟩

@[simp] theorem triangularEquiv_mk (y : LusztigF k I) (g : AddMonoidAlgebra k Y)
    (x : LusztigF k I) :
    triangularEquiv R v hv' (Submodule.Quotient.mk (y ⊗ₜ (g ⊗ₜ x))) =
      minusHom R v y * zeroHom R v g * plusHom R v x := by
  rw [mul_assoc]; rfl

include hv' in
lemma mem_serreTriSubmodule_of_triMap_eq_zero {z : TriSpace k I Y}
    (hz : triMap (R := R) (v := v) z = 0) : z ∈ serreTriSubmodule Y D v := by
  rw [← Submodule.Quotient.mk_eq_zero]
  exact triQuotMap_injective R v hv' (by rw [triQuotMap_mk, hz, map_zero])

/-! ### Consequences: `U⁺ ≅ 'f ⧸ J`, `U⁻ ≅ 'f ⧸ J`, `U⁰ ≅ k[Y]` -/

omit [NeZero v] in
variable (Y) in
/-- The augmentation `k[Y] → k`, `e^μ ↦ 1`. -/
def augmentation : AddMonoidAlgebra k Y →ₐ[k] k := AddMonoidAlgebra.lift k k Y 1

omit [NeZero v] in
@[simp] lemma augmentation_single (μ : Y) (c : k) :
    augmentation Y (AddMonoidAlgebra.single μ c) = c := by
  simp [augmentation, AddMonoidAlgebra.lift_single]

variable (D) in
/-- The Serre ideal `J` as a `k`-submodule of `'f`. -/
abbrev serreSubmodule : Submodule k (LusztigF k I) :=
  (TwoSidedIdeal.asIdeal (serreIdeal D v)).restrictScalars k

omit [NeZero v] [DecidableEq I] in
variable {v} in
lemma mem_serreSubmodule {x : LusztigF k I} : x ∈ serreSubmodule D v ↔ x ∈ serreIdeal D v :=
  TwoSidedIdeal.mem_asIdeal

include hv' in
/-- The kernel of `x ↦ x⁺` is the Serre ideal ([Jan] Thm. 4.21 (check)); equivalently
`U⁺ ≅ 'f ⧸ J`. Requires `v` not a root of unity. -/
theorem plusHom_eq_zero_iff (x : LusztigF k I) : plusHom R v x = 0 ↔ x ∈ serreIdeal D v := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ (TwoSidedIdeal.mem_ker _).1
    (serreIdeal_le_ker_plusHom (R := R) (NeZero.ne v) hv' hx)⟩
  have hz : (1 : LusztigF k I) ⊗ₜ ((1 : AddMonoidAlgebra k Y) ⊗ₜ x) ∈ serreTriSubmodule Y D v :=
    mem_serreTriSubmodule_of_triMap_eq_zero R v hv' (by simp [hx])
  let π : TriSpace k I Y →ₗ[k] LusztigF k I ⧸ serreSubmodule D v :=
    (TensorProduct.lid k _).toLinearMap ∘ₗ TensorProduct.map counit.toLinearMap
      ((TensorProduct.lid k _).toLinearMap ∘ₗ
        TensorProduct.map (augmentation Y).toLinearMap (serreSubmodule D v).mkQ)
  have hπ : ∀ y g x', π (y ⊗ₜ (g ⊗ₜ x')) =
      counit y • augmentation Y g • Submodule.Quotient.mk (p := serreSubmodule D v) x' :=
    fun _ _ _ ↦ rfl
  have hW : serreTriSubmodule Y D v ≤ LinearMap.ker π := by
    rw [serreTriSubmodule, Submodule.span_le]
    rintro _ ⟨y, g, x', rfl, h | h⟩
    · simp [hπ, counit_eq_zero_of_mem_serreIdeal h]
    · have : Submodule.Quotient.mk (p := serreSubmodule D v) x' = 0 :=
        (Submodule.Quotient.mk_eq_zero _).2 (mem_serreSubmodule.2 h)
      simp [hπ, this]
  have := hW hz
  rw [LinearMap.mem_ker, hπ, map_one, map_one, one_smul, one_smul,
    Submodule.Quotient.mk_eq_zero] at this
  exact mem_serreSubmodule.1 this

include hv' in
/-- The kernel of `y ↦ y⁻` is the Serre ideal ([Jan] Thm. 4.21 (check)); equivalently
`U⁻ ≅ 'f ⧸ J`. Requires `v` not a root of unity. -/
theorem minusHom_eq_zero_iff (y : LusztigF k I) : minusHom R v y = 0 ↔ y ∈ serreIdeal D v := by
  refine ⟨fun hy ↦ ?_, fun hy ↦ (TwoSidedIdeal.mem_ker _).1
    (serreIdeal_le_ker_minusHom (R := R) (NeZero.ne v) hv' hy)⟩
  have hz : y ⊗ₜ ((1 : AddMonoidAlgebra k Y) ⊗ₜ (1 : LusztigF k I)) ∈ serreTriSubmodule Y D v :=
    mem_serreTriSubmodule_of_triMap_eq_zero R v hv' (by simp [hy])
  let π : TriSpace k I Y →ₗ[k] LusztigF k I ⧸ serreSubmodule D v :=
    (TensorProduct.rid k _).toLinearMap ∘ₗ TensorProduct.map (serreSubmodule D v).mkQ
      ((TensorProduct.lid k k).toLinearMap ∘ₗ
        TensorProduct.map (augmentation Y).toLinearMap counit.toLinearMap)
  have hπ : ∀ y' g x, π (y' ⊗ₜ (g ⊗ₜ x)) =
      (augmentation Y g • counit x) • Submodule.Quotient.mk (p := serreSubmodule D v) y' :=
    fun _ _ _ ↦ rfl
  have hW : serreTriSubmodule Y D v ≤ LinearMap.ker π := by
    rw [serreTriSubmodule, Submodule.span_le]
    rintro _ ⟨y', g, x, rfl, h | h⟩
    · have : Submodule.Quotient.mk (p := serreSubmodule D v) y' = 0 :=
        (Submodule.Quotient.mk_eq_zero _).2 (mem_serreSubmodule.2 h)
      simp [hπ, this]
    · simp [hπ, counit_eq_zero_of_mem_serreIdeal h]
  have := hW hz
  rw [LinearMap.mem_ker, hπ, map_one, map_one, one_smul, one_smul,
    Submodule.Quotient.mk_eq_zero] at this
  exact mem_serreSubmodule.1 this

include hv' in
/-- `e^μ ↦ K_μ` is injective, i.e. the `K_μ` (`μ ∈ Y`) are linearly independent in `U`
([Jan] Thm. 4.21 (check)). Requires `v` not a root of unity. -/
theorem zeroHom_injective : Function.Injective (zeroHom R v) := by
  rw [injective_iff_map_eq_zero]
  intro g hg
  have hz : (1 : LusztigF k I) ⊗ₜ (g ⊗ₜ (1 : LusztigF k I)) ∈ serreTriSubmodule Y D v :=
    mem_serreTriSubmodule_of_triMap_eq_zero R v hv' (by simp [hg])
  let π : TriSpace k I Y →ₗ[k] AddMonoidAlgebra k Y :=
    (TensorProduct.lid k _).toLinearMap ∘ₗ TensorProduct.map counit.toLinearMap
      ((TensorProduct.rid k _).toLinearMap ∘ₗ TensorProduct.map LinearMap.id counit.toLinearMap)
  have hπ : ∀ y g' x, π (y ⊗ₜ (g' ⊗ₜ x)) = counit y • counit x • g' := fun _ _ _ ↦ rfl
  have hW : serreTriSubmodule Y D v ≤ LinearMap.ker π := by
    rw [serreTriSubmodule, Submodule.span_le]
    rintro _ ⟨y, g', x, rfl, h | h⟩
    · simp [hπ, counit_eq_zero_of_mem_serreIdeal h]
    · simp [hπ, counit_eq_zero_of_mem_serreIdeal h]
  have := hW hz
  rwa [LinearMap.mem_ker, hπ, map_one, one_smul, one_smul] at this

end QuantumGroup

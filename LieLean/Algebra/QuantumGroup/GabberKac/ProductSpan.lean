import LieLean.Algebra.QuantumGroup.GabberKac.SerreSpan

/-!
# Weight components of ideals generated by homogeneous elements

Let `R` be a commutative ring and `s : J → FreeAlgebra R X` a family of homogeneous elements,
`s j` of weight `wt j`. The weight-`ν` component of any element of the two-sided ideal generated by
the `s j` is a linear combination of the products `a (s j) b` of weight `ν`, with words `a`, `b`
(`FreeAlgebra.weightProj_mem_productSpan`). This is the argument of
`LusztigF.weightProj_mem_serreSpan`, for an arbitrary homogeneous family; it applies to the super
Serre elements of contragredient Lie superalgebras and to the Serre elements of covering quantum
groups.

## Main definitions

* `FreeAlgebra.product s g`: the product `a (s j) b` for `g = (a, j, b)`.
* `FreeAlgebra.productSpan s wt ν`: the span of the products of weight `ν`.

## Main results

* `FreeAlgebra.productSpan_le_wordSpan`, `FreeAlgebra.product_mem_productSpan`.
* `FreeAlgebra.weightProj_mem_productSpan`: the weight components of the ideal.
-/

noncomputable section

namespace FreeAlgebra

variable {R X J : Type*} [CommRing R] (s : J → FreeAlgebra R X) (wt : J → X →₀ ℕ)

/-- The product `a (s j) b` for `g = (a, j, b)`, with words `a`, `b`. -/
def product (g : List X × J × List X) : FreeAlgebra R X :=
  wordBasis R X g.1 * s g.2.1 * wordBasis R X g.2.2

/-- The weight `|a| + wt j + |b|` of `product s (a, j, b)`. -/
def productWeight (g : List X × J × List X) : X →₀ ℕ :=
  LusztigF.wordWeight g.1 + wt g.2.1 + LusztigF.wordWeight g.2.2

/-- The span of the products `a (s j) b` of weight `ν`. -/
def productSpan (ν : X →₀ ℕ) : Submodule R (FreeAlgebra R X) :=
  Submodule.span R (product s '' {g | productWeight wt g = ν})

variable {s wt}

lemma product_mem (hs : ∀ j, s j ∈ wordSpan R (wt j)) (g : List X × J × List X) :
    product s g ∈ wordSpan R (productWeight wt g) := by
  classical
  have e : productWeight wt g - LusztigF.wordWeight g.2.2 =
      LusztigF.wordWeight g.1 + wt g.2.1 := add_tsub_cancel_right _ _
  have h : weightProj R (productWeight wt g) (product s g) = product s g := by
    have h1 : LusztigF.wordWeight g.2.2 ≤ productWeight wt g := le_add_self
    have h2 : LusztigF.wordWeight g.1 ≤ LusztigF.wordWeight g.1 + wt g.2.1 := le_self_add
    rw [product, weightProj_mul_wordBasis, ite_eq_left h1, e, weightProj_wordBasis_mul,
      ite_eq_left h2, add_tsub_cancel_left, weightProj_self (hs _)]
  rw [← h]
  exact weightProj_mem _ _

lemma productSpan_le_wordSpan (hs : ∀ j, s j ∈ wordSpan R (wt j)) (ν : X →₀ ℕ) :
    productSpan s wt ν ≤ wordSpan R ν := by
  rw [productSpan, Submodule.span_le]
  rintro _ ⟨g, hg, rfl⟩
  exact (show productWeight wt g = ν from hg) ▸ product_mem hs g

variable (s wt) in
lemma product_mem_productSpan (g : List X × J × List X) :
    product s g ∈ productSpan s wt (productWeight wt g) :=
  Submodule.subset_span ⟨g, rfl, rfl⟩

lemma productSpan_le_ideal (ν : X →₀ ℕ) :
    (productSpan s wt ν : Set (FreeAlgebra R X)) ⊆ TwoSidedIdeal.span (Set.range s) := by
  change productSpan s wt ν ≤ (TwoSidedIdeal.span (Set.range s)).asIdeal.restrictScalars R
  rw [productSpan, Submodule.span_le]
  rintro _ ⟨g, -, rfl⟩
  exact TwoSidedIdeal.mul_mem_right _ _ _
    (TwoSidedIdeal.mul_mem_left _ _ _ (TwoSidedIdeal.subset_span (Set.mem_range_self g.2.1)))

lemma wordBasis_mul_mem_productSpan (a : List X) {μ : X →₀ ℕ} {x : FreeAlgebra R X}
    (hx : x ∈ productSpan s wt μ) :
    wordBasis R X a * x ∈ productSpan s wt (LusztigF.wordWeight a + μ) := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨g, hg, rfl⟩ := hy
    have e1 : wordBasis R X a * product s g = product s (a ++ g.1, g.2.1, g.2.2) := by
      simp only [product, wordBasis_append, mul_assoc]
    have e2 : LusztigF.wordWeight a + μ = productWeight wt (a ++ g.1, g.2.1, g.2.2) := by
      rw [← show productWeight wt g = μ from hg]
      simp only [productWeight, LusztigF.wordWeight_append, add_assoc]
    rw [e1, e2]
    exact product_mem_productSpan s wt _
  | zero => simp
  | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
  | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ _ hy

lemma mul_wordBasis_mem_productSpan (b : List X) {μ : X →₀ ℕ} {x : FreeAlgebra R X}
    (hx : x ∈ productSpan s wt μ) :
    x * wordBasis R X b ∈ productSpan s wt (μ + LusztigF.wordWeight b) := by
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨g, hg, rfl⟩ := hy
    have e1 : product s g * wordBasis R X b = product s (g.1, g.2.1, g.2.2 ++ b) := by
      simp only [product, wordBasis_append, mul_assoc]
    have e2 : μ + LusztigF.wordWeight b = productWeight wt (g.1, g.2.1, g.2.2 ++ b) := by
      rw [← show productWeight wt g = μ from hg]
      simp only [productWeight, LusztigF.wordWeight_append, add_assoc]
    rw [e1, e2]
    exact product_mem_productSpan s wt _
  | zero => simp
  | add y z _ _ hy hz => rw [add_mul]; exact add_mem hy hz
  | smul c y _ hy => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hy

variable [DecidableEq X]

/-- **The weight components of an ideal generated by homogeneous elements.** If `s j` has weight
`wt j` for every `j`, the weight-`ν` component of any element of the two-sided ideal generated by
the `s j` is a linear combination of the products `a (s j) b` of weight `ν`. -/
theorem weightProj_mem_productSpan (hs : ∀ j, s j ∈ wordSpan R (wt j)) {x : FreeAlgebra R X}
    (hx : x ∈ TwoSidedIdeal.span (Set.range s)) (ν : X →₀ ℕ) :
    weightProj R ν x ∈ productSpan s wt ν := by
  induction hx using TwoSidedIdeal.span_induction generalizing ν with
  | mem y hy =>
    obtain ⟨j, rfl⟩ := hy
    rw [weightProj_of_mem (hs j)]
    split_ifs with h
    · have := product_mem_productSpan s wt ([], j, [])
      simp only [product, productWeight, wordBasis_nil, one_mul, mul_one,
        LusztigF.wordWeight_nil, zero_add, add_zero] at this
      exact h ▸ this
    · exact zero_mem _
  | zero => simp
  | add y z _ _ hy hz => rw [map_add]; exact add_mem (hy ν) (hz ν)
  | neg y _ hy => rw [map_neg]; exact neg_mem (hy ν)
  | left_absorb a y _ hy =>
    induction a using induction_wordBasis with
    | zero => simp
    | add a a' ha ha' => rw [add_mul, map_add]; exact add_mem ha ha'
    | smul c a ha => rw [smul_mul_assoc, map_smul]; exact Submodule.smul_mem _ _ ha
    | word w =>
      rw [weightProj_wordBasis_mul]
      split_ifs with h
      · have := wordBasis_mul_mem_productSpan w (hy (ν - LusztigF.wordWeight w))
        rwa [add_tsub_cancel_of_le h] at this
      · exact zero_mem _
  | right_absorb b y _ hy =>
    induction b using induction_wordBasis with
    | zero => simp
    | add b b' hb hb' => rw [mul_add, map_add]; exact add_mem hb hb'
    | smul c b hb => rw [mul_smul_comm, map_smul]; exact Submodule.smul_mem _ _ hb
    | word w =>
      rw [weightProj_mul_wordBasis]
      split_ifs with h
      · have := mul_wordBasis_mem_productSpan w (hy (ν - LusztigF.wordWeight w))
        rwa [tsub_add_cancel_of_le h] at this
      · exact zero_mem _

omit [DecidableEq X] in
/-- The weight-`ν` part of the ideal generated by homogeneous elements is the span of the
products of weight `ν`. -/
theorem wordSpan_inf_ideal_eq_productSpan (hs : ∀ j, s j ∈ wordSpan R (wt j)) (ν : X →₀ ℕ)
    {x : FreeAlgebra R X} (hxν : x ∈ wordSpan R ν) :
    x ∈ TwoSidedIdeal.span (Set.range s) ↔ x ∈ productSpan s wt ν := by
  classical
  refine ⟨fun hx ↦ ?_, fun hx ↦ productSpan_le_ideal ν hx⟩
  rw [← weightProj_self hxν]
  exact weightProj_mem_productSpan hs hx ν

end FreeAlgebra

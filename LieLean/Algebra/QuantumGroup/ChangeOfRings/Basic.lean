import LieLean.Algebra.QuantumGroup.CrystalBasis.Global.CanonicalBasis
import Mathlib.RingTheory.TensorProduct.Free

/-!
# The algebra `_R f`

Let `𝒜 = ℤ[v, v⁻¹]` and let `S` be a commutative `𝒜`-algebra. Lusztig's `_S f = S ⊗_𝒜 𝒜f`
([Lus] 31.1.1) is the `S`-algebra `S ⊗[𝒜] quotientIntegralForm D`, where
`𝒜f = quotientIntegralForm D` is the `𝒜`-subalgebra of `f` generated by the divided powers
`θᵢ^{(n)}`.

## Main results

* `integralCanonicalBasis`: the canonical basis `B` is an `𝒜`-basis of `𝒜f`
  ([Lus] Thm. 14.4.3 (b), transported from `U⁻_ℤ` to `𝒜f`).
* `baseChangeCanonicalBasis`: the elements `1 ⊗ b`, `b ∈ B`, form an `S`-basis of
  `_S f` ([Lus] 31.1.1).
* `adjoin_baseChangeGenerator`: `_S f` is generated as an `S`-algebra by the
  `θᵢ^{(n)} = 1 ⊗ θᵢ^{(n)}`.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, 14.4.3, 31.1.1.
-/

open scoped RatFunc TensorProduct

noncomputable section

namespace LieLean.QuantumGroup

open Sl2.RankOne GrandLoop LusztigF

local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "𝒜" => LaurentPolynomial ℤ

universe u

variable {I : Type u} [Finite I] [DecidableEq I] (D : LusztigCartanDatum I)

/-- `U⁻_ℤ ≅ 𝒜f` as `𝒜`-modules, restricting `U⁻ ≅ f`. -/
def negIntegralEquiv : negIntegral D ≃ₗ[𝒜] quotientIntegralForm D where
  toFun x := ⟨negativeQuotientEquiv D x, x.2⟩
  invFun y := ⟨(negativeQuotientEquiv D).symm y, by
    rw [mem_negIntegral, LinearEquiv.apply_symm_apply]; exact y.2⟩
  map_add' x y := Subtype.ext (map_add _ _ _)
  map_smul' c x := Subtype.ext (by
    change negativeQuotientEquiv D (c • (x : Um D 𝕧)) = integralLaurentEval c • _
    rw [laurent_smul_eq, map_smul])
  left_inv x := Subtype.ext ((negativeQuotientEquiv D).symm_apply_apply _)
  right_inv y := Subtype.ext ((negativeQuotientEquiv D).apply_symm_apply _)

/-- The canonical basis `B` as an `𝒜`-basis of `𝒜f` ([Lus] Thm. 14.4.3 (b)). -/
def integralCanonicalBasis : Module.Basis (canonicalBasis D) 𝒜 (quotientIntegralForm D) :=
  (Module.Basis.span (linearIndependent_canonicalBasis_laurent D)).map
    (LinearEquiv.ofEq _ _ (by rw [Subtype.range_coe]; exact span_canonicalBasis_laurent D) ≪≫ₗ
      negIntegralEquiv D)

lemma integralCanonicalBasis_apply (b : canonicalBasis D) :
    (integralCanonicalBasis D b : LusztigF.Quotient D 𝕧) = negativeQuotientEquiv D b := by
  simp [integralCanonicalBasis, negIntegralEquiv, Module.Basis.span_apply]

variable (S : Type*) [CommRing S] [Algebra 𝒜 S]

/-- **[Lus] 31.1.1**: the elements `1 ⊗ b`, `b ∈ B`, form an `S`-basis of
`_S f = S ⊗_𝒜 𝒜f`. -/
def baseChangeCanonicalBasis :
    Module.Basis (canonicalBasis D) S (S ⊗[𝒜] quotientIntegralForm D) :=
  Algebra.TensorProduct.basis S (integralCanonicalBasis D)

lemma baseChangeCanonicalBasis_apply (b : canonicalBasis D) :
    baseChangeCanonicalBasis D S b = 1 ⊗ₜ integralCanonicalBasis D b :=
  Algebra.TensorProduct.basis_apply _ _

omit [Finite I] in
/-- The divided power `θᵢ^{(n)}` in `𝒜f`. -/
def integralGenerator (i : I) (n : ℕ) : quotientIntegralForm D :=
  ⟨quotientIntegralGenerator D i n, quotientIntegralGenerator_mem D i n⟩

omit [Finite I] in
/-- `_S f` is generated as an `S`-algebra by the divided powers `1 ⊗ θᵢ^{(n)}`. -/
theorem adjoin_baseChangeGenerator :
    Algebra.adjoin S (Set.range fun p : I × ℕ ↦
      (1 : S) ⊗ₜ[𝒜] integralGenerator D p.1 p.2) = ⊤ := by
  set T := Algebra.adjoin S (Set.range fun p : I × ℕ ↦
      (1 : S) ⊗ₜ[𝒜] integralGenerator D p.1 p.2)
  have key : ∀ (x : LusztigF.Quotient D 𝕧) (hx : x ∈ quotientIntegralForm D),
      (1 : S) ⊗ₜ[𝒜] (⟨x, hx⟩ : quotientIntegralForm D) ∈ T := by
    intro x hx
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨i, n, rfl⟩ := hx
      exact Algebra.subset_adjoin ⟨(i, n), rfl⟩
    | algebraMap r =>
      have : (⟨algebraMap 𝒜 _ r, Subalgebra.algebraMap_mem _ r⟩ : quotientIntegralForm D) =
          algebraMap 𝒜 (quotientIntegralForm D) r := rfl
      rw [this, Algebra.algebraMap_eq_smul_one, TensorProduct.tmul_smul,
        ← algebraMap_smul S r, ← Algebra.TensorProduct.one_def]
      exact T.smul_mem T.one_mem _
    | add x y hx hy ihx ihy =>
      have : (⟨x + y, add_mem hx hy⟩ : quotientIntegralForm D) = ⟨x, hx⟩ + ⟨y, hy⟩ := rfl
      rw [this, TensorProduct.tmul_add]
      exact add_mem ihx ihy
    | mul x y hx hy ihx ihy =>
      have : (⟨x * y, mul_mem hx hy⟩ : quotientIntegralForm D) = ⟨x, hx⟩ * ⟨y, hy⟩ := rfl
      rw [this, ← mul_one (1 : S), ← Algebra.TensorProduct.tmul_mul_tmul]
      exact mul_mem ihx ihy
  refine top_unique fun z hz ↦ ?_
  clear hz
  refine TensorProduct.inductionOn z (fun s a ↦ ?_)
    (fun x y hx hy ↦ add_mem hx hy)
  rw [← mul_one s, ← smul_eq_mul, ← TensorProduct.smul_tmul']
  exact Subalgebra.smul_mem _ (key a a.2) s

end LieLean.QuantumGroup

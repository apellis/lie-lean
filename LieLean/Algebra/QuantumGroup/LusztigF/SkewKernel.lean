import LieLean.Algebra.QuantumGroup.LusztigF.QuotientLattice

/-!
# Generators of the actual left skew kernel

For a distinguished node `i`, form the quantum adjoints
`g(j,0) = θⱼ`, `g(j,n+1) = g(j,n) θᵢ - θᵢ twistᵢ(g(j,n))` for `j ≠ i`.
Their divided-power normalizations are the elements `f(i,j;n)` of [Lus] 38.1.1
(the `e = -1` family of 7.1.1), as proved by `skewDividedGenerator_eq_sum`.

The free algebra is spanned by `θᵢ^n a`, where `a` belongs to the algebra generated by these
actual adjoints (`skewStringSpan_eq_top`). Over `ℚ(v)`, `v = RatFunc.X`, their images in the
original radical quotient vanish beyond `n = -aᵢⱼ`. The bounded divided-power generators
generate exactly the original left skew kernel (`mem_quotientSkewGenerators_iff`). Every
quotient element has a finite string expansion with coefficients in this generated algebra
(`exists_quotientSkewGenerators_decomposition`). These are the generation and spanning parts
of [Lus] 38.1.2 and 38.1.6; the proof uses the established boson string projection instead of
assuming generation or identifying a positive braid intersection.

`quotientLDeriv_toQuotient` identifies the transported operator with `LusztigF.lDeriv` on
representatives. `quotientForm_divided_mul_of_mem_skewGenerators` consumes generation to
supply the kernel hypotheses of the original form's string factorization.

The free-algebra results hold over any field; the quotient comparison uses a finite simple-root
set and the existing radical/Serre identification. No finite Weyl group or root-independence
hypothesis is used. Braid-positive intersection, arbitrary reduced-word adapted-tail membership,
projected coproduct compatibility and restricted braid isometry are not established here.

## References

* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser, 1993, 38.1.1–38.1.2, 38.1.6.
-/

open LieLean
noncomputable section
namespace LusztigF
variable {k I : Type*} [Field k]
  (D : LusztigCartanDatum I) (v : k) (i : I)

/-- Right adjoint with the actual diagonal twist. -/
def skewAdjoint : LusztigF k I →ₗ[k] LusztigF k I :=
  LinearMap.mulRight k (θ k i) -
    (LinearMap.mulLeft k (θ k i)).comp (twist D v i).toLinearMap

lemma skewAdjoint_apply (x : LusztigF k I) :
    skewAdjoint D v i x = x * θ k i - θ k i * twist D v i x := rfl

lemma skewAdjoint_mul (x y : LusztigF k I) :
    skewAdjoint D v i (x * y) = x * skewAdjoint D v i y +
      skewAdjoint D v i x * twist D v i y := by
  simp only [skewAdjoint_apply, map_mul]
  noncomm_ring

lemma lDeriv_skewAdjoint [DecidableEq I] {x : LusztigF k I} (hx : lDeriv D v i x = 0) :
    lDeriv D v i (skewAdjoint D v i x) = 0 := by
  simp [skewAdjoint_apply, lDeriv_mul, lDeriv_twist, hx]

/-- Unnormalized iterated quantum adjoints of the other simple generators. -/
def skewGenerator (j : I) (n : ℕ) : LusztigF k I :=
  (skewAdjoint D v i ^ n) (θ k j)

@[simp] lemma skewGenerator_zero (j : I) : skewGenerator D v i j 0 = θ k j := rfl

lemma skewGenerator_succ (j : I) (n : ℕ) :
    skewGenerator D v i j (n + 1) = skewAdjoint D v i (skewGenerator D v i j n) := by
  simp only [skewGenerator, pow_succ', Module.End.mul_apply]

lemma lDeriv_skewGenerator [DecidableEq I] {j : I} (hij : i ≠ j) (n : ℕ) :
    lDeriv D v i (skewGenerator D v i j n) = 0 := by
  induction n with
  | zero => simp [hij]
  | succ n ih => rw [skewGenerator_succ]; exact lDeriv_skewAdjoint D v i ih

lemma twist_skewGenerator (j : I) (n : ℕ) :
    twist D v i (skewGenerator D v i j n) =
      ((v ^ D.dot i i) ^ n * v ^ D.dot i j) • skewGenerator D v i j n := by
  induction n with
  | zero => simp
  | succ n ih =>
    rw [skewGenerator_succ, skewAdjoint_apply, map_sub, map_mul, map_mul,
      twist_θ, ih, map_smul, ih]
    simp only [mul_smul_comm, smul_mul_assoc, smul_smul, smul_sub, pow_succ]
    module

/-- Closed Serre-polynomial expression for the actual adjoint generators. -/
lemma skewGenerator_eq_rev_serreAux (hv : v ≠ 0) (j : I) (n : ℕ) :
    skewGenerator D v i j n = rev k I
      (LieLean.QuantumGroup.serreAux (v ^ D.d i)
        ((v ^ D.d i) ^ n * (v ^ D.d i)⁻¹ * v ^ D.dot i j) n (θ k i) (θ k j)) := by
  classical
  have hq : v ^ D.d i ≠ 0 := pow_ne_zero _ hv
  induction n with
  | zero => simp [LieLean.QuantumGroup.serreAux]
  | succ n ih =>
    have hc : (v ^ D.d i) ^ (n + 1) * (v ^ D.d i)⁻¹ * v ^ D.dot i j *
        (v ^ D.d i)⁻¹ = (v ^ D.d i) ^ n * (v ^ D.d i)⁻¹ * v ^ D.dot i j := by
      rw [pow_succ]; field_simp
    have hd : (v ^ D.d i) ^ (n + 1) * (v ^ D.d i)⁻¹ * v ^ D.dot i j *
        (v ^ D.d i) ^ n = (v ^ D.dot i i) ^ n * v ^ D.dot i j := by
      rw [zpow_dot_self, pow_succ]; field_simp; ring
    rw [skewGenerator_succ, skewAdjoint_apply, twist_skewGenerator,
      LieLean.QuantumGroup.serreAux_succ' hq, hc, hd, map_sub, map_smul,
      rev_mul, rev_mul, rev_θ, ← ih, mul_smul_comm]

/-- The source divided-power adjoint generator, before taking the quotient. -/
def skewDividedGenerator (j : I) (n : ℕ) : LusztigF k I :=
  (LieLean.QuantumGroup.qFactorial (v ^ D.d i) n)⁻¹ • skewGenerator D v i j n

/-- The divided-power sum of §38.1.1, with `c = v_i^(n-1) v^(i·j)`. -/
lemma skewDividedGenerator_eq_sum (hv : v ≠ 0) (j : I) (n : ℕ)
    (hfac : LieLean.QuantumGroup.qFactorial (v ^ D.d i) n ≠ 0) :
    skewDividedGenerator D v i j n =
      ∑ r ∈ Finset.range (n + 1),
        ((-1 : k) ^ r * ((v ^ D.d i) ^ n * (v ^ D.d i)⁻¹ * v ^ D.dot i j) ^ r) •
          (LieLean.QuantumGroup.qDivPow (v ^ D.d i) r (θ k i) * θ k j *
            LieLean.QuantumGroup.qDivPow (v ^ D.d i) (n - r) (θ k i)) := by
  classical
  have hpow (m : ℕ) : rev k I (θ k i ^ m) = θ k i ^ m := by
    induction m with
    | zero => simp
    | succ m ih => rw [pow_succ, rev_mul, ih, rev_θ, ← pow_succ', pow_succ]
  simp only [skewDividedGenerator, skewGenerator_eq_rev_serreAux D v i hv,
    LieLean.QuantumGroup.serreAux, map_sum, map_smul, rev_mul, hpow, rev_θ,
    Finset.smul_sum, smul_smul, LieLean.QuantumGroup.qDivPow, smul_mul_assoc,
    mul_smul_comm, ← mul_assoc]
  apply Finset.sum_congr rfl
  intro r hr
  have hr : r ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hr)
  have hf := LieLean.QuantumGroup.qBinomial_mul_qFactorial_mul_qFactorial (v := v ^ D.d i) hr
  have h1 : LieLean.QuantumGroup.qFactorial (v ^ D.d i) r ≠ 0 := by
    intro h; rw [h, mul_zero, zero_mul] at hf; exact hfac hf.symm
  have h2 : LieLean.QuantumGroup.qFactorial (v ^ D.d i) (n - r) ≠ 0 := by
    intro h; rw [h, mul_zero] at hf; exact hfac hf.symm
  have h3 : LieLean.QuantumGroup.qBinomial (v ^ D.d i) n r ≠ 0 := by
    intro h; rw [h, zero_mul, zero_mul] at hf; exact hfac hf.symm
  congr 1
  rw [← hf]
  field_simp

/-- The algebra generated by the explicit adjoint strings at `i`. -/
def skewGenerated : Subalgebra k (LusztigF k I) :=
  Algebra.adjoin k {x | ∃ j, i ≠ j ∧ ∃ n, x = skewGenerator D v i j n}

lemma skewGenerator_mem {j : I} (hij : i ≠ j) (n : ℕ) :
    skewGenerator D v i j n ∈ skewGenerated D v i :=
  Algebra.subset_adjoin ⟨j, hij, n, rfl⟩

lemma lDeriv_eq_zero_of_mem_skewGenerated [DecidableEq I] {x : LusztigF k I}
    (hx : x ∈ skewGenerated D v i) : lDeriv D v i x = 0 := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, hij, n, rfl⟩ := hx
    exact lDeriv_skewGenerator D v i hij n
  | algebraMap a => simp
  | add x y _ _ hx hy => simp [hx, hy]
  | mul x y _ _ hx hy => simp [lDeriv_mul, hx, hy]

lemma twist_mem_skewGenerated {x : LusztigF k I}
    (hx : x ∈ skewGenerated D v i) : twist D v i x ∈ skewGenerated D v i := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, hij, n, rfl⟩ := hx
    rw [twist_skewGenerator]
    exact Subalgebra.smul_mem _ (skewGenerator_mem D v i hij n) _
  | algebraMap a => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

lemma skewAdjoint_mem_skewGenerated {x : LusztigF k I}
    (hx : x ∈ skewGenerated D v i) : skewAdjoint D v i x ∈ skewGenerated D v i := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨j, hij, n, rfl⟩ := hx
    rw [← skewGenerator_succ]
    exact skewGenerator_mem D v i hij (n + 1)
  | algebraMap a =>
    have : skewAdjoint D v i (algebraMap k _ a) = 0 := by
      simp [skewAdjoint_apply, Algebra.algebraMap_eq_smul_one]
    rw [this]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | mul x y hx hy hdx hdy =>
    rw [skewAdjoint_mul]
    exact add_mem (mul_mem hx hdy) (mul_mem hdx (twist_mem_skewGenerated D v i hy))

/-- Left powers of the distinguished generator followed by actual adjoint words. -/
def skewStringSpan : Submodule k (LusztigF k I) :=
  Submodule.span k {x | ∃ n, ∃ a ∈ skewGenerated D v i, x = θ k i ^ n * a}

lemma skewString_mem (n : ℕ) {a : LusztigF k I} (ha : a ∈ skewGenerated D v i) :
    θ k i ^ n * a ∈ skewStringSpan D v i := Submodule.subset_span ⟨n, a, ha, rfl⟩

lemma mul_theta_mem_skewStringSpan {x : LusztigF k I}
    (hx : x ∈ skewStringSpan D v i) (j : I) : x * θ k j ∈ skewStringSpan D v i := by
  classical
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, a, ha, rfl⟩ := hx
    by_cases hij : i = j
    · subst j
      have he : (θ k i ^ n * a) * θ k i =
          θ k i ^ n * skewAdjoint D v i a + θ k i ^ (n + 1) * twist D v i a := by
        rw [skewAdjoint_apply, pow_succ]
        noncomm_ring
      rw [he]
      exact add_mem (skewString_mem D v i n (skewAdjoint_mem_skewGenerated D v i ha))
        (skewString_mem D v i (n + 1) (twist_mem_skewGenerated D v i ha))
    · rw [mul_assoc]
      exact skewString_mem D v i n (mul_mem ha (skewGenerator_mem D v i hij 0))
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_mul_assoc]; exact Submodule.smul_mem _ _ hx

/-- Spanning by the explicit adjoint generators; no kernel spanning hypothesis. -/
theorem skewStringSpan_eq_top : skewStringSpan D v i = ⊤ := by
  have hm (y : LusztigF k I) : ∀ x ∈ skewStringSpan D v i,
      x * y ∈ skewStringSpan D v i := by
    induction y using FreeAlgebra.induction with
    | grade0 a =>
      intro x hx
      simpa [Algebra.algebraMap_eq_smul_one] using Submodule.smul_mem _ a hx
    | grade1 j => exact fun x hx ↦ mul_theta_mem_skewStringSpan D v i hx j
    | add y z hy hz =>
      intro x hx
      rw [mul_add]; exact add_mem (hy x hx) (hz x hx)
    | mul y z hy hz =>
      intro x hx
      rw [← mul_assoc]; exact hz _ (hy x hx)
  apply top_unique
  intro x _
  have hone : (1 : LusztigF k I) ∈ skewStringSpan D v i := by
    simpa using skewString_mem D v i 0 (one_mem (skewGenerated D v i))
  simpa using hm x 1 hone

end LusztigF

namespace LieLean.QuantumGroup
open LusztigF GrandLoop
local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local instance : NeZero 𝕧 := ⟨RatFunc.X_ne_zero⟩
variable {I : Type*} [Finite I] [DecidableEq I] (D : LusztigCartanDatum I)

/-- The original left skew derivation on the radical quotient. -/
def quotientLDeriv (i : I) : Module.End 𝕂 (Quotient D 𝕧) :=
  (negativeQuotientEquiv D).toLinearMap ∘ₗ
    (bos (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i).e ∘ₗ
      (negativeQuotientEquiv D).symm.toLinearMap

@[simp] lemma quotientLDeriv_toQuotient (i : I) (x : LusztigF 𝕂 I) :
    quotientLDeriv D i (toQuotient D 𝕧 x) = toQuotient D 𝕧 (lDeriv D 𝕧 i x) := by
  simp only [quotientLDeriv, LinearMap.comp_apply, LinearEquiv.coe_coe,
    negativeQuotientEquiv_symm_toQuotient]
  rfl

/-- The actual subalgebra generated by the adjoint strings in the radical quotient. -/
def quotientSkewGenerated (i : I) : Subalgebra 𝕂 (Quotient D 𝕧) :=
  (skewGenerated D 𝕧 i).map (toQuotient D 𝕧)

lemma quotientLDeriv_eq_zero_of_mem (i : I) {x : Quotient D 𝕧}
    (hx : x ∈ quotientSkewGenerated D i) : quotientLDeriv D i x = 0 := by
  obtain ⟨y, hy, rfl⟩ := hx
  change quotientLDeriv D i (toQuotient D 𝕧 y) = 0
  rw [quotientLDeriv_toQuotient, lDeriv_eq_zero_of_mem_skewGenerated D 𝕧 i hy, map_zero]

/-- Projection to the zero string component, built from the proved boson decomposition. -/
def quotientSkewProjection (i : I) : Module.End 𝕂 (Quotient D 𝕧) :=
  (negativeQuotientEquiv D).toLinearMap ∘ₗ
    (bos (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i).component
      (NegativePart.pow_d_ne_zero RatFunc.X_ne_zero i)
      (NegativePart.pow_d_ne_one (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i) 0 ∘ₗ
    (negativeQuotientEquiv D).symm.toLinearMap

lemma quotientSkewProjection_of_ker (i : I) {x : Quotient D 𝕧}
    (hx : quotientLDeriv D i x = 0) : quotientSkewProjection D i x = x := by
  have he : (bos (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i).e
      ((negativeQuotientEquiv D).symm x) = 0 := by
    apply (negativeQuotientEquiv D).injective
    simpa [quotientLDeriv] using hx
  simp only [quotientSkewProjection, LinearMap.comp_apply, LinearEquiv.coe_coe]
  have h := BosonModule.component_df
    (NegativePart.pow_d_ne_zero RatFunc.X_ne_zero i)
    (NegativePart.pow_d_ne_one (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i)
    he 0 0
  simpa using congrArg (negativeQuotientEquiv D) h

lemma quotientSkewProjection_divided_mul (i : I) (n : ℕ) {x : Quotient D 𝕧}
    (hx : quotientLDeriv D i x = 0) :
    quotientSkewProjection D i (quotientIntegralGenerator D i n * x) =
      if n = 0 then x else 0 := by
  have he : (bos (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i).e
      ((negativeQuotientEquiv D).symm x) = 0 := by
    apply (negativeQuotientEquiv D).injective
    simpa [quotientLDeriv] using hx
  have hd := negativeQuotientEquiv_df D i n ((negativeQuotientEquiv D).symm x)
  rw [LinearEquiv.apply_symm_apply] at hd
  rw [← hd]
  simp only [quotientSkewProjection, LinearMap.comp_apply, LinearEquiv.coe_coe,
    LinearEquiv.symm_apply_apply]
  rw [BosonModule.component_df _ _ he]
  split_ifs <;> simp

lemma quotientSkewProjection_string (i : I) (n : ℕ) {a : LusztigF 𝕂 I}
    (ha : a ∈ skewGenerated D 𝕧 i) :
    quotientSkewProjection D i (toQuotient D 𝕧 (θ 𝕂 i ^ n * a)) ∈
      quotientSkewGenerated D i := by
  have hm : toQuotient D 𝕧 a ∈ quotientSkewGenerated D i := ⟨a, ha, rfl⟩
  have hfac : qFactorial (𝕧 ^ D.d i) n ≠ 0 :=
    qFactorial_ne_zero_of_not_root RatFunc.X_ne_zero
      (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i n
  have hp : toQuotient D 𝕧 (θ 𝕂 i ^ n * a) =
      qFactorial (𝕧 ^ D.d i) n •
        (quotientIntegralGenerator D i n * toQuotient D 𝕧 a) := by
    simp [quotientIntegralGenerator, qDivPow, smul_smul, hfac]
  rw [hp, map_smul, quotientSkewProjection_divided_mul D i n
    (quotientLDeriv_eq_zero_of_mem D i hm)]
  split_ifs
  · exact Subalgebra.smul_mem _ hm _
  · simp

lemma quotientSkewProjection_mem (i : I) (x : Quotient D 𝕧) :
    quotientSkewProjection D i x ∈ quotientSkewGenerated D i := by
  obtain ⟨x, rfl⟩ := toQuotient_surjective D 𝕧 x
  have hx : x ∈ skewStringSpan D 𝕧 i := by rw [skewStringSpan_eq_top]; trivial
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨n, a, ha, rfl⟩ := hx
    exact quotientSkewProjection_string D i n ha
  | zero => simp
  | add x y _ _ hx hy => rw [map_add, map_add]; exact add_mem hx hy
  | smul c x _ hx => rw [map_smul, map_smul]; exact Subalgebra.smul_mem _ hx _

/-- The skew kernel is generated by explicit adjoint strings in the original radical quotient.
The generation direction is proved using spanning and the actual zero-string projection. -/
theorem mem_quotientSkewGenerated_iff (i : I) (x : Quotient D 𝕧) :
    x ∈ quotientSkewGenerated D i ↔ quotientLDeriv D i x = 0 := by
  constructor
  · exact quotientLDeriv_eq_zero_of_mem D i
  · intro hx
    rw [← quotientSkewProjection_of_ker D i hx]
    exact quotientSkewProjection_mem D i x

/-- Adjoint strings terminate at the Cartan bound, by the original Serre relation. -/
lemma toQuotient_skewGenerator_eq_zero (i j : I) (hij : i ≠ j) (n : ℕ)
    (hn : (-D.cartanMatrix i j).toNat < n) :
    toQuotient D 𝕧 (skewGenerator D 𝕧 i j n) = 0 := by
  have hN : (1 - D.cartanMatrix i j).toNat = (-D.cartanMatrix i j).toNat + 1 := by
    have := D.isGeneralizedCartan_cartanMatrix.offDiag_nonpos i j hij
    omega
  have hq : 𝕧 ^ D.d i ≠ 0 := pow_ne_zero _ RatFunc.X_ne_zero
  have hbase : toQuotient D 𝕧
      (skewGenerator D 𝕧 i j ((-D.cartanMatrix i j).toNat + 1)) = 0 := by
    rw [skewGenerator_eq_rev_serreAux D 𝕧 i RatFunc.X_ne_zero,
      zpow_dot_eq hij hN]
    have hc : (𝕧 ^ D.d i) ^ ((-D.cartanMatrix i j).toNat + 1) * (𝕧 ^ D.d i)⁻¹ *
        ((𝕧 ^ D.d i)⁻¹ ^ (-D.cartanMatrix i j).toNat) = 1 := by
      simp only [pow_succ, mul_assoc, mul_inv_cancel_left₀ hq]
      rw [← mul_pow, mul_inv_cancel₀ hq, one_pow]
    rw [hc, serreAux_one, ← hN]
    apply (toQuotient_eq_zero_iff_mem_serreIdeal D transcendental_ratFunc_X).mpr
    exact rev_mem_serreIdeal D 𝕧 (qSerre_mem_serreIdeal hij
      (qFactorial_ne_zero_of_not_root RatFunc.X_ne_zero
        (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i _))
  induction n, Nat.succ_le_iff.mpr hn using Nat.le_induction with
  | base => exact hbase
  | succ n _ ih =>
    rw [skewGenerator_succ, skewAdjoint_apply, twist_skewGenerator,
      map_sub, map_mul, map_mul, map_smul, ih (by omega)]
    simp

/-- The finite-in-each-adjoint-string presentation of the source skew subalgebra. -/
def quotientSkewGenerators (i : I) : Subalgebra 𝕂 (Quotient D 𝕧) :=
  Algebra.adjoin 𝕂 {x | ∃ j, i ≠ j ∧ ∃ n, n ≤ (-D.cartanMatrix i j).toNat ∧
    x = toQuotient D 𝕧 (skewDividedGenerator D 𝕧 i j n)}

lemma quotientSkewGenerators_eq (i : I) :
    quotientSkewGenerators D i = quotientSkewGenerated D i := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨j, hij, n, _, rfl⟩
    rw [skewDividedGenerator, map_smul]
    have hm : toQuotient D 𝕧 (skewGenerator D 𝕧 i j n) ∈ quotientSkewGenerated D i :=
      ⟨_, skewGenerator_mem D 𝕧 i hij n, rfl⟩
    exact Subalgebra.smul_mem _ hm _
  · rintro x ⟨x, hx, rfl⟩
    change toQuotient D 𝕧 x ∈ quotientSkewGenerators D i
    induction hx using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨j, hij, n, rfl⟩ := hx
      by_cases hn : n ≤ (-D.cartanMatrix i j).toNat
      · have hm : toQuotient D 𝕧 (skewDividedGenerator D 𝕧 i j n) ∈
            quotientSkewGenerators D i := Algebra.subset_adjoin ⟨j, hij, n, hn, rfl⟩
        have hf := qFactorial_ne_zero_of_not_root (D := D) RatFunc.X_ne_zero
          (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i n
        have he : toQuotient D 𝕧 (skewGenerator D 𝕧 i j n) =
            qFactorial (𝕧 ^ D.d i) n •
              toQuotient D 𝕧 (skewDividedGenerator D 𝕧 i j n) := by
          simp [skewDividedGenerator, smul_smul, hf]
        rw [he]; exact Subalgebra.smul_mem _ hm _
      · rw [toQuotient_skewGenerator_eq_zero D i j hij n (Nat.lt_of_not_ge hn)]
        exact zero_mem _
    | algebraMap c => simp
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy

/-- **Skew-kernel generation**, with the actual bounded divided-power generators of §38.1.1. -/
theorem mem_quotientSkewGenerators_iff (i : I) (x : Quotient D 𝕧) :
    x ∈ quotientSkewGenerators D i ↔ quotientLDeriv D i x = 0 := by
  rw [quotientSkewGenerators_eq, mem_quotientSkewGenerated_iff]

/-- Every element of the original quotient has a finite string expansion with coefficients
in the algebra generated by the source adjoints, not merely an assumed abstract kernel. -/
theorem exists_quotientSkewGenerators_decomposition (i : I) (x : Quotient D 𝕧) :
    ∃ (N : ℕ) (a : ℕ → Quotient D 𝕧), (∀ n, a n ∈ quotientSkewGenerators D i) ∧
      x = ∑ n ∈ Finset.range N, quotientIntegralGenerator D i n * a n := by
  let V := bos (D := D) (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i
  have hq0 := NegativePart.pow_d_ne_zero (D := D) (v := 𝕧) RatFunc.X_ne_zero i
  have hq := NegativePart.pow_d_ne_one (D := D)
    (pow_ne_one_of_transcendental' transcendental_ratFunc_X) i
  let u := (negativeQuotientEquiv D).symm x
  obtain ⟨N, _, hN⟩ := V.exists_sum_component hq0 hq u
  refine ⟨N, fun n ↦ negativeQuotientEquiv D (V.component hq0 hq n u), ?_, ?_⟩
  · intro n
    rw [mem_quotientSkewGenerators_iff]
    simp only [quotientLDeriv, LinearMap.comp_apply, LinearEquiv.coe_coe,
      LinearEquiv.symm_apply_apply]
    change negativeQuotientEquiv D (V.e (V.component hq0 hq n u)) = 0
    rw [V.e_component hq0 hq, map_zero]
  · have h := congrArg (negativeQuotientEquiv D) hN
    simpa only [u, V, LinearEquiv.apply_symm_apply, map_sum, negativeQuotientEquiv_df] using h

/-- Orthogonality and diagonal factors for strings over the concretely generated skew algebra.
This uses the generation theorem to discharge the actual skew-kernel hypotheses. -/
theorem quotientForm_divided_mul_of_mem_skewGenerators (i : I) (r s : ℕ)
    {x y : Quotient D 𝕧} (hx : x ∈ quotientSkewGenerators D i)
    (hy : y ∈ quotientSkewGenerators D i) :
    quotientForm D (quotientIntegralGenerator D i r * x)
      (quotientIntegralGenerator D i s * y) =
      if r = s then coefU D 𝕧 i r * quotientForm D x y else 0 := by
  refine quotientForm_divided_mul D i ?_ ?_ r s
  · apply (negativeQuotientEquiv D).injective
    simpa [quotientLDeriv] using (mem_quotientSkewGenerators_iff D i x).mp hx
  · apply (negativeQuotientEquiv D).injective
    simpa [quotientLDeriv] using (mem_quotientSkewGenerators_iff D i y).mp hy

end LieLean.QuantumGroup

import LieLean.Algebra.QuantumGroup.Modified.IntegralPBWGlobalAll
import LieLean.Algebra.QuantumGroup.LusztigF.QuotientLattice

/-!
# Integral PBW preimages in Lusztig's algebra

The positive embedding of the actual radical quotient identifies its existing integral
form with the subalgebra generated by the positive divided powers. Consequently every
reduced-word `T'_{i,-1}` PBW monomial has a unique integral preimage, the element of
Lusztig 41.1.5. No finite Weyl group or root-independence hypothesis is needed.
The finite index-set assumption is used by the quantum Gabber--Kac theorem.

This construction does not assert the lattice or canonical residue assertion of 41.1.6.
-/

open LieLean
noncomputable section
namespace LieLean.QuantumGroup
open LusztigF
local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "𝒜" => LaurentPolynomial ℤ
attribute [local instance] neZero_ratFunc_X
variable {I Y : Type*} [Finite I] [DecidableEq I] [AddCommGroup Y]
  {D : LusztigCartanDatum I} (R : D.RootDatum Y)

/-- The original positive embedding `f → U`, descended through its actual radical. -/
def quotientPlus : Quotient D 𝕧 →ₐ[𝕂] QuantumGroup R 𝕧 :=
  (radical D 𝕧).ringCon.liftₐ (plusHom R 𝕧) fun x y h ↦ by
    apply sub_eq_zero.mp
    change plusHom R 𝕧 x - plusHom R 𝕧 y = 0
    rw [← map_sub, plusHom_eq_zero_iff R 𝕧 ratFunc_X_not_root,
      ← radical_eq_serreIdeal_ratFunc]
    exact ((radical D 𝕧).rel_iff x y).mp h

@[simp] theorem quotientPlus_toQuotient (x : LusztigF 𝕂 I) :
    quotientPlus R (toQuotient D 𝕧 x) = plusHom R 𝕧 x := rfl

theorem quotientPlus_injective : Function.Injective (quotientPlus R) := by
  rw [injective_iff_map_eq_zero]
  intro x hx
  obtain ⟨x, rfl⟩ := toQuotient_surjective D 𝕧 x
  rw [toQuotient_eq_zero_iff, radical_eq_serreIdeal_ratFunc]
  exact (plusHom_eq_zero_iff R 𝕧 ratFunc_X_not_root x).mp hx

attribute [local instance] Modified.laurentAlgebraK Modified.laurentAlgebraU Modified.laurentTowerU
/-- The same positive embedding, with integer Laurent scalars. -/
def quotientPlusIntegral : Quotient D 𝕧 →ₐ[𝒜] QuantumGroup R 𝕧 where
  __ := (quotientPlus R).toRingHom
  commutes' a := (quotientPlus R).commutes (integralLaurentEval a)

@[simp] theorem quotientPlus_dividedPower (i : I) (n : ℕ) :
    quotientPlus R (toQuotient D 𝕧 (qDivPow (𝕧 ^ D.d i) n (θ 𝕂 i))) =
      Modified.Ed R i n := by
  simp [Modified.Ed, qDivPow]

/-- The integral form in `f` maps onto the original positive integral subalgebra. -/
theorem map_quotientIntegralForm_plus :
    (quotientIntegralForm D).map (quotientPlusIntegral R) =
      Algebra.adjoin 𝒜 (⋃ i, Set.range (Modified.Ed R i)) := by
  rw [quotientIntegralForm, AlgHom.map_adjoin]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨i, n, rfl⟩, rfl⟩
    refine Set.mem_iUnion.2 ⟨i, ⟨n, ?_⟩⟩
    simp [quotientPlusIntegral, quotientIntegralGenerator, Modified.Ed, qDivPow]
  · intro hx
    obtain ⟨i, n, rfl⟩ := Set.mem_iUnion.1 hx
    refine ⟨quotientIntegralGenerator D i n, ⟨i, n, rfl⟩, ?_⟩
    simp [quotientPlusIntegral, quotientIntegralGenerator, Modified.Ed, qDivPow]

namespace Modified

omit [Finite I] in
/-- Integral membership for every reduced word, with no longest-element assumption. -/
theorem pbwDivSymm_mem_integralPlus {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {w : List I}
    (hw : cs.IsReduced w) (c : Fin w.length → ℕ) :
    pbwDivSymm R w c ∈ Algebra.adjoin 𝒜 (⋃ i, Set.range (Ed R i)) := by
  have hc := pbwDivSymm_mem_aPlus (R := R) w [] (by simpa using hw) c
  simp only [List.map_nil, List.prod_nil, AlgEquiv.one_apply] at hc
  generalize pbwDivSymm R w c = y at hc ⊢
  induction hc using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨c, w', hc, rfl⟩ := hx
    refine smul_mem_of_isLaurent hc ?_
    induction w' with
    | nil => exact one_mem _
    | cons a w' ih =>
      exact mul_mem (Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨a.1, ⟨a.2, rfl⟩⟩)) ih
  | zero => exact zero_mem _
  | add _ _ _ _ ha hb => exact add_mem ha hb
  | neg _ _ ha => exact neg_mem ha

/-- Existence and uniqueness in the existing integral `f`, not a new PBW model. -/
theorem existsUnique_integralPBWPreimage {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {w : List I}
    (hw : cs.IsReduced w) (c : Fin w.length → ℕ) :
    ∃! x : quotientIntegralForm D, quotientPlus R x = pbwDivSymm R w c := by
  have h := pbwDivSymm_mem_integralPlus R hw c
  rw [← map_quotientIntegralForm_plus R] at h
  obtain ⟨x, hx, he⟩ := h
  refine ⟨⟨x, hx⟩, he, fun y hy ↦ ?_⟩
  exact Subtype.ext (quotientPlus_injective R (hy.trans he.symm))

/-- Lusztig's `θ_h^c` (41.1.5), as an element of the original integral radical quotient. -/
def integralPBWPreimage {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {w : List I}
    (hw : cs.IsReduced w) (c : Fin w.length → ℕ) : quotientIntegralForm D :=
  (existsUnique_integralPBWPreimage R hw c).exists.choose

/-- The defining positive-image formula, with the exact `T'_{i,-1}` convention. -/
theorem quotientPlus_integralPBWPreimage {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {w : List I}
    (hw : cs.IsReduced w) (c : Fin w.length → ℕ) :
    quotientPlus R (integralPBWPreimage R hw c) = pbwDivSymm R w c :=
  (existsUnique_integralPBWPreimage R hw c).exists.choose_spec

/-- At a single simple reflection the preimage is the original simple divided power. -/
theorem integralPBWPreimage_singleton {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {i : I}
    (hw : cs.IsReduced [i]) (c : Fin [i].length → ℕ) :
    (integralPBWPreimage R hw c : Quotient D 𝕧) = quotientIntegralGenerator D i (c 0) := by
  apply quotientPlus_injective R
  rw [quotientPlus_integralPBWPreimage]
  simp [pbwDivSymm, CoxeterSystem.pbwDivMonomial, quotientIntegralGenerator, Ed, qDivPow]

/-- The singleton PBW preimage has actual lattice membership, by its computed norm.
The general reduced-word statement of 41.1.6 remains separate. -/
theorem integralPBWPreimage_singleton_mem_lattice {W : Type*} [Group W]
    {cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W} {i : I}
    (hw : cs.IsReduced [i]) (c : Fin [i].length → ℕ) :
    (integralPBWPreimage R hw c : Quotient D 𝕧) ∈ quotientCrystalLattice D := by
  rw [integralPBWPreimage_singleton]
  exact quotientIntegralGenerator_mem_lattice D i (c 0)

end Modified
end LieLean.QuantumGroup

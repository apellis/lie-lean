import LieLean.Algebra.QuantumGroup.Modified.IntegralPBWGlobal
import LieLean.Algebra.QuantumGroup.Modified.IntegralPBWG2Symm

/-!
# Global integral PBW spans for all four braid conventions

The inverse G₂ equality completes `BraidInvariantSymm` in arbitrary word contexts.
The existing Laurent-unit comparisons then transfer span invariance, left-descent
stability and finite-longest spanning to the two actual prime conventions.

## Main results

* `Modified.braidInvariantSymm`: arbitrary-word integral inverse braid invariance.
* `Modified.span_pbwDivPrime_braidMove`, `Modified.span_pbwDivPrimeSymm_braidMove`:
  arbitrary-word integral braid invariance for the prime conventions.
* The `*_all` reduced-word, left-descent and finite-longest spanning corollaries.

The convention dictionary is `pbwDiv = T''_{i,1}`, `pbwDivSymm = T'_{i,-1}`,
`pbwDivPrime = T'_{i,1}`, and `pbwDivPrimeSymm = T''_{i,-1}`. All spans are over
`ℤ[v,v⁻¹]` inside the quantum group over `ℚ(v)`. No finite-type hypothesis is needed
except for longest-element spanning. The simply-laced and no-triple-edge APIs are
unchanged. This reconstructed assembly concerns the span conclusions of Lusztig,
*Introduction to quantum groups*; canonical bases and bilinear forms remain separate.
-/
open LieLean Finset
noncomputable section
namespace LieLean.QuantumGroup
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "𝒜" => LaurentPolynomial ℤ
attribute [local instance] neZero_ratFunc_X
variable {I Y : Type*} [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y}
namespace Modified
attribute [local instance] laurentAlgebraK laurentAlgebraU laurentTowerU

/-- Integral braid invariance for the existing divided PBW convention. -/
theorem braidInvariantSymm : BraidInvariantSymm R := by
  apply braidInvariantSymm_of_span_pbwDivSymm_g2
  intro i j hij h3
  have hA := D.isGeneralizedCartan_cartanMatrix
  have h1 := hA.offDiag_nonpos i j hij
  have h2 := hA.offDiag_nonpos j i hij.symm
  have hcases : (D.cartanMatrix i j = -3 ∧ D.cartanMatrix j i = -1) ∨
      (D.cartanMatrix i j = -1 ∧ D.cartanMatrix j i = -3) := by
    generalize D.cartanMatrix i j = a at *
    generalize D.cartanMatrix j i = b at *
    have ha0 : a < 0 := lt_of_le_of_ne h1 (by intro h; simp [h] at h3)
    have hb0 : b < 0 := lt_of_le_of_ne h2 (by intro h; simp [h] at h3)
    have ha : -3 ≤ a := by nlinarith
    have hb : -3 ≤ b := by nlinarith
    interval_cases a <;> interval_cases b <;> simp_all
  rcases hcases with ⟨h, h'⟩ | ⟨h, h'⟩
  · exact span_pbwDivSymm_g2_braid hij h h'
  · exact (span_pbwDivSymm_g2_braid hij.symm h' h).symm

/-- Reduced words of the same element give equal integral PBW spans, for every Cartan datum. -/
theorem span_pbwDivSymm_of_isReduced_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {u w : List I}
    (hu : cs.IsReduced u) (hw : cs.IsReduced w) (huw : cs.wordProd u = cs.wordProd w) :
    Submodule.span 𝒜 (Set.range (pbwDivSymm R u)) = Submodule.span 𝒜 (Set.range (pbwDivSymm R w)) :=
  span_pbwDivSymm_of_isReduced_of_braidInvariant (braidInvariantSymm (R := R)) cs hu hw huw


/-- The integral PBW span of a reduced word is stable under divided powers at left descents. -/
theorem qDivPow_E_mul_mem_span_pbwDivSymm_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    {i : I} (hi : cs.IsLeftDescent (cs.wordProd w) i) (t : ℕ) {x : QuantumGroup R 𝕧}
    (hx : x ∈ Submodule.span 𝒜 (Set.range (pbwDivSymm R w))) :
    qDivPow (𝕧 ^ D.d i) t (E R 𝕧 i) * x ∈ Submodule.span 𝒜 (Set.range (pbwDivSymm R w)) :=
  qDivPow_E_mul_mem_span_pbwDivSymm_of_braidInvariant (braidInvariantSymm (R := R)) cs hw hi t
    hx


/-- For a reduced word of the longest element, the integral PBW span is the integral positive
subalgebra generated by all simple-root divided powers. -/
theorem span_pbwDivSymm_longest_eq_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    Submodule.span 𝒜 (Set.range (pbwDivSymm R w)) =
      (Algebra.adjoin 𝒜 (⋃ i, Set.range (Ed R i))).toSubmodule :=
  span_pbwDivSymm_longest_eq_of_braidInvariant (braidInvariantSymm (R := R)) cs hw hw₀


/-- The integral PBW span of a reduced word of the longest element is the existing `aPlus`. -/
theorem coe_span_pbwDivSymm_longest_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    (Submodule.span 𝒜 (Set.range (pbwDivSymm R w)) : Set (QuantumGroup R 𝕧)) = aPlus R :=
  coe_span_pbwDivSymm_longest_of_braidInvariant (braidInvariantSymm (R := R)) cs hw hw₀

/-- Every braid move preserves the integral `pbwDivPrime` span, including word contexts. -/
theorem span_pbwDivPrime_braidMove {u w : List I}
    (hm : D.cartanMatrix.coxeterMatrix.BraidMove u w) :
    Submodule.span 𝒜 (Set.range (pbwDivPrime R u)) =
      Submodule.span 𝒜 (Set.range (pbwDivPrime R w)) := by
  rw [span_pbwDivPrime, span_pbwDivPrime]
  exact braidInvariant u w hm

/-- Reduced words of the same element have equal integral `pbwDivPrime` spans. -/
theorem span_pbwDivPrime_of_isReduced_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {u w : List I}
    (hu : cs.IsReduced u) (hw : cs.IsReduced w) (huw : cs.wordProd u = cs.wordProd w) :
    Submodule.span 𝒜 (Set.range (pbwDivPrime R u)) =
      Submodule.span 𝒜 (Set.range (pbwDivPrime R w)) := by
  rw [span_pbwDivPrime, span_pbwDivPrime, span_pbwDiv_of_isReduced_all cs hu hw huw]

/-- The integral `pbwDivPrime` span is stable under divided powers at left descents. -/
theorem qDivPow_E_mul_mem_span_pbwDivPrime_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    {i : I} (hi : cs.IsLeftDescent (cs.wordProd w) i) (t : ℕ) {x : QuantumGroup R 𝕧}
    (hx : x ∈ Submodule.span 𝒜 (Set.range (pbwDivPrime R w))) :
    qDivPow (𝕧 ^ D.d i) t (E R 𝕧 i) * x ∈ Submodule.span 𝒜 (Set.range (pbwDivPrime R w)) := by
  rw [span_pbwDivPrime] at hx ⊢
  exact qDivPow_E_mul_mem_span_pbwDiv_all cs hw hi t hx

/-- At the longest element, the `pbwDivPrime` span is the integral positive subalgebra. -/
theorem span_pbwDivPrime_longest_eq_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    Submodule.span 𝒜 (Set.range (pbwDivPrime R w)) =
      (Algebra.adjoin 𝒜 (⋃ i, Set.range (Ed R i))).toSubmodule := by
  rw [span_pbwDivPrime, span_pbwDiv_longest_eq_all cs hw hw₀]

/-- The longest-element integral `pbwDivPrime` span is the existing `aPlus`. -/
theorem coe_span_pbwDivPrime_longest_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    (Submodule.span 𝒜 (Set.range (pbwDivPrime R w)) : Set (QuantumGroup R 𝕧)) = aPlus R := by
  rw [span_pbwDivPrime, coe_span_pbwDiv_longest_all cs hw hw₀]

/-- Every braid move preserves the integral `pbwDivPrimeSymm` span, including word contexts. -/
theorem span_pbwDivPrimeSymm_braidMove {u w : List I}
    (hm : D.cartanMatrix.coxeterMatrix.BraidMove u w) :
    Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R u)) =
      Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w)) := by
  rw [span_pbwDivPrimeSymm, span_pbwDivPrimeSymm]
  exact braidInvariantSymm u w hm

/-- Reduced words of the same element have equal integral `pbwDivPrimeSymm` spans. -/
theorem span_pbwDivPrimeSymm_of_isReduced_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {u w : List I}
    (hu : cs.IsReduced u) (hw : cs.IsReduced w) (huw : cs.wordProd u = cs.wordProd w) :
    Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R u)) =
      Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w)) := by
  rw [span_pbwDivPrimeSymm, span_pbwDivPrimeSymm, span_pbwDivSymm_of_isReduced_all cs hu hw huw]

/-- The integral `pbwDivPrimeSymm` span is stable under divided powers at left descents. -/
theorem qDivPow_E_mul_mem_span_pbwDivPrimeSymm_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    {i : I} (hi : cs.IsLeftDescent (cs.wordProd w) i) (t : ℕ) {x : QuantumGroup R 𝕧}
    (hx : x ∈ Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w))) :
    qDivPow (𝕧 ^ D.d i) t (E R 𝕧 i) * x ∈ Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w)) := by
  rw [span_pbwDivPrimeSymm] at hx ⊢
  exact qDivPow_E_mul_mem_span_pbwDivSymm_all cs hw hi t hx

/-- At the longest element, the `pbwDivPrimeSymm` span is the integral positive subalgebra. -/
theorem span_pbwDivPrimeSymm_longest_eq_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w)) =
      (Algebra.adjoin 𝒜 (⋃ i, Set.range (Ed R i))).toSubmodule := by
  rw [span_pbwDivPrimeSymm, span_pbwDivSymm_longest_eq_all cs hw hw₀]

/-- The longest-element integral `pbwDivPrimeSymm` span is the existing `aPlus`. -/
theorem coe_span_pbwDivPrimeSymm_longest_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    (Submodule.span 𝒜 (Set.range (pbwDivPrimeSymm R w)) : Set (QuantumGroup R 𝕧)) = aPlus R := by
  rw [span_pbwDivPrimeSymm, coe_span_pbwDivSymm_longest_all cs hw hw₀]

end Modified
end LieLean.QuantumGroup

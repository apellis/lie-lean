import LieLean.Algebra.QuantumGroup.Modified.IntegralPBWG2

/-!
# Integral PBW span invariance for arbitrary Cartan data

The local G₂ equality completes the rank-two braid cases. The existing context lemma
transports these equalities through arbitrary prefixes and suffixes, using the actual
braid automorphisms over `ℚ(v)`. The coefficient ring throughout is `ℤ[v,v⁻¹]`.

## Main results

* `Modified.braidInvariant`: every braid move preserves the existing `pbwDiv` span.
* `Modified.span_pbwDiv_of_isReduced_all`: reduced-word invariance.
* `Modified.qDivPow_E_mul_mem_span_pbwDiv_all`: left-descent stability.
* `Modified.span_pbwDiv_longest_eq_all`, `Modified.coe_span_pbwDiv_longest_all`:
  integral longest-element spanning, when the Coxeter group is finite.

The reconstructed proof completes the span results of Lusztig, *Introduction to quantum
groups*, for `T''_{i,1}`. The reduced-word and descent results do not require finite type.
The older simply-laced and no-triple-edge APIs remain available. Inverse braid conventions,
other signs, integral bases and bilinear forms are not extended here.
-/
open LieLean Finset
noncomputable section
namespace LieLean.QuantumGroup
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "𝒜" => LaurentPolynomial ℤ
attribute [local instance] neZero_ratFunc_X
variable {I Y : Type*} [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y}
namespace Modified
attribute [local instance] laurentAlgebraK laurentAlgebraU laurentTowerU

/-- Integral braid invariance for the existing divided PBW convention. -/
theorem braidInvariant : BraidInvariant R := by
  apply braidInvariant_of_span_pbwDiv_g2
  intro i j hij h3
  have hA := D.isGeneralizedCartan_cartanMatrix
  have h1 := hA.offDiag_nonpos i j hij
  have h2 := hA.offDiag_nonpos j i hij.symm
  have hcases : (D.cartanMatrix i j = -3 ∧ D.cartanMatrix j i = -1) ∨
      (D.cartanMatrix i j = -1 ∧ D.cartanMatrix j i = -3) := by
    generalize D.cartanMatrix i j = a at *
    generalize D.cartanMatrix j i = b at *
    have ha0 : a < 0 := lt_of_le_of_ne h1 (by intro h; simp [h] at h3)
    have hb0 : b < 0 := lt_of_le_of_ne h2 (by intro h; simp [h] at h3)
    have ha : -3 ≤ a := by nlinarith
    have hb : -3 ≤ b := by nlinarith
    interval_cases a <;> interval_cases b <;> simp_all
  rcases hcases with ⟨h, h'⟩ | ⟨h, h'⟩
  · exact span_pbwDiv_g2_braid hij h h'
  · exact (span_pbwDiv_g2_braid hij.symm h' h).symm

/-- Reduced words of the same element give equal integral PBW spans, for every Cartan datum. -/
theorem span_pbwDiv_of_isReduced_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {u w : List I}
    (hu : cs.IsReduced u) (hw : cs.IsReduced w) (huw : cs.wordProd u = cs.wordProd w) :
    Submodule.span 𝒜 (Set.range (pbwDiv R u)) = Submodule.span 𝒜 (Set.range (pbwDiv R w)) :=
  span_pbwDiv_of_isReduced_of_braidInvariant (braidInvariant (R := R)) cs hu hw huw


/-- The integral PBW span of a reduced word is stable under divided powers at left descents. -/
theorem qDivPow_E_mul_mem_span_pbwDiv_all {W : Type*} [Group W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    {i : I} (hi : cs.IsLeftDescent (cs.wordProd w) i) (t : ℕ) {x : QuantumGroup R 𝕧}
    (hx : x ∈ Submodule.span 𝒜 (Set.range (pbwDiv R w))) :
    qDivPow (𝕧 ^ D.d i) t (E R 𝕧 i) * x ∈ Submodule.span 𝒜 (Set.range (pbwDiv R w)) :=
  qDivPow_E_mul_mem_span_pbwDiv_of_braidInvariant (braidInvariant (R := R)) cs hw hi t
    hx


/-- For a reduced word of the longest element, the integral PBW span is the integral positive
subalgebra generated by all simple-root divided powers. -/
theorem span_pbwDiv_longest_eq_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    Submodule.span 𝒜 (Set.range (pbwDiv R w)) =
      (Algebra.adjoin 𝒜 (⋃ i, Set.range (Ed R i))).toSubmodule :=
  span_pbwDiv_longest_eq_of_braidInvariant (braidInvariant (R := R)) cs hw hw₀


/-- The integral PBW span of a reduced word of the longest element is the existing `aPlus`. -/
theorem coe_span_pbwDiv_longest_all {W : Type*} [Group W] [Finite W]
    (cs : CoxeterSystem D.cartanMatrix.coxeterMatrix W) {w : List I} (hw : cs.IsReduced w)
    (hw₀ : cs.wordProd w = cs.longestElement) :
    (Submodule.span 𝒜 (Set.range (pbwDiv R w)) : Set (QuantumGroup R 𝕧)) = aPlus R :=
  coe_span_pbwDiv_longest_of_braidInvariant (braidInvariant (R := R)) cs hw hw₀

end Modified
end LieLean.QuantumGroup

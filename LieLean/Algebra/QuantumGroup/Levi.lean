import LieLean.Algebra.QuantumGroup.ModuleSymmetry.Integrable

/-!
# Levi subalgebras `U_q(𝔤_J) ⊆ U_q(𝔤)` and restriction of modules

For an injection `e : J ↪ I` of index sets, a Cartan datum `D` on `I` restricts to a Cartan datum
`D.comap e` on `J`, and a root datum `R` of type `D` with coweight lattice `Y` restricts to the root
datum `R.comap e` of type `D.comap e` with the same lattice `Y` and the simple roots and coroots
indexed by `J`. This is the datum `{P, {αᵢ}_{i ∈ J}, {hᵢ}_{i ∈ J}}` of [Kas] §4.6. The algebra
homomorphism `U(R.comap e) → U(R)`, `Eⱼ ↦ E_{e j}`, `Fⱼ ↦ F_{e j}`, `K_μ ↦ K_μ`
(`QuantumGroup.leviHom`), has image the subalgebra `U_q(𝔤_J)` generated by the `Eᵢ`, `Fᵢ`, `i ∈ J`,
and the `K_μ`.

A `U(R)`-module `M` is a `U(R.comap e)`-module `QuantumGroup.LeviRestrict R v e M` along
`leviHom`. Its weight spaces are those of `M` (`QuantumGroup.weightSpace_leviRestrict`), it is
integrable when `M` is (`QuantumGroup.IsIntegrable.leviRestrict`), and its rank-one structure at
`j ∈ J` is that of `M` at `e j` (`QuantumGroup.nodeSl2_leviRestrict`).

## References

* [Kas] M. Kashiwara, *On crystal bases*, CMS Conf. Proc. 16 (1995), §4.6.
-/

noncomputable section

open LieLean

namespace LusztigCartanDatum

variable {I J : Type*} (D : LusztigCartanDatum I) (e : J ↪ I)

/-- The restriction of a Cartan datum along an injection `e : J ↪ I`: `j · j' = e j · e j'`. -/
def comap : LusztigCartanDatum J where
  dot j j' := D.dot (e j) (e j')
  dot_comm _ _ := D.dot_comm _ _
  dot_self_pos _ := D.dot_self_pos _
  even_dot_self _ := D.even_dot_self _
  dot_nonpos _ _ h := D.dot_nonpos _ _ (e.injective.ne h)
  dot_self_dvd _ _ := D.dot_self_dvd _ _

@[simp] lemma comap_dot (j j' : J) : (D.comap e).dot j j' = D.dot (e j) (e j') := rfl

@[simp] lemma comap_d (j : J) : (D.comap e).d j = D.d (e j) := rfl

@[simp] lemma comap_cartanMatrix (j j' : J) :
    (D.comap e).cartanMatrix j j' = D.cartanMatrix (e j) (e j') := rfl

variable {D} {Y : Type*} [AddCommGroup Y]

/-- The restriction of a root datum along `e : J ↪ I`: the same lattice `Y`, with the simple
coroots and roots indexed by `J`. -/
def RootDatum.comap (R : D.RootDatum Y) : (D.comap e).RootDatum Y where
  coroot j := R.coroot (e j)
  root j := R.root (e j)
  root_coroot _ _ := R.root_coroot _ _

@[simp] lemma RootDatum.comap_coroot (R : D.RootDatum Y) (j : J) :
    (R.comap e).coroot j = R.coroot (e j) := rfl

@[simp] lemma RootDatum.comap_root (R : D.RootDatum Y) (j : J) :
    (R.comap e).root j = R.root (e j) := rfl

lemma RootDatum.comap_rootSum (R : D.RootDatum Y) (ν : J →₀ ℕ) :
    (R.comap e).rootSum ν = R.rootSum (ν.embDomain e) := by
  simp [LusztigCartanDatum.RootDatum.rootSum, Finsupp.sum_embDomain]

lemma RootDatum.IsXRegular.comap {R : D.RootDatum Y} (hR : R.IsXRegular) :
    (R.comap e).IsXRegular :=
  hR.comp e e.injective

end LusztigCartanDatum

namespace LieLean.QuantumGroup

variable {k I J Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] [DecidableEq J]
  {D : LusztigCartanDatum I} (R : D.RootDatum Y) (v : k) (e : J ↪ I)

omit [DecidableEq I] [DecidableEq J] in
@[simp] lemma ktilde_comap (j : J) : ktilde (R.comap e) j = ktilde R (e j) := rfl

/-- The generators `E_{e j}`, `F_{e j}`, `K_μ` of `U(R)` satisfy the relations of `U(R.comap e)`. -/
theorem levi_relations :
    Relations (R.comap e) v (fun j ↦ E R v (e j)) (fun j ↦ F R v (e j)) (KHom R v) where
  K_mul_E μ j := K_mul_E R v μ (e j)
  K_mul_F μ j := K_mul_F R v μ (e j)
  E_mul_F j j' := by
    show E R v (e j) * F R v (e j') - F R v (e j') * E R v (e j) = _
    rw [E_mul_F_sub]
    by_cases h : j = j'
    · subst h
      rw [if_pos rfl, if_pos rfl]
      rfl
    · rw [if_neg (e.injective.ne h), if_neg h]
  serre_E _ _ h := serre_E R v (e.injective.ne h)
  serre_F _ _ h := serre_F R v (e.injective.ne h)

/-- The homomorphism `U(R.comap e) → U(R)` onto the Levi subalgebra `U_q(𝔤_J)` ([Kas] §4.6). -/
def leviHom : QuantumGroup (R.comap e) v →ₐ[k] QuantumGroup R v := lift (levi_relations R v e)

@[simp] lemma leviHom_E (j : J) : leviHom R v e (E (R.comap e) v j) = E R v (e j) :=
  lift_E (levi_relations R v e) j

@[simp] lemma leviHom_F (j : J) : leviHom R v e (F (R.comap e) v j) = F R v (e j) :=
  lift_F (levi_relations R v e) j

@[simp] lemma leviHom_K (μ : Y) : leviHom R v e (K (R.comap e) v μ) = K R v μ :=
  lift_K (levi_relations R v e) μ

/-! ### Restriction of modules -/

variable (M : Type*) [AddCommGroup M] [Module k M] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M]

/-- A `U(R)`-module `M`, regarded as a `U(R.comap e)`-module along `leviHom`. -/
@[nolint unusedArguments]
def LeviRestrict {D : LusztigCartanDatum I} (_R : D.RootDatum Y) (_v : k) (_e : J ↪ I)
    (M : Type*) : Type _ := M

namespace LeviRestrict

omit [DecidableEq I] [DecidableEq J] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M]

instance : AddCommGroup (LeviRestrict R v e M) := inferInstanceAs (AddCommGroup M)

instance : Module k (LeviRestrict R v e M) := inferInstanceAs (Module k M)

instance {A : Type*} [Semiring A] [Module A M] : Module A (LeviRestrict R v e M) :=
  inferInstanceAs (Module A M)

instance {A : Type*} [CommSemiring A] [Algebra A k] [Module A M] [IsScalarTower A k M] :
    IsScalarTower A k (LeviRestrict R v e M) :=
  inferInstanceAs (IsScalarTower A k M)

/-- The identity `M ≃ LeviRestrict R v e M` as a `k`-linear equivalence. -/
def of : M ≃ₗ[k] LeviRestrict R v e M := LinearEquiv.refl k M

@[simp] lemma of_apply (m : M) : of R v e M m = m := rfl

end LeviRestrict

omit [IsScalarTower k (QuantumGroup R v) M] in
instance : Module (QuantumGroup (R.comap e) v) (LeviRestrict R v e M) :=
  (Module.compHom M (leviHom R v e).toRingHom : Module (QuantumGroup (R.comap e) v) M)

omit [IsScalarTower k (QuantumGroup R v) M] in
lemma leviRestrict_smul (u : QuantumGroup (R.comap e) v) (m : LeviRestrict R v e M) :
    u • m = (leviHom R v e u • (m : M) : M) := rfl

instance : IsScalarTower k (QuantumGroup (R.comap e) v) (LeviRestrict R v e M) where
  smul_assoc c u m := by
    change leviHom R v e (c • u) • (m : M) = c • (leviHom R v e u • (m : M))
    rw [map_smul, smul_assoc]

variable {R v e M}

omit [IsScalarTower k (QuantumGroup R v) M] in
lemma E_smul_leviRestrict (j : J) (m : LeviRestrict R v e M) :
    E (R.comap e) v j • m = (E R v (e j) • (m : M) : M) := by
  rw [leviRestrict_smul, leviHom_E]

omit [IsScalarTower k (QuantumGroup R v) M] in
lemma F_smul_leviRestrict (j : J) (m : LeviRestrict R v e M) :
    F (R.comap e) v j • m = (F R v (e j) • (m : M) : M) := by
  rw [leviRestrict_smul, leviHom_F]

omit [IsScalarTower k (QuantumGroup R v) M] in
lemma K_smul_leviRestrict (μ : Y) (m : LeviRestrict R v e M) :
    K (R.comap e) v μ • m = (K R v μ • (m : M) : M) := by
  rw [leviRestrict_smul, leviHom_K]

omit [IsScalarTower k (QuantumGroup R v) M] in
/-- The weight spaces of the restriction are those of `M`. -/
theorem weightSpace_leviRestrict (Λ : Y →+ ℤ) :
    weightSpace (R.comap e) v (LeviRestrict R v e M) Λ = weightSpace R v M Λ := by
  ext m
  show (∀ μ, K (R.comap e) v μ • m = v ^ Λ μ • m) ↔ ∀ μ, K R v μ • (m : M) = v ^ Λ μ • (m : M)
  exact forall_congr' fun μ ↦ by rw [K_smul_leviRestrict]; rfl

omit [IsScalarTower k (QuantumGroup R v) M] in
/-- The restriction of an integrable module is integrable. -/
theorem IsIntegrable.leviRestrict (hM : IsIntegrable R v M) :
    IsIntegrable (R.comap e) v (LeviRestrict R v e M) where
  iSup_weightSpace_eq_top := by
    simp only [weightSpace_leviRestrict]
    exact hM.iSup_weightSpace_eq_top
  exists_E_pow_smul_eq_zero j m := by
    obtain ⟨n, hn⟩ := hM.exists_E_pow_smul_eq_zero (e j) (m : M)
    exact ⟨n, by rw [leviRestrict_smul, map_pow, leviHom_E]; exact hn⟩
  exists_F_pow_smul_eq_zero j m := by
    obtain ⟨n, hn⟩ := hM.exists_F_pow_smul_eq_zero (e j) (m : M)
    exact ⟨n, by rw [leviRestrict_smul, map_pow, leviHom_F]; exact hn⟩

lemma nodeWt_leviRestrict (j : J) (n : ℤ) :
    nodeWt (R.comap e) v (LeviRestrict R v e M) j n = nodeWt R v M (e j) n := by
  simp only [nodeWt, weightSpace_leviRestrict]
  rfl

/-- Rank-one structures with the same operators and grading are equal. -/
lemma IntegrableSl2.eq_of {q : k} {N : Type*} [AddCommGroup N] [Module k N]
    {V W : IntegrableSl2 q N} (hE : V.E = W.E) (hF : V.F = W.F) (hwt : V.wt = W.wt) : V = W := by
  cases V
  cases W
  cases hE
  cases hF
  cases hwt
  rfl

variable [NeZero v] (hv : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) (hM : IsIntegrable R v M)

/-- The rank-one structure of the restriction at `j ∈ J` is that of `M` at `e j`. -/
theorem nodeSl2_leviRestrict (j : J) :
    (nodeSl2 (R.comap e) v (LeviRestrict R v e M) hv hM.leviRestrict j :
      IntegrableSl2 (v ^ D.d (e j)) M) = nodeSl2 R v M hv hM (e j) := by
  refine IntegrableSl2.eq_of ?_ ?_ ?_
  · ext m
    exact E_smul_leviRestrict j m
  · ext m
    exact F_smul_leviRestrict j m
  · funext n
    exact nodeWt_leviRestrict j n

end LieLean.QuantumGroup

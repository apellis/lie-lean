import LieLean.Algebra.QuantumGroup.PBW.G2FAIntegral

/-!
# Multiplicative closure of the integral G₂ ordered span

The existing six-root ordered additive span equals the existing subring generated by
Laurent coefficients and the two simple-root divided powers. The reconstructed proof
uses right-simple-root stability and induction on the generated subring; it does not
assume multiplicative closure or linear independence. The hypotheses retain `q = ±1`
when the positive quantum integers are nonzero.

## Main results

* `orderedSpan_eq_genRing`: equality of the underlying additive subgroups.
* `orderedSpan_mul`: products of arbitrary elements of the ordered span remain in it.

This supplies the integral rank-two span comparison needed before identifying the two
G₂ braid-word spans. No braid-word identification or basis theorem is asserted here.
-/

noncomputable section
namespace LieLean.QuantumGroup.G2Integral

variable {k B : Type*} [Field k] [Ring B] [Algebra k B]
  {q : k} {Λ : Subring k} {e A b C D f : B}
  (hq : q ≠ 0) (hqi : ∀ n : ℕ, 0 < n → qInt q n ≠ 0)
  (hpi : ∀ n : ℕ, 0 < n → qInt (q ^ 3) n ≠ 0)
  (H : Rel q e A b C D f) (hqΛ : q ∈ Λ) (hiΛ : q⁻¹ ∈ Λ)

include hq hqi hpi H hqΛ hiΛ in
/-- The ordered span is stable under right multiplication by the generated subring.
This is proved from simple-root stability, without assuming closure of the span. -/
lemma orderedSpan_mul_genRing {x y : B} (hx : x ∈ orderedSpan q Λ e A b C D f)
    (hy : y ∈ genRing q Λ e f) : x * y ∈ orderedSpan q Λ e A b C D f := by
  have stable : ∀ y ∈ genRing q Λ e f, ∀ x ∈ orderedSpan q Λ e A b C D f,
      x * y ∈ orderedSpan q Λ e A b C D f := by
    intro y hy
    induction hy using Subring.closure_induction with
    | mem y hy =>
      rcases hy with (⟨c, hc, rfl⟩ | ⟨n, rfl⟩) | ⟨n, rfl⟩
      · intro x hx
        rw [← Algebra.commutes, ← Algebra.smul_def]
        exact smul_mem_orderedSpan hc hx
      · exact fun x hx => orderedSpan_mul_e hq hqi hpi H hqΛ hiΛ n hx
      · exact fun x hx => orderedSpan_mul_f hpi hqΛ hiΛ n hx
    | zero => intro x _; rw [mul_zero]; exact zero_mem _
    | one => intro x hx; rwa [mul_one]
    | add y z _ _ hy hz =>
      intro x hx
      rw [mul_add]
      exact add_mem (hy x hx) (hz x hx)
    | neg y _ hy =>
      intro x hx
      rw [mul_neg]
      exact neg_mem (hy x hx)
    | mul y z _ _ hy hz =>
      intro x hx
      rw [← mul_assoc]
      exact hz (x * y) (hy x hx)
  exact stable y hy x hx

include hq hqi hpi H hqΛ hiΛ in
/-- Every element generated by Laurent scalars and simple-root divided powers belongs
to the six-root ordered span. -/
theorem genRing_le_orderedSpan :
    (genRing q Λ e f).toAddSubgroup ≤ orderedSpan q Λ e A b C D f := by
  intro x hx
  simpa only [one_mul] using
    orderedSpan_mul_genRing hq hqi hpi H hqΛ hiΛ one_mem_orderedSpan hx

include hq hqi hpi H hqΛ hiΛ in
/-- The actual six-root ordered integral span is exactly the additive subgroup underlying
the subring generated by the two simple-root divided-power families and coefficients.
This reconstructed equality retains `q = ±1`; no independence assumption is used. -/
theorem orderedSpan_eq_genRing :
    orderedSpan q Λ e A b C D f = (genRing q Λ e f).toAddSubgroup :=
  le_antisymm (orderedSpan_le_genRing_all hq hqi hpi H hqΛ hiΛ)
    (genRing_le_orderedSpan hq hqi hpi H hqΛ hiΛ)

include hq hqi hpi H hqΛ hiΛ in
/-- Products of any two elements of the six-root ordered integral span remain in it. -/
theorem orderedSpan_mul {x y : B} (hx : x ∈ orderedSpan q Λ e A b C D f)
    (hy : y ∈ orderedSpan q Λ e A b C D f) :
    x * y ∈ orderedSpan q Λ e A b C D f :=
  orderedSpan_mul_genRing hq hqi hpi H hqΛ hiΛ hx
    (orderedSpan_le_genRing_all hq hqi hpi H hqΛ hiΛ hy)

end LieLean.QuantumGroup.G2Integral

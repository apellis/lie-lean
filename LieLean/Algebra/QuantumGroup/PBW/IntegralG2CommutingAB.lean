import LieLean.Algebra.QuantumGroup.BraidAction.TripleEdge
import LieLean.Algebra.QuantumGroup.PBW.IntegralG2Basic

/-!
# G₂ commutation certificate for AB

The adjacent normalized root vectors q-commute. The three internal pairs are proved by
polynomial identities in the two-sided ideal generated by the quantum Serre relations; for
this pair the identity is the one of the triple-edge braid relation.
The scalar nonvanishing assumptions used to cancel these identities hold at every parameter
which is not a root of unity; their necessity at special parameters is not asserted.
-/

open Finset

noncomputable section

namespace LieLean.QuantumGroup.G2Integral

variable {k B : Type*} [Field k] [Ring B] [Algebra k B]
  {q : k} {e f : B}

/-- `x₂` in expanded form. -/
private lemma x2_expand (hq : q ≠ 0) : G2PBW.x2 q e f =
    e ^ 2 * f - ((q + q⁻¹) * q⁻¹ ^ 2) • (e * f * e) + q⁻¹ ^ 4 • (f * e ^ 2) := by
  simp only [G2PBW.x1, G2PBW.x2, pow_succ, pow_zero, one_mul, mul_sub, sub_mul, smul_sub,
    mul_smul_comm, smul_mul_assoc, smul_smul, mul_assoc]
  match_scalars <;> (field_simp; try ring)

/-- `x₃` in expanded form. -/
private lemma x3_expand (hq : q ≠ 0) : G2PBW.x3 q e f =
    e ^ 3 * f - ((q ^ 2 + 1 + q⁻¹ ^ 2) * q⁻¹) • (e ^ 2 * f * e) +
      ((q ^ 2 + 1 + q⁻¹ ^ 2) * q⁻¹ ^ 2) • (e * f * e ^ 2) - q⁻¹ ^ 3 • (f * e ^ 3) := by
  simp only [G2PBW.x1, G2PBW.x2, G2PBW.x3, pow_succ, pow_zero, one_mul, mul_sub, sub_mul,
    smul_sub, mul_smul_comm, smul_mul_assoc, smul_smul, mul_assoc]
  match_scalars <;> (field_simp; try ring)

/-- `x₂x₃ = q⁻³x₃x₂`, from the certificate `tripleEdge_originalSerre_certificate` in the ideal
of the two Serre relations. -/
lemma x2_mul_x3_raw (hq : q ≠ 0)
    (h4 : (1 + (q ^ 4)) ≠ 0)
    (hS4 : qSerre q 4 e f = 0) (hS2 : qSerre (q ^ 3) 2 f e = 0) :
    G2PBW.x2 q e f * G2PBW.x3 q e f =
      (q ^ 3)⁻¹ • (G2PBW.x3 q e f * G2PBW.x2 q e f) := by
  have hd : q ^ 7 * (q ^ 4 + 1) ≠ 0 :=
    mul_ne_zero (pow_ne_zero _ hq) (by rwa [add_comm])
  have key := tripleEdge_originalSerre_certificate e f q hq hS4 hS2
  dsimp only at key
  rw [← x2_expand hq, ← x3_expand hq, inv_pow] at key
  exact sub_eq_zero.mp ((smul_eq_zero.mp key).resolve_left hd)

end LieLean.QuantumGroup.G2Integral

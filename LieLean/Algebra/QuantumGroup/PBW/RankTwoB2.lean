import LieLean.Algebra.QuantumGroup.PBW.RankTwoRootVectors

/-!
# The PBW basis of `U⁺` in type `B₂`

Let `{i, j}` be an exact two-node Cartan datum with `aᵢⱼ = -2`, `aⱼᵢ = -1` (type `B₂`, `i` the
short node), `q = vᵢ` and `p = q² = vⱼ`. Along the reduced expression `sᵢ sⱼ sᵢ sⱼ` of the
longest Weyl group element, the root vectors are `Eᵢ`, `Tᵢ(Eⱼ) = [2]ᵢ!⁻¹ x`, `TᵢTⱼ(Eᵢ) = y` and
`TᵢTⱼTᵢ(Eⱼ) = Eⱼ`, where `y = EᵢEⱼ - p⁻¹EⱼEᵢ` and `x = Eᵢy - yEᵢ`. We prove that the ordered
monomials `Eᵢ^A Tᵢ(Eⱼ)^B (TᵢTⱼEᵢ)^C Eⱼ^D` form a basis of `U⁺`, the subalgebra of `U = U_v(𝔤)`
generated by the `Eₗ` ([Jan] 8.24, Rem. 1, [Lus] Cor. 40.2.2).

## Method

The method is the one of `RankTwoA2.lean`. With `e = Eᵢ`, `f = Eⱼ`, the relations
`f e = p e f - p y`, `y e = e y - x` (definitions), `x e = p⁻¹ e x` (the cubic Serre relation) and
`f y = p⁻¹ y f` (the quadratic one), packaged as `B2PBW.Rel`, imply `f x = x f - (p - 1) y²`
(`B2PBW.Rel.fx`) and `y x = p⁻¹ x y` (`B2PBW.Rel.yx`). They give the straightening formula
`f · e^A x^B y^C f^D = p^{A-C} e^A x^B y^C f^{D+1} - p^A (p - 1) d_B e^A x^{B-1} y^{C+2} f^D
  + β_A p^{-B} e^{A-1} x^B y^{C+1} f^D + γ_A e^{A-2} x^{B+1} y^C f^D`
(`B2PBW.monoMap_opF`), with explicit rational functions `β_A, γ_A, d_B` of `p` and `p^A, p^B`.
These formulas define operators `B2PBW.opE`, `B2PBW.opF` on `k[ℕ⁴]`; we prove directly that they
satisfy `x e = p⁻¹ e x` and `f y = p⁻¹ y f` (`B2PBW.opX_mul_opE`, `B2PBW.opF_mul_opY`), hence both
Serre relations, so they define a representation `B2PBW.rep` of Lusztig's `'f` killing the
Serre ideal (`B2PBW.serreIdeal_le_ker_rep`). Spanning and independence then follow as for `A₂`,
using `U⁺ ≅ 'f ⧸ J` (`plusHom_eq_zero_iff`). The argument is our reconstruction; it does not
use the bilinear form or a dimension count.

## Main results

* `QuantumGroup.span_b2PBWMono`: the monomials span `U⁺`, assuming `vᵢ - vᵢ⁻¹ ≠ 0` and
  `[2]ᵢ! ≠ 0`.
* `QuantumGroup.linearIndependent_b2PBWMono`: they are linearly independent, for `v` not a root
  of unity.
* `QuantumGroup.b2PBWBasis`, `QuantumGroup.b2PBWBasis_apply`: the PBW basis of `U⁺`.
* `QuantumGroup.b2PBWMono_eq_rootVectors`, `QuantumGroup.b2PBWBasis_apply_braidEquiv`: the basis
  vectors are the ordered monomials in the root vectors `Eᵢ, Tᵢ(Eⱼ), TᵢTⱼ(Eᵢ), TᵢTⱼTᵢ(Eⱼ)`, for
  any endomorphisms with Lusztig's generator formulas, in particular for
  `twoNodeBraidEquiv_of_not_root`.

## References

* [Jan] J. C. Jantzen, *Lectures on quantum groups*, GSM 6, §8.21–8.24.
* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, §40.1–40.2.
-/

open LieLean

noncomputable section

open LusztigF

namespace LieLean.QuantumGroup

namespace B2PBW

/-! ### Structure constants -/

section Scalars

variable {k : Type*} [Field k] (p : k)

/-- `β_A = -(p + p² + ⋯ + p^A)`. -/
def cβ (A : ℕ) : k := p * (1 - p ^ A) / (p - 1)

/-- `γ_A`, the coefficient of `e^{A-2} x` in `f e^A`. -/
def cγ (A : ℕ) : k := p * (((p ^ A)⁻¹ - p ^ A) * p ^ 2 / (p ^ 2 - 1) - cβ p A) / (p - 1)

/-- `g_A = -(1 + p⁻¹ + ⋯ + p^{1-A})`, the coefficient of `e^{A-1} x` in `y e^A`. -/
def cg (A : ℕ) : k := -(p * (1 - (p ^ A)⁻¹) / (p - 1))

/-- `d_B = 1 + p⁻² + ⋯ + p^{2-2B}`, the coefficient of `x^{B-1} y²` in `f x^B`. -/
def cd (B : ℕ) : k := p ^ 2 * (1 - ((p ^ B) ^ 2)⁻¹) / (p ^ 2 - 1)

@[simp] lemma cβ_zero : cβ p 0 = 0 := by simp [cβ]
@[simp] lemma cγ_zero : cγ p 0 = 0 := by simp [cγ]
@[simp] lemma cg_zero : cg p 0 = 0 := by simp [cg]
@[simp] lemma cd_zero : cd p 0 = 0 := by simp [cd]

variable {p}

lemma cγ_one (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) : cγ p 1 = 0 := by
  simp only [cγ, cβ, pow_one]
  field_simp
  ring

end Scalars

/-- Normalises the indices and the vanishing coefficients in a sum of basis vectors. -/
local macro "b2_norm" h1:term:max h2:term:max : tactic => `(tactic|
  simp only [Nat.add_sub_cancel, Nat.zero_sub, Nat.sub_zero, zero_add, add_assoc, Nat.reduceAdd,
    Nat.reduceSubDiff, Nat.reduceSub, cβ_zero, cγ_zero, cd_zero, cg_zero, cγ_one $h1 $h2,
    mul_zero, zero_mul, zero_smul, add_zero, sub_zero, zero_sub, neg_zero, pow_zero, inv_one,
    mul_one, smul_zero])

/-- Closes the scalar goals left by `match_scalars`. -/
local macro "b2_scalars" : tactic => `(tactic|
  ((try simp only [cβ, cγ, cg, cd]); (try field_simp); (try ring)))

/-! ### The operator model on `k[ℕ⁴]` -/

section Operators

variable {k : Type*} [Field k] (p : k)

/-- The model space: finitely supported functions on exponent quadruples `(A, B, C, D)`. -/
abbrev Space (k : Type*) [Field k] := (ℕ × ℕ × ℕ × ℕ) →₀ k

/-- `e · (A, B, C, D) = (A + 1, B, C, D)`. -/
def opE : Module.End k (Space k) := Finsupp.lmapDomain k k (fun p ↦ (p.1 + 1, p.2))

/-- The straightening operator of `f`. -/
def opF : Module.End k (Space k) := Finsupp.linearCombination k (fun m : ℕ × ℕ × ℕ × ℕ ↦
  (p ^ m.1 * (p ^ m.2.2.1)⁻¹) • Finsupp.single (m.1, m.2.1, m.2.2.1, m.2.2.2 + 1) (1 : k) -
    (p ^ m.1 * (p - 1) * cd p m.2.1) • Finsupp.single (m.1, m.2.1 - 1, m.2.2.1 + 2, m.2.2.2) 1 +
    (cβ p m.1 * (p ^ m.2.1)⁻¹) • Finsupp.single (m.1 - 1, m.2.1, m.2.2.1 + 1, m.2.2.2) 1 +
    cγ p m.1 • Finsupp.single (m.1 - 2, m.2.1 + 1, m.2.2.1, m.2.2.2) 1)

/-- The operator of `y = e f - p⁻¹ f e`. -/
def opY : Module.End k (Space k) := A2PBW.qComm p opE (opF p)

/-- The operator of `x = e y - y e`. -/
def opX : Module.End k (Space k) := opE * opY p - opY p * opE

variable {p}

lemma opE_single (A B C D : ℕ) (x : k) :
    opE (Finsupp.single (A, B, C, D) x) = Finsupp.single (A + 1, B, C, D) x := by
  simp [opE]

lemma opF_single (A B C D : ℕ) (x : k) :
    opF p (Finsupp.single (A, B, C, D) x) =
      x • ((p ^ A * (p ^ C)⁻¹) • Finsupp.single (A, B, C, D + 1) (1 : k) -
        (p ^ A * (p - 1) * cd p B) • Finsupp.single (A, B - 1, C + 2, D) 1 +
        (cβ p A * (p ^ B)⁻¹) • Finsupp.single (A - 1, B, C + 1, D) 1 +
        cγ p A • Finsupp.single (A - 2, B + 1, C, D) 1) := by
  simp [opF]

lemma opY_single (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (A B C D : ℕ) (x : k) :
    opY p (Finsupp.single (A, B, C, D) x) =
      (x * (p ^ B)⁻¹) • Finsupp.single (A, B, C + 1, D) 1 +
        (x * cg p A) • Finsupp.single (A - 1, B + 1, C, D) 1 := by
  rcases A with _ | _ | A <;> rcases B with _ | B <;>
  · simp only [opY, A2PBW.qComm, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.mul_apply,
      opF_single, opE_single, map_sub, map_add, map_smul, smul_add, smul_sub, smul_smul]
    b2_norm h1 h2
    match_scalars <;> b2_scalars

lemma opX_single (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (A B C D : ℕ) (x : k) :
    opX p (Finsupp.single (A, B, C, D) x) =
      (x * (p ^ A)⁻¹) • Finsupp.single (A, B + 1, C, D) 1 := by
  rcases A with _ | A <;>
  · simp only [opX, LinearMap.sub_apply, Module.End.mul_apply, opE_single, opY_single hp h1 h2,
      map_add, map_smul]
    b2_norm h1 h2
    match_scalars <;> b2_scalars

/-- `x e = p⁻¹ e x` on the model. -/
lemma opX_mul_opE (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) :
    opX p * opE = p⁻¹ • (opE * opX p) := by
  refine Finsupp.lhom_ext fun m x ↦ ?_
  obtain ⟨A, B, C, D⟩ := m
  simp only [Module.End.mul_apply, LinearMap.smul_apply, opE_single, opX_single hp h1 h2,
    map_smul, smul_smul]
  match_scalars
  b2_scalars

/-- `f y = p⁻¹ y f` on the model. -/
lemma opF_mul_opY (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) :
    opF p * opY p = p⁻¹ • (opY p * opF p) := by
  refine Finsupp.lhom_ext fun m x ↦ ?_
  obtain ⟨A, B, C, D⟩ := m
  rcases A with _ | _ | _ | A <;> rcases B with _ | B <;>
  · simp only [Module.End.mul_apply, LinearMap.smul_apply, opF_single, opY_single hp h1 h2,
      map_add, map_sub, map_smul, smul_add, smul_sub, smul_smul]
    b2_norm h1 h2
    match_scalars <;> b2_scalars

lemma opF_pow_single (D : ℕ) :
    (opF p ^ D) (Finsupp.single (0, 0, 0, 0) 1) = Finsupp.single (0, 0, 0, D) 1 := by
  induction D with
  | zero => rfl
  | succ D ih => rw [pow_succ', Module.End.mul_apply, ih, opF_single]; simp

lemma opY_pow_single (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (C D : ℕ) :
    (opY p ^ C) (Finsupp.single (0, 0, 0, D) 1) = Finsupp.single (0, 0, C, D) 1 := by
  induction C with
  | zero => rfl
  | succ C ih => rw [pow_succ', Module.End.mul_apply, ih, opY_single hp h1 h2]; simp

lemma opX_pow_single (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (B C D : ℕ) :
    (opX p ^ B) (Finsupp.single (0, 0, C, D) 1) = Finsupp.single (0, B, C, D) 1 := by
  induction B with
  | zero => rfl
  | succ B ih => rw [pow_succ', Module.End.mul_apply, ih, opX_single hp h1 h2]; simp

omit [Field k] in
lemma opE_pow_single' {k : Type*} [Field k] (A B C D : ℕ) :
    (opE ^ A) (Finsupp.single (0, B, C, D) (1 : k)) = Finsupp.single (A, B, C, D) 1 := by
  induction A with
  | zero => rfl
  | succ A ih => rw [pow_succ', Module.End.mul_apply, ih, opE_single]

end Operators

/-! ### Straightening in an abstract algebra -/

section Abstract

variable {k B : Type*} [Field k] [Ring B] [Algebra k B] {p : k} {e x y f : B}

lemma qSerre_three_eq {q : k} (hq : q ≠ 0) (e f : B) :
    qSerre q 3 e f = e * (e * A2PBW.qComm (q ^ 2) e f - A2PBW.qComm (q ^ 2) e f * e) -
      q ^ 2 • ((e * A2PBW.qComm (q ^ 2) e f - A2PBW.qComm (q ^ 2) e f * e) * e) := by
  simp only [qSerre, Finset.sum_range_succ, Finset.sum_range_zero, qBinomial, A2PBW.qComm]
  simp only [pow_succ, pow_zero, one_mul, mul_one, mul_sub, sub_mul, smul_sub, mul_smul_comm,
    smul_mul_assoc, smul_smul, mul_assoc, zero_add, Nat.sub_zero, Nat.sub_self,
    Nat.add_one_sub_one]
  match_scalars <;> (field_simp; try ring)

/-- The commutation relations of the ordered root vectors `e < x < y < f` of type `B₂` that
follow directly from the definitions of `y` and `x` and the two Serre relations. -/
structure Rel (p : k) (e x y f : B) : Prop where
  fe : f * e = p • (e * f) - p • y
  ye : y * e = e * y - x
  xe : x * e = p⁻¹ • (e * x)
  fy : f * y = p⁻¹ • (y * f)

namespace Rel

variable (H : Rel p e x y f)
include H

lemma fe' (z : B) : f * (e * z) = p • (e * (f * z)) - p • (y * z) := by
  rw [← mul_assoc, H.fe, sub_mul, smul_mul_assoc, smul_mul_assoc, mul_assoc]

lemma ye' (z : B) : y * (e * z) = e * (y * z) - x * z := by
  rw [← mul_assoc, H.ye, sub_mul, mul_assoc]

lemma xe' (z : B) : x * (e * z) = p⁻¹ • (e * (x * z)) := by
  rw [← mul_assoc, H.xe, smul_mul_assoc, mul_assoc]

lemma fy' (z : B) : f * (y * z) = p⁻¹ • (y * (f * z)) := by
  rw [← mul_assoc, H.fy, smul_mul_assoc, mul_assoc]

/-- `f x = x f - (p - 1) y²`. -/
lemma fx (hp : p ≠ 0) : f * x = x * f - (p - 1) • (y * y) := by
  have hx : x = e * y - y * e := by rw [H.ye]; abel
  rw [hx]
  simp only [mul_sub, sub_mul, H.fe', H.fy', H.fe, H.fy, mul_assoc, mul_smul_comm, smul_sub,
    smul_smul]
  match_scalars <;> (field_simp; try ring)

lemma fx' (hp : p ≠ 0) (z : B) : f * (x * z) = x * (f * z) - (p - 1) • (y * (y * z)) := by
  rw [← mul_assoc, H.fx hp, sub_mul, smul_mul_assoc, mul_assoc, mul_assoc]

/-- `y x = p⁻¹ x y`, a consequence of the two Serre relations. -/
lemma yx (hp : p ≠ 0) : y * x = p⁻¹ • (x * y) := by
  have h1 : f * (e * x) = f * (p • (x * e)) := by
    rw [H.xe, smul_smul, mul_inv_cancel₀ hp, one_smul]
  simp only [H.fe', H.fx' hp, H.fx hp, H.fe, H.ye', H.ye, H.xe', mul_smul_comm, mul_sub,
    smul_sub, smul_smul] at h1
  linear_combination (norm := skip) (-(p ^ 2)⁻¹) • h1
  simp only [smul_sub, smul_smul]
  match_scalars <;> field_simp <;> ring

lemma xe_pow (n : ℕ) (z : B) : x * (e ^ n * z) = (p ^ n)⁻¹ • (e ^ n * (x * z)) := by
  rw [← mul_assoc, mul_pow_of_mul_eq_smul H.xe, smul_mul_assoc, mul_assoc, inv_pow]

lemma yx_pow (hp : p ≠ 0) (n : ℕ) (z : B) : y * (x ^ n * z) = (p ^ n)⁻¹ • (x ^ n * (y * z)) := by
  rw [← mul_assoc, mul_pow_of_mul_eq_smul (H.yx hp), smul_mul_assoc, mul_assoc, inv_pow]

lemma fy_pow (n : ℕ) (z : B) : f * (y ^ n * z) = (p ^ n)⁻¹ • (y ^ n * (f * z)) := by
  rw [← mul_assoc, mul_pow_of_mul_eq_smul H.fy, smul_mul_assoc, mul_assoc, inv_pow]

lemma fx_pow (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (n : ℕ) (z : B) :
    f * (x ^ (n + 1) * z) =
      x ^ (n + 1) * (f * z) - ((p - 1) * cd p (n + 1)) • (x ^ n * (y * (y * z))) := by
  induction n with
  | zero =>
    rw [pow_one, H.fx' hp, pow_zero, one_mul]
    congr 2
    simp only [cd]
    field_simp
    ring
  | succ n ih =>
    rw [pow_succ' x (n + 1), mul_assoc, H.fx' hp, ih]
    simp only [H.yx_pow hp, mul_smul_comm, mul_sub, smul_smul]
    simp only [← mul_assoc, ← pow_succ']
    match_scalars <;> b2_scalars

lemma ye_pow (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (n : ℕ) (z : B) :
    y * (e ^ (n + 1) * z) = e ^ (n + 1) * (y * z) + cg p (n + 1) • (e ^ n * (x * z)) := by
  induction n with
  | zero =>
    rw [pow_one, H.ye', pow_zero, one_mul, sub_eq_add_neg, ← neg_one_smul k (x * z)]
    congr 2
    simp only [cg]
    field_simp
    ring
  | succ n ih =>
    rw [pow_succ' e (n + 1), mul_assoc, H.ye', ih, H.xe_pow]
    simp only [mul_add, mul_smul_comm]
    simp only [← mul_assoc, ← pow_succ']
    match_scalars <;> b2_scalars

lemma fe_pow_one (z : B) : f * (e ^ 1 * z) = p • (e ^ 1 * (f * z)) - p • (e ^ 0 * (y * z)) := by
  rw [pow_one, pow_zero, one_mul, H.fe']

lemma fe_pow (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0) (n : ℕ) (z : B) :
    f * (e ^ (n + 2) * z) = p ^ (n + 2) • (e ^ (n + 2) * (f * z)) +
      cβ p (n + 2) • (e ^ (n + 1) * (y * z)) + cγ p (n + 2) • (e ^ n * (x * z)) := by
  induction n with
  | zero =>
    rw [pow_succ' e 1, pow_one, mul_assoc, H.fe', H.fe', H.ye']
    simp only [mul_sub, mul_smul_comm, smul_sub, smul_smul]
    simp only [← mul_assoc, pow_zero, one_mul]
    match_scalars <;> b2_scalars
  | succ n ih =>
    rw [pow_succ' e (n + 2), mul_assoc, H.fe', ih, H.ye_pow hp h1]
    simp only [mul_add, mul_smul_comm, smul_add, smul_smul]
    simp only [← mul_assoc, ← pow_succ']
    match_scalars <;> b2_scalars

end Rel

end Abstract

section Monomials

variable {k B : Type*} [Field k] [Ring B] [Algebra k B] {p : k} (e x y f : B)

/-- The ordered monomial `e^A x^B y^C f^D`. -/
def mono (m : ℕ × ℕ × ℕ × ℕ) : B := e ^ m.1 * (x ^ m.2.1 * (y ^ m.2.2.1 * f ^ m.2.2.2))

variable (k) in
/-- The linear map sending the basis vector `(A, B, C, D)` to `e^A x^B y^C f^D`. -/
def monoMap : Space k →ₗ[k] B := Finsupp.linearCombination k (mono e x y f)

variable {e x y f}

omit [Algebra k B] in
lemma pow_add_two' (a : B) (n : ℕ) : a ^ (n + 2) = a * (a * a ^ n) := by
  rw [pow_succ', pow_succ']

lemma monoMap_single (m : ℕ × ℕ × ℕ × ℕ) (c : k) :
    monoMap k e x y f (Finsupp.single m c) = c • mono e x y f m := by
  simp [monoMap]

lemma monoMap_opE (s : Space k) : monoMap k e x y f (opE s) = e * monoMap k e x y f s := by
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, mul_add]
  | single m c =>
    obtain ⟨A, B, C, D⟩ := m
    simp [opE_single, monoMap_single, mono, pow_succ', mul_assoc]

lemma monoMap_opF (H : Rel p e x y f) (hp : p ≠ 0) (h1 : p - 1 ≠ 0) (h2 : p ^ 2 - 1 ≠ 0)
    (s : Space k) : monoMap k e x y f (opF p s) = f * monoMap k e x y f s := by
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, mul_add]
  | single m c =>
    obtain ⟨A, B, C, D⟩ := m
    rw [opF_single, monoMap_single, mul_smul_comm]
    simp only [map_smul, map_add, map_sub, monoMap_single, mono]
    rcases A with _ | _ | A <;> rcases B with _ | B <;>
    · b2_norm h1 h2
      simp only [one_smul, one_mul, H.fe_pow hp h1 h2, pow_one, H.fe', H.fx_pow hp h1 h2,
        H.yx_pow hp, H.fy_pow]
      simp only [pow_add_two', pow_succ' f, pow_succ' y, pow_succ' x, mul_sub, mul_smul_comm,
        smul_add, smul_sub, smul_smul, mul_assoc]
      all_goals (match_scalars <;> b2_scalars)

end Monomials

/-! ### The operator representation of `'f` -/

section Representation

variable {k I : Type*} [Field k] [DecidableEq I]

/-- The representation of `'f` on `Space k`: `θᵢ ↦ opE`, `θₗ ↦ opF` for `l ≠ i`. -/
def rep (p : k) (i : I) : LusztigF k I →ₐ[k] Module.End k (Space k) :=
  FreeAlgebra.lift k (fun l ↦ if l = i then opE else opF p)

variable {p : k} {i j : I}

@[simp] lemma rep_θ_left : rep p i (θ k i) = opE := by simp [rep]

lemma rep_θ_right (hij : i ≠ j) : rep p i (θ k j) = opF p := by simp [rep, hij.symm]

lemma rep_qSerre (q : k) (m : ℕ) (a b : LusztigF k I) :
    rep p i (qSerre q m a b) = qSerre q m (rep p i a) (rep p i b) := by
  simp only [qSerre, map_sum, map_smul, map_mul, map_pow]

end Representation

section RepSerre

variable {k I : Type*} [Field k] [DecidableEq I] {D : LusztigCartanDatum I} {v : k} {i j : I}

omit [DecidableEq I] in
lemma toNat_one_sub_eq_three (h : D.cartanMatrix i j = -2) :
    (1 - D.cartanMatrix i j).toNat = 3 := by
  rw [h]; rfl

omit [DecidableEq I] in
/-- The nonvanishing conditions on `p = vᵢ²` used by the model. -/
lemma param_ne {q : k} (hq0 : q ≠ 0) (hq : q - q⁻¹ ≠ 0) (h2 : qFactorial q 2 ≠ 0) :
    q ^ 2 ≠ 0 ∧ q ^ 2 - 1 ≠ 0 ∧ (q ^ 2) ^ 2 - 1 ≠ 0 := by
  rw [b2_qFactorial_two hq0] at h2
  have e1 : q ^ 2 - 1 = q * (q - q⁻¹) := by field_simp
  have e2 : (q ^ 2) ^ 2 - 1 = q ^ 2 * ((q - q⁻¹) * (q + q⁻¹)) := by field_simp; ring
  exact ⟨pow_ne_zero _ hq0, e1 ▸ mul_ne_zero hq0 hq,
    e2 ▸ mul_ne_zero (pow_ne_zero _ hq0) (mul_ne_zero hq h2)⟩

/-- At an exact two-node datum with entries `(-2, -1)` and `v` not a root of unity, the
representation `rep` of `'f` kills every quantum Serre element. -/
theorem serreIdeal_le_ker_rep [NeZero v] (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1) (hij : i ≠ j)
    (hall : ∀ l, l = i ∨ l = j) (h : D.cartanMatrix i j = -2) (h' : D.cartanMatrix j i = -1) :
    serreIdeal D v ≤ TwoSidedIdeal.ker (rep ((v ^ D.d i) ^ 2) i) := by
  have hq0 : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  obtain ⟨hp, h1, h2⟩ := param_ne hq0 (shortNode_braidGeneric_of_not_root hv' i).sub_ne
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2)
  rw [serreIdeal, TwoSidedIdeal.span_le]
  rintro _ ⟨l, m, hlm, rfl⟩
  rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker]
  rcases hall l with rfl | rfl <;> rcases hall m with rfl | rfl
  · exact absurd rfl hlm
  · rw [serreElement, toNat_one_sub_eq_three h,
      qSerreDiv_eq (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' l 3), map_smul,
      rep_qSerre, rep_θ_left, rep_θ_right hij, qSerre_three_eq hq0]
    change _ • (opE * opX _ - _ • (opX _ * opE)) = 0
    rw [opX_mul_opE hp h1 h2, smul_smul, mul_inv_cancel₀ hp, one_smul, sub_self, smul_zero]
  · have hj := qFactorial_ne_zero_of_not_root (D := D) (NeZero.ne v) hv' l 2
    rw [parameter_eq_square_of_double_edge h h'] at hj
    rw [serreElement, A2PBW.toNat_one_sub_eq_two h', parameter_eq_square_of_double_edge h h',
      qSerreDiv_eq hj, map_smul, rep_qSerre, rep_θ_left, rep_θ_right hlm.symm,
      A2PBW.qSerre_two_right hp]
    change _ • (opY _ * opF _ - _ • (opF _ * opY _)) = 0
    rw [opF_mul_opY hp h1 h2, smul_smul, mul_inv_cancel₀ hp, one_smul, sub_self, smul_zero]
  · exact absurd rfl hlm

end RepSerre

end B2PBW

open B2PBW

/-! ### The PBW basis of `U⁺` in type `B₂` -/

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  (R : D.RootDatum Y) (v : k) (i j : I)

/-- `y = Eᵢ Eⱼ - vᵢ⁻² Eⱼ Eᵢ`; in type `B₂` this is the root vector `TᵢTⱼ(Eᵢ)`
(`b2PBWMono_eq_rootVectors`). -/
def b2RootY : QuantumGroup R v := A2PBW.qComm ((v ^ D.d i) ^ 2) (E R v i) (E R v j)

/-- `x = Eᵢ y - y Eᵢ`; in type `B₂`, `Tᵢ(Eⱼ) = [2]ᵢ!⁻¹ x` (`b2_braidEj_eq`). -/
def b2RootX : QuantumGroup R v := E R v i * b2RootY R v i j - b2RootY R v i j * E R v i

/-- The ordered PBW monomial `Eᵢ^A Tᵢ(Eⱼ)^B y^C Eⱼ^D` of type `B₂`. -/
def b2PBWMono (m : ℕ × ℕ × ℕ × ℕ) : QuantumGroup R v :=
  E R v i ^ m.1 * (braidEj R v i j ^ m.2.1 * (b2RootY R v i j ^ m.2.2.1 * E R v j ^ m.2.2.2))

variable {R v i j}

lemma b2RootY_mem : b2RootY R v i j ∈ Algebra.adjoin k (Set.range (E R v)) :=
  sub_mem (mul_mem (E_mem_adjoin i) (E_mem_adjoin j))
    (Subalgebra.smul_mem _ (mul_mem (E_mem_adjoin j) (E_mem_adjoin i)) _)

lemma b2RootX_mem : b2RootX R v i j ∈ Algebra.adjoin k (Set.range (E R v)) :=
  sub_mem (mul_mem (E_mem_adjoin i) b2RootY_mem)
    (mul_mem b2RootY_mem (E_mem_adjoin i))

section Relations

variable [NeZero v] (hij : i ≠ j) (h : D.cartanMatrix i j = -2) (h' : D.cartanMatrix j i = -1)
include hij h h'

/-- The straightening relations hold for `Eᵢ, x, y, Eⱼ` in `U`. -/
theorem b2_rel :
    B2PBW.Rel ((v ^ D.d i) ^ 2) (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j) where
  fe := A2PBW.mul_eq_qComm (pow_ne_zero _ (pow_ne_zero _ (NeZero.ne v))) _ _
  ye := by rw [b2RootX]; abel
  xe := by
    have hq0 : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
    have hS := serre_E R v hij
    rw [toNat_one_sub_eq_three h, qSerre_three_eq hq0, sub_eq_zero] at hS
    rw [b2RootX, b2RootY, hS, smul_smul, inv_mul_cancel₀ (pow_ne_zero _ hq0), one_smul]
  fy := by
    have hS := serre_E R v hij.symm
    rw [A2PBW.toNat_one_sub_eq_two h', parameter_eq_square_of_double_edge h h'] at hS
    exact A2PBW.mul_qComm_right_of_qSerre (pow_ne_zero _ (pow_ne_zero _ (NeZero.ne v))) hS

omit hij h' in
/-- `Tᵢ(Eⱼ) = [2]ᵢ!⁻¹ x`. -/
theorem b2_braidEj_eq : braidEj R v i j = (qFactorial (v ^ D.d i) 2)⁻¹ • b2RootX R v i j := by
  have hq0 : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  have hc : (v ^ D.d i) ^ 2 * (v ^ D.d i * (v ^ D.d i) ^ 2)⁻¹ = (v ^ D.d i)⁻¹ := by
    field_simp
  have hX := BraidDiagonal.X_eq_serreAux hq0 (pow_ne_zero 2 hq0) (E R v i) (E R v j) 2
  rw [hc] at hX
  unfold braidEj
  rw [b2_negA h, ← hX, BraidDiagonal.X_succ (n := 1), BraidDiagonal.X_succ (n := 0),
    b2_shift_one hq0, b2_shift_zero,
    one_smul]
  rfl

variable (hq : v ^ D.d i - (v ^ D.d i)⁻¹ ≠ 0) (h2 : qFactorial (v ^ D.d i) 2 ≠ 0)
  (hall : ∀ l, l = i ∨ l = j)
include hq h2 hall

/-- The operator model intertwines: `Φ(x · s) = x⁺ Φ(s)`. -/
theorem b2_monoMap_rep (a : LusztigF k I) (s : Space k) :
    monoMap k (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j)
        (rep ((v ^ D.d i) ^ 2) i a s) =
      plusHom R v a *
        monoMap k (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j) s := by
  obtain ⟨hp, h1, hp2⟩ := param_ne (pow_ne_zero _ (NeZero.ne v)) hq h2
  induction a using FreeAlgebra.induction generalizing s with
  | grade0 r =>
    rw [AlgHom.commutes, AlgHom.commutes, Module.algebraMap_end_apply, map_smul,
      Algebra.smul_def]
  | grade1 l =>
    rcases hall l with rfl | rfl
    · change monoMap (B := QuantumGroup R v) k _ _ _ _ (rep _ l (θ k l) s) = plusHom R v (θ k l) * _
      rw [rep_θ_left, plusHom_θ, monoMap_opE]
    · change monoMap (B := QuantumGroup R v) k _ _ _ _ (rep _ i (θ k l) s) = plusHom R v (θ k l) * _
      rw [rep_θ_right hij, plusHom_θ, monoMap_opF (b2_rel hij h h') hp h1 hp2]
  | mul a b ha hb =>
    rw [map_mul, Module.End.mul_apply, ha, hb, map_mul, mul_assoc]
  | add a b ha hb =>
    rw [map_add, LinearMap.add_apply, map_add, ha, hb, map_add, add_mul]

/-- The monomials `Eᵢ^A x^B y^C Eⱼ^D` span `U⁺`. -/
theorem span_b2Mono :
    Submodule.span k (Set.range (mono (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j))) =
      Subalgebra.toSubmodule (Algebra.adjoin k (Set.range (E R v))) := by
  refine le_antisymm (Submodule.span_le.2 ?_) ?_
  · rintro _ ⟨m, rfl⟩
    change mono _ _ _ _ m ∈ Algebra.adjoin k (Set.range (E R v))
    exact mul_mem (pow_mem (E_mem_adjoin i) _) (mul_mem (pow_mem b2RootX_mem _)
      (mul_mem (pow_mem b2RootY_mem _) (pow_mem (E_mem_adjoin j) _)))
  · rw [Algebra.adjoin_range_eq_range_freeAlgebra_lift]
    rintro _ ⟨a, rfl⟩
    change FreeAlgebra.lift k (E R v) a ∈ _
    have ha : FreeAlgebra.lift k (E R v) a =
        monoMap k (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j)
          (rep ((v ^ D.d i) ^ 2) i a (Finsupp.single (0, 0, 0, 0) 1)) := by
      rw [b2_monoMap_rep hij h h' hq h2 hall]
      simp only [monoMap_single, mono, pow_zero, one_smul, mul_one]
      rfl
    rw [ha, monoMap, ← Finsupp.range_linearCombination]
    exact LinearMap.mem_range_self _ _

end Relations

section Independence

variable [NeZero v] (hij : i ≠ j) (h : D.cartanMatrix i j = -2) (h' : D.cartanMatrix j i = -1)
  (hall : ∀ l, l = i ∨ l = j) (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)
include hij h h' hall hv'

/-- For `v` not a root of unity, the monomials `Eᵢ^A x^B y^C Eⱼ^D` are linearly independent. -/
theorem linearIndependent_b2Mono :
    LinearIndependent k (mono (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j)) := by
  have hq0 : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  obtain ⟨hp, h1, hp2⟩ := param_ne hq0 (shortNode_braidGeneric_of_not_root hv' i).sub_ne
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2)
  let θY : LusztigF k I := A2PBW.qComm ((v ^ D.d i) ^ 2) (θ k i) (θ k j)
  let θX : LusztigF k I := θ k i * θY - θY * θ k i
  let fm : Space k →ₗ[k] LusztigF k I :=
    Finsupp.linearCombination k (mono (θ k i) θX θY (θ k j))
  have hY : rep ((v ^ D.d i) ^ 2) i θY = opY ((v ^ D.d i) ^ 2) := by
    simp [θY, A2PBW.qComm, rep_θ_right hij, opY]
  have hX : rep ((v ^ D.d i) ^ 2) i θX = opX ((v ^ D.d i) ^ 2) := by
    simp only [θX, map_sub, map_mul, hY, rep_θ_left]
    rfl
  have hplus : ∀ s, plusHom R v (fm s) =
      monoMap k (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j) s := by
    intro s
    induction s using Finsupp.induction_linear with
    | zero => simp
    | add s t hs ht => rw [map_add, map_add, hs, ht, map_add]
    | single m c =>
      simp only [fm, θX, θY, Finsupp.linearCombination_single, map_smul, monoMap_single, mono,
        map_mul, map_pow, map_sub, plusHom_θ, A2PBW.qComm, b2RootX, b2RootY]
  have hrep : ∀ s, rep ((v ^ D.d i) ^ 2) i (fm s) (Finsupp.single (0, 0, 0, 0) 1) = s := by
    intro s
    induction s using Finsupp.induction_linear with
    | zero => simp
    | add s t hs ht => rw [map_add, map_add, LinearMap.add_apply, hs, ht]
    | single m c =>
      obtain ⟨a, b, c', d⟩ := m
      simp only [fm, Finsupp.linearCombination_single, map_smul, LinearMap.smul_apply, mono,
        map_mul, map_pow, rep_θ_left, rep_θ_right hij, hX, hY, Module.End.mul_apply,
        opF_pow_single, opY_pow_single hp h1 hp2, opX_pow_single hp h1 hp2, opE_pow_single']
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
  rw [linearIndependent_iff]
  intro s hs
  have h0 : plusHom R v (fm s) = 0 := (hplus s).trans hs
  have hker := serreIdeal_le_ker_rep hv' hij hall h h' ((plusHom_eq_zero_iff R v hv' _).1 h0)
  rw [TwoSidedIdeal.mem_ker] at hker
  rw [← hrep s, hker, LinearMap.zero_apply]

end Independence

section Basis

variable [NeZero v] (h : D.cartanMatrix i j = -2)

omit [NeZero v] in
include h in
lemma b2PBWMono_eq_smul [NeZero v] (m : ℕ × ℕ × ℕ × ℕ) :
    b2PBWMono R v i j m = ((qFactorial (v ^ D.d i) 2)⁻¹ ^ m.2.1) •
      mono (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j) m := by
  rw [b2PBWMono, b2_braidEj_eq h, smul_pow, mono]
  simp only [smul_mul_assoc, mul_smul_comm]

variable (hij : i ≠ j) (h' : D.cartanMatrix j i = -1) (hall : ∀ l, l = i ∨ l = j)
include h hij h' hall

/-- **Spanning** ([Jan] 8.24, Rem. 1, [Lus] Cor. 40.2.2): in type `B₂` the ordered monomials
`Eᵢ^A Tᵢ(Eⱼ)^B (TᵢTⱼEᵢ)^C Eⱼ^D` span `U⁺`, assuming `vᵢ - vᵢ⁻¹ ≠ 0` and `[2]ᵢ! ≠ 0`. -/
theorem span_b2PBWMono (hq : v ^ D.d i - (v ^ D.d i)⁻¹ ≠ 0)
    (h2 : qFactorial (v ^ D.d i) 2 ≠ 0) :
    Submodule.span k (Set.range (b2PBWMono R v i j)) =
      Subalgebra.toSubmodule (Algebra.adjoin k (Set.range (E R v))) := by
  rw [← span_b2Mono hij h h' hq h2 hall]
  have hc : (qFactorial (v ^ D.d i) 2)⁻¹ ≠ 0 := inv_ne_zero h2
  apply le_antisymm <;> rw [Submodule.span_le] <;> rintro _ ⟨m, rfl⟩
  · rw [b2PBWMono_eq_smul h]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩)
  · have e : mono (E R v i) (b2RootX R v i j) (b2RootY R v i j) (E R v j) m =
        ((qFactorial (v ^ D.d i) 2)⁻¹ ^ m.2.1)⁻¹ • b2PBWMono R v i j m := by
      rw [b2PBWMono_eq_smul h, smul_smul, inv_mul_cancel₀ (pow_ne_zero _ hc), one_smul]
    rw [SetLike.mem_coe, e]
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨m, rfl⟩)

variable (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)
include hv'

/-- **Linear independence** ([Jan] 8.24, Rem. 1, [Lus] 40.2.1): for `v` not a root of
unity, the ordered monomials `Eᵢ^A Tᵢ(Eⱼ)^B (TᵢTⱼEᵢ)^C Eⱼ^D` of type `B₂` are linearly
independent. Reconstructed proof: the straightening formulas define a representation of `'f`
on `k[ℕ⁴]` killing the Serre ideal, and `U⁺ ≅ 'f ⧸ J` (`plusHom_eq_zero_iff`). -/
theorem linearIndependent_b2PBWMono : LinearIndependent k (b2PBWMono R v i j) := by
  have hc : (qFactorial (v ^ D.d i) 2)⁻¹ ≠ 0 :=
    inv_ne_zero (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2)
  have hl := (linearIndependent_b2Mono (R := R) hij h h' hall hv').units_smul
    (fun m ↦ Units.mk0 _ (pow_ne_zero m.2.1 hc))
  convert hl using 1
  funext m
  rw [b2PBWMono_eq_smul h, Pi.smul_apply', Units.smul_def, Units.val_mk0]

variable (R v) in
/-- **The PBW basis of `U⁺` in type `B₂`** ([Jan] 8.24, Rem. 1, [Lus] Cor. 40.2.2):
for an exact two-node datum with entries `(-2, -1)` and `v` not a root of unity, the ordered
monomials `Eᵢ^A Tᵢ(Eⱼ)^B (TᵢTⱼEᵢ)^C Eⱼ^D` form a basis of the subalgebra generated by the
`Eₗ`. -/
def b2PBWBasis :
    Module.Basis (ℕ × ℕ × ℕ × ℕ) k
      (Subalgebra.toSubmodule (Algebra.adjoin k (Set.range (E R v)))) :=
  (Module.Basis.span (linearIndependent_b2PBWMono h hij h' hall hv')).map
    (LinearEquiv.ofEq _ _ (span_b2PBWMono h hij h' hall
      (shortNode_braidGeneric_of_not_root hv' i).sub_ne
      (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2)))

@[simp] theorem b2PBWBasis_apply (m : ℕ × ℕ × ℕ × ℕ) :
    (b2PBWBasis R v h hij h' hall hv' m : QuantumGroup R v) = b2PBWMono R v i j m := by
  simp [b2PBWBasis, Module.Basis.span_apply]

end Basis

/-! ### The root vectors along the reduced word `i j i j` -/

section RootVectors

variable {S T : QuantumGroup R v →ₐ[k] QuantumGroup R v}

/-- The PBW monomials are the ordered monomials in the root vectors `E_{β₁} = Eᵢ`,
`E_{β₂} = Tᵢ(Eⱼ)`, `E_{β₃} = TᵢTⱼ(Eᵢ)`, `E_{β₄} = TᵢTⱼTᵢ(Eⱼ)` along the reduced expression
`sᵢ sⱼ sᵢ sⱼ` of the longest Weyl group element ([Jan] 8.21, [Lus] 40.1). -/
theorem b2PBWMono_eq_rootVectors [NeZero v] (HS : HasBraidGeneratorImages i S)
    (HT : HasBraidGeneratorImages j T) (hij : i ≠ j) (h : D.cartanMatrix i j = -2)
    (h' : D.cartanMatrix j i = -1) (hq : v ^ D.d i - (v ^ D.d i)⁻¹ ≠ 0)
    (h2 : qFactorial (v ^ D.d i) 2 ≠ 0) (m : ℕ × ℕ × ℕ × ℕ) :
    b2PBWMono R v i j m = E R v i ^ m.1 * (S (E R v j) ^ m.2.1 *
      (S (T (E R v i)) ^ m.2.2.1 * S (T (S (E R v j))) ^ m.2.2.2)) := by
  have hq0 : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  have hY : S (T (E R v i)) = b2RootY R v i j := by
    rw [b2_rootVector_three HS HT hij h h' hq, b2_cc_two hq0 hq, ← b2_qFactorial_two hq0,
      inv_mul_cancel₀ h2, one_smul, BraidDiagonal.X_succ (n := 0), b2_shift_zero]
    rfl
  rw [b2_rootVector_four HS HT hij h h' hq h2, a2_rootVector_two hij HS, hY]
  rfl

end RootVectors

section Concrete

variable [NeZero v] (h : D.cartanMatrix i j = -2) (hij : i ≠ j) (h' : D.cartanMatrix j i = -1)
  (hall : ∀ l, l = i ∨ l = j) (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)

/-- The `B₂` PBW basis in terms of Lusztig's automorphisms `Tᵢ, Tⱼ =
twoNodeBraidEquiv_of_not_root`: the basis vector `(A, B, C, D)` is
`Eᵢ^A Tᵢ(Eⱼ)^B (TᵢTⱼEᵢ)^C (TᵢTⱼTᵢEⱼ)^D`. -/
theorem b2PBWBasis_apply_braidEquiv (m : ℕ × ℕ × ℕ × ℕ) :
    (b2PBWBasis R v h hij h' hall hv' m : QuantumGroup R v) =
      E R v i ^ m.1 * (twoNodeBraidEquiv_of_not_root (R := R) hij hall hv' (E R v j) ^ m.2.1 *
        (twoNodeBraidEquiv_of_not_root (R := R) hij hall hv'
          (twoNodeBraidEquiv_of_not_root (R := R) hij.symm (fun l ↦ (hall l).symm) hv'
            (E R v i)) ^ m.2.2.1 *
        twoNodeBraidEquiv_of_not_root (R := R) hij hall hv'
          (twoNodeBraidEquiv_of_not_root (R := R) hij.symm (fun l ↦ (hall l).symm) hv'
            (twoNodeBraidEquiv_of_not_root (R := R) hij hall hv' (E R v j))) ^ m.2.2.2)) := by
  have HS : HasBraidGeneratorImages i
      (twoNodeBraidEquiv_of_not_root (R := R) hij hall hv').toAlgHom :=
    braidHom_hasBraidGeneratorImages
      (twoNode_braidGeneric hij hall (shortNode_braidGeneric_of_not_root hv' i).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' i j))
      (twoNode_transformedSerre hij hall (shortNode_braidGeneric_of_not_root hv' i).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' i j))
  have HT : HasBraidGeneratorImages j
      (twoNodeBraidEquiv_of_not_root (R := R) hij.symm (fun l ↦ (hall l).symm) hv').toAlgHom :=
    braidHom_hasBraidGeneratorImages
      (twoNode_braidGeneric hij.symm (fun l ↦ (hall l).symm)
        (shortNode_braidGeneric_of_not_root hv' j).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' j i))
      (twoNode_transformedSerre hij.symm (fun l ↦ (hall l).symm)
        (shortNode_braidGeneric_of_not_root hv' j).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' j i))
  rw [b2PBWBasis_apply, b2PBWMono_eq_rootVectors HS HT hij h h'
    (shortNode_braidGeneric_of_not_root hv' i).sub_ne
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2)]
  rfl

end Concrete


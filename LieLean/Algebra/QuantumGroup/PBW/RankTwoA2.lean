import LieLean.Algebra.QuantumGroup.BraidAction.ThreeLocalArtin
import LieLean.Algebra.QuantumGroup.BraidAction.GeneralRelations
import LieLean.Algebra.QuantumGroup.BraidAction.TwoNodeGeneral
import LieLean.Algebra.QuantumGroup.TriangularDecomposition

/-!
# The PBW basis of `U⁺` in type `A₂`

Let `{i, j}` be an exact two-node Cartan datum with `aᵢⱼ = aⱼᵢ = -1` (type `A₂`) and `q = vᵢ`.
The longest Weyl group element has the reduced expression `sᵢ sⱼ sᵢ`, with root vectors
`E_{β₁} = Eᵢ`, `E_{β₂} = Tᵢ(Eⱼ) = EᵢEⱼ - q⁻¹EⱼEᵢ` and `E_{β₃} = TᵢTⱼ(Eᵢ) = Eⱼ`. We prove that the
ordered monomials `Eᵢ^a Tᵢ(Eⱼ)^b Eⱼ^c` form a basis of `U⁺`, the subalgebra of `U = U_v(𝔤)`
generated by the `Eₗ` ([Jan] Thm. 8.24 (check), [Lus] Cor. 40.2.2 (check)).

## Method

With `X = Tᵢ(Eⱼ)`, the Serre relations are `Eᵢ X = q X Eᵢ` and `X Eⱼ = q Eⱼ X`, and
`Eⱼ Eᵢ = q EᵢEⱼ - q X`. Straightening gives (`A2PBW.monoMap_opF`)
`Eⱼ · Eᵢ^a X^b Eⱼ^c = q^a q^{-b} Eᵢ^a X^b Eⱼ^{c+1} - q [a] Eᵢ^{a-1} X^{b+1} Eⱼ^c`.
We realise these formulas as operators `A2PBW.opE`, `A2PBW.opF` on `k[ℕ³]` and prove the Serre
relations for them directly, so they define a representation `A2PBW.rep` of Lusztig's `'f`
killing the Serre ideal (`A2PBW.serreIdeal_le_ker_rep`). The linear map
`Φ : k[ℕ³] → U`, `(a, b, c) ↦ Eᵢ^a X^b Eⱼ^c`, intertwines this representation with left
multiplication (`a2_monoMap_rep`); evaluating at `(0, 0, 0)` gives spanning, and applying
`rep` to a preimage in `'f` together with `U⁺ ≅ 'f ⧸ J` (`plusHom_eq_zero_iff`, which needs `v`
not a root of unity) gives linear independence. This argument is our reconstruction; it does
not use the bilinear form or a dimension count.

## Main results

* `QuantumGroup.span_a2PBWMono`: the monomials span `U⁺` (only `v ≠ 0` is used).
* `QuantumGroup.linearIndependent_a2PBWMono`: they are linearly independent, for `v` not a root
  of unity.
* `QuantumGroup.a2PBWBasis`, `QuantumGroup.a2PBWBasis_apply`: the PBW basis of `U⁺`.
* `QuantumGroup.a2PBWMono_eq_rootVectors`, `QuantumGroup.a2PBWBasis_apply_braidEquiv`: the basis
  vectors are the ordered monomials in the root vectors `Eᵢ`, `Tᵢ(Eⱼ)`, `TᵢTⱼ(Eᵢ)`, for any
  endomorphisms with Lusztig's generator formulas, in particular for
  `twoNodeBraidEquiv_of_not_root`.

## References

* [Jan] J. C. Jantzen, *Lectures on quantum groups*, GSM 6, §8.21–8.24 (check).
* [Lus] G. Lusztig, *Introduction to quantum groups*, Birkhäuser 1993, §40.1–40.2 (check).
-/

noncomputable section

open LusztigF

namespace QuantumGroup

namespace A2PBW

section Abstract

variable {k B : Type*} [Field k] [Ring B] [Algebra k B] {q : k}

/-- The twisted commutator `e f - q⁻¹ f e`; for `e = Eᵢ`, `f = Eⱼ` at a simple edge it is the
root vector `Tᵢ(Eⱼ)`. -/
def qComm (q : k) (e f : B) : B := e * f - q⁻¹ • (f * e)

lemma qInt_two (q : k) : qInt q 2 = q + q⁻¹ := by simp [qInt, Finset.sum_range_succ]

/-- The quadratic quantum Serre element in terms of the twisted commutator. -/
lemma qSerre_two_left (hq : q ≠ 0) (e f : B) :
    qSerre q 2 e f = e * qComm q e f - q • (qComm q e f * e) := by
  simp only [qSerre, Finset.sum_range_succ, Finset.sum_range_zero, qBinomial_one_right,
    qBinomial_self, qBinomial_zero_right, qInt_two, qComm]
  simp only [pow_succ, pow_zero, one_mul, mul_one, mul_sub, sub_mul, smul_sub, mul_smul_comm,
    smul_mul_assoc, smul_smul, mul_assoc, zero_add, Nat.sub_zero, Nat.sub_self,
    Nat.add_one_sub_one]
  rw [mul_inv_cancel₀ hq]
  module

/-- The quadratic quantum Serre element with the arguments exchanged. -/
lemma qSerre_two_right (hq : q ≠ 0) (e f : B) :
    qSerre q 2 f e = qComm q e f * f - q • (f * qComm q e f) := by
  simp only [qSerre, Finset.sum_range_succ, Finset.sum_range_zero, qBinomial_one_right,
    qBinomial_self, qBinomial_zero_right, qInt_two, qComm]
  simp only [pow_succ, pow_zero, one_mul, mul_one, mul_sub, sub_mul, smul_sub, mul_smul_comm,
    smul_mul_assoc, smul_smul, mul_assoc, zero_add, Nat.sub_zero, Nat.sub_self,
    Nat.add_one_sub_one]
  rw [mul_inv_cancel₀ hq]
  module

variable {e f X : B}

/-- `f e = q e f - q X` for `X = e f - q⁻¹ f e`. -/
lemma mul_eq_qComm (hq : q ≠ 0) (e f : B) : f * e = q • (e * f) - q • qComm q e f := by
  rw [qComm, smul_sub, smul_smul, mul_inv_cancel₀ hq, one_smul, sub_sub_cancel]

/-- The Serre relation `S₂(e, f) = 0` gives `X e = q⁻¹ e X`. -/
lemma qComm_mul_left_of_qSerre (hq : q ≠ 0) (hS : qSerre q 2 e f = 0) :
    qComm q e f * e = q⁻¹ • (e * qComm q e f) := by
  rw [qSerre_two_left hq, sub_eq_zero] at hS
  rw [hS, smul_smul, inv_mul_cancel₀ hq, one_smul]

/-- The Serre relation `S₂(f, e) = 0` gives `f X = q⁻¹ X f`. -/
lemma mul_qComm_right_of_qSerre (hq : q ≠ 0) (hS : qSerre q 2 f e = 0) :
    f * qComm q e f = q⁻¹ • (qComm q e f * f) := by
  rw [qSerre_two_right hq, sub_eq_zero] at hS
  rw [hS, smul_smul, inv_mul_cancel₀ hq, one_smul]

/-- Straightening `f eⁿ⁺¹`, assuming `f e = q e f - q X` and `X e = q⁻¹ e X`. -/
lemma mul_pow_succ_left (hfe : f * e = q • (e * f) - q • X)
    (hXe : X * e = q⁻¹ • (e * X)) (n : ℕ) :
    f * e ^ (n + 1) = q ^ (n + 1) • (e ^ (n + 1) * f) - (q * qInt q (n + 1)) • (e ^ n * X) := by
  induction n with
  | zero => simp [hfe, qInt]
  | succ n ih =>
    rw [pow_succ e (n + 1), ← mul_assoc f, ih]
    simp only [sub_mul, smul_mul_assoc, mul_assoc, hfe, hXe]
    simp only [mul_sub, mul_smul_comm, smul_sub, smul_smul]
    rw [← mul_assoc (e ^ n) e X, ← pow_succ e n, qInt_succ (v := q) (n + 1)]
    match_scalars <;> ring

/-- `f (eⁿ⁺¹ y)`, right-associated form of `mul_pow_succ_left`. -/
lemma mul_pow_succ_left_assoc (hfe : f * e = q • (e * f) - q • X)
    (hXe : X * e = q⁻¹ • (e * X)) (n : ℕ) (y : B) :
    f * (e ^ (n + 1) * y) =
      q ^ (n + 1) • (e ^ (n + 1) * (f * y)) - (q * qInt q (n + 1)) • (e ^ n * (X * y)) := by
  rw [← mul_assoc, mul_pow_succ_left hfe hXe, sub_mul, smul_mul_assoc, smul_mul_assoc,
    mul_assoc, mul_assoc]

/-- `f (Xⁿ y) = q⁻ⁿ Xⁿ (f y)`, assuming `f X = q⁻¹ X f`. -/
lemma mul_pow_assoc_of_mul_eq (hfX : f * X = q⁻¹ • (X * f)) (n : ℕ) (y : B) :
    f * (X ^ n * y) = q⁻¹ ^ n • (X ^ n * (f * y)) := by
  rw [← mul_assoc, mul_pow_of_mul_eq_smul hfX, smul_mul_assoc, mul_assoc]

end Abstract

section Operators

variable {k : Type*} [Field k] (q : k)

/-- The model space: finitely supported functions on exponent triples `(a, b, c)`. -/
abbrev Space (k : Type*) [Field k] := (ℕ × ℕ × ℕ) →₀ k

/-- `e · (a, b, c) = (a + 1, b, c)`. -/
def opE : Module.End k (Space k) := Finsupp.lmapDomain k k (fun p ↦ (p.1 + 1, p.2))

/-- `f · (a, b, c) = qᵃ q⁻ᵇ (a, b, c + 1) - q [a] (a - 1, b + 1, c)`. -/
def opF : Module.End k (Space k) := Finsupp.linearCombination k (fun p : ℕ × ℕ × ℕ ↦
  (q ^ p.1 * q⁻¹ ^ p.2.1) • Finsupp.single (p.1, p.2.1, p.2.2 + 1) (1 : k) -
    (q * qInt q p.1) • Finsupp.single (p.1 - 1, p.2.1 + 1, p.2.2) 1)

/-- The operator of the root vector `x = e f - q⁻¹ f e`. -/
def opX : Module.End k (Space k) := qComm q opE (opF q)

variable {q}

lemma opE_single (a b c : ℕ) (x : k) :
    opE (Finsupp.single (a, b, c) x) = Finsupp.single (a + 1, b, c) x := by
  simp [opE]

lemma opF_single (a b c : ℕ) (x : k) :
    opF q (Finsupp.single (a, b, c) x) =
      x • ((q ^ a * q⁻¹ ^ b) • Finsupp.single (a, b, c + 1) (1 : k) -
        (q * qInt q a) • Finsupp.single (a - 1, b + 1, c) 1) := by
  simp [opF]

lemma opX_single (hq : q ≠ 0) (a b c : ℕ) (x : k) :
    opX q (Finsupp.single (a, b, c) x) = (x * q⁻¹ ^ a) • Finsupp.single (a, b + 1, c) 1 := by
  have hm := qInt_mul_sub (v := q) a
  have hqq : q⁻¹ * q = 1 := inv_mul_cancel₀ hq
  simp only [opX, qComm, LinearMap.sub_apply, LinearMap.smul_apply, Module.End.mul_apply,
    opF_single, opE_single, map_sub, map_smul, qInt_succ (v := q) a, Nat.add_sub_cancel]
  cases a with
  | zero =>
    simp only [Nat.zero_sub, zero_add, qInt_zero, mul_zero, zero_smul, sub_zero]
    match_scalars
    · linear_combination (-x * q⁻¹ ^ b) * hqq
    · linear_combination x * hqq
  | succ a =>
    simp only [Nat.add_sub_cancel]
    match_scalars
    · linear_combination (-x * q ^ (a + 1) * q⁻¹ ^ b) * hqq
    · linear_combination (-x) * hm + (x * q⁻¹ * qInt q (a + 1) + x * q ^ (a + 1)) * hqq


lemma opE_opX (hq : q ≠ 0) : opE * opX q = q • (opX q * opE) := by
  refine Finsupp.lhom_ext fun p x ↦ ?_
  obtain ⟨a, b, c⟩ := p
  simp only [Module.End.mul_apply, LinearMap.smul_apply, opE_single, opX_single hq, map_smul]
  rw [smul_smul]
  congr 1
  linear_combination (-(x * q⁻¹ ^ a)) * mul_inv_cancel₀ hq

lemma opX_opF (hq : q ≠ 0) : opX q * opF q = q • (opF q * opX q) := by
  refine Finsupp.lhom_ext fun p x ↦ ?_
  obtain ⟨a, b, c⟩ := p
  rcases a with _ | a
  · simp only [Module.End.mul_apply, LinearMap.smul_apply, opF_single, opX_single hq, map_smul,
      qInt_zero, mul_zero, zero_smul, sub_zero, smul_smul]
    match_scalars
    linear_combination (-(x * q⁻¹ ^ b)) * mul_inv_cancel₀ hq
  · simp only [Module.End.mul_apply, LinearMap.smul_apply, opF_single, opX_single hq, map_smul,
      map_sub, smul_sub, smul_smul, Nat.add_sub_cancel]
    match_scalars
    · linear_combination (-(x * q ^ (a + 1) * q⁻¹ ^ (a + 1) * q⁻¹ ^ b)) * mul_inv_cancel₀ hq
    · linear_combination (x * q * qInt q (a + 1) * q⁻¹ ^ a) * mul_inv_cancel₀ hq

lemma opF_pow_single (c : ℕ) :
    (opF q ^ c) (Finsupp.single (0, 0, 0) 1) = Finsupp.single (0, 0, c) 1 := by
  induction c with
  | zero => rfl
  | succ c ih => rw [pow_succ', Module.End.mul_apply, ih, opF_single]; simp

lemma opX_pow_single (hq : q ≠ 0) (b c : ℕ) :
    (opX q ^ b) (Finsupp.single (0, 0, c) 1) = Finsupp.single (0, b, c) 1 := by
  induction b with
  | zero => rfl
  | succ b ih => rw [pow_succ', Module.End.mul_apply, ih, opX_single hq]; simp

lemma opE_pow_single (a b c : ℕ) :
    (opE ^ a) (Finsupp.single (0, b, c) (1 : k)) = Finsupp.single (a, b, c) 1 := by
  induction a with
  | zero => rfl
  | succ a ih => rw [pow_succ', Module.End.mul_apply, ih, opE_single]

end Operators


section Monomials

variable {k B : Type*} [Field k] [Ring B] [Algebra k B] {q : k} (e X f : B)

/-- The ordered monomial `e^a X^b f^c`. -/
def mono (p : ℕ × ℕ × ℕ) : B := e ^ p.1 * X ^ p.2.1 * f ^ p.2.2

variable (k) in
/-- The linear map sending the basis vector `(a, b, c)` to the monomial `e^a X^b f^c`. -/
def monoMap : Space k →ₗ[k] B := Finsupp.linearCombination k (mono e X f)

variable {e X f}

lemma monoMap_single (p : ℕ × ℕ × ℕ) (x : k) :
    monoMap k e X f (Finsupp.single p x) = x • mono e X f p := by
  simp [monoMap]

lemma monoMap_opE (s : Space k) : monoMap k e X f (opE s) = e * monoMap k e X f s := by
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, mul_add]
  | single p x =>
    obtain ⟨a, b, c⟩ := p
    simp [opE_single, monoMap_single, mono, pow_succ', mul_assoc]

lemma monoMap_opF (hfe : f * e = q • (e * f) - q • X)
    (hXe : X * e = q⁻¹ • (e * X)) (hfX : f * X = q⁻¹ • (X * f)) (s : Space k) :
    monoMap k e X f (opF q s) = f * monoMap k e X f s := by
  induction s using Finsupp.induction_linear with
  | zero => simp
  | add s t hs ht => rw [map_add, map_add, hs, ht, map_add, mul_add]
  | single p x =>
    obtain ⟨a, b, c⟩ := p
    rw [opF_single, map_smul, map_sub, map_smul, map_smul, monoMap_single, monoMap_single,
      monoMap_single, mul_smul_comm]
    simp only [mono, one_smul, mul_assoc]
    rcases a with _ | a
    · simp only [pow_zero, one_mul, qInt_zero, mul_zero, zero_smul, sub_zero,
        mul_pow_assoc_of_mul_eq hfX, pow_succ' f c, smul_smul]
    · rw [mul_pow_succ_left_assoc hfe hXe, mul_pow_assoc_of_mul_eq hfX, Nat.add_sub_cancel,
        pow_succ' X b, pow_succ' f c]
      simp only [smul_sub, smul_smul, mul_smul_comm, mul_assoc]

lemma monoMap_single_zero : monoMap k e X f (Finsupp.single (0, 0, 0) 1) = 1 := by
  simp [monoMap_single, mono]

end Monomials

section Representation

variable {k I : Type*} [Field k] [DecidableEq I]

/-- The representation of `'f` on `Space k`: `θᵢ ↦ opE`, `θₗ ↦ opF` for `l ≠ i`. -/
def rep (q : k) (i : I) : LusztigF k I →ₐ[k] Module.End k (Space k) :=
  FreeAlgebra.lift k (fun l ↦ if l = i then opE else opF q)

variable {q : k} {i j : I}

@[simp] lemma rep_θ_left : rep q i (θ k i) = opE := by simp [rep]

lemma rep_θ_right (hij : i ≠ j) : rep q i (θ k j) = opF q := by simp [rep, hij.symm]

lemma rep_qSerre (q' : k) (m : ℕ) (a b : LusztigF k I) :
    rep q i (qSerre q' m a b) = qSerre q' m (rep q i a) (rep q i b) := by
  simp only [qSerre, map_sum, map_smul, map_mul, map_pow]

lemma rep_qComm (hij : i ≠ j) : rep q i (qComm q (θ k i) (θ k j)) = opX q := by
  simp [qComm, rep_θ_right hij, opX]

end Representation

/-! ### The operator representation of `'f` kills the Serre ideal -/

section RepSerre

variable {k I : Type*} [Field k] [DecidableEq I] {D : LusztigCartanDatum I} {v : k} {i j : I}

omit [DecidableEq I] in
lemma toNat_one_sub_eq_two {i j : I} (h : D.cartanMatrix i j = -1) :
    (1 - D.cartanMatrix i j).toNat = 2 := by
  rw [h]; rfl

/-- At an exact two-node datum with a simple edge, the representation `rep` of `'f` kills
every quantum Serre element. -/
theorem serreIdeal_le_ker_rep [NeZero v] (hij : i ≠ j) (hall : ∀ l, l = i ∨ l = j)
    (h : D.cartanMatrix i j = -1) (h' : D.cartanMatrix j i = -1)
    (h2 : qFactorial (v ^ D.d i) 2 ≠ 0) :
    serreIdeal D v ≤ TwoSidedIdeal.ker (rep (v ^ D.d i) i) := by
  have hq : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  rw [serreIdeal, TwoSidedIdeal.span_le]
  rintro _ ⟨l, m, hlm, rfl⟩
  rw [SetLike.mem_coe, TwoSidedIdeal.mem_ker]
  rcases hall l with rfl | rfl <;> rcases hall m with rfl | rfl
  · exact absurd rfl hlm
  · rw [serreElement, toNat_one_sub_eq_two h, qSerreDiv_eq h2, map_smul,
      rep_qSerre, rep_θ_left, rep_θ_right hij, qSerre_two_left hq]
    change _ • (opE * opX _ - _ • (opX _ * opE)) = 0
    rw [opE_opX hq, sub_self, smul_zero]
  · rw [serreElement, toNat_one_sub_eq_two h', ← D.d_eq_of_simply_laced_edge h h',
      qSerreDiv_eq h2, map_smul, rep_qSerre, rep_θ_left, rep_θ_right hlm.symm,
      qSerre_two_right hq]
    change _ • (opX _ * opF _ - _ • (opF _ * opX _)) = 0
    rw [opX_opF hq, sub_self, smul_zero]
  · exact absurd rfl hlm

end RepSerre

end A2PBW

open A2PBW

/-! ### The PBW basis of `U⁺` in type `A₂` -/

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  (R : D.RootDatum Y) (v : k) (i j : I)

/-- The ordered PBW monomial `Eᵢ^a Tᵢ(Eⱼ)^b Eⱼ^c` of type `A₂`, where
`Tᵢ(Eⱼ) = braidEj R v i j = EᵢEⱼ - vᵢ⁻¹ EⱼEᵢ` is the root vector of the non-simple positive
root. -/
def a2PBWMono (p : ℕ × ℕ × ℕ) : QuantumGroup R v :=
  mono (E R v i) (braidEj R v i j) (E R v j) p

variable {R v i j}

section Relations

variable (h : D.cartanMatrix i j = -1)
include h

lemma a2_braidEj_eq_qComm : braidEj R v i j = qComm (v ^ D.d i) (E R v i) (E R v j) :=
  braidEj_eq_of_cartanMatrix_eq_neg_one h

variable [NeZero v]

/-- `Eⱼ Eᵢ = vᵢ Eᵢ Eⱼ - vᵢ Tᵢ(Eⱼ)`. -/
lemma a2_E_mul_E : E R v j * E R v i =
    v ^ D.d i • (E R v i * E R v j) - v ^ D.d i • braidEj R v i j := by
  rw [a2_braidEj_eq_qComm h]
  exact mul_eq_qComm (pow_ne_zero _ (NeZero.ne v)) _ _

variable (hij : i ≠ j)
include hij

/-- `Tᵢ(Eⱼ) Eᵢ = vᵢ⁻¹ Eᵢ Tᵢ(Eⱼ)`, from the Serre relation `S₂(Eᵢ, Eⱼ) = 0`. -/
lemma a2_braidEj_mul_E : braidEj R v i j * E R v i =
    (v ^ D.d i)⁻¹ • (E R v i * braidEj R v i j) := by
  rw [a2_braidEj_eq_qComm h]
  refine qComm_mul_left_of_qSerre (pow_ne_zero _ (NeZero.ne v)) ?_
  have hS := serre_E R v hij
  rwa [toNat_one_sub_eq_two h] at hS

variable (h' : D.cartanMatrix j i = -1)
include h'

/-- `Eⱼ Tᵢ(Eⱼ) = vᵢ⁻¹ Tᵢ(Eⱼ) Eⱼ`, from the Serre relation `S₂(Eⱼ, Eᵢ) = 0`. -/
lemma a2_E_mul_braidEj : E R v j * braidEj R v i j =
    (v ^ D.d i)⁻¹ • (braidEj R v i j * E R v j) := by
  rw [a2_braidEj_eq_qComm h]
  refine mul_qComm_right_of_qSerre (pow_ne_zero _ (NeZero.ne v)) ?_
  have hS := serre_E R v hij.symm
  rwa [toNat_one_sub_eq_two h', ← D.d_eq_of_simply_laced_edge h h'] at hS

variable (hall : ∀ l, l = i ∨ l = j)
include hall

/-- The operator model intertwines: `Φ(x · s) = x⁺ Φ(s)`. -/
theorem a2_monoMap_rep (x : LusztigF k I) (s : Space k) :
    monoMap k (E R v i) (braidEj R v i j) (E R v j) (rep (v ^ D.d i) i x s) =
      plusHom R v x * monoMap k (E R v i) (braidEj R v i j) (E R v j) s := by
  induction x using FreeAlgebra.induction generalizing s with
  | grade0 r =>
    rw [AlgHom.commutes, AlgHom.commutes, Module.algebraMap_end_apply, map_smul,
      Algebra.smul_def]
  | grade1 l =>
    rcases hall l with rfl | rfl
    · change monoMap k _ _ _ (rep _ l (θ k l) s) = plusHom R v (θ k l) * _
      rw [rep_θ_left, plusHom_θ, monoMap_opE]
    · change monoMap k _ _ _ (rep _ i (θ k l) s) = plusHom R v (θ k l) * _
      rw [rep_θ_right hij, plusHom_θ, monoMap_opF (a2_E_mul_E h) (a2_braidEj_mul_E h hij)
        (a2_E_mul_braidEj h hij h')]
  | mul a b ha hb =>
    rw [map_mul, Module.End.mul_apply, ha, hb, map_mul, mul_assoc]
  | add a b ha hb =>
    rw [map_add, LinearMap.add_apply, map_add, ha, hb, map_add, add_mul]

/-- **Spanning** ([Jan] 8.24 (check), [Lus] 40.2.1 (check)): in type `A₂`, the ordered monomials
`Eᵢ^a Tᵢ(Eⱼ)^b Eⱼ^c` span `U⁺`, the subalgebra generated by the `Eₗ`. Only `v ≠ 0` is used. -/
theorem span_a2PBWMono :
    Submodule.span k (Set.range (a2PBWMono R v i j)) =
      Subalgebra.toSubmodule (Algebra.adjoin k (Set.range (E R v))) := by
  refine le_antisymm (Submodule.span_le.2 ?_) ?_
  · rintro _ ⟨p, rfl⟩
    change a2PBWMono R v i j p ∈ Algebra.adjoin k (Set.range (E R v))
    have hE : ∀ l, E R v l ∈ Algebra.adjoin k (Set.range (E R v)) :=
      fun l ↦ Algebra.subset_adjoin ⟨l, rfl⟩
    have hX : braidEj R v i j ∈ Algebra.adjoin k (Set.range (E R v)) := by
      rw [a2_braidEj_eq_qComm h, qComm]
      exact sub_mem (mul_mem (hE i) (hE j)) (Subalgebra.smul_mem _ (mul_mem (hE j) (hE i)) _)
    exact mul_mem (mul_mem (pow_mem (hE i) _) (pow_mem hX _)) (pow_mem (hE j) _)
  · rw [Algebra.adjoin_range_eq_range_freeAlgebra_lift]
    rintro _ ⟨x, rfl⟩
    change FreeAlgebra.lift k (E R v) x ∈ _
    have hx : FreeAlgebra.lift k (E R v) x =
        monoMap k (E R v i) (braidEj R v i j) (E R v j)
          (rep (v ^ D.d i) i x (Finsupp.single (0, 0, 0) 1)) := by
      rw [a2_monoMap_rep h hij h' hall, monoMap_single_zero, mul_one]
      rfl
    rw [hx, monoMap, ← Finsupp.range_linearCombination]
    exact LinearMap.mem_range_self _ _

variable (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)
include hv'

/-- **Linear independence** ([Jan] 8.24 (check), [Lus] 40.2.1 (check)): for `v` not a root of
unity, the ordered monomials `Eᵢ^a Tᵢ(Eⱼ)^b Eⱼ^c` of type `A₂` are linearly independent. The
proof represents `'f` on `k[ℕ³]` through the straightening formulas and uses `U⁺ ≅ 'f ⧸ J`
(`plusHom_eq_zero_iff`); the argument is reconstructed. -/
theorem linearIndependent_a2PBWMono : LinearIndependent k (a2PBWMono R v i j) := by
  have hq : v ^ D.d i ≠ 0 := pow_ne_zero _ (NeZero.ne v)
  let fm : Space k →ₗ[k] LusztigF k I :=
    Finsupp.linearCombination k (mono (θ k i) (qComm (v ^ D.d i) (θ k i) (θ k j)) (θ k j))
  have hplus : ∀ s, plusHom R v (fm s) =
      monoMap k (E R v i) (braidEj R v i j) (E R v j) s := by
    intro s
    induction s using Finsupp.induction_linear with
    | zero => simp
    | add s t hs ht => rw [map_add, map_add, hs, ht, map_add]
    | single p x =>
      simp only [fm, Finsupp.linearCombination_single, map_smul, monoMap_single, mono, map_mul,
        map_pow, plusHom_θ, a2_braidEj_eq_qComm h, qComm, map_sub]
  have hrep : ∀ s, rep (v ^ D.d i) i (fm s) (Finsupp.single (0, 0, 0) 1) = s := by
    intro s
    induction s using Finsupp.induction_linear with
    | zero => simp
    | add s t hs ht => rw [map_add, map_add, LinearMap.add_apply, hs, ht]
    | single p x =>
      obtain ⟨a, b, c⟩ := p
      simp only [fm, Finsupp.linearCombination_single, map_smul, LinearMap.smul_apply, mono,
        map_mul, map_pow, rep_θ_left, rep_θ_right hij, rep_qComm hij, Module.End.mul_apply,
        opF_pow_single, opX_pow_single hq, opE_pow_single]
      rw [Finsupp.smul_single, smul_eq_mul, mul_one]
  rw [linearIndependent_iff]
  intro s hs
  have h0 : plusHom R v (fm s) = 0 := (hplus s).trans hs
  have hker := serreIdeal_le_ker_rep hij hall h h'
    (qFactorial_ne_zero_of_not_root (NeZero.ne v) hv' i 2) ((plusHom_eq_zero_iff R v hv' _).1 h0)
  rw [TwoSidedIdeal.mem_ker] at hker
  rw [← hrep s, hker, LinearMap.zero_apply]

variable (R v) in
/-- **The PBW basis of `U⁺` in type `A₂`** ([Jan] Thm. 8.24 (check), [Lus] Cor. 40.2.2 (check)):
for an exact two-node datum with mutual Cartan entries `-1` and `v` not a root of unity, the
ordered monomials `Eᵢ^a Tᵢ(Eⱼ)^b Eⱼ^c` form a basis of the subalgebra generated by the `Eₗ`. -/
def a2PBWBasis :
    Module.Basis (ℕ × ℕ × ℕ) k (Subalgebra.toSubmodule (Algebra.adjoin k (Set.range (E R v)))) :=
  (Module.Basis.span (linearIndependent_a2PBWMono h hij h' hall hv')).map
    (LinearEquiv.ofEq _ _ (span_a2PBWMono h hij h' hall))

@[simp] theorem a2PBWBasis_apply (p : ℕ × ℕ × ℕ) :
    (a2PBWBasis R v h hij h' hall hv' p : QuantumGroup R v) = a2PBWMono R v i j p := by
  simp [a2PBWBasis, Module.Basis.span_apply]

end Relations

/-! ### The root vectors along the reduced word `i j i` -/

section RootVectors

variable {S T : QuantumGroup R v →ₐ[k] QuantumGroup R v}

/-- The second root vector `E_{αᵢ+αⱼ} = Tᵢ(Eⱼ)` is `braidEj R v i j`. -/
theorem a2_rootVector_two (hij : i ≠ j) (HS : HasBraidGeneratorImages i S) :
    S (E R v j) = braidEj R v i j := by
  simp [HS.map_E, hij.symm]

/-- The third root vector `E_{αⱼ} = TᵢTⱼ(Eᵢ)` is `Eⱼ` ([Jan] 8.20 (check)). -/
theorem a2_rootVector_three [NeZero v] (HS : HasBraidGeneratorImages i S)
    (HT : HasBraidGeneratorImages j T) (hij : i ≠ j) (h : D.cartanMatrix i j = -1)
    (h' : D.cartanMatrix j i = -1) (hqi : v ^ D.d i - (v ^ D.d i)⁻¹ ≠ 0) :
    S (T (E R v i)) = E R v j :=
  HS.three_double_E HT hij h h' hqi

/-- The PBW monomials are the ordered monomials `E_{β₁}^a E_{β₂}^b E_{β₃}^c` in the root vectors
`E_{β₁} = Eᵢ`, `E_{β₂} = Tᵢ(Eⱼ)`, `E_{β₃} = TᵢTⱼ(Eᵢ)` along the reduced expression `sᵢ sⱼ sᵢ` of
the longest Weyl group element ([Jan] 8.21 (check), [Lus] 40.1 (check)). -/
theorem a2PBWMono_eq_rootVectors [NeZero v] (HS : HasBraidGeneratorImages i S)
    (HT : HasBraidGeneratorImages j T) (hij : i ≠ j) (h : D.cartanMatrix i j = -1)
    (h' : D.cartanMatrix j i = -1) (hqi : v ^ D.d i - (v ^ D.d i)⁻¹ ≠ 0) (p : ℕ × ℕ × ℕ) :
    a2PBWMono R v i j p = E R v i ^ p.1 * S (E R v j) ^ p.2.1 * S (T (E R v i)) ^ p.2.2 := by
  rw [a2_rootVector_two hij HS, a2_rootVector_three HS HT hij h h' hqi]
  rfl

end RootVectors

section Concrete

variable [NeZero v] (h : D.cartanMatrix i j = -1) (hij : i ≠ j) (h' : D.cartanMatrix j i = -1)
  (hall : ∀ l, l = i ∨ l = j) (hv' : ∀ n : ℕ, 0 < n → v ^ n ≠ 1)

/-- The PBW basis in terms of Lusztig's automorphisms `Tᵢ = twoNodeBraidEquiv_of_not_root`:
the basis vector `(a, b, c)` is `Eᵢ^a Tᵢ(Eⱼ)^b (TᵢTⱼ(Eᵢ))^c`. -/
theorem a2PBWBasis_apply_braidEquiv (p : ℕ × ℕ × ℕ) :
    (a2PBWBasis R v h hij h' hall hv' p : QuantumGroup R v) =
      E R v i ^ p.1 * twoNodeBraidEquiv_of_not_root (R := R) hij hall hv' (E R v j) ^ p.2.1 *
        twoNodeBraidEquiv_of_not_root (R := R) hij hall hv'
          (twoNodeBraidEquiv_of_not_root (R := R) hij.symm (fun l ↦ (hall l).symm) hv'
            (E R v i)) ^ p.2.2 := by
  have HS : HasBraidGeneratorImages i
      (twoNodeBraidEquiv_of_not_root (R := R) hij hall hv').toAlgHom :=
    braidHom_hasBraidGeneratorImages
      (twoNode_braidGeneric hij hall (shortNode_braidGeneric_of_not_root hv' i).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' i j))
      (twoNode_transformedSerre hij hall (shortNode_braidGeneric_of_not_root hv' i).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' i j))
  have HT : HasBraidGeneratorImages j
      (twoNodeBraidEquiv_of_not_root (R := R) hij.symm (fun l ↦ (hall l).symm) hv').toAlgHom :=
    braidHom_hasBraidGeneratorImages
      (twoNode_braidGeneric hij.symm (fun l ↦ (hall l).symm)
        (shortNode_braidGeneric_of_not_root hv' j).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' j i))
      (twoNode_transformedSerre hij.symm (fun l ↦ (hall l).symm)
        (shortNode_braidGeneric_of_not_root hv' j).sub_ne
        (twoNode_qFactorial_ne_zero_of_not_root hv' j i))
  rw [a2PBWBasis_apply, a2PBWMono_eq_rootVectors HS HT hij h h'
    (shortNode_braidGeneric_of_not_root hv' i).sub_ne]
  rfl

end Concrete

end QuantumGroup

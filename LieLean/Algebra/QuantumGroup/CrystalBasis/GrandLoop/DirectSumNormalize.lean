import LieLean.Algebra.QuantumGroup.CrystalBasis.Dimension
import LieLean.Algebra.QuantumGroup.CrystalBasis.GrandLoop.DirectSumAut

/-!
# Normalizing the highest weight vectors of `⊕ⱼ V(λⱼ)` against a crystal base

Let `N = ⊕ⱼ V(λⱼ)` be a direct sum of irreducible highest weight modules `V(λ) = L_q(λ)` with
dominant highest weights, and let `(L, B)` be a crystal base of `N`. This file contains the step of
the uniqueness theorem for crystal bases ([HK] Thm. 5.2.1) which splits off the summands of a
maximal highest weight.

The standing hypotheses on a set `S` of summands, possibly infinite, are: `L` is stable under the
projection onto the summands in `S` (`hPS`), and `L` and `⊕ⱼ L(λⱼ)` contain the same vectors among
those with no component in `S` (`hoff`). Let `λ = λ_{j₀}` be maximal among the `λⱼ`, `j ∈ S`, and
different from the `λⱼ`, `j ∉ S`, and let `T = {j ∈ S | λⱼ = λ}`, a finite set. The weight space of
`N` of weight `λ` is assumed finite-dimensional.

## Main results

* `IsCrystalBase.linearIndependent_of_mk`: over a principal ideal domain, lifts to `L` of distinct
  elements of `B` are linearly independent.
* `IsCrystalBase.exists_sub_sum_mem`: every vector of `L` is, modulo `ϖL`, an `A`-linear
  combination of chosen lifts of the elements of `B`.
* `GrandLoop.projDS_mem_smul_or`: a lift `x ∈ L` of weight `λ` of an element of `B` has its
  components in `S` or its components outside `S` in `ϖL`.
* `GrandLoop.exists_normalize`: there is a `k`-linear automorphism `g` of the span of the `v_{λⱼ}`,
  `j ∈ T`, such that the automorphism `GrandLoop.autEquiv g` of `N` maps every `v_{λⱼ}`, `j ∈ T`,
  to a lift of an element of `B`, and its inverse maps the vectors of `L` in that span into
  `⊕ⱼ L(λⱼ)`.

## Implementation notes

[HK] split off the submodule generated by lifts of the elements of `B` of maximal weight `λ`
together with a complement. Here the module `N` is fixed: the lifts with a nonzero component in
`S` form a basis of the span of the `v_{λⱼ}`, `j ∈ T`, and an automorphism of `N` moves the
`v_{λⱼ}` onto them, after which the splitting is the projection onto summands. These arguments are
ours.

## References

* [HK] J. Hong, S.-J. Kang, *Introduction to quantum groups and crystal bases*, GSM 42, §5.2.
-/

open Pointwise

noncomputable section

namespace LieLean.QuantumGroup

/-! ### Lifts of crystal base elements -/

namespace IsCrystalBase

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {v : k}
  {M : Type*} [AddCommGroup M] [Module k M] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M]
  [NeZero v] {hv : ∀ n : ℕ, 0 < n → v ^ n ≠ 1} {hM : IsIntegrable R v M}
  {A : Type*} [CommRing A] [Algebra A k] [Module A M] [IsScalarTower A k M]
  {L : Submodule A M} {hL : IsCrystalLattice hv hM L} {c : A}
  {B : Set (L ⧸ (Ideal.span {c} • ⊤ : Submodule A L))}

/-- Over a principal ideal domain, vectors of `L` whose classes modulo `cL` are distinct elements
of a crystal base `B` are linearly independent. -/
lemma linearIndependent_of_mk [IsDomain A] [IsPrincipalIdealRing A] [Module.IsTorsionFree A M]
    (hB : IsCrystalBase hL c B) (hc : ¬IsUnit c) {ι : Type*} (y : ι → M) (hy : ∀ b, y b ∈ L)
    (f : ι → B) (hf : Function.Injective f)
    (hyf : ∀ b, Submodule.Quotient.mk ⟨y b, hy b⟩ = (f b).1) : LinearIndependent A y := by
  classical
  have : Nontrivial (A ⧸ Ideal.span {c}) :=
    Ideal.Quotient.nontrivial_iff.mpr (by rwa [Ne, Ideal.span_singleton_eq_top])
  rw [linearIndependent_iff']
  intro s g hg i hi
  obtain ⟨d, hd⟩ := (IsPrincipalIdealRing.principal (Ideal.span (g '' ↑s))).principal
  have hgd : ∀ j ∈ s, g j ∈ Ideal.span {d} := fun j hj ↦ by
    rw [← Ideal.submodule_span_eq, ← hd]
    exact Ideal.subset_span (Set.mem_image_of_mem g hj)
  by_cases hd0 : d = 0
  · simpa [hd0] using hgd i hi
  exfalso
  choose! g' hg' using fun j hj ↦ Ideal.mem_span_singleton'.mp (hgd j hj)
  have h0 : ∑ j ∈ s, g' j • y j = 0 := by
    have : d • ∑ j ∈ s, g' j • y j = 0 := by
      rw [Finset.smul_sum, ← hg]
      refine Finset.sum_congr rfl fun j hj ↦ ?_
      rw [smul_smul, mul_comm, hg' j hj]
    exact ((Module.isTorsionFree_iff_smul_eq_zero.mp inferInstance) d _ this).resolve_left hd0
  have h1 : ∑ j ∈ s, Ideal.Quotient.mk (Ideal.span {c}) (g' j) •
      ((f j : B) : L ⧸ (Ideal.span {c} • ⊤ : Submodule A L)) = 0 := by
    have hsum : (∑ j ∈ s, g' j • (⟨y j, hy j⟩ : L)) = 0 :=
      Subtype.ext (by simpa [Submodule.coe_sum] using h0)
    have := congrArg (Ideal.span {c} • ⊤ : Submodule A L).mkQ hsum
    rw [map_sum, map_zero] at this
    rw [← this]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_smul, ← hyf j]
    rfl
  have hc' := linearIndependent_iff'.mp (hB.linearIndependent.comp f hf) s _ h1
  have hd' : d ∈ Ideal.span {c * d} := by
    have hle : Ideal.span (g '' ↑s) ≤ Ideal.span {c * d} := by
      refine Ideal.span_le.mpr ?_
      rintro _ ⟨j, hj, rfl⟩
      obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp
        (Ideal.Quotient.eq_zero_iff_mem.mp (hc' j hj))
      rw [← hg' j hj, ← ht]
      exact Ideal.mem_span_singleton'.mpr ⟨t, by ring⟩
    refine hle ?_
    rw [hd]
    exact Submodule.mem_span_singleton_self d
  obtain ⟨t, ht⟩ := Ideal.mem_span_singleton'.mp hd'
  have : t * c = 1 := by
    have h2 : (t * c - 1) * d = 0 := by linear_combination ht
    exact sub_eq_zero.mp ((mul_eq_zero.mp h2).resolve_right hd0)
  exact hc (IsUnit.of_mul_eq_one_right t this)

/-- Every vector of `L` is congruent modulo `cL` to an `A`-linear combination of chosen lifts of
elements of `B`. -/
lemma exists_sub_sum_mem (hB : IsCrystalBase hL c B) (x : B → L)
    (hxb : ∀ b, Submodule.Quotient.mk (x b) = b.1) (z : L) :
    ∃ (n : ℕ) (a : Fin n → A) (g : Fin n → B), (z : M) - ∑ i, a i • (x (g i) : M) ∈ c • L := by
  have hz : (Submodule.Quotient.mk z : L ⧸ (Ideal.span {c} • ⊤ : Submodule A L)) ∈
      Submodule.span (A ⧸ Ideal.span {c}) B := hB.span_eq_top ▸ Submodule.mem_top
  obtain ⟨n, f, g, hfg⟩ := Submodule.mem_span_set'.mp hz
  choose a ha using fun i ↦ Ideal.Quotient.mk_surjective (f i)
  refine ⟨n, a, g, ?_⟩
  have e : (Submodule.Quotient.mk z : L ⧸ (Ideal.span {c} • ⊤ : Submodule A L)) =
      Submodule.Quotient.mk (∑ i, a i • x (g i)) := by
    rw [← hfg]
    have e' : ∀ i, f i • ((g i : B) : L ⧸ (Ideal.span {c} • ⊤ : Submodule A L)) =
        (Ideal.span {c} • ⊤ : Submodule A L).mkQ (a i • x (g i)) := fun i ↦ by
      rw [← ha i, ← hxb (g i)]
      rfl
    rw [Finset.sum_congr rfl fun i _ ↦ e' i, ← map_sum]
    rfl
  have := (IntegrableSl2.mk_eq_mk_iff c _ _).mp e
  simpa [Submodule.coe_sum] using this

/-- If `B₁ ⊆ B₂` with `B₁` spanning and `B₂` linearly independent, then `B₁ = B₂`. -/
lemma eq_of_subset_of_span_eq_top {R' N : Type*} [Ring R'] [Nontrivial R'] [AddCommGroup N]
    [Module R' N] {B₁ B₂ : Set N} (hsub : B₁ ⊆ B₂) (hspan : Submodule.span R' B₁ = ⊤)
    (hli : LinearIndependent R' (Subtype.val : B₂ → N)) : B₁ = B₂ := by
  refine le_antisymm hsub fun b hb ↦ ?_
  by_contra hb'
  have hspan' : b ∈ Submodule.span R' (Subtype.val '' {x : B₂ | x ≠ ⟨b, hb⟩}) := by
    have h1 : b ∈ Submodule.span R' B₁ := by rw [hspan]; trivial
    refine Submodule.span_mono (fun x hx ↦ ?_) h1
    refine ⟨⟨x, hsub hx⟩, fun h ↦ hb' ?_, rfl⟩
    have := congrArg Subtype.val h
    simp only at this
    rw [← this]; exact hx
  exact hli.notMem_span_image (s := {x : B₂ | x ≠ ⟨b, hb⟩}) (x := ⟨b, hb⟩) (fun h ↦ h rfl) hspan'

end IsCrystalBase

namespace GrandLoop

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {v : k} [NeZero v] [CharZero k]
  {hvt : Transcendental ℚ v} {hR : R.IsXRegular} {A : Type*} [CommRing A] [Algebra A k] {ϖ : A}
  {J : Type*} (Λ : J → Dom R)

/-! ### Preliminaries -/

variable {Λ} in
/-- The quotient `L / ϖ L` for an `A`-submodule `L` of `⊕ⱼ V(λⱼ)`. (The quotient instance is given
explicitly: instance search does not find it for `Π₀ j, L_q(λⱼ)`.) -/
abbrev QDS (L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)) (ϖ : A) : Type _ :=
  @HasQuotient.Quotient L (Submodule A L)
    (@Submodule.hasQuotient A L _ (Submodule.addCommGroup L) _) (Ideal.span {ϖ} • ⊤)

omit [CharZero k] in
/-- `A` is a fraction ring of `k` under the hypotheses of the grand loop. -/
lemma isFractionRing_of [IsDomain A] (hinj : Function.Injective (algebraMap A k))
    (hϖv : algebraMap A k ϖ = v⁻¹)
    (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a) :
    IsFractionRing A k := by
  have : FaithfulSMul A k := (faithfulSMul_iff_algebraMap_injective A k).2 hinj
  refine IsFractionRing.of_field A k fun c ↦ ?_
  obtain ⟨m, a, ha⟩ := hk c
  have h0 : algebraMap A k (ϖ ^ m) ≠ 0 := by
    rw [map_pow, hϖv]
    exact pow_ne_zero _ (inv_ne_zero (NeZero.ne v))
  exact ⟨a, ϖ ^ m, by rw [← ha, mul_div_cancel_left₀ _ h0]⟩

omit [DecidableEq I] [NeZero v] [CharZero k] in
/-- Nonzero vectors in distinct summands of a direct sum are linearly independent. -/
lemma linearIndependent_dfinsuppSingle {ι : Type*} [DecidableEq ι] {M : ι → Type*}
    [∀ i, AddCommGroup (M i)] [∀ i, Module k (M i)] (w : ∀ i, M i) (hw : ∀ i, w i ≠ 0)
    (T : Set ι) : LinearIndependent k (fun j : T ↦ DFinsupp.single (j : ι) (w j)) := by
  refine linearIndependent_iff'.2 fun t c hsum j hj ↦ ?_
  have h := congrArg (fun f : Π₀ i, M i ↦ f j.1) hsum
  simp only [DFinsupp.finsetSum_apply, DFinsupp.zero_apply] at h
  rw [Finset.sum_eq_single j (fun i _ hij ↦ by
      rw [DFinsupp.smul_apply, DFinsupp.single_eq_of_ne (fun h ↦ hij (Subtype.ext h).symm),
        smul_zero])
    (fun hj' ↦ absurd hj hj'), DFinsupp.smul_apply, DFinsupp.single_eq_same] at h
  exact (smul_eq_zero.1 h).resolve_right (hw _)

omit [DecidableEq I] [NeZero v] [CharZero k] in
/-- Two bases of a vector space are related by an automorphism and a bijection of the indices. -/
lemma exists_linearEquiv_of_basis {V : Type*} [AddCommMonoid V] [Module k V] {ι₁ ι₂ : Type*}
    {f₁ : ι₁ → V} {f₂ : ι₂ → V} (h₁ : LinearIndependent k f₁)
    (hs₁ : ⊤ ≤ Submodule.span k (Set.range f₁)) (h₂ : LinearIndependent k f₂)
    (hs₂ : ⊤ ≤ Submodule.span k (Set.range f₂)) :
    ∃ (e : ι₁ ≃ ι₂) (g : V ≃ₗ[k] V), ∀ j, g (f₁ j) = f₂ (e j) := by
  set b₁ := Module.Basis.mk h₁ hs₁
  set b₂ := Module.Basis.mk h₂ hs₂
  refine ⟨b₁.indexEquiv b₂, b₁.equiv b₂ (b₁.indexEquiv b₂), fun j ↦ ?_⟩
  rw [← Module.Basis.mk_apply h₁ hs₁ j, ← Module.Basis.mk_apply h₂ hs₂, Module.Basis.equiv_apply]

omit [DecidableEq I] [NeZero v] [CharZero k] in
/-- A family in a subspace `p` spans `p` if its image spans a subspace containing `p`. -/
lemma top_le_span_range_of_le {N : Type*} [AddCommGroup N] [Module k N] (p : Submodule k N)
    {ι : Type*} (f : ι → p) (h : p ≤ Submodule.span k (Set.range fun i ↦ (f i : N))) :
    ⊤ ≤ Submodule.span k (Set.range f) := by
  intro y _
  have hmap : (Submodule.span k (Set.range f)).map p.subtype =
      Submodule.span k (Set.range fun i ↦ (f i : N)) := by
    rw [Submodule.map_span, ← Set.range_comp]; rfl
  have hy : (y : N) ∈ (Submodule.span k (Set.range f)).map p.subtype := by
    rw [hmap]; exact h y.2
  obtain ⟨y', hy', hyy⟩ := Submodule.mem_map.1 hy
  rwa [Subtype.ext hyy] at hy'

omit [DecidableEq I] [NeZero v] [CharZero k] in
/-- A `k`-linear map carries `ϖ L₁` into `ϖ L₂` if it carries `L₁` into `L₂`. -/
lemma map_mem_smul_of_mem' {M : Type*} [AddCommGroup M] [Module k M] [Module A M]
    [IsScalarTower A k M] {f : Module.End k M} {L₁ L₂ : Submodule A M}
    (hf : ∀ m ∈ L₁, f m ∈ L₂) {m : M} (hm : m ∈ ϖ • L₁) : f m ∈ ϖ • L₂ := by
  obtain ⟨x, hx, rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hm
  rw [LinearMap.map_smul_of_tower]
  exact Submodule.smul_mem_pointwise_smul _ _ _ (hf x hx)

section Maximal

variable {Λ} {S : Set J} {j₀ : J}
  (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
include hmax

include hvt in
/-- If `λ_{j₀}` is maximal among the `λⱼ`, `j ∈ S`, then `λ_{j₀} + αᵢ` is not a weight of
`V(λⱼ)`, `j ∈ S`. -/
lemma eq_zero_of_mem_weightSpace_add_root {j : J} (hj : j ∈ S) (i : I)
    {y : IrreducibleModule R v (Λ j).1} (hy : y ∈ weightSpace R v _ ((Λ j₀).1 + R.root i)) :
    y = 0 := by
  by_contra hy0
  obtain ⟨ν, hν⟩ :=
    IrreducibleModule.exists_eq_sub_rootSum (pow_ne_one_of_transcendental' hvt) hy hy0
  rw [eq_sub_iff_add_eq] at hν
  have h := hmax j hj (ν + Finsupp.single i 1) (by
    rw [R.rootSum_add, R.rootSum_single, one_nsmul, ← hν]; abel)
  simpa using DFunLike.congr_fun h i

include hvt in
/-- If `λ_{j₀}` is maximal among the `λⱼ`, `j ∈ S`, then `λ_{j₀}` is a weight of `V(λⱼ)`, `j ∈ S`,
only if `λⱼ = λ_{j₀}`. -/
lemma eq_zero_of_mem_weightSpace_of_ne {j : J} (hj : j ∈ S) (hne : (Λ j).1 ≠ (Λ j₀).1)
    {y : IrreducibleModule R v (Λ j).1} (hy : y ∈ weightSpace R v _ (Λ j₀).1) : y = 0 := by
  by_contra hy0
  obtain ⟨ν, hν⟩ :=
    IrreducibleModule.exists_eq_sub_rootSum (pow_ne_one_of_transcendental' hvt) hy hy0
  have h := hmax j hj ν (by rw [hν]; abel)
  rw [h, R.rootSum_zero, sub_zero] at hν
  exact hne hν.symm

variable [DecidablePred (· ∈ S)]

include hvt in
/-- The components in `S` of a vector of weight `λ_{j₀} + αᵢ` vanish. -/
lemma projDS_eq_zero_of_mem_weightSpace_add_root (i : I)
    {x : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hx : x ∈ weightSpace R v _ ((Λ j₀).1 + R.root i)) : projDS Λ (· ∈ S) x = 0 := by
  ext j
  rw [projDS_apply, DFinsupp.zero_apply]
  split_ifs with hj
  · exact eq_zero_of_mem_weightSpace_add_root (hvt := hvt) hmax hj i
      (map_mem_weightSpace (DFinsupp.lapply (R := QuantumGroup R v) j) hx)
  · rfl

omit [DecidablePred (· ∈ S)] in
include hvt hR in
/-- A vector of weight `λ_{j₀}` with components only in `S` lies in the span of the highest weight
vectors `v_{λⱼ}`, `j ∈ S`, `λⱼ = λ_{j₀}`. -/
lemma mem_hwSpan_of_mem_weightSpace [DecidableEq J] {T : Finset J}
    (hTS : ∀ j ∈ S, (Λ j).1 = (Λ j₀).1 → j ∈ T) {x : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hx : x ∈ weightSpace R v _ (Λ j₀).1) (hxS : ∀ j, j ∉ S → x j = 0) :
    x ∈ hwSpan v Λ T := by
  classical
  rw [← DFinsupp.sum_single (f := x)]
  refine Submodule.dfinsuppSum_mem _ _ _ fun j _ ↦ ?_
  have hxj : x j ∈ weightSpace R v _ (Λ j₀).1 :=
    map_mem_weightSpace (DFinsupp.lapply (R := QuantumGroup R v) j) hx
  by_cases hj : j ∈ S
  · by_cases hje : (Λ j).1 = (Λ j₀).1
    · obtain ⟨c, hc⟩ := exists_eq_smul_hwv_of_mem_weightSpace (hvt := hvt) (hR := hR) (Λ j)
        (x := x j) (by rw [← hje] at hxj; exact hxj)
      rw [hc, DFinsupp.single_smul]
      exact Submodule.smul_mem _ c (single_hwv_mem_hwSpan (hTS j hj hje))
    · rw [eq_zero_of_mem_weightSpace_of_ne (hvt := hvt) hmax hj hje hxj, DFinsupp.single_zero]
      exact zero_mem _
  · rw [hxS j hj, DFinsupp.single_zero]
    exact zero_mem _

end Maximal

/-! ### Splitting off the summands of maximal weight -/

/-- The highest weight vector of a summand lies in `⊕ⱼ L(λⱼ)`. -/
lemma single_hwv_mem_dsSum [DecidableEq J] (j : J) :
    DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ dsSum hvt hR A Λ := by
  refine (mem_dsSum Λ).2 fun l ↦ ?_
  by_cases hl : l = j
  · subst hl
    rw [DFinsupp.single_eq_same]
    exact IrreducibleModule.hwv_mem_lattice hR _ (Λ l).2 A
  · rw [DFinsupp.single_eq_of_ne hl]
    exact zero_mem _

omit [NeZero v] [CharZero k] in
variable (v) in
/-- The basis `(v_{λⱼ})_{j ∈ T}` of `hwSpan v Λ T` as a family. -/
def hwFamily [DecidableEq J] (T : Finset J) (j : T) : hwSpan v Λ T :=
  ⟨DFinsupp.single (j : J) (IrreducibleModule.hwv R v (Λ (j : J)).1), single_hwv_mem_hwSpan j.2⟩

variable {Λ} in
include hvt hR in
/-- A basis `(u_b)` of the span of the `v_{λⱼ}`, `j ∈ T`, is the image of the basis `(v_{λⱼ})` under
an automorphism of that span, up to a bijection of the indices. -/
lemma exists_hwSpan_equiv [DecidableEq J] {T : Finset J} {ι : Type*}
    {u : ι → Π₀ j, IrreducibleModule R v (Λ j).1} (hu : ∀ b, u b ∈ hwSpan v Λ T)
    (hli : LinearIndependent k u) (hsp : ∀ y ∈ hwSpan v Λ T, y ∈ Submodule.span k (Set.range u)) :
    ∃ (e : T ≃ ι) (g : hwSpan v Λ T ≃ₗ[k] hwSpan v Λ T), (∀ (j : J) (hj : j ∈ T),
      (g ⟨_, single_hwv_mem_hwSpan hj⟩ : Π₀ j, IrreducibleModule R v (Λ j).1) = u (e ⟨j, hj⟩)) ∧
      ∀ b, (g.symm ⟨u b, hu b⟩ : Π₀ j, IrreducibleModule R v (Λ j).1) =
        DFinsupp.single (e.symm b : J) (IrreducibleModule.hwv R v (Λ (e.symm b : J)).1) := by
  have hv' := pow_ne_one_of_transcendental' hvt
  let u' : ι → hwSpan v Λ T := fun b ↦ ⟨u b, hu b⟩
  have hli' : LinearIndependent k u' := LinearIndependent.of_comp (hwSpan v Λ T).subtype hli
  have hsp' : ⊤ ≤ Submodule.span k (Set.range u') :=
    top_le_span_range_of_le _ u' fun y hy ↦ hsp y hy
  have hliβ : LinearIndependent k (hwFamily v Λ T) :=
    LinearIndependent.of_comp (hwSpan v Λ T).subtype
      (linearIndependent_dfinsuppSingle (fun j ↦ IrreducibleModule.hwv R v (Λ j).1)
        (fun j ↦ hwv_ne_zero hR hv' _) (T : Set J))
  have hspβ : ⊤ ≤ Submodule.span k (Set.range (hwFamily v Λ T)) := by
    refine top_le_span_range_of_le _ (hwFamily v Λ T) (Submodule.span_le.2 ?_)
    rintro _ ⟨j, hj, rfl⟩
    exact Submodule.subset_span ⟨⟨j, hj⟩, rfl⟩
  obtain ⟨e, g, hg⟩ := exists_linearEquiv_of_basis hliβ hspβ hli' hsp'
  refine ⟨e, g, fun j hj ↦ congrArg Subtype.val (hg ⟨j, hj⟩), fun b ↦ ?_⟩
  have h := hg (e.symm b)
  rw [Equiv.apply_symm_apply] at h
  exact congrArg Subtype.val (g.symm_apply_eq.2 h.symm)


omit [NeZero v] [CharZero k] in
variable {Λ} in
/-- Membership of a class in `B` transported along an equality of vectors. -/
lemma exists_mem_mk_mem {L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)} {B : Set (QDS L ϖ)}
    {x y : Π₀ j, IrreducibleModule R v (Λ j).1} (h : x = y) (hy : y ∈ L)
    (hB : (Submodule.Quotient.mk (⟨y, hy⟩ : L) : QDS L ϖ) ∈ B) :
    ∃ hx : x ∈ L, (Submodule.Quotient.mk (⟨x, hx⟩ : L) : QDS L ϖ) ∈ B := by
  subst h
  exact ⟨hy, hB⟩

section Split

variable [Finite I] [IsDomain A] [IsDiscreteValuationRing A]
  (hinj : Function.Injective (algebraMap A k)) (hϖ : ϖ ∈ IsLocalRing.maximalIdeal A)
  (hϖv : algebraMap A k ϖ = v⁻¹)
  (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a)
  (hfund : ∀ j : I, ∃ Λ : Dom R, ∀ i, Λ.1 (R.coroot i) = if i = j then 1 else 0)
  [DecidableEq J] {Λ}
  {L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)} {S : Set J} [DecidablePred (· ∈ S)]
  (hPS : ∀ x ∈ L, projDS Λ (· ∈ S) x ∈ L)
  (hoff : ∀ x : Π₀ j, IrreducibleModule R v (Λ j).1,
    (∀ j ∈ S, x j = 0) → (x ∈ L ↔ x ∈ dsSum hvt hR A Λ))

omit [NeZero v] [CharZero k] [Finite I] [IsDomain A] [IsDiscreteValuationRing A] [DecidableEq J] in
include hPS in
/-- `L` is stable under the projection onto the summands outside `S`. -/
lemma projDS_notMem_mem {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ L) :
    projDS Λ (fun j ↦ j ∉ S) x ∈ L := by
  have h : projDS Λ (fun j ↦ j ∉ S) x = x - projDS Λ (· ∈ S) x :=
    eq_sub_of_add_eq' (projDS_add_projDS_not Λ (· ∈ S) x)
  rw [h]
  exact sub_mem hx (hPS x hx)

omit [Finite I] [IsDomain A] [IsDiscreteValuationRing A] [DecidableEq J] in
include hPS hoff in
/-- For vectors with no components in `S`, `ϖ L` and `ϖ ⊕ⱼ L(λⱼ)` agree. -/
lemma mem_smul_iff_mem_smul_dsSum {y : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hy : ∀ j ∈ S, y j = 0) : y ∈ ϖ • L ↔ y ∈ ϖ • dsSum hvt hR A Λ := by
  have hyP : projDS Λ (fun j ↦ j ∉ S) y = y := by
    ext j
    rw [projDS_apply]
    by_cases h : j ∈ S <;> simp [h, hy]
  have hoffP : ∀ z : Π₀ j, IrreducibleModule R v (Λ j).1, ∀ j ∈ S,
      projDS Λ (fun j ↦ j ∉ S) z j = 0 := fun z j hj ↦ by
    rw [projDS_apply]
    simp [hj]
  constructor
  · intro h
    rw [← hyP]
    exact map_mem_smul_of_mem' (f := (projDS Λ (fun j ↦ j ∉ S)).restrictScalars k)
      (fun m hm ↦ (hoff _ (hoffP m)).1 (projDS_notMem_mem hPS hm)) h
  · intro h
    rw [← hyP]
    refine map_mem_smul_of_mem' (f := (projDS Λ (fun j ↦ j ∉ S)).restrictScalars k)
      (fun m hm ↦ (hoff _ (hoffP m)).2 ((mem_dsSum Λ).2 fun j ↦ ?_)) h
    rw [projDS_apply]
    split_ifs
    · exact zero_mem _
    · exact (mem_dsSum Λ).1 hm j

variable {hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) L}
  {B : Set (QDS L ϖ)}

omit [Finite I] [IsDomain A] [IsDiscreteValuationRing A] [DecidableEq J] in
include hPS in
/-- Let `λ_{j₀}` be maximal among the `λⱼ`, `j ∈ S`, and let `x ∈ L` be a vector of weight
`λ_{j₀}` whose class lies in `B`. If `ẽᵢ x ∉ ϖ L` for some `i`, then the components of `x` in `S`
lie in `ϖ L`: the class of `x` is `f̃ᵢ` of the class of `ẽᵢ x`, which has no components in `S`. -/
lemma projDS_mem_smul_of_eDS_notMem {j₀ : J}
    (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
    (hB : IsCrystalBase hL ϖ B) {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ L)
    (hxw : x ∈ weightSpace R v _ (Λ j₀).1)
    (hxB : (Submodule.Quotient.mk (⟨x, hx⟩ : L) : QDS L ϖ) ∈ B) {i : I}
    (hi : eDS hvt hR Λ i x ∉ ϖ • L) :
    projDS Λ (· ∈ S) x ∈ ϖ • L := by
  have hv' := pow_ne_one_of_transcendental' hvt
  have he : hL.eQ ϖ i (Submodule.Quotient.mk ⟨x, hx⟩) =
      Submodule.Quotient.mk ⟨eDS hvt hR Λ i x, hL.kashiwaraE_mem i x hx⟩ := rfl
  have hne : hL.eQ ϖ i (Submodule.Quotient.mk ⟨x, hx⟩) ≠ 0 := by
    rw [he]
    exact fun h ↦ hi ((IntegrableSl2.mk_eq_zero_iff ϖ _).1 h)
  have hb' := (hB.eQ_mem i _ hxB).resolve_right hne
  have hf := (hB.fQ_eq_iff i _ hb' _ hxB).2 rfl
  rw [he] at hf
  have hsub : fDS hvt hR Λ i (eDS hvt hR Λ i x) - x ∈ ϖ • L :=
    (IntegrableSl2.mk_eq_mk_iff ϖ ⟨_, hL.kashiwaraF_mem i _ (hL.kashiwaraE_mem i x hx)⟩
      ⟨x, hx⟩).1 hf
  have h0 : projDS Λ (· ∈ S) (fDS hvt hR Λ i (eDS hvt hR Λ i x)) = 0 := by
    have h := projDS_eq_zero_of_mem_weightSpace_add_root (hvt := hvt) hmax i
      (kashiwaraE_mem_weightSpace hv' (isIntDS hvt hR Λ) i hxw)
    rw [← fDS_projDS]
    erw [h]
    exact map_zero _
  have := map_mem_smul_of_mem' (f := (projDS Λ (· ∈ S)).restrictScalars k) hPS hsub
  rwa [map_sub, LinearMap.restrictScalars_apply, LinearMap.restrictScalars_apply, h0, zero_sub,
    neg_mem_iff] at this

omit [DecidableEq J] in
include hinj hϖ hϖv hk hfund hPS hoff in
/-- If `x ∈ L` has weight `μ ≠ λⱼ` for all `j ∉ S` and `ẽᵢ x ∈ ϖ L` for all `i`, then the
components of `x` outside `S` lie in `ϖ L` ([HK] Lemma 5.2.2 (1) for the summands outside `S`). -/
lemma projDS_notMem_mem_smul_of_eDS_mem {μ : Y →+ ℤ} (hne : ∀ j ∉ S, (Λ j).1 ≠ μ)
    {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ L) (hxw : x ∈ weightSpace R v _ μ)
    (he : ∀ i, eDS hvt hR Λ i x ∈ ϖ • L) : projDS Λ (fun j ↦ j ∉ S) x ∈ ϖ • L := by
  set y := projDS Λ (fun j ↦ j ∉ S) x with hy
  have hyoff : ∀ j ∈ S, y j = 0 := fun j hj ↦ by
    rw [hy, projDS_apply]
    simp [hj]
  have hyL : y ∈ dsSum hvt hR A Λ := (hoff y hyoff).1 (projDS_notMem_mem hPS hx)
  have hyw : y ∈ weightSpace R v _ μ := map_mem_weightSpace (projDS Λ _) hxw
  have hey : ∀ i, eDS hvt hR Λ i y ∈ ϖ • dsSum hvt hR A Λ := by
    intro i
    have hoff' : ∀ j ∈ S, eDS hvt hR Λ i y j = 0 := fun j hj ↦ by
      rw [eDS_apply, hyoff j hj, map_zero]
    refine (mem_smul_iff_mem_smul_dsSum hPS hoff hoff').1 ?_
    rw [hy, eDS_projDS]
    exact map_mem_smul_of_mem' (f := (projDS Λ (fun j ↦ j ∉ S)).restrictScalars k)
      (fun m hm ↦ projDS_notMem_mem hPS hm) (he i)
  refine (mem_smul_iff_mem_smul_dsSum hPS hoff hyoff).2 ((mem_smul_dsSum Λ).2 fun j ↦ ?_)
  by_cases hj : j ∈ S
  · rw [hyoff j hj]
    exact zero_mem _
  · exact mem_smul_lat_of_eK_of_ne hinj hϖ hϖv hk hfund (Λ j) (hne j hj).symm
      ((mem_dsSum Λ).1 hyL j)
      (map_mem_weightSpace (DFinsupp.lapply (R := QuantumGroup R v) j) hyw)
      fun i ↦ eDS_apply Λ i y j ▸ (mem_smul_dsSum Λ).1 (hey i) j

omit [DecidableEq J] in
include hinj hϖ hϖv hk hfund hPS hoff in
/-- Let `λ_{j₀}` be maximal among the `λⱼ`, `j ∈ S`, and different from the `λⱼ`, `j ∉ S`. A vector
`x ∈ L` of weight `λ_{j₀}` whose class lies in `B` has its components in `S` or its components
outside `S` in `ϖ L`. -/
lemma projDS_mem_smul_or {j₀ : J}
    (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
    (hne : ∀ j ∉ S, (Λ j).1 ≠ (Λ j₀).1) (hB : IsCrystalBase hL ϖ B)
    {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ L)
    (hxw : x ∈ weightSpace R v _ (Λ j₀).1)
    (hxB : (Submodule.Quotient.mk (⟨x, hx⟩ : L) : QDS L ϖ) ∈ B) :
    projDS Λ (· ∈ S) x ∈ ϖ • L ∨ projDS Λ (fun j ↦ j ∉ S) x ∈ ϖ • L := by
  by_cases h : ∀ i, eDS hvt hR Λ i x ∈ ϖ • L
  · exact Or.inr (projDS_notMem_mem_smul_of_eDS_mem hinj hϖ hϖv hk hfund hPS hoff hne hx hxw h)
  · push Not at h
    obtain ⟨i, hi⟩ := h
    exact Or.inl (projDS_mem_smul_of_eDS_notMem hPS hmax hB hx hxw hxB hi)

omit [IsDomain A] [IsDiscreteValuationRing A] in
/-- The automorphism of `exists_normalize`, given a `k`-basis `u` of `span(v_{λⱼ}, j ∈ T)` made of
vectors of `L` with classes in `B`, whose `A`-span contains `L ∩ span(v_{λⱼ}, j ∈ T)`. -/
lemma exists_normalize_of_family {μ : Y →+ ℤ} {T : Finset J} (hT : ∀ j ∈ T, (Λ j).1 = μ)
    {ι : Type*} (u : ι → Π₀ j, IrreducibleModule R v (Λ j).1) (hu_mem : ∀ b, u b ∈ L)
    (hu_hw : ∀ b, u b ∈ hwSpan v Λ T)
    (hu_B : ∀ b, (Submodule.Quotient.mk (⟨u b, hu_mem b⟩ : L) : QDS L ϖ) ∈ B)
    (hlik : LinearIndependent k u)
    (hspank : ∀ y ∈ hwSpan v Λ T, y ∈ Submodule.span k (Set.range u))
    (hW : ∀ y ∈ L, y ∈ hwSpan v Λ T → y ∈ Submodule.span A (Set.range u)) :
    ∃ g : hwSpan v Λ T ≃ₗ[k] hwSpan v Λ T,
      (∀ j ∈ T, ∃ h : autEquiv hvt hR Λ hT g
          (DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1)) ∈ L,
        (Submodule.Quotient.mk (⟨_, h⟩ : L) : QDS L ϖ) ∈ B) ∧
      ∀ x ∈ L, x ∈ hwSpan v Λ T → (autEquiv hvt hR Λ hT g).symm x ∈ dsSum hvt hR A Λ := by
  have key := exists_hwSpan_equiv (hvt := hvt) (hR := hR) (Λ := Λ) (T := T) (ι := ι) (u := u)
    hu_hw hlik hspank
  refine key.elim fun e he ↦ he.elim fun g hg ↦ ?_
  obtain ⟨hg, hgs⟩ := hg
  refine ⟨g, fun j hj ↦ ?_, fun y hyL hyT ↦ ?_⟩
  · have heq : autEquiv hvt hR Λ hT g (DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1)) =
        u (e ⟨j, hj⟩) := by
      rw [autEquiv_apply, autMap_single_hwv hT _ hj]
      exact hg j hj
    exact exists_mem_mk_mem (L := L) (B := B) heq (hu_mem _) (hu_B _)
  · let φ := ((autMap hvt hR Λ hT g.symm.toLinearMap).restrictScalars k).restrictScalars A
    have hle : Submodule.span A (Set.range u) ≤ (dsSum hvt hR A Λ).comap φ := by
      rw [Submodule.span_le]
      rintro _ ⟨b, rfl⟩
      change autMap hvt hR Λ hT g.symm.toLinearMap (u b) ∈ dsSum hvt hR A Λ
      rw [autMap_eq hT _ (hu_hw b)]
      change (g.symm ⟨u b, hu_hw b⟩ : Π₀ j, IrreducibleModule R v (Λ j).1) ∈ _
      rw [hgs b]
      exact single_hwv_mem_dsSum Λ _
    rw [autEquiv_symm_apply]
    exact hle (hW y hyL hyT)

omit [Finite I] in
include hinj hϖ hϖv hk hPS in
/-- Let `λ = λ_{j₀}` be maximal among the `λⱼ`, `j ∈ S`, and let `x b ∈ L` be lifts of weight
vectors of the elements `b ∈ B`. The vectors of `L` in the span of the `v_{λⱼ}`, `j ∈ T`, lie in the
`A`-span of the components in `S` of those lifts of weight `λ` whose components in `S` are not in
`ϖ L` (by Nakayama's lemma). -/
lemma le_span_of_maximal {j₀ : J}
    [FiniteDimensional k (weightSpace R v (Π₀ j, IrreducibleModule R v (Λ j).1) (Λ j₀).1)]
    (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
    (hB : IsCrystalBase hL ϖ B) {T : Finset J}
    (hT : ∀ j ∈ T, (Λ j).1 = (Λ j₀).1) (hTS : ∀ j ∈ S, (Λ j).1 = (Λ j₀).1 → j ∈ T)
    (hTsub : ∀ j ∈ T, j ∈ S) (x : B → L)
    (hxw : ∀ b, (x b : Π₀ j, IrreducibleModule R v (Λ j).1) ∈ weightSpace R v _ (hB.wt b))
    (hxb : ∀ b, Submodule.Quotient.mk (x b) = b.1) :
    L ⊓ (hwSpan v Λ T).restrictScalars A ≤ Submodule.span A (Set.range fun
      b : {b : B // hB.wt b = (Λ j₀).1 ∧ projDS Λ (· ∈ S) (x b).1 ∉ ϖ • L} ↦
        projDS Λ (· ∈ S) (x b.1).1) := by
  classical
  have hv' := pow_ne_one_of_transcendental' hvt
  have : IsFractionRing A k := isFractionRing_of hinj hϖv hk
  have hS : ∀ y : Π₀ j, IrreducibleModule R v (Λ j).1, ∀ j, j ∉ S →
      projDS Λ (· ∈ S) y j = 0 := fun y j hj ↦ by rw [projDS_apply]; simp [hj]
  have hhw : ∀ y : Π₀ j, IrreducibleModule R v (Λ j).1,
      y ∈ weightSpace R v _ (Λ j₀).1 → projDS Λ (· ∈ S) y ∈ hwSpan v Λ T := fun y hy ↦
    mem_hwSpan_of_mem_weightSpace (hvt := hvt) (hR := hR) hmax hTS
      (map_mem_weightSpace (projDS Λ (· ∈ S)) hy) (hS y)
  let ι := {b : B // hB.wt b = (Λ j₀).1 ∧ projDS Λ (· ∈ S) (x b).1 ∉ ϖ • L}
  let u : ι → Π₀ j, IrreducibleModule R v (Λ j).1 := fun b ↦ projDS Λ (· ∈ S) (x b.1).1
  have hu_hw : ∀ b, u b ∈ hwSpan v Λ T := fun b ↦ hhw _ (by have := hxw b.1; rwa [b.2.1] at this)
  set W : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1) :=
    L ⊓ (hwSpan v Λ T).restrictScalars A with hW
  have hsmulW : ∀ z ∈ ϖ • L, z ∈ hwSpan v Λ T → z ∈ (Ideal.span {ϖ} : Ideal A) • W := by
    intro z hz hzT
    obtain ⟨z', hz', rfl⟩ := (Submodule.mem_smul_pointwise_iff_exists _ _ _).1 hz
    have hz'T : z' ∈ hwSpan v Λ T := by
      have : z' = v • (ϖ • z') := by
        rw [← algebraMap_smul k ϖ z', hϖv, smul_smul, mul_inv_cancel₀ (NeZero.ne v), one_smul]
      rw [this]
      exact Submodule.smul_mem _ v hzT
    exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self ϖ) ⟨hz', hz'T⟩
  let P : Module.End k (Π₀ j, IrreducibleModule R v (Λ j).1) :=
    (projDS Λ (· ∈ S)).restrictScalars k ∘ₗ weightSetProj hv' (isIntDS hvt hR Λ) {(Λ j₀).1}
  have hPL : ∀ m ∈ L, P m ∈ L := fun m hm ↦ hPS _ (hL.weightSetProj_mem _ m hm)
  have hPx : ∀ b : B, P (x b) = if hB.wt b = (Λ j₀).1 then projDS Λ (· ∈ S) (x b).1 else 0 :=
    fun b ↦ by
      simp only [P, LinearMap.comp_apply, weightSetProj_of_mem hv' _ _ (hxw b),
        Set.mem_singleton_iff]
      split_ifs <;> simp
  have hW_le : W ≤ Submodule.span A (Set.range u) := by
    have hfg : W.FG := Submodule.FG.of_le (hL.fg_latticeWeightSpace (Λ j₀).1)
      fun w hw ↦ ⟨hw.1, mem_weightSpace_of_mem_hwSpan hT hw.2⟩
    refine Submodule.le_of_le_smul_of_le_jacobson_bot hfg
      (I := Ideal.span {ϖ}) ?_ fun w hw ↦ ?_
    · rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top, Ideal.span_le,
        Set.singleton_subset_iff]
      exact hϖ
    obtain ⟨n, a, g, hsum⟩ := hB.exists_sub_sum_mem x hxb ⟨w, hw.1⟩
    let d : B → Π₀ j, IrreducibleModule R v (Λ j).1 := fun b ↦
      if h : hB.wt b = (Λ j₀).1 ∧ projDS Λ (· ∈ S) (x b).1 ∉ ϖ • L then u ⟨b, h⟩ else 0
    have hd : ∀ b, d b ∈ Submodule.span A (Set.range u) := fun b ↦ by
      simp only [d]
      split_ifs with h
      · exact Submodule.subset_span ⟨_, rfl⟩
      · exact zero_mem _
    have hdhw : ∀ b, d b ∈ hwSpan v Λ T := fun b ↦ by
      simp only [d]
      split_ifs with h
      · exact hu_hw _
      · exact zero_mem _
    have he : ∀ b, P (x b) - d b ∈ ϖ • L := fun b ↦ by
      rw [hPx]
      simp only [d]
      by_cases h1 : hB.wt b = (Λ j₀).1
      · by_cases h2 : projDS Λ (· ∈ S) (x b).1 ∈ ϖ • L
        · rw [ite_eq_left_of_eq_true _ _ (eq_true h1),
            dite_eq_right_of_eq_false (eq_false fun h ↦ h.2 h2), sub_zero]
          exact h2
        · rw [ite_eq_left_of_eq_true _ _ (eq_true h1), dite_eq_left_of_eq_true (eq_true ⟨h1, h2⟩),
            sub_self]
          exact zero_mem _
      · rw [ite_eq_right_of_eq_false _ _ (eq_false h1),
          dite_eq_right_of_eq_false (eq_false fun h ↦ h1 h.1), sub_zero]
        exact zero_mem _
    have hPw : P w = w := by
      simp only [P, LinearMap.comp_apply,
        weightSetProj_of_mem hv' _ _ (mem_weightSpace_of_mem_hwSpan hT hw.2),
        Set.mem_singleton_iff, ↓reduceIte]
      exact projDS_eq_self_of_mem_hwSpan _ (fun j hj ↦ hTsub j hj) hw.2
    have h1 := map_mem_smul_of_mem' (f := P) hPL hsum
    rw [map_sub, map_sum, hPw] at h1
    simp only [LinearMap.map_smul_of_tower] at h1
    set z := w - ∑ i, a i • d (g i) with hz
    have hzL : z ∈ ϖ • L := by
      have : z = (w - ∑ i, a i • P (x (g i))) + ∑ i, a i • (P (x (g i)) - d (g i)) := by
        rw [hz]; simp only [smul_sub, Finset.sum_sub_distrib]; abel
      rw [this]
      exact add_mem h1 (Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (he _))
    have hzT : z ∈ hwSpan v Λ T :=
      sub_mem hw.2 (Submodule.sum_mem _ fun i _ ↦ Submodule.smul_of_tower_mem _ _ (hdhw _))
    refine Submodule.mem_sup.2 ⟨∑ i, a i • d (g i),
      Submodule.sum_mem _ fun i _ ↦ Submodule.smul_mem _ _ (hd _), z, hsmulW z hzL hzT, ?_⟩
    rw [hz]; abel
  exact hW_le

include hinj hϖ hϖv hk hfund hPS hoff in
/-- Normalization of the highest weight vectors of maximal weight. Let `λ = λ_{j₀}` be maximal
among the `λⱼ`, `j ∈ S`, and different from the `λⱼ`, `j ∉ S`, and let `T` be the set of `j ∈ S`
with `λⱼ = λ`. There is a `k`-linear automorphism `g` of the span of the `v_{λⱼ}`, `j ∈ T`, such
that the induced automorphism of `⊕ⱼ V(λⱼ)` maps each `v_{λⱼ}`, `j ∈ T`, to a vector of `L` whose
class lies in `B`, and maps `⊕ⱼ L(λⱼ)` onto the vectors of `L` in that span (cf. the proof of
[HK] Thm. 5.2.1). -/
theorem exists_normalize {j₀ : J}
    [FiniteDimensional k (weightSpace R v (Π₀ j, IrreducibleModule R v (Λ j).1) (Λ j₀).1)]
    (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
    (hne : ∀ j ∉ S, (Λ j).1 ≠ (Λ j₀).1) (hB : IsCrystalBase hL ϖ B) {T : Finset J}
    (hT : ∀ j ∈ T, (Λ j).1 = (Λ j₀).1) (hTS : ∀ j ∈ S, (Λ j).1 = (Λ j₀).1 → j ∈ T)
    (hTsub : ∀ j ∈ T, j ∈ S) :
    ∃ g : hwSpan v Λ T ≃ₗ[k] hwSpan v Λ T,
      (∀ j ∈ T, ∃ h : autEquiv hvt hR Λ hT g
          (DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1)) ∈ L,
        (Submodule.Quotient.mk (⟨_, h⟩ : L) : QDS L ϖ) ∈ B) ∧
      ∀ x ∈ L, x ∈ hwSpan v Λ T → (autEquiv hvt hR Λ hT g).symm x ∈ dsSum hvt hR A Λ := by
  classical
  have hv' := pow_ne_one_of_transcendental' hvt
  have hc : ¬IsUnit ϖ := not_isUnit_ϖ hϖ
  have : FaithfulSMul A k := (faithfulSMul_iff_algebraMap_injective A k).2 hinj
  have : IsFractionRing A k := isFractionRing_of hinj hϖv hk
  have : Module.IsTorsionFree A (Π₀ j, IrreducibleModule R v (Λ j).1) :=
    Module.IsTorsionFree.trans_faithfulSMul A k _
  choose x hxw hxb using hB.exists_mk_eq
  -- supports and weights
  have hS : ∀ y : Π₀ j, IrreducibleModule R v (Λ j).1, ∀ j, j ∉ S →
      projDS Λ (· ∈ S) y j = 0 := fun y j hj ↦ by rw [projDS_apply]; simp [hj]
  have hhw : ∀ y : Π₀ j, IrreducibleModule R v (Λ j).1,
      y ∈ weightSpace R v _ (Λ j₀).1 → projDS Λ (· ∈ S) y ∈ hwSpan v Λ T := fun y hy ↦
    mem_hwSpan_of_mem_weightSpace (hvt := hvt) (hR := hR) hmax hTS
      (map_mem_weightSpace (projDS Λ (· ∈ S)) hy) (hS y)
  -- the lifts of the elements of `B` of weight `λ` with a nonzero component in `S`
  let ι := {b : B // hB.wt b = (Λ j₀).1 ∧ projDS Λ (· ∈ S) (x b).1 ∉ ϖ • L}
  let u : ι → Π₀ j, IrreducibleModule R v (Λ j).1 := fun b ↦ projDS Λ (· ∈ S) (x b.1).1
  have hu_mem : ∀ b, u b ∈ L := fun b ↦ hPS _ (x b.1).2
  have hxw' : ∀ b : ι, ((x b.1).1 : Π₀ j, IrreducibleModule R v (Λ j).1) ∈
      weightSpace R v _ (Λ j₀).1 := fun b ↦ by have := hxw b.1; rwa [b.2.1] at this
  have hu_hw : ∀ b, u b ∈ hwSpan v Λ T := fun b ↦ hhw _ (hxw' b)
  have hu_mk : ∀ b, (Submodule.Quotient.mk (⟨u b, hu_mem b⟩ : L) : QDS L ϖ) = b.1.1 := by
    intro b
    have hxB : (Submodule.Quotient.mk (⟨(x b.1).1, (x b.1).2⟩ : L) : QDS L ϖ) ∈ B := by
      rw [Subtype.coe_eta, hxb]; exact b.1.2
    have h := (projDS_mem_smul_or hinj hϖ hϖv hk hfund hPS hoff hmax hne hB (x b.1).2
      (hxw' b) hxB).resolve_left b.2.2
    rw [← hxb b.1]
    refine (IntegrableSl2.mk_eq_mk_iff ϖ _ _).2 ?_
    have h2 := projDS_add_projDS_not Λ (· ∈ S) (x b.1).1
    have h3 : u b - (x b.1).1 = -projDS Λ (fun j ↦ ¬j ∈ S) (x b.1).1 := by
      calc u b - (x b.1).1 = u b - (projDS Λ (· ∈ S) (x b.1).1 +
            projDS Λ (fun j ↦ ¬j ∈ S) (x b.1).1) := by rw [h2]
        _ = _ := by simp only [u]; abel
    rw [h3]
    exact neg_mem h
  have hliA : LinearIndependent A u :=
    hB.linearIndependent_of_mk hc u hu_mem (fun b ↦ b.1) Subtype.val_injective hu_mk
  have hlik : LinearIndependent k u := (LinearIndependent.iff_fractionRing A k).1 hliA
  -- `L ∩ span(v_{λⱼ}, j ∈ T)` is the `A`-span of the `u b`
  have hW_le := le_span_of_maximal (hvt := hvt) (hR := hR) hinj hϖ hϖv hk hPS hmax hB hT hTS hTsub
    x hxw hxb
  have hspank : ∀ y ∈ hwSpan v Λ T, y ∈ Submodule.span k (Set.range u) := by
    intro y hy
    obtain ⟨a, ha, hay⟩ := exists_smul_mem_of_span_eq_top hL.span_eq_top y
    have h2 : a • y ∈ Submodule.span k (Set.range u) :=
      Submodule.span_le_restrictScalars A k _
        (hW_le ⟨hay, Submodule.smul_of_tower_mem _ a hy⟩)
    have ha' : algebraMap A k a ≠ 0 := (map_ne_zero_iff _ hinj).2 ha
    have : y = (algebraMap A k a)⁻¹ • (a • y) := by
      rw [← algebraMap_smul k a y, smul_smul, inv_mul_cancel₀ ha', one_smul]
    rw [this]
    exact Submodule.smul_mem _ _ h2
  have hu_B : ∀ b, (Submodule.Quotient.mk (⟨u b, hu_mem b⟩ : L) : QDS L ϖ) ∈ B := fun b ↦
    (congrArg (· ∈ B) (hu_mk b)).mpr b.1.2
  have hWu : ∀ y ∈ L, y ∈ hwSpan v Λ T → y ∈ Submodule.span A (Set.range u) :=
    fun y hyL hyT ↦ hW_le ⟨hyL, hyT⟩
  exact exists_normalize_of_family hT u hu_mem hu_hw hu_B hlik hspank hWu

end Split

end GrandLoop

end LieLean.QuantumGroup

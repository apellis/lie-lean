import LieLean.Algebra.QuantumGroup.CrystalBasis.GrandLoop.DirectSumNormalize

/-!
# Splitting a crystal base of `⊕ⱼ V(λⱼ)` along the summands

Let `N = ⊕ⱼ V(λⱼ)` be a direct sum of irreducible highest weight modules `V(λ) = L_q(λ)` with
dominant highest weights, and let `(L, B)` be a crystal base of `N`. This file contains the step of
the proof of the uniqueness theorem for crystal bases ([HK] Thm. 5.2.1) which splits off the
summands of a maximal highest weight, and the identification of crystal bases once the lattices are
identified. The theorem itself is in `CrystalBaseUniqueness.lean`.

## Main definitions

* `GrandLoop.pullback L Φ`: the preimage of an `A`-submodule `L` of `N` under an automorphism `Φ`;
  with `GrandLoop.pullbackBase` it carries crystal bases to crystal bases.
* `GrandLoop.IsLatticeIso L B Φ`: the automorphism `Φ` maps `⊕ⱼ L(λⱼ)` onto `L` and every
  `v_{λⱼ}` to a vector whose class lies in `B`.
* `GrandLoop.IsSplit S L B`: `(L, B)` agrees with `(⊕ⱼ L(λⱼ), ⊔ⱼ B(λⱼ))` outside a set `S` of
  summands.
* `GrandLoop.dsBase`: the crystal base `⊔ⱼ B(λⱼ)` of `⊕ⱼ L(λⱼ)`.

## Main results

* `GrandLoop.IsSplit.exists_pullback`: one step of the proof of [HK] Thm. 5.2.1. It applies
  `GrandLoop.exists_normalize` to the summands of a maximal highest weight among those in `S` and
  pulls `(L, B)` back along the resulting automorphism. The set `S` may be infinite.
* `GrandLoop.IsLatticeIso.mem_dsBase_iff`: once the lattices are identified, so are the crystal
  bases (`B(λ)` is generated by `v_λ` under the `f̃ᵢ`).

The setting is that of the grand loop: `k = A[ϖ⁻¹]` for a discrete valuation ring `A` with
`ϖ ↦ v⁻¹`, `v` transcendental, and the root datum has fundamental weights.

## Implementation notes

The proof follows the strategy of [HK]: split off the summands of a maximal highest weight. The
splitting is realized by an automorphism of `N` and projections onto summands
(`DirectSumNormalize.lean`); the details are ours.

## References

* [HK] J. Hong, S.-J. Kang, *Introduction to quantum groups and crystal bases*, GSM 42, §5.2.
-/

open Pointwise

noncomputable section

namespace LieLean.QuantumGroup

namespace GrandLoop

variable {k I Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] {D : LusztigCartanDatum I}
  {R : D.RootDatum Y} {v : k} [NeZero v] [CharZero k]
  {hvt : Transcendental ℚ v} {hR : R.IsXRegular} {A : Type*} [CommRing A] [Algebra A k] {ϖ : A}
  {J : Type*} {Λ : J → Dom R}

/-! ### Pulling back a crystal base along an automorphism -/

section Pullback

variable (L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1))
  (Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
    Π₀ j, IrreducibleModule R v (Λ j).1)

/-- The preimage `Φ⁻¹(L)` of an `A`-submodule `L` of `⊕ⱼ V(λⱼ)` under an automorphism `Φ`. -/
def pullback : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1) :=
  L.comap (((Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) →ₗ[QuantumGroup R v]
    Π₀ j, IrreducibleModule R v (Λ j).1).restrictScalars k).restrictScalars A)

omit [NeZero v] [CharZero k] in
lemma mem_pullback {x : Π₀ j, IrreducibleModule R v (Λ j).1} : x ∈ pullback L Φ ↔ Φ x ∈ L :=
  Iff.rfl

omit [NeZero v] [CharZero k] in
lemma mem_pullback_symm (x : Π₀ j, IrreducibleModule R v (Λ j).1) :
    x ∈ L ↔ Φ.symm x ∈ pullback L Φ := by
  rw [mem_pullback, Φ.apply_symm_apply]

variable {L}

/-- The preimage of a crystal lattice is a crystal lattice. -/
lemma isCrystalLattice_pullback
    (hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) L) :
    IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) (pullback L Φ) :=
  hL.of_equiv (isIntDS hvt hR Λ) Φ.symm (mem_pullback_symm L Φ)

variable (L) in
/-- The image of `B ⊆ L / ϖL` in `Φ⁻¹(L) / ϖΦ⁻¹(L)`. -/
def pullbackBase (B : Set (QDS L ϖ)) : Set (QDS (pullback L Φ) ϖ) :=
  IntegrableSl2.quotEquiv (Φ.symm.restrictScalars k) (mem_pullback_symm L Φ) ϖ '' B

/-- The preimage of a crystal base is a crystal base. -/
lemma isCrystalBase_pullback
    {hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) L}
    {B : Set (QDS L ϖ)} (hB : IsCrystalBase hL ϖ B) :
    IsCrystalBase (isCrystalLattice_pullback (hvt := hvt) (hR := hR) Φ hL) ϖ
      (pullbackBase L Φ B) :=
  hB.of_equiv (isIntDS hvt hR Λ) Φ.symm (mem_pullback_symm L Φ) fun _ ↦
    (Function.Injective.mem_set_image
      (IntegrableSl2.quotEquiv (Φ.symm.restrictScalars k) (mem_pullback_symm L Φ) ϖ).injective).symm

omit [NeZero v] [CharZero k] in
lemma mk_mem_pullbackBase_iff {B : Set (QDS L ϖ)} {y : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hy : y ∈ pullback L Φ) :
    (Submodule.Quotient.mk (⟨y, hy⟩ : pullback L Φ) : QDS (pullback L Φ) ϖ) ∈
      pullbackBase L Φ B ↔ (Submodule.Quotient.mk (⟨Φ y, hy⟩ : L) : QDS L ϖ) ∈ B := by
  have h : (Submodule.Quotient.mk (⟨y, hy⟩ : pullback L Φ) : QDS (pullback L Φ) ϖ) =
      IntegrableSl2.quotEquiv (Φ.symm.restrictScalars k) (mem_pullback_symm L Φ) ϖ
        (Submodule.Quotient.mk (⟨Φ y, hy⟩ : L)) := by
    exact congrArg Submodule.Quotient.mk (Subtype.ext (Φ.symm_apply_apply y).symm)
  rw [h, pullbackBase, Function.Injective.mem_set_image
    (IntegrableSl2.quotEquiv (Φ.symm.restrictScalars k) (mem_pullback_symm L Φ) ϖ).injective]

variable [DecidableEq J]

variable (hvt hR) in
/-- `Φ` identifies `⊕ⱼ L(λⱼ)` with `L`, and maps the highest weight vectors `v_{λⱼ}` to vectors
whose classes lie in `B`. -/
def IsLatticeIso (L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)) (B : Set (QDS L ϖ))
    (Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
      Π₀ j, IrreducibleModule R v (Λ j).1) : Prop :=
  (∀ x, x ∈ dsSum hvt hR A Λ ↔ Φ x ∈ L) ∧
    ∀ j, ∃ h : Φ (DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1)) ∈ L,
      (Submodule.Quotient.mk (⟨_, h⟩ : L) : QDS L ϖ) ∈ B

lemma IsLatticeIso.trans {B : Set (QDS L ϖ)}
    {Φ' : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
      Π₀ j, IrreducibleModule R v (Λ j).1}
    (h : IsLatticeIso hvt hR (pullback L Φ) (pullbackBase L Φ B) Φ') :
    IsLatticeIso hvt hR L B (Φ'.trans Φ) :=
  ⟨fun x ↦ h.1 x, fun j ↦ (h.2 j).elim fun h1 h2 ↦ ⟨h1, (mk_mem_pullbackBase_iff Φ h1).1 h2⟩⟩

end Pullback


/-! ### One step of the induction -/

section Step

variable [DecidableEq J] {S : Set J} [DecidablePred (· ∈ S)] {T : Finset J}
  {Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
    Π₀ j, IrreducibleModule R v (Λ j).1}
  (hΦS : ∀ x, Φ (projDS Λ (· ∈ S) x) = projDS Λ (· ∈ S) (Φ x))
  (hΦn : ∀ x, Φ (projDS Λ (fun j ↦ j ∉ S) x) = projDS Λ (fun j ↦ j ∉ S) x)

omit [NeZero v] [CharZero k] [DecidableEq J] in
include hΦS hΦn in
/-- An automorphism commuting with the projection onto the summands in `S` and fixing the vectors
supported outside `S` does not change the components outside `S`. -/
lemma projDS_not_map_eq (x : Π₀ j, IrreducibleModule R v (Λ j).1) :
    projDS Λ (fun j ↦ j ∉ S) (Φ x) = projDS Λ (fun j ↦ j ∉ S) x := by
  have h := projDS_add_projDS_not Λ (· ∈ S) x
  conv_lhs => rw [← h, map_add, hΦS, hΦn]
  ext j
  simp only [map_add, DFinsupp.add_apply, projDS_apply]
  by_cases hj : j ∈ S <;> simp [hj]

variable {L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)}
  (hPS : ∀ x ∈ L, projDS Λ (· ∈ S) x ∈ L)

omit [NeZero v] [CharZero k] [DecidableEq J] in
include hΦS hPS in
lemma projDS_mem_pullback {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ pullback L Φ) :
    projDS Λ (· ∈ S) x ∈ pullback L Φ := by
  rw [mem_pullback, hΦS]
  exact hPS _ hx

omit [NeZero v] [CharZero k] [DecidableEq J] in
include hΦS hΦn hPS in
lemma projDS_not_mem_pullback {x : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hx : x ∈ pullback L Φ) : projDS Λ (fun j ↦ j ∉ S) x ∈ pullback L Φ := by
  rw [mem_pullback, hΦn, ← projDS_not_map_eq hΦS hΦn]
  exact projDS_notMem_mem hPS hx

/-- An `A`-submodule of `⊕ⱼ V(λⱼ)` stable under the `f̃ᵢ` and containing `v_{λⱼ}` in the `j`-th
summand for `j ∈ T` contains the components in `T` of the vectors of `⊕ⱼ L(λⱼ)`. -/
lemma projDS_mem_of_kashiwaraF_stable (L' : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1))
    (hF : ∀ i, ∀ x ∈ L', fDS hvt hR Λ i x ∈ L')
    (hv : ∀ j ∈ T, DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ L')
    {x : Π₀ j, IrreducibleModule R v (Λ j).1} (hx : x ∈ dsSum hvt hR A Λ) :
    projDS Λ (· ∈ T) x ∈ L' := by
  induction x using DFinsupp.induction with
  | h0 => rw [map_zero]; exact zero_mem _
  | ha j b f hf _ ih =>
    have hx' := (mem_dsSum Λ).1 hx
    have hb : b ∈ lat hvt hR A (Λ j) := by simpa [hf] using hx' j
    rw [map_add]
    refine add_mem ?_ (ih ((mem_dsSum Λ).2 fun l ↦ ?_))
    · rw [DFinsupp.filterLinearMap_apply, DFinsupp.filter_single]
      split_ifs with h
      · exact single_mem_of_kashiwaraF_stable Λ L' hF (hv j h) hb
      · exact zero_mem _
    · by_cases hl : l = j
      · subst hl; rw [hf]; exact zero_mem _
      · simpa [DFinsupp.single_apply, Ne.symm hl] using hx' l

variable [Finite I] [IsDomain A] [IsDiscreteValuationRing A]
  (hinj : Function.Injective (algebraMap A k)) (hϖ : ϖ ∈ IsLocalRing.maximalIdeal A)
  (hϖv : algebraMap A k ϖ = v⁻¹)
  (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a)
  (hfund : ∀ j : I, ∃ Λ : Dom R, ∀ i, Λ.1 (R.coroot i) = if i = j then 1 else 0)
  {j₀ : J} (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
  (hT : ∀ j ∈ T, (Λ j).1 = (Λ j₀).1) (hTS : ∀ j ∈ S, (Λ j).1 = (Λ j₀).1 → j ∈ T)
  (hTsub : ∀ j ∈ T, j ∈ S)
  (hL' : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) (pullback L Φ))
  (hΦT : ∀ x ∈ hwSpan v Λ T, Φ x ∈ hwSpan v Λ T)
  (hD2 : ∀ x ∈ L, x ∈ hwSpan v Λ T → Φ.symm x ∈ dsSum hvt hR A Λ)

include hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦS hPS hΦT hD2 in
/-- The components in `T` of the vectors of `Φ⁻¹(L)` lie in the `L(λⱼ)` (cf. [HK] Lemma 5.2.2 (2)).
-/
lemma mem_lat_of_mem_pullback {y : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hy : y ∈ pullback L Φ) {j : J} (hj : j ∈ T) : y j ∈ lat hvt hR A (Λ j) := by
  have hv' := pow_ne_one_of_transcendental' hvt
  obtain ⟨s, hs⟩ := exists_finset_eq_sum_weightSetProj hv' (isIntDS hvt hR Λ) y
  rw [hs, DFinsupp.finsetSum_apply]
  refine Submodule.sum_mem _ fun μ _ ↦ mem_lat_of_kashiwaraE_stable hinj hϖ hϖv hk hfund Λ
    (T : Set J) (pullback L Φ) (fun i x hx ↦ hL'.kashiwaraE_mem i x hx) ?_
    (hL'.weightSetProj_mem _ y hy) (weightSetProj_singleton_mem hv' _ μ y) hj
  intro x hx l hl hxw
  have hxS : Φ (projDS Λ (· ∈ S) x) ∈ L := projDS_mem_pullback hΦS hPS hx
  have hw : projDS Λ (· ∈ S) x ∈ hwSpan v Λ T :=
    mem_hwSpan_of_mem_weightSpace (hvt := hvt) (hR := hR) hmax hTS
      (by rw [← hT l hl]; exact map_mem_weightSpace (projDS Λ (· ∈ S)) hxw)
      fun j hj ↦ by rw [projDS_apply]; simp [hj]
  have h := hD2 _ hxS (hΦT _ hw)
  rw [Φ.symm_apply_apply] at h
  have := (mem_dsSum Λ).1 h l
  rwa [projDS_apply, ite_eq_left_of_eq_true _ _ (eq_true (hTsub _ hl))] at this

include hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦS hPS hΦT hD2 in
/-- The components in `T` of a vector of `Φ⁻¹(L)` form a vector of `⊕ⱼ L(λⱼ)`. -/
lemma projDS_mem_dsSum_of_mem_pullback {y : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hy : y ∈ pullback L Φ) : projDS Λ (· ∈ T) y ∈ dsSum hvt hR A Λ := by
  refine (mem_dsSum Λ).2 fun j ↦ ?_
  rw [projDS_apply]
  split_ifs with h
  · exact mem_lat_of_mem_pullback hΦS hPS hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦT hD2 hy h
  · exact zero_mem _

variable (hv : ∀ j ∈ T, DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ pullback L Φ)

include hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦS hPS hΦT hD2 hv in
/-- `Φ⁻¹(L)` is stable under the projection onto the summands in `S \ T`. -/
lemma projDS_sdiff_mem_pullback {x : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hx : x ∈ pullback L Φ) : projDS Λ (· ∈ S \ (T : Set J)) x ∈ pullback L Φ := by
  have h1 := projDS_mem_pullback hΦS hPS hx
  have h2 := projDS_mem_of_kashiwaraF_stable (pullback L Φ)
    (fun i x hx ↦ hL'.kashiwaraF_mem i x hx) hv
    (projDS_mem_dsSum_of_mem_pullback hΦS hPS hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦT
      hD2 hx)
  have e : projDS Λ (· ∈ S \ (T : Set J)) x =
      projDS Λ (· ∈ S) x - projDS Λ (· ∈ T) (projDS Λ (· ∈ T) x) := by
    ext j
    simp only [DFinsupp.sub_apply, projDS_apply, Set.mem_sdiff, Finset.mem_coe]
    by_cases hjT : j ∈ T
    · simp [hjT, hTsub _ hjT]
    · by_cases hjS : j ∈ S <;> simp [hjT, hjS]
  rw [e]
  exact sub_mem h1 h2

variable (hoff : ∀ x : Π₀ j, IrreducibleModule R v (Λ j).1,
    (∀ j ∈ S, x j = 0) → (x ∈ L ↔ x ∈ dsSum hvt hR A Λ))

include hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL' hΦS hΦn hPS hΦT hD2 hv hoff in
/-- For vectors with no components in `S \ T`, `Φ⁻¹(L)` and `⊕ⱼ L(λⱼ)` agree. -/
lemma mem_pullback_iff_of_sdiff {x : Π₀ j, IrreducibleModule R v (Λ j).1}
    (hx0 : ∀ j ∈ S \ (T : Set J), x j = 0) : x ∈ pullback L Φ ↔ x ∈ dsSum hvt hR A Λ := by
  have e : x = projDS Λ (fun j ↦ j ∉ S) x + projDS Λ (· ∈ T) x := by
    ext j
    simp only [DFinsupp.add_apply, projDS_apply]
    by_cases hjT : j ∈ T
    · simp [hjT, hTsub _ hjT]
    · by_cases hjS : j ∈ S
      · simp [hjT, hjS, hx0 j ⟨hjS, hjT⟩]
      · simp [hjT, hjS]
  have hoffn : ∀ z : Π₀ j, IrreducibleModule R v (Λ j).1, ∀ j ∈ S,
      projDS Λ (fun j ↦ j ∉ S) z j = 0 := fun z j hj ↦ by
    rw [projDS_apply]
    simp [hj]
  constructor
  · intro h
    rw [e]
    refine add_mem ?_ (projDS_mem_dsSum_of_mem_pullback hΦS hPS hinj hϖ hϖv hk hfund hmax hT hTS
      hTsub hL' hΦT hD2 h)
    have h' := projDS_not_mem_pullback hΦS hΦn hPS h
    rw [mem_pullback, hΦn] at h'
    exact (hoff _ (hoffn x)).1 h'
  · intro h
    rw [e]
    refine add_mem ?_ (projDS_mem_of_kashiwaraF_stable (pullback L Φ)
      (fun i x hx ↦ hL'.kashiwaraF_mem i x hx) hv h)
    rw [mem_pullback, hΦn]
    refine (hoff _ (hoffn x)).2 ((mem_dsSum Λ).2 fun j ↦ ?_)
    rw [projDS_apply]
    split_ifs
    · exact zero_mem _
    · exact (mem_dsSum Λ).1 h j

end Step

/-! ### Splitting off the summands of a maximal highest weight -/

section Split

variable [DecidableEq J]

variable (hvt hR) in
/-- A crystal base `(L, B)` of `⊕ⱼ V(λⱼ)` *agrees with `(⊕ⱼ L(λⱼ), ⊔ⱼ B(λⱼ))` outside a set `S` of
summands*: `L` is stable under the projection onto the summands in `S`, `L` and `⊕ⱼ L(λⱼ)` contain
the same vectors without components in `S`, the classes of the `v_{λⱼ}`, `j ∉ S`, lie in `B`, and
the `λⱼ`, `j ∉ S`, differ from the `λⱼ`, `j ∈ S`. -/
structure IsSplit (S : Set J) [DecidablePred (· ∈ S)]
    (L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)) (B : Set (QDS L ϖ)) : Prop where
  projDS_mem : ∀ x ∈ L, projDS Λ (· ∈ S) x ∈ L
  mem_iff : ∀ x : Π₀ j, IrreducibleModule R v (Λ j).1,
    (∀ j ∈ S, x j = 0) → (x ∈ L ↔ x ∈ dsSum hvt hR A Λ)
  hwv_mem : ∀ j ∉ S, ∃ h : DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ L,
    (Submodule.Quotient.mk (⟨_, h⟩ : L) : QDS L ϖ) ∈ B
  ne : ∀ j ∉ S, ∀ j' ∈ S, (Λ j).1 ≠ (Λ j').1

variable [Finite I] [IsDomain A] [IsDiscreteValuationRing A]
  (hinj : Function.Injective (algebraMap A k)) (hϖ : ϖ ∈ IsLocalRing.maximalIdeal A)
  (hϖv : algebraMap A k ϖ = v⁻¹)
  (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a)
  (hfund : ∀ j : I, ∃ Λ : Dom R, ∀ i, Λ.1 (R.coroot i) = if i = j then 1 else 0)

include hinj hϖ hϖv hk hfund in
/-- One step of the proof of [HK] Thm. 5.2.1: if `(L, B)` agrees with `(⊕ⱼ L(λⱼ), ⊔ⱼ B(λⱼ))`
outside a set `S` of summands, `λ_{j₀}`, `j₀ ∈ S`, is maximal among the `λⱼ`, `j ∈ S`, and `T` is
the set of `j ∈ S` with `λⱼ = λ_{j₀}`, then after the automorphism `GrandLoop.autEquiv g` of the
summands in `T`, the crystal base agrees with `(⊕ⱼ L(λⱼ), ⊔ⱼ B(λⱼ))` outside `S \ T`. -/
theorem IsSplit.exists_pullback {S : Set J} [DecidablePred (· ∈ S)]
    {L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)}
    {hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) L}
    {B : Set (QDS L ϖ)} (hB : IsCrystalBase hL ϖ B) (hS : IsSplit hvt hR S L B) {j₀ : J}
    (hj₀ : j₀ ∈ S) (hmax : ∀ j ∈ S, ∀ ν : I →₀ ℕ, (Λ j).1 = (Λ j₀).1 + R.rootSum ν → ν = 0)
    [FiniteDimensional k (weightSpace R v (Π₀ j, IrreducibleModule R v (Λ j).1) (Λ j₀).1)]
    {T : Finset J} (hT : ∀ j ∈ T, (Λ j).1 = (Λ j₀).1)
    (hTS : ∀ j ∈ S, (Λ j).1 = (Λ j₀).1 → j ∈ T) (hTsub : ∀ j ∈ T, j ∈ S) :
    ∃ g : hwSpan v Λ T ≃ₗ[k] hwSpan v Λ T,
      IsSplit hvt hR (S \ (T : Set J)) (pullback L (autEquiv hvt hR Λ hT g))
        (pullbackBase L (autEquiv hvt hR Λ hT g) B) := by
  have hne : ∀ j ∉ S, (Λ j).1 ≠ (Λ j₀).1 := fun j hj ↦ hS.ne j hj j₀ hj₀
  obtain ⟨g, hg⟩ := exists_normalize hinj hϖ hϖv hk hfund hS.projDS_mem hS.mem_iff hmax hne hB hT
    hTS hTsub
  let Φ := autEquiv hvt hR Λ hT g
  have hΦS : ∀ x, Φ (projDS Λ (· ∈ S) x) = projDS Λ (· ∈ S) (Φ x) := fun x ↦
    (projDS_autMap hT g.toLinearMap (· ∈ S) (fun j hj ↦ hTsub j hj) x).symm
  have hΦn : ∀ x, Φ (projDS Λ (fun j ↦ j ∉ S) x) = projDS Λ (fun j ↦ j ∉ S) x := fun x ↦
    autMap_projDS_of_notMem hT g.toLinearMap (fun j ↦ j ∉ S) (fun j hj h ↦ h (hTsub j hj)) x
  have hΦT : ∀ x ∈ hwSpan v Λ T, Φ x ∈ hwSpan v Λ T := fun x hx ↦
    autMap_mem_hwSpan hT g.toLinearMap hx
  have hD1 := hg.1
  have hD2 : ∀ x ∈ L, x ∈ hwSpan v Λ T → Φ.symm x ∈ dsSum hvt hR A Λ := hg.2
  have hv : ∀ j ∈ T, DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ pullback L Φ :=
    fun j hj ↦ (hD1 j hj).fst
  have hL' := isCrystalLattice_pullback (hvt := hvt) (hR := hR) Φ hL
  have hPS := hS.projDS_mem
  refine ⟨g, fun x hx ↦ projDS_sdiff_mem_pullback hΦS hPS hinj hϖ hϖv hk hfund hmax hT hTS hTsub
      hL' hΦT hD2 hv hx,
    fun x hx0 ↦ mem_pullback_iff_of_sdiff hΦS hΦn hPS hinj hϖ hϖv hk hfund hmax hT hTS hTsub hL'
      hΦT hD2 hv hS.mem_iff hx0, fun j hj ↦ ?_, fun j hj j' hj' ↦ ?_⟩
  · by_cases hjS : j ∈ S
    · have hjT : j ∈ T := by
        by_contra h
        exact hj ⟨hjS, h⟩
      refine (hD1 j hjT).elim fun h1 h2 ↦ ?_
      exact ⟨h1, (mk_mem_pullbackBase_iff Φ h1).2 h2⟩
    · refine (hS.hwv_mem j hjS).elim fun h1 h2 ↦ ?_
      have he : Φ (DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1)) =
          DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) :=
        autMap_single_of_notMem hT g.toLinearMap (fun h ↦ hjS (hTsub j h)) _
      have h1' : DFinsupp.single j (IrreducibleModule.hwv R v (Λ j).1) ∈ pullback L Φ := by
        rw [mem_pullback, he]
        exact h1
      exact ⟨h1', (mk_mem_pullbackBase_iff Φ h1').2
        ((exists_mem_mk_mem he h1 h2).elim fun _ h ↦ h)⟩
  · obtain ⟨hj'S, hj'T⟩ := hj'
    by_cases hjS : j ∈ S
    · have hjT : j ∈ T := by
        by_contra h
        exact hj ⟨hjS, h⟩
      rw [hT j hjT]
      exact fun h ↦ hj'T (hTS j' hj'S h.symm)
    · exact hS.ne j hjS j' hj'S

end Split

/-! ### Identification of the crystal bases -/

section Base

variable [DecidableEq J]

variable (hvt hR A ϖ Λ) in
/-- The crystal base `⊔ⱼ B(λⱼ)` of `⊕ⱼ L(λⱼ)`. -/
abbrev dsBase : Set (QDS (dsSum hvt hR A Λ) ϖ) :=
  dfinsuppBase (fun j ↦ lat hvt hR A (Λ j)) ϖ
    fun j ↦ IrreducibleModule.base hR (pow_ne_one_of_transcendental' hvt) (Λ j).2 A ϖ

lemma single_fW_cons (j : J) (i : I) (w : List I) :
    DFinsupp.single j (fW hvt hR (Λ j) (i :: w)) =
      fDS hvt hR Λ i (DFinsupp.single j (fW hvt hR (Λ j) w)) := by
  rw [single_fW, single_fW]
  rfl

variable [Finite I] [IsDomain A] [IsDiscreteValuationRing A]
  (hinj : Function.Injective (algebraMap A k)) (hϖ : ϖ ∈ IsLocalRing.maximalIdeal A)
  (hϖv : algebraMap A k ϖ = v⁻¹)
  (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a)
  (hfund : ∀ j : I, ∃ Λ : Dom R, ∀ i, Λ.1 (R.coroot i) = if i = j then 1 else 0)
  {L : Submodule A (Π₀ j, IrreducibleModule R v (Λ j).1)}
  {hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) (isIntDS hvt hR Λ) L}
  {B : Set (QDS L ϖ)}

omit [Finite I] [IsDomain A] [IsDiscreteValuationRing A] in
/-- If `Φ` maps `⊕ⱼ L(λⱼ)` onto `L` and the `v_{λⱼ}` to vectors with classes in `B`, then the
class of `Φ(f̃_w v_{λⱼ})` lies in `B ∪ {0}`. -/
lemma IsLatticeIso.mk_mem_or (hB : IsCrystalBase hL ϖ B)
    {Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
      Π₀ j, IrreducibleModule R v (Λ j).1} (h : IsLatticeIso hvt hR L B Φ) (j : J) (w : List I)
    (hw : Φ (DFinsupp.single j (fW hvt hR (Λ j) w)) ∈ L) :
    (Submodule.Quotient.mk (⟨_, hw⟩ : L) : QDS L ϖ) ∈ B ∨
      (Submodule.Quotient.mk (⟨_, hw⟩ : L) : QDS L ϖ) = 0 := by
  have hv' := pow_ne_one_of_transcendental' hvt
  induction w with
  | nil => exact Or.inl ((h.2 j).elim fun _ h2 ↦ h2)
  | cons i w ih =>
    have hw' : Φ (DFinsupp.single j (fW hvt hR (Λ j) w)) ∈ L :=
      (h.1 _).1 (single_mem_dfinsuppLattice (IrreducibleModule.fWord_mem_lattice hR _ (Λ j).2 A w))
    have e : Φ (DFinsupp.single j (fW hvt hR (Λ j) (i :: w))) =
        kashiwaraF R v _ hv' (isIntDS hvt hR Λ) i (Φ (DFinsupp.single j (fW hvt hR (Λ j) w))) := by
      rw [single_fW_cons]
      exact map_kashiwaraF hv' (isIntDS hvt hR Λ) i (isIntDS hvt hR Λ) Φ.toLinearMap _
    have hq : (Submodule.Quotient.mk (⟨_, hw⟩ : L) : QDS L ϖ) =
        hL.fQ ϖ i (Submodule.Quotient.mk (⟨_, hw'⟩ : L)) :=
      congrArg Submodule.Quotient.mk (Subtype.ext e)
    rcases ih hw' with h1 | h1
    · rw [hq]
      exact hB.fQ_mem i _ h1
    · rw [hq, h1, map_zero]
      exact Or.inr rfl

include hinj hϖ hϖv hk hfund in
/-- If `Φ` maps `⊕ⱼ L(λⱼ)` onto `L` and the `v_{λⱼ}` to vectors with classes in `B`, then the
isomorphism `(⊕ⱼ L(λⱼ)) / ϖ(⊕ⱼ L(λⱼ)) ≃ L / ϖL` induced by `Φ` maps `⊔ⱼ B(λⱼ)` onto `B`. -/
theorem IsLatticeIso.mem_dsBase_iff (hB : IsCrystalBase hL ϖ B)
    {Φ : (Π₀ j, IrreducibleModule R v (Λ j).1) ≃ₗ[QuantumGroup R v]
      Π₀ j, IrreducibleModule R v (Λ j).1} (h : IsLatticeIso hvt hR L B Φ)
    (b : QDS (dsSum hvt hR A Λ) ϖ) :
    b ∈ dsBase hvt hR A ϖ Λ ↔ IntegrableSl2.quotEquiv (Φ.restrictScalars k) h.1 ϖ b ∈ B := by
  have hc := not_isUnit_ϖ hϖ
  have : Nontrivial (A ⧸ Ideal.span {ϖ}) :=
    Ideal.Quotient.nontrivial_iff.mpr (by rwa [Ne, Ideal.span_singleton_eq_top])
  set Q := IntegrableSl2.quotEquiv (Φ.restrictScalars k) h.1 ϖ
  have hB₀ := IsCrystalBase.dfinsupp (M := fun j ↦ IrreducibleModule R v (Λ j).1) hc
    fun j ↦ isCrystalBaseHW hvt hR hinj hϖ hϖv hk hfund (Λ j)
  have hB₁ := hB₀.of_equiv (isIntDS hvt hR Λ) Φ h.1 (B' := Q '' dsBase hvt hR A ϖ Λ)
    fun _ ↦ (Q.injective.mem_set_image).symm
  have hsub : Q '' dsBase hvt hR A ϖ Λ ⊆ B := by
    rintro _ ⟨b, hb, rfl⟩
    obtain ⟨j, hbj⟩ := Set.mem_iUnion.1 hb
    obtain ⟨b', ⟨⟨w, rfl⟩, hne⟩, rfl⟩ := hbj
    have hw : Φ (DFinsupp.single j (fW hvt hR (Λ j) w)) ∈ L :=
      (h.1 _).1 (single_mem_dfinsuppLattice (IrreducibleModule.fWord_mem_lattice hR _ (Λ j).2 A w))
    have hQ : Q (dfinsuppQuotIncl _ ϖ j (Submodule.Quotient.mk
        ⟨fW hvt hR (Λ j) w, IrreducibleModule.fWord_mem_lattice hR _ (Λ j).2 A w⟩)) =
        (Submodule.Quotient.mk (⟨_, hw⟩ : L) : QDS L ϖ) := rfl
    rw [hQ]
    refine (h.mk_mem_or hB j w hw).resolve_right fun h0 ↦ hne ?_
    rw [← hQ, map_eq_zero_iff _ Q.injective] at h0
    exact (map_eq_zero_iff _ (dfinsuppQuotIncl_injective _ ϖ j)).1 h0
  have heq := IsCrystalBase.eq_of_subset_of_span_eq_top hsub hB₁.span_eq_top hB.linearIndependent
  rw [← heq, Q.injective.mem_set_image]

end Base

end GrandLoop


import LieLean.Algebra.QuantumGroup.CrystalBasis.GrandLoop.TensorDecomposition
import LieLean.Algebra.QuantumGroup.CrystalBasis.GrandLoop.WeightsAbove
import LieLean.Algebra.QuantumGroup.CrystalBasis.Levi

/-!
# Restriction of `L_q(λ)` to a Levi subalgebra

**[Kas] Prop. 4.3.** For `J ⊆ I` and a dominant weight `λ`, Kashiwara decomposes `V(λ)`, as a
module over the subalgebra `U_q(𝔤_J)` generated by the `eᵢ`, `fᵢ`, `i ∈ J`, and the `q(h)`, as the
direct sum of the `V_J(wt b)` over the elements `b ∈ B(λ)` with `ẽᵢ b = 0` for all `i ∈ J`. Here
`J ⊆ I` is an injection `e : J ↪ I`, `U_q(𝔤_J)` is the image of
`QuantumGroup.leviHom : U(R.comap e) → U(R)`, and `V(λ)` restricted to it is
`QuantumGroup.LeviRestrict R v e (L_q(λ))`.

The proof combines three results:

* the crystal base `(L(λ), B(λ))` of `L_q(λ)` is a crystal base of the restriction, with `ẽⱼ`
  equal to `ẽ_{e j}` and the same weights (`QuantumGroup.IsCrystalBase.leviRestrict`);
* the restriction is integrable, has finite-dimensional weight spaces and finitely many weights
  above each weight (`QuantumGroup.HasFiniteWeightsAbove.leviRestrict`); it is usually not in
  `𝒪_int` of `U(R.comap e)`, since its weights can lie in infinitely many cones `μ - Q_J₊`;
* for such modules the irreducible summands correspond to the highest weight elements of a crystal
  base, with the same weights (`GrandLoop.exists_crystalEquiv_sigma_of_hasFiniteWeightsAbove`;
  [Kas] (4.6)).

## Main results

* `GrandLoop.nonempty_leviRestrict_equiv_dfinsupp`: `L_q(λ) ≅ ⊕_b L_q^J(wt b)` as
  `U(R.comap e)`-modules, the sum over the `b ∈ B(λ)` with `ẽ_{e j} b = 0` for all `j ∈ J`;
  `GrandLoop.nonempty_leviRestrict_equiv_dfinsupp_ratFunc` over `ℚ(v)` with no hypothesis left.

## References

* [Kas] M. Kashiwara, *On crystal bases*, CMS Conf. Proc. 16 (1995), §4.5–4.6.
-/

noncomputable section

open LieLean

namespace LieLean.QuantumGroup

variable {k I J Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] [DecidableEq J]
  {D : LusztigCartanDatum I} {R : D.RootDatum Y} {v : k} {e : J ↪ I}
  {M : Type*} [AddCommGroup M] [Module k M] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M]

/-- The restriction of a module with finitely many weights above each weight has finitely many
weights above each weight: its weights are those of `M`, and `Q_J₊ ⊆ Q₊`. -/
theorem HasFiniteWeightsAbove.leviRestrict (h : HasFiniteWeightsAbove R v M) :
    HasFiniteWeightsAbove (R.comap e) v (LeviRestrict R v e M) := fun Λ ↦ by
  refine ((h Λ).preimage (Finsupp.embDomain_injective e).injOn).subset fun ν hν ↦ ?_
  simp only [Set.mem_preimage, Set.mem_ofPred_eq] at hν ⊢
  rwa [weightSpace_leviRestrict, LusztigCartanDatum.RootDatum.comap_rootSum] at hν

variable [NeZero v] {hv : ∀ n : ℕ, 0 < n → v ^ n ≠ 1} {hM : IsIntegrable R v M}
  {A : Type*} [CommRing A] [Algebra A k] [Module A M] [IsScalarTower A k M]
  {L : Submodule A M} {hL : IsCrystalLattice hv hM L} {c : A}
  {B : Set (L ⧸ (Ideal.span {c} • ⊤ : Submodule A L))}

/-- `ẽⱼ b = 0` in the restricted crystal base iff `ẽ_{e j} b = 0`. -/
lemma IsCrystalBase.leviRestrict_e_eq_none_iff (hB : IsCrystalBase hL c B) (j : J) (b : B) :
    (hB.leviRestrict (e := e)).e j b = none ↔ hB.e (e j) b = none := by
  rw [IsCrystalBase.e_eq_none_iff, IsCrystalBase.e_eq_none_iff, hL.eQ_leviRestrict]

/-- The weights of the restricted crystal base are those of `(L, B)`. -/
lemma IsCrystalBase.wt_leviRestrict (hB : IsCrystalBase hL c B) (hc : ¬IsUnit c) (b : B) :
    (hB.leviRestrict (e := e)).wt b = hB.wt b := by
  obtain ⟨x, hx, hxb⟩ := hB.exists_mk_eq b
  exact (hB.leviRestrict (e := e)).wt_eq hc b x (by rw [weightSpace_leviRestrict]; exact hx) hxb

end LieLean.QuantumGroup

namespace LieLean.QuantumGroup.GrandLoop

variable {k I J Y : Type*} [Field k] [AddCommGroup Y] [DecidableEq I] [DecidableEq J]
  {D : LusztigCartanDatum I} {R : D.RootDatum Y} {v : k} [NeZero v] [CharZero k]
  {hvt : Transcendental ℚ v} {hR : R.IsXRegular} {A : Type*} [CommRing A] [Algebra A k]
  [IsDomain A] [IsDiscreteValuationRing A] [Finite I] {ϖ : A}
  (hinj : Function.Injective (algebraMap A k)) (hϖ : ϖ ∈ IsLocalRing.maximalIdeal A)
  (hϖv : algebraMap A k ϖ = v⁻¹)
  (hk : ∀ c : k, ∃ (m : ℕ) (a : A), algebraMap A k (ϖ ^ m) * c = algebraMap A k a)
  (hfund : ∀ j : I, ∃ Λ : Dom R, ∀ i, Λ.1 (R.coroot i) = if i = j then 1 else 0)
  (e : J ↪ I)

omit [NeZero v] [CharZero k] [Finite I] in
include hfund in
/-- The fundamental weights of `R` restrict to fundamental weights of `R.comap e`. -/
lemma exists_fundamental_comap (j : J) :
    ∃ Λ : Dom (R.comap e), ∀ i, Λ.1 ((R.comap e).coroot i) = if i = j then 1 else 0 := by
  obtain ⟨Λ, hΛ⟩ := hfund (e j)
  refine ⟨⟨Λ.1, fun i ↦ Λ.2 (e i)⟩, fun i ↦ ?_⟩
  simp only [LusztigCartanDatum.RootDatum.comap_coroot, hΛ, e.injective.eq_iff]

section Generic

variable {M : Type*} [AddCommGroup M] [Module k M] [Module (QuantumGroup R v) M]
  [IsScalarTower k (QuantumGroup R v) M] [Module A M] [IsScalarTower A k M]
  {hM : IsIntegrable R v M} {L : Submodule A M}
  {hL : IsCrystalLattice (pow_ne_one_of_transcendental' hvt) hM L}
  {B : Set (L ⧸ (Ideal.span {ϖ} • ⊤ : Submodule A L))}

include hinj hϖ hϖv hk hfund in
/-- **Restriction to a Levi subalgebra** ([Kas] Prop. 4.3, (4.6)) for a module `M` in `𝒪_int` with a
crystal base `(L, B)`: `M ≅ ⊕_b L_q^J(wt b)` as `U(R.comap e)`-modules, the sum running over the
`b ∈ B` with `ẽ_{e j} b = 0` for every `j ∈ J`. -/
theorem nonempty_leviRestrict_equiv_dfinsupp_of_isCategoryOInt (hO : IsCategoryOInt R v M)
    (hB : IsCrystalBase hL ϖ B) :
    Nonempty ((Π₀ b : {b : B // ∀ j, hB.e (e j) b = none},
        IrreducibleModule (R.comap e) v (hB.wt b)) ≃ₗ[QuantumGroup (R.comap e) v]
      LeviRestrict R v e M) := by
  have : Finite J := Finite.of_injective e e.injective
  have hc := not_isUnit_ϖ hϖ
  have hfd : ∀ Λ, FiniteDimensional k (weightSpace (R.comap e) v (LeviRestrict R v e M) Λ) :=
    fun Λ ↦ by
      rw [weightSpace_leviRestrict]
      exact hO.finiteDimensional_weightSpace Λ
  have hab := HasFiniteWeightsAbove.leviRestrict (e := e) (hO.hasFiniteWeightsAbove hR)
  have hB' := hB.leviRestrict (e := e)
  obtain ⟨s, Λ, Φ, hhw, hwt, ⟨Ψ⟩⟩ := exists_crystalEquiv_sigma_of_hasFiniteWeightsAbove
    (hvt := hvt) (hR := hR.comap e) hinj hϖ hϖv hk (exists_fundamental_comap hfund e) hfd hab hB'
  have hC : ∀ b, (hB'.crystal hc).IsHighestWeight b ↔ ∀ j, hB.e (e j) b = none := fun b ↦
    forall_congr' fun j ↦ hB.leviRestrict_e_eq_none_iff j b
  let f : s → {b : B // ∀ j, hB.e (e j) b = none} :=
    fun j ↦ ⟨Φ ⟨j, topHW hvt (hR.comap e) hinj hϖ (Λ j)⟩, (hC _).1 ((hhw _).2 ⟨j, rfl⟩)⟩
  have hf : Function.Bijective f := by
    refine ⟨fun j j' h ↦ ?_, fun b ↦ ?_⟩
    · exact (Sigma.mk.inj_iff.1 (Φ.toEquiv.injective (congrArg Subtype.val h))).1
    · obtain ⟨j, hj⟩ := (hhw b.1).1 ((hC b.1).2 b.2)
      exact ⟨j, Subtype.ext hj.symm⟩
  have hwt' : ∀ j, hB.wt (f j).1 = (Λ j).1 := fun j ↦
    (hB.wt_leviRestrict hc _).symm.trans (hwt j)
  exact ⟨(DFinsupp.domLCongrOfEq (fun Λ' : Y →+ ℤ ↦ IrreducibleModule (R.comap e) v Λ')
    (fun j ↦ (Λ j).1) (fun b ↦ hB.wt b.1) (Equiv.ofBijective f hf) hwt').trans Ψ⟩

end Generic

include hinj hϖ hϖv hk hfund in
/-- **[Kas] Prop. 4.3 (restriction to a Levi subalgebra).** For an injection `e : J ↪ I` and a
dominant `λ`, `L_q(λ) ≅ ⊕_b L_q^J(wt b)` as modules over `U(R.comap e)` (acting through
`leviHom`, whose image is the subalgebra `U_q(𝔤_J)`), the sum running over the elements `b` of the
crystal `B(λ)` of `L_q(λ)` with `ẽ_{e j} b = 0` for every `j ∈ J`. Here `L_q^J(μ)` is the
irreducible highest weight module of `U(R.comap e)`. Kashiwara works over `ℚ(q)`; here `v` is
transcendental over `ℚ` and the crystal bases are taken over a discrete valuation ring `A` with
`k = A[ϖ⁻¹]` and `ϖ ↦ v⁻¹` (the hypotheses of the grand loop). -/
theorem nonempty_leviRestrict_equiv_dfinsupp (μ : Dom R) :
    Nonempty ((Π₀ b : {b // ∀ j, (crystalHW hvt hR hinj hϖ hϖv hk hfund μ).e (e j) b = none},
        IrreducibleModule (R.comap e) v ((crystalHW hvt hR hinj hϖ hϖv hk hfund μ).wt b)) ≃ₗ[
          QuantumGroup (R.comap e) v]
      LeviRestrict R v e (IrreducibleModule R v μ.1)) :=
  nonempty_leviRestrict_equiv_dfinsupp_of_isCategoryOInt hinj hϖ hϖv hk hfund e
    (IrreducibleModule.isCategoryOInt hR (pow_ne_one_of_transcendental' hvt) μ.2)
    (isCrystalBaseHW hvt hR hinj hϖ hϖv hk hfund μ)

end LieLean.QuantumGroup.GrandLoop

/-! ### Kashiwara's setting `ℚ(v)` -/

namespace LieLean.QuantumGroup.GrandLoop

variable {I J : Type*} [Fintype I] [DecidableEq I] [DecidableEq J] {D : LusztigCartanDatum I}

/-- **[Kas] Prop. 4.3** in Kashiwara's setting: `k = ℚ(v)`, `A` the local ring at `v = ∞`,
`ϖ = v⁻¹`, every Cartan datum with finite index set and the root datum
`LusztigCartanDatum.extendedRootDatum`, with no hypothesis left. For an injection `e : J ↪ I` and a
dominant `λ`, `L_q(λ) ≅ ⊕_b L_q^J(wt b)` as `U(R.comap e)`-modules, the sum over the `b ∈ B(λ)`
with `ẽ_{e j} b = 0` for every `j ∈ J`. -/
theorem nonempty_leviRestrict_equiv_dfinsupp_ratFunc (e : J ↪ I) (μ : Dom D.extendedRootDatum) :
    Nonempty ((Π₀ b : {b // ∀ j, (crystalHW transcendental_vInf D.isXRegular_extendedRootDatum
            injective_algebraMap_localRing localX_mem_maximalIdeal algebraMap_localX
            exists_pow_localX_mul D.exists_fundamental_extendedRootDatum μ).e (e j) b = none},
        IrreducibleModule (D.extendedRootDatum.comap e) vInf
          ((crystalHW transcendental_vInf D.isXRegular_extendedRootDatum
            injective_algebraMap_localRing localX_mem_maximalIdeal algebraMap_localX
            exists_pow_localX_mul D.exists_fundamental_extendedRootDatum μ).wt b)) ≃ₗ[
          QuantumGroup (D.extendedRootDatum.comap e) vInf]
      LeviRestrict D.extendedRootDatum vInf e (IrreducibleModule D.extendedRootDatum vInf μ.1)) :=
  nonempty_leviRestrict_equiv_dfinsupp injective_algebraMap_localRing localX_mem_maximalIdeal
    algebraMap_localX exists_pow_localX_mul D.exists_fundamental_extendedRootDatum e μ

end LieLean.QuantumGroup.GrandLoop

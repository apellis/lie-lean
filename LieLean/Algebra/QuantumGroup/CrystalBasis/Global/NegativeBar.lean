import LieLean.Algebra.QuantumGroup.CrystalBasis.Global.BalancedTriple
import LieLean.Algebra.QuantumGroup.CrystalBasis.Integral.Coordinates

/-!
# Bar involution, `ℤ`-form and the lattice `L(∞)⁻` of `U⁻`

Kashiwara's global basis of `U⁻` ([Kas91] §7) is built from the triple
`(U⁻_ℤ, L(∞), L(∞)⁻)`: the `𝒜`-form generated by the divided powers ([Kas91] §6.1), the crystal
lattice at `v = ∞` (in Lusztig's conventions; `q = 0` in Kashiwara's) and its image under the
bar involution. We set these up on the library's model `Um D 𝕧 = 'f ⧸ J` of `U⁻` over
`𝕂 = ℚ(v)`:

* `negBar`: the bar involution of `U⁻` (`v ↦ v⁻¹`, fixing every `fᵢ`), descended from `'f`;
* `negIntegral`: `U⁻_ℤ`, the elements whose image in Lusztig's `f` lies in `𝒜f`
  (`quotientIntegralForm`); it is a module over `𝒜 = ℤ[v, v⁻¹]` (`negLaurentModule`);
* `latInfBar`: `L(∞)⁻ = bar(L(∞))`, a lattice over the local ring `ℚ[v]_{(v)}` at `v = 0`.

## Main results

* `negBar_negBar`, `negBar_smul`, `negativeQuotientEquiv_negBar`: bar is a semilinear
  involution compatible with Lusztig's bar on `f`.
* `negBar_mem_negIntegral`: `U⁻_ℤ` is bar-stable.
* `residueIndependent_latInfBar`: bar carries residue-independent families of `L(∞)` to
  residue-independent families of `L(∞)⁻`.
* `exists_sub_negBar_eq_smul`: for `x ∈ U⁻_ℤ`, `x - x̄ = (v - v⁻¹) y` with `y ∈ U⁻_ℤ`. This is
  the divisibility used in the proof of [Kas91] Lemma 7.3.4; with
  `balanced_eq_of_sub_eq_smul` it gives bar-invariance of the global basis elements.

The divisibility argument (on generators, scalars, sums and products) is our own.

## References

* [Kas91] M. Kashiwara, *On crystal bases of the q-analogue of universal enveloping algebras*,
  Duke Math. J. 63 (1991), 465–516, §6.1 and Lemma 7.3.4.
-/

open Finset Pointwise LusztigF

noncomputable section

namespace LieLean.QuantumGroup

open GrandLoop Sl2.RankOne

local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "hvt" => transcendental_ratFunc_X
local instance : NeZero 𝕧 := ⟨RatFunc.X_ne_zero⟩

variable {I : Type*} [Finite I] [DecidableEq I] (D : LusztigCartanDatum I)

/-! ### The bar involution -/

/-- Coefficient bar as a ring endomorphism of `𝕂`. -/
abbrev barRingHom : 𝕂 →+* 𝕂 := RingHomClass.toRingHom (RatFunc.bar (K := ℚ))

/-- The bar involution of the free algebra `'f`, as a semilinear map. -/
def freeBarSL : LusztigF 𝕂 I →ₛₗ[barRingHom] LusztigF 𝕂 I where
  toFun := LusztigF.bar
  map_add' := map_add _
  map_smul' c x := LusztigF.bar_smul c x

omit [Finite I] [DecidableEq I] in
lemma serreSubmodule_le_comap_freeBarSL :
    serreSubmodule D 𝕧 ≤ (serreSubmodule D 𝕧).comap (freeBarSL (I := I)) := fun x hx ↦ by
  rw [mem_serreSubmodule] at hx
  simp only [Submodule.mem_comap, mem_serreSubmodule]
  exact LusztigF.bar_mem_serreIdeal D hx

/-- The bar involution of `U⁻ = 'f ⧸ J`: `v ↦ v⁻¹`, `fᵢ ↦ fᵢ`. -/
def negBar : Um D 𝕧 →ₛₗ[barRingHom] Um D 𝕧 :=
  (serreSubmodule D 𝕧).mapQ (serreSubmodule D 𝕧) freeBarSL
    (serreSubmodule_le_comap_freeBarSL D)

omit [Finite I] [DecidableEq I] in
@[simp] lemma negBar_mk (x : LusztigF 𝕂 I) :
    negBar D (Submodule.Quotient.mk x) = Submodule.Quotient.mk (LusztigF.bar x) := rfl

omit [Finite I] [DecidableEq I] in
@[simp] lemma negBar_negBar (x : Um D 𝕧) : negBar D (negBar D x) = x := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  simp

omit [Finite I] [DecidableEq I] in
lemma negBar_smul (c : 𝕂) (x : Um D 𝕧) : negBar D (c • x) = RatFunc.bar c • negBar D x :=
  (negBar D).map_smulₛₗ c x

omit [Finite I] [DecidableEq I] in
lemma negBar_injective : Function.Injective (negBar D) :=
  Function.LeftInverse.injective (negBar_negBar D)

/-- Bar on `U⁻` corresponds to Lusztig's bar on `f`. -/
lemma negativeQuotientEquiv_negBar (x : Um D 𝕧) :
    negativeQuotientEquiv D (negBar D x) = quotientBar D (negativeQuotientEquiv D x) := by
  obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ x
  exact (quotientBar_toQuotient D x).symm

/-! ### The lattice `L(∞)⁻` -/

omit [Finite I] [DecidableEq I] in
/-- The bar involution exchanges the scalar actions of the local rings at `v = ∞` and `v = 0`
(the two rings have the same underlying ring; their embeddings into `ℚ(v)` differ by bar). -/
lemma negBar_infinity_smul (b : LocalRing) (x : Um D 𝕧) :
    negBar D ((show InfinityLocalRing from b) • x) = b • negBar D x := by
  rw [← algebraMap_smul 𝕂 (show InfinityLocalRing from b) x, negBar_smul,
    ← algebraMap_smul 𝕂 b (negBar D x)]
  congr 1
  change RatFunc.bar (RatFunc.bar (algebraMap LocalRing 𝕂 b)) = _
  rw [RatFunc.bar_bar]

omit [Finite I] [DecidableEq I] in
lemma negBar_local_smul (b : LocalRing) (x : Um D 𝕧) :
    negBar D (b • x) = (show InfinityLocalRing from b) • negBar D x := by
  conv_lhs => rw [← negBar_negBar D x, ← negBar_infinity_smul]
  exact negBar_negBar D _

/-- `L(∞)⁻`: the image of `L(∞)` under bar, a lattice over the local ring at `v = 0`. -/
def latInfBar : Submodule LocalRing (Um D 𝕧) where
  carrier := {x | negBar D x ∈ latInf (D := D) hvt InfinityLocalRing}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, map_add] at hx hy ⊢
    exact add_mem hx hy
  zero_mem' := by
    simp only [Set.mem_ofPred_eq, map_zero]
    exact zero_mem _
  smul_mem' b x hx := by
    simp only [Set.mem_ofPred_eq] at hx ⊢
    rw [negBar_local_smul]
    exact Submodule.smul_mem _ _ hx

omit [Finite I] in
lemma mem_latInfBar_iff (x : Um D 𝕧) :
    x ∈ latInfBar D ↔ negBar D x ∈ latInf (D := D) hvt InfinityLocalRing := Iff.rfl

omit [Finite I] in
lemma mem_localX_smul_latInfBar_iff (x : Um D 𝕧) :
    x ∈ localX • latInfBar D ↔
      negBar D x ∈ InfinityLocalRing.uniformizer • latInf (D := D) hvt InfinityLocalRing := by
  rw [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_smul_pointwise_iff_exists]
  constructor
  · rintro ⟨y, hy, rfl⟩
    exact ⟨negBar D y, hy, (negBar_local_smul D localX y).symm⟩
  · rintro ⟨y, hy, hxy⟩
    refine ⟨negBar D y, (mem_latInfBar_iff D _).2 (by rwa [negBar_negBar]), ?_⟩
    rw [← negBar_negBar D x, ← hxy]
    exact (negBar_infinity_smul D localX y).symm

omit [Finite I] in
/-- Bar transports residue independence at `v = ∞` to residue independence at `v = 0`. -/
lemma residueIndependent_latInfBar {ι : Type*} {g : ι → Um D 𝕧}
    (hg : ResidueIndependent InfinityLocalRing (latInf (D := D) hvt InfinityLocalRing)
      InfinityLocalRing.uniformizer g) :
    ResidueIndependent LocalRing (latInfBar D) localX (fun i ↦ negBar D (g i)) := by
  refine ⟨fun i ↦ (mem_latInfBar_iff D _).2 (by rw [negBar_negBar]; exact hg.1 i), ?_⟩
  intro s a hs i hi
  rw [mem_localX_smul_latInfBar_iff, map_sum] at hs
  simp_rw [negBar_local_smul, negBar_negBar] at hs
  exact hg.2 s (fun i ↦ show InfinityLocalRing from a i) hs i hi

/-! ### The `ℤ`-form -/

/-- `𝒜 = ℤ[v, v⁻¹]` acts on `U⁻` through `v ↦ X`. -/
instance negLaurentModule : Module (LaurentPolynomial ℤ) (Um D 𝕧) :=
  Module.compHom _ integralLaurentEval

omit [Finite I] [DecidableEq I] in
lemma laurent_smul_eq (c : LaurentPolynomial ℤ) (x : Um D 𝕧) :
    c • x = integralLaurentEval c • x := rfl

/-- `U⁻_ℤ`: the elements of `U⁻` whose image in `f` lies in Lusztig's `𝒜f`. -/
def negIntegral : Submodule (LaurentPolynomial ℤ) (Um D 𝕧) where
  carrier := {x | negativeQuotientEquiv D x ∈ quotientIntegralForm D}
  add_mem' {x y} hx hy := by
    simp only [Set.mem_ofPred_eq, map_add] at hx hy ⊢
    exact add_mem hx hy
  zero_mem' := by simp
  smul_mem' c x hx := by
    simp only [Set.mem_ofPred_eq] at hx ⊢
    rw [laurent_smul_eq, map_smul]
    exact (quotientIntegralForm D).smul_mem hx c

lemma mem_negIntegral (x : Um D 𝕧) :
    x ∈ negIntegral D ↔ negativeQuotientEquiv D x ∈ quotientIntegralForm D := Iff.rfl

lemma negBar_mem_negIntegral {x : Um D 𝕧} (hx : x ∈ negIntegral D) :
    negBar D x ∈ negIntegral D := by
  rw [mem_negIntegral, negativeQuotientEquiv_negBar]
  exact quotientBar_mem_integralForm D hx

lemma fWi_mem_negIntegral (w : List I) : fWi (D := D) hvt w ∈ negIntegral D :=
  fWi_mem_original_integral D w

open LaurentPolynomial in
/-- `vⁿ - v⁻ⁿ = (v - v⁻¹)(v^{n-1} + v^{n-3} + ⋯ + v^{1-n})`. -/
lemma T_sub_T_neg (n : ℕ) :
    (T (n : ℤ) - T (-(n : ℤ)) : LaurentPolynomial ℤ) =
      (T 1 - T (-1)) * ∑ k ∈ range n, T ((n : ℤ) - 1 - 2 * k) := by
  rw [Finset.mul_sum]
  have h : ∀ k : ℕ, ((T 1 - T (-1)) * T ((n : ℤ) - 1 - 2 * k) : LaurentPolynomial ℤ) =
      T ((n : ℤ) - 2 * k) - T ((n : ℤ) - 2 * ((k + 1 : ℕ) : ℤ)) := by
    intro k
    rw [sub_mul, ← T_add, ← T_add]
    congr 2
    · ring
    · push_cast; ring
  simp_rw [h]
  rw [Finset.sum_range_sub' (f := fun k : ℕ ↦ (T ((n : ℤ) - 2 * k) : LaurentPolynomial ℤ))]
  congr 2
  ring

open LaurentPolynomial in
/-- `c - c̄` is divisible by `v - v⁻¹` in `𝒜`. -/
lemma exists_sub_invert_eq_mul (c : LaurentPolynomial ℤ) :
    ∃ d : LaurentPolynomial ℤ, c - invert c = (T 1 - T (-1)) * d := by
  refine LaurentPolynomial.induction_on' c ?_ ?_
  · rintro p q ⟨d, hd⟩ ⟨e, he⟩
    refine ⟨d + e, ?_⟩
    rw [map_add, mul_add, ← hd, ← he]
    ring
  · intro n z
    obtain ⟨d, hd⟩ : ∃ d : LaurentPolynomial ℤ, T n - T (-n) = (T 1 - T (-1)) * d := by
      obtain ⟨m, rfl | rfl⟩ := Int.eq_nat_or_neg n
      · exact ⟨_, T_sub_T_neg m⟩
      · refine ⟨-∑ k ∈ range m, T ((m : ℤ) - 1 - 2 * k), ?_⟩
        rw [neg_neg, mul_neg, ← T_sub_T_neg m]
        ring
    refine ⟨C z * d, ?_⟩
    rw [map_mul, invert_C, invert_T, ← mul_sub, hd]
    ring

/-- In `𝒜f`, `x - x̄ ∈ (v - v⁻¹) 𝒜f`: true on the bar-invariant generators, on scalars by
`exists_sub_invert_eq_mul`, and stable under sums and products. -/
lemma exists_sub_quotientBar_eq_smul {x : Quotient D 𝕧} (hx : x ∈ quotientIntegralForm D) :
    ∃ y ∈ quotientIntegralForm D,
      x - quotientBar D x =
        (LaurentPolynomial.T 1 - LaurentPolynomial.T (-1) : LaurentPolynomial ℤ) • y := by
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨i, n, rfl⟩ := hx
    refine ⟨0, zero_mem _, ?_⟩
    rw [quotientIntegralGenerator, quotientBar_qDivPow, sub_self, smul_zero]
  | algebraMap c =>
    obtain ⟨d, hd⟩ := exists_sub_invert_eq_mul c
    refine ⟨algebraMap _ _ d, (quotientIntegralForm D).algebraMap_mem d, ?_⟩
    rw [quotientBar_integral_algebraMap, ← map_sub, hd, map_mul, Algebra.smul_def]
  | add x y _ _ hx hy =>
    obtain ⟨a, ha, hxa⟩ := hx
    obtain ⟨b, hb, hyb⟩ := hy
    refine ⟨a + b, add_mem ha hb, ?_⟩
    rw [map_add, smul_add, ← hxa, ← hyb]
    abel
  | mul x y hx' hy' hx hy =>
    obtain ⟨a, ha, hxa⟩ := hx
    obtain ⟨b, hb, hyb⟩ := hy
    refine ⟨a * y + quotientBar D x * b,
      add_mem (mul_mem ha hy') (mul_mem (quotientBar_mem_integralForm D hx') hb), ?_⟩
    have e : x * y - quotientBar D (x * y) =
        (x - quotientBar D x) * y + quotientBar D x * (y - quotientBar D y) := by
      rw [map_mul]; noncomm_ring
    rw [e, hxa, hyb, smul_add, smul_mul_assoc, mul_smul_comm]

/-- For `x ∈ U⁻_ℤ`, `x - x̄ = (v - v⁻¹) y` with `y ∈ U⁻_ℤ`. -/
lemma exists_sub_negBar_eq_smul {x : Um D 𝕧} (hx : x ∈ negIntegral D) :
    ∃ y ∈ negIntegral D, x - negBar D x = (RatFunc.X - RatFunc.X⁻¹ : 𝕂) • y := by
  obtain ⟨y, hy, hxy⟩ := exists_sub_quotientBar_eq_smul D hx
  refine ⟨(negativeQuotientEquiv D).symm y, by simpa [mem_negIntegral] using hy, ?_⟩
  apply (negativeQuotientEquiv D).injective
  rw [map_sub, negativeQuotientEquiv_negBar, hxy, map_smul, LinearEquiv.apply_symm_apply]
  change integralLaurentEval _ • y = _
  simp [integralLaurentEval_T]

end LieLean.QuantumGroup

import LieLean.Algebra.QuantumGroup.CrystalBasis.Global.NegativeBar

/-!
# The weight grading of `U⁻_ℤ`

Kashiwara's construction of the global basis ([Kas91] §7) proceeds weight by weight, so it uses
the weight components `(U⁻_ℤ)_ξ` of the `𝒜`-form `U⁻_ℤ` generated by the divided powers
`f_i^{(n)}` ([Kas91] §6.1). Since `U⁻_ℤ` is spanned over `𝒜` by products of divided powers,
which are weight vectors, it is graded:

* `exists_homogeneous_of_mem_closure`: a product of divided powers in `f` is the image of a
  weight vector of `'f` lying in the integral form;
* `negIntegral_le_span`: `U⁻_ℤ` is the `𝒜`-span of the images of such weight vectors;
* `proj_mem_negIntegral`: the weight projections of `U⁻` preserve `U⁻_ℤ`.

## References

* [Kas91] M. Kashiwara, *On crystal bases of the q-analogue of universal enveloping algebras*,
  Duke Math. J. 63 (1991), 465–516, §6.1.
-/

open Finset LusztigF

noncomputable section

namespace LieLean.QuantumGroup

open GrandLoop Sl2.RankOne NegativePart

local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local instance : NeZero 𝕧 := ⟨RatFunc.X_ne_zero⟩

variable {I : Type*} [Finite I] [DecidableEq I] (D : LusztigCartanDatum I)

omit [Finite I] [DecidableEq I] in
lemma pow_mem_weightSpace {ν : I →₀ ℕ} {x : LusztigF 𝕂 I} (hx : x ∈ LusztigF.weightSpace 𝕂 ν)
    (n : ℕ) : x ^ n ∈ LusztigF.weightSpace 𝕂 (n • ν) := by
  induction n with
  | zero => simpa using one_mem_weightSpace
  | succ n ih => simpa [pow_succ, succ_nsmul] using mul_mem_weightSpace ih hx

/-- The homogeneous elements of `'f` whose image in `f` lies in Lusztig's `𝒜f`. -/
def IsIntegralHomogeneous (y : Quotient D 𝕧) : Prop :=
  ∃ (ν : I →₀ ℕ) (z : LusztigF 𝕂 I), z ∈ LusztigF.weightSpace 𝕂 ν ∧ toQuotient D 𝕧 z = y ∧
    y ∈ quotientIntegralForm D

omit [Finite I] in
/-- Products of divided powers are images of weight vectors. -/
lemma exists_homogeneous_of_mem_closure {y : Quotient D 𝕧}
    (hy : y ∈ Submonoid.closure {x | ∃ i n, x = quotientIntegralGenerator D i n}) :
    IsIntegralHomogeneous D y := by
  induction hy using Submonoid.closure_induction with
  | mem x hx =>
    obtain ⟨i, n, rfl⟩ := hx
    refine ⟨n • Finsupp.single i 1, QuantumGroup.qDivPow (𝕧 ^ D.d i) n (θ 𝕂 i),
      Submodule.smul_mem _ _ (pow_mem_weightSpace (θ_mem_weightSpace i) n), ?_,
      quotientIntegralGenerator_mem D i n⟩
    rw [quotientIntegralGenerator, QuantumGroup.qDivPow, QuantumGroup.qDivPow, map_smul,
      map_pow]
  | one => exact ⟨0, 1, one_mem_weightSpace, map_one _, one_mem _⟩
  | mul x y _ _ hx hy =>
    obtain ⟨ν, z, hz, rfl, hzI⟩ := hx
    obtain ⟨μ, z', hz', rfl, hz'I⟩ := hy
    exact ⟨ν + μ, z * z', mul_mem_weightSpace hz hz', map_mul _ _ _, mul_mem hzI hz'I⟩

/-- `U⁻_ℤ` is spanned over `𝒜` by images of weight vectors of `'f` lying in `U⁻_ℤ`. -/
theorem negIntegral_le_span :
    negIntegral D ≤ Submodule.span (LaurentPolynomial ℤ)
      {x | ∃ (ν : I →₀ ℕ) (z : LusztigF 𝕂 I), z ∈ LusztigF.weightSpace 𝕂 ν ∧
        x = NegativePart.mk (D := D) (v := 𝕧) z ∧ x ∈ negIntegral D} := by
  intro x hx
  have h : negativeQuotientEquiv D x ∈ Subalgebra.toSubmodule (quotientIntegralForm D) :=
    (mem_negIntegral D x).1 hx
  rw [quotientIntegralForm, Algebra.adjoin_eq_span] at h
  rw [← (negativeQuotientEquiv D).symm_apply_apply x]
  generalize negativeQuotientEquiv D x = y at h
  induction h using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨ν, z, hz, rfl, hzI⟩ := exists_homogeneous_of_mem_closure D hy
    have hmk : (negativeQuotientEquiv D).symm (toQuotient D 𝕧 z) = NegativePart.mk z :=
      (negativeQuotientEquiv D).symm_apply_eq.2 rfl
    refine Submodule.subset_span ⟨ν, z, hz, hmk, ?_⟩
    rw [mem_negIntegral, LinearEquiv.apply_symm_apply]
    exact hzI
  | zero => simp
  | add y y' _ _ hy hy' => rw [map_add]; exact add_mem hy hy'
  | smul c y _ hy =>
    have : (negativeQuotientEquiv D).symm (c • y) = c • (negativeQuotientEquiv D).symm y := by
      change (negativeQuotientEquiv D).symm (integralLaurentEval c • y) =
        integralLaurentEval c • (negativeQuotientEquiv D).symm y
      exact map_smul _ _ _
    rw [this]
    exact Submodule.smul_mem _ _ hy

/-- The weight projections of `U⁻` preserve `U⁻_ℤ`. -/
theorem proj_mem_negIntegral (γ : I →₀ ℤ) {x : Um D 𝕧} (hx : x ∈ negIntegral D) :
    proj D 𝕧 γ x ∈ negIntegral D := by
  have h := negIntegral_le_span D hx
  clear hx
  induction h using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨ν, z, hz, rfl, hzI⟩ := hx
    classical
    rw [proj_mk, zWeightProj_of_mem hz]
    split_ifs
    · exact hzI
    · exact zero_mem _
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul c x _ hx =>
    rw [laurent_smul_eq, map_smul, ← laurent_smul_eq]
    exact Submodule.smul_mem _ _ hx

end LieLean.QuantumGroup

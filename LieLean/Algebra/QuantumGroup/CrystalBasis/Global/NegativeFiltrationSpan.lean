import LieLean.Algebra.QuantumGroup.CrystalBasis.Global.LiftUniqueness

/-!
# `U⁻_{ℤ,ν}` is the sum of the `(fᵢU⁻)^ℤ_ν`

In the last step of the induction of [Kas91] §7.5 (before (7.5.6)), Kashiwara uses that
`U⁻_ℤ(𝔤)_ν = Σᵢ (fᵢU⁻)^ℤ_ν` for `ν ≠ 0`. We prove it here (`mem_iSup_negFilt`), together with
`U⁻_{ℤ,0} = 𝒜 · 1` (`mem_span_one_of_mem_Uw_zero`), from the description of `𝒜f` as the
`𝒜`-algebra generated by the divided powers: every element of `U⁻_ℤ` is an `𝒜`-combination of `1`
and of elements `fᵢ^{(n)} z` with `n ≥ 1` and `z ∈ U⁻_ℤ` (`negIntegral_le_span_df`), and the
weight projections carry `fᵢ^{(n)} z` into `(fᵢⁿU⁻)^ℤ_ν` (`proj_df_mem_negFilt`).

We also record that `(fᵢU⁻)^ℤ_ν` consists of the elements of `U⁻_{ℤ,ν}` whose `0`-th `i`-string
component vanishes (`mem_negFilt_iff_comp_zero`), and hence contains `f̃ᵢ f̃_w 1`
(`fWi_cons_mem_negFilt`). Both statements are implicit in [Kas91] §7.5.

## Main results

* `negIntegral_le_span_df`: `U⁻_ℤ ⊆ 𝒜 · 1 + Σ 𝒜 fᵢ^{(n)} U⁻_ℤ`, `n ≥ 1`.
* `mem_iSup_negFilt`: `U⁻_{ℤ,ν} = Σᵢ (fᵢU⁻)^ℤ_ν` for `ν ≠ 0`.
* `mem_span_one_of_mem_Uw_zero`: `U⁻_{ℤ,0} = 𝒜 · 1`.
* `mem_negFilt_iff_comp_zero`: `(fᵢU⁻)^ℤ_ν = {x ∈ U⁻_{ℤ,ν} | x₀ = 0}`.

## References

* [Kas91] M. Kashiwara, *On crystal bases of the q-analogue of universal enveloping algebras*,
  Duke Math. J. 63 (1991), 465–516, §7.5.
-/

open Pointwise

noncomputable section

namespace LieLean.QuantumGroup

open Sl2.RankOne GrandLoop LusztigF

local notation "𝕂" => RatFunc ℚ
local notation "𝕧" => (RatFunc.X : RatFunc ℚ)
local notation "hvt" => transcendental_ratFunc_X

local instance : NeZero 𝕧 := ⟨RatFunc.X_ne_zero⟩

variable {I : Type*} [Finite I] [DecidableEq I] (D : LusztigCartanDatum I)

local notation "bosv" => bos (D := D) (pow_ne_one_of_transcendental' hvt)

/-! ### The divided-power generators of `U⁻_ℤ` -/

/-- The elements `fᵢ^{(n)} z` with `n ≥ 1` and `z ∈ U⁻_ℤ`. -/
def negDfSet : Set (Um D 𝕧) :=
  {x | ∃ (i : I) (n : ℕ) (z : Um D 𝕧), 1 ≤ n ∧ z ∈ negIntegral D ∧ x = (bosv i).df n z}

lemma negativeQuotientEquiv_symm_one :
    (negativeQuotientEquiv D).symm 1 = fWi (D := D) hvt [] := by
  rw [← map_one (toQuotient D 𝕧)]
  exact (negativeQuotientEquiv D).symm_apply_eq.2 rfl

/-- `U⁻_ℤ ⊆ 𝒜 · 1 + Σ 𝒜 fᵢ^{(n)} U⁻_ℤ`, `n ≥ 1`: a product of divided powers is `1` or
`fᵢ^{(n)}` times a shorter product. -/
theorem negIntegral_le_span_df :
    negIntegral D ≤
      Submodule.span (LaurentPolynomial ℤ) (insert (fWi (D := D) hvt []) (negDfSet D)) := by
  intro x hx
  have h : negativeQuotientEquiv D x ∈ Subalgebra.toSubmodule (quotientIntegralForm D) :=
    (mem_negIntegral D x).1 hx
  rw [quotientIntegralForm, Algebra.adjoin_eq_span] at h
  rw [← (negativeQuotientEquiv D).symm_apply_apply x]
  generalize negativeQuotientEquiv D x = y at h
  induction h using Submodule.span_induction with
  | mem y hy =>
    induction hy using Submonoid.closure_induction_left with
    | one =>
      rw [negativeQuotientEquiv_symm_one]
      exact Submodule.subset_span (Set.mem_insert _ _)
    | mul_left g hg y hy ih =>
      obtain ⟨i, n, rfl⟩ := hg
      have hyI : y ∈ quotientIntegralForm D :=
        (Submonoid.closure_le.2 fun _ hz ↦ Algebra.subset_adjoin hz) hy
      have e : (negativeQuotientEquiv D).symm (quotientIntegralGenerator D i n * y) =
          (bosv i).df n ((negativeQuotientEquiv D).symm y) := by
        rw [LinearEquiv.symm_apply_eq, negativeQuotientEquiv_df, LinearEquiv.apply_symm_apply]
      rw [e]
      rcases Nat.eq_zero_or_pos n with rfl | hn
      · rw [BosonModule.df_zero]; exact ih
      · refine Submodule.subset_span (Set.mem_insert_of_mem _ ⟨i, n, _, hn, ?_, rfl⟩)
        rw [mem_negIntegral, LinearEquiv.apply_symm_apply]
        exact hyI
  | zero => simp
  | add y y' _ _ hy hy' => rw [map_add]; exact add_mem hy hy'
  | smul c y _ hy =>
    have : (negativeQuotientEquiv D).symm (c • y) = c • (negativeQuotientEquiv D).symm y := by
      change (negativeQuotientEquiv D).symm (integralLaurentEval c • y) =
        integralLaurentEval c • (negativeQuotientEquiv D).symm y
      exact map_smul _ _ _
    rw [this]
    exact Submodule.smul_mem _ _ hy

/-! ### Weight components -/

/-- Every `x ∈ U⁻_{ℤ,ν}` lies in `𝒜 · P_ν(1) + Σᵢ (fᵢU⁻)^ℤ_ν`. -/
theorem mem_span_proj_one_sup_negFilt {ν : I →₀ ℕ} {x : Um D 𝕧} (hx : x ∈ negIntegral D)
    (hxw : x ∈ Uw D 𝕧 ν) :
    x ∈ Submodule.span (LaurentPolynomial ℤ)
        {NegativePart.proj D 𝕧 (LusztigF.toZ ν) (fWi (D := D) hvt [])} ⊔
      ⨆ i, negFilt D i 1 ν := by
  have h := negIntegral_le_span_df D hx
  have e : NegativePart.proj D 𝕧 (LusztigF.toZ ν) x = x := by
    rw [proj_of_mem_Uw hxw]; exact ite_eq_left_iff.2 fun h ↦ absurd rfl h
  rw [← e]
  clear e hx hxw
  induction h using Submodule.span_induction with
  | mem y hy =>
    rcases hy with rfl | ⟨i, n, z, hn, hz, rfl⟩
    · exact Submodule.mem_sup_left (Submodule.subset_span rfl)
    · exact Submodule.mem_sup_right (Submodule.mem_iSup_of_mem i
        (proj_df_mem_negFilt D i hn ν hz))
  | zero => rw [map_zero]; exact zero_mem _
  | add y y' _ _ hy hy' => rw [map_add]; exact add_mem hy hy'
  | smul c y _ hy =>
    rw [laurent_smul_eq, map_smul, ← laurent_smul_eq]
    exact Submodule.smul_mem _ _ hy

/-- **[Kas91] §7.5, before (7.5.6)**: for `ν ≠ 0`, `U⁻_{ℤ,ν} = Σᵢ (fᵢU⁻)^ℤ_ν`. -/
theorem mem_iSup_negFilt {ν : I →₀ ℕ} (hν : ν ≠ 0) {x : Um D 𝕧} (hx : x ∈ negIntegral D)
    (hxw : x ∈ Uw D 𝕧 ν) : x ∈ ⨆ i, negFilt D i 1 ν := by
  have h := mem_span_proj_one_sup_negFilt D hx hxw
  have h0 : NegativePart.proj D 𝕧 (LusztigF.toZ ν) (fWi (D := D) hvt []) = 0 := by
    have hz : LusztigF.toZ (wordWeight ([] : List I)) ≠ LusztigF.toZ ν := fun e ↦
      hν ((LusztigF.toZ_injective e).symm.trans (by simp [wordWeight]))
    rw [proj_of_mem_Uw (fWi_mem_Uw [])]; exact ite_eq_right_iff.2 fun h ↦ absurd h hz
  rwa [h0, Set.singleton_zero, Submodule.span_zero, bot_sup_eq] at h

/-- `(fᵢU⁻)^ℤ_0 = 0`. -/
lemma negFilt_zero (i : I) : negFilt D i 1 0 = ⊥ :=
  Submodule.span_eq_bot.2 fun _ ⟨k, _, hk, hk0, _⟩ ↦ by simp at hk0; omega

/-- `U⁻_{ℤ,0} = 𝒜 · 1`. -/
theorem mem_span_one_of_mem_Uw_zero {x : Um D 𝕧} (hx : x ∈ negIntegral D)
    (hxw : x ∈ Uw D 𝕧 0) :
    x ∈ Submodule.span (LaurentPolynomial ℤ) {fWi (D := D) hvt []} := by
  have h := mem_span_proj_one_sup_negFilt D hx hxw
  have h1 : NegativePart.proj D 𝕧 (LusztigF.toZ 0) (fWi (D := D) hvt []) = fWi hvt [] := by
    rw [proj_of_mem_Uw (fWi_mem_Uw [])]; exact ite_eq_left_iff.2 fun h ↦ absurd (by simp) h
  simpa only [h1, negFilt_zero, iSup_bot, sup_bot_eq] using h

/-! ### `(fᵢU⁻)^ℤ` and the `0`-th string component -/

omit [Finite I] in
/-- The `0`-th `i`-string component vanishes on `fᵢ^{(n)}U⁻`, `n ≥ 1`. -/
lemma comp_zero_df (i : I) {n : ℕ} (hn : 1 ≤ n) (y : Um D 𝕧) :
    comp hvt i 0 ((bosv i).df n y) = 0 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hn
  rw [df_succ, map_smul, comp_zero_f, smul_zero]

/-- The `0`-th `i`-string component vanishes on `(fᵢU⁻)^ℤ_ν`. -/
lemma comp_zero_of_mem_negFilt {i : I} {ν : I →₀ ℕ} {x : Um D 𝕧} (hx : x ∈ negFilt D i 1 ν) :
    comp hvt i 0 x = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨k, y, hk, -, -, -, rfl⟩ := hx
    exact comp_zero_df D i hk y
  | zero => exact map_zero _
  | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
  | smul c x _ hx => rw [laurent_smul_eq, map_smul, hx, smul_zero]

/-- `(fᵢU⁻)^ℤ_ν` consists of the elements of `U⁻_{ℤ,ν}` whose `0`-th `i`-string component
vanishes, by (6.1.2) (`df_sub_df_comp_mem_negFilt`). -/
theorem mem_negFilt_iff_comp_zero {i : I} {ν : I →₀ ℕ} {x : Um D 𝕧} :
    x ∈ negFilt D i 1 ν ↔ x ∈ negIntegral D ∧ x ∈ Uw D 𝕧 ν ∧ comp hvt i 0 x = 0 := by
  refine ⟨fun hx ↦ ⟨(mem_negFilt_le D hx).1, (mem_negFilt_le D hx).2,
    comp_zero_of_mem_negFilt D hx⟩, fun ⟨hx, hxw, h0⟩ ↦ ?_⟩
  have h := df_sub_df_comp_mem_negFilt D i (n := 0) (Nat.zero_le _) hx
    (by rwa [Finsupp.single_zero, tsub_zero])
  rwa [BosonModule.df_zero, BosonModule.df_zero, h0, sub_zero] at h

/-- `f̃ᵢ f̃_w 1 ∈ (fᵢU⁻)^ℤ`. -/
lemma fWi_cons_mem_negFilt (i : I) (w : List I) :
    fWi (D := D) hvt (i :: w) ∈ negFilt D i 1 (wordWeight (i :: w)) :=
  (mem_negFilt_iff_comp_zero D).2 ⟨fWi_mem_negIntegral D _, fWi_mem_Uw _, comp_zero_kF i _⟩

end LieLean.QuantumGroup

import LieLean.Algebra.Lie.KacMoody.Basic
import LieLean.Algebra.Lie.LocallyNilpotent

/-!
# The Serre-presented algebra `𝔤̂(A)`

Let `A` be a square integer matrix with realization `(𝔥, Π, Π^∨)` over a field `K`. The
*Serre-presented algebra* is `𝔤̂(A) = 𝔤̃(A) / 𝔰`, where `𝔰` is the ideal of `𝔤̃(A)` generated by the
Serre elements `(ad eᵢ)^{1 - aᵢⱼ} eⱼ`, `(ad fᵢ)^{1 - aᵢⱼ} fⱼ` (`i ≠ j`). It is the Lie algebra
generated by `eᵢ, fᵢ, 𝔥` subject to the relations (1.2.1) of [Kac] and the Serre relations.

When `A` is a generalized Cartan matrix and `K` has characteristic zero, `𝔰 ⊆ 𝔯` (the Serre
relations hold in `𝔤(A)`), so there is a surjection `𝔤̂(A) → 𝔤(A) = 𝔤̃(A)/𝔯` with kernel
`𝔯̂ = 𝔯/𝔰`. The Gabber–Kac theorem ([Kac] Thm. 9.11) states that `𝔯̂ = 0` if `A` is
symmetrizable; see `Matrix.Realization.SerrePresentedAlgebra.maxIdeal_eq_serreIdeal_iff`.

This file sets up `𝔤̂(A)`: generators and relations, weight spaces, the triangular
decomposition, the decomposition `𝔯̂ = 𝔯̂₋ ⊕ 𝔯̂₊` into ideals with `[𝔯̂₊, 𝔯̂₋] = 0`, and the
Chevalley involution. We also prove that `𝔤̂(A)` is integrable for the adjoint action: `ad eᵢ` and
`ad fᵢ` are locally nilpotent (for any `A`), so that a weight vector `x` of weight `μ` with
`[eᵢ, x] = 0` has `⟨μ, αᵢ^∨⟩ ∈ ℕ` (for a generalized Cartan matrix).

The splitting of ideals `I ⊆ 𝔯` as `(I ∩ 𝔫̃₋) ⊕ (I ∩ 𝔫̃₊)` is proved as in [Kac] Thm. 1.2 (e):
`I` is stable under `ad 𝔥` and contained in the sum of the root spaces `𝔤̃_α`, `α ≠ 0`.

## Main definitions

* `Matrix.Realization.SerrePresentedAlgebra`: the Lie algebra `𝔤̂(A) = 𝔤̃(A)/𝔰`.
* `Matrix.Realization.SerrePresentedAlgebra.π`, `e`, `f`, `h`, `fHom`, `eHom`.
* `Matrix.Realization.SerrePresentedAlgebra.toKacMoody`: the projection `𝔤̂(A) → 𝔤(A)`.
* `Matrix.Realization.SerrePresentedAlgebra.radical`: its kernel `𝔯̂ = 𝔯/𝔰`.
* `Matrix.Realization.SerrePresentedAlgebra.radicalNeg`, `radicalPos`: the ideals
  `𝔯̂₋ = 𝔯̂ ∩ 𝔫̂₋` and `𝔯̂₊ = 𝔯̂ ∩ 𝔫̂₊`.
* `Matrix.Realization.SerrePresentedAlgebra.rootSpace`: the root space `𝔤̂_μ`.
* `Matrix.Realization.SerrePresentedAlgebra.chevalleyInvolution`.

## Main results

* `Matrix.Realization.AuxLieAlgebra.toSubmodule_eq_inf_sup_inf`: an ideal `I ⊆ 𝔯` of `𝔤̃(A)` is
  `(I ∩ 𝔫̃₋) ⊕ (I ∩ 𝔫̃₊)`, and both summands are ideals (`negPartIdeal`, `posPartIdeal`).
* `Matrix.Realization.SerrePresentedAlgebra.maxIdeal_eq_serreIdeal_iff`: the Gabber–Kac statement
  `𝔯 = 𝔰` is equivalent to `𝔯̂ = 0`, and (`radical_eq_bot_iff`) to `𝔯̂₋ = 0`.
* `Matrix.Realization.SerrePresentedAlgebra.triangular_eq_zero`: `𝔤̂ = 𝔫̂₋ ⊕ 𝔥 ⊕ 𝔫̂₊`.
* `Matrix.Realization.SerrePresentedAlgebra.radical_toSubmodule_eq`,
  `Matrix.Realization.SerrePresentedAlgebra.lie_radicalPos_radicalNeg`: `𝔯̂ = 𝔯̂₋ ⊕ 𝔯̂₊` and
  `[𝔯̂₊, 𝔯̂₋] = 0`.
* `Matrix.Realization.SerrePresentedAlgebra.rootSpace_eq_map`: `𝔤̂_μ` is the image of `𝔤̃_μ`.
* `Matrix.Realization.SerrePresentedAlgebra.exists_ad_e_pow_eq_zero`, `exists_ad_f_pow_eq_zero`:
  `ad eᵢ` and `ad fᵢ` are locally nilpotent on `𝔤̂(A)` ([Kac] Lemma 3.5 (check)).
* `Matrix.Realization.SerrePresentedAlgebra.exists_nat_of_lie_e_eq_zero`: if `x ≠ 0` has weight
  `μ` and `[eᵢ, x] = 0`, then `⟨μ, αᵢ^∨⟩ ∈ ℕ`.

## References

* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §1.2–1.3, §3.3–3.6,
  §9.11.
* [GK] O. Gabber, V. G. Kac, *On defining relations of certain infinite-dimensional Lie
  algebras*, Bull. Amer. Math. Soc. (N.S.) **5** (1981), 185–189.
-/

open FreeLieAlgebra Module LieModule LieAlgebra

noncomputable section

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H)

namespace AuxLieAlgebra

/-! ### Ideals of `𝔤̃(A)` contained in `𝔯` -/

lemma range_fHom_inf_range_eHom :
    LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) ⊓
      LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) = ⊥ := by
  refine eq_bot_iff.mpr fun x ⟨⟨y, hy⟩, ⟨z, hz⟩⟩ ↦ ?_
  have hy' : fHom P y = x := hy
  have hz' : eHom P z = x := hz
  have h0 : triangularMap P (y, 0, -z) = triangularMap P 0 := by
    rw [triangularMap_apply, map_neg, hy', hz', map_zero, add_zero, add_neg_cancel, map_zero]
  have := congr_arg Prod.fst (triangularMap_injective P h0)
  rw [← hy', show y = 0 from this, map_zero]
  exact Submodule.zero_mem _

/-- A weight vector `x` of `𝔤̃(A)` whose image under a morphism `g` commuting with `𝔥` is a weight
vector of the same weight. -/
lemma map_mem_weightSpaceOfMap {L' : Type*} [LieRing L'] [LieAlgebra K L']
    (g : P.AuxLieAlgebra →ₗ⁅K⁆ L') {μ : Dual K H} {x : P.AuxLieAlgebra}
    (hx : x ∈ rootSpace P μ) :
    g x ∈ weightSpaceOfMap L' ((g : P.AuxLieAlgebra →ₗ[K] L') ∘ₗ h P) μ := by
  intro a
  rw [LinearMap.comp_apply, LieHom.coe_toLinearMap, ← LieHom.map_lie, hx a, map_smul]

/-- For a surjective morphism `g : 𝔤̃(A) → L'`, the weight spaces of `L'` (with respect to the
image of `𝔥`) are the images of the root spaces of `𝔤̃(A)`. -/
theorem weightSpaceOfMap_eq_map {L' : Type*} [LieRing L'] [LieAlgebra K L']
    (g : P.AuxLieAlgebra →ₗ⁅K⁆ L') (hg : Function.Surjective g) (μ : Dual K H) :
    weightSpaceOfMap L' ((g : P.AuxLieAlgebra →ₗ[K] L') ∘ₗ h P) μ =
      (rootSpace P μ).map (g : P.AuxLieAlgebra →ₗ[K] L') := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · obtain ⟨x, rfl⟩ := hg x
    have htop := iSup_rootSpace_eq_top P
    have hx' : (g : P.AuxLieAlgebra →ₗ[K] L') x ∈
        ⨆ ν, (rootSpace P ν).map (g : P.AuxLieAlgebra →ₗ[K] L') := by
      rw [← Submodule.map_iSup]
      refine Submodule.mem_map_of_mem ?_
      exact (iSup₂_le fun ν _ ↦ le_iSup (fun ν ↦ rootSpace P ν) ν)
        (htop ▸ Submodule.mem_top)
    refine mem_of_mem_iSup_of_le _
      (fun ν ↦ (rootSpace P ν).map (g : P.AuxLieAlgebra →ₗ[K] L')) ?_ hx hx'
    intro ν
    rw [Submodule.map_le_iff_le_comap]
    exact fun y hy ↦ map_mem_weightSpaceOfMap P g hy
  · rw [Submodule.map_le_iff_le_comap]
    exact fun y hy ↦ map_mem_weightSpaceOfMap P g hy

variable [CharZero K]

/-- An ideal `I ⊆ 𝔯` of `𝔤̃(A)` splits as `I = (I ∩ 𝔫̃₋) ⊕ (I ∩ 𝔫̃₊)` ([Kac] Thm. 1.2 (e)). -/
theorem toSubmodule_eq_inf_sup_inf {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P) :
    I.toSubmodule =
      I.toSubmodule ⊓ LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) ⊔
        I.toSubmodule ⊓ LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) := by
  refine le_antisymm ?_ (sup_le inf_le_left inf_le_left)
  have hle := inf_iSup_weightSpaceOfMap_le (h P) I.toSubmodule
    (lie_h_mem P _) (P.negWeights ∪ P.posWeights)
  have hI' : I.toSubmodule ≤ ⨆ μ ∈ P.negWeights ∪ P.posWeights, rootSpace P μ :=
    le_trans (show I.toSubmodule ≤ (maxIdeal P).toSubmodule from fun _ hx ↦ hI hx)
      (maxIdeal_le P)
  rw [inf_eq_left.mpr hI'] at hle
  refine hle.trans (iSup₂_le fun μ hμ ↦ ?_)
  rcases hμ with hμ | hμ
  · exact le_sup_of_le_left (inf_le_inf_left _ (rootSpace_neg_le P hμ))
  · exact le_sup_of_le_right (inf_le_inf_left _ (rootSpace_pos_le P hμ))

/-- For an ideal `I ⊆ 𝔯`, the triangular decomposition is compatible with `I`: if
`n₋ + h + n₊ ∈ I`, then `n₋ ∈ I`, `h = 0` and `n₊ ∈ I`. -/
theorem triangular_mem_of_le_maxIdeal {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P)
    {y z : FreeLieAlgebra K ι} {a : H} (hyaz : fHom P y + h P a + eHom P z ∈ I) :
    fHom P y ∈ I ∧ a = 0 ∧ eHom P z ∈ I := by
  have hmem' : fHom P y + h P a + eHom P z ∈ I.toSubmodule := hyaz
  rw [toSubmodule_eq_inf_sup_inf P hI, Submodule.mem_sup] at hmem'
  obtain ⟨r₁, ⟨hr₁, y', rfl⟩, r₂, ⟨hr₂, z', rfl⟩, hr⟩ := hmem'
  have hr' : fHom P y' + eHom P z' = fHom P y + h P a + eHom P z := hr
  have h0 : triangularMap P (y - y', a, z - z') = triangularMap P 0 := by
    rw [triangularMap_apply, map_zero, map_sub, map_sub]
    have : fHom P y - fHom P y' + h P a + (eHom P z - eHom P z') =
        (fHom P y + h P a + eHom P z) - (fHom P y' + eHom P z') := by abel
    rw [this, hr', sub_self]
  have hinj := triangularMap_injective P h0
  simp only [Prod.mk_eq_zero, sub_eq_zero] at hinj
  obtain ⟨rfl, rfl, rfl⟩ := hinj
  exact ⟨hr₁, rfl, hr₂⟩

variable {P}

/-- For an ideal `I ⊆ 𝔯`, `I ∩ 𝔫̃₋` is an ideal of `𝔤̃(A)`. -/
def negPartIdeal {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P) :
    LieIdeal K P.AuxLieAlgebra :=
  idealOfGenerators
    (I.toSubmodule ⊓ LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra))
    (fun i x ⟨hxI, y, hy⟩ ↦ by
      have hy' : fHom P y = x := hy
      obtain ⟨y', b, hyb⟩ := lie_e_fHom P i y
      have hmem : fHom P y' + h P b + eHom P 0 ∈ I := by
        rw [map_zero, add_zero, ← hyb, hy']; exact I.lie_mem hxI
      obtain ⟨-, rfl, -⟩ := triangular_mem_of_le_maxIdeal P hI hmem
      refine ⟨I.lie_mem hxI, y', ?_⟩
      change fHom P y' = _
      rw [← hy', hyb, map_zero, add_zero])
    (fun i x ⟨hxI, y, hy⟩ ↦ by
      have hy' : fHom P y = x := hy
      exact ⟨I.lie_mem hxI, ⁅FreeLieAlgebra.of K i, y⁆, by simp [hy']⟩)
    (fun a x ⟨hxI, y, hy⟩ ↦ by
      have hy' : fHom P y = x := hy
      obtain ⟨y', hy''⟩ := lie_h_fHom P a y
      exact ⟨I.lie_mem hxI, y', by rw [← hy', hy'']; rfl⟩)

/-- For an ideal `I ⊆ 𝔯`, `I ∩ 𝔫̃₊` is an ideal of `𝔤̃(A)`. -/
def posPartIdeal {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P) :
    LieIdeal K P.AuxLieAlgebra :=
  idealOfGenerators
    (I.toSubmodule ⊓ LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra))
    (fun i x ⟨hxI, z, hz⟩ ↦ by
      have hz' : eHom P z = x := hz
      exact ⟨I.lie_mem hxI, ⁅FreeLieAlgebra.of K i, z⁆, by simp [hz']⟩)
    (fun i x ⟨hxI, z, hz⟩ ↦ by
      have hz' : eHom P z = x := hz
      obtain ⟨z', b, hzb⟩ := lie_f_eHom P i z
      have hmem : fHom P 0 + h P b + eHom P z' ∈ I := by
        rw [map_zero, zero_add, add_comm, ← hzb, hz']; exact I.lie_mem hxI
      obtain ⟨-, rfl, -⟩ := triangular_mem_of_le_maxIdeal P hI hmem
      refine ⟨I.lie_mem hxI, z', ?_⟩
      change eHom P z' = _
      rw [← hz', hzb, map_zero, add_zero])
    (fun a x ⟨hxI, z, hz⟩ ↦ by
      have hz' : eHom P z = x := hz
      obtain ⟨z', hz''⟩ := lie_h_eHom P a z
      exact ⟨I.lie_mem hxI, z', by rw [← hz', hz'']; rfl⟩)

@[simp] lemma negPartIdeal_toSubmodule {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P) :
    (negPartIdeal hI).toSubmodule =
      I.toSubmodule ⊓ LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) :=
  rfl

@[simp] lemma posPartIdeal_toSubmodule {I : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P) :
    (posPartIdeal hI).toSubmodule =
      I.toSubmodule ⊓ LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) :=
  rfl

/-- For ideals `I, J ⊆ 𝔯`, `[I ∩ 𝔫̃₊, J ∩ 𝔫̃₋] = 0`: both are ideals and `𝔫̃₊ ∩ 𝔫̃₋ = 0`. -/
lemma lie_posPartIdeal_negPartIdeal {I J : LieIdeal K P.AuxLieAlgebra} (hI : I ≤ maxIdeal P)
    (hJ : J ≤ maxIdeal P) {x y : P.AuxLieAlgebra} (hx : x ∈ posPartIdeal hI)
    (hy : y ∈ negPartIdeal hJ) : ⁅x, y⁆ = 0 := by
  have h1 : ⁅x, y⁆ ∈ (negPartIdeal hJ).toSubmodule := (negPartIdeal hJ).lie_mem hy
  have h2 : ⁅x, y⁆ ∈ (posPartIdeal hI).toSubmodule := by
    rw [← lie_skew]; exact (posPartIdeal hI).toSubmodule.neg_mem ((posPartIdeal hI).lie_mem hx)
  have := (Submodule.eq_bot_iff _).mp (range_fHom_inf_range_eHom P) _ ⟨h1.2, h2.2⟩
  exact this

variable (P)

omit [CharZero K] in
lemma chevalleyInvolution_serreF (i j : ι) :
    chevalleyInvolution P (serreF P i j) = (-1 : K) ^ (-A i j).toNat • serreE P i j := by
  rw [serreE, serreF, LieHom.map_ad_pow, LieHom.map_lie, chevalleyInvolution_f,
    chevalleyInvolution_f, neg_lie, lie_neg, neg_neg, ad_neg_pow_apply]

omit [CharZero K] in
/-- The Serre ideal is stable under the Chevalley involution. -/
lemma chevalleyInvolution_mem_serreIdeal {x : P.AuxLieAlgebra} (hx : x ∈ serreIdeal P) :
    chevalleyInvolution P x ∈ serreIdeal P := by
  have hle : serreIdeal P ≤ LieIdeal.comap (chevalleyInvolution P) (serreIdeal P) := by
    rw [serreIdeal, LieSubmodule.lieSpan_le]
    rintro _ ⟨i, j, hij, rfl | rfl⟩
    · change chevalleyInvolution P (serreE P i j) ∈ serreIdeal P
      rw [chevalleyInvolution_serreE]
      exact (serreIdeal P).smul_mem _
        (LieSubmodule.subset_lieSpan ⟨i, j, hij, Or.inr rfl⟩)
    · change chevalleyInvolution P (serreF P i j) ∈ serreIdeal P
      rw [chevalleyInvolution_serreF]
      exact (serreIdeal P).smul_mem _
        (LieSubmodule.subset_lieSpan ⟨i, j, hij, Or.inl rfl⟩)
  exact hle hx

end AuxLieAlgebra

/-! ### The Serre-presented algebra -/

/-- The Serre-presented algebra `𝔤̂(A) = 𝔤̃(A)/𝔰`: the Lie algebra generated by `eᵢ, fᵢ, 𝔥` with
the relations (1.2.1) of [Kac] and the Serre relations. -/
abbrev SerrePresentedAlgebra : Type _ := P.AuxLieAlgebra ⧸ AuxLieAlgebra.serreIdeal P

namespace SerrePresentedAlgebra

/-- The quotient map `𝔤̃(A) → 𝔤̂(A)`. -/
def π : P.AuxLieAlgebra →ₗ⁅K⁆ P.SerrePresentedAlgebra := LieIdeal.mkHom _

lemma π_surjective : Function.Surjective (π P) := LieIdeal.mkHom_surjective _

lemma π_eq_zero_iff {x : P.AuxLieAlgebra} : π P x = 0 ↔ x ∈ AuxLieAlgebra.serreIdeal P :=
  LieIdeal.mkHom_eq_zero_iff _

/-- The generator `eᵢ` of `𝔤̂(A)`. -/
def e (i : ι) : P.SerrePresentedAlgebra := π P (AuxLieAlgebra.e P i)

/-- The generator `fᵢ` of `𝔤̂(A)`. -/
def f (i : ι) : P.SerrePresentedAlgebra := π P (AuxLieAlgebra.f P i)

/-- The map `𝔥 → 𝔤̂(A)`. -/
def h : H →ₗ[K] P.SerrePresentedAlgebra := (π P).toLinearMap ∘ₗ AuxLieAlgebra.h P

@[simp] lemma π_e (i : ι) : π P (AuxLieAlgebra.e P i) = e P i := rfl
@[simp] lemma π_f (i : ι) : π P (AuxLieAlgebra.f P i) = f P i := rfl
@[simp] lemma π_h (a : H) : π P (AuxLieAlgebra.h P a) = h P a := rfl

lemma lie_h_h (a b : H) : ⁅h P a, h P b⁆ = 0 := by
  rw [← π_h, ← π_h, ← LieHom.map_lie, AuxLieAlgebra.lie_h_h, map_zero]

lemma lie_e_f (i j : ι) : ⁅e P i, f P j⁆ = if i = j then h P (P.coroot i) else 0 := by
  rw [← π_e, ← π_f, ← LieHom.map_lie, AuxLieAlgebra.lie_e_f]
  split_ifs <;> simp

@[simp] lemma lie_e_f_self (i : ι) : ⁅e P i, f P i⁆ = h P (P.coroot i) := by
  simp [lie_e_f]

lemma lie_e_f_of_ne {i j : ι} (hij : i ≠ j) : ⁅e P i, f P j⁆ = 0 := by
  simp [lie_e_f, hij]

lemma lie_h_e (a : H) (i : ι) : ⁅h P a, e P i⁆ = P.root i a • e P i := by
  rw [← π_h, ← π_e, ← LieHom.map_lie, AuxLieAlgebra.lie_h_e, map_smul]

lemma lie_h_f (a : H) (i : ι) : ⁅h P a, f P i⁆ = -(P.root i a • f P i) := by
  rw [← π_h, ← π_f, ← LieHom.map_lie, AuxLieAlgebra.lie_h_f, map_neg, map_smul]

/-- The Serre relations `(ad eᵢ)^{1 - aᵢⱼ} eⱼ = 0` hold in `𝔤̂(A)` for `i ≠ j`. -/
theorem serre_e {i j : ι} (hij : i ≠ j) :
    (ad K _ (e P i) ^ (-A i j).toNat) ⁅e P i, e P j⁆ = 0 := by
  have := (π_eq_zero_iff P).mpr (LieSubmodule.subset_lieSpan ⟨i, j, hij, Or.inl rfl⟩ :
    AuxLieAlgebra.serreE P i j ∈ AuxLieAlgebra.serreIdeal P)
  rwa [AuxLieAlgebra.serreE, LieHom.map_ad_pow, LieHom.map_lie] at this

/-- The Serre relations `(ad fᵢ)^{1 - aᵢⱼ} fⱼ = 0` hold in `𝔤̂(A)` for `i ≠ j`. -/
theorem serre_f {i j : ι} (hij : i ≠ j) :
    (ad K _ (f P i) ^ (-A i j).toNat) ⁅f P i, f P j⁆ = 0 := by
  have := (π_eq_zero_iff P).mpr (LieSubmodule.subset_lieSpan ⟨i, j, hij, Or.inr rfl⟩ :
    AuxLieAlgebra.serreF P i j ∈ AuxLieAlgebra.serreIdeal P)
  rwa [AuxLieAlgebra.serreF, LieHom.map_ad_pow, LieHom.map_lie] at this

/-- The morphism from the free Lie algebra on `ι` onto `𝔫̂₋ ⊆ 𝔤̂(A)`. -/
def fHom : FreeLieAlgebra K ι →ₗ⁅K⁆ P.SerrePresentedAlgebra := (π P).comp (AuxLieAlgebra.fHom P)

/-- The morphism from the free Lie algebra on `ι` onto `𝔫̂₊ ⊆ 𝔤̂(A)`. -/
def eHom : FreeLieAlgebra K ι →ₗ⁅K⁆ P.SerrePresentedAlgebra := (π P).comp (AuxLieAlgebra.eHom P)

@[simp] lemma fHom_of (i : ι) : fHom P (FreeLieAlgebra.of K i) = f P i := by simp [fHom]
@[simp] lemma eHom_of (i : ι) : eHom P (FreeLieAlgebra.of K i) = e P i := by simp [eHom]

lemma π_fHom (y : FreeLieAlgebra K ι) : π P (AuxLieAlgebra.fHom P y) = fHom P y := rfl
lemma π_eHom (z : FreeLieAlgebra K ι) : π P (AuxLieAlgebra.eHom P z) = eHom P z := rfl

/-- Every element of `𝔤̂(A)` is of the form `n₋ + h + n₊`. -/
lemma exists_triangular (x : P.SerrePresentedAlgebra) :
    ∃ y a z, x = fHom P y + h P a + eHom P z := by
  obtain ⟨x, rfl⟩ := π_surjective P x
  obtain ⟨⟨y, a, z⟩, rfl⟩ := (AuxLieAlgebra.triangularEquiv P).surjective x
  exact ⟨y, a, z, by simp [fHom, eHom, map_add]⟩

/-- The generators span `𝔤̂(A)` as a Lie algebra. -/
lemma lieSpan_generators :
    LieSubalgebra.lieSpan K P.SerrePresentedAlgebra
      (Set.range (e P) ∪ Set.range (f P) ∪ Set.range (h P)) = ⊤ := by
  rw [eq_top_iff]
  rintro y -
  obtain ⟨x, rfl⟩ := π_surjective P y
  have : (LieSubalgebra.lieSpan K P.SerrePresentedAlgebra
      (Set.range (e P) ∪ Set.range (f P) ∪ Set.range (h P))).comap (π P) = ⊤ := by
    rw [eq_top_iff, ← AuxLieAlgebra.lieSpan_generators, LieSubalgebra.lieSpan_le]
    rintro _ ((⟨i, rfl⟩ | ⟨i, rfl⟩) | ⟨a, rfl⟩) <;> apply LieSubalgebra.subset_lieSpan
    exacts [Or.inl (Or.inl ⟨i, rfl⟩), Or.inl (Or.inr ⟨i, rfl⟩), Or.inr ⟨a, rfl⟩]
  exact (this ▸ LieSubalgebra.mem_top x : x ∈ _)

/-! ### Weight spaces -/

/-- The root space `𝔤̂_μ = {x ∈ 𝔤̂(A) | ∀ h, [h, x] = ⟨μ, h⟩ x}`. -/
abbrev rootSpace (μ : Dual K H) : Submodule K P.SerrePresentedAlgebra :=
  weightSpaceOfMap P.SerrePresentedAlgebra (h P) μ

lemma π_mem_rootSpace {μ : Dual K H} {x : P.AuxLieAlgebra}
    (hx : x ∈ AuxLieAlgebra.rootSpace P μ) : π P x ∈ rootSpace P μ :=
  AuxLieAlgebra.map_mem_weightSpaceOfMap P (π P) hx

/-- The root space `𝔤̂_μ` is the image of the root space `𝔤̃_μ`. -/
theorem rootSpace_eq_map (μ : Dual K H) :
    rootSpace P μ = (AuxLieAlgebra.rootSpace P μ).map (π P).toLinearMap :=
  AuxLieAlgebra.weightSpaceOfMap_eq_map P (π P) (π_surjective P) μ

lemma e_mem_rootSpace (i : ι) : e P i ∈ rootSpace P (P.root i) :=
  π_mem_rootSpace P (AuxLieAlgebra.e_mem_rootSpace P i)

lemma f_mem_rootSpace (i : ι) : f P i ∈ rootSpace P (-P.root i) :=
  π_mem_rootSpace P (AuxLieAlgebra.f_mem_rootSpace P i)

lemma h_mem_rootSpace (a : H) : h P a ∈ rootSpace P 0 :=
  π_mem_rootSpace P (AuxLieAlgebra.h_mem_rootSpace P a)

lemma lie_mem_rootSpace {μ ν : Dual K H} {x y : P.SerrePresentedAlgebra}
    (hx : x ∈ rootSpace P μ) (hy : y ∈ rootSpace P ν) : ⁅x, y⁆ ∈ rootSpace P (μ + ν) :=
  lie_mem_weightSpaceOfMap (h P) hx hy

/-- `𝔫̂₋ ⊆ ⊕_{α > 0} 𝔤̂_{-α}`. -/
lemma fHom_mem (y : FreeLieAlgebra K ι) : fHom P y ∈ ⨆ μ ∈ P.negWeights, rootSpace P μ := by
  have := Submodule.mem_map_of_mem (f := (π P).toLinearMap) (AuxLieAlgebra.fHom_mem P y)
  simp_rw [Submodule.map_iSup, ← rootSpace_eq_map] at this
  exact this

/-- `𝔫̂₊ ⊆ ⊕_{α > 0} 𝔤̂_α`. -/
lemma eHom_mem (z : FreeLieAlgebra K ι) : eHom P z ∈ ⨆ μ ∈ P.posWeights, rootSpace P μ := by
  have := Submodule.mem_map_of_mem (f := (π P).toLinearMap) (AuxLieAlgebra.eHom_mem P z)
  simp_rw [Submodule.map_iSup, ← rootSpace_eq_map] at this
  exact this

/-- `𝔤̂(A)` is the sum of its root spaces. -/
theorem iSup_rootSpace_eq_top : ⨆ μ ∈ AuxLieAlgebra.allWeights P, rootSpace P μ = ⊤ := by
  rw [eq_top_iff]
  rintro x -
  obtain ⟨x, rfl⟩ := π_surjective P x
  have hx : x ∈ ⨆ μ ∈ AuxLieAlgebra.allWeights P, AuxLieAlgebra.rootSpace P μ := by
    rw [AuxLieAlgebra.iSup_rootSpace_eq_top]; trivial
  have := Submodule.mem_map_of_mem (f := (π P).toLinearMap) hx
  simp_rw [Submodule.map_iSup, ← rootSpace_eq_map] at this
  exact this

/-- `𝔤̂_{-αᵢ} = K fᵢ`. -/
theorem rootSpace_neg_root [CharZero K] (i : ι) : rootSpace P (-P.root i) = K ∙ f P i := by
  rw [rootSpace_eq_map, AuxLieAlgebra.rootSpace_neg_root, Submodule.map_span,
    Set.image_singleton]
  rfl

/-- `𝔤̂_{αᵢ} = K eᵢ`. -/
theorem rootSpace_root [CharZero K] (i : ι) : rootSpace P (P.root i) = K ∙ e P i := by
  rw [rootSpace_eq_map, AuxLieAlgebra.rootSpace_root, Submodule.map_span, Set.image_singleton]
  rfl

/-- For `α > 0`, `𝔤̂_{-α} ⊆ 𝔫̂₋`. -/
theorem rootSpace_neg_le [CharZero K] {μ : Dual K H} (hμ : μ ∈ P.negWeights) :
    rootSpace P μ ≤
      LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) := by
  rw [rootSpace_eq_map, Submodule.map_le_iff_le_comap]
  intro x hx
  obtain ⟨y, hy⟩ := AuxLieAlgebra.rootSpace_neg_le P hμ hx
  exact ⟨y, by rw [← (show AuxLieAlgebra.fHom P y = x from hy)]; rfl⟩

/-- For `α > 0`, `𝔤̂_α ⊆ 𝔫̂₊`. -/
theorem rootSpace_pos_le [CharZero K] {μ : Dual K H} (hμ : μ ∈ P.posWeights) :
    rootSpace P μ ≤
      LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) := by
  rw [rootSpace_eq_map, Submodule.map_le_iff_le_comap]
  intro x hx
  obtain ⟨z, hz⟩ := AuxLieAlgebra.rootSpace_pos_le P hμ hx
  exact ⟨z, by rw [← (show AuxLieAlgebra.eHom P z = x from hz)]; rfl⟩

/-! ### The Chevalley involution -/

/-- The Chevalley involution of `𝔤̂(A)`: `eᵢ ↦ -fᵢ`, `fᵢ ↦ -eᵢ`, `h ↦ -h` ([Kac] (1.3.4)). -/
def chevalleyInvolution : P.SerrePresentedAlgebra →ₗ⁅K⁆ P.SerrePresentedAlgebra :=
  LieIdeal.lift _ ((π P).comp (AuxLieAlgebra.chevalleyInvolution P)) fun x hx ↦ by
    simp only [LieHom.mem_ker, LieHom.comp_apply]
    exact (π_eq_zero_iff P).mpr (AuxLieAlgebra.chevalleyInvolution_mem_serreIdeal P hx)

@[simp] lemma chevalleyInvolution_π (x : P.AuxLieAlgebra) :
    chevalleyInvolution P (π P x) = π P (AuxLieAlgebra.chevalleyInvolution P x) := rfl

@[simp] lemma chevalleyInvolution_e (i : ι) : chevalleyInvolution P (e P i) = -f P i := by
  rw [← π_e, chevalleyInvolution_π, AuxLieAlgebra.chevalleyInvolution_e, map_neg, π_f]

@[simp] lemma chevalleyInvolution_f (i : ι) : chevalleyInvolution P (f P i) = -e P i := by
  rw [← π_f, chevalleyInvolution_π, AuxLieAlgebra.chevalleyInvolution_f, map_neg, π_e]

@[simp] lemma chevalleyInvolution_h (a : H) : chevalleyInvolution P (h P a) = -h P a := by
  rw [← π_h, chevalleyInvolution_π, AuxLieAlgebra.chevalleyInvolution_h, map_neg, π_h]

@[simp] lemma chevalleyInvolution_chevalleyInvolution (x : P.SerrePresentedAlgebra) :
    chevalleyInvolution P (chevalleyInvolution P x) = x := by
  obtain ⟨x, rfl⟩ := π_surjective P x
  simp

lemma chevalleyInvolution_surjective : Function.Surjective (chevalleyInvolution P) :=
  fun x ↦ ⟨chevalleyInvolution P x, chevalleyInvolution_chevalleyInvolution P x⟩

/-! ### Integrability of the adjoint representation -/

/-- `ad eᵢ` is locally nilpotent on `𝔤̂(A)` ([Kac] Lemma 3.5 (check)). This holds for any square
matrix `A`, since the Serre relations are imposed. -/
theorem exists_ad_e_pow_eq_zero (i : ι) (x : P.SerrePresentedAlgebra) :
    ∃ n : ℕ, (ad K _ (e P i) ^ n) x = 0 := by
  refine LieSubalgebra.exists_ad_pow_eq_zero_of_lieSpan_eq_top (lieSpan_generators P) _ ?_ x
  have hsucc : ∀ (n : ℕ) (y : P.SerrePresentedAlgebra),
      (ad K _ (e P i) ^ (n + 1)) y = (ad K _ (e P i) ^ n) ⁅e P i, y⁆ := by
    intro n y; rw [pow_succ, Module.End.mul_apply, ad_apply]
  have hhe : ∀ a, ⁅e P i, h P a⁆ = -(P.root i a • e P i) := fun a ↦ by
    rw [← lie_skew, lie_h_e]
  rintro _ ((⟨j, rfl⟩ | ⟨j, rfl⟩) | ⟨a, rfl⟩)
  · by_cases hij : i = j
    · subst hij; exact ⟨1, by simp⟩
    · exact ⟨(-A i j).toNat + 1, by rw [hsucc, serre_e P hij]⟩
  · by_cases hij : i = j
    · subst hij
      refine ⟨3, ?_⟩
      rw [hsucc, hsucc, hsucc, lie_e_f_self, hhe, lie_neg, lie_smul, lie_self]
      simp
    · exact ⟨1, by rw [hsucc, lie_e_f_of_ne P hij]; simp⟩
  · exact ⟨2, by rw [hsucc, hsucc, hhe, lie_neg, lie_smul, lie_self]; simp⟩

/-- `ad fᵢ` is locally nilpotent on `𝔤̂(A)` ([Kac] Lemma 3.5 (check)). -/
theorem exists_ad_f_pow_eq_zero (i : ι) (x : P.SerrePresentedAlgebra) :
    ∃ n : ℕ, (ad K _ (f P i) ^ n) x = 0 := by
  have htop : LieSubalgebra.engel K (e P i) = ⊤ :=
    LieSubalgebra.engel_eq_top_of_lieSpan_eq_top (lieSpan_generators P) _
      fun y _ ↦ exists_ad_e_pow_eq_zero P i y
  have := LieSubalgebra.engel_eq_top_of_surjective (chevalleyInvolution_surjective P) htop
  rw [chevalleyInvolution_e] at this
  obtain ⟨n, hn⟩ := (LieSubalgebra.mem_engel_iff K _ x).mp (this ▸ LieSubalgebra.mem_top x)
  refine ⟨n, ?_⟩
  rw [ad_neg_pow_apply] at hn
  exact (smul_eq_zero.mp hn).resolve_left (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))

/-! ### The projection onto `𝔤(A)` -/

variable [CharZero K] (hA : A.IsGeneralizedCartan)

/-- The projection `𝔤̂(A) → 𝔤(A)`, which exists since the Serre relations hold in `𝔤(A)`. -/
def toKacMoody : P.SerrePresentedAlgebra →ₗ⁅K⁆ P.KacMoodyAlgebra :=
  LieIdeal.lift _ (KacMoodyAlgebra.π P) fun _ hx ↦
    (KacMoodyAlgebra.π_eq_zero_iff P).mpr (AuxLieAlgebra.serreIdeal_le_maxIdeal P hA hx)

@[simp] lemma toKacMoody_π (x : P.AuxLieAlgebra) :
    toKacMoody P hA (π P x) = KacMoodyAlgebra.π P x := rfl

@[simp] lemma toKacMoody_e (i : ι) : toKacMoody P hA (e P i) = KacMoodyAlgebra.e P i := rfl
@[simp] lemma toKacMoody_f (i : ι) : toKacMoody P hA (f P i) = KacMoodyAlgebra.f P i := rfl
@[simp] lemma toKacMoody_h (a : H) : toKacMoody P hA (h P a) = KacMoodyAlgebra.h P a := rfl

lemma toKacMoody_fHom (y : FreeLieAlgebra K ι) :
    toKacMoody P hA (fHom P y) = KacMoodyAlgebra.fHom P y := rfl

lemma toKacMoody_eHom (z : FreeLieAlgebra K ι) :
    toKacMoody P hA (eHom P z) = KacMoodyAlgebra.eHom P z := rfl

lemma toKacMoody_surjective : Function.Surjective (toKacMoody P hA) := by
  intro y
  obtain ⟨x, rfl⟩ := KacMoodyAlgebra.π_surjective P y
  exact ⟨π P x, rfl⟩

lemma toKacMoody_chevalleyInvolution (x : P.SerrePresentedAlgebra) :
    toKacMoody P hA (chevalleyInvolution P x) =
      KacMoodyAlgebra.chevalleyInvolution P (toKacMoody P hA x) := by
  obtain ⟨x, rfl⟩ := π_surjective P x
  rfl

include hA in
/-- `𝔥 ↪ 𝔤̂(A)`. -/
theorem h_injective : Function.Injective (h P) := by
  intro a b hab
  apply KacMoodyAlgebra.h_injective P
  rw [← toKacMoody_h P hA, hab, toKacMoody_h]

include hA in
/-- The triangular decomposition `𝔤̂(A) = 𝔫̂₋ ⊕ 𝔥 ⊕ 𝔫̂₊` is direct. -/
theorem triangular_eq_zero {y z : FreeLieAlgebra K ι} {a : H}
    (hyaz : fHom P y + h P a + eHom P z = 0) : fHom P y = 0 ∧ a = 0 ∧ eHom P z = 0 := by
  have hmem : AuxLieAlgebra.fHom P y + AuxLieAlgebra.h P a + AuxLieAlgebra.eHom P z ∈
      AuxLieAlgebra.serreIdeal P := by
    rw [← π_eq_zero_iff]; simpa [fHom, eHom, map_add] using hyaz
  obtain ⟨h1, h2, h3⟩ := AuxLieAlgebra.triangular_mem_of_le_maxIdeal P
    (AuxLieAlgebra.serreIdeal_le_maxIdeal P hA) hmem
  exact ⟨(π_eq_zero_iff P).mpr h1, h2, (π_eq_zero_iff P).mpr h3⟩

include hA in
/-- `𝔫̂₋ ∩ 𝔫̂₊ = 0`. -/
lemma range_fHom_inf_range_eHom :
    LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) ⊓
      LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) = ⊥ := by
  refine eq_bot_iff.mpr fun x ⟨⟨y, hy⟩, ⟨z, hz⟩⟩ ↦ ?_
  have hy' : fHom P y = x := hy
  have hz' : eHom P z = x := hz
  have := (triangular_eq_zero P hA (y := y) (z := -z) (a := 0)
    (by rw [map_neg, hy', hz', map_zero, add_zero, add_neg_cancel])).1
  rw [← hy', this]
  exact Submodule.zero_mem _

/-! ### The radical `𝔯̂ = 𝔯 / 𝔰` -/

/-- The kernel `𝔯̂ = 𝔯/𝔰` of the projection `𝔤̂(A) → 𝔤(A)`. -/
def radical : LieIdeal K P.SerrePresentedAlgebra := (toKacMoody P hA).ker

lemma mem_radical_iff {x : P.SerrePresentedAlgebra} :
    x ∈ radical P hA ↔ toKacMoody P hA x = 0 := LieHom.mem_ker

lemma π_mem_radical_iff {x : P.AuxLieAlgebra} :
    π P x ∈ radical P hA ↔ x ∈ AuxLieAlgebra.maxIdeal P := by
  rw [mem_radical_iff, toKacMoody_π, KacMoodyAlgebra.π_eq_zero_iff]

/-- `𝔯̂` is the image of `𝔯`. -/
lemma radical_eq_map : radical P hA = (AuxLieAlgebra.maxIdeal P).map (π P) := by
  ext x
  obtain ⟨x, rfl⟩ := π_surjective P x
  have : π P x ∈ (AuxLieAlgebra.maxIdeal P).map (π P) ↔
      π P x ∈ ((AuxLieAlgebra.maxIdeal P).map (π P)).toSubmodule := Iff.rfl
  rw [π_mem_radical_iff, this, LieIdeal.coe_map_of_surjective (π_surjective P)]
  constructor
  · intro hx; exact ⟨x, hx, rfl⟩
  · rintro ⟨y, hy, hyx⟩
    have : y - x ∈ AuxLieAlgebra.serreIdeal P := by
      rw [← π_eq_zero_iff, map_sub, sub_eq_zero]; exact hyx
    have h' := (AuxLieAlgebra.maxIdeal P).sub_mem hy
      (AuxLieAlgebra.serreIdeal_le_maxIdeal P hA this)
    rwa [sub_sub_cancel] at h'

/-- The Gabber–Kac statement `𝔯 = 𝔰` ([Kac] Thm. 9.11) is equivalent to `𝔯̂ = 0`, i.e. to the
projection `𝔤̂(A) → 𝔤(A)` being an isomorphism. -/
theorem maxIdeal_eq_serreIdeal_iff :
    AuxLieAlgebra.maxIdeal P = AuxLieAlgebra.serreIdeal P ↔ radical P hA = ⊥ := by
  constructor
  · intro heq
    rw [eq_bot_iff]
    intro x hx
    obtain ⟨x, rfl⟩ := π_surjective P x
    rw [π_mem_radical_iff, heq, ← π_eq_zero_iff] at hx
    rw [hx]; exact LieSubmodule.zero_mem _
  · intro hbot
    refine le_antisymm (fun x hx ↦ ?_) (AuxLieAlgebra.serreIdeal_le_maxIdeal P hA)
    rw [← π_mem_radical_iff P hA, hbot, LieSubmodule.mem_bot, π_eq_zero_iff] at hx
    exact hx

lemma radical_eq_bot_iff_injective : radical P hA = ⊥ ↔ Function.Injective (toKacMoody P hA) :=
  (toKacMoody P hA).ker_eq_bot

/-- The ideal `𝔯̂₋ = 𝔯̂ ∩ 𝔫̂₋` of `𝔤̂(A)`, the image of `𝔯 ∩ 𝔫̃₋`. -/
def radicalNeg : LieIdeal K P.SerrePresentedAlgebra :=
  (AuxLieAlgebra.negPartIdeal (le_refl (AuxLieAlgebra.maxIdeal P))).map (π P)

/-- The ideal `𝔯̂₊ = 𝔯̂ ∩ 𝔫̂₊` of `𝔤̂(A)`, the image of `𝔯 ∩ 𝔫̃₊`. -/
def radicalPos : LieIdeal K P.SerrePresentedAlgebra :=
  (AuxLieAlgebra.posPartIdeal (le_refl (AuxLieAlgebra.maxIdeal P))).map (π P)

/-- `𝔯̂₋ = 𝔯̂ ∩ 𝔫̂₋`. -/
theorem radicalNeg_toSubmodule : (radicalNeg P).toSubmodule = (radical P hA).toSubmodule ⊓
    LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) := by
  rw [radicalNeg, LieIdeal.coe_map_of_surjective (π_surjective P)]
  ext x
  simp only [Submodule.mem_map, AuxLieAlgebra.negPartIdeal_toSubmodule, Submodule.mem_inf,
    LieSubmodule.mem_toSubmodule, LinearMap.mem_range, LieHom.coe_toLinearMap]
  constructor
  · rintro ⟨x, ⟨hx, y, rfl⟩, rfl⟩
    exact ⟨(π_mem_radical_iff P hA).mpr hx, y, rfl⟩
  · rintro ⟨hx, y, rfl⟩
    exact ⟨_, ⟨(π_mem_radical_iff P hA).mp hx, y, rfl⟩, rfl⟩

/-- `𝔯̂₊ = 𝔯̂ ∩ 𝔫̂₊`. -/
theorem radicalPos_toSubmodule : (radicalPos P).toSubmodule = (radical P hA).toSubmodule ⊓
    LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.SerrePresentedAlgebra) := by
  rw [radicalPos, LieIdeal.coe_map_of_surjective (π_surjective P)]
  ext x
  simp only [Submodule.mem_map, AuxLieAlgebra.posPartIdeal_toSubmodule, Submodule.mem_inf,
    LieSubmodule.mem_toSubmodule, LinearMap.mem_range, LieHom.coe_toLinearMap]
  constructor
  · rintro ⟨x, ⟨hx, z, rfl⟩, rfl⟩
    exact ⟨(π_mem_radical_iff P hA).mpr hx, z, rfl⟩
  · rintro ⟨hx, z, rfl⟩
    exact ⟨_, ⟨(π_mem_radical_iff P hA).mp hx, z, rfl⟩, rfl⟩

lemma radicalNeg_le_radical : radicalNeg P ≤ radical P hA := fun x hx ↦ by
  have : x ∈ (radicalNeg P).toSubmodule := hx
  rw [radicalNeg_toSubmodule P hA] at this
  exact this.1

lemma radicalPos_le_radical : radicalPos P ≤ radical P hA := fun x hx ↦ by
  have : x ∈ (radicalPos P).toSubmodule := hx
  rw [radicalPos_toSubmodule P hA] at this
  exact this.1

/-- `𝔯̂ = 𝔯̂₋ ⊕ 𝔯̂₊`. -/
theorem radical_toSubmodule_eq :
    (radical P hA).toSubmodule = (radicalNeg P).toSubmodule ⊔ (radicalPos P).toSubmodule := by
  rw [radical_eq_map, LieIdeal.coe_map_of_surjective (π_surjective P),
    AuxLieAlgebra.toSubmodule_eq_inf_sup_inf P (le_refl _), Submodule.map_sup, radicalNeg,
    radicalPos, LieIdeal.coe_map_of_surjective (π_surjective P),
    LieIdeal.coe_map_of_surjective (π_surjective P)]
  rfl

include hA in
/-- `𝔯̂₋ ∩ 𝔯̂₊ = 0`. -/
theorem radicalNeg_inf_radicalPos : radicalNeg P ⊓ radicalPos P = ⊥ := by
  rw [eq_bot_iff]
  rintro x ⟨hx, hx'⟩
  have h1 : x ∈ (radicalNeg P).toSubmodule := hx
  have h2 : x ∈ (radicalPos P).toSubmodule := hx'
  rw [radicalNeg_toSubmodule P hA] at h1
  rw [radicalPos_toSubmodule P hA] at h2
  have := (Submodule.eq_bot_iff _).mp (range_fHom_inf_range_eHom P hA) x ⟨h1.2, h2.2⟩
  rw [this]; exact LieSubmodule.zero_mem _

/-- `[𝔯̂₊, 𝔯̂₋] = 0` (already `[𝔯₊, 𝔯₋] = 0` in `𝔤̃(A)`). -/
theorem lie_radicalPos_radicalNeg {x y : P.SerrePresentedAlgebra} (hx : x ∈ radicalPos P)
    (hy : y ∈ radicalNeg P) : ⁅x, y⁆ = 0 := by
  obtain ⟨⟨x', hx'⟩, rfl⟩ := LieIdeal.mem_map_of_surjective (π_surjective P) hx
  obtain ⟨⟨y', hy'⟩, rfl⟩ := LieIdeal.mem_map_of_surjective (π_surjective P) hy
  rw [← LieHom.map_lie, AuxLieAlgebra.lie_posPartIdeal_negPartIdeal _ _ hx' hy', map_zero]

/-- `[𝔯̂₊, 𝔯̂₋] = 0`, as a statement about ideals. -/
theorem lie_radicalPos_radicalNeg_eq_bot : ⁅radicalPos P, radicalNeg P⁆ = ⊥ := by
  rw [eq_bot_iff, LieSubmodule.lie_le_iff]
  intro x hx y hy
  rw [lie_radicalPos_radicalNeg P hx hy]
  exact LieSubmodule.zero_mem _

include hA in
/-- The Chevalley involution maps `𝔯̂₊` into `𝔯̂₋`. -/
lemma chevalleyInvolution_mem_radicalNeg {x : P.SerrePresentedAlgebra} (hx : x ∈ radicalPos P) :
    chevalleyInvolution P x ∈ radicalNeg P := by
  have h1 : x ∈ (radicalPos P).toSubmodule := hx
  rw [radicalPos_toSubmodule P hA] at h1
  obtain ⟨hxr, z, rfl⟩ := h1
  change _ ∈ (radicalNeg P).toSubmodule
  rw [radicalNeg_toSubmodule P hA]
  refine ⟨?_, AuxLieAlgebra.negGen z, ?_⟩
  · change _ ∈ radical P hA
    rw [mem_radical_iff, toKacMoody_chevalleyInvolution, (mem_radical_iff P hA).mp hxr, map_zero]
  · exact congrArg (π P) (AuxLieAlgebra.chevalleyInvolution_eHom P z).symm

/-- It suffices to prove `𝔯̂₋ = 0`: then `𝔯̂ = 0` (using the Chevalley involution). -/
theorem radical_eq_bot_iff : radical P hA = ⊥ ↔ radicalNeg P = ⊥ := by
  constructor
  · intro h; rw [eq_bot_iff, ← h]; exact radicalNeg_le_radical P hA
  · intro h
    have hpos : radicalPos P = ⊥ := by
      rw [eq_bot_iff]
      intro x hx
      have := chevalleyInvolution_mem_radicalNeg P hA hx
      rw [h, LieSubmodule.mem_bot] at this
      rw [LieSubmodule.mem_bot, ← chevalleyInvolution_chevalleyInvolution P x, this, map_zero]
    rw [← LieSubmodule.toSubmodule_inj, radical_toSubmodule_eq P hA, h, hpos]
    simp

/-! ### `𝔰𝔩₂`-triples and integrality of weights -/

include hA in
/-- `(αᵢ^∨, eᵢ, fᵢ)` is an `𝔰𝔩₂`-triple in `𝔤̂(A)`. -/
theorem isSl2Triple (i : ι) : IsSl2Triple (h P (P.coroot i)) (e P i) (f P i) where
  h_ne_zero := by
    rw [ne_eq, ← map_zero (h P), (h_injective P hA).eq_iff]
    exact P.linearIndependent_coroot.ne_zero i
  lie_e_f := lie_e_f_self P i
  lie_h_e_nsmul := by
    rw [lie_h_e, P.root_coroot, hA.diag, two_nsmul, Int.cast_ofNat, two_smul]
  lie_h_f_nsmul := by
    rw [lie_h_f, P.root_coroot, hA.diag, two_nsmul, Int.cast_ofNat, two_smul]

include hA in
/-- If `x ≠ 0` has weight `μ` and `[eᵢ, x] = 0`, then `⟨μ, αᵢ^∨⟩ ∈ ℕ`: this follows from the local
nilpotency of `ad fᵢ` and `𝔰𝔩₂`-theory ([Kac] §3.6 (check)). -/
theorem exists_nat_of_lie_e_eq_zero (i : ι) {μ : Dual K H} {x : P.SerrePresentedAlgebra}
    (hx : x ∈ rootSpace P μ) (hx0 : x ≠ 0) (hex : ⁅e P i, x⁆ = 0) :
    ∃ n : ℕ, μ (P.coroot i) = n :=
  IsSl2Triple.HasPrimitiveVectorWith.exists_nat_of_exists_pow_eq_zero
    (t := isSl2Triple P hA i) ⟨hx0, hx (P.coroot i), hex⟩ (exists_ad_f_pow_eq_zero P i x)

include hA in
/-- If `x ≠ 0` has weight `μ` and `[fᵢ, x] = 0`, then `-⟨μ, αᵢ^∨⟩ ∈ ℕ`. -/
theorem exists_nat_of_lie_f_eq_zero (i : ι) {μ : Dual K H} {x : P.SerrePresentedAlgebra}
    (hx : x ∈ rootSpace P μ) (hx0 : x ≠ 0) (hfx : ⁅f P i, x⁆ = 0) :
    ∃ n : ℕ, μ (P.coroot i) = -n := by
  obtain ⟨n, hn⟩ := IsSl2Triple.HasPrimitiveVectorWith.exists_nat_of_exists_pow_eq_zero
    (t := (isSl2Triple P hA i).symm) (μ := -μ (P.coroot i))
    ⟨hx0, by rw [neg_lie, hx (P.coroot i), neg_smul], hfx⟩ (exists_ad_e_pow_eq_zero P i x)
  exact ⟨n, by rw [← hn, neg_neg]⟩

end SerrePresentedAlgebra


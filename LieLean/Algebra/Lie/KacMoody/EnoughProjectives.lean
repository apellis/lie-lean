import LieLean.Algebra.Lie.KacMoody.ProjectiveCover
import LieLean.Algebra.Lie.KacMoody.GabberKac
import LieLean.Algebra.Lie.KacMoody.BGG.LowDegree

/-!
# Enough projectives in category `𝒪`

Humphreys' category `𝒪` (GSM 94, §1.1) consists of the finitely generated modules among those
satisfying `IsCategoryO`. We prove that every such module is a quotient of a projective module in
`𝒪` (Humphreys, GSM 94, Theorem 3.8, projective part): a finite direct sum of the modules
`M(λ + nρ) ⊗ L(nρ)^*` of `projectiveCoverAmbient'`, which is again finitely generated and lies in
`𝒪`, and is projective against all surjections between modules satisfying `IsCategoryO`.

## Main results

* `Matrix.Realization.KacMoodyAlgebra.IsProjectiveO.directSum`: direct sums of projectives in `𝒪`
  are projective.
* `Matrix.Realization.KacMoodyAlgebra.exists_finset_lieSpan_tmul_eq_top`: if `v` generates `V` and
  `L` is finite-dimensional, then `V ⊗ L` is generated by finitely many vectors `v ⊗ l`.
* `Matrix.Realization.KacMoodyAlgebra.exists_isProjectiveO_surjective`: **enough projectives**
  (Humphreys, GSM 94, Theorem 3.8): in finite type over an algebraically closed field of
  characteristic zero, every finitely generated module in `𝒪` is a quotient of a finitely
  generated projective module in `𝒪`.

## Proof notes

Humphreys argues by induction on the length of `M`. We argue instead by induction on the dimension
of the sum `W` of the weight spaces `M_{μ + β}`, `β ∈ Q₊`, over the finitely many weights `μ` of a
generating set (finite-dimensional since `M` lies in `𝒪`). If `W ≠ 0`, a nonzero vector `v ∈ W` of
a weight of maximal height is primitive, so the submodule `N` it generates is a quotient of some
`M(ν + nρ) ⊗ L(nρ)^*`. The space `W` of `M/N` is a proper quotient of that of `M`; a projective
cover of `M/N` lifts to `M`, and together with the map onto `N` it covers `M`.

The parenthetical "and enough injectives" of Theorem 3.8 is not formalized here.

## References

* J. E. Humphreys, *Representations of semisimple Lie algebras in the BGG category 𝒪*, GSM 94,
  AMS 2008, §1.1, §3.8.
-/

noncomputable section

open Module LieModule TensorProduct

universe w

namespace Matrix.Realization.KacMoodyAlgebra

/-! ### Direct sums -/

section DirectSum

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H}
  {κ : Type*} {Q : κ → Type*} [∀ j, AddCommGroup (Q j)] [∀ j, Module K (Q j)]
  [∀ j, LieRingModule P.KacMoodyAlgebra (Q j)]

/-- A direct sum of projective modules in `𝒪` is projective in `𝒪`. -/
theorem IsProjectiveO.directSum (hQ : ∀ j, IsProjectiveO.{w} P (Q j)) :
    IsProjectiveO.{w} P (DirectSum κ Q) := by
  classical
  intro M N _ _ _ _ _ _ _ _ hM hN π hπ φ
  choose ψ hψ using fun j ↦
    hQ j hM hN π hπ (φ.comp (DirectSum.lieModuleOf K κ P.KacMoodyAlgebra Q j))
  refine ⟨DirectSum.toLieModule ψ, ?_⟩
  ext x
  induction x using DirectSum.induction_on with
  | zero => simp only [map_zero]
  | of j q =>
    rw [LieModuleHom.comp_apply, DirectSum.toLieModule_of]
    exact LieModuleHom.congr_fun (hψ j) q
  | add x y hx hy =>
    rw [map_add, map_add, hx, hy]

end DirectSum

/-! ### Finite generation -/

section FiniteGeneration

variable {K L V W : Type*} [Field K] [LieRing L] [LieAlgebra K L]
  [AddCommGroup V] [Module K V] [LieRingModule L V] [LieModule K L V]
  [AddCommGroup W] [Module K W] [LieRingModule L W] [LieModule K L W]

/-- If `v` generates `V` and `W` is finite-dimensional, then `V ⊗ W` is generated by the finitely
many vectors `v ⊗ bᵢ`, `(bᵢ)` a basis of `W`. -/
theorem exists_finset_lieSpan_tmul_eq_top [FiniteDimensional K W] {v : V}
    (hv : LieSubmodule.lieSpan K L {v} = ⊤) :
    ∃ T : Finset (V ⊗[K] W), LieSubmodule.lieSpan K L (T : Set (V ⊗[K] W)) = ⊤ := by
  classical
  let b := Module.finBasis K W
  refine ⟨Finset.univ.image fun i ↦ v ⊗ₜ[K] b i, ?_⟩
  set N := LieSubmodule.lieSpan K L
    ((Finset.univ.image fun i ↦ v ⊗ₜ[K] b i : Finset (V ⊗[K] W)) : Set (V ⊗[K] W))
  have hvN : ∀ l : W, v ⊗ₜ[K] l ∈ N := by
    intro l
    rw [← b.sum_repr l, tmul_sum]
    refine N.sum_mem fun i _ ↦ ?_
    rw [tmul_smul]
    exact N.smul_mem _ (LieSubmodule.subset_lieSpan (by simp))
  let S : LieSubmodule K L V :=
    { carrier := {x | ∀ l : W, x ⊗ₜ[K] l ∈ N}
      add_mem' := fun {x y} hx hy l ↦ by
        rw [add_tmul]
        exact N.add_mem (hx l) (hy l)
      zero_mem' := fun l ↦ by
        rw [zero_tmul]
        exact N.zero_mem
      smul_mem' := fun c x hx l ↦ by
        rw [← smul_tmul']
        exact N.smul_mem c (hx l)
      lie_mem := fun {y x} hx l ↦ by
        have h := N.sub_mem (N.lie_mem (x := y) (hx l)) (hx ⁅y, l⁆)
        rwa [TensorProduct.LieModule.lie_tmul_right, add_sub_cancel_right] at h }
  have hS : S = ⊤ := by
    rw [eq_top_iff, ← hv, LieSubmodule.lieSpan_le]
    rintro _ rfl
    exact hvN
  rw [eq_top_iff]
  rintro z -
  induction z using TensorProduct.inductionOn with
  | tmul x l =>
    have hx : x ∈ S := hS ▸ LieSubmodule.mem_top x
    exact hx l
  | add x y hx hy => exact N.add_mem hx hy

variable {κ : Type*} [Finite κ] {Q : κ → Type*} [∀ j, AddCommGroup (Q j)]
  [∀ j, Module K (Q j)] [∀ j, LieRingModule L (Q j)]

omit [LieAlgebra K L] in
/-- A finite direct sum of finitely generated modules is finitely generated. -/
theorem exists_finset_lieSpan_directSum_eq_top
    (hQ : ∀ j, ∃ T : Finset (Q j), LieSubmodule.lieSpan K L (T : Set (Q j)) = ⊤) :
    ∃ T : Finset (DirectSum κ Q), LieSubmodule.lieSpan K L (T : Set (DirectSum κ Q)) = ⊤ := by
  classical
  have := Fintype.ofFinite κ
  choose T hT using hQ
  refine ⟨Finset.univ.biUnion fun j ↦ (T j).image (DirectSum.of Q j), ?_⟩
  set N := LieSubmodule.lieSpan K L
    ((Finset.univ.biUnion fun j ↦ (T j).image (DirectSum.of Q j) : Finset (DirectSum κ Q)) :
      Set (DirectSum κ Q))
  have hof : ∀ j (q : Q j), DirectSum.of Q j q ∈ N := by
    intro j q
    have hle : LieSubmodule.lieSpan K L (T j : Set (Q j)) ≤
        N.comap (DirectSum.lieModuleOf K κ L Q j) := by
      rw [LieSubmodule.lieSpan_le]
      intro t ht
      rw [SetLike.mem_coe, LieSubmodule.mem_comap]
      exact LieSubmodule.subset_lieSpan (by
        simp only [Finset.coe_biUnion, Finset.coe_univ, Set.mem_univ, Finset.coe_image,
          Set.iUnion_true, Set.mem_iUnion, Set.mem_image]
        exact ⟨j, t, ht, rfl⟩)
    rw [hT j] at hle
    exact hle (LieSubmodule.mem_top q)
  rw [eq_top_iff]
  rintro x -
  induction x using DirectSum.induction_on with
  | zero => exact N.zero_mem
  | of j q => exact hof j q
  | add x y hx hy => exact N.add_mem hx hy

end FiniteGeneration

/-! ### Enough projectives -/

section Existence

variable {ι H : Type*} {K : Type} [Fintype ι] [DecidableEq ι] [Field K] [CharZero K]
  [IsAlgClosed K] [AddCommGroup H] [Module K H] [FiniteDimensional K H] {A : Matrix ι ι ℤ}
  (P : Realization A K H) (hA : A.IsFiniteCartan)
  {M : Type w} [AddCommGroup M] [Module K M] [LieRingModule P.KacMoodyAlgebra M]
  [LieModule K P.KacMoodyAlgebra M]

local notation "𝔤" => KacMoodyAlgebra P

variable (M) in
/-- The sum of the weight spaces `M_{μ + β}`, `μ ∈ F`, `β ∈ Q₊`. -/
def aboveSpan (F : Finset (Dual K H)) : Submodule K M :=
  ⨆ μ : F, ⨆ (k : ι → ℤ) (_ : 0 ≤ k), weightSpace P M ((μ : Dual K H) + P.rootOf k)

omit [IsAlgClosed K] [FiniteDimensional K H] in
/-- In a module in `𝒪`, only finitely many `k ≥ 0` have `M_{μ + Σ kᵢ αᵢ} ≠ 0`. -/
theorem IsCategoryO.finite_setOf_weightSpace_add_rootOf_ne_bot (hM : IsCategoryO P M)
    (μ : Dual K H) :
    {k : ι → ℤ | 0 ≤ k ∧ weightSpace P M (μ + P.rootOf k) ≠ ⊥}.Finite := by
  have hfin := (hM.finite_setOf_weightSpace_add_ne_bot μ).preimage
    P.rootOf_injective.injOn
  refine ((Set.finite_singleton (0 : ι → ℤ)).union hfin).subset ?_
  rintro k ⟨hk, hne⟩
  by_cases hk0 : k = 0
  · exact Or.inl hk0
  · refine Or.inr ⟨⟨k, ⟨hk, hk0⟩, rfl⟩, ?_⟩
    rwa [add_comm]

omit [IsAlgClosed K] [FiniteDimensional K H] in
theorem IsCategoryO.finiteDimensional_aboveSpan (hM : IsCategoryO P M) (F : Finset (Dual K H)) :
    FiniteDimensional K (aboveSpan P M F) := by
  have hinner : ∀ μ : Dual K H, ⨆ (k : ι → ℤ) (_ : 0 ≤ k), weightSpace P M (μ + P.rootOf k) ≤
      ⨆ k : {k : ι → ℤ | 0 ≤ k ∧ weightSpace P M (μ + P.rootOf k) ≠ ⊥},
        weightSpace P M (μ + P.rootOf k) := by
    intro μ
    refine iSup₂_le fun k hk ↦ ?_
    by_cases hb : weightSpace P M (μ + P.rootOf k) = ⊥
    · rw [hb]
      exact bot_le
    · exact le_iSup_of_le (⟨k, hk, hb⟩ : {k : ι → ℤ | 0 ≤ k ∧
        weightSpace P M (μ + P.rootOf k) ≠ ⊥}) le_rfl
  have hfd : ∀ μ : F, FiniteDimensional K
      ↥(⨆ (k : ι → ℤ) (_ : 0 ≤ k), weightSpace P M ((μ : Dual K H) + P.rootOf k) :
        Submodule K M) := by
    intro μ
    have := (hM.finite_setOf_weightSpace_add_rootOf_ne_bot P (μ : Dual K H)).to_subtype
    have := fun k ↦ hM.finiteDimensional_weightSpaceOfMap ((μ : Dual K H) + P.rootOf k)
    exact Submodule.finiteDimensional_of_le (hinner μ)
  exact Submodule.finiteDimensional_iSup _

omit [IsAlgClosed K] [FiniteDimensional K H] in
/-- If `aboveSpan` is nonzero, it contains a nonzero primitive vector. -/
theorem IsCategoryO.exists_primitive_mem_aboveSpan (hM : IsCategoryO P M)
    (F : Finset (Dual K H)) (hW : aboveSpan P M F ≠ ⊥) :
    ∃ ν : Dual K H, ∃ v ∈ primitiveVectors P M ν, v ≠ 0 ∧ v ∈ aboveSpan P M F := by
  classical
  have hex : ∃ μ ∈ F, ∃ k : ι → ℤ, 0 ≤ k ∧ weightSpace P M (μ + P.rootOf k) ≠ ⊥ := by
    by_contra hcon
    push Not at hcon
    refine hW (eq_bot_iff.mpr (iSup_le fun μ ↦ iSup₂_le fun k hk ↦ ?_))
    rw [hcon μ μ.2 k hk]
  obtain ⟨μ, hμF, k₀, hk₀, hne₀⟩ := hex
  set G := {k : ι → ℤ | 0 ≤ k ∧ weightSpace P M (μ + P.rootOf k) ≠ ⊥}
  have hG := hM.finite_setOf_weightSpace_add_rootOf_ne_bot P μ
  obtain ⟨k, hkG, hkmax⟩ := hG.toFinset.exists_max_image (fun k ↦ ∑ i, k i)
    ⟨k₀, hG.mem_toFinset.mpr ⟨hk₀, hne₀⟩⟩
  rw [Set.Finite.mem_toFinset] at hkG
  obtain ⟨v, hv, hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hkG.2
  refine ⟨μ + P.rootOf k, v, mem_primitiveVectors.mpr ⟨hv, fun i ↦ ?_⟩, hv0, ?_⟩
  · have hmem := toEnd_e_mem_weightSpace (P := P) i hv
    rw [toEnd_apply_apply] at hmem
    have hw : μ + P.rootOf k + P.root i = μ + P.rootOf (k + Pi.single i 1) := by
      rw [map_add, rootOf_single, add_assoc]
    rw [hw] at hmem
    by_contra hne
    have hmemG : k + Pi.single i 1 ∈ G := ⟨add_nonneg hkG.1 (by
      intro j
      by_cases hj : j = i
      · subst hj; simp
      · simp [hj]), fun hb ↦ hne (by rw [hb] at hmem; exact (Submodule.mem_bot K).mp hmem)⟩
    have hle := hkmax _ (hG.mem_toFinset.mpr hmemG)
    simp only [Pi.add_apply, Finset.sum_add_distrib, Finset.sum_pi_single',
      Finset.mem_univ, ↓reduceIte] at hle
    omega
  · exact (le_iSup_of_le (⟨μ, hμF⟩ : F) (le_iSup₂_of_le k hkG.1 le_rfl) :
      weightSpace P M (μ + P.rootOf k) ≤ aboveSpan P M F) hv

omit [IsAlgClosed K] [FiniteDimensional K H] in
/-- Passing to the quotient by a submodule containing a nonzero vector of `aboveSpan` lowers its
dimension. -/
theorem IsCategoryO.finrank_aboveSpan_quotient_lt (hM : IsCategoryO P M) (F : Finset (Dual K H))
    (N : LieSubmodule K 𝔤 M) {v : M} (hvW : v ∈ aboveSpan P M F) (hvN : v ∈ N) (hv0 : v ≠ 0) :
    finrank K (aboveSpan P (M ⧸ N) F) < finrank K (aboveSpan P M F) := by
  have := hM.finiteDimensional_aboveSpan P F
  have hle : aboveSpan P (M ⧸ N) F ≤ (aboveSpan P M F).map (quotMk P N) := by
    refine iSup_le fun μ ↦ iSup₂_le fun k hk ↦ ?_
    refine (map_weightSpaceOfMap_quotient P N hM.iSup_weightSpaceOfMap_eq_top _).ge.trans ?_
    exact Submodule.map_mono (le_iSup_of_le μ (le_iSup₂_of_le k hk le_rfl))
  refine (Submodule.finrank_mono hle).trans_lt ?_
  set f := (quotMk P N).domRestrict (aboveSpan P M F)
  have hrk := LinearMap.finrank_range_add_finrank_ker f
  rw [LinearMap.range_domRestrict] at hrk
  have hker : LinearMap.ker f ≠ ⊥ := by
    intro hb
    have hmem : (⟨v, hvW⟩ : aboveSpan P M F) ∈ LinearMap.ker f := by
      rw [LinearMap.mem_ker, LinearMap.domRestrict_apply]
      exact (LieSubmodule.Quotient.mk_eq_zero (N := N)).mpr hvN
    rw [hb, Submodule.mem_bot] at hmem
    exact hv0 (congrArg Subtype.val hmem)
  have hpos : 0 < finrank K (LinearMap.ker f) :=
    Nat.pos_of_ne_zero fun h0 ↦ hker (Submodule.finrank_eq_zero.mp h0)
  omega

omit [IsAlgClosed K] in
/-- A morphism `M(λ + nρ) ⊗ L(nρ)^* → M` whose image is the submodule generated by a primitive
vector of weight `λ`. -/
theorem exists_projectiveCoverAmbient'_range_eq_lieSpan {ν : Dual K H} {v : M}
    (hv : v ∈ primitiveVectors P M ν) :
    ∃ φ : projectiveCoverAmbient' P hA ν →ₗ⁅K,𝔤⁆ M,
      ∀ x ∈ LieSubmodule.lieSpan K 𝔤 {v}, ∃ p, φ p = x := by
  obtain ⟨s, hs⟩ := exists_surjective_projectiveCoverAmbient P hA ν (projectiveCoverShift P hA ν)
  set f := (VermaModule.homEquiv P M ν).symm ⟨v, hv⟩
  have hf : f (VermaModule.hwv P ν) = v :=
    congrArg Subtype.val ((VermaModule.homEquiv P M ν).apply_symm_apply ⟨v, hv⟩)
  refine ⟨f.comp s, fun x hx ↦ ?_⟩
  rw [← hf, ← VermaModule.range_eq_lieSpan] at hx
  obtain ⟨y, rfl⟩ := (LieModuleHom.mem_range f x).mp hx
  obtain ⟨p, rfl⟩ := hs y
  exact ⟨p, rfl⟩

/-- A module in `𝒪` covered by a finite direct sum of the projectives
`M(λ + nρ) ⊗ L(nρ)^*`. -/
def IsCovered (M : Type*) [AddCommGroup M] [Module K M] [LieRingModule 𝔤 M] [LieModule K 𝔤 M] :
    Prop :=
  ∃ (κ : Type) (_ : Fintype κ) (_ : DecidableEq κ) (τ : κ → Dual K H)
    (π : DirectSum κ (fun j ↦ projectiveCoverAmbient' P hA (τ j)) →ₗ⁅K,𝔤⁆ M),
    Function.Surjective π

omit [IsAlgClosed K] [FiniteDimensional K H] in
theorem isCovered_of_subsingleton [Subsingleton M] : IsCovered P hA M :=
  ⟨Empty, inferInstance, inferInstance, Empty.elim, 0, fun _ ↦ ⟨0, Subsingleton.elim _ _⟩⟩

omit [IsAlgClosed K] [FiniteDimensional K H] in
/-- If the weight spaces `M_μ`, `μ ∈ F`, generate `M` and `aboveSpan` vanishes, `M` is zero and
hence covered. -/
theorem isCovered_of_subsingleton_of_aboveSpan_eq_bot {F : Finset (Dual K H)}
    (hspan : LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M)) = ⊤)
    (hbot : aboveSpan P M F = ⊥) : IsCovered P hA M := by
  have hzero : ∀ m : M, m = 0 := by
    intro m
    have hle : LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M)) ≤ ⊥ := by
      rw [LieSubmodule.lieSpan_le]
      intro x hx
      simp only [Set.mem_iUnion, SetLike.mem_coe] at hx
      obtain ⟨μ, hμ, hx⟩ := hx
      have hxW : x ∈ aboveSpan P M F := by
        refine (le_iSup_of_le (⟨μ, hμ⟩ : F) (le_iSup₂_of_le (0 : ι → ℤ) le_rfl le_rfl) :
          weightSpace P M (μ + P.rootOf 0) ≤ aboveSpan P M F) ?_
        rwa [map_zero, add_zero]
      rw [hbot] at hxW
      exact hxW
    rw [hspan] at hle
    exact (LieSubmodule.mem_bot m).mp (hle (LieSubmodule.mem_top m))
  have : Subsingleton M := ⟨fun a b ↦ by rw [hzero a, hzero b]⟩
  exact isCovered_of_subsingleton P hA

/-- If `M/N` is covered and `N` is generated by a primitive vector, then `M` is covered. -/
theorem IsCategoryO.isCovered_of_quotient (hM : IsCategoryO P M) (N : LieSubmodule K 𝔤 M)
    {ν : Dual K H} {v : M} (hv : v ∈ primitiveVectors P M ν)
    (hN : N = LieSubmodule.lieSpan K 𝔤 {v}) (hcov : IsCovered P hA (M ⧸ N)) :
    IsCovered P hA M := by
  classical
  obtain ⟨κ, _, _, τ, g, hg⟩ := hcov
  obtain ⟨φv, hφv⟩ := exists_projectiveCoverAmbient'_range_eq_lieSpan P hA hv
  obtain ⟨ψ, hψ⟩ := IsProjectiveO.directSum (Q := fun j ↦ projectiveCoverAmbient' P hA (τ j))
    (fun j ↦ isProjectiveO_projectiveCoverAmbient' P hA (τ j)) hM (hM.quotient N)
    (LieSubmodule.Quotient.mk' N) (LieSubmodule.Quotient.surjective_mk' N) g
  obtain ⟨π, hπnone, hπsome⟩ : ∃ π : DirectSum (Option κ)
      (fun o ↦ projectiveCoverAmbient' P hA (o.elim ν τ)) →ₗ⁅K,𝔤⁆ M,
      (∀ p, π (DirectSum.of (fun o : Option κ ↦ projectiveCoverAmbient' P hA (o.elim ν τ))
        none p) = φv p) ∧
      ∀ j x, π (DirectSum.of (fun o : Option κ ↦ projectiveCoverAmbient' P hA (o.elim ν τ))
        (some j) x) = ψ (DirectSum.of (fun j ↦ projectiveCoverAmbient' P hA (τ j)) j x) :=
    ⟨DirectSum.toLieModule fun o ↦ match o with
      | none => φv
      | some j => ψ.comp (DirectSum.lieModuleOf K κ 𝔤
          (fun j ↦ projectiveCoverAmbient' P hA (τ j)) j),
      fun p ↦ DirectSum.toLieModule_of _ _ _, fun j x ↦ DirectSum.toLieModule_of _ _ _⟩
  refine ⟨Option κ, inferInstance, inferInstance, fun o ↦ o.elim ν τ, π, fun m ↦ ?_⟩
  have hψr : ∀ q, ψ q ∈ π.range := by
    intro q
    induction q using DirectSum.induction_on with
    | zero => rw [map_zero]; exact π.range.zero_mem
    | of j x => exact (LieModuleHom.mem_range π _).mpr ⟨_, hπsome j x⟩
    | add x y hx hy => rw [map_add]; exact π.range.add_mem hx hy
  obtain ⟨q, hq⟩ := hg (LieSubmodule.Quotient.mk' N m)
  have hmq : m - ψ q ∈ N := by
    rw [← LieSubmodule.Quotient.mk_eq_zero, map_sub, ← hq, ← LieModuleHom.comp_apply, hψ,
      sub_self]
  rw [hN] at hmq
  obtain ⟨p, hp⟩ := hφv _ hmq
  obtain ⟨r, hr⟩ := (LieModuleHom.mem_range π _).mp
    (π.range.add_mem ((LieModuleHom.mem_range π _).mpr ⟨_, hπnone p⟩) (hψr q))
  refine ⟨r, ?_⟩
  rw [hr, hp, sub_add_cancel]

/-- Induction step of the proof of Theorem 3.8: a module in `𝒪` generated by the weight spaces
`M_μ`, `μ ∈ F`, is covered, by induction on the dimension of `aboveSpan P M F`. -/
theorem isCovered_of_finrank_aboveSpan_le (d : ℕ) : ∀ (M : Type w) [AddCommGroup M] [Module K M]
    [LieRingModule 𝔤 M] [LieModule K 𝔤 M], IsCategoryO P M → ∀ F : Finset (Dual K H),
    LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M)) = ⊤ →
    finrank K (aboveSpan P M F) ≤ d → IsCovered P hA M := by
  induction d with
  | zero =>
    intro M _ _ _ _ hM F hspan hd
    have := hM.finiteDimensional_aboveSpan P F
    have hbot : aboveSpan P M F = ⊥ := Submodule.finrank_eq_zero.mp (Nat.le_zero.mp hd)
    exact isCovered_of_subsingleton_of_aboveSpan_eq_bot P hA hspan hbot
  | succ d ih =>
    intro M _ _ _ _ hM F hspan hd
    by_cases hbot : aboveSpan P M F = ⊥
    · exact isCovered_of_subsingleton_of_aboveSpan_eq_bot P hA hspan hbot
    obtain ⟨ν, v, hv, hv0, hvW⟩ := hM.exists_primitive_mem_aboveSpan P F hbot
    set N := LieSubmodule.lieSpan K 𝔤 {v}
    refine hM.isCovered_of_quotient P hA N hv rfl
      (ih (M ⧸ N) (hM.quotient N) F ?_ ?_)
    · rw [eq_top_iff]
      rintro x -
      obtain ⟨m, rfl⟩ := LieSubmodule.Quotient.surjective_mk' N x
      have hle : LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M)) ≤
          (LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P (M ⧸ N) μ : Set (M ⧸ N)))).comap
            (LieSubmodule.Quotient.mk' N) := by
        rw [LieSubmodule.lieSpan_le]
        intro y hy
        simp only [Set.mem_iUnion, SetLike.mem_coe] at hy
        obtain ⟨μ, hμ, hy⟩ := hy
        rw [SetLike.mem_coe, LieSubmodule.mem_comap]
        refine LieSubmodule.subset_lieSpan ?_
        simp only [Set.mem_iUnion, SetLike.mem_coe]
        exact ⟨μ, hμ, map_mem_weightSpaceOfMap P (LieSubmodule.Quotient.mk' N) hy⟩
      rw [hspan] at hle
      exact hle (LieSubmodule.mem_top m)
    · have := hM.finrank_aboveSpan_quotient_lt P F N hvW (LieSubmodule.subset_lieSpan rfl) hv0
      omega

universe w'

/-- **Enough projectives in `𝒪`** (Humphreys, GSM 94, Theorem 3.8, projective part). In finite
type over an algebraically closed field of characteristic zero, every finitely generated module
`M` in `𝒪` (Humphreys' `𝒪`, §1.1) is a quotient of a finite direct sum `P` of the modules
`M(λ + nρ) ⊗ L(nρ)^*`. The module `P` is finitely generated and lies in `𝒪`, and it is
projective against all surjections between modules satisfying `IsCategoryO`.

Humphreys works over `ℂ` and proves this by induction on the length of `M`; the proof here is by
induction on the dimension of the weight spaces above a generating set (reconstructed). The
statement "and enough injectives" of the theorem is not included. -/
theorem exists_isProjectiveO_surjective (hM : IsCategoryO P M) {S : Finset M}
    (hS : LieSubmodule.lieSpan K 𝔤 (S : Set M) = ⊤) :
    ∃ (κ : Type) (_ : Fintype κ) (_ : DecidableEq κ) (τ : κ → Dual K H),
      IsCategoryO P (DirectSum κ fun j ↦ projectiveCoverAmbient' P hA (τ j)) ∧
      IsProjectiveO.{w'} P (DirectSum κ fun j ↦ projectiveCoverAmbient' P hA (τ j)) ∧
      (∃ T : Finset (DirectSum κ fun j ↦ projectiveCoverAmbient' P hA (τ j)),
        LieSubmodule.lieSpan K 𝔤 (T : Set (DirectSum κ fun j ↦
          projectiveCoverAmbient' P hA (τ j))) = ⊤) ∧
      ∃ π : (DirectSum κ fun j ↦ projectiveCoverAmbient' P hA (τ j)) →ₗ⁅K,𝔤⁆ M,
        Function.Surjective π := by
  classical
  have hgen : ∀ s ∈ S, ∃ F : Finset (Dual K H), s ∈ ⨆ μ ∈ F, weightSpace P M μ := by
    intro s _
    have hs : s ∈ ⨆ μ, weightSpace P M μ := by
      rw [hM.iSup_weightSpaceOfMap_eq_top]
      trivial
    exact Submodule.mem_iSup_iff_exists_finset.mp hs
  choose! Fs hFs using hgen
  set F := S.biUnion Fs
  have hspan : LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M)) = ⊤ := by
    rw [eq_top_iff, ← hS, LieSubmodule.lieSpan_le]
    intro s hs
    have hle : (⨆ μ ∈ Fs s, weightSpace P M μ) ≤
        (LieSubmodule.lieSpan K 𝔤 (⋃ μ ∈ F, (weightSpace P M μ : Set M))).toSubmodule :=
      iSup₂_le fun μ hμ x hx ↦ LieSubmodule.subset_lieSpan
        (Set.mem_iUnion₂.mpr ⟨μ, Finset.mem_biUnion.mpr ⟨s, hs, hμ⟩, hx⟩)
    exact hle (hFs s hs)
  obtain ⟨κ, _, _, τ, π, hπ⟩ := isCovered_of_finrank_aboveSpan_le P hA _ M hM F hspan le_rfl
  have hfg : ∀ Λ : Dual K H, ∃ T : Finset (projectiveCoverAmbient' P hA Λ),
      LieSubmodule.lieSpan K 𝔤 (T : Set (projectiveCoverAmbient' P hA Λ)) = ⊤ := by
    intro Λ
    have := IrreducibleModule.finiteDimensional (P := P) hA
      (isDominantIntegral_nsmul_rho P (projectiveCoverShift P hA Λ))
    exact exists_finset_lieSpan_tmul_eq_top
      (VermaModule.lieSpan_map_hwv_eq_top LieModuleHom.id Function.surjective_id)
  exact ⟨κ, inferInstance, inferInstance, τ,
    IsCategoryO.directSum _ fun j ↦ isCategoryO_projectiveCoverAmbient P hA _ _,
    IsProjectiveO.directSum fun j ↦ isProjectiveO_projectiveCoverAmbient' P hA _,
    exists_finset_lieSpan_directSum_eq_top fun j ↦ hfg (τ j), π, hπ⟩

end Existence

end Matrix.Realization.KacMoodyAlgebra

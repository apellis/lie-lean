import LieLean.Algebra.Lie.KacMoody.TranslationProjective
import LieLean.Algebra.Lie.KacMoody.ProjectiveCharacter
import LieLean.Algebra.Lie.KacMoody.EnoughProjectives

/-!
# Translation functors and indecomposable projectives

Humphreys, GSM 94, Theorem 7.11: let `λ`, `μ` be antidominant and compatible, with `μ♮` in the
closure of the facet `F` of `λ♮`. If `w ∈ W_[λ]` and `w·μ♮` lies in the upper closure of `w·F`,
then `T_μ^λ P(w·μ) ≅ P(w·λ)`.

## Main results

* `Matrix.Realization.KacMoodyAlgebra.ProjectiveCover.exists_lieSpan_singleton_eq_top`: `P(λ)` is
  generated by one vector.
* `Matrix.Realization.KacMoodyAlgebra.ProjectiveCover.centralBlock_eq_top`: `P(λ)` lies in the
  block of `χ_λ`.
* `Matrix.Realization.KacMoodyAlgebra.exists_finset_lieSpan_centralTranslation_eq_top`:
  translation of a cyclic module by a finite-dimensional module is finitely generated.
* `Matrix.Realization.KacMoodyAlgebra.finrank_hom_centralTranslation_projectiveCover`:
  `dim Hom(T P(Λ), L(η)) = [T' L(η) : L(Λ)]` for a translation `T` and its adjoint `T'`.
* `Matrix.Realization.KacMoodyAlgebra.nonempty_equiv_projectiveCover_translation_projectiveCover`:
  **Theorem 7.11**.

## Proof

As in Humphreys: `T_μ^λ P(w·μ)` is projective, and by adjunction and Theorem 3.9 (c)
`dim Hom(T_μ^λ P(w·μ), L(η)) = [T_λ^μ L(η) : L(w·μ)]`. By Theorem 7.9 this is `1` for `η = w·λ`
and `0` otherwise. Humphreys then reads off the indecomposable summands with Theorem 3.9 (b) and
proves uniqueness with the chamber geometry of Proposition 7.3; here the uniqueness is the
root-lattice comparison `exists_apply_sub_eq_rootOf_of_upperClosureCondition_of_integral`, and the
conclusion comes from the fact that finitely generated projectives in `𝒪` with the same
`dim Hom(−, L(η))` for all `η` are isomorphic (`IsFGProjectiveO.nonempty_equiv_of_finrank_hom_eq`).

## References

* J. E. Humphreys, *Representations of semisimple Lie algebras in the BGG category 𝒪*, GSM 94,
  AMS 2008, §7.11.
-/

noncomputable section

open Module LieModule TensorProduct

universe u₁ u₂

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [CharZero K]
  [AddCommGroup H] [Module K H] {A : Matrix ι ι ℤ} {P : Realization A K H}
  (hF : A.IsFiniteCartan)

/-- **Uniqueness of the upper-closure representative.** Let `λ` be antidominant with `λ - μ`
integral. If `w(μ + ρ) = w'(μ + ρ)` and both `w·μ`, `w'·μ` lie in the upper closures of the facets
of `w·λ`, `w'·λ` (in the form `UpperClosureCondition`), then `w·λ = w'·λ`. -/
theorem weylDot_eq_of_upperClosureCondition [FiniteDimensional K H] {lam μ : Dual K H}
    (hlam : P.IsAntidominant hF.isGeneralizedCartan lam)
    (hint : ∀ j, ∃ n : ℤ, ((lam + P.rho) - (μ + P.rho)) (P.coroot j) = n)
    {w w' : P.weylGroup hF.isGeneralizedCartan}
    (hC : P.UpperClosureCondition hF.isGeneralizedCartan (w.val (lam + P.rho))
      (w.val (μ + P.rho)))
    (hC' : P.UpperClosureCondition hF.isGeneralizedCartan (w'.val (lam + P.rho))
      (w'.val (μ + P.rho)))
    (hb : w'.val (μ + P.rho) = w.val (μ + P.rho)) :
    P.weylDot hF.isGeneralizedCartan w' lam = P.weylDot hF.isGeneralizedCartan w lam := by
  have ha : ∀ v i, P.IsPosRoot hF.isGeneralizedCartan v i → ∀ n : ℤ,
      P.corootPairing hF.isGeneralizedCartan (lam + P.rho) v i = n → n ≤ 0 := hlam
  obtain ⟨c₁, hc₁, h₁⟩ := exists_apply_sub_eq_rootOf_of_upperClosureCondition_of_integral
    (P := P) hF hint ha hC hb
  obtain ⟨c₂, hc₂, h₂⟩ := exists_apply_sub_eq_rootOf_of_upperClosureCondition_of_integral
    (P := P) hF hint ha hC' hb.symm
  have h0 : P.rootOf (c₁ + c₂) = P.rootOf 0 := by
    rw [map_add, ← h₁, ← h₂, map_zero]; abel
  have hc0 : c₁ = 0 := by
    have := P.rootOf_injective h0
    ext j
    have h1 := congrFun this j
    have h2 : (0 : ℤ) ≤ c₁ j := hc₁ j
    have h3 : (0 : ℤ) ≤ c₂ j := hc₂ j
    simp only [Pi.add_apply, Pi.zero_apply] at h1 ⊢
    omega
  rw [hc0, map_zero, sub_eq_zero] at h₁
  simp only [weylDot, h₁]

end Matrix.Realization

namespace Matrix.Realization.KacMoodyAlgebra

open VermaModule

/-- The image of a generating set under a surjective morphism generates. -/
theorem lieSpan_image_eq_top_of_surjective {R L M N : Type*} [CommRing R] [LieRing L]
    [AddCommGroup M] [Module R M] [LieRingModule L M] [AddCommGroup N] [Module R N]
    [LieRingModule L N] (f : M →ₗ⁅R,L⁆ N) (hf : Function.Surjective f) {s : Set M}
    (hs : LieSubmodule.lieSpan R L s = ⊤) : LieSubmodule.lieSpan R L (f '' s) = ⊤ := by
  rw [eq_top_iff]
  rintro y -
  obtain ⟨x, rfl⟩ := hf y
  have hle : LieSubmodule.lieSpan R L s ≤ (LieSubmodule.lieSpan R L (f '' s)).comap f := by
    rw [LieSubmodule.lieSpan_le]
    intro a ha
    exact LieSubmodule.subset_lieSpan (Set.mem_image_of_mem f ha)
  exact hle (hs ▸ LieSubmodule.mem_top x)

section Block

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [CharZero K] [IsAlgClosed K]
  [AddCommGroup H] [Module K H] {A : Matrix ι ι ℤ} (P : Realization A K H)

local notation "𝔤" => KacMoodyAlgebra P
local notation "𝓤" => UniversalEnvelopingAlgebra K P.KacMoodyAlgebra
local notation "𝓩" => Subalgebra.center K 𝓤

/-- The translation `pr_{χ₂}(pr_{χ₁} V ⊗ Z)` of a cyclic module `V` in the block `χ₁` by a
finite-dimensional module `Z` in `𝒪` is finitely generated. -/
theorem exists_finset_lieSpan_centralTranslation_eq_top {V Z : Type*} [AddCommGroup V]
    [Module K V] [LieRingModule 𝔤 V] [LieModule K 𝔤 V] [AddCommGroup Z] [Module K Z]
    [LieRingModule 𝔤 Z] [LieModule K 𝔤 Z] [FiniteDimensional K Z] (hV : IsCategoryO P V)
    (hZ : IsCategoryO P Z) {χ₁ : 𝓩 →ₐ[K] K} (χ₂ : 𝓩 →ₐ[K] K) (hVχ : centralBlock P V χ₁ = ⊤)
    {x : V} (hx : LieSubmodule.lieSpan K 𝔤 {x} = ⊤) :
    ∃ T : Finset (centralTranslation P Z χ₁ χ₂ V),
      LieSubmodule.lieSpan K 𝔤 (T : Set (centralTranslation P Z χ₁ χ₂ V)) = ⊤ := by
  classical
  let e := equivCentralBlockOfEqTop P hVχ
  have hx' : LieSubmodule.lieSpan K 𝔤 {e.symm x} = ⊤ := by
    have := lieSpan_image_eq_top_of_surjective e.symm.toLieModuleHom e.symm.surjective hx
    rwa [Set.image_singleton] at this
  have hS0 := exists_finset_lieSpan_tmul_eq_top (L := 𝔤) (W := Z) hx'
  have hXO : IsCategoryO P (centralBlock P V χ₁ ⊗[K] Z) :=
    (hV.centralBlock P χ₁).tensorProduct hZ
  let r : (centralBlock P V χ₁ ⊗[K] Z) →ₗ⁅K,𝔤⁆ centralTranslation P Z χ₁ χ₂ V :=
    blockRetr P hXO χ₂
  have hr : Function.Surjective r := fun y ↦ ⟨y, blockRetr_incl P hXO χ₂ y⟩
  refine ⟨hS0.choose.image r, ?_⟩
  rw [Finset.coe_image]
  exact lieSpan_image_eq_top_of_surjective r hr hS0.choose_spec

omit [IsAlgClosed K] in
/-- A morphism from a module in the block of `χ` to a simple module `L(η)` with `χ_η ≠ χ`
vanishes. -/
theorem eq_zero_of_centralBlock_eq_top_of_ne {V : Type*} [AddCommGroup V] [Module K V]
    [LieRingModule 𝔤 V] [LieModule K 𝔤 V] {χ : 𝓩 →ₐ[K] K} (hV : centralBlock P V χ = ⊤)
    {η : Dual K H} (hne : centralCharacter P η ≠ χ) (f : V →ₗ⁅K,𝔤⁆ IrreducibleModule P η) :
    f = 0 := by
  ext y
  have := map_mem_centralBlock P f χ (hV ▸ LieSubmodule.mem_top y)
  rwa [centralBlock_irreducible_eq_bot P η χ hne, LieSubmodule.mem_bot] at this

end Block

section Cover

variable {ι : Type u₁} {H : Type u₂} {K : Type} [Fintype ι] [DecidableEq ι] [Field K]
  [CharZero K] [IsAlgClosed K] [AddCommGroup H] [Module K H] [FiniteDimensional K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (hA : A.IsFiniteCartan)

local notation "𝔤" => KacMoodyAlgebra P
local notation "𝓩" => Subalgebra.center K (UniversalEnvelopingAlgebra K P.KacMoodyAlgebra)

namespace ProjectiveCover

/-- `P(λ)` is generated by a single vector (any preimage of the highest weight vector of
`L(λ)`). -/
theorem exists_lieSpan_singleton_eq_top (Λ : Dual K H) :
    ∃ x : ProjectiveCover P hA Λ, LieSubmodule.lieSpan K 𝔤 {x} = ⊤ := by
  obtain ⟨x, hx⟩ := surjective_π P hA Λ (IrreducibleModule.hwv P Λ)
  refine ⟨x, eq_top_of_not_le_ker P hA Λ _ fun hle ↦ IrreducibleModule.hwv_ne_zero P Λ ?_⟩
  rw [← hx]
  exact LieModuleHom.mem_ker.mp (hle (LieSubmodule.subset_lieSpan (Set.mem_singleton x)))

/-- `P(λ)` lies in the block of the central character `χ_λ`. -/
theorem centralBlock_eq_top (Λ : Dual K H) :
    centralBlock P (ProjectiveCover P hA Λ) (centralCharacter P Λ) = ⊤ := by
  have hO := (isCategoryO P hA Λ).isCentralLocallyFinite P
  have hL := (IrreducibleModule.isCategoryO P Λ).isCentralLocallyFinite P
  refine eq_top_of_not_le_ker P hA Λ _ fun hle ↦ ?_
  obtain ⟨x, hx⟩ := surjective_π P hA Λ (IrreducibleModule.hwv P Λ)
  have h0 := LieModuleHom.mem_ker.mp
    (hle (centralBlockProjection_mem P hO (centralCharacter P Λ) x))
  have hnat := LieModuleHom.congr_fun
    (centralBlockProjection_natural P hO hL (π P hA Λ) (centralCharacter P Λ)) x
  rw [LieModuleHom.comp_apply, LieModuleHom.comp_apply, hx, centralBlockProjection_self P hL _
    (by rw [centralBlock_irreducible]; trivial)] at hnat
  exact IrreducibleModule.hwv_ne_zero P Λ (hnat.symm.trans h0)

/-- `P(λ)` is a finitely generated projective module in `𝒪`. -/
theorem isFGProjectiveO (Λ : Dual K H) : IsFGProjectiveO P (ProjectiveCover P hA Λ) := by
  obtain ⟨x, hx⟩ := exists_lieSpan_singleton_eq_top P hA Λ
  exact ⟨isProjectiveO P hA Λ, isCategoryO P hA Λ, ⟨{x}, by simpa using hx⟩⟩

end ProjectiveCover

/-- The translation `pr_{χ₂}(pr_{χ₁} P(Λ) ⊗ L(ν))` of `P(Λ)`, for `P(Λ)` in the block of `χ₁` and
`ν` dominant integral, is a finitely generated projective module in `𝒪`. -/
theorem isFGProjectiveO_centralTranslation_projectiveCover {Λ ν : Dual K H}
    (hν : P.IsDominantIntegral ν) {χ₁ : 𝓩 →ₐ[K] K} (χ₂ : 𝓩 →ₐ[K] K)
    (hMχ : centralBlock P (ProjectiveCover P hA Λ) χ₁ = ⊤) :
    IsFGProjectiveO P
      (centralTranslation P (IrreducibleModule P ν) χ₁ χ₂ (ProjectiveCover P hA Λ)) := by
  have hd := IrreducibleModule.exists_equiv_dual P hA hν
  have := IrreducibleModule.finiteDimensional (P := P) hA hν
  have hLO := IrreducibleModule.isCategoryO P ν
  have hL'O : IsCategoryO P (Module.Dual K (IrreducibleModule P ν)) :=
    IsCategoryO.of_equiv (IrreducibleModule.isCategoryO P _) hd.choose_spec.2.2.some.symm
  have hMO := ProjectiveCover.isCategoryO P hA Λ
  have hMp : IsProjectiveO.{max u₁ u₂} P (ProjectiveCover P hA Λ) :=
    ProjectiveCover.isProjectiveO P hA Λ
  have hx₀ := ProjectiveCover.exists_lieSpan_singleton_eq_top P hA Λ
  have hT := exists_finset_lieSpan_centralTranslation_eq_top P hMO hLO χ₂ hMχ hx₀.choose_spec
  exact ⟨isProjectiveO_centralBlock P (hV := (hMO.centralBlock P _).tensorProduct hLO)
      ((hMp.of_equiv (equivCentralBlockOfEqTop P hMχ).symm).tensorProduct P hL'O) _,
    hMO.centralTranslation P hLO χ₁ χ₂, ⟨hT.choose, hT.choose_spec⟩⟩

/-- `dim Hom(T P(Λ), L(η)) = [T' L(η) : L(Λ)]` for the translation `T = pr_{χ₂}(pr_{χ₁}(−) ⊗ L(ν))`
and its adjoint `T'` by `L(ν)^* ≅ L(ν')` (adjunction and Theorem 3.9 (c)). -/
theorem finrank_hom_centralTranslation_projectiveCover {Λ ν ν' η : Dual K H}
    (hν : P.IsDominantIntegral ν)
    (eν : Module.Dual K (IrreducibleModule P ν) ≃ₗ⁅K,𝔤⁆ IrreducibleModule P ν')
    {χ₁ χ₂ : 𝓩 →ₐ[K] K} (hMχ : centralBlock P (ProjectiveCover P hA Λ) χ₁ = ⊤)
    (hNχ : centralBlock P (IrreducibleModule P η) χ₂ = ⊤) :
    finrank K (centralTranslation P (IrreducibleModule P ν) χ₁ χ₂ (ProjectiveCover P hA Λ)
      →ₗ⁅K,𝔤⁆ IrreducibleModule P η) =
      ((IrreducibleModule.isCategoryO P η).centralTranslation P
        (IrreducibleModule.isCategoryO P ν') χ₂ χ₁).multiplicity Λ := by
  have := IrreducibleModule.finiteDimensional (P := P) hA hν
  have hLO := IrreducibleModule.isCategoryO P ν
  have hL'O : IsCategoryO P (Module.Dual K (IrreducibleModule P ν)) :=
    IsCategoryO.of_equiv (IrreducibleModule.isCategoryO P _) eν.symm
  have hMO := ProjectiveCover.isCategoryO P hA Λ
  have hT'O := (IrreducibleModule.isCategoryO P η).centralTranslation P hL'O χ₂ χ₁
  rw [(translationAdjunction P hMO hLO hMχ hNχ).finrank_eq,
    ProjectiveCover.finrank_hom_eq_multiplicity P Λ hA hT'O]
  exact IsCategoryO.multiplicity_congr hT'O _
    (centralTranslationCoeffEquiv P (IrreducibleModule P η) χ₂ χ₁ eν) Λ

include hA in
/-- **Humphreys, GSM 94, Theorem 7.11.** Let `λ`, `μ` be antidominant, with every positive root
orthogonal to `λ + ρ` orthogonal to `μ + ρ` (`μ♮` in the closure of the facet `F` of `λ♮`), let
`ν = z (λ - μ)` (`z ∈ W`) be dominant integral and `T_μ^λ = pr_{χ_λ}(pr_{χ_μ}(−) ⊗ L(ν))`. If
`w ∈ W_[λ]` and `w·μ` lies in the upper closure of the facet of `w·λ`, then
`T_μ^λ P(w·μ) ≅ P(w·λ)`.

Humphreys states this over `ℂ` for `𝔤` semisimple. The proof follows Humphreys (adjunction,
Theorem 3.9 and Theorem 7.9); the uniqueness step uses a root-lattice comparison instead of the
chamber geometry of Proposition 7.3. -/
theorem nonempty_equiv_projectiveCover_translation_projectiveCover {lam μ ν : Dual K H}
    (hlam : P.IsAntidominant hA.isGeneralizedCartan lam)
    (hμ : P.IsAntidominant hA.isGeneralizedCartan μ)
    (hfacet : ∀ v i, P.IsPosRoot hA.isGeneralizedCartan v i →
      P.corootPairing hA.isGeneralizedCartan (lam + P.rho) v i = 0 →
        P.corootPairing hA.isGeneralizedCartan (μ + P.rho) v i = 0)
    (hν : P.IsDominantIntegral ν) {z : Dual K H ≃ₗ[K] Dual K H}
    (hz : z ∈ P.weylGroup hA.isGeneralizedCartan) (hzν : z (lam - μ) = ν)
    {w : P.weylGroup hA.isGeneralizedCartan}
    (hwint : w ∈ P.integralWeylGroup hA.isGeneralizedCartan lam)
    (hup : P.MemUpperClosure hA.isGeneralizedCartan (P.weylDot hA.isGeneralizedCartan w lam)
      (P.weylDot hA.isGeneralizedCartan w μ)) :
    Nonempty (ProjectiveCover P hA (P.weylDot hA.isGeneralizedCartan w lam) ≃ₗ⁅K,𝔤⁆
      centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
        (centralCharacter P lam)
        (ProjectiveCover P hA (P.weylDot hA.isGeneralizedCartan w μ))) := by
  classical
  have hA' := hA.isGeneralizedCartan
  let Λw := P.weylDot hA' w μ
  have hΛw : Λw = P.weylDot hA' w μ := rfl
  -- the dual of `L(ν)` and the integrality of `λ - μ`
  have hd := IrreducibleModule.exists_equiv_dual P hA hν
  let z' := hd.choose
  have hz' : z' ∈ P.weylGroup hA' := hd.choose_spec.1
  have hν' : P.IsDominantIntegral (z' (-ν)) := hd.choose_spec.2.1
  let eν := hd.choose_spec.2.2.some
  have hzz : z' * z ∈ P.weylGroup hA' := mul_mem hz' hz
  have hzν' : (z' * z) (μ - lam) = z' (-ν) := by
    change z' (z (μ - lam)) = z' (-ν)
    rw [← hzν, ← map_neg, neg_sub]
  have hint := sub_rho_integral P hA hν' hzz hzν'
  have hC : P.UpperClosureCondition hA' (w.val (lam + P.rho)) (w.val (μ + P.rho)) :=
    (memUpperClosure_weylDot_iff_of_isAntidominant hA hlam hμ hint hfacet w).mp hup
  -- `W_[λ] = W_[λ + ρ] = W_[μ + ρ]`
  have hWl : P.integralWeylGroup hA' lam = P.integralWeylGroup hA' (lam + P.rho) :=
    P.integralWeylGroup_eq_of_integral hA' fun j ↦ ⟨-1, by simp⟩
  have hWm : P.integralWeylGroup hA' (lam + P.rho) = P.integralWeylGroup hA' (μ + P.rho) :=
    P.integralWeylGroup_eq_of_integral hA' hint
  have hwb : w ∈ P.integralWeylGroup hA' (μ + P.rho) := hWm ▸ hWl ▸ hwint
  -- the modules
  have hMχ : centralBlock P (ProjectiveCover P hA Λw) (centralCharacter P μ) = ⊤ :=
    (VermaModule.centralCharacter_weyl P hA' w.property μ) ▸
      ProjectiveCover.centralBlock_eq_top P hA Λw
  have hV := isFGProjectiveO_centralTranslation_projectiveCover P hA hν
    (centralCharacter P lam) hMχ
  -- multiplicities of the adjoint translation
  let mult : Dual K H → ℕ := fun η ↦ ((IrreducibleModule.isCategoryO P η).centralTranslation P
    (IrreducibleModule.isCategoryO P (z' (-ν))) (centralCharacter P lam)
    (centralCharacter P μ)).multiplicity Λw
  -- `dim Hom(T P(w·μ), L(η)) = [T' L(η) : L(w·μ)]`
  have hHom : ∀ η, centralBlock P (IrreducibleModule P η) (centralCharacter P lam) = ⊤ →
      finrank K (centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
        (centralCharacter P lam) (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆ IrreducibleModule P η) =
        mult η := by
    intro η hNχ
    exact finrank_hom_centralTranslation_projectiveCover P hA hν eν hMχ hNχ
  -- maps to simple modules outside the block of `λ` vanish
  have hTop : centralBlock P (centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
      (centralCharacter P lam) (ProjectiveCover P hA Λw)) (centralCharacter P lam) = ⊤ :=
    centralBlock_centralBlock_eq_top P _
  have hblock : ∀ η, centralBlock P (IrreducibleModule P η) (centralCharacter P lam) ≠ ⊤ →
      ∀ f : centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
        (centralCharacter P lam) (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆ IrreducibleModule P η,
        f = 0 := by
    intro η hη f
    exact eq_zero_of_centralBlock_eq_top_of_ne P hTop (fun h ↦
      hη (h ▸ centralBlock_irreducible P η)) f
  have hmult1 : ∀ w' : P.weylGroup hA',
      P.UpperClosureCondition hA' (w'.val (lam + P.rho)) (w'.val (μ + P.rho)) →
      P.weylDot hA' w' μ = Λw → mult (P.weylDot hA' w' lam) = 1 := by
    intro w' hC' hw'μ
    let e := (translation_irreducible_of_upperClosureCondition_of_isAntidominant P hA hlam hμ
      hfacet hν' hzz hzν' w' hC').some
    exact (IsCategoryO.multiplicity_congr ((IrreducibleModule.isCategoryO P
      (P.weylDot hA' w' lam)).centralTranslation P (IrreducibleModule.isCategoryO P (z' (-ν)))
      (centralCharacter P lam) (centralCharacter P μ)) (IrreducibleModule.isCategoryO P _)
      e.symm Λw).trans (by simp [IrreducibleModule.multiplicity_eq, hw'μ])
  -- a nonzero multiplicity forces `η = w·λ`
  have hK : ∀ η, mult η ≠ 0 → η = P.weylDot hA' w lam := by
    intro η hη
    have hex := exists_weylDot_of_multiplicity_translation_ne_zero_of_isAntidominant P hA hlam hμ
      hfacet hν' hzz hzν' hη
    let w' := hex.choose
    have hηw : η = P.weylDot hA' w' lam := hex.choose_spec.1
    have hw'μ : P.weylDot hA' w' μ = Λw := hex.choose_spec.2.1
    have hns := hex.choose_spec.2.2
    rw [hηw] at hns
    have hw'b : w'.val (μ + P.rho) = w.val (μ + P.rho) := by
      have := congrArg (· + P.rho) hw'μ
      simpa [weylDot, hΛw] using this
    have hw'int : w' ∈ P.integralWeylGroup hA' lam := by
      rw [hWl, hWm, mem_integralWeylGroup, hw'b]
      exact hwb
    have hC' : P.UpperClosureCondition hA' (w'.val (lam + P.rho)) (w'.val (μ + P.rho)) := by
      by_contra hC'
      exact hns (translation_irreducible_of_not_upperClosureCondition_of_isAntidominant P
        hA hlam hμ hfacet hν' hzz hzν' w' hw'int hC')
    rw [hηw]
    exact weylDot_eq_of_upperClosureCondition hA hlam hint hC hC' hw'b
  have hwblock : centralBlock P (IrreducibleModule P (P.weylDot hA' w lam))
      (centralCharacter P lam) = ⊤ :=
    (VermaModule.centralCharacter_weyl P hA' w.property lam) ▸ centralBlock_irreducible P _
  have hdim1 : finrank K (centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
      (centralCharacter P lam) (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆
        IrreducibleModule P (P.weylDot hA' w lam)) = 1 := by
    rw [hHom _ hwblock]
    exact hmult1 w hC rfl
  have hdim0 : ∀ η, η ≠ P.weylDot hA' w lam → finrank K (centralTranslation P
      (IrreducibleModule P ν) (centralCharacter P μ) (centralCharacter P lam)
      (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆ IrreducibleModule P η) = 0 := by
    intro η hη
    by_cases hηb : centralBlock P (IrreducibleModule P η) (centralCharacter P lam) = ⊤
    · rw [hHom η hηb]
      by_contra h
      exact hη (hK η h)
    · have : Subsingleton (centralTranslation P (IrreducibleModule P ν) (centralCharacter P μ)
          (centralCharacter P lam) (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆ IrreducibleModule P η) :=
        ⟨fun f g ↦ (hblock η hηb f).trans (hblock η hηb g).symm⟩
      exact Module.finrank_zero_of_subsingleton
  have key : ∀ η, finrank K (ProjectiveCover P hA (P.weylDot hA' w lam) →ₗ⁅K,𝔤⁆
      IrreducibleModule P η) = finrank K (centralTranslation P (IrreducibleModule P ν)
      (centralCharacter P μ) (centralCharacter P lam) (ProjectiveCover P hA Λw) →ₗ⁅K,𝔤⁆
        IrreducibleModule P η) := by
    intro η
    refine (ProjectiveCover.finrank_hom_irreducible (P := P) (hA := hA)
      (Λ := P.weylDot hA' w lam) η).trans ?_
    split_ifs with hη
    · subst hη
      exact hdim1.symm
    · exact (hdim0 η hη).symm
  exact (ProjectiveCover.isFGProjectiveO P hA _).nonempty_equiv_of_finrank_hom_eq P hA hV key

end Cover

end Matrix.Realization.KacMoodyAlgebra

import LieLean.Algebra.Lie.KacMoody.Super.Enveloping
import Mathlib.LinearAlgebra.Eigenspace.Pi

/-!
# Gradings of `U(G̃(A, τ))` and the super commutator

The enveloping algebra `U = U(G̃(A, τ))` of the auxiliary contragredient Lie superalgebra
([Kac78] §1.1) has two gradings.

* The parity grading: the algebra involution `σ` with `σ(eᵢ) = (-1)^{p i} eᵢ`,
  `σ(fᵢ) = (-1)^{p i} fᵢ`, `σ(h) = h` (`SuperEnveloping.parity`). Its `±1`-eigenspaces are the even
  and odd parts of `U`.
* The weight grading by the adjoint action of `𝔥`: `U_μ = {u | [h, u] = μ(h) u}`
  (`SuperEnveloping.weightSpace`), with `eᵢ ∈ U_{αᵢ}`, `fᵢ ∈ U_{-αᵢ}`, `𝔥 ⊆ U_0` and
  `U_μ U_ν ⊆ U_{μ+ν}`. The weight spaces are independent and span `U`.

The super commutator `[x, y] = x y - (-1)^{|x||y|} y x` of homogeneous elements is extended
bilinearly (`SuperEnveloping.superBracket`); the Lie superalgebra `G̃(A, τ)` will be the
subspace of `U` generated by `𝔥` and the `eᵢ, fᵢ` under it.

## Main definitions

* `Matrix.Realization.SuperEnveloping.parity`: the parity involution `σ`.
* `Matrix.Realization.SuperEnveloping.weightSpace`: the weight space `U_μ`.
* `Matrix.Realization.SuperEnveloping.superBracket`: the super commutator.

## Main results

* `Matrix.Realization.SuperEnveloping.parity_parity`: `σ² = 1`.
* `Matrix.Realization.SuperEnveloping.iSup_weightSpace`,
  `Matrix.Realization.SuperEnveloping.iSupIndep_weightSpace`: `U = ⊕_μ U_μ`.
* `Matrix.Realization.SuperEnveloping.superBracket_of_even`,
  `Matrix.Realization.SuperEnveloping.superBracket_of_odd_odd`: values on homogeneous elements.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.1.
-/

open Module

noncomputable section

namespace Matrix.Realization

section paritySign

variable {ι : Type*} (K : Type*) [Field K] (p : ι → ZMod 2)

/-- The sign `(-1)^{p i}`. -/
def paritySign (i : ι) : K := if p i = 1 then -1 else 1

lemma paritySign_mul_self (i : ι) : paritySign K p i * paritySign K p i = 1 := by
  unfold paritySign; split_ifs <;> norm_num

end paritySign

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2)

namespace SuperEnveloping

/-! ### The parity involution -/

/-- The data of the parity involution. -/
def parityData : LiftData P p (P.SuperEnveloping p) where
  h := h P p
  e i := paritySign K p i • e P p i
  f i := paritySign K p i • f P p i
  h_mul_h := h_mul_h P p
  e_mul_f i j := by
    simp only [smul_mul_smul_comm, e_mul_f, smul_add, smul_smul]
    split_ifs with hij
    · subst hij
      rw [paritySign_mul_self]
      simp only [one_mul, mul_one, one_smul]
    · rw [smul_zero, add_zero, add_zero, mul_comm (paritySign K p i), mul_comm]
  h_mul_e a i := by
    rw [mul_smul_comm, h_mul_e, smul_add, smul_mul_assoc, smul_comm]
  h_mul_f a i := by
    rw [mul_smul_comm, h_mul_f, smul_sub, smul_mul_assoc, smul_comm]

/-- The parity involution `σ` of `U(G̃(A, τ))`: `eᵢ ↦ (-1)^{p i} eᵢ`, `fᵢ ↦ (-1)^{p i} fᵢ`,
`h ↦ h`. -/
def parity : P.SuperEnveloping p →ₐ[K] P.SuperEnveloping p := lift (parityData P p)

@[simp] lemma parity_e (i : ι) : parity P p (e P p i) = paritySign K p i • e P p i :=
  lift_e _ i

@[simp] lemma parity_f (i : ι) : parity P p (f P p i) = paritySign K p i • f P p i :=
  lift_f _ i

@[simp] lemma parity_h (a : H) : parity P p (h P p a) = h P p a := lift_h _ a

lemma parity_comp_parity : (parity P p).comp (parity P p) = AlgHom.id K _ := by
  refine hom_ext (fun i ↦ ?_) (fun i ↦ ?_) (fun a ↦ ?_) <;>
    simp [smul_smul, paritySign_mul_self]

@[simp] lemma parity_parity (u : P.SuperEnveloping p) : parity P p (parity P p u) = u :=
  congrArg (fun φ : P.SuperEnveloping p →ₐ[K] _ ↦ φ u) (parity_comp_parity P p)

/-- The parity involution as an algebra automorphism. -/
def parityEquiv : P.SuperEnveloping p ≃ₐ[K] P.SuperEnveloping p :=
  AlgEquiv.ofAlgHom (parity P p) (parity P p) (parity_comp_parity P p) (parity_comp_parity P p)

/-- `u` is even: `σ u = u`. -/
def IsEven (u : P.SuperEnveloping p) : Prop := parity P p u = u

/-- `u` is odd: `σ u = -u`. -/
def IsOdd (u : P.SuperEnveloping p) : Prop := parity P p u = -u

lemma isEven_h (a : H) : IsEven P p (h P p a) := parity_h P p a

lemma isEven_e {i : ι} (hi : p i = 0) : IsEven P p (e P p i) := by
  simp [IsEven, paritySign, hi]

lemma isOdd_e {i : ι} (hi : p i = 1) : IsOdd P p (e P p i) := by
  simp only [IsOdd, parity_e, paritySign, hi, ↓reduceIte]
  exact neg_one_smul K _

lemma isEven_f {i : ι} (hi : p i = 0) : IsEven P p (f P p i) := by
  simp [IsEven, paritySign, hi]

lemma isOdd_f {i : ι} (hi : p i = 1) : IsOdd P p (f P p i) := by
  simp only [IsOdd, parity_f, paritySign, hi, ↓reduceIte]
  exact neg_one_smul K _

/-! ### The super commutator -/

/-- The super commutator: `[x, y] = x y - (-1)^{|x||y|} y x` for homogeneous `x, y`, extended
bilinearly. Here it is written as `x y - ½ ((y + σ y) x + (y - σ y) σ x)`. -/
def superBracket (x y : P.SuperEnveloping p) : P.SuperEnveloping p :=
  x * y - (2 : K)⁻¹ • ((y + parity P p y) * x + (y - parity P p y) * parity P p x)

variable [CharZero K]

lemma superBracket_of_even_left {x : P.SuperEnveloping p} (hx : IsEven P p x)
    (y : P.SuperEnveloping p) : superBracket P p x y = x * y - y * x := by
  rw [superBracket, hx, ← add_mul, add_add_sub_cancel, ← two_smul K y, smul_mul_assoc,
    smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]

lemma superBracket_of_even_right (x : P.SuperEnveloping p) {y : P.SuperEnveloping p}
    (hy : IsEven P p y) : superBracket P p x y = x * y - y * x := by
  rw [superBracket, hy, sub_self, zero_mul, add_zero, ← two_smul K y, smul_mul_assoc,
    smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]

lemma superBracket_of_odd_odd {x y : P.SuperEnveloping p} (hx : IsOdd P p x)
    (hy : IsOdd P p y) : superBracket P p x y = x * y + y * x := by
  rw [superBracket, hx, hy]
  have h2 : (2 : K)⁻¹ • ((y + -y) * x + (y - -y) * -x) = -(y * x) := by
    rw [add_neg_cancel, zero_mul, zero_add, sub_neg_eq_add, ← two_smul K y, smul_mul_assoc,
      smul_smul, inv_mul_cancel₀ two_ne_zero, one_smul]
    noncomm_ring
  rw [h2, sub_neg_eq_add]

/-! ### The weight grading -/

omit [CharZero K]

/-- The weight space `U_μ = {u | [h, u] = μ(h) u for all h ∈ 𝔥}` of the adjoint action of `𝔥`. -/
def weightSpace (μ : Dual K H) : Submodule K (P.SuperEnveloping p) where
  carrier := {u | ∀ a, h P p a * u = u * h P p a + μ a • u}
  add_mem' {u v} hu hv a := by
    rw [mul_add, hu a, hv a, add_mul, smul_add]; abel
  zero_mem' a := by simp
  smul_mem' c u hu a := by
    rw [mul_smul_comm, hu a, smul_add, smul_mul_assoc, smul_comm]

lemma mem_weightSpace {μ : Dual K H} {u : P.SuperEnveloping p} :
    u ∈ weightSpace P p μ ↔ ∀ a, h P p a * u = u * h P p a + μ a • u := Iff.rfl

lemma e_mem_weightSpace (i : ι) : e P p i ∈ weightSpace P p (P.root i) := fun a ↦ h_mul_e P p a i

lemma f_mem_weightSpace (i : ι) : f P p i ∈ weightSpace P p (-P.root i) := fun a ↦ by
  rw [h_mul_f, LinearMap.neg_apply, neg_smul, sub_eq_add_neg]

lemma h_mem_weightSpace (b : H) : h P p b ∈ weightSpace P p 0 := fun a ↦ by
  rw [h_mul_h, LinearMap.zero_apply, zero_smul, add_zero]

lemma algebraMap_mem_weightSpace (c : K) : algebraMap K _ c ∈ weightSpace P p 0 := fun a ↦ by
  rw [Algebra.commutes, LinearMap.zero_apply, zero_smul, add_zero]

lemma one_mem_weightSpace : (1 : P.SuperEnveloping p) ∈ weightSpace P p 0 := by
  simpa using algebraMap_mem_weightSpace P p 1

lemma mul_mem_weightSpace {μ ν : Dual K H} {u v : P.SuperEnveloping p}
    (hu : u ∈ weightSpace P p μ) (hv : v ∈ weightSpace P p ν) :
    u * v ∈ weightSpace P p (μ + ν) := fun a ↦ by
  rw [← mul_assoc, hu a, add_mul, mul_assoc, hv a, smul_mul_assoc, mul_add, mul_smul_comm,
    LinearMap.add_apply, add_smul, ← mul_assoc]
  abel

lemma parity_mem_weightSpace {μ : Dual K H} {u : P.SuperEnveloping p}
    (hu : u ∈ weightSpace P p μ) : parity P p u ∈ weightSpace P p μ := fun a ↦ by
  have := congrArg (parity P p) (hu a)
  simpa using this

lemma mul_mem_iSup_weightSpace {u v : P.SuperEnveloping p}
    (hu : u ∈ ⨆ μ, weightSpace P p μ) (hv : v ∈ ⨆ μ, weightSpace P p μ) :
    u * v ∈ ⨆ μ, weightSpace P p μ := by
  induction hu using Submodule.iSup_induction' with
  | mem μ u hu =>
    induction hv using Submodule.iSup_induction' with
    | mem ν v hv =>
      exact Submodule.mem_iSup_of_mem (μ + ν) (mul_mem_weightSpace P p hu hv)
    | zero => simp
    | add v w _ _ hv hw => rw [mul_add]; exact add_mem hv hw
  | zero => simp
  | add u w _ _ hu hw => rw [add_mul]; exact add_mem hu hw

/-- The weight spaces span `U(G̃(A, τ))`. -/
theorem iSup_weightSpace : ⨆ μ, weightSpace P p μ = ⊤ := by
  refine eq_top_iff.2 fun u _ ↦ ?_
  obtain ⟨w, rfl⟩ := mk_surjective P p u
  induction w using FreeAlgebra.induction with
  | grade0 c =>
    simpa using Submodule.mem_iSup_of_mem 0 (algebraMap_mem_weightSpace P p c)
  | grade1 g =>
    cases g with
    | e i => exact Submodule.mem_iSup_of_mem _ (e_mem_weightSpace P p i)
    | f i => exact Submodule.mem_iSup_of_mem _ (f_mem_weightSpace P p i)
    | h a => exact Submodule.mem_iSup_of_mem _ (h_mem_weightSpace P p a)
  | add x y hx hy => rw [map_add]; exact add_mem (hx trivial) (hy trivial)
  | mul x y hx hy => rw [map_mul]; exact mul_mem_iSup_weightSpace P p (hx trivial) (hy trivial)

/-- The adjoint action of `h ∈ 𝔥` on `U(G̃(A, τ))`. -/
def adH (a : H) : Module.End K (P.SuperEnveloping p) :=
  LinearMap.mulLeft K (h P p a) - LinearMap.mulRight K (h P p a)

lemma commute_adH (a b : H) : Commute (adH P p a) (adH P p b) := by
  refine LinearMap.ext fun u ↦ ?_
  simp only [adH, Module.End.mul_apply, LinearMap.sub_apply, LinearMap.mulLeft_apply,
    LinearMap.mulRight_apply, mul_sub, sub_mul, ← mul_assoc, h_mul_h P p a b]
  rw [mul_assoc u, mul_assoc u, h_mul_h P p a b]
  abel

lemma weightSpace_le_iInf (μ : Dual K H) :
    weightSpace P p μ ≤ ⨅ a, (adH P p a).maxGenEigenspace (μ a) := by
  intro u hu
  rw [Submodule.mem_iInf]
  refine fun a ↦ Module.End.eigenspace_le_maxGenEigenspace ?_
  rw [Module.End.mem_eigenspace_iff, adH, LinearMap.sub_apply, LinearMap.mulLeft_apply,
    LinearMap.mulRight_apply, hu a, add_sub_cancel_left]

/-- The weight spaces of `U(G̃(A, τ))` are independent. -/
theorem iSupIndep_weightSpace : iSupIndep (weightSpace P p) := by
  have := Module.End.independent_iInf_maxGenEigenspace_of_forall_mapsTo (adH P p)
    fun a b φ ↦ Module.End.mapsTo_maxGenEigenspace_of_comm (commute_adH P p b a) φ
  exact (this.comp DFunLike.coe_injective).mono (weightSpace_le_iInf P p)

end SuperEnveloping

end Matrix.Realization

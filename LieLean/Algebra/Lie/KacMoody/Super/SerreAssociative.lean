import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.Character
import LieLean.Algebra.QuantumGroup.GabberKac

/-!
# The associative super Serre presentation of `M̄(Λ)`

Let `A` be a symmetrizable generalized Cartan matrix with a super-admissible parity `τ`, and let
`T(V) = K⟨v_i⟩` map to `U(G̃(A, τ))` by `vᵢ ↦ fᵢ`. The kernel of `T(V) → M̄(Λ)`, `t ↦ f(t) v̄_Λ`,
is the left ideal `J` generated by `f⁻¹(R)` (`GVerma.fAlg_smul_hwv_eq_zero_iff`). This file
identifies `J` with the two-sided ideal of `T(V)` generated by the **super Serre elements**

`sᵢⱼ = [v_i, [v_i, ⋯ [v_i, v_j] ⋯ ]]` (`1 - aᵢⱼ` factors `v_i`, `i ≠ j`),

the iterated super commutators for the parity `|vᵢ| = τᵢ` (`superSerreFree`): `J = T(V) S T(V)`
(`gIdeal_eq_superSerreIdeal`). So `U(𝔫₋)` of the contragredient Lie superalgebra `G(A, τ)` is the
algebra `T(V) / (sᵢⱼ)`, presented by the super Serre relations, and with the Verma multiplicities
of [Kac78] §2 (`GVerma.finrank_modWeightSpace_sub_eq_kostantPartition`):

`K(ν) + dim (T(V)_ν ∩ (sᵢⱼ)) = #{words of weight ν}`
(`kostantPartition_add_finrank_superSerreIdeal`),

where `K` is Kostant's partition function of the Kac–Moody algebra `𝔤(A)`. This is the super
analogue of `LusztigF.kostantPartition_add_finrank_serreSpan`.

## Proof

`sᵢⱼ` maps to the Serre element `(ad fᵢ)^{1-aᵢⱼ} fⱼ ∈ R` (`fAlg_superSerreFree`,
`serreF_mem_maxIdeal`), so `(sᵢⱼ) ⊆ J`. Conversely let `N = {f(t) v_Λ | t ∈ (sᵢⱼ)} ⊆ M(Λ)`. It is
stable under the `fᵢ`, under `𝔥` and under the `eₖ`, since `[eₖ, (ad fᵢ)^{1-aᵢⱼ} fⱼ] = 0`
(`Verma.serreSubU`). The elements `z ∈ U` with `z M(Λ) ⊆ N` and `σ(z) M(Λ) ⊆ N` form a subspace
stable under all super commutators (`Verma.superBracket_mem_annSub`); it contains the negative Serre
elements and the positive ones, which act by zero on `M(Λ)` (`Verma.serreE_smul`). So it contains
the ideal generated by the Serre elements, which is `R` by the super Gabber–Kac theorem
(`maxIdeal_eq_serreIdeal`). Hence `r ∈ f⁻¹(R)` gives `f(r) v_Λ ∈ N`, i.e. `r ∈ (sᵢⱼ)`. The
argument is reconstructed.

## Main definitions

* `Matrix.Realization.SuperEnveloping.superSerreFree`: the super Serre element `sᵢⱼ ∈ T(V)`.
* `Matrix.Realization.SuperEnveloping.superSerreIdeal`: the ideal of `T(V)` they generate.

## Main results

* `Matrix.Realization.SuperEnveloping.gIdeal_eq_superSerreIdeal`: `J = (sᵢⱼ)`.
* `Matrix.Realization.SuperEnveloping.fAlg_smul_hwv_eq_zero_iff_mem_superSerreIdeal`:
  `f(t) v̄_Λ = 0` in `M̄(Λ)` iff `t ∈ (sᵢⱼ)`.
* `Matrix.Realization.SuperEnveloping.kostantPartition_add_finrank_superSerreIdeal`:
  `K(ν) + dim (T(V)_ν ∩ (sᵢⱼ)) = #{words of weight ν}`.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.2–2.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §9.11.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H} {p : ι → ZMod 2} [CharZero K]

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

/-! ### The super Serre elements of `T(V)` -/

variable (K A p) in
/-- The super Serre element `sᵢⱼ = [vᵢ, [vᵢ, ⋯ [vᵢ, vⱼ] ⋯ ]]` of `T(V)`, with `1 - aᵢⱼ` factors
`vᵢ`, for the parity `|vᵢ| = τᵢ`. -/
def superSerreFree (i j : ι) : FreeAlgebra K ι :=
  sLie p j (List.replicate ((-A i j).toNat + 1) i)

variable (K A p) in
/-- The two-sided ideal of `T(V)` generated by the super Serre elements `sᵢⱼ`, `i ≠ j`. -/
def superSerreIdeal : Submodule (FreeAlgebra K ι) (FreeAlgebra K ι) :=
  Submodule.span (FreeAlgebra K ι) {t | ∃ i j, i ≠ j ∧ ∃ b, t = superSerreFree K A p i j * b}

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma superSerreFree_mul_mem {i j : ι} (hij : i ≠ j) (b : FreeAlgebra K ι) :
    superSerreFree K A p i j * b ∈ superSerreIdeal K A p :=
  Submodule.subset_span ⟨i, j, hij, b, rfl⟩

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
/-- `(sᵢⱼ)` is a two-sided ideal. -/
lemma mul_mem_superSerreIdeal {t : FreeAlgebra K ι} (ht : t ∈ superSerreIdeal K A p)
    (a : FreeAlgebra K ι) : t * a ∈ superSerreIdeal K A p := by
  induction ht using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, j, hij, b, rfl⟩ := hx
    rw [mul_assoc]
    exact superSerreFree_mul_mem hij _
  | zero => simp
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_eq_mul, mul_assoc]; exact Submodule.smul_mem _ c hx

omit [CharZero K] in
lemma eLie_replicate (i j : ι) (n : ℕ) :
    eLie P p j (List.replicate n i) = adE P p i n (e P p j) := by
  induction n with
  | zero => rfl
  | succ n ih => rw [List.replicate_succ, eLie_cons, ih, adE_succ]

/-- `f(sᵢⱼ) = (ad fᵢ)^{1-aᵢⱼ} fⱼ`. -/
lemma fAlg_superSerreFree (i j : ι) :
    fAlg P p (superSerreFree K A p i j) = serreF P p i j := by
  rw [superSerreFree, fAlg_sLie, eLie_replicate, ← omega_serreE, serreE]

/-! ### Commutation relations of the Serre elements -/

lemma isHomog_serreF (i j : ι) :
    IsHomog P p (((-A i j).toNat + 1 : ℕ) * p i + p j) (serreF P p i j) :=
  isHomog_adF i _ (isHomog_f P p j)

/-- `(ad eᵢ)^{1-aᵢⱼ} eⱼ fₖ = ± fₖ (ad eᵢ)^{1-aᵢⱼ} eⱼ`. -/
lemma serreE_mul_f (hA : A.IsGeneralizedCartan) (hp : A.IsSuperAdmissible p) {i j : ι}
    (hij : i ≠ j) (k : ι) :
    serreE P p i j * f P p k =
      zSign K (p k * (((-A i j).toNat + 1 : ℕ) * p i + p j)) • (f P p k * serreE P p i j) := by
  have h0 := superBracket_f_serreE (P := P) hA hp hij k
  rw [superBracket_of_isHomog (isHomog_f P p k) (isHomog_serreE i j), sub_eq_zero] at h0
  rw [h0, smul_smul, zSign_mul_self, one_smul]

/-- `eₖ (ad fᵢ)^{1-aᵢⱼ} fⱼ = ± (ad fᵢ)^{1-aᵢⱼ} fⱼ eₖ`. -/
lemma e_mul_serreF (hA : A.IsGeneralizedCartan) (hp : A.IsSuperAdmissible p) {i j : ι}
    (hij : i ≠ j) (k : ι) :
    e P p k * serreF P p i j =
      zSign K (p k * (((-A i j).toNat + 1 : ℕ) * p i + p j)) • (serreF P p i j * e P p k) := by
  have h0 : superBracket P p (e P p k) (serreF P p i j) = 0 := by
    have := congrArg (omega P p) (superBracket_f_serreE (P := P) hA hp hij k)
    rw [omega_superBracket, omega_f, omega_serreE, superBracket_smul_left, map_zero] at this
    refine (smul_eq_zero.1 this).resolve_left ?_
    unfold paritySign
    split_ifs <;> norm_num
  rwa [superBracket_of_isHomog (isHomog_e P p k) (isHomog_serreF i j), sub_eq_zero] at h0

omit [CharZero K] in
/-- `(ad fᵢ)^{1-aᵢⱼ} fⱼ` has weight `-(αⱼ + (1 - aᵢⱼ) αᵢ)`. -/
lemma serreF_mem_weightSpace (i j : ι) :
    serreF P p i j ∈ weightSpace P p (-(P.root j + ((-A i j).toNat + 1) • P.root i)) := by
  intro a
  have h := congrArg (omega P p) (serreE_mem_weightSpace (P := P) (p := p) i j a)
  rw [map_mul, map_add, map_mul, map_smul, omega_h, omega_serreE] at h
  rw [neg_mul, mul_neg, neg_eq_iff_eq_neg, neg_add, neg_neg] at h
  rw [LinearMap.neg_apply, neg_smul]
  exact h

/-! ### The subspace `N = (sᵢⱼ) v_Λ` of `M(Λ)` -/

namespace Verma

variable (P p) (Λ : Dual K H)

/-- `N = {f(t) v_Λ | t ∈ (sᵢⱼ)} ⊆ M(Λ)`. -/
def serreSub : Submodule K (Verma P p Λ) :=
  ((superSerreIdeal K A p).restrictScalars K).map (toTensorEquiv P p Λ).symm.toLinearMap

variable {P p Λ}

omit [CharZero K] in
lemma mem_serreSub_iff {v : Verma P p Λ} :
    v ∈ serreSub P p Λ ↔ ∃ t ∈ superSerreIdeal K A p, fAlg P p t • hwv P p Λ = v := by
  rw [serreSub, Submodule.mem_map]
  simp only [Submodule.restrictScalars_mem, LinearEquiv.coe_coe, toTensorEquiv_symm_apply]

omit [CharZero K] in
lemma fAlg_smul_hwv_mem_serreSub_iff {t : FreeAlgebra K ι} :
    fAlg P p t • hwv P p Λ ∈ serreSub P p Λ ↔ t ∈ superSerreIdeal K A p := by
  refine ⟨fun h ↦ ?_, fun ht ↦ mem_serreSub_iff.2 ⟨t, ht, rfl⟩⟩
  obtain ⟨s, hs, hst⟩ := mem_serreSub_iff.1 h
  rw [← toTensorEquiv_symm_apply, ← toTensorEquiv_symm_apply] at hst
  rwa [← (toTensorEquiv P p Λ).symm.injective hst]

omit [CharZero K] in
lemma exists_fAlg_smul_hwv_eq (v : Verma P p Λ) : ∃ t, fAlg P p t • hwv P p Λ = v :=
  ⟨toTensorEquiv P p Λ v, by rw [← toTensorEquiv_symm_apply, LinearEquiv.symm_apply_apply]⟩

omit [CharZero K] in
lemma fAlg_smul_mem_serreSub (b : FreeAlgebra K ι) {v : Verma P p Λ} (hv : v ∈ serreSub P p Λ) :
    fAlg P p b • v ∈ serreSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_serreSub_iff.1 hv
  rw [smul_smul, ← map_mul, fAlg_smul_hwv_mem_serreSub_iff]
  exact (superSerreIdeal K A p).smul_mem b ht

omit [CharZero K] in
lemma f_smul_mem_serreSub (i : ι) {v : Verma P p Λ} (hv : v ∈ serreSub P p Λ) :
    f P p i • v ∈ serreSub P p Λ := by
  simpa using fAlg_smul_mem_serreSub (FreeAlgebra.ι K i) hv

/-- `(ad fᵢ)^{1-aᵢⱼ} fⱼ M(Λ) ⊆ N`. -/
lemma serreF_smul_mem_serreSub {i j : ι} (hij : i ≠ j) (m : Verma P p Λ) :
    serreF P p i j • m ∈ serreSub P p Λ := by
  obtain ⟨t, rfl⟩ := exists_fAlg_smul_hwv_eq m
  rw [smul_smul, ← fAlg_superSerreFree, ← map_mul, fAlg_smul_hwv_mem_serreSub_iff]
  exact superSerreFree_mul_mem hij t

/-- `N` is stable under `𝔥`. -/
theorem h_smul_mem_serreSub (a : H) {v : Verma P p Λ} (hv : v ∈ serreSub P p Λ) :
    h P p a • v ∈ serreSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_serreSub_iff.1 hv
  clear hv
  induction ht using Submodule.span_induction with
  | mem r hr =>
    obtain ⟨i, j, hij, b, rfl⟩ := hr
    rw [map_mul, fAlg_superSerreFree, mul_smul, smul_smul, serreF_mem_weightSpace i j a,
      add_smul, mul_smul, smul_assoc]
    exact add_mem (serreF_smul_mem_serreSub hij _)
      (Submodule.smul_mem _ _ (serreF_smul_mem_serreSub hij _))
  | zero => simp
  | add s t _ _ hs ht => rw [map_add, add_smul, smul_add]; exact add_mem hs ht
  | smul b t ht' ht =>
    obtain ⟨b', hb'⟩ := exists_h_mul_fAlg (P := P) (p := p) a b
    rw [smul_eq_mul, map_mul, mul_smul, smul_smul, hb', add_smul]
    refine add_mem ?_ ?_
    · rw [mul_smul]; exact fAlg_smul_mem_serreSub b ht
    · rw [smul_smul, ← map_mul]
      exact fAlg_smul_hwv_mem_serreSub_iff.2 ((superSerreIdeal K A p).smul_mem b' ht')

lemma e_smul_fAlg_smul_mem_serreSub (b : FreeAlgebra K ι) {v : Verma P p Λ}
    (hv : v ∈ serreSub P p Λ) (he : ∀ j, e P p j • v ∈ serreSub P p Λ) (i : ι) :
    e P p i • fAlg P p b • v ∈ serreSub P p Λ := by
  induction b using FreeAlgebra.induction generalizing v i with
  | grade0 c =>
    rw [AlgHom.commutes, algebraMap_smul, smul_comm]
    exact Submodule.smul_mem _ c (he i)
  | grade1 j =>
    rw [fAlg_ι, smul_smul, e_mul_f, add_smul, smul_assoc, mul_smul]
    refine add_mem (Submodule.smul_mem _ _ (f_smul_mem_serreSub j (he i))) ?_
    split_ifs
    · exact h_smul_mem_serreSub _ hv
    · simp
  | mul b c hb hc =>
    rw [map_mul, mul_smul]
    exact hb (fAlg_smul_mem_serreSub c hv) (fun j ↦ hc hv he j) i
  | add b c hb hc =>
    rw [map_add, add_smul, smul_add]
    exact add_mem (hb hv he i) (hc hv he i)

variable (hA : A.IsGeneralizedCartan) (hp : A.IsSuperAdmissible p)

include hA hp in
/-- `N` is stable under the `eᵢ`. -/
theorem e_smul_mem_serreSub (k : ι) {v : Verma P p Λ} (hv : v ∈ serreSub P p Λ) :
    e P p k • v ∈ serreSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_serreSub_iff.1 hv
  clear hv
  induction ht using Submodule.span_induction generalizing k with
  | mem r hr =>
    obtain ⟨i, j, hij, b, rfl⟩ := hr
    rw [map_mul, fAlg_superSerreFree, mul_smul, smul_smul, e_mul_serreF hA hp hij, smul_assoc,
      mul_smul]
    exact Submodule.smul_mem _ _ (serreF_smul_mem_serreSub hij _)
  | zero => simp
  | add s t _ _ hs ht => rw [map_add, add_smul, smul_add]; exact add_mem (hs k) (ht k)
  | smul b t ht' ht =>
    rw [smul_eq_mul, map_mul, mul_smul]
    exact e_smul_fAlg_smul_mem_serreSub b (fAlg_smul_hwv_mem_serreSub_iff.2 ht') ht k

variable (P p Λ) in
/-- `N` as a `U`-submodule of `M(Λ)`. -/
def serreSubU : Submodule 𝒰 (Verma P p Λ) where
  __ := serreSub P p Λ
  smul_mem' u v hv := by
    induction u using induction generalizing v with
    | algebraMap c => rw [algebraMap_smul]; exact Submodule.smul_mem _ c hv
    | e i => exact e_smul_mem_serreSub hA hp i hv
    | f i => exact f_smul_mem_serreSub i hv
    | h a => exact h_smul_mem_serreSub a hv
    | add x y hx hy => rw [add_smul]; exact (serreSub P p Λ).add_mem (hx _ hv) (hy _ hv)
    | mul x y hx hy => rw [mul_smul]; exact hx _ (hy _ hv)

@[simp] lemma mem_serreSubU {v : Verma P p Λ} :
    v ∈ serreSubU P p Λ hA hp ↔ v ∈ serreSub P p Λ := Iff.rfl

/-! ### The positive Serre elements kill `M(Λ)` -/

lemma adE_e_smul_hwv (i j : ι) (n : ℕ) : adE P p i n (e P p j) • hwv P p Λ = 0 := by
  induction n with
  | zero => exact e_smul_hwv P p Λ j
  | succ n ih =>
    rw [adE_succ, superBracket_of_isHomog (isHomog_e P p i) (isHomog_adE i n (isHomog_e P p j)),
      sub_smul, mul_smul, ih, smul_zero, smul_assoc, mul_smul, e_smul_hwv, smul_zero, smul_zero,
      sub_zero]

include hA hp in
/-- The positive Serre elements act by zero on `M(Λ)`. -/
theorem serreE_smul {i j : ι} (hij : i ≠ j) (m : Verma P p Λ) : serreE P p i j • m = 0 := by
  obtain ⟨t, rfl⟩ := exists_fAlg_smul_hwv_eq m
  suffices ∀ (t : FreeAlgebra K ι) (v : Verma P p Λ), serreE P p i j • v = 0 →
      serreE P p i j • fAlg P p t • v = 0 from this t _ (adE_e_smul_hwv i j _)
  intro t
  induction t using FreeAlgebra.induction with
  | grade0 c => intro v hv; rw [AlgHom.commutes, algebraMap_smul, smul_comm, hv, smul_zero]
  | grade1 k =>
    intro v hv
    rw [fAlg_ι, smul_smul, serreE_mul_f hA hp hij, smul_assoc, mul_smul, hv, smul_zero, smul_zero]
  | mul x y hx hy => intro v hv; rw [map_mul, mul_smul]; exact hx _ (hy v hv)
  | add x y hx hy => intro v hv; rw [map_add, add_smul, smul_add, hx v hv, hy v hv, add_zero]

/-! ### The elements of `U` mapping `M(Λ)` into `N` -/

variable (P p Λ) in
/-- The elements `z ∈ U` with `z M(Λ) ⊆ N` and `σ(z) M(Λ) ⊆ N`. -/
def annSub : Submodule K 𝒰 where
  carrier := {z | ∀ m : Verma P p Λ, z • m ∈ serreSub P p Λ ∧ parity P p z • m ∈ serreSub P p Λ}
  add_mem' {x y} hx hy m := ⟨by rw [add_smul]; exact add_mem (hx m).1 (hy m).1,
    by rw [map_add, add_smul]; exact add_mem (hx m).2 (hy m).2⟩
  zero_mem' m := by simp
  smul_mem' c x hx m := ⟨by rw [smul_assoc]; exact Submodule.smul_mem _ c (hx m).1,
    by rw [map_smul, smul_assoc]; exact Submodule.smul_mem _ c (hx m).2⟩

include hA hp in
lemma superBracket_smul_mem (g : 𝒰) {z : 𝒰} (hz : ∀ m : Verma P p Λ, z • m ∈ serreSub P p Λ)
    (hσz : ∀ m : Verma P p Λ, parity P p z • m ∈ serreSub P p Λ) (m : Verma P p Λ) :
    superBracket P p g z • m ∈ serreSub P p Λ := by
  simp only [superBracket, sub_smul, add_smul, mul_smul, smul_assoc]
  exact sub_mem ((serreSubU P p Λ hA hp).smul_mem g (hz m)) (Submodule.smul_mem _ _
    (add_mem (add_mem (hz _) (hσz _)) (sub_mem (hz _) (hσz _))))

include hA hp in
/-- `annSub` is stable under all super commutators. -/
theorem superBracket_mem_annSub (g : 𝒰) {z : 𝒰} (hz : z ∈ annSub P p Λ) :
    superBracket P p g z ∈ annSub P p Λ := fun m ↦
  ⟨superBracket_smul_mem hA hp g (fun m ↦ (hz m).1) (fun m ↦ (hz m).2) m, by
    rw [parity_superBracket]
    exact superBracket_smul_mem hA hp _ (fun m ↦ (hz m).2)
      (fun m ↦ by rw [parity_parity]; exact (hz m).1) m⟩

include hA hp in
/-- The ideal generated by the Serre elements maps `M(Λ)` into `N`. -/
theorem serreIdeal_le_annSub : serreIdeal P p ≤ annSub P p Λ := by
  let annAd : Submodule 𝒰 (Ad P p) :=
    { carrier := {y | (toAd P p).symm y ∈ annSub P p Λ}
      add_mem' := fun {x y} hx hy ↦ by
        simp only [Set.mem_ofPred_eq, map_add]; exact add_mem hx hy
      zero_mem' := by simp
      smul_mem' := fun u y hy ↦ by
        change (toAd P p).symm (u • y) ∈ annSub P p Λ
        rw [← (toAd P p).apply_symm_apply y, smul_toAd, LinearEquiv.symm_apply_apply]
        exact adRep_mem_of_forall (fun _ _ hz ↦ superBracket_mem_annSub hA hp _ hz)
          (fun _ _ hz ↦ superBracket_mem_annSub hA hp _ hz)
          (fun _ _ hz ↦ superBracket_mem_annSub hA hp _ hz) u hy }
  have hle : serreAd P p ≤ annAd := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, ⟨i, j, hij, rfl | rfl⟩, rfl⟩
    · change (toAd P p).symm (toAd P p (serreE P p i j)) ∈ annSub P p Λ
      rw [LinearEquiv.symm_apply_apply]
      refine fun m ↦ ⟨by rw [serreE_smul hA hp hij]; exact zero_mem _, ?_⟩
      rw [isHomog_serreE i j, smul_assoc, serreE_smul hA hp hij, smul_zero]
      exact zero_mem _
    · change (toAd P p).symm (toAd P p (serreF P p i j)) ∈ annSub P p Λ
      rw [LinearEquiv.symm_apply_apply]
      refine fun m ↦ ⟨serreF_smul_mem_serreSub hij m, ?_⟩
      rw [isHomog_serreF i j, smul_assoc]
      exact Submodule.smul_mem _ _ (serreF_smul_mem_serreSub hij m)
  intro x hx
  have : (toAd P p).symm (toAd P p x) ∈ annSub P p Λ := hle ((mem_serreIdeal P p).1 hx)
  rwa [LinearEquiv.symm_apply_apply] at this

end Verma

/-! ### The presentation -/

variable [FiniteDimensional K H] (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
  (hp : A.IsSuperAdmissible p)

variable (P p) in
include S hA hp in
/-- **The associative super Serre presentation.** The left ideal `J` of `T(V)` generated by
`f⁻¹(R)` is the two-sided ideal generated by the super Serre elements `sᵢⱼ`. -/
theorem gIdeal_eq_superSerreIdeal : gIdeal P p = superSerreIdeal K A p := by
  refine le_antisymm (Submodule.span_le.2 fun r hr ↦ ?_) (Submodule.span_le.2 ?_)
  · have hx : fAlg P p r ∈ Verma.annSub P p (0 : Dual K H) := by
      refine Verma.serreIdeal_le_annSub hA hp ?_
      rw [← maxIdeal_eq_serreIdeal P p S hA hp]
      exact hr
    exact Verma.fAlg_smul_hwv_mem_serreSub_iff.1 (hx (Verma.hwv P p 0)).1
  · rintro _ ⟨i, j, hij, b, rfl⟩
    refine mul_mem_gIdeal (mem_gIdeal_of_mem_fPre ?_) b
    rw [mem_fPre, fAlg_superSerreFree]
    exact serreF_mem_maxIdeal P p S hA hp hij

include S hA hp in
/-- `f(t) v̄_Λ = 0` in `M̄(Λ)` iff `t` lies in the ideal generated by the super Serre elements. -/
theorem GVerma.fAlg_smul_hwv_eq_zero_iff_mem_superSerreIdeal (Λ : Dual K H)
    {t : FreeAlgebra K ι} :
    fAlg P p t • GVerma.hwv P p Λ = 0 ↔ t ∈ superSerreIdeal K A p := by
  rw [GVerma.fAlg_smul_hwv_eq_zero_iff, gIdeal_eq_superSerreIdeal P p S hA hp]

include S hA hp in
/-- **Dimension count for the super Serre relations**: for every `ν ∈ ℕ[I]`,
`K(ν) + dim (T(V)_ν ∩ (sᵢⱼ)) = #{words of weight ν}`, with `K` Kostant's partition function of
`𝔤(A)`. -/
theorem kostantPartition_add_finrank_superSerreIdeal (ν : ι →₀ ℕ) :
    KacMoodyAlgebra.kostantPartition P (P.rootOf (natVec ν)) +
      finrank K ↥(FreeAlgebra.wordSpan K ν ⊓ (superSerreIdeal K A p).restrictScalars K) =
        Fintype.card (LusztigF.Words ν) := by
  set V := FreeAlgebra.wordSpan K ν with hV
  have : FiniteDimensional K V :=
    FiniteDimensional.span_of_finite K ((LusztigF.finite_setOf_wordWeight_eq ν).image _)
  set g := (GVerma.ofTensor P p (0 : Dual K H)).domRestrict V
  have hw : ∀ w : List ι, GVerma.ofTensor P p 0 ((w.map (FreeAlgebra.ι K)).prod) =
      GVerma.wordVector P p 0 w := fun w ↦ by
    rw [GVerma.ofTensor_apply, GVerma.wordVector, word_eq_wordBasis, FreeAlgebra.wordBasis_apply]
  have hrange : LinearMap.range g =
      modWeightSpace P p (GVerma P p 0) (0 - P.rootOf (natVec ν)) := by
    rw [LinearMap.range_domRestrict, GVerma.modWeightSpace_sub_eq, hV, FreeAlgebra.wordSpan,
      Submodule.map_span, Set.image_image]
    congr 1
    ext v
    simp only [Set.mem_image, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨w, hw', rfl⟩
      exact ⟨w, by rw [wordVec_eq_natVec, hw'], (hw w).symm⟩
    · rintro ⟨w, hw', rfl⟩
      exact ⟨w, natVec_injective (P.rootOf_injective (by rwa [← wordVec_eq_natVec])), hw w⟩
  have hker : LinearMap.ker g = ((superSerreIdeal K A p).restrictScalars K).comap V.subtype := by
    rw [LinearMap.ker_domRestrict, GVerma.ker_ofTensor, gIdeal_eq_superSerreIdeal P p S hA hp]
  have hSer : finrank K (((superSerreIdeal K A p).restrictScalars K).comap V.subtype) =
      finrank K ↥(V ⊓ (superSerreIdeal K A p).restrictScalars K) := by
    rw [← Submodule.finrank_map_subtype_eq, Submodule.map_comap_subtype]
  have hrn := LinearMap.finrank_range_add_finrank_ker g
  rw [hrange, hker, hSer, GVerma.finrank_modWeightSpace_sub_eq_kostantPartition S hA hp] at hrn
  rw [hrn]
  exact LusztigF.finrank_weightSpace K ν

end Matrix.Realization.SuperEnveloping

import LieLean.Algebra.Lie.KacMoody.CasimirIrreducible
import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.CasimirExpansion
import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.IntegrableAt
import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.Syzygy

/-!
# Integrable highest-weight modules of contragredient Lie superalgebras

Let `A` be a symmetrizable generalized Cartan matrix with an admissible parity `τ`
(`aᵢⱼ` even whenever `τᵢ` is odd), `G(A, τ)` the contragredient Lie superalgebra and `M̄(Λ)` its
Verma module. Let `Λ` be dominant integral for `G(A, τ)`: `⟨Λ, αᵢ^∨⟩ = nᵢ ∈ ℕ`, with `nᵢ` even
whenever `τᵢ` is odd. Then `L̃(Λ) = M̄(Λ) / ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ` is irreducible
([Kac78] Thm. 2 (c)): the submodule `∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ` is the maximal proper submodule of
`M̄(Λ)`, so `L̃(Λ)` is the irreducible highest-weight module `L(Λ)`.

## Main definitions

* `Matrix.Realization.SuperEnveloping.GVerma.fPowSubmodule`: `∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ ⊆ M̄(Λ)`.
* `Matrix.Realization.SuperEnveloping.GVerma.FPowQuotient`: `L̃(Λ) = M̄(Λ) / ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ`.

## Main results

* `Matrix.Realization.SuperEnveloping.exists_nat_of_e_smul_eq_zero_of_isIntegrableAt`: in a
  module integrable at `i`, a nonzero vector of weight `μ` killed by `eᵢ` has `⟨μ, αᵢ^∨⟩ ∈ ℕ`.
* `Matrix.Realization.SuperEnveloping.IsBounded.exists_e_smul_eq_zero`: a nonzero module whose
  weights lie in finitely many cones `Λ - Q₊` has a nonzero weight vector killed by all `eᵢ`.
* `Matrix.Realization.SuperEnveloping.GVerma.isIntegrable_fPowQuotient`: `L̃(Λ)` is integrable.
* `Matrix.Realization.SuperEnveloping.GVerma.fPowSubmodule_ne_top`: `L̃(Λ) ≠ 0`.
* `Matrix.Realization.SuperEnveloping.GVerma.isSimpleModule_fPowQuotient`,
  `Matrix.Realization.SuperEnveloping.GVerma.isCoatom_fPowSubmodule`: **[Kac78] Thm. 2 (c)**.

## Proof

For an odd node the `𝔰𝔩₂`-triple is `(αᵢ^∨ / 2, eᵢ² / 2, -fᵢ² / 2)`, and
`eᵢ fᵢ^{k+1} v = dₖ₊₁ fᵢ^k v` for a vector `v` of weight `μ` killed by `eᵢ`, with
`d₂ₖ = -2k`, `d₂ₖ₊₁ = ⟨μ, αᵢ^∨⟩ - 2k`; for an even node `dₖ = k (⟨μ, αᵢ^∨⟩ - k + 1)`. Hence
`fᵢ^{nᵢ+1} v̄_Λ` is a highest-weight vector of weight `Λ - (nᵢ + 1) αᵢ`, and `L̃(Λ) ≠ 0`. It is
integrable since it is generated by `v̄_Λ`, on which `eᵢ` and `fᵢ` act nilpotently
([Kac78] §1.4). Irreducibility then follows from the Casimir operator as in the even case
(`Matrix.Realization.KacMoodyAlgebra.eq_bot_or_eq_top_of_isIntegrable`): a nonzero submodule
contains a highest-weight vector of some weight `μ = Λ - β`, `β ∈ Q₊`; integrability makes `μ`
dominant integral, the Casimir operator gives `(Λ + 2ρ | Λ) = (μ + 2ρ | μ)`, which forces `β = 0`
([Kac] Lemma 10.3). [Kac78] states Thm. 2 (c) as a consequence of the character formula; the
direct argument above is written out by us.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.4, §2, Thm. 2.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, Lemma 10.3, §10.4.
-/

open Module Matrix.Realization.WeightOrd

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H} {p : ι → ZMod 2} [CharZero K]

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

attribute [local instance] LieRing.ofAssociativeRing LieRingModule.ofAssociativeModule
  LieModule.ofAssociativeModule

/-! ### Rank-one computations -/

/-- The coefficients in `eᵢ fᵢᵏ v = dₖ fᵢᵏ⁻¹ v` for `eᵢ v = 0`, `v` of weight `s` for `αᵢ^∨`;
`σ = (-1)^{τᵢ}`. -/
def lowerCoeff (σ s : K) : ℕ → K
  | 0 => 0
  | k + 1 => σ * lowerCoeff σ s k + (s - 2 * k)

omit [CharZero K] in
lemma lowerCoeff_one (s : K) (k : ℕ) : lowerCoeff 1 s k = k * (s - k + 1) := by
  induction k with
  | zero => simp [lowerCoeff]
  | succ k ih => rw [lowerCoeff, ih]; push_cast; ring

omit [CharZero K] in
lemma lowerCoeff_neg_one (s : K) (k : ℕ) :
    lowerCoeff (-1) s (2 * k) = -(2 * k) ∧ lowerCoeff (-1) s (2 * k + 1) = s - 2 * k := by
  induction k with
  | zero => simp [lowerCoeff]
  | succ k ih =>
    have h1 : lowerCoeff (-1) s (2 * (k + 1)) = -(2 * (k + 1)) := by
      rw [show 2 * (k + 1) = 2 * k + 1 + 1 by ring, lowerCoeff, ih.2]; push_cast; ring
    refine ⟨by push_cast; exact h1, ?_⟩
    rw [lowerCoeff, h1]; push_cast; ring

section Module

variable {V : Type*} [AddCommGroup V] [Module K V] [Module (P.SuperEnveloping p) V]
  [IsScalarTower K (P.SuperEnveloping p) V]

omit [CharZero K] in
/-- `eᵢ fᵢᵏ⁺¹ v = dₖ₊₁ fᵢᵏ v` for `v` of weight `μ` with `eᵢ v = 0`. -/
lemma e_smul_f_pow_smul (hA : A.IsGeneralizedCartan) (i : ι) {μ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V μ) (he : e P p i • v = 0) (k : ℕ) :
    e P p i • (f P p i ^ (k + 1) • v) =
      lowerCoeff (superSign K p i i) (μ (P.coroot i)) (k + 1) • (f P p i ^ k • v) := by
  induction k with
  | zero =>
    rw [pow_one, pow_zero, one_smul, ← mul_smul, e_mul_f, ite_eq_left rfl, add_smul,
      smul_assoc, mul_smul, he, smul_zero, smul_zero, zero_add, hv (P.coroot i)]
    simp [lowerCoeff]
  | succ k ih =>
    have hw := f_pow_smul_mem_modWeightSpace hv i (k + 1)
    have h2 : (μ - (k + 1) • P.root i) (P.coroot i) = μ (P.coroot i) - 2 * (k + 1 : ℕ) := by
      simp [P.root_coroot, hA.diag]; ring
    rw [pow_succ' _ (k + 1), mul_smul, ← mul_smul (e P p i), e_mul_f, ite_eq_left rfl, add_smul,
      smul_assoc, mul_smul, ih, hw (P.coroot i), h2, smul_comm (f P p i) (lowerCoeff _ _ _),
      ← mul_smul (f P p i), ← pow_succ', smul_smul, ← add_smul]
    rfl

omit [CharZero K] in
/-- `eⱼ` commutes with `fᵢ` up to sign for `j ≠ i`, so it kills `fᵢᵏ v` if it kills `v`. -/
lemma e_smul_f_pow_smul_of_ne {i j : ι} (hji : j ≠ i) {v : V} (he : e P p j • v = 0) (k : ℕ) :
    e P p j • (f P p i ^ k • v) = 0 := by
  induction k with
  | zero => rwa [pow_zero, one_smul]
  | succ k ih =>
    rw [pow_succ', mul_smul, ← mul_smul, e_mul_f_of_ne _ _ hji, smul_assoc, mul_smul, ih, smul_zero,
      smul_zero]

omit [CharZero K] in
/-- If `v` has weight `μ` with `⟨μ, αᵢ^∨⟩ = n` (`n` even if `τᵢ` is odd) and is killed by all
the `eⱼ`, then so is `fᵢ^{n+1} v`. -/
lemma e_smul_f_pow_succ_smul_eq_zero (hA : A.IsGeneralizedCartan) {i : ι} {μ : Dual K H}
    {n : ℕ} (hn : μ (P.coroot i) = n) (hodd : p i = 1 → Even n) {v : V}
    (hv : v ∈ modWeightSpace P p V μ) (he : ∀ j, e P p j • v = 0) (j : ι) :
    e P p j • (f P p i ^ (n + 1) • v) = 0 := by
  obtain rfl | hji := eq_or_ne j i
  · rw [e_smul_f_pow_smul hA _ hv (he _), superSign_self, hn]
    split_ifs with hi
    · obtain ⟨m, rfl⟩ := hodd hi
      rw [show m + m + 1 = 2 * m + 1 by ring, (lowerCoeff_neg_one _ m).2]
      convert zero_smul K _ using 2
      push_cast; ring
    · rw [lowerCoeff_one]
      convert zero_smul K _ using 2
      push_cast; ring
  · exact e_smul_f_pow_smul_of_ne hji (he j) _

/-- In a module integrable at `i`, a nonzero vector of weight `μ` killed by `eᵢ` has
`⟨μ, αᵢ^∨⟩ ∈ ℕ` ([Kac78] §1.4, cf. [Kac] (3.2.4)). -/
theorem exists_nat_of_e_smul_eq_zero_of_isIntegrableAt (hA : A.IsGeneralizedCartan) {i : ι}
    (hV : IsIntegrableAt P p V i) {μ : Dual K H} {v : V} (hv : v ∈ modWeightSpace P p V μ)
    (hv0 : v ≠ 0) (he : e P p i • v = 0) : ∃ m : ℕ, μ (P.coroot i) = m := by
  have hE : ⁅sl2E P p i, v⁆ = 0 := by
    change sl2E P p i • v = 0
    unfold sl2E
    split_ifs
    · rw [smul_assoc, sq, mul_smul, he, smul_zero, smul_zero]
    · exact he
  obtain ⟨m, hm⟩ := IsSl2Triple.HasPrimitiveVectorWith.exists_nat_of_exists_pow_eq_zero
    (t := isSl2Triple P p (hA := hA) i) ⟨hv0, sl2H_smul hv i, hE⟩ (hV.exists_sl2F v)
  refine ⟨sl2Deg p i * m, ?_⟩
  rw [apply_coroot_eq, hm]
  push_cast
  ring

/-- A module whose weights lie in finitely many cones `Λ - Q₊` has, above every weight `μ₁` of a
nonzero weight vector, a weight `μ` with a nonzero weight vector killed by all the `eᵢ`. -/
theorem IsBounded.exists_e_smul_eq_zero {Λs : Finset (Dual K H)} (hV : IsBounded P p V Λs)
    {μ₁ : Dual K H} {v₁ : V} (hv₁ : v₁ ∈ modWeightSpace P p V μ₁) (hv₁0 : v₁ ≠ 0) :
    ∃ μ, ∃ w ∈ modWeightSpace P p V μ, w ≠ 0 ∧ (∀ i, e P p i • w = 0) ∧
      toWeightOrd P μ ≤ toWeightOrd P μ₁ := by
  classical
  set F := {κ | modWeightSpace P p V κ ≠ ⊥ ∧ toWeightOrd P κ ≤ toWeightOrd P μ₁}
  have hFfin : F.Finite := (finite_setOf_le_le P Λs μ₁).subset fun κ ⟨hκ, hle⟩ ↦ by
    obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff _).1 hκ
    obtain ⟨Λ, hΛ, d, hd, rfl⟩ := hV.exists_eq_sub hw hw0
    exact ⟨⟨Λ, hΛ, (toWeightOrd_le_toWeightOrd_iff_exists_eq_sub P).2 ⟨d, hd, rfl⟩⟩, hle⟩
  have hne : (toWeightOrd P '' F).Nonempty :=
    ⟨_, μ₁, ⟨(Submodule.ne_bot_iff _).2 ⟨v₁, hv₁, hv₁0⟩, le_rfl⟩, rfl⟩
  obtain ⟨_, ⟨μ₀, ⟨hne0, hle⟩, rfl⟩, hmin⟩ := (hFfin.image _).isPWO.exists_minimal hne
  obtain ⟨w, hw, hw0⟩ := (Submodule.ne_bot_iff _).1 hne0
  refine ⟨μ₀, w, hw, hw0, fun i ↦ ?_, hle⟩
  by_contra h0
  have hmem := smul_mem_modWeightSpace V (e_mem_weightSpace P p i) hw
  have hup : toWeightOrd P (P.root i + μ₀) ≤ toWeightOrd P μ₀ :=
    (toWeightOrd_le_iff P).2 ⟨Pi.single i 1, Pi.single_nonneg.2 zero_le_one, by simp⟩
  have hF : P.root i + μ₀ ∈ F := ⟨(Submodule.ne_bot_iff _).2 ⟨_, hmem, h0⟩, hup.trans hle⟩
  have h1 := (toWeightOrd P).injective (le_antisymm hup (hmin ⟨_, hF, rfl⟩ hup))
  rw [add_eq_right, ← rootOf_single, ← map_zero P.rootOf] at h1
  simpa using congr_fun (P.rootOf_injective h1) i

end Module

/-! ### The quotient `L̃(Λ)` -/

namespace GVerma

variable (P p) in
/-- The submodule `∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ` of `M̄(Λ)`. -/
def fPowSubmodule (Λ : Dual K H) (n : ι → ℕ) : Submodule 𝒰 (GVerma P p Λ) :=
  Submodule.span 𝒰 (Set.range fun i ↦ f P p i ^ (n i + 1) • hwv P p Λ)

variable (P p) in
/-- `L̃(Λ) = M̄(Λ) / ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ`. -/
abbrev FPowQuotient (Λ : Dual K H) (n : ι → ℕ) : Type _ :=
  GVerma P p Λ ⧸ fPowSubmodule P p Λ n

variable {Λ : Dual K H} {n : ι → ℕ}

lemma hwv_mem_modWeightSpace : hwv P p Λ ∈ modWeightSpace P p (GVerma P p Λ) Λ := by
  rw [modWeightSpace_self]
  exact Submodule.subset_span rfl

lemma isGModule_fPowQuotient : IsGModule P p (FPowQuotient P p Λ n) := by
  intro x hx v
  obtain ⟨v, rfl⟩ := (fPowSubmodule P p Λ n).mkQ_surjective v
  rw [← map_smul, isGModule x hx v, map_zero]

lemma span_mkQ_hwv :
    Submodule.span 𝒰 {(fPowSubmodule P p Λ n).mkQ (hwv P p Λ)} = ⊤ := by
  rw [← Set.image_singleton, ← Submodule.map_span, span_hwv, Submodule.map_top,
    Submodule.range_mkQ]

variable [FiniteDimensional K H] (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
  (hp : A.IsSuperAdmissible p)

include S hA hp in
/-- `L̃(Λ)` is integrable ([Kac78] §1.4, §2). -/
theorem isIntegrable_fPowQuotient : IsIntegrable P p (FPowQuotient P p Λ n) := by
  set N := fPowSubmodule P p Λ n
  intro i
  refine isIntegrableAt_of_span S hA hp (s := {N.mkQ (hwv P p Λ)}) isGModule_fPowQuotient i
    span_mkQ_hwv ?_ ?_
  · rintro _ rfl
    exact ⟨1, by rw [pow_one, ← map_smul, e_smul_hwv, map_zero]⟩
  · rintro _ rfl
    refine ⟨n i + 1, ?_⟩
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span ⟨i, rfl⟩

omit [FiniteDimensional K H] in
/-- If `v̄_Λ` lies in the submodule generated by vectors `gᵢ` of weights `μᵢ` killed by all the
`eⱼ`, then `Λ ≤ μᵢ` for some `i`. -/
lemma exists_eq_sub_of_hwv_mem_span {μ : ι → Dual K H} (g : ι → GVerma P p Λ)
    (hg : ∀ i, g i ∈ modWeightSpace P p (GVerma P p Λ) (μ i)) (he : ∀ i j, e P p j • g i = 0)
    (hmem : hwv P p Λ ∈ Submodule.span 𝒰 (Set.range g)) :
    ∃ i, ∃ d : ι → ℤ, 0 ≤ d ∧ Λ = μ i - P.rootOf d := by
  classical
  let φ (i : ι) : GVerma P p (μ i) →ₗ[𝒰] GVerma P p Λ :=
    lift isGModule (g i) (he i) fun a ↦ by rw [algebraMap_smul]; exact hg i a
  let Φ : (∀ i, GVerma P p (μ i)) →ₗ[𝒰] GVerma P p Λ :=
    ∑ i, (φ i).comp (LinearMap.proj i)
  have hle : Submodule.span 𝒰 (Set.range g) ≤ LinearMap.range Φ := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨i, rfl⟩
    refine ⟨Pi.single i (hwv P p (μ i)), ?_⟩
    simp only [Φ, LinearMap.sum_apply, LinearMap.comp_apply, LinearMap.proj_apply]
    rw [Finset.sum_eq_single i (fun j _ hj ↦ by rw [Pi.single_eq_of_ne hj, map_zero])
      (by simp), Pi.single_eq_same, lift_hwv]
  have hB : IsBounded P p (LinearMap.range Φ) (Finset.univ.biUnion fun i ↦ {μ i}) :=
    (isBounded_pi fun _ ↦ isBounded).of_surjective Φ.rangeRestrict
      Φ.surjective_rangeRestrict
  obtain ⟨Λ', hΛ', d, hd, hdeq⟩ := hB.exists_eq_sub (w := ⟨_, hle hmem⟩) (ν := Λ)
    (fun a ↦ Subtype.ext (hwv_mem_modWeightSpace a))
    (fun h ↦ hwv_ne_zero P p Λ (congr_arg Subtype.val h))
  obtain ⟨i, -, hi⟩ := Finset.mem_biUnion.1 hΛ'
  exact ⟨i, d, hd, Finset.mem_singleton.1 hi ▸ hdeq⟩

omit [FiniteDimensional K H] in
include hA in
/-- If `⟨Λ, αᵢ^∨⟩ = nᵢ` with `nᵢ` even for odd `τᵢ`, then `v̄_Λ ∉ ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ`, i.e.
`L̃(Λ) ≠ 0`. -/
theorem fPowSubmodule_ne_top (hn : ∀ i, Λ (P.coroot i) = n i)
    (hodd : ∀ i, p i = 1 → Even (n i)) : fPowSubmodule P p Λ n ≠ ⊤ := by
  intro htop
  obtain ⟨i, d, hd, hdeq⟩ := exists_eq_sub_of_hwv_mem_span (μ := fun i ↦ Λ - (n i + 1) • P.root i)
    _ (fun i ↦ f_pow_smul_mem_modWeightSpace hwv_mem_modWeightSpace i _)
    (fun i ↦ e_smul_f_pow_succ_smul_eq_zero hA (hn i) (hodd i) hwv_mem_modWeightSpace
      e_smul_hwv) (show hwv P p Λ ∈ fPowSubmodule P p Λ n from htop ▸ Submodule.mem_top)
  have h0 : P.rootOf (d + ((n i + 1 : ℕ) : ℤ) • Pi.single i 1) = P.rootOf 0 := by
    rw [map_add, map_zsmul, rootOf_single, map_zero, natCast_zsmul]
    linear_combination (norm := module) hdeq
  have h1 := congr_fun (P.rootOf_injective h0) i
  simp only [Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, mul_one,
    Pi.zero_apply] at h1
  have := hd i
  simp only [Pi.zero_apply] at this
  omega

include S hA hp in
/-- **[Kac78] Thm. 2 (c)**: for `Λ` dominant integral (`⟨Λ, αᵢ^∨⟩ = nᵢ ∈ ℕ`, `nᵢ` even for odd
`τᵢ`), every submodule of `L̃(Λ) = M̄(Λ) / ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ` is `0` or `L̃(Λ)`. -/
theorem eq_bot_or_eq_top_fPowQuotient (hn : ∀ i, Λ (P.coroot i) = n i)
    (N' : Submodule 𝒰 (FPowQuotient P p Λ n)) : N' = ⊥ ∨ N' = ⊤ := by
  set N := fPowSubmodule P p Λ n
  have hV : IsCasimirModule P p S (FPowQuotient P p Λ n) {Λ}
      (P.dualBilinForm S (Λ + 2 • P.rho) Λ) :=
    (IsCasimirModule.gVerma hA ⟨Λ, Finset.mem_singleton_self _, le_rfl⟩).quotient N
  have hint := isIntegrable_fPowQuotient (P := P) (Λ := Λ) (n := n) S hA hp
  rcases eq_or_ne N' ⊥ with h | h0
  · exact Or.inl h
  right
  have hN' := hV.submodule N'
  obtain ⟨x, hx, hx0⟩ := (Submodule.ne_bot_iff _).1 h0
  obtain ⟨μ₁, hμ₁⟩ : ∃ μ₁, modWeightSpace P p N' μ₁ ≠ ⊥ := by
    by_contra hall
    push Not at hall
    have htop := hN'.isBounded.iSup_modWeightSpace_eq_top
    simp only [hall, iSup_bot] at htop
    have hmem : (⟨x, hx⟩ : N') ∈ (⊥ : Submodule K N') := htop ▸ Submodule.mem_top
    exact hx0 (congr_arg Subtype.val ((Submodule.mem_bot K).1 hmem))
  obtain ⟨v₁, hv₁, hv₁0⟩ := (Submodule.ne_bot_iff _).1 hμ₁
  obtain ⟨μ, w, hw, hw0, he, -⟩ := hN'.isBounded.exists_e_smul_eq_zero hv₁ hv₁0
  -- the vector `w` in `L̃(Λ)`
  have hwV : (w : FPowQuotient P p Λ n) ∈ modWeightSpace P p _ μ := fun a ↦ by
    simpa using congr_arg Subtype.val (hw a)
  have hw0' : (w : FPowQuotient P p Λ n) ≠ 0 := fun h ↦ hw0 (Subtype.ext h)
  have he' : ∀ i, e P p i • (w : FPowQuotient P p Λ n) = 0 := fun i ↦
    congr_arg Subtype.val (he i)
  -- `μ` is dominant integral
  have hμdom : P.IsDominantIntegral μ := fun i ↦
    exists_nat_of_e_smul_eq_zero_of_isIntegrableAt hA (hint i) hwV hw0' (he' i)
  have hΛdom : P.IsDominantIntegral Λ := fun i ↦ ⟨n i, hn i⟩
  -- `μ = Λ - β` with `β ∈ Q₊`
  obtain ⟨Λ', hΛ', k, hk, hμk⟩ := hV.isBounded.exists_eq_sub hwV hw0'
  rw [Finset.mem_singleton.1 hΛ'] at hμk
  -- the Casimir operator
  have hc : P.dualBilinForm S (μ + 2 • P.rho) μ = P.dualBilinForm S (Λ + 2 • P.rho) Λ := by
    have h1 := casimir_apply_of_e_smul_eq_zero (S := S) hV.isBounded.isPosFinite hV.isGModule
      hwV he'
    rw [hV.casimir_eq] at h1
    exact (smul_left_injective K hw0' h1).symm
  have hk0 : k = 0 := by
    by_contra hk0
    exact KacMoodyAlgebra.dualBilinForm_add_two_rho_ne S hΛdom hμdom ⟨hk, hk0⟩
      (by rw [hμk]; abel) hc.symm
  rw [hk0, map_zero, sub_zero] at hμk
  subst μ
  -- `w` is a nonzero multiple of the image of `v̄_Λ`
  rw [modWeightSpace_quotient N isBounded.iSup_modWeightSpace_eq_top, modWeightSpace_self,
    Submodule.map_span, Set.image_singleton, Submodule.mem_span_singleton] at hwV
  obtain ⟨t, ht⟩ := hwV
  have ht0 : t ≠ 0 := by rintro rfl; rw [zero_smul] at ht; exact hw0' ht.symm
  have hmem : N.mkQ (hwv P p Λ) ∈ N' := by
    have : N.mkQ (hwv P p Λ) = t⁻¹ • (w : FPowQuotient P p Λ n) := by
      rw [← ht, smul_smul, inv_mul_cancel₀ ht0, one_smul]
      rfl
    rw [this]
    exact N'.smul_of_tower_mem t⁻¹ w.2
  rw [eq_top_iff, ← span_mkQ_hwv (n := n), Submodule.span_le, Set.singleton_subset_iff]
  exact hmem

include S hA hp in
/-- **[Kac78] Thm. 2 (c)**: `L̃(Λ)` is irreducible for `Λ` dominant integral. -/
theorem isSimpleModule_fPowQuotient (hn : ∀ i, Λ (P.coroot i) = n i)
    (hodd : ∀ i, p i = 1 → Even (n i)) : IsSimpleModule 𝒰 (FPowQuotient P p Λ n) := by
  have : Nontrivial (FPowQuotient P p Λ n) :=
    Submodule.Quotient.nontrivial_iff.2 (fPowSubmodule_ne_top hA hn hodd)
  exact { eq_bot_or_eq_top := eq_bot_or_eq_top_fPowQuotient S hA hp hn }

include S hA hp in
/-- **[Kac78] Thm. 2 (c)**: `∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ` is a maximal proper submodule of `M̄(Λ)`, so
`L(Λ) = M̄(Λ) / ∑ᵢ U fᵢ^{nᵢ+1} v̄_Λ`. -/
theorem isCoatom_fPowSubmodule (hn : ∀ i, Λ (P.coroot i) = n i)
    (hodd : ∀ i, p i = 1 → Even (n i)) : IsCoatom (fPowSubmodule P p Λ n) :=
  isSimpleModule_iff_isCoatom.1 (isSimpleModule_fPowQuotient S hA hp hn hodd)

end GVerma


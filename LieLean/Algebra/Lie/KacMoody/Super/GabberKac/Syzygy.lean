import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.FreeGrading
import LieLean.Algebra.Lie.KacMoody.GabberKac

/-!
# The super Gabber–Kac theorem

Let `A` be a symmetrizable generalized Cartan matrix with a super-admissible parity `τ`,
`G̃ = G̃(A, τ)`, `R ⊆ G̃` the maximal ideal meeting `𝔥` trivially and `S ⊆ R` the ideal generated
by the Serre elements. This file proves `R = S` (`maxIdeal_eq_serreIdeal`): the contragredient
Lie superalgebra `G(A, τ) = G̃ / R` is presented by the Chevalley generators, the relations of
`G̃` and the Serre relations.

## Proof

The argument is the super analogue of the proof of the Gabber–Kac theorem ([Kac] §9.11, [GK]);
it is reconstructed. By the Chevalley involution and the weight decomposition of `R` it suffices
to show `R_{-β} ⊆ S` for `β = ∑ kᵢ αᵢ ∈ Q₊ \ {0}`, by induction on the height of `β`. Let
`x ∈ R_{-β} \ S` and suppose `R_{-γ} ⊆ S` for `ht γ < ht β`.

1. `x` is a highest weight vector modulo `S` in the integrable module `G̃ / S`, so
   `⟨β, αᵢ^∨⟩ ≤ 0` for all `i` (`sum_mul_le_zero_of_minimal`) and
   `c = (-β + 2ρ | -β) ≠ 0` (`Matrix.Realization.dualBilinForm_neg_rootOf_add_two_rho_ne_zero`).
2. Write `x = f(t)` with `t = ∑ᵢ cᵢ vᵢ ∈ T(V)` of weight `β` (`exists_eq_sum_mul_ι`). With
   `M̄(Λ)` the Verma modules of `G(A, τ)` (`GVerma`), `s = (f(cᵢ) v̄_{-αᵢ})ᵢ` lies in the kernel
   `Syz` of `E = ⊕ᵢ M̄(-αᵢ) → M̄(0)`, `(mᵢ) ↦ ∑ᵢ (mᵢ ↦ fᵢ v̄₀)`, since `x` kills `M̄(0)`.
3. Let `T ⊆ Syz` be the submodule generated by the weight spaces `Syz_{-γ}`, `ht γ < ht β`. Then
   `eᵢ s ∈ T`. The Casimir operator acts by `0` on `E` (`(-αᵢ + 2ρ | -αᵢ) = 0`) and by `c` on the
   image of `s` in `E / T`; hence `s ∈ T`, and the weight `-β` component of `T` is
   `∑ⱼ fⱼ Syz_{-β+αⱼ}` (`mem_lowerSyz_iff`): `s = ∑ⱼ fⱼ yⱼ`, `yⱼ ∈ Syz`.
4. Lifting `yⱼ` to `T(V)` gives `t = ∑ᵢ gᵢ vᵢ + ∑ⱼ vⱼ ρⱼ` with `gᵢ, ρⱼ` in the left ideal
   `J = T(V) f⁻¹(R)` (`GVerma.fAlg_smul_hwv_eq_zero_iff`). Taking weight components, `f(gᵢ)` and
   `f(ρⱼ)` lie in the left ideal `U S` by the induction hypothesis
   (`fAlg_weightProj_mem_of_mem_gIdeal`), so `x ∈ U S ∩ G̃_{-β} = S` (`mem_serreIdeal_of_mem`), a
   contradiction.

## Main results

* `Matrix.Realization.SuperEnveloping.maxIdeal_eq_serreIdeal`: `R = S`.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.2–2.
* [GK] O. Gabber, V. G. Kac, *On defining relations of certain infinite-dimensional Lie
  algebras*, Bull. Amer. Math. Soc. (N.S.) **5** (1981), 185–189.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §9.11.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H} {p : ι → ZMod 2} [CharZero K]

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

/-! ### The left ideal generated by `S` -/

variable (P p) in
/-- The left ideal `U S` of `U` generated by the Serre ideal `S`. -/
def leftSerre : Submodule 𝒰 𝒰 := Submodule.span 𝒰 (serreIdeal P p : Set 𝒰)

lemma mem_leftSerre_of_mem {x : 𝒰} (hx : x ∈ serreIdeal P p) : x ∈ leftSerre P p :=
  Submodule.subset_span hx

/-- `U S` is stable under right multiplication by the `fᵢ`. -/
lemma mul_f_mem_leftSerre {m : 𝒰} (hm : m ∈ leftSerre P p) (i : ι) :
    m * f P p i ∈ leftSerre P p := by
  induction hm using Submodule.span_induction with
  | mem y hy =>
    have hy : y ∈ serreIdeal P p := hy
    have key : y * f P p i = superBracket P p y (f P p i) + (2 : K)⁻¹ •
        ((f P p i + parity P p (f P p i)) * y + (f P p i - parity P p (f P p i)) *
          parity P p y) := by
      rw [superBracket, sub_add_cancel]
    rw [key]
    refine add_mem (mem_leftSerre_of_mem (superBracket_mem_of_mem_left (isIdeal_serreIdeal P p)
      (fun _ ↦ parity_mem_serreIdeal) hy (f_mem_gTilde P p i))) ?_
    refine Submodule.smul_of_tower_mem _ _ (add_mem ?_ ?_)
    · exact (leftSerre P p).smul_mem _ (mem_leftSerre_of_mem hy)
    · exact (leftSerre P p).smul_mem _ (mem_leftSerre_of_mem (parity_mem_serreIdeal hy))
  | zero => rw [zero_mul]; exact zero_mem _
  | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
  | smul u x _ hx => rw [smul_eq_mul, mul_assoc]; exact (leftSerre P p).smul_mem u hx

/-- The adjoint action of `U S` on `𝔥` lands in `S`. -/
lemma adRep_h_mem_of_mem_leftSerre {m : 𝒰} (hm : m ∈ leftSerre P p) (a : H) :
    adRep P p m (h P p a) ∈ serreIdeal P p := by
  induction hm using Submodule.span_induction with
  | mem y hy =>
    rw [adRep_of_mem_gTilde (serreIdeal_le_gTilde P p hy)]
    exact superBracket_mem_of_mem_left (isIdeal_serreIdeal P p)
      (fun _ ↦ parity_mem_serreIdeal) hy (h_mem_gTilde P p a)
  | zero => rw [map_zero, LinearMap.zero_apply]; exact zero_mem _
  | add x y _ _ hx hy => rw [map_add, LinearMap.add_apply]; exact add_mem hx hy
  | smul u x _ hx =>
    rw [smul_eq_mul, map_mul, Module.End.mul_apply]
    exact adRep_mem_serreIdeal u hx

/-- `U S ∩ G̃_μ = S_μ` for `μ ≠ 0`. -/
lemma mem_serreIdeal_of_mem {μ : Dual K H} (hμ : μ ≠ 0) {x : 𝒰} (hx : x ∈ leftSerre P p)
    (hxg : x ∈ gTilde P p) (hxμ : x ∈ weightSpace P p μ) : x ∈ serreIdeal P p := by
  obtain ⟨a, ha⟩ : ∃ a, μ a ≠ 0 := by
    by_contra h0
    exact hμ (LinearMap.ext fun a ↦ not_not.1 fun h ↦ h0 ⟨a, h⟩)
  have h1 := adRep_h_mem_of_mem_leftSerre hx a
  rw [adRep_of_mem_gTilde hxg, superBracket_of_even_right P p x (isEven_h P p a), hxμ a,
    sub_add_cancel_left] at h1
  have := (serreIdeal P p).smul_mem (-(μ a)⁻¹) h1
  rwa [smul_neg, neg_smul, neg_neg, inv_smul_smul₀ ha] at this

/-! ### The syzygy module -/

section Syzygies

/- Instances on `GVerma` with head `GVerma`: instance search for the `Pi` structures on
`∀ i, GVerma P p (-P.root i)` cannot unify the quotient instances under the binder. -/
noncomputable instance (Λ : Dual K H) : AddCommGroup (GVerma P p Λ) :=
  Submodule.Quotient.addCommGroup _
noncomputable instance (Λ : Dual K H) : Module 𝒰 (GVerma P p Λ) := Submodule.Quotient.module _
noncomputable instance (Λ : Dual K H) : Module K (GVerma P p Λ) := Submodule.Quotient.module' _
instance (Λ : Dual K H) : IsScalarTower K 𝒰 (GVerma P p Λ) :=
  Submodule.Quotient.isScalarTower _ _

variable (P p) in
/-- `E = ⊕ᵢ M̄(-αᵢ)`. -/
abbrev SyzSource : Type _ := ∀ i, GVerma P p (-P.root i)

lemma e_smul_f_smul_hwv_zero (i j : ι) :
    e P p j • f P p i • GVerma.hwv P p 0 = 0 := by
  rw [← mul_smul, e_mul_f, add_smul, smul_assoc, mul_smul, GVerma.e_smul_hwv, smul_zero,
    smul_zero, zero_add]
  split_ifs
  · rw [GVerma.h_smul_hwv, LinearMap.zero_apply, zero_smul]
  · rw [zero_smul]

lemma h_smul_f_smul_hwv_zero (i : ι) (a : H) :
    h P p a • f P p i • GVerma.hwv P p 0 =
      algebraMap K 𝒰 ((-P.root i) a) • f P p i • GVerma.hwv P p 0 := by
  rw [← mul_smul, h_mul_f, sub_smul, mul_smul, GVerma.h_smul_hwv, LinearMap.zero_apply, zero_smul,
    smul_zero, zero_sub, algebraMap_smul, smul_assoc, LinearMap.neg_apply, neg_smul]

variable (P p) in
/-- The component `M̄(-αᵢ) → M̄(0)`, `v̄_{-αᵢ} ↦ fᵢ v̄₀`. -/
def syzComponent (i : ι) : GVerma P p (-P.root i) →ₗ[𝒰] GVerma P p 0 :=
  GVerma.lift GVerma.isGModule (f P p i • GVerma.hwv P p 0)
    (fun j ↦ e_smul_f_smul_hwv_zero i j) (h_smul_f_smul_hwv_zero i)

lemma syzComponent_fAlg_smul_hwv (i : ι) (t : FreeAlgebra K ι) :
    syzComponent P p i (fAlg P p t • GVerma.hwv P p (-P.root i)) =
      fAlg P p t • f P p i • GVerma.hwv P p 0 := by
  rw [map_smul, syzComponent, GVerma.lift_hwv]

variable (P p) in
/-- The map `E → M̄(0)`, `(mᵢ) ↦ ∑ᵢ (mᵢ ↦ fᵢ v̄₀)`. -/
def syzMap : SyzSource P p →ₗ[𝒰] GVerma P p 0 :=
  ∑ i, (syzComponent P p i).comp (LinearMap.proj i)

lemma syzMap_apply (v : SyzSource P p) : syzMap P p v = ∑ i, syzComponent P p i (v i) := by
  simp [syzMap]

variable (P p) in
/-- The syzygies `Syz = ker (E → M̄(0))`. -/
def syzygies : Submodule 𝒰 (SyzSource P p) := LinearMap.ker (syzMap P p)

lemma mem_modWeightSpace_syzSource {μ : Dual K H} {v : SyzSource P p} :
    v ∈ modWeightSpace P p (SyzSource P p) μ ↔
      ∀ i, v i ∈ modWeightSpace P p (GVerma P p (-P.root i)) μ :=
  ⟨fun hv i a ↦ congrFun (hv a) i, fun hv a ↦ funext fun i ↦ hv i a⟩

variable (P p) in
/-- The syzygies of weight `-γ` with `ht γ < ht β`, where `β = ∑ kᵢ αᵢ`. -/
def lowerSet (k : ι → ℤ) : Set (SyzSource P p) :=
  {t | t ∈ syzygies P p ∧ ∃ l, height l < height k ∧
    t ∈ modWeightSpace P p (SyzSource P p) (-P.rootOf l)}

variable (P p) in
/-- The submodule `T ⊆ Syz` generated by the syzygies of weight `-γ` with `ht γ < ht β`. -/
def lowerSyz (k : ι → ℤ) : Submodule 𝒰 (SyzSource P p) := Submodule.span 𝒰 (lowerSet P p k)

variable (P p) in
/-- The span of the `f_{j₁} ⋯ f_{jₘ} t` with `t ∈ lowerSet P p k`; it contains `T`. -/
def lowerSpan (k : ι → ℤ) : Submodule K (SyzSource P p) :=
  Submodule.span K {v | ∃ w t, t ∈ lowerSet P p k ∧ v = fAlg P p (FreeAlgebra.word w) • t}

lemma f_smul_mem_lowerSpan (k : ι → ℤ) (j : ι) {m : SyzSource P p}
    (hm : m ∈ lowerSpan P p k) : f P p j • m ∈ lowerSpan P p k := by
  induction hm using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨w, t, ht, rfl⟩ := hv
    refine Submodule.subset_span ⟨j :: w, t, ht, ?_⟩
    rw [FreeAlgebra.word_cons, map_mul, fAlg_ι, mul_smul]
  | zero => rw [smul_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ c hx

lemma h_smul_mem_lowerSpan (k : ι → ℤ) (a : H) {m : SyzSource P p}
    (hm : m ∈ lowerSpan P p k) : h P p a • m ∈ lowerSpan P p k := by
  induction hm using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨w, t, ht, rfl⟩ := hv
    have hg : fAlg P p (FreeAlgebra.word w) • t ∈ lowerSpan P p k :=
      Submodule.subset_span ⟨w, t, ht, rfl⟩
    obtain ⟨-, l, -, htl⟩ := ht
    rw [← mul_smul, fAlg_word_mem_weightSpace P p w a, add_smul, mul_smul, htl a, smul_assoc,
      smul_comm]
    exact add_mem (Submodule.smul_mem _ _ hg) (Submodule.smul_mem _ _ hg)
  | zero => rw [smul_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ c hx

lemma e_smul_mem_lowerSpan (k : ι → ℤ) (i : ι) {m : SyzSource P p}
    (hm : m ∈ lowerSpan P p k) : e P p i • m ∈ lowerSpan P p k := by
  induction hm using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨w, t, ht, rfl⟩ := hv
    induction w with
    | nil =>
      obtain ⟨hts, l, hl, htl⟩ := ht
      refine Submodule.subset_span ⟨[], e P p i • t, ⟨(syzygies P p).smul_mem _ hts,
        l - Pi.single i 1, ?_, ?_⟩, ?_⟩
      · rw [height_sub_single]; omega
      · have := smul_mem_modWeightSpace (SyzSource P p) (e_mem_weightSpace P p i) htl
        convert this using 2
        rw [map_sub, rootOf_single]
        abel
      · rw [FreeAlgebra.word_nil, map_one, one_smul, one_smul]
    | cons j w ih =>
      rw [FreeAlgebra.word_cons, map_mul, fAlg_ι, mul_smul, ← mul_smul, e_mul_f, add_smul,
        smul_assoc, mul_smul]
      refine add_mem (Submodule.smul_mem _ _ (f_smul_mem_lowerSpan k j ih)) ?_
      split_ifs
      · exact h_smul_mem_lowerSpan k _ (Submodule.subset_span ⟨w, t, ht, rfl⟩)
      · rw [zero_smul]; exact zero_mem _
  | zero => rw [smul_zero]; exact zero_mem _
  | add x y _ _ hx hy => rw [smul_add]; exact add_mem hx hy
  | smul c x _ hx => rw [smul_comm]; exact Submodule.smul_mem _ c hx

lemma smul_mem_lowerSpan (k : ι → ℤ) (u : 𝒰) {m : SyzSource P p}
    (hm : m ∈ lowerSpan P p k) : u • m ∈ lowerSpan P p k := by
  refine induction_on (q := fun u ↦ ∀ m ∈ lowerSpan P p k, u • m ∈ lowerSpan P p k) u
    (fun c m hm ↦ ?_) (fun i m hm ↦ e_smul_mem_lowerSpan k i hm)
    (fun i m hm ↦ f_smul_mem_lowerSpan k i hm) (fun a m hm ↦ h_smul_mem_lowerSpan k a hm)
    (fun x y hx hy m hm ↦ ?_) (fun x y hx hy m hm ↦ ?_) m hm
  · rw [algebraMap_smul]; exact Submodule.smul_mem _ c hm
  · rw [add_smul]; exact add_mem (hx m hm) (hy m hm)
  · rw [mul_smul]; exact hx _ (hy m hm)

lemma lowerSyz_le_lowerSpan (k : ι → ℤ) {s : SyzSource P p} (hs : s ∈ lowerSyz P p k) :
    s ∈ lowerSpan P p k := by
  let N : Submodule 𝒰 (SyzSource P p) :=
    { toAddSubmonoid := (lowerSpan P p k).toAddSubmonoid
      smul_mem' := fun u _ hm ↦ smul_mem_lowerSpan k u hm }
  have : lowerSyz P p k ≤ N := Submodule.span_le.2 fun t ht ↦
    Submodule.subset_span ⟨[], t, ht, by rw [FreeAlgebra.word_nil, map_one, one_smul]⟩
  exact this hs

lemma lowerSyz_le_syzygies (k : ι → ℤ) : lowerSyz P p k ≤ syzygies P p :=
  Submodule.span_le.2 fun _ ht ↦ ht.1

/-- `T_{-β} ⊆ ∑ⱼ fⱼ Syz`. -/
lemma exists_eq_sum_f_smul {k : ι → ℤ} {s : SyzSource P p} (hs : s ∈ lowerSyz P p k)
    (hsk : s ∈ modWeightSpace P p (SyzSource P p) (-P.rootOf k)) :
    ∃ y : ι → SyzSource P p, (∀ j, y j ∈ syzygies P p) ∧ s = ∑ j, f P p j • y j := by
  have hG : ∀ g ∈ {v | ∃ w t, t ∈ lowerSet P p k ∧ v = fAlg P p (FreeAlgebra.word w) • t},
      ∃ ν, g ∈ modWeightSpace P p (SyzSource P p) ν := by
    rintro _ ⟨w, t, ⟨-, l, -, htl⟩, rfl⟩
    exact ⟨_, smul_mem_modWeightSpace _ (fAlg_word_mem_weightSpace P p w) htl⟩
  have := (iSupIndep_modWeightSpace (SyzSource P p)).mem_span_inter hG
    (lowerSyz_le_lowerSpan k hs) hsk
  clear hs hsk
  induction this using Submodule.span_induction with
  | mem g hg =>
    obtain ⟨⟨w, t, ⟨hts, l, hl, htl⟩, rfl⟩, hgk⟩ := hg
    by_cases g0 : fAlg P p (FreeAlgebra.word w) • t = 0
    · exact ⟨0, fun _ ↦ zero_mem _, by simp [g0]⟩
    have hgν := smul_mem_modWeightSpace _ (fAlg_word_mem_weightSpace P p w) htl
    have hν : -P.rootOf (wordVec w) + -P.rootOf l = -P.rootOf k := by
      by_contra hne
      exact g0 (Submodule.disjoint_def.1
        ((iSupIndep_modWeightSpace (SyzSource P p)).pairwiseDisjoint hne) _ hgν hgk)
    have hwl : wordVec w + l = k := P.rootOf_injective (by
      rw [map_add, ← neg_inj, neg_add]; exact hν)
    cases w with
    | nil => rw [wordVec_nil, zero_add] at hwl; exact absurd hl (by rw [hwl]; exact lt_irrefl _)
    | cons j w =>
      refine ⟨Pi.single j (fAlg P p (FreeAlgebra.word w) • t), fun j' ↦ ?_, ?_⟩
      · rcases eq_or_ne j' j with rfl | hj
        · rw [Pi.single_eq_same]; exact (syzygies P p).smul_mem _ hts
        · rw [Pi.single_eq_of_ne hj]; exact zero_mem _
      · rw [Finset.sum_eq_single j (fun j' _ hj ↦ by rw [Pi.single_eq_of_ne hj, smul_zero])
          (by simp), Pi.single_eq_same, FreeAlgebra.word_cons, map_mul, fAlg_ι, mul_smul]
  | zero => exact ⟨0, fun _ ↦ zero_mem _, by simp⟩
  | add x y _ _ hx hy =>
    obtain ⟨a, ha, rfl⟩ := hx
    obtain ⟨b, hb, rfl⟩ := hy
    exact ⟨a + b, fun j ↦ add_mem (ha j) (hb j), by simp [smul_add, Finset.sum_add_distrib]⟩
  | smul c x _ hx =>
    obtain ⟨a, ha, rfl⟩ := hx
    exact ⟨c • a, fun j ↦ Submodule.smul_of_tower_mem _ c (ha j), by
      simp [Finset.smul_sum, smul_comm c]⟩

/-! ### The Casimir operator on the syzygy module -/

section Casimir

lemma isGModule_syzSource : IsGModule P p (SyzSource P p) :=
  fun r hr v ↦ funext fun i ↦ GVerma.isGModule r hr (v i)

open Classical in
lemma isBounded_syzSource :
    IsBounded P p (SyzSource P p) (Finset.univ.biUnion fun i ↦ {-P.root i}) :=
  isBounded_pi fun _ ↦ GVerma.isBounded

lemma isPosFinite_syzSource : IsPosFinite P p (SyzSource P p) :=
  isBounded_syzSource.isPosFinite

lemma hwv_mem_modWeightSpace (Λ : Dual K H) :
    GVerma.hwv P p Λ ∈ modWeightSpace P p (GVerma P p Λ) Λ :=
  GVerma.h_smul_hwv

variable [FiniteDimensional K H]

/-- `Ω = 0` on `E = ⊕ᵢ M̄(-αᵢ)`, since `(-αᵢ + 2ρ | -αᵢ) = 0`. -/
lemma casimir_syzSource (S : A.Symmetrization) (hA : A.IsGeneralizedCartan) (v : SyzSource P p) :
    casimir S isPosFinite_syzSource v = 0 := by
  funext i
  have := map_casimir S isPosFinite_syzSource GVerma.isBounded.isPosFinite
    (LinearMap.proj i : SyzSource P p →ₗ[𝒰] GVerma P p (-P.root i)) v
  rw [LinearMap.proj_apply] at this
  change (casimir S isPosFinite_syzSource v) i = 0
  rw [this, LinearMap.proj_apply, casimir_eq_smul_of_forall_eq_smul GVerma.isGModule _ hA
    (hwv_mem_modWeightSpace _) GVerma.e_smul_hwv
    (fun w ↦ let ⟨t, ht⟩ := GVerma.exists_eq_fAlg_smul_hwv w; ⟨fAlg P p t, ht.symm⟩),
    P.dualBilinForm_neg_root_add_two_rho S hA i, zero_smul]

/-- A syzygy of weight `-β`, `β = ∑ kᵢ αᵢ` with `⟨β, αᵢ^∨⟩ ≤ 0`, whose images under the `eᵢ`
lie in `T_β` lies itself in `T_β`: on `E / T_β` it is a highest-weight vector of weight `-β`, so
`Ω` acts on it by `(-β + 2ρ | -β) ≠ 0`, while `Ω = 0` on `E`. -/
lemma mem_lowerSyz_of_e_smul_mem (S : A.Symmetrization) (hA : A.IsGeneralizedCartan) {k : ι → ℤ}
    (hk : k ∈ posCone ι) (hle : ∀ i, ∑ j, A i j * k j ≤ 0) {s : SyzSource P p}
    (hs : s ∈ modWeightSpace P p (SyzSource P p) (-P.rootOf k))
    (he : ∀ i, e P p i • s ∈ lowerSyz P p k) : s ∈ lowerSyz P p k := by
  set N := lowerSyz P p k
  have hQ : IsPosFinite P p (SyzSource P p ⧸ N) :=
    (isBounded_syzSource.of_surjective N.mkQ N.mkQ_surjective).isPosFinite
  have hQG : IsGModule P p (SyzSource P p ⧸ N) := fun r hr v ↦ by
    obtain ⟨v, rfl⟩ := N.mkQ_surjective v
    rw [← map_smul, isGModule_syzSource r hr v, map_zero]
  have h1 := map_casimir S isPosFinite_syzSource hQ N.mkQ s
  rw [casimir_syzSource S hA, map_zero] at h1
  have hsQ : N.mkQ s ∈ modWeightSpace P p (SyzSource P p ⧸ N) (-P.rootOf k) := fun a ↦ by
    rw [← map_smul, hs a, LinearMap.map_smul_of_tower]
  have heQ : ∀ i, e P p i • N.mkQ s = 0 := fun i ↦ by
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]; exact he i
  rw [casimir_apply_of_e_smul_eq_zero hQ hQG hsQ heQ] at h1
  have := (smul_eq_zero.1 h1.symm).resolve_left
    (P.dualBilinForm_neg_rootOf_add_two_rho_ne_zero S hk hle)
  exact (Submodule.Quotient.mk_eq_zero N).1 this

end Casimir


/-! ### The main step -/

section Main

omit [CharZero K] [Fintype ι] [DecidableEq ι] in
lemma exists_natVec_eq [Finite ι] {k : ι → ℤ} (hk : 0 ≤ k) : ∃ ν : ι →₀ ℕ, natVec ν = k :=
  ⟨Finsupp.equivFunOnFinite.symm fun i ↦ (k i).toNat,
    funext fun i ↦ by simp [natVec, Int.toNat_of_nonneg (hk i)]⟩

omit [CharZero K] [DecidableEq ι] in
lemma height_natVec_le {μ ν : ι →₀ ℕ} (h : μ ≤ ν) : height (natVec μ) ≤ height (natVec ν) :=
  Finset.sum_le_sum fun i _ ↦ by simpa [natVec] using h i

omit [CharZero K] [Fintype ι] in
lemma natVec_tsub_single {ν : ι →₀ ℕ} {i : ι} (hi : 1 ≤ ν i) :
    natVec (ν - Finsupp.single i 1) = natVec ν - Pi.single i 1 := by
  funext j
  rcases eq_or_ne j i with rfl | hj
  · simp [natVec]; omega
  · simp [natVec, hj]

omit [CharZero K] [Fintype ι] [DecidableEq ι] in
lemma ι_eq_wordBasis (i : ι) : FreeAlgebra.ι K i = FreeAlgebra.wordBasis K ι [i] := by
  rw [← word_eq_wordBasis, FreeAlgebra.word_cons, FreeAlgebra.word_nil, mul_one]

omit [Fintype ι] [DecidableEq ι] in
lemma wordWeight_singleton (i : ι) : LusztigF.wordWeight [i] = Finsupp.single i 1 := by
  rw [LusztigF.wordWeight_cons]; simp

/-- The projection onto `U_{-β}`, `β ∈ Q₊ \ {0}`, kills `ñ₊`. -/
lemma wProj_nPlus {k : ι → ℤ} (hk : k ∈ posCone ι) {m : 𝒰} (hm : m ∈ nPlus P p) :
    wProj P p (-P.rootOf k) m = 0 := by
  suffices nPlus P p ≤ LinearMap.ker (wProj P p (-P.rootOf k)) from this hm
  refine (nPlus_le_iff P p).2 fun i w ↦
    wProj_of_mem_ne P p (fun h ↦ ?_) (eLie_mem_weightSpace_rootOf P p i w)
  refine P.rootOf_ne_zero (posCone_add (wordVec_cons_mem_posCone i w) hk).2 ?_
  rw [map_add, h, neg_add_cancel]

/-- An element of `G̃_{-β}`, `β = ∑ νᵢ αᵢ ∈ Q₊ \ {0}`, is `f(t)` with `t ∈ T(V)` of weight `ν`. -/
lemma exists_fAlg_eq {ν : ι →₀ ℕ} (hν : natVec ν ∈ posCone ι) {x : 𝒰} (hxg : x ∈ gTilde P p)
    (hxν : x ∈ weightSpace P p (-P.rootOf (natVec ν))) :
    ∃ t ∈ FreeAlgebra.wordSpan K ν, fAlg P p t = x := by
  obtain ⟨n, hn, a, m, hm, rfl⟩ := (mem_gTilde_iff P p).1 hxg
  obtain ⟨t, -, rfl⟩ := nMinus_le_fAug P p hn
  refine ⟨FreeAlgebra.weightProj K ν t, FreeAlgebra.weightProj_mem ν t, ?_⟩
  have hx := wProj_of_mem P p hxν
  rw [map_add, map_add, wProj_of_mem_ne P p (fun h ↦ P.rootOf_ne_zero hν.2 (neg_eq_zero.1 h.symm))
    (h_mem_weightSpace P p a), wProj_nPlus hν hm, add_zero, add_zero, AlgHom.toLinearMap_apply,
    wProj_fAlg] at hx
  exact hx

/-- Under the induction hypothesis, the weight components of `J` of height `< ht β` map into
`U S`. -/
lemma fAlg_weightProj_mem_leftSerre {k : ι → ℤ}
    (hmin : ∀ l ∈ posCone ι, height l < height k →
      maxIdeal P p ⊓ weightSpace P p (-P.rootOf l) ≤ serreIdeal P p)
    {t : FreeAlgebra K ι} (ht : t ∈ gIdeal P p) {ν : ι →₀ ℕ} (hν : height (natVec ν) < height k) :
    fAlg P p (FreeAlgebra.weightProj K ν t) ∈ leftSerre P p := by
  refine fAlg_weightProj_mem_of_mem_gIdeal ht ν fun μ hμ r hr hrμ ↦ ?_
  have hrw := fAlg_mem_weightSpace_of_mem_wordSpan P p hrμ
  by_cases hμ0 : natVec μ = 0
  · have : fAlg P p r ∈ maxIdeal P p ⊓ LinearMap.range (h P p) := by
      refine ⟨hr, ?_⟩
      rw [← gTilde_inf_weightSpace_zero P p]
      refine ⟨(isIdeal_maxIdeal P p).le_gTilde hr, ?_⟩
      rwa [hμ0, map_zero, neg_zero] at hrw
    rw [maxIdeal_inf_range_h, Submodule.mem_bot] at this
    rw [this]
    exact zero_mem _
  · refine mem_leftSerre_of_mem (hmin _ ⟨fun i ↦ by simp [natVec], hμ0⟩
      ((height_natVec_le hμ).trans_lt hν) ⟨hr, hrw⟩)

variable [FiniteDimensional K H]

/-- The main step: if `R_{-γ} ⊆ S` for all `γ ∈ Q₊ \ {0}` of height `< ht β`, then
`R_{-β} ⊆ S`. -/
theorem mem_serreIdeal_of_minimal (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
    {k : ι → ℤ} (hk : k ∈ posCone ι)
    (hmin : ∀ l ∈ posCone ι, height l < height k →
      maxIdeal P p ⊓ weightSpace P p (-P.rootOf l) ≤ serreIdeal P p)
    {x : 𝒰} (hx : x ∈ maxIdeal P p) (hxk : x ∈ weightSpace P p (-P.rootOf k)) :
    x ∈ serreIdeal P p := by
  by_contra hxS
  have hle := fun i ↦ sum_mul_le_zero_of_minimal hA hk hmin hx hxk hxS i
  obtain ⟨ν, rfl⟩ := exists_natVec_eq hk.1
  have hxg := (isIdeal_maxIdeal P p).le_gTilde hx
  obtain ⟨t₀, ht₀, rfl⟩ := exists_fAlg_eq hk hxg hxk
  have hν0 : ν ≠ 0 := fun h ↦ hk.2 (by rw [h]; funext i; simp [natVec])
  obtain ⟨c, hc, hc0, ht⟩ := exists_eq_sum_mul_ι hν0 ht₀
  obtain ⟨s, hs⟩ : ∃ s : SyzSource P p,
      ∀ i, s i = fAlg P p (c i) • GVerma.hwv P p (-P.root i) := ⟨_, fun _ ↦ rfl⟩
  -- `s` is a syzygy of weight `-β`
  have hss : s ∈ syzygies P p := by
    change syzMap P p s = 0
    rw [syzMap_apply]
    have : ∑ i, syzComponent P p i (s i) = fAlg P p t₀ • GVerma.hwv P p 0 := by
      rw [ht, map_sum, Finset.sum_smul]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [hs, syzComponent_fAlg_smul_hwv, map_mul, fAlg_ι, mul_smul]
    rw [this]
    exact GVerma.isGModule _ hx _
  have hsk : s ∈ modWeightSpace P p (SyzSource P p) (-P.rootOf (natVec ν)) := by
    refine mem_modWeightSpace_syzSource.2 fun i ↦ ?_
    rw [hs]
    by_cases hi : ν i = 0
    · rw [hc0 i hi, map_zero, zero_smul]
      exact zero_mem _
    · have := smul_mem_modWeightSpace _ (fAlg_mem_weightSpace_of_mem_wordSpan P p (hc i))
        (hwv_mem_modWeightSpace (P := P) (p := p) (-P.root i))
      convert this using 2
      rw [natVec_tsub_single (by omega), map_sub, rootOf_single]
      abel
  -- the Casimir step: `s ∈ T`
  have he : ∀ j, e P p j • s ∈ lowerSyz P p (natVec ν) := fun j ↦
    Submodule.subset_span ⟨(syzygies P p).smul_mem _ hss, natVec ν - Pi.single j 1,
      by rw [height_sub_single]; omega, by
        have := smul_mem_modWeightSpace (SyzSource P p) (e_mem_weightSpace P p j) hsk
        convert this using 2
        rw [map_sub, rootOf_single]
        abel⟩
  obtain ⟨y, hy, hsy⟩ := exists_eq_sum_f_smul (mem_lowerSyz_of_e_smul_mem S hA hk hle hsk he) hsk
  choose τ hτ using fun j i ↦ GVerma.exists_eq_fAlg_smul_hwv (y j i)
  -- lifting to `T(V)`
  have hg : ∀ i, c i - ∑ j, FreeAlgebra.ι K j * τ j i ∈ gIdeal P p := fun i ↦ by
    rw [← GVerma.fAlg_smul_hwv_eq_zero_iff (Λ := -P.root i), map_sub, sub_smul, map_sum,
      Finset.sum_smul, sub_eq_zero, ← hs i, hsy, Finset.sum_apply]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [Pi.smul_apply, map_mul, fAlg_ι, mul_smul, hτ]
  have hρ : ∀ j, ∑ i, τ j i * FreeAlgebra.ι K i ∈ gIdeal P p := fun j ↦ by
    rw [← GVerma.fAlg_smul_hwv_eq_zero_iff (Λ := 0), map_sum, Finset.sum_smul]
    have := hy j
    change syzMap P p (y j) = 0 at this
    rw [syzMap_apply] at this
    rw [← this]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [← hτ j i, syzComponent_fAlg_smul_hwv, map_mul, fAlg_ι, mul_smul]
  have key : t₀ = ∑ i, (c i - ∑ j, FreeAlgebra.ι K j * τ j i) * FreeAlgebra.ι K i +
      ∑ j, FreeAlgebra.ι K j * ∑ i, τ j i * FreeAlgebra.ι K i := by
    rw [ht, eq_comm, ← sub_eq_zero]
    simp only [sub_mul, Finset.sum_sub_distrib, Finset.sum_mul, Finset.mul_sum, mul_assoc]
    rw [Finset.sum_comm]
    abel
  -- taking the weight-`β` component
  have hmem : fAlg P p t₀ ∈ leftSerre P p := by
    rw [← FreeAlgebra.weightProj_self ht₀, key]
    simp only [map_add, map_sum]
    refine add_mem (Submodule.sum_mem _ fun i _ ↦ ?_) (Submodule.sum_mem _ fun j _ ↦ ?_)
    · rw [ι_eq_wordBasis, FreeAlgebra.weightProj_mul_wordBasis, wordWeight_singleton]
      split_ifs with hw
      · rw [map_mul, ← ι_eq_wordBasis, fAlg_ι]
        refine mul_f_mem_leftSerre (fAlg_weightProj_mem_leftSerre hmin (hg i) ?_) i
        rw [natVec_tsub_single (Finsupp.single_le_iff.1 hw), height_sub_single]
        omega
      · rw [map_zero]; exact zero_mem _
    · rw [ι_eq_wordBasis, FreeAlgebra.weightProj_wordBasis_mul, wordWeight_singleton]
      split_ifs with hw
      · rw [map_mul, ← ι_eq_wordBasis, fAlg_ι]
        refine (leftSerre P p).smul_mem (f P p j) (fAlg_weightProj_mem_leftSerre hmin (hρ j) ?_)
        rw [natVec_tsub_single (Finsupp.single_le_iff.1 hw), height_sub_single]
        omega
      · rw [map_zero]; exact zero_mem _
  exact hxS (mem_serreIdeal_of_mem (neg_ne_zero.2 (P.rootOf_ne_zero hk.2)) hmem hxg hxk)

/-- `R_{-β} ⊆ S` for every `β ∈ Q₊ \ {0}`. -/
theorem maxIdeal_inf_weightSpace_le_serreIdeal (S : A.Symmetrization)
    (hA : A.IsGeneralizedCartan) {k : ι → ℤ} (hk : k ∈ posCone ι) :
    maxIdeal P p ⊓ weightSpace P p (-P.rootOf k) ≤ serreIdeal P p := by
  suffices ∀ n : ℕ, ∀ k ∈ posCone ι, height k < n →
      maxIdeal P p ⊓ weightSpace P p (-P.rootOf k) ≤ serreIdeal P p from
    this _ k hk (by omega : height k < ((height k).toNat + 1 : ℕ))
  intro n
  induction n with
  | zero => intro k hk h; have := height_pos hk; omega
  | succ n ih =>
    rintro k hk hkn x ⟨hx, hxk⟩
    exact mem_serreIdeal_of_minimal S hA hk (fun l hl hlk ↦ ih l hl (by omega)) hx hxk

variable (P p) in
/-- **Super Gabber–Kac theorem.** For a symmetrizable generalized Cartan matrix `A` with a
super-admissible parity `τ`, the maximal ideal `R` of `G̃(A, τ)` meeting `𝔥` trivially is the
ideal `S` generated by the Serre elements ([Kac78] §1.2–2; argument reconstructed from [Kac] §9.11,
[GK]). -/
theorem maxIdeal_eq_serreIdeal (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
    (hp : A.IsSuperAdmissible p) : maxIdeal P p = serreIdeal P p := by
  refine le_antisymm (fun y hy ↦ ?_) (serreIdeal_le_maxIdeal P p S hA hp)
  have hN : ∀ a, ∀ x ∈ maxIdeal P p, superBracket P p (h P p a) x ∈ maxIdeal P p :=
    fun a x hx ↦ (isIdeal_maxIdeal P p).superBracket_mem _ (h_mem_gTilde P p a) x hx
  refine Submodule.iSup_induction _ (motive := fun x ↦ x ∈ serreIdeal P p)
    (le_iSup_inf_weightSpace P p _ hN hy) (fun μ x hx ↦ ?_) (zero_mem _)
    fun _ _ ↦ add_mem
  obtain ⟨hxR, hxμ⟩ := hx
  by_cases hx0 : x = 0
  · rw [hx0]; exact zero_mem _
  rcases mem_allWeights P p ((isIdeal_maxIdeal P p).le_gTilde hxR) hxμ hx0 with
    (⟨k, hk, rfl⟩ | rfl) | ⟨k, hk, rfl⟩
  · exact maxIdeal_inf_weightSpace_le_serreIdeal S hA hk ⟨hxR, hxμ⟩
  · have : x ∈ maxIdeal P p ⊓ LinearMap.range (h P p) := by
      refine ⟨hxR, ?_⟩
      rw [← gTilde_inf_weightSpace_zero P p]
      exact ⟨(isIdeal_maxIdeal P p).le_gTilde hxR, hxμ⟩
    rw [maxIdeal_inf_range_h, Submodule.mem_bot] at this
    exact absurd this hx0
  · have h1 := maxIdeal_inf_weightSpace_le_serreIdeal S hA hk
      ⟨omega_mem_maxIdeal P p hxR, omega_mem_weightSpace P p hxμ⟩
    have h2 := omega_mem_serreIdeal h1
    rw [← AlgHom.comp_apply, omega_comp_omega] at h2
    simpa using parity_mem_serreIdeal h2

end Main


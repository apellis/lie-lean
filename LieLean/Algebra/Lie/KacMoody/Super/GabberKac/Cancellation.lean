import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.Syzygy
import LieLean.Algebra.QuantumGroup.LusztigF.Reverse

/-!
# Cancellation in the negative part of a contragredient Lie superalgebra

Let `A` be a generalized Cartan matrix with a parity `τ : ι → ZMod 2`, `G̃ = G̃(A, τ)`, `R ⊆ G̃`
the maximal ideal meeting `𝔥` trivially, `f : T(V) → U(G̃)` the algebra map `vᵢ ↦ fᵢ` and
`J ⊆ T(V)` the left ideal generated by `f⁻¹(R)` (`gIdeal`). Then `T(V) / J ≅ U(G⁻)` for
`G = G̃ / R` (`GVerma.fAlg_smul_hwv_eq_zero_iff`). This file proves that left and right
multiplication by the generators `vᵢ` are injective on `T(V) / J`, without symmetrizability or
admissibility hypotheses on `A` and `τ`.

## Main results

* `exists_nat_of_f_smul_eq_zero`: rank-one integrality. If `v` has weight `μ`, `fᵢ v = 0` and
  `eᵢᴺ v = 0`, then `⟨μ, αᵢ^∨⟩ ∈ -ℕ` (for `τᵢ` odd the string coefficients alternate, see
  `rankOneCoeff_neg_one`).
* `mem_gIdeal_of_ι_mul_mem'`: `vᵢ t ∈ J → t ∈ J` (left cancellation), proved in the Verma
  module `M̄(ρ/2)`, where no weight has a nonpositive integral pairing with any coroot.
* `mem_span_sLie_of_mem_fPre`: `f⁻¹(R)` is spanned by lifts of iterated super commutators of the
  generators; hence `f⁻¹(R)` is stable under the reversal antiautomorphism (`rev_mem_fPre`),
  `J` is a two-sided ideal (`mul_mem_gIdeal`) stable under reversal (`rev_mem_gIdeal`).
* `mem_gIdeal_of_mul_ι_mem'`: `t vᵢ ∈ J → t ∈ J` (right cancellation).
* `syzComponent_injective`: the map `M̄(-αᵢ) → M̄(0)`, `v̄_{-αᵢ} ↦ fᵢ v̄₀`, is injective. This is
  the injectivity of Verma maps used for the denominator identity of `G(A, τ)`.

The arguments are reconstructed; in the even case they reduce to the statement that `U(𝔫₋)` has
no zero divisors of degree one, which is usually deduced from PBW ([Kac] §9).

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.2–2.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §9.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H} {p : ι → ZMod 2} [CharZero K]
  {V : Type*} [AddCommGroup V] [Module K V] [Module (P.SuperEnveloping p) V]
  [IsScalarTower K (P.SuperEnveloping p) V]

local notation "𝒰" => SuperEnveloping P p

/-- The coefficients in `fᵢ eᵢᵏ v = cₖ eᵢᵏ⁻¹ v` for `fᵢ v = 0`, `v` of weight `s` for `αᵢ^∨`. -/
def rankOneCoeff (σ s : K) : ℕ → K
  | 0 => 0
  | k + 1 => σ * (rankOneCoeff σ s k - (s + 2 * k))

omit [CharZero K] in
lemma rankOneCoeff_one (s : K) (k : ℕ) :
    rankOneCoeff 1 s k = -(k * (s + k - 1)) := by
  induction k with
  | zero => simp [rankOneCoeff]
  | succ k ih => rw [rankOneCoeff, ih]; push_cast; ring

omit [CharZero K] in
lemma rankOneCoeff_neg_one (s : K) (k : ℕ) :
    rankOneCoeff (-1) s (2 * k) = 2 * k ∧ rankOneCoeff (-1) s (2 * k + 1) = s + 2 * k := by
  induction k with
  | zero => simp [rankOneCoeff]
  | succ k ih =>
    have h1 : rankOneCoeff (-1) s (2 * (k + 1)) = 2 * (k + 1) := by
      rw [show 2 * (k + 1) = 2 * k + 1 + 1 by ring, rankOneCoeff, ih.2]; push_cast; ring
    refine ⟨by push_cast; exact h1, ?_⟩
    rw [show 2 * (k + 1) + 1 = 2 * (k + 1) + 1 by rfl, rankOneCoeff, h1]; push_cast; ring

omit [CharZero K] in
/-- `fᵢ eᵢᵏ⁺¹ v = cₖ₊₁ eᵢᵏ v` for `v` of weight `μ` with `fᵢ v = 0`. -/
lemma f_smul_e_pow_smul (hA : A.IsGeneralizedCartan) (i : ι) {μ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V μ) (hf : f P p i • v = 0) (k : ℕ) :
    f P p i • (e P p i ^ (k + 1) • v) =
      rankOneCoeff (superSign K p i i) (μ (P.coroot i)) (k + 1) • (e P p i ^ k • v) := by
  induction k with
  | zero =>
    rw [pow_one, pow_zero, one_smul, ← mul_smul, f_mul_e, ite_eq_left rfl]
    simp only [sub_smul, smul_assoc, mul_smul, hf, smul_zero, zero_sub, hv _]
    simp [rankOneCoeff, smul_smul]
  | succ k ih =>
    set σ := superSign K p i i
    have hw := e_pow_smul_mem_modWeightSpace hv i (k + 1)
    have h1 : f P p i • (e P p i ^ (k + 1 + 1) • v) = σ • (e P p i • (f P p i •
        (e P p i ^ (k + 1) • v))) - σ • (h P p (P.coroot i) • (e P p i ^ (k + 1) • v)) := by
      rw [pow_succ' _ (k + 1), mul_smul, ← mul_smul, f_mul_e, ite_eq_left rfl, sub_smul,
        smul_assoc, smul_assoc, mul_smul]
    have h2 : (μ + (k + 1) • P.root i) (P.coroot i) = μ (P.coroot i) + 2 * (k + 1 : ℕ) := by
      simp [P.root_coroot, hA.diag]; ring
    have h3 : rankOneCoeff σ (μ (P.coroot i)) (k + 1 + 1) =
        σ * (rankOneCoeff σ (μ (P.coroot i)) (k + 1) - (μ (P.coroot i) + 2 * (k + 1 : ℕ))) :=
      rfl
    rw [h1, ih, hw, h2, smul_comm (e P p i) (rankOneCoeff _ _ _), ← mul_smul (e P p i),
      ← pow_succ', h3, smul_smul, smul_smul, ← sub_smul, mul_sub]

/-- A nonzero vector `v` of weight `μ` with `fᵢ v = 0` on which `eᵢ` is nilpotent has
`⟨μ, αᵢ^∨⟩ ∈ -ℕ`. -/
theorem exists_nat_of_f_smul_eq_zero (hA : A.IsGeneralizedCartan) (i : ι) {μ : Dual K H}
    {v : V} (hv : v ∈ modWeightSpace P p V μ) (hv0 : v ≠ 0) (hf : f P p i • v = 0)
    {N : ℕ} (hN : e P p i ^ N • v = 0) : ∃ m : ℕ, μ (P.coroot i) = -m := by
  classical
  have hex : ∃ n, e P p i ^ (n + 1) • v = 0 := ⟨N, by
    rw [pow_succ', mul_smul, hN, smul_zero]⟩
  set m := Nat.find hex
  have hm : e P p i ^ (m + 1) • v = 0 := Nat.find_spec hex
  have hm' : e P p i ^ m • v ≠ 0 := by
    rcases Nat.eq_zero_or_pos m with h0 | hpos
    · rw [h0, pow_zero, one_smul]; exact hv0
    · obtain ⟨n, hn⟩ : ∃ n, m = n + 1 := ⟨m - 1, by omega⟩
      have := Nat.find_min hex (show n < m by omega)
      rwa [hn]
  have hc := f_smul_e_pow_smul hA i hv hf m
  rw [hm, smul_zero, eq_comm, smul_eq_zero] at hc
  have hc := hc.resolve_right hm'
  refine ⟨m, ?_⟩
  rw [superSign_self] at hc
  split_ifs at hc
  · obtain ⟨j, hj | hj⟩ := Nat.even_or_odd' (m + 1)
    · rw [hj, (rankOneCoeff_neg_one _ j).1] at hc
      have : (j : K) = 0 := by linear_combination hc / 2
      have : j = 0 := by exact_mod_cast this
      omega
    · rw [hj, (rankOneCoeff_neg_one _ j).2] at hc
      have : (m : K) = 2 * j := by exact_mod_cast (show m = 2 * j by omega)
      linear_combination hc + this
  · rw [rankOneCoeff_one] at hc
    have h1 : ((m + 1 : ℕ) : K) ≠ 0 := by exact_mod_cast Nat.succ_ne_zero m
    push_cast at hc h1
    have := (mul_eq_zero.1 (neg_eq_zero.1 hc)).resolve_left h1
    linear_combination this

/-- In a module bounded by `Λ`, `eᵢ` is nilpotent on weight vectors. -/
lemma exists_e_pow_smul_eq_zero {Λ : Dual K H} (hV : IsBounded P p V {Λ}) (i : ι)
    {μ : Dual K H} {v : V} (hv : v ∈ modWeightSpace P p V μ) :
    ∃ N : ℕ, e P p i ^ N • v = 0 := by
  by_cases hv0 : v = 0
  · exact ⟨0, by rw [hv0, smul_zero]⟩
  obtain ⟨μ', hΛ, d₀, -, hd₀⟩ := hV.exists_eq_sub hv hv0
  rw [Finset.mem_singleton] at hΛ
  rw [hΛ] at hd₀
  refine ⟨(d₀ i).toNat + 1, ?_⟩
  by_contra hne
  obtain ⟨_, hΛ', d, hd, hdeq⟩ := hV.exists_eq_sub (e_pow_smul_mem_modWeightSpace hv i _) hne
  rw [Finset.mem_singleton] at hΛ'
  rw [hΛ'] at hdeq
  have : P.rootOf d = P.rootOf (d₀ - (((d₀ i).toNat + 1 : ℕ) : ℤ) • Pi.single i 1) := by
    rw [map_sub, map_zsmul, rootOf_single, natCast_zsmul]
    rw [hd₀] at hdeq
    calc P.rootOf d = Λ - (Λ - P.rootOf d) := by abel
      _ = Λ - (Λ - P.rootOf d₀ + (((d₀ i).toNat + 1 : ℕ) • P.root i)) := by rw [hdeq]
      _ = _ := by abel
  have h := congr_fun (P.rootOf_injective this) i
  have := hd i
  simp only [Pi.sub_apply, Pi.smul_apply, Pi.single_eq_same, smul_eq_mul, mul_one,
    Pi.zero_apply] at h this
  omega

/-- In a module bounded by `Λ`, a vector of weight `μ` with `fᵢ v = 0` vanishes when
`⟨μ, αᵢ^∨⟩ ∉ -ℕ`. -/
theorem eq_zero_of_f_smul_eq_zero (hA : A.IsGeneralizedCartan) {Λ : Dual K H}
    (hV : IsBounded P p V {Λ}) (i : ι) {μ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V μ) (hf : f P p i • v = 0)
    (hμ : ∀ m : ℕ, μ (P.coroot i) ≠ -m) : v = 0 := by
  by_contra hv0
  obtain ⟨N, hN⟩ := exists_e_pow_smul_eq_zero hV i hv
  obtain ⟨m, hm⟩ := exists_nat_of_f_smul_eq_zero hA i hv hv0 hf hN
  exact hμ m hm

/-- Left cancellation of generators modulo `J` on homogeneous elements: `vᵢ t ∈ J` implies
`t ∈ J`. The proof works in `M̄(ρ/2)`, where `⟨ρ/2 - β, αᵢ^∨⟩ ∉ ℤ`. -/
theorem mem_gIdeal_of_ι_mul_mem (hA : A.IsGeneralizedCartan) {ν : ι →₀ ℕ}
    {t : FreeAlgebra K ι} (ht : t ∈ FreeAlgebra.wordSpan K ν) (i : ι)
    (hit : FreeAlgebra.ι K i * t ∈ gIdeal P p) : t ∈ gIdeal P p := by
  rw [← GVerma.fAlg_smul_hwv_eq_zero_iff (Λ := (2 : K)⁻¹ • P.rho)] at hit ⊢
  refine eq_zero_of_f_smul_eq_zero hA GVerma.isBounded i
    (μ := (2 : K)⁻¹ • P.rho - P.rootOf (natVec ν)) ?_ ?_ ?_
  · rw [sub_eq_neg_add]
    exact smul_mem_modWeightSpace _ (fAlg_mem_weightSpace_of_mem_wordSpan P p ht)
      GVerma.h_smul_hwv
  · rwa [← mul_smul, ← fAlg_ι P p i, ← map_mul]
  · intro m hm
    rw [LinearMap.sub_apply, LinearMap.smul_apply, rho_coroot, rootOf_apply_coroot,
      smul_eq_mul, mul_one] at hm
    have h2 : (1 : K) = 2 * (((A *ᵥ natVec ν) i : ℤ) - (m : ℤ) : ℤ) := by
      push_cast; linear_combination 2 * hm
    have h2' : (1 : ℤ) = 2 * ((A *ᵥ natVec ν) i - m) := by exact_mod_cast h2
    omega

/-! ### Words and parities -/

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma mul_mem_wordSpan {μ ν : ι →₀ ℕ} {x y : FreeAlgebra K ι}
    (hx : x ∈ FreeAlgebra.wordSpan K μ) (hy : y ∈ FreeAlgebra.wordSpan K ν) :
    x * y ∈ FreeAlgebra.wordSpan K (μ + ν) := by
  induction hx using FreeAlgebra.wordSpan_induction with
  | word w hw =>
    induction hy using FreeAlgebra.wordSpan_induction with
    | word u hu =>
      rw [← FreeAlgebra.wordBasis_append]
      exact FreeAlgebra.wordBasis_mem_wordSpan_of_eq (by rw [LusztigF.wordWeight_append, hw, hu])
    | zero => rw [mul_zero]; exact zero_mem _
    | add y z _ _ hy hz => rw [mul_add]; exact add_mem hy hz
    | smul c y _ hy => rw [mul_smul_comm]; exact Submodule.smul_mem _ c hy
  | zero => rw [zero_mul]; exact zero_mem _
  | add a b _ _ ha hb => rw [add_mul]; exact add_mem ha hb
  | smul c a _ ha => rw [smul_mul_assoc]; exact Submodule.smul_mem _ c ha

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma ι_mem_wordSpan (i : ι) :
    FreeAlgebra.ι K i ∈ FreeAlgebra.wordSpan K (Finsupp.single i 1) := by
  rw [ι_eq_wordBasis]
  exact FreeAlgebra.wordBasis_mem_wordSpan_of_eq (wordWeight_singleton i)

variable (p) in
/-- The number of odd letters, with multiplicity, of a weight `ν ∈ ℕ[I]`. -/
def oddDeg (ν : ι →₀ ℕ) : ℕ := ∑ i, ν i * (p i).val

omit [DecidableEq ι] [CharZero K] in
lemma oddDeg_add (μ ν : ι →₀ ℕ) : oddDeg p (μ + ν) = oddDeg p μ + oddDeg p ν := by
  simp [oddDeg, add_mul, Finset.sum_add_distrib]

omit [DecidableEq ι] [CharZero K] in
lemma oddDeg_single (j : ι) : oddDeg p (Finsupp.single j 1) = (p j).val := by
  classical simp [oddDeg, Finsupp.single_apply]

omit [DecidableEq ι] [CharZero K] in
lemma natCast_oddDeg_single_add (j : ι) (ν : ι →₀ ℕ) :
    ((oddDeg p (Finsupp.single j 1 + ν) : ℕ) : ZMod 2) = p j + (oddDeg p ν : ZMod 2) := by
  rw [oddDeg_add, oddDeg_single, Nat.cast_add, ZMod.natCast_zmod_val]

omit [CharZero K] in
/-- `f(t)` is homogeneous of the parity of the weight of `t`. -/
lemma isHomog_fAlg {ν : ι →₀ ℕ} {t : FreeAlgebra K ι} (ht : t ∈ FreeAlgebra.wordSpan K ν) :
    IsHomog P p (oddDeg p ν : ZMod 2) (fAlg P p t) := by
  induction ht using FreeAlgebra.wordSpan_induction with
  | word w hw =>
    subst hw
    induction w with
    | nil => simp [IsHomog, oddDeg]
    | cons j w ih =>
      rw [← FreeAlgebra.ι_mul_wordBasis, map_mul, fAlg_ι, LusztigF.wordWeight_cons,
        natCast_oddDeg_single_add]
      exact (isHomog_f P p j).mul ih
  | zero => rw [map_zero]; exact isHomog_zero _
  | add x y _ _ hx hy => rw [map_add]; exact hx.add hy
  | smul c x _ hx => rw [map_smul]; exact hx.smul c

omit [Fintype ι] [CharZero K] in
/-- Every element of `T(V)` is the sum of its weight components. -/
lemma sum_weightProj (x : FreeAlgebra K ι) :
    ∑ ν ∈ ((FreeAlgebra.wordBasis K ι).repr x).support.image LusztigF.wordWeight,
      FreeAlgebra.weightProj K ν x = x := by
  set c := (FreeAlgebra.wordBasis K ι).repr x
  have hx : x = ∑ w ∈ c.support, c w • FreeAlgebra.wordBasis K ι w := by
    conv_lhs => rw [← (FreeAlgebra.wordBasis K ι).linearCombination_repr x]
    rw [Finsupp.linearCombination_apply, Finsupp.sum]
  conv_rhs => rw [hx]
  conv_lhs => rw [hx]
  simp only [map_sum, map_smul, FreeAlgebra.weightProj_wordBasis, smul_ite, smul_zero]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun w hw ↦ ?_
  rw [Finset.sum_ite_eq]
  simp [Finset.mem_image_of_mem _ hw]

/-! ### Iterated super commutators in `T(V)` -/

variable (p) in
/-- The lift `[v_{j₁}, [v_{j₂}, ⋯ [v_{jₖ}, vᵢ] ⋯ ]]` to `T(V)` of the iterated super commutator
of the `f`'s, so that `f` maps it to `ω` of the iterated super commutator of the `e`'s. -/
def sLie (i : ι) : List ι → FreeAlgebra K ι
  | [] => FreeAlgebra.ι K i
  | j :: w => FreeAlgebra.ι K j * sLie i w -
      zSign K (p j * ((w.map p).sum + p i)) • (sLie i w * FreeAlgebra.ι K j)

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma sLie_mem_wordSpan (i : ι) (w : List ι) :
    sLie p i w ∈ FreeAlgebra.wordSpan K (Finsupp.single i 1 + LusztigF.wordWeight w) := by
  induction w with
  | nil => simpa [sLie] using ι_mem_wordSpan i
  | cons j w ih =>
    rw [sLie, LusztigF.wordWeight_cons, add_left_comm]
    refine sub_mem (mul_mem_wordSpan (ι_mem_wordSpan j) ih)
      (Submodule.smul_mem _ _ ?_)
    rw [add_comm (Finsupp.single j 1)]
    exact mul_mem_wordSpan ih (ι_mem_wordSpan j)

lemma fAlg_sLie (i : ι) (w : List ι) :
    fAlg P p (sLie p i w) = omega P p (eLie P p i w) := by
  induction w with
  | nil => simp [sLie]
  | cons j w ih =>
    rw [sLie, eLie_cons, omega_superBracket, omega_e, ← ih,
      superBracket_of_isHomog (isHomog_f P p j) (ih ▸ (isHomog_eLie P p i w).omega P p)]
    simp [map_sub, map_mul, map_smul]

/-- `ñ₋` is the image under `f` of the span of the `sLie i w`. -/
lemma nMinus_le_map_span_sLie :
    nMinus P p ≤ (Submodule.span K (Set.range fun x : ι × List ι ↦ sLie p x.1 x.2)).map
      (fAlg P p).toLinearMap := by
  rw [nMinus, Submodule.map_le_iff_le_comap, nPlus_le_iff]
  intro i w
  rw [Submodule.mem_comap, Submodule.map_span]
  refine Submodule.subset_span ⟨sLie p i w, ⟨(i, w), rfl⟩, ?_⟩
  rw [AlgHom.toLinearMap_apply, AlgHom.toLinearMap_apply, fAlg_sLie]

/-- The weight-`ν` elements of `f⁻¹(R)` are combinations of the `sLie i w` of weight `ν`. -/
theorem mem_span_sLie_of_mem_fPre {ν : ι →₀ ℕ} {t : FreeAlgebra K ι} (ht : t ∈ fPre P p)
    (htν : t ∈ FreeAlgebra.wordSpan K ν) :
    t ∈ Submodule.span K {x | ∃ i w, Finsupp.single i 1 + LusztigF.wordWeight w = ν ∧
      sLie p i w = x} := by
  have hw := fAlg_mem_weightSpace_of_mem_wordSpan P p htν
  have hg := (isIdeal_maxIdeal P p).le_gTilde (mem_fPre.1 ht)
  by_cases hν : ν = 0
  · subst hν
    have : fAlg P p t ∈ maxIdeal P p ⊓ LinearMap.range (h P p) := by
      refine ⟨mem_fPre.1 ht, ?_⟩
      rw [← gTilde_inf_weightSpace_zero P p]
      refine ⟨hg, ?_⟩
      have h0 : natVec (0 : ι →₀ ℕ) = 0 := by ext; simp [natVec]
      rwa [h0, map_zero, neg_zero] at hw
    rw [maxIdeal_inf_range_h, Submodule.mem_bot, ← map_zero (fAlg P p)] at this
    rw [fAlg_injective P p this]
    exact zero_mem _
  have hk : natVec ν ∈ posCone ι := ⟨fun i ↦ by simp [natVec], fun h ↦ hν
    (natVec_injective (h.trans (by ext; simp [natVec])))⟩
  have hμ : -P.rootOf (natVec ν) ≠ 0 := neg_ne_zero.2 (P.rootOf_ne_zero hk.2)
  rcases mem_nMinus_or_mem_nPlus_of_mem_weightSpace hg hw hμ with hn | hn
  · obtain ⟨s, hs, hst⟩ := nMinus_le_map_span_sLie hn
    rw [AlgHom.toLinearMap_apply] at hst
    rw [← FreeAlgebra.weightProj_self htν, ← fAlg_injective P p hst]
    clear hst
    induction hs using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨⟨i, w⟩, rfl⟩ := hy
      rw [FreeAlgebra.weightProj_of_mem (sLie_mem_wordSpan i w)]
      split_ifs with h
      · exact Submodule.subset_span ⟨i, w, h, rfl⟩
      · exact zero_mem _
    | zero => simp
    | add y z _ _ hy hz => rw [map_add]; exact add_mem hy hz
    | smul c y _ hy => rw [map_smul]; exact Submodule.smul_mem _ c hy
  · have h1 := wProj_of_mem P p hw
    rw [wProj_nPlus hk hn, eq_comm, ← map_zero (fAlg P p)] at h1
    rw [fAlg_injective P p h1]
    exact zero_mem _

/-! ### Reversal -/

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma zSign_natCast (n : ℕ) : zSign K (n : ZMod 2) = (-1) ^ n := by
  induction n with
  | zero => simp
  | succ n ih => rw [Nat.cast_succ, zSign_add, ih, zSign_one, pow_succ]

omit [DecidableEq ι] [CharZero K] in
lemma natCast_oddDeg_wordWeight (w : List ι) :
    ((oddDeg p (LusztigF.wordWeight w) : ℕ) : ZMod 2) = (w.map p).sum := by
  induction w with
  | nil => simp [oddDeg]
  | cons j w ih =>
    rw [LusztigF.wordWeight_cons, natCast_oddDeg_single_add, ih, List.map_cons, List.sum_cons]

variable (K p) in
/-- The sign by which reversal acts on the iterated super commutators of weight `ν`:
`(-1)^{n+1} (-1)^{o(o-1)/2}` for `n` letters of which `o` are odd. -/
def revSign (ν : ι →₀ ℕ) : K := (-1) ^ (∑ i, ν i + 1) * (-1) ^ (oddDeg p ν).choose 2

omit [DecidableEq ι] [CharZero K] in
lemma revSign_single_add (j : ι) (ν : ι →₀ ℕ) :
    revSign K p (Finsupp.single j 1 + ν) =
      -(zSign K (p j * (oddDeg p ν : ZMod 2)) * revSign K p ν) := by
  have h1 : ∑ i, (Finsupp.single j 1 + ν : ι →₀ ℕ) i = ∑ i, ν i + 1 := by
    classical simp [Finset.sum_add_distrib, Finsupp.single_apply, add_comm]
  rw [revSign, revSign, h1, oddDeg_add, oddDeg_single]
  rcases zmod_two_cases (p j) with h | h <;> rw [h]
  · simp [pow_succ]
  · rw [show (1 : ZMod 2).val = 1 from rfl, one_mul, zSign_natCast, add_comm 1,
      Nat.choose_succ_succ', Nat.choose_one_right, pow_add, pow_add, pow_one]
    ring

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma rev_ι (j : ι) : LusztigF.rev K ι (FreeAlgebra.ι K j) = FreeAlgebra.ι K j :=
  LusztigF.rev_θ j

omit [DecidableEq ι] [CharZero K] in
/-- Reversal acts on `sLie i w` by the sign `revSign` of its weight. -/
lemma rev_sLie (i : ι) (w : List ι) :
    LusztigF.rev K ι (sLie p i w) =
      revSign K p (Finsupp.single i 1 + LusztigF.wordWeight w) • sLie p i w := by
  induction w with
  | nil =>
    have : (p i).val.choose 2 = 0 := Nat.choose_eq_zero_of_lt (by have := ZMod.val_lt (p i); omega)
    classical simp [sLie, revSign, oddDeg_single, this, Finsupp.single_apply]
  | cons j w ih =>
    rw [sLie, map_sub, map_smul, LusztigF.rev_mul, LusztigF.rev_mul, ih, rev_ι,
      LusztigF.wordWeight_cons, add_left_comm, revSign_single_add j, natCast_oddDeg_single_add,
      natCast_oddDeg_wordWeight, add_comm (p i)]
    set z := zSign K (p j * ((w.map p).sum + p i))
    have hz : z * z = 1 := zSign_mul_self K _
    simp only [mul_smul_comm, smul_mul_assoc, smul_sub, smul_smul, neg_mul, neg_smul]
    rw [show z * revSign K p (Finsupp.single i 1 + LusztigF.wordWeight w) * z =
      revSign K p (Finsupp.single i 1 + LusztigF.wordWeight w) by
        rw [mul_comm, ← mul_assoc, hz, one_mul], mul_comm z]
    abel

omit [DecidableEq ι] [CharZero K] in
lemma rev_of_mem_span_sLie {ν : ι →₀ ℕ} {x : FreeAlgebra K ι}
    (hx : x ∈ Submodule.span K {x | ∃ i w, Finsupp.single i 1 + LusztigF.wordWeight w = ν ∧
      sLie p i w = x}) : LusztigF.rev K ι x = revSign K p ν • x := by
  induction hx using Submodule.span_induction with
  | mem y hy => obtain ⟨i, w, rfl, rfl⟩ := hy; exact rev_sLie i w
  | zero => simp
  | add y z _ _ hy hz => rw [map_add, hy, hz, smul_add]
  | smul c y _ hy => rw [map_smul, hy, smul_comm]

omit [Fintype ι] [DecidableEq ι] [CharZero K] in
lemma rev_mem_wordSpan {ν : ι →₀ ℕ} {t : FreeAlgebra K ι} (ht : t ∈ FreeAlgebra.wordSpan K ν) :
    LusztigF.rev K ι t ∈ FreeAlgebra.wordSpan K ν :=
  LusztigF.rev_mem_weightSpace ht

/-- `f⁻¹(R)` is stable under the reversal anti-automorphism of `T(V)`. -/
theorem rev_mem_fPre {t : FreeAlgebra K ι} (ht : t ∈ fPre P p) : LusztigF.rev K ι t ∈ fPre P p := by
  rw [← sum_weightProj t, map_sum]
  refine sum_mem fun ν _ ↦ ?_
  have h1 := weightProj_mem_fPre ht ν
  rw [rev_of_mem_span_sLie (mem_span_sLie_of_mem_fPre h1 (FreeAlgebra.weightProj_mem ν t))]
  exact Submodule.smul_mem _ _ h1

/-- `J` is graded. -/
theorem weightProj_mem_gIdeal {t : FreeAlgebra K ι} (ht : t ∈ gIdeal P p) (ν : ι →₀ ℕ) :
    FreeAlgebra.weightProj K ν t ∈ gIdeal P p := by
  rw [← GVerma.fAlg_smul_hwv_eq_zero_iff (Λ := 0)]
  have := fAlg_weightProj_mem_of_mem_gIdeal
    (M := LinearMap.ker (LinearMap.toSpanSingleton 𝒰 (GVerma P p 0) (GVerma.hwv P p 0))) ht ν
    fun μ _ r hr _ ↦ by
      simp [GVerma.fAlg_smul_hwv_eq_zero_iff, mem_gIdeal_of_mem_fPre hr]
  simpa using this

lemma mul_ι_mem_gIdeal_of_mem_fPre {r : FreeAlgebra K ι} (hr : r ∈ fPre P p) (j : ι) :
    r * FreeAlgebra.ι K j ∈ gIdeal P p := by
  rw [← sum_weightProj r, Finset.sum_mul]
  refine sum_mem fun ν _ ↦ ?_
  have hs := weightProj_mem_fPre hr ν
  have hh := isHomog_fAlg (P := P) (p := p) (FreeAlgebra.weightProj_mem ν r)
  set s := FreeAlgebra.weightProj K ν r
  set z := zSign K (p j * (oddDeg p ν : ZMod 2))
  have hb : FreeAlgebra.ι K j * s - z • (s * FreeAlgebra.ι K j) ∈ fPre P p := by
    rw [mem_fPre, map_sub, map_smul, map_mul, map_mul, fAlg_ι,
      ← superBracket_of_isHomog (isHomog_f P p j) hh]
    exact (isIdeal_maxIdeal P p).superBracket_mem _ (f_mem_gTilde P p j) _ (mem_fPre.1 hs)
  have : s * FreeAlgebra.ι K j = z • (FreeAlgebra.ι K j * s -
      (FreeAlgebra.ι K j * s - z • (s * FreeAlgebra.ι K j))) := by
    rw [sub_sub_cancel, smul_smul, zSign_mul_self, one_smul]
  rw [this]
  exact Submodule.smul_of_tower_mem _ _ (sub_mem (Submodule.smul_mem _ (FreeAlgebra.ι K j)
    (mem_gIdeal_of_mem_fPre hs)) (mem_gIdeal_of_mem_fPre hb))

/-- `J` is a two-sided ideal. -/
theorem mul_mem_gIdeal {t : FreeAlgebra K ι} (ht : t ∈ gIdeal P p) (a : FreeAlgebra K ι) :
    t * a ∈ gIdeal P p := by
  have hι : ∀ t ∈ gIdeal P p, ∀ j, t * FreeAlgebra.ι K j ∈ gIdeal P p := by
    intro t ht j
    induction ht using Submodule.span_induction with
    | mem r hr => exact mul_ι_mem_gIdeal_of_mem_fPre hr j
    | zero => simp
    | add x y _ _ hx hy => rw [add_mul]; exact add_mem hx hy
    | smul a x _ hx => rw [smul_eq_mul, mul_assoc]; exact Submodule.smul_mem _ a hx
  induction a using FreeAlgebra.induction generalizing t with
  | grade0 c =>
    rw [← Algebra.commutes, ← Algebra.smul_def]; exact Submodule.smul_of_tower_mem _ c ht
  | grade1 j => exact hι t ht j
  | mul a b ha hb => rw [← mul_assoc]; exact hb (ha ht)
  | add a b ha hb => rw [mul_add]; exact add_mem (ha ht) (hb ht)

/-- `J` is stable under reversal. -/
theorem rev_mem_gIdeal {t : FreeAlgebra K ι} (ht : t ∈ gIdeal P p) :
    LusztigF.rev K ι t ∈ gIdeal P p := by
  induction ht using Submodule.span_induction with
  | mem r hr => exact mem_gIdeal_of_mem_fPre (rev_mem_fPre hr)
  | zero => simp
  | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
  | smul a x _ hx => rw [smul_eq_mul, LusztigF.rev_mul]; exact mul_mem_gIdeal hx _

/-- Right cancellation of generators modulo `J` on homogeneous elements. -/
theorem mem_gIdeal_of_mul_ι_mem (hA : A.IsGeneralizedCartan) {ν : ι →₀ ℕ}
    {t : FreeAlgebra K ι} (ht : t ∈ FreeAlgebra.wordSpan K ν) (i : ι)
    (hit : t * FreeAlgebra.ι K i ∈ gIdeal P p) : t ∈ gIdeal P p := by
  have := rev_mem_gIdeal hit
  rw [LusztigF.rev_mul, rev_ι] at this
  have := rev_mem_gIdeal (mem_gIdeal_of_ι_mul_mem hA (rev_mem_wordSpan ht) i this)
  rwa [LusztigF.rev_rev] at this

/-! ### Cancellation of generators -/

/-- Left cancellation of generators modulo `J`: `vᵢ t ∈ J` implies `t ∈ J`. -/
theorem mem_gIdeal_of_ι_mul_mem' (hA : A.IsGeneralizedCartan) {t : FreeAlgebra K ι} (i : ι)
    (hit : FreeAlgebra.ι K i * t ∈ gIdeal P p) : t ∈ gIdeal P p := by
  rw [← sum_weightProj t]
  refine sum_mem fun ν _ ↦ mem_gIdeal_of_ι_mul_mem hA (FreeAlgebra.weightProj_mem ν t) i ?_
  have := weightProj_mem_gIdeal hit (Finsupp.single i 1 + ν)
  rwa [ι_eq_wordBasis, FreeAlgebra.weightProj_wordBasis_mul, wordWeight_singleton,
    ite_eq_left le_self_add, add_tsub_cancel_left, ← ι_eq_wordBasis] at this

/-- Right cancellation of generators modulo `J`: `t vᵢ ∈ J` implies `t ∈ J`. -/
theorem mem_gIdeal_of_mul_ι_mem' (hA : A.IsGeneralizedCartan) {t : FreeAlgebra K ι} (i : ι)
    (hit : t * FreeAlgebra.ι K i ∈ gIdeal P p) : t ∈ gIdeal P p := by
  rw [← sum_weightProj t]
  refine sum_mem fun ν _ ↦ mem_gIdeal_of_mul_ι_mem hA (FreeAlgebra.weightProj_mem ν t) i ?_
  have := weightProj_mem_gIdeal hit (ν + Finsupp.single i 1)
  rwa [ι_eq_wordBasis, FreeAlgebra.weightProj_mul_wordBasis, wordWeight_singleton,
    ite_eq_left le_add_self, add_tsub_cancel_right, ← ι_eq_wordBasis] at this

/-- The component `M̄(-αᵢ) → M̄(0)`, `v̄_{-αᵢ} ↦ fᵢ v̄₀`, of the syzygy map is injective. -/
theorem syzComponent_injective (hA : A.IsGeneralizedCartan) (i : ι) :
    Function.Injective (syzComponent P p i) := by
  rw [← LinearMap.ker_eq_bot, LinearMap.ker_eq_bot']
  intro v hv
  obtain ⟨t, rfl⟩ := GVerma.exists_eq_fAlg_smul_hwv v
  rw [syzComponent_fAlg_smul_hwv, ← mul_smul, ← fAlg_ι P p i, ← map_mul,
    GVerma.fAlg_smul_hwv_eq_zero_iff] at hv
  exact GVerma.fAlg_smul_hwv_eq_zero_iff.2 (mem_gIdeal_of_mul_ι_mem' hA i hv)


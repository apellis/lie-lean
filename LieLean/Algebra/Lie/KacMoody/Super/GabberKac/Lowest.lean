import LieLean.Algebra.Lie.KacMoody.Super.Adjoint
import LieLean.Algebra.Lie.KacMoody.SerrePresented.LowestWeight

/-!
# The Serre ideal of `G̃(A, τ)` and lowest weight vectors of `R / S`

Let `S ⊆ G̃(A, τ)` be the ideal generated by the Serre elements `(ad eᵢ)^{1-aᵢⱼ} eⱼ` and
`(ad fᵢ)^{1-aᵢⱼ} fⱼ` (`i ≠ j`), realized inside `U = U(G̃(A, τ))` as the preimage of the
submodule `serreAd` of the adjoint module (`SuperEnveloping.serreIdeal`). It is an ideal
(`isIdeal_serreIdeal`) and, for a symmetrizable admissible matrix, it lies in the maximal ideal `R`
(`serreIdeal_le_maxIdeal`).

This file contains the first step of the proof of the super Gabber–Kac theorem `R = S`: let
`x ∈ R` have weight `-β`, `β = ∑ kⱼ αⱼ ∈ Q₊ \ {0}`, with `x ∉ S`, and suppose that `R` and `S`
agree in the weights `-γ` with `ht γ < ht β`. Then `[eᵢ, x] ∈ S` for all `i`
(`superBracket_e_mem_serreIdeal_of_minimal`), so the image of `x` in the integrable module
`G̃(A, τ) / S` (`isIntegrable_quotient`) is a nonzero highest weight vector of weight `-β`. Hence
`⟨β, αᵢ^∨⟩ ≤ 0` for all `i` (`sum_mul_le_zero_of_minimal`), by `𝔰𝔩₂`-theory for the triples of
`Integrable.lean` (`exists_nat_of_e_smul_eq_zero`). This is the super analogue of the first step
of the proof of [Kac] Thm. 9.11 (cf. `KacMoody/SerrePresented/LowestWeight.lean`).

## Main definitions

* `Matrix.Realization.SuperEnveloping.serreIdeal`: the ideal `S` generated by the Serre elements.

## Main results

* `Matrix.Realization.SuperEnveloping.isIdeal_serreIdeal`, `serreIdeal_le_maxIdeal`: `S ⊆ R` is
  an ideal.
* `Matrix.Realization.SuperEnveloping.exists_nat_of_e_smul_eq_zero`: highest weights of integrable
  modules are dominant.
* `Matrix.Realization.SuperEnveloping.sum_mul_le_zero_of_minimal`: the inequality
  `⟨β, αᵢ^∨⟩ ≤ 0`.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.2–1.4.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §9.11.
-/

open Module LieModule

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2) [CharZero K]

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

attribute [local instance] LieRing.ofAssociativeRing LieRingModule.ofAssociativeModule
  LieModule.ofAssociativeModule

/-! ### Highest weights of integrable modules -/

section Integrable

variable {P p} {V : Type*} [AddCommGroup V] [Module K V] [Module (P.SuperEnveloping p) V]
  [IsScalarTower K (P.SuperEnveloping p) V] (hA : A.IsGeneralizedCartan)

include hA in
/-- In an integrable module, a nonzero vector `v` of weight `μ` with `eᵢ v = 0` has
`⟨μ, αᵢ^∨⟩ = dᵢ n` for some `n ∈ ℕ` (cf. [Kac] Lemma 3.2 (a)). -/
theorem exists_nat_of_e_smul_eq_zero (hV : IsIntegrable P p V) {μ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V μ) (hv0 : v ≠ 0) {i : ι} (he : e P p i • v = 0) :
    ∃ n : ℕ, μ (P.coroot i) = ((sl2Deg p i * n : ℕ) : K) := by
  have hE : ⁅sl2E P p i, v⁆ = 0 := by
    change sl2E P p i • v = 0
    unfold sl2E
    split_ifs
    · rw [smul_assoc, sq, mul_smul, he, smul_zero, smul_zero]
    · exact he
  obtain ⟨n, hn⟩ := IsSl2Triple.HasPrimitiveVectorWith.exists_nat_of_exists_pow_eq_zero
    (t := isSl2Triple P p (hA := hA) i) ⟨hv0, sl2H_smul hv i, hE⟩ (hV.exists_sl2F i v)
  exact ⟨n, by rw [apply_coroot_eq, hn]; push_cast; ring⟩

end Integrable

/-! ### The Serre ideal -/

/-- The ideal `S` of `G̃(A, τ)` generated by the Serre elements, as a subspace of `U`. -/
def serreIdeal : Submodule K 𝒰 := ((serreAd P p).restrictScalars K).comap (toAd P p).toLinearMap

lemma mem_serreIdeal {x : 𝒰} : x ∈ serreIdeal P p ↔ toAd P p x ∈ serreAd P p := Iff.rfl

lemma serreIdeal_le_gTilde : serreIdeal P p ≤ gTilde P p := fun _ hx ↦
  (toAd_mem_gTildeAd P p).1 (serreAd_le_gTildeAd P p hx)

variable {P p} in
lemma adRep_mem_serreIdeal (u : 𝒰) {z : 𝒰} (hz : z ∈ serreIdeal P p) :
    adRep P p u z ∈ serreIdeal P p := by
  rw [mem_serreIdeal, ← smul_toAd]
  exact (serreAd P p).smul_mem u hz

/-- `S` is an ideal of `G̃(A, τ)`. -/
theorem isIdeal_serreIdeal : IsIdeal P p (serreIdeal P p) where
  le_gTilde := serreIdeal_le_gTilde P p
  superBracket_mem x hx y hy := by
    rw [← adRep_of_mem_gTilde hx]
    exact adRep_mem_serreIdeal x hy

lemma serreE_mem_serreIdeal {i j : ι} (hij : i ≠ j) : serreE P p i j ∈ serreIdeal P p :=
  serreE_mem_serreAd P p hij

lemma serreF_mem_serreIdeal {i j : ι} (hij : i ≠ j) : serreF P p i j ∈ serreIdeal P p :=
  serreF_mem_serreAd P p hij

section MaxIdeal

variable [FiniteDimensional K H] (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
  (hp : A.IsSuperAdmissible p)

include S hA hp in
/-- `S ⊆ R`: the Serre elements lie in `R` ([Kac78] §1.2). -/
theorem serreIdeal_le_maxIdeal : serreIdeal P p ≤ maxIdeal P p := by
  have : serreAd P p ≤ maxIdealAd P p := by
    refine Submodule.span_le.2 ?_
    rintro _ ⟨x, ⟨i, j, hij, rfl | rfl⟩, rfl⟩
    · exact (toAd_mem_maxIdealAd P p).2 (serreE_mem_maxIdeal P p S hA hp hij)
    · exact (toAd_mem_maxIdealAd P p).2 (serreF_mem_maxIdeal P p S hA hp hij)
  exact fun x hx ↦ (toAd_mem_maxIdealAd P p).1 (this hx)

end MaxIdeal

/-! ### Lowest weight vectors of `R / S` -/

variable {P p}

/-- Let `x ∈ R` have weight `-β`, `β = ∑ kⱼ αⱼ ∈ Q₊ \ {0}`, and suppose that `R ⊆ S` in the
weights `-γ` with `ht γ < ht β`. Then `[eᵢ, x] ∈ S` for all `i` (cf. the proof of [Kac]
Thm. 9.11; reconstructed argument). -/
theorem superBracket_e_mem_serreIdeal_of_minimal {k : ι → ℤ} (hk : k ∈ posCone ι)
    (hmin : ∀ l ∈ posCone ι, height l < height k →
      maxIdeal P p ⊓ weightSpace P p (-P.rootOf l) ≤ serreIdeal P p)
    {x : 𝒰} (hx : x ∈ maxIdeal P p) (hxk : x ∈ weightSpace P p (-P.rootOf k)) (i : ι) :
    superBracket P p (e P p i) x ∈ serreIdeal P p := by
  have hyr : superBracket P p (e P p i) x ∈ maxIdeal P p :=
    (isIdeal_maxIdeal P p).superBracket_mem _ (e_mem_gTilde P p i) _ hx
  have hyk : superBracket P p (e P p i) x ∈ weightSpace P p (-P.rootOf (k - Pi.single i 1)) := by
    have := superBracket_mem_weightSpace (e_mem_weightSpace P p i) hxk
    rwa [map_sub, rootOf_single, neg_sub, sub_eq_neg_add, add_comm]
  have hyg := (isIdeal_maxIdeal P p).le_gTilde hyr
  rcases SerrePresentedAlgebra.sub_single_mem_posCone_or P hk i with hl | hl | hl
  · rw [hl, map_zero, neg_zero] at hyk
    have : superBracket P p (e P p i) x ∈ maxIdeal P p ⊓ LinearMap.range (h P p) := by
      rw [← gTilde_inf_weightSpace_zero P p]
      exact ⟨hyr, hyg, hyk⟩
    rw [maxIdeal_inf_range_h, Submodule.mem_bot] at this
    rw [this]
    exact zero_mem _
  · have hlt : height (k - Pi.single i 1) < height k := by
      have := height_add (k - Pi.single i 1) (Pi.single i 1)
      rw [sub_add_cancel] at this
      have h1 : height (Pi.single i 1 : ι → ℤ) = 1 := by simp [height]
      omega
    exact hmin _ hl hlt ⟨hyr, hyk⟩
  · by_contra hne
    exact hl (mem_allWeights P p hyg hyk fun h0 ↦ hne (h0 ▸ zero_mem _))

variable (hA : A.IsGeneralizedCartan)

include hA in
/-- Under the hypotheses of `superBracket_e_mem_serreIdeal_of_minimal`, if `x ∉ S` then
`⟨β, αᵢ^∨⟩ ≤ 0`, i.e. `∑ⱼ aᵢⱼ kⱼ ≤ 0`, for all `i`: the image of `x` in the integrable module
`G̃(A, τ) / S` is a highest weight vector of weight `-β` ([Kac] §9.11; reconstructed argument). -/
theorem sum_mul_le_zero_of_minimal {k : ι → ℤ} (hk : k ∈ posCone ι)
    (hmin : ∀ l ∈ posCone ι, height l < height k →
      maxIdeal P p ⊓ weightSpace P p (-P.rootOf l) ≤ serreIdeal P p)
    {x : 𝒰} (hx : x ∈ maxIdeal P p) (hxk : x ∈ weightSpace P p (-P.rootOf k))
    (hxS : x ∉ serreIdeal P p) (i : ι) : ∑ j, A i j * k j ≤ 0 := by
  have hV := isIntegrable_quotient (serreAd P p) (fun _ _ hij ↦ serreE_mem_serreAd P p hij)
    (fun _ _ hij ↦ serreF_mem_serreAd P p hij)
  have hxg := (isIdeal_maxIdeal P p).le_gTilde hx
  have hmk : ∀ (y : 𝒰) (hy : y ∈ gTilde P p),
      (Submodule.Quotient.mk (p := (serreAd P p).comap (gTildeAd P p).subtype)
        ⟨toAd P p y, (toAd_mem_gTildeAd P p).2 hy⟩ = 0 ↔ y ∈ serreIdeal P p) := fun y hy ↦ by
    rw [Submodule.Quotient.mk_eq_zero]
    rfl
  set v := Submodule.Quotient.mk (p := (serreAd P p).comap (gTildeAd P p).subtype)
    ⟨toAd P p x, (toAd_mem_gTildeAd P p).2 hxg⟩
  have hsmul : ∀ u : 𝒰, u • v = Submodule.Quotient.mk (p := (serreAd P p).comap
      (gTildeAd P p).subtype) ⟨toAd P p (adRep P p u x),
        (toAd_mem_gTildeAd P p).2 (adRep_mem_gTilde u hxg)⟩ := fun _ ↦ rfl
  have hv0 : v ≠ 0 := fun h0 ↦ hxS ((hmk x hxg).1 h0)
  have hv : v ∈ modWeightSpace P p _ (-P.rootOf k) := fun a ↦ by
    rw [hsmul, ← Submodule.Quotient.mk_smul]
    congr 1
    ext
    change toAd P p (adRep P p (h P p a) x) = (-P.rootOf k) a • toAd P p x
    rw [adRep_of_mem_gTilde (h_mem_gTilde P p a), superBracket_h_of_mem_weightSpace P p a hxk,
      map_smul]
  have he : e P p i • v = 0 := by
    rw [hsmul, hmk _ (adRep_mem_gTilde _ hxg), adRep_of_mem_gTilde (e_mem_gTilde P p i)]
    exact superBracket_e_mem_serreIdeal_of_minimal hk hmin hx hxk i
  obtain ⟨n, hn⟩ := exists_nat_of_e_smul_eq_zero hA hV hv hv0 he
  rw [LinearMap.neg_apply, rootOf_apply_coroot, neg_eq_iff_eq_neg] at hn
  have : (∑ j, A i j * k j : ℤ) = -((sl2Deg p i * n : ℕ) : ℤ) := by exact_mod_cast hn
  omega

end Matrix.Realization.SuperEnveloping

end

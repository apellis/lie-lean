import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.GVerma

/-!
# Integrability at a node of modules over `G(A, τ)`

Let `V` be a module over `G(A, τ) = G̃(A, τ) / R`. If `A` is a symmetrizable generalized Cartan
matrix and `τ` is admissible, the Serre elements lie in `R`, so `ad eᵢ` and `ad fᵢ` act locally
nilpotently on `G(A, τ)`. By the Leibniz rule, the vectors of `V` killed by a power of `Eᵢ`
(resp. `Fᵢ`) form a submodule (`nilSubmodule`). Consequently `V` is integrable at `i` as soon as
it is generated by vectors killed by powers of `eᵢ` and `fᵢ` (`isIntegrableAt_of_span`); in
particular the quotient `M̄(Λ) / U fᵢᵐ v̄_Λ` of the Verma module of `G(A, τ)` is integrable at
`i` for every `Λ` and `m` (`GVerma.isIntegrableAt_quotient`).

## Main definitions

* `Matrix.Realization.SuperEnveloping.nilSubmodule`: the vectors killed by a power of `x`.

## Main results

* `Matrix.Realization.SuperEnveloping.isIntegrableAt_of_span`
* `Matrix.Realization.SuperEnveloping.GVerma.isIntegrableAt_quotient`

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.4, §2.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, Lemma 3.4.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} {P : Realization A K H} {p : ι → ZMod 2}

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

variable [CharZero K]

/-- If `x` acts on `G̃(A, τ)` locally nilpotently modulo `R` at `g`, then `(ad x)ᵏ g ∈ R` for
all large `k`. -/
lemma exists_adRep_pow_mem_maxIdeal {x g : 𝒰}
    (h : ∃ n, x ^ n • toAd P p g ∈ maxIdealAd P p) :
    ∃ a, ∀ k, a ≤ k → (adRep P p x ^ k) g ∈ maxIdeal P p := by
  obtain ⟨n, hn⟩ := h
  rw [smul_toAd, toAd_mem_maxIdealAd P p, map_pow] at hn
  refine ⟨n, fun k hk ↦ ?_⟩
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hk
  rw [add_comm, pow_add, Module.End.mul_apply, ← map_pow]
  exact adRep_mem_maxIdeal _ hn

variable {V : Type*} [AddCommGroup V] [Module K V] [Module (P.SuperEnveloping p) V]
  [IsScalarTower K (P.SuperEnveloping p) V]

attribute [local instance] LieRing.ofAssociativeRing LieRingModule.ofAssociativeModule
  LieModule.ofAssociativeModule

/-- The Leibniz rule on a `G(A, τ)`-module: if `(ad x)ᵏ g ∈ R` for `k ≥ a` and `xᵇ v = 0`, then
`x^{a + b} g v = 0`. -/
lemma pow_smul_smul_eq_zero (hV : IsGModule P p V) {x g : 𝒰} {a b : ℕ}
    (hx : ∀ z, adRep P p x z = x * z - z * x)
    (hg : ∀ k, a ≤ k → (adRep P p x ^ k) g ∈ maxIdeal P p) {v : V} (hv : x ^ b • v = 0) :
    x ^ (a + b) • (g • v) = 0 := by
  have had : ∀ k (y : 𝒰), (LieAlgebra.ad K 𝒰 x ^ k) y = (adRep P p x ^ k) y := by
    intro k
    induction k with
    | zero => intro y; rfl
    | succ k ih =>
      intro y
      rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply, ih,
        LieAlgebra.ad_apply, Ring.lie_def, hx]
  have hgv : g • v = ⁅g, v⁆ := rfl
  rw [hgv, ← toEnd_pow_apply, LieModule.toEnd_pow_lie]
  refine Finset.sum_eq_zero fun ij hij ↦ ?_
  rw [Finset.mem_antidiagonal] at hij
  rw [had, toEnd_pow_apply]
  change _ • ((adRep P p x ^ ij.1) g • (x ^ ij.2 • v)) = 0
  by_cases hi : a ≤ ij.1
  · rw [hV _ (hg _ hi), smul_zero]
  · obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le' (show b ≤ ij.2 by omega)
    rw [hc, pow_add, mul_smul, hv, smul_zero, smul_zero, smul_zero]

omit [CharZero K] [Module K V] [IsScalarTower K 𝒰 V] in
lemma pow_smul_eq_zero_of_le {x : 𝒰} {n k : ℕ} (hnk : n ≤ k) {v : V} (hv : x ^ n • v = 0) :
    x ^ k • v = 0 := by
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le' hnk
  rw [pow_add, mul_smul, hv, smul_zero]

variable (P p V) in
/-- The vectors of `V` killed by a power of `x`. If `(ad x)ᵏ g ∈ R` for large `k` and all
generators `g`, this is a `U`-submodule of every `G(A, τ)`-module. -/
def nilSubmodule (hV : IsGModule P p V) {x : 𝒰} (hx : ∀ z, adRep P p x z = x * z - z * x)
    (he : ∀ j, ∃ a, ∀ k, a ≤ k → (adRep P p x ^ k) (e P p j) ∈ maxIdeal P p)
    (hf : ∀ j, ∃ a, ∀ k, a ≤ k → (adRep P p x ^ k) (f P p j) ∈ maxIdeal P p)
    (hh : ∀ c, ∃ a, ∀ k, a ≤ k → (adRep P p x ^ k) (h P p c) ∈ maxIdeal P p) :
    Submodule 𝒰 V where
  carrier := {v | ∃ n, x ^ n • v = 0}
  add_mem' := by
    rintro v w ⟨n, hn⟩ ⟨m, hm⟩
    refine ⟨n + m, ?_⟩
    rw [smul_add, pow_smul_eq_zero_of_le (Nat.le_add_right n m) hn,
      pow_smul_eq_zero_of_le (Nat.le_add_left m n) hm, add_zero]
  zero_mem' := ⟨0, smul_zero _⟩
  smul_mem' := by
    intro u v hv
    refine induction_on (q := fun u ↦ ∀ v : V, (∃ n, x ^ n • v = 0) →
      ∃ n, x ^ n • (u • v) = 0) u ?_ ?_ ?_ ?_ ?_ ?_ v hv
    · rintro c v ⟨n, hn⟩
      refine ⟨n, ?_⟩
      rw [← mul_smul, ← Algebra.commutes, mul_smul, hn, smul_zero]
    · rintro j v ⟨b, hb⟩
      obtain ⟨a, ha⟩ := he j
      exact ⟨a + b, pow_smul_smul_eq_zero hV hx ha hb⟩
    · rintro j v ⟨b, hb⟩
      obtain ⟨a, ha⟩ := hf j
      exact ⟨a + b, pow_smul_smul_eq_zero hV hx ha hb⟩
    · rintro c v ⟨b, hb⟩
      obtain ⟨a, ha⟩ := hh c
      exact ⟨a + b, pow_smul_smul_eq_zero hV hx ha hb⟩
    · rintro y z hy hz v hv
      obtain ⟨n, hn⟩ := hy v hv
      obtain ⟨m, hm⟩ := hz v hv
      refine ⟨n + m, ?_⟩
      rw [add_smul, smul_add, pow_smul_eq_zero_of_le (Nat.le_add_right n m) hn,
        pow_smul_eq_zero_of_le (Nat.le_add_left m n) hm, add_zero]
    · rintro y z hy hz v hv
      rw [mul_smul]
      exact hy _ (hz v hv)

lemma exists_e_pow_smul_eq_zero_iff (i : ι) (v : V) :
    (∃ n, e P p i ^ n • v = 0) ↔ ∃ n, sl2E P p i ^ n • v = 0 := by
  have hd : ∀ n, ((sl2Deg p i : K) ^ n) ≠ 0 := fun n ↦
    pow_ne_zero _ (by exact_mod_cast (sl2Deg_pos p i).ne')
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le (Nat.le_mul_of_pos_left n (sl2Deg_pos p i))
    have := congr_arg (e P p i ^ c • ·) hn
    simp only [smul_zero, ← mul_smul, ← pow_add] at this
    rw [add_comm, ← hc, e_pow_sl2Deg_mul, smul_assoc] at this
    exact (smul_eq_zero.1 this).resolve_left (hd n)
  · rintro ⟨n, hn⟩
    exact ⟨sl2Deg p i * n, by rw [e_pow_sl2Deg_mul, smul_assoc, hn, smul_zero]⟩

lemma exists_f_pow_smul_eq_zero_iff (i : ι) (v : V) :
    (∃ n, f P p i ^ n • v = 0) ↔ ∃ n, sl2F P p i ^ n • v = 0 := by
  have hc0 : sl2FCoeff (K := K) p i ≠ 0 := by
    unfold sl2FCoeff; split_ifs <;> norm_num
  have hd : ∀ n, ((sl2FCoeff (K := K) p i)⁻¹ ^ n) ≠ 0 := fun n ↦ pow_ne_zero _ (inv_ne_zero hc0)
  constructor
  · rintro ⟨n, hn⟩
    refine ⟨n, ?_⟩
    obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le (Nat.le_mul_of_pos_left n (sl2Deg_pos p i))
    have := congr_arg (f P p i ^ c • ·) hn
    simp only [smul_zero, ← mul_smul, ← pow_add] at this
    rw [add_comm, ← hc, f_pow_sl2Deg_mul, smul_assoc] at this
    exact (smul_eq_zero.1 this).resolve_left (hd n)
  · rintro ⟨n, hn⟩
    exact ⟨sl2Deg p i * n, by rw [f_pow_sl2Deg_mul, smul_assoc, hn, smul_zero]⟩

/-- `M̄(Λ)` is generated by `v̄_Λ`. -/
lemma GVerma.span_hwv (Λ : Dual K H) : Submodule.span 𝒰 {GVerma.hwv P p Λ} = ⊤ := by
  refine eq_top_iff.2 fun v _ ↦ ?_
  obtain ⟨t, rfl⟩ := GVerma.exists_eq_fAlg_smul_hwv v
  exact Submodule.smul_mem _ _ (Submodule.subset_span rfl)

variable [FiniteDimensional K H] (S : A.Symmetrization) (hA : A.IsGeneralizedCartan)
  (hp : A.IsSuperAdmissible p)

include S hA hp

lemma exists_adRep_sl2E_pow_mem (i : ι) {g : 𝒰} (hg : g ∈ gTilde P p) :
    ∃ a, ∀ k, a ≤ k → (adRep P p (sl2E P p i) ^ k) g ∈ maxIdeal P p :=
  exists_adRep_pow_mem_maxIdeal (exists_sl2E_pow_smul_mem (maxIdealAd P p)
    (fun _ _ hij ↦ (toAd_mem_maxIdealAd P p).2 (serreE_mem_maxIdeal P p S hA hp hij)) i hg)

lemma exists_adRep_sl2F_pow_mem (i : ι) {g : 𝒰} (hg : g ∈ gTilde P p) :
    ∃ a, ∀ k, a ≤ k → (adRep P p (sl2F P p i) ^ k) g ∈ maxIdeal P p :=
  exists_adRep_pow_mem_maxIdeal (exists_sl2F_pow_smul_mem (maxIdealAd P p)
    (fun _ _ hij ↦ (toAd_mem_maxIdealAd P p).2 (serreF_mem_maxIdeal P p S hA hp hij)) i hg)

/-- A `G(A, τ)`-module generated by vectors killed by powers of `eᵢ` and `fᵢ` is integrable at
`i` ([Kac78] §1.4, cf. [Kac] Lemma 3.4). -/
theorem isIntegrableAt_of_span (hV : IsGModule P p V) (i : ι) {s : Set V}
    (hs : Submodule.span 𝒰 s = ⊤) (hse : ∀ v ∈ s, ∃ n, e P p i ^ n • v = 0)
    (hsf : ∀ v ∈ s, ∃ n, f P p i ^ n • v = 0) : IsIntegrableAt P p V i := by
  let NE := nilSubmodule P p V hV (adRep_sl2E_apply P p i)
    (fun j ↦ exists_adRep_sl2E_pow_mem S hA hp i (e_mem_gTilde P p j))
    (fun j ↦ exists_adRep_sl2E_pow_mem S hA hp i (f_mem_gTilde P p j))
    (fun c ↦ exists_adRep_sl2E_pow_mem S hA hp i (h_mem_gTilde P p c))
  let NF := nilSubmodule P p V hV (adRep_sl2F_apply P p i)
    (fun j ↦ exists_adRep_sl2F_pow_mem S hA hp i (e_mem_gTilde P p j))
    (fun j ↦ exists_adRep_sl2F_pow_mem S hA hp i (f_mem_gTilde P p j))
    (fun c ↦ exists_adRep_sl2F_pow_mem S hA hp i (h_mem_gTilde P p c))
  have hE : NE = ⊤ := eq_top_iff.2 (hs ▸ Submodule.span_le.2 fun v hv ↦
    (exists_e_pow_smul_eq_zero_iff i v).1 (hse v hv))
  have hF : NF = ⊤ := eq_top_iff.2 (hs ▸ Submodule.span_le.2 fun v hv ↦
    (exists_f_pow_smul_eq_zero_iff i v).1 (hsf v hv))
  intro v
  refine ⟨(exists_e_pow_smul_eq_zero_iff i v).2 ?_, (exists_f_pow_smul_eq_zero_iff i v).2 ?_⟩
  · have : v ∈ NE := hE ▸ Submodule.mem_top
    exact this
  · have : v ∈ NF := hF ▸ Submodule.mem_top
    exact this

namespace GVerma

/-- [Kac78] §2: for every `Λ` and `m`, the quotient `M̄(Λ) / U fᵢᵐ v̄_Λ` of the Verma module of
`G(A, τ)` is integrable at `i`. -/
theorem isIntegrableAt_quotient (Λ : Dual K H) (i : ι) (m : ℕ) :
    IsIntegrableAt P p
      (GVerma P p Λ ⧸ Submodule.span 𝒰 {f P p i ^ m • hwv P p Λ}) i := by
  set N := Submodule.span 𝒰 {f P p i ^ m • hwv P p Λ}
  refine isIntegrableAt_of_span S hA hp (s := {N.mkQ (hwv P p Λ)}) ?_ i ?_ ?_ ?_
  · intro x hx v
    obtain ⟨v, rfl⟩ := N.mkQ_surjective v
    rw [← map_smul, isGModule x hx v, map_zero]
  · rw [← Set.image_singleton, ← Submodule.map_span, span_hwv, Submodule.map_top,
      Submodule.range_mkQ]
  · rintro _ rfl
    exact ⟨1, by rw [pow_one, ← map_smul, e_smul_hwv, map_zero]⟩
  · rintro _ rfl
    refine ⟨m, ?_⟩
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.subset_span rfl

end GVerma

end Matrix.Realization.SuperEnveloping

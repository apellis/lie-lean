import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.Lowest
import LieLean.Algebra.Lie.KacMoody.Super.GabberKac.Weights

/-!
# Verma modules of `G(A, τ)`

Let `U = U(G̃(A, τ))`, `R ⊆ G̃(A, τ)` the maximal ideal meeting `𝔥` trivially and
`G(A, τ) = G̃(A, τ) / R`. For `Λ ∈ 𝔥*` let `M(Λ) = U ⊗_{U(𝔟̃)} K_Λ ≅ T(V)` be the Verma module of
`G̃(A, τ)` (`Matrix.Realization.SuperEnveloping.Verma`). This file constructs the Verma module of
`G(A, τ)`, `M̄(Λ) = M(Λ) / U R v_Λ`, without a PBW theorem for `G(A, τ)`. Its key property is the
description of the kernel of `T(V) → M̄(Λ)`, `t ↦ f(t) v̄_Λ`: it is the left ideal `J` of `T(V)`
generated by `f⁻¹(R)` (`GVerma.fAlg_smul_hwv_eq_zero_iff`), independently of `Λ`.

## Proof

Let `N = {f(t) v_Λ | t ∈ J} ⊆ M(Λ)`.
1. A weight vector of `R` of nonzero weight lies in `ñ₋` or `ñ₊`
   (`mem_nMinus_or_mem_nPlus_of_mem_weightSpace`), and `R ∩ 𝔥 = 0`; since `R` is the sum of its
   weight spaces, `R v_Λ ⊆ N` (`Verma.smul_hwv_mem_gSub`).
2. `N` is stable under the `fᵢ` (as `J` is a left ideal), under `𝔥` (as `[h, f(t)] ∈ f(T(V))`
   and `[h, R] ⊆ R`) and under the `eᵢ` (by induction on words, using `[eᵢ, R] ⊆ R` and step 1),
   so it is a `U`-submodule (`Verma.gSubU`).
3. `R` kills `M(Λ) / N`: if `R m ⊆ N` then `R g m ⊆ N` for `g = eᵢ, fᵢ, h`, since
   `x g = ±(g x - [g, x])` for homogeneous `x ∈ R` (`Verma.smul_mem_gSubU`).

So `N = U R v_Λ` and `M̄(Λ) = M(Λ) / N`. The argument is reconstructed.

## Main definitions

* `Matrix.Realization.SuperEnveloping.fPre`: `f⁻¹(R) ⊆ T(V)`.
* `Matrix.Realization.SuperEnveloping.gIdeal`: the left ideal `J` of `T(V)` generated by `f⁻¹(R)`.
* `Matrix.Realization.SuperEnveloping.GVerma`: the Verma module `M̄(Λ)` of `G(A, τ)`.

## Main results

* `Matrix.Realization.SuperEnveloping.GVerma.isGModule`: `R` acts by zero on `M̄(Λ)`.
* `Matrix.Realization.SuperEnveloping.GVerma.fAlg_smul_hwv_eq_zero_iff`: the kernel of
  `t ↦ f(t) v̄_Λ` is `J`.
* `Matrix.Realization.SuperEnveloping.GVerma.isBounded`: `M̄(Λ)` is spanned by weight vectors of
  weights in `Λ - Q₊`.
* `Matrix.Realization.SuperEnveloping.GVerma.lift`: the universal property among modules on which
  `R` acts by zero.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §2.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §9.11.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2)

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

/-! ### Weight vectors of `G̃(A, τ)` -/

lemma nPlusRoot_le_nPlus (k : ι → ℤ) : nPlusRoot P p k ≤ nPlus P p :=
  Submodule.span_le.2 fun _ ⟨i, w, _, hx⟩ ↦ hx ▸ eLie_mem_nPlus P p i w

lemma fAlg_word_mem_weightSpace (w : List ι) :
    fAlg P p (FreeAlgebra.word w) ∈ weightSpace P p (-P.rootOf (wordVec w)) := by
  induction w with
  | nil => rw [FreeAlgebra.word_nil, map_one]; simpa using one_mem_weightSpace P p
  | cons j w ih =>
    rw [FreeAlgebra.word_cons, map_mul, fAlg_ι, wordVec_cons, map_add, rootOf_single, neg_add]
    exact mul_mem_weightSpace P p (f_mem_weightSpace P p j) ih

variable {P p} [CharZero K]

/-- A weight vector of `G̃(A, τ)` of nonzero weight lies in `ñ₋` or in `ñ₊`. -/
theorem mem_nMinus_or_mem_nPlus_of_mem_weightSpace {μ : Dual K H} {x : 𝒰} (hx : x ∈ gTilde P p)
    (hxμ : x ∈ weightSpace P p μ) (hμ : μ ≠ 0) : x ∈ nMinus P p ∨ x ∈ nPlus P p := by
  by_cases hx0 : x = 0
  · exact Or.inl (hx0 ▸ zero_mem _)
  rcases mem_allWeights P p hx hxμ hx0 with (⟨k, hk, rfl⟩ | h0) | ⟨k, hk, rfl⟩
  · left
    have h1 : omega P p (parity P p x) ∈ gTilde P p ⊓ weightSpace P p (P.rootOf k) :=
      ⟨omega_mem_gTilde P p (parity_mem_gTilde P p hx),
        by simpa using omega_mem_weightSpace P p (parity_mem_weightSpace P p hxμ)⟩
    rw [gTilde_inf_weightSpace_rootOf P p hk] at h1
    have h2 := omega_mem_nMinus P p (nPlusRoot_le_nPlus P p k h1)
    rwa [← AlgHom.comp_apply, omega_comp_omega, parity_parity] at h2
  · exact absurd h0 hμ
  · right
    refine nPlusRoot_le_nPlus P p k ?_
    rw [← gTilde_inf_weightSpace_rootOf P p hk]
    exact ⟨hx, hxμ⟩

variable (P p)

/-! ### The left ideal `J` -/

/-- `f⁻¹(R) ⊆ T(V)`, for the map `f : T(V) → U`, `vᵢ ↦ fᵢ`. -/
def fPre : Submodule K (FreeAlgebra K ι) := (maxIdeal P p).comap (fAlg P p).toLinearMap

/-- The left ideal `J` of `T(V)` generated by `f⁻¹(R)`. -/
def gIdeal : Submodule (FreeAlgebra K ι) (FreeAlgebra K ι) :=
  Submodule.span (FreeAlgebra K ι) (fPre P p : Set (FreeAlgebra K ι))

variable {P p}

omit [CharZero K] in
lemma mem_fPre {t : FreeAlgebra K ι} : t ∈ fPre P p ↔ fAlg P p t ∈ maxIdeal P p := Iff.rfl

omit [CharZero K] in
lemma mem_gIdeal_of_mem_fPre {t : FreeAlgebra K ι} (ht : t ∈ fPre P p) : t ∈ gIdeal P p :=
  Submodule.subset_span ht

omit [CharZero K] in
/-- `[h, f(x)] ∈ f(T(V))`. -/
lemma exists_h_mul_fAlg (a : H) (x : FreeAlgebra K ι) :
    ∃ y, h P p a * fAlg P p x = fAlg P p x * h P p a + fAlg P p y := by
  induction x using FreeAlgebra.induction with
  | grade0 c => exact ⟨0, by simp [Algebra.commutes]⟩
  | grade1 i =>
    refine ⟨-(P.root i a) • FreeAlgebra.ι K i, ?_⟩
    rw [fAlg_ι, h_mul_f, map_smul, fAlg_ι, neg_smul, sub_eq_add_neg]
  | mul x y hx hy =>
    obtain ⟨x', hx⟩ := hx
    obtain ⟨y', hy⟩ := hy
    refine ⟨x' * y + x * y', ?_⟩
    simp only [map_mul, map_add]
    rw [← mul_assoc, hx, add_mul, mul_assoc, hy]
    noncomm_ring
  | add x y hx hy =>
    obtain ⟨x', hx⟩ := hx
    obtain ⟨y', hy⟩ := hy
    exact ⟨x' + y', by simp only [map_add, mul_add, add_mul, hx, hy]; abel⟩

lemma exists_h_mul_fAlg_of_mem_fPre (a : H) {r : FreeAlgebra K ι} (hr : r ∈ fPre P p) :
    ∃ y ∈ fPre P p, h P p a * fAlg P p r = fAlg P p r * h P p a + fAlg P p y := by
  obtain ⟨y, hy⟩ := exists_h_mul_fAlg a r
  refine ⟨y, ?_, hy⟩
  have : fAlg P p y = superBracket P p (h P p a) (fAlg P p r) := by
    rw [superBracket_of_even_left P p (isEven_h P p a), hy, add_sub_cancel_left]
  rw [mem_fPre, this]
  exact (isIdeal_maxIdeal P p).superBracket_mem _ (h_mem_gTilde P p a) _ hr

omit [CharZero K] in
/-- If `x m = 0` and `σ(x) m = 0` then `[x, y] m = x y m`. -/
lemma superBracket_smul_of_smul_eq_zero {V : Type*} [AddCommGroup V] [Module K V]
    [Module (P.SuperEnveloping p) V] [IsScalarTower K (P.SuperEnveloping p) V] {x : 𝒰} {m : V}
    (hx : x • m = 0) (hσx : parity P p x • m = 0) (y : 𝒰) :
    superBracket P p x y • m = x • y • m := by
  rw [superBracket, sub_smul, smul_assoc, add_smul, mul_smul (y + _), mul_smul (y - _), hx, hσx]
  simp [mul_smul]

namespace Verma

variable (P p) (Λ : Dual K H)

/-! ### The subspace `N = J v_Λ` -/

/-- `N = {f(t) v_Λ | t ∈ J} ⊆ M(Λ)`. -/
def gSub : Submodule K (Verma P p Λ) :=
  ((gIdeal P p).restrictScalars K).map (toTensorEquiv P p Λ).symm.toLinearMap

variable {P p Λ}

omit [CharZero K] in
lemma mem_gSub_iff {v : Verma P p Λ} :
    v ∈ gSub P p Λ ↔ ∃ t ∈ gIdeal P p, fAlg P p t • hwv P p Λ = v := by
  rw [gSub, Submodule.mem_map]
  simp only [Submodule.restrictScalars_mem, LinearEquiv.coe_coe, toTensorEquiv_symm_apply]

omit [CharZero K] in
lemma fAlg_smul_hwv_mem_gSub_iff {t : FreeAlgebra K ι} :
    fAlg P p t • hwv P p Λ ∈ gSub P p Λ ↔ t ∈ gIdeal P p := by
  refine ⟨fun h ↦ ?_, fun ht ↦ mem_gSub_iff.2 ⟨t, ht, rfl⟩⟩
  obtain ⟨s, hs, hst⟩ := mem_gSub_iff.1 h
  rw [← toTensorEquiv_symm_apply, ← toTensorEquiv_symm_apply] at hst
  rwa [← (toTensorEquiv P p Λ).symm.injective hst]

omit [CharZero K] in
lemma fAlg_smul_mem_gSub (b : FreeAlgebra K ι) {v : Verma P p Λ} (hv : v ∈ gSub P p Λ) :
    fAlg P p b • v ∈ gSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_gSub_iff.1 hv
  rw [smul_smul, ← map_mul, fAlg_smul_hwv_mem_gSub_iff]
  exact (gIdeal P p).smul_mem b ht

omit [CharZero K] in
lemma f_smul_mem_gSub (i : ι) {v : Verma P p Λ} (hv : v ∈ gSub P p Λ) :
    f P p i • v ∈ gSub P p Λ := by
  simpa using fAlg_smul_mem_gSub (FreeAlgebra.ι K i) hv

/-- `R v_Λ ⊆ N`. -/
theorem smul_hwv_mem_gSub {x : 𝒰} (hx : x ∈ maxIdeal P p) : x • hwv P p Λ ∈ gSub P p Λ := by
  have hle := le_iSup_inf_weightSpace P p (maxIdeal P p) (fun a y hy ↦
    (isIdeal_maxIdeal P p).superBracket_mem _ (h_mem_gTilde P p a) y hy) hx
  refine Submodule.iSup_induction _ (motive := fun y ↦ y • hwv P p Λ ∈ gSub P p Λ) hle ?_
    (by simp) (fun y z hy hz ↦ by rw [add_smul]; exact add_mem hy hz)
  rintro μ y ⟨hy, hyμ⟩
  by_cases hμ : μ = 0
  · subst hμ
    have : y ∈ maxIdeal P p ⊓ LinearMap.range (h P p) := by
      refine ⟨hy, ?_⟩
      rw [← gTilde_inf_weightSpace_zero P p]
      exact ⟨(isIdeal_maxIdeal P p).le_gTilde hy, hyμ⟩
    rw [maxIdeal_inf_range_h, Submodule.mem_bot] at this
    simp [this]
  rcases mem_nMinus_or_mem_nPlus_of_mem_weightSpace ((isIdeal_maxIdeal P p).le_gTilde hy) hyμ hμ
    with hn | hn
  · obtain ⟨t, -, rfl⟩ := nMinus_le_fAug P p hn
    exact fAlg_smul_hwv_mem_gSub_iff.2 (mem_gIdeal_of_mem_fPre hy)
  · have := nPlus_le_vermaIdeal P p Λ hn
    rw [Submodule.restrictScalars_mem] at this
    rw [← mk_eq_smul_hwv, (Submodule.Quotient.mk_eq_zero _).2 this]
    exact zero_mem _

/-- `N` is stable under `𝔥`. -/
theorem h_smul_mem_gSub (a : H) {v : Verma P p Λ} (hv : v ∈ gSub P p Λ) :
    h P p a • v ∈ gSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_gSub_iff.1 hv
  clear hv
  induction ht using Submodule.span_induction with
  | mem r hr =>
    obtain ⟨y, hy, hry⟩ := exists_h_mul_fAlg_of_mem_fPre a hr
    rw [smul_smul, hry, add_smul, mul_smul, h_smul_hwv, smul_comm]
    exact add_mem (Submodule.smul_mem _ _ (fAlg_smul_hwv_mem_gSub_iff.2
      (mem_gIdeal_of_mem_fPre hr))) (fAlg_smul_hwv_mem_gSub_iff.2 (mem_gIdeal_of_mem_fPre hy))
  | zero => simp
  | add s t _ _ hs ht => rw [map_add, add_smul, smul_add]; exact add_mem hs ht
  | smul b t ht' ht =>
    obtain ⟨b', hb'⟩ := exists_h_mul_fAlg a b
    rw [smul_eq_mul, map_mul, mul_smul, smul_smul, hb', add_smul]
    refine add_mem ?_ ?_
    · rw [mul_smul]; exact fAlg_smul_mem_gSub b ht
    · rw [smul_smul, ← map_mul]
      exact fAlg_smul_hwv_mem_gSub_iff.2 ((gIdeal P p).smul_mem b' ht')

lemma e_smul_fAlg_smul_mem_gSub (b : FreeAlgebra K ι) {v : Verma P p Λ} (hv : v ∈ gSub P p Λ)
    (he : ∀ j, e P p j • v ∈ gSub P p Λ) (i : ι) : e P p i • fAlg P p b • v ∈ gSub P p Λ := by
  induction b using FreeAlgebra.induction generalizing v i with
  | grade0 c =>
    rw [AlgHom.commutes, algebraMap_smul, smul_comm]
    exact Submodule.smul_mem _ c (he i)
  | grade1 j =>
    rw [fAlg_ι, smul_smul, e_mul_f, add_smul, smul_assoc, mul_smul]
    refine add_mem (Submodule.smul_mem _ _ (f_smul_mem_gSub j (he i))) ?_
    split_ifs
    · exact h_smul_mem_gSub _ hv
    · simp
  | mul b c hb hc =>
    rw [map_mul, mul_smul]
    exact hb (fAlg_smul_mem_gSub c hv) (fun j ↦ hc hv he j) i
  | add b c hb hc =>
    rw [map_add, add_smul, smul_add]
    exact add_mem (hb hv he i) (hc hv he i)

/-- `N` is stable under the `eᵢ`. -/
theorem e_smul_mem_gSub (i : ι) {v : Verma P p Λ} (hv : v ∈ gSub P p Λ) :
    e P p i • v ∈ gSub P p Λ := by
  obtain ⟨t, ht, rfl⟩ := mem_gSub_iff.1 hv
  clear hv
  induction ht using Submodule.span_induction generalizing i with
  | mem r hr =>
    rw [← superBracket_smul_of_smul_eq_zero (e_smul_hwv P p Λ i) (by
      rw [parity_e, smul_assoc, e_smul_hwv, smul_zero])]
    exact smul_hwv_mem_gSub ((isIdeal_maxIdeal P p).superBracket_mem _ (e_mem_gTilde P p i) _ hr)
  | zero => simp
  | add s t _ _ hs ht => rw [map_add, add_smul, smul_add]; exact add_mem (hs i) (ht i)
  | smul b t ht' ht =>
    rw [smul_eq_mul, map_mul, mul_smul]
    exact e_smul_fAlg_smul_mem_gSub b (fAlg_smul_hwv_mem_gSub_iff.2 ht') ht i

variable (P p Λ)

/-- `N` as a `U`-submodule of `M(Λ)`. -/
def gSubU : Submodule 𝒰 (Verma P p Λ) where
  __ := gSub P p Λ
  smul_mem' u v hv := by
    induction u using induction generalizing v with
    | algebraMap c => rw [algebraMap_smul]; exact Submodule.smul_mem _ c hv
    | e i => exact e_smul_mem_gSub i hv
    | f i => exact f_smul_mem_gSub i hv
    | h a => exact h_smul_mem_gSub a hv
    | add x y hx hy => rw [add_smul]; exact (gSub P p Λ).add_mem (hx _ hv) (hy _ hv)
    | mul x y hx hy => rw [mul_smul]; exact hx _ (hy _ hv)

variable {P p Λ}

@[simp] lemma mem_gSubU {v : Verma P p Λ} : v ∈ gSubU P p Λ ↔ v ∈ gSub P p Λ := Iff.rfl

/-- If `R m ⊆ N` then `R (u m) ⊆ N` for all `u ∈ U`. -/
theorem smul_mem_gSubU (u : 𝒰) {m : Verma P p Λ} (hm : ∀ x ∈ maxIdeal P p, x • m ∈ gSubU P p Λ)
    {x : 𝒰} (hx : x ∈ maxIdeal P p) : x • u • m ∈ gSubU P p Λ := by
  induction u using induction generalizing m x with
  | algebraMap c => rw [algebraMap_smul, smul_comm]; exact Submodule.smul_of_tower_mem _ c (hm x hx)
  | add y z hy hz => rw [add_smul, smul_add]; exact add_mem (hy hm hx) (hz hm hx)
  | mul y z hy hz => rw [mul_smul]; exact hy (fun x hx ↦ hz hm hx) hx
  | e i => exact gen_aux (isHomog_e P p i) (e_mem_gTilde P p i) hm hx
  | f i => exact gen_aux (isHomog_f P p i) (f_mem_gTilde P p i) hm hx
  | h a => exact gen_aux (isHomog_h P p a) (h_mem_gTilde P p a) hm hx
where
  gen_aux {d : ZMod 2} {g : 𝒰} (hg : IsHomog P p d g) (hgG : g ∈ gTilde P p) {m : Verma P p Λ}
      (hm : ∀ x ∈ maxIdeal P p, x • m ∈ gSubU P p Λ) {x : 𝒰} (hx : x ∈ maxIdeal P p) :
      x • g • m ∈ gSubU P p Λ := by
    -- split `x` into homogeneous components
    have hhom : ∀ c : ZMod 2, ∀ y ∈ maxIdeal P p, IsHomog P p c y → y • g • m ∈ gSubU P p Λ := by
      intro c y hy hyc
      have hb := superBracket_of_isHomog hg hyc
      have key : y * g = zSign K (d * c) • (g * y - superBracket P p g y) := by
        rw [hb, sub_sub_cancel, smul_smul, mul_comm d c, zSign_mul_self, one_smul]
      rw [smul_smul, key, smul_assoc, sub_smul, mul_smul]
      exact Submodule.smul_of_tower_mem _ _ (sub_mem (Submodule.smul_mem _ g (hm y hy))
        (hm _ ((isIdeal_maxIdeal P p).superBracket_mem _ hgG _ hy)))
    have hx' : x = (2 : K)⁻¹ • (x + parity P p x) + (2 : K)⁻¹ • (x - parity P p x) := by
      rw [← smul_add, add_add_sub_cancel, ← two_smul K x, smul_smul, inv_mul_cancel₀ two_ne_zero,
        one_smul]
    rw [hx', add_smul, smul_assoc, smul_assoc]
    refine add_mem (Submodule.smul_of_tower_mem _ _ (hhom 0 _ (add_mem hx
      (parity_mem_maxIdeal P p hx)) ?_)) (Submodule.smul_of_tower_mem _ _ (hhom 1 _ (sub_mem hx
      (parity_mem_maxIdeal P p hx)) ?_))
    · simp [IsHomog, zSign, add_comm]
    · simp [IsHomog, zSign, neg_sub]

end Verma

variable (P p) (Λ : Dual K H)

/-! ### The Verma module of `G(A, τ)` -/

/-- The Verma module `M̄(Λ) = M(Λ) / U R v_Λ` of `G(A, τ)`. -/
abbrev GVerma : Type _ := Verma P p Λ ⧸ Verma.gSubU P p Λ

namespace GVerma

/-- The highest weight vector `v̄_Λ`. -/
def hwv : GVerma P p Λ := Submodule.Quotient.mk (Verma.hwv P p Λ)

variable {P p Λ}

lemma exists_eq_fAlg_smul_hwv (v : GVerma P p Λ) : ∃ t, fAlg P p t • hwv P p Λ = v := by
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective (Verma.gSubU P p Λ) v
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective (vermaIdeal P p Λ) v
  obtain ⟨t, ht⟩ := exists_sub_fAlg_mem_vermaIdeal P p Λ u
  have : (Submodule.Quotient.mk u : Verma P p Λ) = fAlg P p t • Verma.hwv P p Λ := by
    rw [← Verma.mk_eq_smul_hwv]; exact (Submodule.Quotient.eq _).2 ht
  exact ⟨t, by rw [this, hwv, Submodule.Quotient.mk_smul]⟩

lemma e_smul_hwv (i : ι) : e P p i • hwv P p Λ = 0 := by
  rw [hwv, ← Submodule.Quotient.mk_smul, Verma.e_smul_hwv, Submodule.Quotient.mk_zero]

lemma h_smul_hwv (a : H) : h P p a • hwv P p Λ = Λ a • hwv P p Λ := by
  rw [hwv, ← Submodule.Quotient.mk_smul, Verma.h_smul_hwv, Submodule.Quotient.mk_smul]

/-- `R` acts by zero on `M̄(Λ)`. -/
theorem isGModule : IsGModule P p (GVerma P p Λ) := by
  intro x hx v
  obtain ⟨v, rfl⟩ := Submodule.Quotient.mk_surjective (Verma.gSubU P p Λ) v
  have h1 : x • v ∈ Verma.gSubU P p Λ := by
    obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective (vermaIdeal P p Λ) v
    rw [Verma.mk_eq_smul_hwv]
    exact Verma.smul_mem_gSubU u (fun y hy ↦ Verma.mem_gSubU.2 (Verma.smul_hwv_mem_gSub hy)) hx
  rw [← Submodule.Quotient.mk_smul, (Submodule.Quotient.mk_eq_zero _).2 h1]

/-- The kernel of `T(V) → M̄(Λ)`, `t ↦ f(t) v̄_Λ`, is `J`. -/
theorem fAlg_smul_hwv_eq_zero_iff {t : FreeAlgebra K ι} :
    fAlg P p t • hwv P p Λ = 0 ↔ t ∈ gIdeal P p := by
  rw [hwv, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, Verma.mem_gSubU,
    Verma.fAlg_smul_hwv_mem_gSub_iff]

lemma fAlg_word_smul_hwv_mem (w : List ι) :
    fAlg P p (FreeAlgebra.word w) • hwv P p Λ ∈
      modWeightSpace P p (GVerma P p Λ) (Λ - P.rootOf (wordVec w)) := by
  rw [sub_eq_neg_add]
  exact smul_mem_modWeightSpace _ (fAlg_word_mem_weightSpace P p w) h_smul_hwv

/-- `M̄(Λ)` is spanned by weight vectors of weights in `Λ - Q₊`. -/
theorem isBounded : IsBounded P p (GVerma P p Λ) {Λ} := by
  intro v
  obtain ⟨t, rfl⟩ := exists_eq_fAlg_smul_hwv v
  have ht : t ∈ Submodule.span K (Set.range (FreeAlgebra.basisFreeMonoid K ι)) := by
    rw [Basis.span_eq]; trivial
  induction ht using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, rfl⟩ := hy
    refine Submodule.subset_span ⟨Λ, Finset.mem_singleton_self Λ, wordVec (FreeMonoid.toList w),
      wordVec_nonneg _, ?_⟩
    simpa [FreeAlgebra.word] using fAlg_word_smul_hwv_mem (Λ := Λ) (FreeMonoid.toList w)
  | zero => simp
  | add y z _ _ hy hz => rw [map_add, add_smul]; exact add_mem hy hz
  | smul c y _ hy => rw [map_smul, smul_assoc]; exact Submodule.smul_mem _ c hy

section lift

variable {V : Type*} [AddCommGroup V] [Module (P.SuperEnveloping p) V]
  (hV : IsGModule P p V) (m : V)
  (he : ∀ i, e P p i • m = 0)
  (hh : ∀ a, h P p a • m = algebraMap K (P.SuperEnveloping p) (Λ a) • m)

include hV in
lemma gSubU_le_ker :
    Verma.gSubU P p Λ ≤ LinearMap.ker (Verma.lift P p Λ m he hh) := by
  intro v hv
  obtain ⟨t, ht, rfl⟩ := Verma.mem_gSub_iff.1 (Verma.mem_gSubU.1 hv)
  clear hv
  rw [LinearMap.mem_ker, map_smul, Verma.lift_hwv]
  induction ht using Submodule.span_induction with
  | mem r hr => exact hV _ hr m
  | zero => simp
  | add s t _ _ hs ht => rw [map_add, add_smul, hs, ht, add_zero]
  | smul b t _ ht => rw [smul_eq_mul, map_mul, mul_smul, ht, smul_zero]

/-- The universal property of `M̄(Λ)`: a vector `m` of a module on which `R` acts by zero, killed
by the `eᵢ` and of weight `Λ`, defines a module map `M̄(Λ) → V`, `v̄_Λ ↦ m`. -/
def lift : GVerma P p Λ →ₗ[𝒰] V :=
  (Verma.gSubU P p Λ).liftQ (Verma.lift P p Λ m he hh) (gSubU_le_ker hV m he hh)

@[simp] lemma lift_hwv : lift hV m he hh (hwv P p Λ) = m := by
  simp [lift, hwv]

end lift

end GVerma

end Matrix.Realization.SuperEnveloping

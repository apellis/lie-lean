import LieLean.Algebra.Lie.KacMoody.Super.RootPairing
import LieLean.Algebra.Lie.KacMoody.Casimir

/-!
# The Casimir operator of a contragredient Lie superalgebra

Let `A` be a symmetrizable generalized Cartan matrix with symmetrization `S`, `p : ι → ZMod 2` a
parity, `U = U(G̃(A, τ))` and `R ⊆ G̃(A, τ)` the maximal ideal meeting `𝔥` trivially. Let `V` be a
`U`-module on which `R` acts by zero (`SuperEnveloping.IsGModule`: a module over
`G(A, τ) = G̃(A, τ) / R`) and such that for every `v ∈ V` only finitely many positive root spaces
`G̃_α` act nontrivially on `v` (`SuperEnveloping.IsPosFinite`). Following [Kac78] §2.3, the
*Casimir operator* on `V` is
`Ω = 2 ν⁻¹(ρ) + T_0 + 2 ∑_{α > 0} T_α`, `T_μ = ∑ₖ e_{-μ}^{(k)} e_μ^{(k)}`,
for the dual bases `e_μ^{(k)} ∈ G̃_μ`, `e_{-μ}^{(k)} ∈ G̃_{-μ}` of `SuperEnveloping.rootBasis` and
`SuperEnveloping.rootCobasis` (`(e_μ^{(k)} | e_{-μ}^{(l)}) = δₖₗ` modulo `R`). On a weight vector of
weight `λ`, `2 ν⁻¹(ρ) + T_0` acts by `(λ + 2ρ | λ)`, which is Kac's formula.

## Main definitions

* `Matrix.Realization.SuperEnveloping.IsGModule`: `R` acts by zero on `V`.
* `Matrix.Realization.SuperEnveloping.IsPosFinite`: the finiteness condition.
* `Matrix.Realization.SuperEnveloping.casimirTerm`: `T_μ = ∑ₖ e_{-μ}^{(k)} e_μ^{(k)}`.
* `Matrix.Realization.SuperEnveloping.casimir`: the Casimir operator `Ω`.

## Main results

* `Matrix.Realization.SuperEnveloping.casimir_smul`: `Ω` commutes with the action of `U`
  ([Kac78] Prop. 2.7).
* `Matrix.Realization.SuperEnveloping.casimir_apply_of_e_smul_eq_zero`: on a vector `v` of weight
  `λ` killed by all the `eᵢ`, `Ω v = (λ + 2ρ | λ) v` ([Kac78] §2.4).
* `Matrix.Realization.SuperEnveloping.casimir_eq_smul_of_forall_eq_smul`: `Ω` acts by
  `(λ + 2ρ | λ)` on a module generated by such a vector.

## Proof

For `z ∈ G̃_γ` homogeneous of parity `c` write `R_μ(z) = ∑ₖ e_{-μ}^{(k)} [z, e_μ^{(k)}]` and
`L_μ(z) = ∑ₖ [z, e_{-μ}^{(k)}] e_μ^{(k)}` (acting on `V`). The super Leibniz rule gives
`z T_μ - T_μ z = L_μ(z) + s_μ R_μ(z)` with `s_μ = (-1)^{c |G̃_μ|}`, and the invariance and
supersymmetry of the form give the super analogue of [Kac] Lemma 2.4,
`L_μ(z) = -s_{μ-γ} R_{μ-γ}(z)` (`casimirSum_left`). Hence `z T_μ - T_μ z = F(μ) - F(μ - γ)` with
`F(μ) = s_μ R_μ(z)`, and the sums over `μ > 0` telescope exactly as in the even case
(`KacMoody/Casimir.lean`). Expansions in the dual bases hold modulo `R`, which acts by zero on `V`.
The pairing `(e_μ^{(k)} | e_{-μ}^{(l)}) = δₖₗ`, with the element of `G̃_μ` on the left, is what
makes the signs `s_μ` telescope for odd `z`. Kac only sketches the computation; this form of it is
ours.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §2.3–2.4.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §2.4–2.6.
-/

open Module

noncomputable section

namespace Matrix.Realization.SuperEnveloping

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2)
  (V : Type*) [AddCommGroup V] [Module K V] [Module (P.SuperEnveloping p) V]
  [IsScalarTower K (P.SuperEnveloping p) V]

/-- `R` acts by zero on `V`: `V` is a module over `G(A, τ) = G̃(A, τ) / R`. -/
def IsGModule : Prop := ∀ r ∈ maxIdeal P p, ∀ v : V, r • v = 0

/-- The finiteness condition of [Kac78] §2.3: for every `v ∈ V`, `G̃_α v = 0` for all but
finitely many `α ∈ Q₊ \ {0}`. -/
def IsPosFinite : Prop :=
  ∀ v : V, {μ | μ ∈ P.posWeights ∧ ∃ x ∈ gRoot P p μ, x • v ≠ 0}.Finite

/-- The weight space `V_λ = {v | h v = λ(h) v}`. -/
def modWeightSpace (Λ : Dual K H) : Submodule K V where
  carrier := {v | ∀ a, h P p a • v = Λ a • v}
  add_mem' hv hw a := by rw [smul_add, smul_add, hv a, hw a]
  zero_mem' a := by rw [smul_zero, smul_zero]
  smul_mem' c v hv a := by rw [smul_comm, hv a, smul_comm]

/-- The action of `u ∈ U` on `V`, as a `K`-linear map. -/
def smulEnd (u : P.SuperEnveloping p) : Module.End K V where
  toFun v := u • v
  map_add' := smul_add u
  map_smul' c v := by rw [RingHom.id_apply, smul_comm]

@[simp] lemma smulEnd_apply (u : P.SuperEnveloping p) (v : V) : smulEnd P p V u v = u • v := rfl

variable {P p V}

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

/-! ### The super Leibniz rule on `V` -/

variable [CharZero K]

/-- `z (y w) = [z, y] w + (-1)^{|z||y|} y (z w)`. -/
lemma smul_smul_eq_superBracket {c a : ZMod 2} {z y : P.SuperEnveloping p} (hz : IsHomog P p c z)
    (hy : IsHomog P p a y) (w : V) :
    z • y • w = superBracket P p z y • w + zSign K (c * a) • y • z • w := by
  rw [superBracket_of_isHomog hz hy, sub_smul, smul_assoc, mul_smul, mul_smul, sub_add_cancel]

omit [CharZero K] in
lemma eLie_smul_eq_zero [CharZero K] {v : V} (he : ∀ i, e P p i • v = 0) (i : ι) (w : List ι) :
    eLie P p i w • v = 0 := by
  induction w with
  | nil => exact he i
  | cons j w ih =>
    rw [eLie_cons, superBracket_of_isHomog (isHomog_e P p j) (isHomog_eLie P p i w), sub_smul,
      mul_smul, smul_assoc, mul_smul, ih, he j]
    simp

/-- Positive root spaces kill a vector killed by all the `eᵢ`. -/
lemma smul_eq_zero_of_mem_posWeights {v : V} (he : ∀ i, e P p i • v = 0) {μ : Dual K H}
    (hμ : μ ∈ P.posWeights) {x : P.SuperEnveloping p} (hx : x ∈ gRoot P p μ) : x • v = 0 := by
  obtain ⟨k, hk, rfl⟩ := hμ
  have hx' : x ∈ nPlusRoot P p k := by rw [← gTilde_inf_weightSpace_rootOf P p hk]; exact hx
  clear hx
  induction hx' using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨i, w, -, rfl⟩ := hx
    exact eLie_smul_eq_zero he i w
  | zero => exact zero_smul _ v
  | add x y _ _ hx hy => rw [add_smul, hx, hy, add_zero]
  | smul c x _ hx => rw [smul_assoc, hx, smul_zero]

/-! ### Expansions in the dual bases -/

variable [FiniteDimensional K H] {S : A.Symmetrization}

variable (S) in
/-- The sum `∑ₖ F (e_{-μ}^{(k)}) (e_μ^{(k)})`. -/
def casimirSum (F : P.SuperEnveloping p → P.SuperEnveloping p → V) (μ : Dual K H) : V :=
  ∑ k, F (rootCobasis P p S μ k) (rootBasis P p μ k)

omit [Module K V] [Module (P.SuperEnveloping p) V] [IsScalarTower K (P.SuperEnveloping p) V] in
lemma casimirSum_def (F : P.SuperEnveloping p → P.SuperEnveloping p → V) (μ : Dual K H) :
    casimirSum S F μ = ∑ k, F (rootCobasis P p S μ k) (rootBasis P p μ k) := rfl

omit [Module K V] [Module (P.SuperEnveloping p) V] [IsScalarTower K (P.SuperEnveloping p) V] in
lemma exists_ne_zero_of_casimirSum_ne_zero {F : P.SuperEnveloping p → P.SuperEnveloping p → V}
    {μ : Dual K H} (hF : casimirSum S F μ ≠ 0) :
    ∃ y ∈ gRoot P p (-μ), ∃ x ∈ gRoot P p μ, F y x ≠ 0 := by
  obtain ⟨k, -, hk⟩ := Finset.exists_ne_zero_of_sum_ne_zero hF
  exact ⟨_, (rootCobasis P p S μ k).2, _, (rootBasis P p μ k).2, hk⟩

omit [Module K V] [Module (P.SuperEnveloping p) V] [IsScalarTower K (P.SuperEnveloping p) V] in
lemma casimirSum_eq_zero_of_eq_bot {F : P.SuperEnveloping p → P.SuperEnveloping p → V}
    (hF0 : ∀ y, F y 0 = 0) {μ : Dual K H} (hμ : gRoot P p μ = ⊥) : casimirSum S F μ = 0 := by
  refine Finset.sum_eq_zero fun k _ ↦ ?_
  have h0 : ∀ x ∈ gRoot P p μ, x = 0 := fun x hx ↦ by
    rw [hμ] at hx; exact (Submodule.mem_bot K).1 hx
  rw [h0 _ (rootBasis P p μ k).2, hF0]

variable (S) in
/-- `x w = ∑ₖ (x | e_{-μ}^{(k)}) e_μ^{(k)} w` for `x ∈ G̃_μ`. -/
lemma smul_eq_sum_rootBasis (hV : IsGModule P p V) {μ : Dual K H} {x : P.SuperEnveloping p}
    (hx : x ∈ gRoot P p μ) (w : V) :
    x • w = ∑ k, invForm P p S x (rootCobasis P p S μ k) • (rootBasis P p μ k : 𝒰) • w := by
  have := hV _ (sub_sum_rootBasis_mem_maxIdeal P p S hx) w
  rw [sub_smul, sub_eq_zero, Finset.sum_smul] at this
  simp only [this, smul_assoc]

variable (S) in
/-- `y w = ∑ₖ (e_μ^{(k)} | y) e_{-μ}^{(k)} w` for `y ∈ G̃_{-μ}`. -/
lemma smul_eq_sum_rootCobasis (hV : IsGModule P p V) {μ : Dual K H} {y : P.SuperEnveloping p}
    (hy : y ∈ gRoot P p (-μ)) (w : V) :
    y • w = ∑ k, invForm P p S (rootBasis P p μ k) y • (rootCobasis P p S μ k : 𝒰) • w := by
  have := hV _ (sub_sum_rootCobasis_mem_maxIdeal P p S hy) w
  rw [sub_smul, sub_eq_zero, Finset.sum_smul] at this
  simp only [this, smul_assoc]

omit [FiniteDimensional K H] in
lemma superBracket_mem_gRoot {γ μ : Dual K H} {z x : P.SuperEnveloping p} (hz : z ∈ gTilde P p)
    (hzγ : z ∈ weightSpace P p γ) (hx : x ∈ gRoot P p μ) :
    superBracket P p z x ∈ gRoot P p (γ + μ) :=
  ⟨superBracket_mem_gTilde P p hz hx.1, superBracket_mem_weightSpace hzγ hx.2⟩

/-- The super analogue of [Kac] Lemma 2.4: for `z ∈ G̃_γ` of parity `c`,
`L_μ(z) = -(-1)^{c |G̃_{μ-γ}|} R_{μ-γ}(z)`. -/
theorem casimirSum_left (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hz : z ∈ gTilde P p) (hzγ : z ∈ weightSpace P p γ)
    (hzc : IsHomog P p c z) (μ : Dual K H) (v : V) :
    casimirSum S (fun y x : 𝒰 ↦ superBracket P p z y • x • v) μ =
      -(zSign K (c * weightParity P p (μ - γ)) •
        casimirSum S (fun y x : 𝒰 ↦ y • superBracket P p z x • v) (μ - γ)) := by
  have hL : ∀ k, superBracket P p z (rootCobasis P p S μ k) ∈ gRoot P p (-(μ - γ)) := fun k ↦ by
    have := superBracket_mem_gRoot hz hzγ (rootCobasis P p S μ k).2
    rwa [show γ + -μ = -(μ - γ) by abel] at this
  have hR : ∀ l, superBracket P p z (rootBasis P p (μ - γ) l) ∈ gRoot P p μ := fun l ↦ by
    have := superBracket_mem_gRoot hz hzγ (rootBasis P p (μ - γ) l).2
    rwa [add_sub_cancel] at this
  have hinv : ∀ k l, invForm P p S (rootBasis P p (μ - γ) l)
      (superBracket P p z (rootCobasis P p S μ k)) =
      -(zSign K (c * weightParity P p (μ - γ)) * invForm P p S
        (superBracket P p z (rootBasis P p (μ - γ) l)) (rootCobasis P p S μ k)) := fun k l ↦ by
    have hb := (rootBasis P p (μ - γ) l).2
    rw [← invForm_superBracket P p S hb.1 hz (rootCobasis P p S μ k).2.1,
      superBracket_swap hzc (isHomog_of_mem_gRoot P p hb)]
    rw [LinearMap.map_neg₂, LinearMap.map_smul₂, smul_eq_mul]
  simp only [casimirSum_def]
  simp_rw [smul_eq_sum_rootCobasis S hV (hL _), smul_eq_sum_rootBasis S hV (hR _), Finset.smul_sum,
    smul_comm (rootCobasis P p S (μ - γ) _ : 𝒰) (invForm P p S _ _), hinv]
  rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun l _ ↦ ?_
  rw [← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [neg_smul, mul_smul]

/-- `z T_μ - T_μ z = L_μ(z) + (-1)^{c |G̃_μ|} R_μ(z)`. -/
lemma smul_casimirSum_sub {c : ZMod 2} {z : P.SuperEnveloping p} (hzc : IsHomog P p c z)
    (μ : Dual K H) (v : V) :
    z • casimirSum S (fun y x : 𝒰 ↦ y • x • v) μ - casimirSum S (fun y x : 𝒰 ↦ y • x • z • v) μ =
      casimirSum S (fun y x : 𝒰 ↦ superBracket P p z y • x • v) μ +
        zSign K (c * weightParity P p μ) •
          casimirSum S (fun y x : 𝒰 ↦ y • superBracket P p z x • v) μ := by
  simp only [casimirSum_def, Finset.smul_sum, ← Finset.sum_add_distrib, ← Finset.sum_sub_distrib]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  have hy := isHomog_of_mem_gRoot P p (rootCobasis P p S μ k).2
  have hx := isHomog_of_mem_gRoot P p (rootBasis P p μ k).2
  rw [weightParity_neg] at hy
  rw [smul_smul_eq_superBracket hzc hy, smul_smul_eq_superBracket hzc hx, smul_add, smul_add,
    smul_comm (rootCobasis P p S μ k : 𝒰) (zSign K _)]
  have hs (a : ZMod 2) (x : V) : zSign K a • zSign K a • x = x := by
    rw [smul_smul, zSign_mul_self, one_smul]
  rw [hs]
  abel

variable (S) in
/-- `F(μ) = (-1)^{c |G̃_μ|} R_μ(z)`. -/
def casimirRight (c : ZMod 2) (z : 𝒰) (v : V) (μ : Dual K H) : V :=
  zSign K (c * weightParity P p μ) • casimirSum S (fun y x : 𝒰 ↦ y • superBracket P p z x • v) μ

variable (S) in
/-- `L_μ(z)`. -/
def casimirLeft (z : 𝒰) (v : V) (μ : Dual K H) : V :=
  casimirSum S (fun y x : 𝒰 ↦ superBracket P p z y • x • v) μ

lemma casimirLeft_eq (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hz : z ∈ gTilde P p) (hzγ : z ∈ weightSpace P p γ)
    (hzc : IsHomog P p c z) (μ : Dual K H) (v : V) :
    casimirLeft S z v μ = -casimirRight S c z v (μ - γ) :=
  casimirSum_left hV hz hzγ hzc μ v

/-- For `z ∈ G̃_γ`: `z T_μ - T_μ z = F(μ) - F(μ - γ)`. -/
lemma smul_casimirSum_sub_right (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hz : z ∈ gTilde P p) (hzγ : z ∈ weightSpace P p γ)
    (hzc : IsHomog P p c z) (μ : Dual K H) (v : V) :
    z • casimirSum S (fun y x : 𝒰 ↦ y • x • v) μ - casimirSum S (fun y x : 𝒰 ↦ y • x • z • v) μ =
      casimirRight S c z v μ - casimirRight S c z v (μ - γ) := by
  rw [smul_casimirSum_sub hzc, ← casimirLeft, casimirLeft_eq hV hz hzγ hzc, casimirRight]
  abel

/-- For `z ∈ G̃_γ`: `z T_μ - T_μ z = L_μ(z) - L_{μ+γ}(z)`. -/
lemma smul_casimirSum_sub_left (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hz : z ∈ gTilde P p) (hzγ : z ∈ weightSpace P p γ)
    (hzc : IsHomog P p c z) (μ : Dual K H) (v : V) :
    z • casimirSum S (fun y x : 𝒰 ↦ y • x • v) μ - casimirSum S (fun y x : 𝒰 ↦ y • x • z • v) μ =
      casimirLeft S z v μ - casimirLeft S z v (μ + γ) := by
  rw [smul_casimirSum_sub hzc, ← casimirLeft, casimirLeft_eq hV hz hzγ hzc (μ + γ),
    add_sub_cancel_right]
  simp only [casimirRight]
  abel

/-! ### The `𝔥`-parts -/

/-- `∑ₖ λ(e_0^{(k)}) e_{-0}^{(k)} w = ν⁻¹(λ) w`, viewing `e_0^{(k)} ∈ 𝔥`. -/
lemma sum_hComp_rootBasis_smul (hV : IsGModule P p V) (Λ : Dual K H) (w : V) :
    ∑ k, Λ (hComp P p (rootBasis P p 0 k)) • (rootCobasis P p S 0 k : 𝒰) • w =
      h P p ((P.toDual S).symm Λ) • w := by
  have hh : h P p ((P.toDual S).symm Λ) ∈ gRoot P p (-0) := by
    rw [neg_zero]; exact ⟨h_mem_gTilde P p _, h_mem_weightSpace P p _⟩
  rw [smul_eq_sum_rootCobasis S hV hh]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [invForm_of_mem_zero P p S (rootBasis P p 0 k).2.2, hComp_h, bilinForm_toDual_symm_right]

/-- `∑ₖ λ(e_{-0}^{(k)}) e_0^{(k)} w = ν⁻¹(λ) w`. -/
lemma sum_hComp_rootCobasis_smul (hV : IsGModule P p V) (Λ : Dual K H) (w : V) :
    ∑ k, Λ (hComp P p (rootCobasis P p S 0 k)) • (rootBasis P p 0 k : 𝒰) • w =
      h P p ((P.toDual S).symm Λ) • w := by
  have hh : h P p ((P.toDual S).symm Λ) ∈ gRoot P p 0 :=
    ⟨h_mem_gTilde P p _, h_mem_weightSpace P p _⟩
  rw [smul_eq_sum_rootBasis S hV hh]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [invForm_h_left, bilinForm_toDual_symm_left]

omit [FiniteDimensional K H] in
/-- `[z, x] = -γ(x) z` for `x ∈ G̃_0 = 𝔥` and `z ∈ U_γ`. -/
lemma superBracket_of_mem_gRoot_zero {γ : Dual K H} {c : ZMod 2} {z x : P.SuperEnveloping p}
    (hzγ : z ∈ weightSpace P p γ) (hzc : IsHomog P p c z) (hx : x ∈ gRoot P p 0) :
    superBracket P p z x = -(γ (hComp P p x) • z) := by
  rw [← h_hComp_of_mem_zero P p hx.1 hx.2, superBracket_swap (isHomog_h P p _) hzc,
    superBracket_h_of_mem_weightSpace P p _ hzγ, hComp_h, zero_mul, zSign_zero, one_smul]

/-- `R_0(z) = -ν⁻¹(γ) z`. -/
lemma casimirRight_zero (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hzγ : z ∈ weightSpace P p γ) (hzc : IsHomog P p c z) (v : V) :
    casimirRight S c z v 0 = -(h P p ((P.toDual S).symm γ) • z • v) := by
  rw [← sum_hComp_rootBasis_smul hV, casimirRight, casimirSum_def, ← Finset.sum_neg_distrib,
    Finset.smul_sum]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  have hw : weightParity P p 0 = 0 := by
    rw [← map_zero P.rootOf, weightParity_rootOf, rootParity]; simp
  rw [superBracket_of_mem_gRoot_zero hzγ hzc (rootBasis P p 0 k).2, hw, mul_zero, zSign_zero,
    one_smul, neg_smul, smul_neg, smul_assoc, smul_comm (rootCobasis P p S 0 k : 𝒰) (γ _)]

/-- `L_0(z) = -z ν⁻¹(γ)`. -/
lemma casimirLeft_zero (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hzγ : z ∈ weightSpace P p γ) (hzc : IsHomog P p c z) (v : V) :
    casimirLeft S z v 0 = -(z • h P p ((P.toDual S).symm γ) • v) := by
  rw [← sum_hComp_rootCobasis_smul hV, casimirLeft, casimirSum_def, Finset.smul_sum,
    ← Finset.sum_neg_distrib]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  have hk : (rootCobasis P p S 0 k : 𝒰) ∈ gRoot P p 0 := by
    simpa using (rootCobasis P p S 0 k).2
  rw [superBracket_of_mem_gRoot_zero hzγ hzc hk, neg_smul, smul_assoc, smul_comm z (γ _)]

omit [FiniteDimensional K H] in
lemma smul_h_smul_sub {γ : Dual K H} {c : ZMod 2} {z : P.SuperEnveloping p}
    (hzγ : z ∈ weightSpace P p γ) (hzc : IsHomog P p c z) (a : H) (w : V) :
    z • h P p a • w - h P p a • z • w = -(γ a • z • w) := by
  have hx : h P p a ∈ gRoot P p 0 := ⟨h_mem_gTilde P p _, h_mem_weightSpace P p _⟩
  rw [smul_smul_eq_superBracket hzc (isHomog_h P p a), superBracket_of_mem_gRoot_zero hzγ hzc hx,
    hComp_h, mul_zero, zSign_zero, one_smul, add_sub_cancel_right, neg_smul, smul_assoc]

/-- `R_0(z) - L_0(z) = -⟨γ, ν⁻¹(γ)⟩ z`. -/
lemma casimirRight_zero_sub_casimirLeft_zero (hV : IsGModule P p V) {γ : Dual K H} {c : ZMod 2}
    {z : P.SuperEnveloping p} (hzγ : z ∈ weightSpace P p γ) (hzc : IsHomog P p c z) (v : V) :
    casimirRight S c z v 0 - casimirLeft S z v 0 = -(γ ((P.toDual S).symm γ) • z • v) := by
  rw [casimirRight_zero hV hzγ hzc, casimirLeft_zero hV hzγ hzc, ← smul_h_smul_sub hzγ hzc]
  abel

/-! ### Telescoping sums -/

omit [Fintype ι] [DecidableEq ι] in
private lemma finsum_mem_sub_distrib_of_finite {α M : Type*} [AddCommGroup M] {s : Set α}
    {f g : α → M} (hf : (s ∩ Function.support f).Finite)
    (hg : (s ∩ Function.support g).Finite) :
    ∑ᶠ i ∈ s, (f i - g i) = ∑ᶠ i ∈ s, f i - ∑ᶠ i ∈ s, g i := by
  have hfg : (s ∩ Function.support fun i ↦ f i - g i).Finite :=
    (hf.union hg).subset fun i ⟨his, hi⟩ ↦ by
      rcases Function.support_sub f g hi with h | h
      · exact Or.inl ⟨his, h⟩
      · exact Or.inr ⟨his, h⟩
  rw [eq_sub_iff_add_eq, ← finsum_mem_add_distrib' hfg hg]
  simp only [sub_add_cancel]

omit [FiniteDimensional K H] [CharZero K] in
lemma mem_allWeights_of_gRoot_ne_bot {μ : Dual K H} (hμ : gRoot P p μ ≠ ⊥) :
    μ ∈ AuxLieAlgebra.allWeights P := by
  obtain ⟨x, hx, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hμ
  exact mem_allWeights P p hx.1 hx.2 hx0

omit [FiniteDimensional K H] in
/-- `∑_{μ > 0} F(μ - αᵢ) = F(0) + ∑_{μ > 0} F(μ)` if `F` vanishes where `G̃_μ = 0`. -/
theorem finsum_mem_posWeights_sub_root {M : Type*} [AddCommGroup M] (F : Dual K H → M) (i : ι)
    (hF : ∀ μ, gRoot P p μ = ⊥ → F μ = 0) (hfin : (P.posWeights ∩ Function.support F).Finite) :
    ∑ᶠ μ ∈ P.posWeights, F (μ - P.root i) = F 0 + ∑ᶠ μ ∈ P.posWeights, F μ := by
  have hpt (β : Dual K H) : P.posWeights.indicator (fun μ ↦ F (μ - P.root i)) (β + P.root i) =
      (insert 0 P.posWeights).indicator F β := by
    by_cases hβ : β ∈ insert 0 P.posWeights
    · have : β + P.root i ∈ P.posWeights := by
        rcases hβ with rfl | hβ
        · simpa using P.root_mem_posWeights i
        · exact P.posWeights_add hβ (P.root_mem_posWeights i)
      rw [Set.indicator_of_mem this, Set.indicator_of_mem hβ, add_sub_cancel_right]
    · rw [Set.indicator_of_notMem hβ]
      by_cases h' : β + P.root i ∈ P.posWeights
      · rw [Set.indicator_of_mem h', add_sub_cancel_right]
        refine hF β (by_contra fun hne ↦ ?_)
        rcases mem_allWeights_of_gRoot_ne_bot hne with (hneg | h0) | hpos
        · exact KacMoodyAlgebra.add_root_notMem_posWeights P hneg i h'
        · exact hβ (Or.inl h0)
        · exact hβ (Or.inr hpos)
      · rw [Set.indicator_of_notMem h']
  calc ∑ᶠ μ ∈ P.posWeights, F (μ - P.root i)
      = ∑ᶠ μ, P.posWeights.indicator (fun μ ↦ F (μ - P.root i)) μ := finsum_mem_def _ _
    _ = ∑ᶠ β, P.posWeights.indicator (fun μ ↦ F (μ - P.root i))
          (Equiv.addRight (P.root i) β) := (finsum_comp_equiv _).symm
    _ = ∑ᶠ β, (insert 0 P.posWeights).indicator F β := finsum_congr hpt
    _ = ∑ᶠ β ∈ insert 0 P.posWeights, F β := (finsum_mem_def _ _).symm
    _ = F 0 + ∑ᶠ μ ∈ P.posWeights, F μ := finsum_mem_insert' F P.zero_notMem_posWeights hfin

omit [FiniteDimensional K H] in
lemma finite_posWeights_inter_support_sub_root {M : Type*} [AddCommGroup M] (F : Dual K H → M)
    (i : ι) (hF : ∀ μ, gRoot P p μ = ⊥ → F μ = 0)
    (hfin : (P.posWeights ∩ Function.support F).Finite) :
    (P.posWeights ∩ Function.support fun μ ↦ F (μ - P.root i)).Finite := by
  refine ((hfin.insert 0).preimage (f := fun μ ↦ μ - P.root i)
    (sub_left_injective.injOn)).subset ?_
  rintro μ ⟨hμ, hne⟩
  simp only [Set.mem_preimage, Set.mem_insert_iff]
  by_cases h0 : μ - P.root i = 0
  · exact Or.inl h0
  refine Or.inr ⟨?_, hne⟩
  have hne' : gRoot P p (μ - P.root i) ≠ ⊥ := fun hbot ↦ hne (hF _ hbot)
  rcases mem_allWeights_of_gRoot_ne_bot hne' with (hneg | h0') | hpos
  · exact absurd (by rwa [sub_add_cancel]) (KacMoodyAlgebra.add_root_notMem_posWeights P hneg i)
  · exact absurd h0' h0
  · exact hpos

/-! ### The Casimir operator -/

variable (P p S V) in
/-- The operator `T_μ = ∑ₖ e_{-μ}^{(k)} e_μ^{(k)}` on `V`. -/
def casimirTerm (μ : Dual K H) : Module.End K V :=
  ∑ k, smulEnd P p V (rootCobasis P p S μ k) * smulEnd P p V (rootBasis P p μ k)

lemma casimirTerm_apply (μ : Dual K H) (v : V) :
    casimirTerm P p V S μ v = casimirSum S (fun y x : 𝒰 ↦ y • x • v) μ := by
  simp [casimirTerm, casimirSum_def, LinearMap.sum_apply]

lemma finite_casimirTerm (hV : IsPosFinite P p V) (v : V) :
    (P.posWeights ∩ Function.support fun μ ↦ casimirTerm P p V S μ v).Finite := by
  refine (hV v).subset fun μ ⟨hμ, hne⟩ ↦ ⟨hμ, ?_⟩
  rw [Function.mem_support, casimirTerm_apply] at hne
  obtain ⟨y, -, x, hx, hne⟩ := exists_ne_zero_of_casimirSum_ne_zero hne
  exact ⟨x, hx, fun h0 ↦ hne (by rw [h0, smul_zero])⟩

variable (S) in
/-- The Casimir operator `Ω = 2 ν⁻¹(ρ) + T_0 + 2 ∑_{α > 0} T_α` ([Kac78] §2.3) on a module `V`
satisfying the finiteness condition `IsPosFinite`. -/
def casimir (hV : IsPosFinite P p V) : Module.End K V where
  toFun v := (2 : K) • h P p ((P.toDual S).symm P.rho) • v + casimirTerm P p V S 0 v +
    (2 : K) • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v
  map_add' v w := by
    simp only [map_add, smul_add]
    rw [finsum_mem_add_distrib' (finite_casimirTerm hV v) (finite_casimirTerm hV w)]
    simp only [← smulEnd_apply P p V]
    module
  map_smul' c v := by
    simp only [map_smul, RingHom.id_apply, smul_comm _ c]
    have := (DistribSMul.toAddMonoidHom V c).map_finsum_mem' (finite_casimirTerm (S := S) hV v)
    simp only [DistribSMul.toAddMonoidHom_apply] at this
    rw [← this]
    simp only [← smulEnd_apply P p V]
    module

lemma casimir_apply (hV : IsPosFinite P p V) (v : V) :
    casimir S hV v = (2 : K) • h P p ((P.toDual S).symm P.rho) • v + casimirTerm P p V S 0 v +
      (2 : K) • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v := rfl

/-! ### Commutation with `U` -/

omit [Module K V] [IsScalarTower K 𝒰 V] in
lemma finite_casimirLeft (hV : IsPosFinite P p V) (z : 𝒰) (v : V) :
    (P.posWeights ∩ Function.support fun μ ↦ casimirLeft S z v μ).Finite := by
  refine (hV v).subset fun μ ⟨hμ, hne⟩ ↦ ⟨hμ, ?_⟩
  obtain ⟨y, -, x, hx, hne⟩ := exists_ne_zero_of_casimirSum_ne_zero hne
  exact ⟨x, hx, fun h0 ↦ hne (by rw [h0, smul_zero])⟩

omit [IsScalarTower K 𝒰 V] in
lemma finite_casimirRight (hV : IsPosFinite P p V) {γ : Dual K H} (hγ : γ ∈ P.posWeights)
    {c : ZMod 2} {z : P.SuperEnveloping p} (hz : z ∈ gTilde P p) (hzγ : z ∈ weightSpace P p γ)
    (v : V) : (P.posWeights ∩ Function.support fun μ ↦ casimirRight S c z v μ).Finite := by
  refine ((hV v).preimage (f := fun μ ↦ γ + μ) (add_right_injective γ).injOn).subset
    fun μ ⟨hμ, hne⟩ ↦ ?_
  have hne' : casimirSum S (fun y x : 𝒰 ↦ y • superBracket P p z x • v) μ ≠ 0 :=
    fun h0 ↦ hne (by simp only [casimirRight, h0, smul_zero])
  obtain ⟨y, -, x, hx, hne⟩ := exists_ne_zero_of_casimirSum_ne_zero hne'
  exact ⟨P.posWeights_add hγ hμ, _, superBracket_mem_gRoot hz hzγ hx,
    fun h0 ↦ hne (by rw [h0, smul_zero])⟩

lemma smul_finsum_casimirTerm_sub (hV : IsPosFinite P p V) (z : 𝒰) (v : V) :
    z • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v -
        ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ (z • v) =
      ∑ᶠ μ ∈ P.posWeights, (z • casimirTerm P p V S μ v - casimirTerm P p V S μ (z • v)) := by
  have h1 := (smulEnd P p V z).toAddMonoidHom.map_finsum_mem' (finite_casimirTerm (S := S) hV v)
  simp only [LinearMap.toAddMonoidHom_coe, smulEnd_apply] at h1
  have hf : (P.posWeights ∩ Function.support fun μ ↦ z • casimirTerm P p V S μ v).Finite :=
    (finite_casimirTerm hV v).subset fun μ ⟨hμ, hne⟩ ↦
      ⟨hμ, fun h0 ↦ hne (by simp only at h0 ⊢; rw [h0, smul_zero])⟩
  rw [h1, finsum_mem_sub_distrib_of_finite hf (finite_casimirTerm hV _)]

variable (hV : IsGModule P p V) (hV' : IsPosFinite P p V)
include hV

/-- `Ω` commutes with `eᵢ` ([Kac78] Prop. 2.7). -/
theorem casimir_e_smul (hA : A.IsGeneralizedCartan) (i : ι) (v : V) :
    casimir S hV' (e P p i • v) = e P p i • casimir S hV' v := by
  have hz := nPlus_le_gTilde P p (e_mem_nPlus P p i)
  have hzγ := e_mem_weightSpace P p i
  have hzc := isHomog_e P p i
  have hfin := finite_casimirRight (S := S) hV' (P.root_mem_posWeights i) hz hzγ v (c := p i)
  have hR0 : ∀ μ, gRoot P p μ = ⊥ → casimirRight S (p i) (e P p i) v μ = 0 := fun μ hμ ↦ by
    rw [casimirRight, casimirSum_eq_zero_of_eq_bot (fun y ↦ by simp) hμ, smul_zero]
  have hsum : e P p i • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v -
      ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ (e P p i • v) =
      -casimirRight S (p i) (e P p i) v 0 := by
    rw [smul_finsum_casimirTerm_sub hV',
      finsum_mem_congr rfl fun μ _ ↦ by
        rw [casimirTerm_apply, casimirTerm_apply, smul_casimirSum_sub_right hV hz hzγ hzc μ v],
      finsum_mem_sub_distrib_of_finite hfin
        (finite_posWeights_inter_support_sub_root _ i hR0 hfin),
      finsum_mem_posWeights_sub_root _ i hR0 hfin]
    abel
  have h0 := smul_casimirSum_sub_right (S := S) hV hz hzγ hzc 0 v
  rw [← casimirTerm_apply, ← casimirTerm_apply] at h0
  have hL := casimirLeft_eq (S := S) hV hz hzγ hzc 0 v
  have hRL := casimirRight_zero_sub_casimirLeft_zero (S := S) hV hzγ hzc v
  have hρ := smul_h_smul_sub hzγ hzc ((P.toDual S).symm P.rho) v
  rw [KacMoodyAlgebra.root_toDual_symm_root S hA] at hRL
  simp only [casimir_apply, smul_add, smul_comm (e P p i) (2 : K)]
  simp only [← smulEnd_apply P p V] at h0 hsum hρ hRL ⊢
  linear_combination (norm := module) -(2 : K) • hρ - h0 - (2 : K) • hsum + hL + hRL

/-- `Ω` commutes with `fᵢ` ([Kac78] Prop. 2.7). -/
theorem casimir_f_smul (hA : A.IsGeneralizedCartan) (i : ι) (v : V) :
    casimir S hV' (f P p i • v) = f P p i • casimir S hV' v := by
  have hz := nMinus_le_gTilde P p (f_mem_nMinus P p i)
  have hzγ := f_mem_weightSpace P p i
  have hzc := isHomog_f P p i
  have hfin := finite_casimirLeft (S := S) hV' (f P p i) v
  have hL0 : ∀ μ, gRoot P p μ = ⊥ → casimirLeft S (f P p i) v μ = 0 :=
    fun μ hμ ↦ casimirSum_eq_zero_of_eq_bot (fun y ↦ by simp) hμ
  have hsum : f P p i • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v -
      ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ (f P p i • v) =
      -casimirLeft S (f P p i) v 0 := by
    rw [smul_finsum_casimirTerm_sub hV',
      finsum_mem_congr rfl fun μ _ ↦ by
        rw [casimirTerm_apply, casimirTerm_apply, smul_casimirSum_sub_left hV hz hzγ hzc μ v,
          ← sub_eq_add_neg],
      finsum_mem_sub_distrib_of_finite hfin
        (finite_posWeights_inter_support_sub_root _ i hL0 hfin),
      finsum_mem_posWeights_sub_root _ i hL0 hfin]
    abel
  have h0 := smul_casimirSum_sub_left (S := S) hV hz hzγ hzc 0 v
  rw [← casimirTerm_apply, ← casimirTerm_apply] at h0
  have hR := casimirLeft_eq (S := S) hV hz hzγ hzc (0 + -P.root i) v
  rw [add_sub_cancel_right] at hR
  have hRL := casimirRight_zero_sub_casimirLeft_zero (S := S) hV hzγ hzc v
  have hρ := smul_h_smul_sub hzγ hzc ((P.toDual S).symm P.rho) v
  simp only [map_neg, LinearMap.neg_apply, neg_neg,
    KacMoodyAlgebra.root_toDual_symm_root S hA] at hRL hρ
  simp only [casimir_apply, smul_add, smul_comm (f P p i) (2 : K)]
  simp only [← smulEnd_apply P p V] at h0 hsum hρ hRL ⊢
  linear_combination (norm := module) -(2 : K) • hρ - h0 - (2 : K) • hsum + hR - hRL

/-- `Ω` commutes with `𝔥` ([Kac78] Prop. 2.7). -/
theorem casimir_h_smul (a : H) (v : V) :
    casimir S hV' (h P p a • v) = h P p a • casimir S hV' v := by
  have hz := h_mem_gTilde P p a
  have hzγ := h_mem_weightSpace P p a
  have hzc := isHomog_h P p a
  have hsum : h P p a • ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v -
      ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ (h P p a • v) = 0 := by
    rw [smul_finsum_casimirTerm_sub hV']
    exact finsum_mem_eq_zero_of_forall_eq_zero fun μ _ ↦ by
      rw [casimirTerm_apply, casimirTerm_apply, smul_casimirSum_sub_right hV hz hzγ hzc μ v,
        sub_zero, sub_self]
  have h0 := smul_casimirSum_sub_right (S := S) hV hz hzγ hzc 0 v
  rw [← casimirTerm_apply, ← casimirTerm_apply, sub_zero, sub_self] at h0
  have hρ := smul_h_smul_sub hzγ hzc ((P.toDual S).symm P.rho) v
  rw [LinearMap.zero_apply, zero_smul, neg_zero] at hρ
  simp only [casimir_apply, smul_add, smul_comm (h P p a) (2 : K)]
  simp only [← smulEnd_apply P p V] at h0 hsum hρ ⊢
  linear_combination (norm := module) -(2 : K) • hρ - h0 - (2 : K) • hsum

omit hV [CharZero K] [FiniteDimensional K H] in
/-- Induction over `U = U(G̃(A, τ))` on the generators. -/
lemma induction_on {q : P.SuperEnveloping p → Prop} (u : 𝒰)
    (halg : ∀ c : K, q (algebraMap K _ c)) (he : ∀ i, q (e P p i)) (hf : ∀ i, q (f P p i))
    (hh : ∀ a, q (h P p a)) (hadd : ∀ x y, q x → q y → q (x + y))
    (hmul : ∀ x y, q x → q y → q (x * y)) : q u := by
  obtain ⟨y, rfl⟩ := mk_surjective P p u
  induction y using FreeAlgebra.induction with
  | grade0 c => simpa using halg c
  | grade1 x =>
    rcases x with i | i | a
    · exact he i
    · exact hf i
    · exact hh a
  | mul x y hx hy => rw [map_mul]; exact hmul _ _ hx hy
  | add x y hx hy => rw [map_add]; exact hadd _ _ hx hy

/-- **The Casimir operator commutes with `U(G̃(A, τ))`** ([Kac78] Prop. 2.7): for a
`G(A, τ)`-module `V` satisfying the finiteness condition `IsPosFinite`, `Ω (u v) = u Ω v`. -/
theorem casimir_smul (hA : A.IsGeneralizedCartan) (u : 𝒰) (v : V) :
    casimir S hV' (u • v) = u • casimir S hV' v := by
  revert v
  refine induction_on (q := fun u ↦ ∀ v, casimir S hV' (u • v) = u • casimir S hV' v) u
    (fun c v ↦ ?_) (fun i ↦ casimir_e_smul hV hV' hA i) (fun i ↦ casimir_f_smul hV hV' hA i)
    (fun a ↦ casimir_h_smul hV hV' a) ?_ ?_
  · rw [algebraMap_smul, algebraMap_smul, map_smul]
  · intro x y hx hy v
    rw [add_smul, map_add, hx, hy, add_smul]
  · intro x y hx hy v
    rw [mul_smul, hx, hy, mul_smul]

/-! ### The Casimir operator on highest-weight vectors -/

omit hV in
/-- On a vector `v` of weight `λ` killed by all the `eᵢ`, `Ω v = (λ + 2ρ | λ) v`
([Kac78] §2.4). -/
theorem casimir_apply_of_e_smul_eq_zero (hV : IsGModule P p V) {Λ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V Λ) (he : ∀ i, e P p i • v = 0) :
    casimir S hV' v = P.dualBilinForm S (Λ + 2 • P.rho) Λ • v := by
  have hpos : ∑ᶠ μ ∈ P.posWeights, casimirTerm P p V S μ v = 0 := by
    refine finsum_mem_eq_zero_of_forall_eq_zero fun μ hμ ↦ ?_
    rw [casimirTerm_apply]
    refine Finset.sum_eq_zero fun k _ ↦ ?_
    simp only
    rw [smul_eq_zero_of_mem_posWeights he hμ (rootBasis P p μ k).2, smul_zero]
  have h0 : casimirTerm P p V S 0 v = h P p ((P.toDual S).symm Λ) • v := by
    rw [← sum_hComp_rootBasis_smul hV, casimirTerm_apply, casimirSum_def]
    refine Finset.sum_congr rfl fun k _ ↦ ?_
    have hb := (rootBasis P p 0 k).2
    rw [← h_hComp_of_mem_zero P p hb.1 hb.2, hv, smul_comm, hComp_h]
  have hsymm : P.rho ((P.toDual S).symm Λ) = Λ ((P.toDual S).symm P.rho) := by
    rw [← dualBilinForm_apply_eq, ← dualBilinForm_apply_eq, (P.isSymm_dualBilinForm S).eq]
  rw [casimir_apply, hpos, h0, hv, hv, dualBilinForm_apply_eq, LinearMap.add_apply,
    LinearMap.smul_apply, hsymm]
  module

/-- **[Kac78] §2.4**: the Casimir operator acts by the scalar `(λ + 2ρ | λ)` on a module
generated by a vector `v` of weight `λ` killed by all the `eᵢ`. -/
theorem casimir_eq_smul_of_forall_eq_smul (hA : A.IsGeneralizedCartan) {Λ : Dual K H} {v : V}
    (hv : v ∈ modWeightSpace P p V Λ) (he : ∀ i, e P p i • v = 0)
    (hgen : ∀ w : V, ∃ u : P.SuperEnveloping p, w = u • v) (w : V) :
    casimir S hV' w = P.dualBilinForm S (Λ + 2 • P.rho) Λ • w := by
  obtain ⟨u, rfl⟩ := hgen w
  rw [casimir_smul hV hV' hA, casimir_apply_of_e_smul_eq_zero hV' hV hv he, smul_comm]

end Matrix.Realization.SuperEnveloping

import Mathlib.Algebra.FreeAlgebra
import Mathlib.Algebra.RingQuot
import LieLean.Algebra.Lie.KacMoody.Auxiliary

/-!
# The enveloping algebra of the auxiliary contragredient Lie superalgebra `G̃(A, τ)`

Let `A` be a square integer matrix with a realization `(𝔥, Π, Π^∨)` over a field `K`, and let
`p : ι → ZMod 2` be a parity on the index set (Kac's subset `τ` is `{i | p i = 1}`). The auxiliary
contragredient Lie superalgebra `G̃(A, τ)` ([Kac78] §1.1) is generated by `eᵢ, fᵢ` of parity `p i`
and by the even space `𝔥`, subject to the super analogues of the relations (1.2.1) of [Kac]:
`[eᵢ, fⱼ] = δᵢⱼ αᵢ^∨`, `[h, h'] = 0`, `[h, eᵢ] = ⟨αᵢ, h⟩ eᵢ`, `[h, fᵢ] = -⟨αᵢ, h⟩ fᵢ`, where
`[x, y] = x y - (-1)^{|x||y|} y x` is the super commutator.

Mathlib has no Lie superalgebras. We work with the enveloping algebra of `G̃(A, τ)` directly: the
associative algebra `SuperEnveloping P p` generated by `eᵢ, fᵢ, 𝔥` subject to these relations,
written with super commutators. A representation of `G̃(A, τ)` is the same as a module over it.

## Main definitions

* `Matrix.IsSuperAdmissible A p`: the condition of [Kac78] (1.1) that `aᵢⱼ` is even whenever
  `p i = 1`.
* `Matrix.Realization.superSign p i j`: the sign `(-1)^{p i p j}`.
* `Matrix.Realization.SuperEnveloping P p`: the enveloping algebra of `G̃(A, τ)`.
* `Matrix.Realization.SuperEnveloping.e`, `.f`, `.h`: the generators.
* `Matrix.Realization.SuperEnveloping.lift`: the universal property.

## Main results

* `Matrix.Realization.SuperEnveloping.h_mul_h`, `e_mul_f`, `h_mul_e`, `h_mul_f`: the defining
  relations.
* `Matrix.Realization.SuperEnveloping.hom_ext`: algebra morphisms out of `SuperEnveloping P p`
  are determined by their values on the generators.

## Implementation notes

[Kac78] takes for `𝔥` the span of the `hᵢ` and includes the Serre relations
`(ad eᵢ)^{1-aᵢⱼ} eⱼ = (ad fᵢ)^{1-aᵢⱼ} fⱼ = 0` (`i ≠ j`) among the defining relations (1.2) of
`G̃(A, τ)`. As in [Kac] §1.2–1.3 we use a realization of `A` and omit the Serre relations; the
contragredient Lie superalgebra `G(A, τ)` is the quotient by the maximal graded ideal meeting `𝔥`
trivially, which contains the Serre elements, so it is the same in both conventions.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.1.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §1.2.
-/

noncomputable section

/-- The condition of [Kac78] (1.1) on a parity `p`: `aᵢⱼ` is even whenever `eᵢ` is odd. -/
def Matrix.IsSuperAdmissible {ι : Type*} (A : Matrix ι ι ℤ) (p : ι → ZMod 2) : Prop :=
  ∀ i j, p i = 1 → Even (A i j)

namespace Matrix.Realization

section superSign

variable {ι : Type*} (K : Type*) [Field K] (p : ι → ZMod 2)

/-- The sign `(-1)^{p i p j}` of the super commutator of two generators of parities `p i`,
`p j`. -/
def superSign (i j : ι) : K := if p i = 1 ∧ p j = 1 then -1 else 1

lemma superSign_comm (i j : ι) : superSign K p i j = superSign K p j i := by
  simp [superSign, and_comm]

lemma superSign_mul_self (i j : ι) : superSign K p i j * superSign K p i j = 1 := by
  unfold superSign; split_ifs <;> norm_num

lemma superSign_self (i : ι) : superSign K p i i = if p i = 1 then -1 else 1 := by
  simp [superSign]

end superSign

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2)

namespace SuperEnveloping

variable (K H) in
/-- The generator `eᵢ` of the free algebra. -/
abbrev genE (i : ι) : FreeAlgebra K (AuxGen ι H) := FreeAlgebra.ι K (.e i)

variable (K H) in
/-- The generator `fᵢ` of the free algebra. -/
abbrev genF (i : ι) : FreeAlgebra K (AuxGen ι H) := FreeAlgebra.ι K (.f i)

variable (K ι) in
/-- The generator `h` of the free algebra. -/
abbrev genH (a : H) : FreeAlgebra K (AuxGen ι H) := FreeAlgebra.ι K (.h a)

/-- The defining relations of the enveloping algebra of `G̃(A, τ)`, including the relations
making `h ↦ h` linear. -/
inductive Rel : FreeAlgebra K (AuxGen ι H) → FreeAlgebra K (AuxGen ι H) → Prop
  | h_add (a b : H) : Rel (genH ι K (a + b)) (genH ι K a + genH ι K b)
  | h_smul (c : K) (a : H) : Rel (genH ι K (c • a)) (c • genH ι K a)
  | h_h (a b : H) : Rel (genH ι K a * genH ι K b) (genH ι K b * genH ι K a)
  | e_f (i j : ι) : Rel (genE K H i * genF K H j)
      (superSign K p i j • (genF K H j * genE K H i) +
        if i = j then genH ι K (P.coroot i) else 0)
  | h_e (a : H) (i : ι) : Rel (genH ι K a * genE K H i)
      (genE K H i * genH ι K a + P.root i a • genE K H i)
  | h_f (a : H) (i : ι) : Rel (genH ι K a * genF K H i)
      (genF K H i * genH ι K a - P.root i a • genF K H i)

end SuperEnveloping

/-- The enveloping algebra of the auxiliary contragredient Lie superalgebra `G̃(A, τ)` of
[Kac78] §1.1 (without the Serre relations, see the module docstring): the associative algebra
generated by `eᵢ, fᵢ` (`i ∈ ι`) and `𝔥`, with `eᵢ, fᵢ` of parity `p i` and `𝔥` even, subject to
`[eᵢ, fⱼ] = δᵢⱼ αᵢ^∨`, `[h, h'] = 0`, `[h, eᵢ] = ⟨αᵢ, h⟩ eᵢ`, `[h, fᵢ] = -⟨αᵢ, h⟩ fᵢ` for the super
commutator. -/
abbrev SuperEnveloping : Type _ := RingQuot (SuperEnveloping.Rel P p)

namespace SuperEnveloping

/-- The quotient map from the free algebra. -/
def mk : FreeAlgebra K (AuxGen ι H) →ₐ[K] P.SuperEnveloping p := RingQuot.mkAlgHom K (Rel P p)

lemma mk_surjective : Function.Surjective (mk P p) := RingQuot.mkAlgHom_surjective K _

/-- The generator `eᵢ`. -/
def e (i : ι) : P.SuperEnveloping p := mk P p (genE K H i)

/-- The generator `fᵢ`. -/
def f (i : ι) : P.SuperEnveloping p := mk P p (genF K H i)

/-- The linear map `𝔥 → U(G̃(A, τ))`. -/
def h : H →ₗ[K] P.SuperEnveloping p where
  toFun a := mk P p (genH ι K a)
  map_add' a b := by
    rw [mk, RingQuot.mkAlgHom_rel K (Rel.h_add a b), map_add]
  map_smul' c a := by
    rw [mk, RingQuot.mkAlgHom_rel K (Rel.h_smul c a), map_smul, RingHom.id_apply]

lemma h_mul_h (a b : H) : h P p a * h P p b = h P p b * h P p a := by
  simp only [h, LinearMap.coe_mk, AddHom.coe_mk, ← map_mul]
  exact RingQuot.mkAlgHom_rel K (Rel.h_h a b)

lemma e_mul_f (i j : ι) : e P p i * f P p j =
    superSign K p i j • (f P p j * e P p i) + if i = j then h P p (P.coroot i) else 0 := by
  have := RingQuot.mkAlgHom_rel K (Rel.e_f (P := P) (p := p) i j)
  simp only [map_mul, map_add, map_smul] at this
  rw [e, f, mk, this]
  split_ifs <;> simp [h, mk]

/-- The super commutator relation `[eᵢ, fⱼ] = δᵢⱼ αᵢ^∨`. -/
lemma e_mul_f_sub (i j : ι) : e P p i * f P p j - superSign K p i j • (f P p j * e P p i) =
    if i = j then h P p (P.coroot i) else 0 := by
  rw [e_mul_f, add_sub_cancel_left]

lemma e_mul_f_of_ne {i j : ι} (hij : i ≠ j) :
    e P p i * f P p j = superSign K p i j • (f P p j * e P p i) := by
  simp [e_mul_f, hij]

lemma h_mul_e (a : H) (i : ι) : h P p a * e P p i = e P p i * h P p a + P.root i a • e P p i := by
  have := RingQuot.mkAlgHom_rel K (Rel.h_e (P := P) (p := p) a i)
  simp only [map_mul, map_add, map_smul] at this
  exact this

lemma h_mul_f (a : H) (i : ι) : h P p a * f P p i = f P p i * h P p a - P.root i a • f P p i := by
  have := RingQuot.mkAlgHom_rel K (Rel.h_f (P := P) (p := p) a i)
  simp only [map_mul, map_sub, map_smul] at this
  exact this

section lift

variable {B : Type*} [Ring B] [Algebra K B]

/-- Data of an algebra morphism out of `U(G̃(A, τ))`: images of `𝔥`, of the `eᵢ` and of the `fᵢ`
satisfying the defining relations. -/
structure LiftData (B : Type*) [Ring B] [Algebra K B] where
  /-- The image of `𝔥`. -/
  h : H →ₗ[K] B
  /-- The images of the `eᵢ`. -/
  e : ι → B
  /-- The images of the `fᵢ`. -/
  f : ι → B
  h_mul_h : ∀ a b, h a * h b = h b * h a
  e_mul_f : ∀ i j, e i * f j = superSign K p i j • (f j * e i) +
    if i = j then h (P.coroot i) else 0
  h_mul_e : ∀ a i, h a * e i = e i * h a + P.root i a • e i
  h_mul_f : ∀ a i, h a * f i = f i * h a - P.root i a • f i

variable {P p}

/-- The map on generators. -/
def LiftData.gen (D : LiftData P p B) : AuxGen ι H → B
  | .e i => D.e i
  | .f i => D.f i
  | .h a => D.h a

lemma LiftData.rel (D : LiftData P p B) {x y : FreeAlgebra K (AuxGen ι H)} (hxy : Rel P p x y) :
    FreeAlgebra.lift K D.gen x = FreeAlgebra.lift K D.gen y := by
  cases hxy with
  | h_add a b => simp [LiftData.gen]
  | h_smul c a => simp [LiftData.gen]
  | h_h a b => simpa [LiftData.gen] using D.h_mul_h a b
  | e_f i j =>
    simp only [map_mul, map_add, map_smul, FreeAlgebra.lift_ι_apply, LiftData.gen, D.e_mul_f]
    split_ifs <;> simp [LiftData.gen]
  | h_e a i => simpa [LiftData.gen] using D.h_mul_e a i
  | h_f a i => simpa [LiftData.gen] using D.h_mul_f a i

/-- The universal property of `U(G̃(A, τ))`. -/
def lift (D : LiftData P p B) : P.SuperEnveloping p →ₐ[K] B :=
  RingQuot.liftAlgHom K ⟨FreeAlgebra.lift K D.gen, fun _ _ hxy ↦ D.rel hxy⟩

@[simp] lemma lift_mk (D : LiftData P p B) (x : FreeAlgebra K (AuxGen ι H)) :
    lift D (mk P p x) = FreeAlgebra.lift K D.gen x :=
  RingQuot.liftAlgHom_mkAlgHom_apply _ _ _ _

@[simp] lemma lift_e (D : LiftData P p B) (i : ι) : lift D (e P p i) = D.e i := by
  simp [e, LiftData.gen]

@[simp] lemma lift_f (D : LiftData P p B) (i : ι) : lift D (f P p i) = D.f i := by
  simp [f, LiftData.gen]

@[simp] lemma lift_h (D : LiftData P p B) (a : H) : lift D (h P p a) = D.h a := by
  simp [h, LiftData.gen]

/-- Algebra morphisms out of `U(G̃(A, τ))` are determined by their values on the generators. -/
@[ext]
lemma hom_ext {g₁ g₂ : P.SuperEnveloping p →ₐ[K] B} (he : ∀ i, g₁ (e P p i) = g₂ (e P p i))
    (hf : ∀ i, g₁ (f P p i) = g₂ (f P p i)) (hh : ∀ a, g₁ (h P p a) = g₂ (h P p a)) :
    g₁ = g₂ := by
  refine RingQuot.ringQuot_ext' K _ _ (FreeAlgebra.hom_ext (funext fun x ↦ ?_))
  rcases x with i | i | a
  · exact he i
  · exact hf i
  · exact hh a

end lift

end SuperEnveloping

end Matrix.Realization

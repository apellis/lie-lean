import LieLean.Algebra.Lie.KacMoody.Super.Serre
import LieLean.Algebra.Lie.KacMoody.Super.Integrable

/-!
# The adjoint representation of `U(G̃(A, τ))`

Let `U = U(G̃(A, τ))`. The super commutators `ad x = [x, -]` with the generators `eᵢ`, `fᵢ`,
`h ∈ 𝔥` of `G̃(A, τ)` satisfy the defining relations of `U` (by the super Jacobi identity), so
they define an algebra homomorphism `adRep : U → End_K(U)`, the adjoint representation. For
`x ∈ G̃(A, τ)` it is the super commutator: `adRep x = [x, -]`.

We regard `U` as a `U`-module `Ad` through `adRep`; `G̃(A, τ)` and `R` are submodules. For a
submodule `N` of `Ad` containing the Serre elements `(ad eᵢ)^{1 - aᵢⱼ} eⱼ`, `(ad fᵢ)^{1 - aᵢⱼ} fⱼ`
(`i ≠ j`), the quotient `G̃(A, τ) / N` is an integrable module ([Kac78] §1.4, proof of Prop. 1.4:
the Serre-presented algebra is integrable). The proof is the usual one: if `Eᵢ` is the even
element `eᵢ` (`eᵢ` even) or `eᵢ² / 2` (`eᵢ` odd) then `ad Eᵢ` is a derivation of the super
commutator, it acts nilpotently on the generators modulo `N`, and the Leibniz rule propagates
local nilpotency to all of `G̃(A, τ)`.

## Main definitions

* `Matrix.Realization.SuperEnveloping.adRep`: the adjoint representation.
* `Matrix.Realization.SuperEnveloping.Ad`: `U` as a module over itself through `adRep`.
* `Matrix.Realization.SuperEnveloping.gTildeAd`, `maxIdealAd`, `serreAd`: the submodules
  `G̃(A, τ)`, `R` and the submodule generated by the Serre elements.

## Main results

* `Matrix.Realization.SuperEnveloping.adRep_of_mem_gTilde`: `adRep x = [x, -]` on `G̃(A, τ)`.
* `Matrix.Realization.SuperEnveloping.isIntegrable_quotient`: `G̃(A, τ) / N` is integrable.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §1.2–1.4.
* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §3.3–3.5.
-/

open Module

noncomputable section

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2) [CharZero K]

namespace SuperEnveloping

/-- The enveloping superalgebra `U(G̃(A, τ))`. -/
local notation "𝒰" => SuperEnveloping P p

/-! ### The super Jacobi identity for arbitrary third argument -/

variable {P p} in
/-- `[x, [y, z]] = [[x, y], z] + (-1)^{|x||y|} [y, [x, z]]` for homogeneous `x`, `y` and arbitrary
`z`. -/
theorem superBracket_jacobi_left {a b : ZMod 2} {x y : 𝒰} (hx : IsHomog P p a x)
    (hy : IsHomog P p b y) (z : 𝒰) :
    superBracket P p x (superBracket P p y z) =
      superBracket P p (superBracket P p x y) z +
        zSign K (a * b) • superBracket P p y (superBracket P p x z) := by
  refine induction_parity P p (N := ⊤) (fun _ _ ↦ Submodule.mem_top)
    (q := fun z ↦ superBracket P p x (superBracket P p y z) =
      superBracket P p (superBracket P p x y) z +
        zSign K (a * b) • superBracket P p y (superBracket P p x z))
    (fun c z _ hz ↦ superBracket_jacobi hx hy hz) (fun z₁ z₂ h₁ h₂ ↦ ?_) Submodule.mem_top
  simp only [superBracket_add_right, h₁, h₂, smul_add]
  abel

/-! ### The adjoint representation -/

/-- The super commutator `[x, -]` as a function of `x`. -/
def adLin : 𝒰 →ₗ[K] Module.End K 𝒰 where
  toFun := superBracketRight P p
  map_add' x y := by ext z; simp [superBracket_add_left]
  map_smul' c x := by ext z; simp [superBracket_smul_left]

omit [CharZero K] in
@[simp] lemma adLin_apply (x z : 𝒰) : adLin P p x z = superBracket P p x z := rfl

/-- The super commutators with the generators satisfy the defining relations of `U`. -/
def adData : LiftData P p (Module.End K 𝒰) where
  h := (adLin P p).comp (h P p)
  e i := adLin P p (e P p i)
  f i := adLin P p (f P p i)
  h_mul_h a b := by
    ext z
    simp only [LinearMap.comp_apply, Module.End.mul_apply, adLin_apply]
    rw [superBracket_jacobi_left (isHomog_h P p a) (isHomog_h P p b),
      superBracket_of_even_left P p (isEven_h P p a), h_mul_h, sub_self, superBracket_zero_left,
      zero_add, mul_zero, zSign_zero, one_smul]
  e_mul_f i j := by
    ext z
    simp only [LinearMap.comp_apply, Module.End.mul_apply, adLin_apply, LinearMap.add_apply,
      LinearMap.smul_apply]
    rw [superBracket_jacobi_left (isHomog_e P p i) (isHomog_f P p j), superBracket_e_f,
      ← superSign_eq_zSign, add_comm]
    split_ifs <;> simp [superBracket_zero_left]
  h_mul_e a i := by
    ext z
    simp only [LinearMap.comp_apply, Module.End.mul_apply, adLin_apply, LinearMap.add_apply,
      LinearMap.smul_apply]
    rw [superBracket_jacobi_left (isHomog_h P p a) (isHomog_e P p i),
      superBracket_h_of_mem_weightSpace P p a (e_mem_weightSpace P p i), superBracket_smul_left,
      zero_mul, zSign_zero, one_smul, add_comm]
  h_mul_f a i := by
    ext z
    simp only [LinearMap.comp_apply, Module.End.mul_apply, adLin_apply, LinearMap.sub_apply,
      LinearMap.smul_apply]
    rw [superBracket_jacobi_left (isHomog_h P p a) (isHomog_f P p i),
      superBracket_h_of_mem_weightSpace P p a (f_mem_weightSpace P p i), superBracket_smul_left,
      zero_mul, zSign_zero, one_smul, LinearMap.neg_apply, neg_smul]
    abel

/-- The adjoint representation `U → End_K(U)`, `x ↦ [x, -]` on `G̃(A, τ)`. -/
def adRep : 𝒰 →ₐ[K] Module.End K 𝒰 := lift (adData P p)

@[simp] lemma adRep_e (i : ι) (z : 𝒰) : adRep P p (e P p i) z = superBracket P p (e P p i) z := by
  simp [adRep, adData]

@[simp] lemma adRep_f (i : ι) (z : 𝒰) : adRep P p (f P p i) z = superBracket P p (f P p i) z := by
  simp [adRep, adData]

@[simp] lemma adRep_h (a : H) (z : 𝒰) : adRep P p (h P p a) z = superBracket P p (h P p a) z := by
  simp [adRep, adData]

/-- The elements `y` with `adRep y = [y, -]`. -/
def adAgree : Submodule K 𝒰 where
  carrier := {y | adRep P p y = adLin P p y}
  add_mem' hy hy' := by simp only [Set.mem_ofPred_eq, map_add] at *; rw [hy, hy']
  zero_mem' := by simp
  smul_mem' c y hy := by simp only [Set.mem_ofPred_eq, map_smul] at *; rw [hy]

variable {P p} in
lemma superBracket_mem_adAgree {a b : ZMod 2} {g y : 𝒰} (hg : IsHomog P p a g)
    (hy : IsHomog P p b y) (hg' : g ∈ adAgree P p) (hy' : y ∈ adAgree P p) :
    superBracket P p g y ∈ adAgree P p := by
  change adRep P p _ = adLin P p _
  ext z
  rw [superBracket_of_isHomog hg hy, map_sub, map_smul, map_mul, map_mul, hg', hy']
  simp only [LinearMap.sub_apply, LinearMap.smul_apply, Module.End.mul_apply, adLin_apply]
  rw [← superBracket_of_isHomog hg hy, superBracket_jacobi_left hg hy]
  abel

lemma e_mem_adAgree (i : ι) : e P p i ∈ adAgree P p := by
  change adRep P p _ = adLin P p _; ext z; simp

lemma f_mem_adAgree (i : ι) : f P p i ∈ adAgree P p := by
  change adRep P p _ = adLin P p _; ext z; simp

lemma h_mem_adAgree (a : H) : h P p a ∈ adAgree P p := by
  change adRep P p _ = adLin P p _; ext z; simp

lemma nPlus_le_adAgree : nPlus P p ≤ adAgree P p := by
  refine (nPlus_le_iff P p).2 fun i w ↦ ?_
  induction w with
  | nil => simpa using e_mem_adAgree P p i
  | cons j w ih =>
    rw [eLie_cons]
    exact superBracket_mem_adAgree (isHomog_e P p j) (isHomog_eLie P p i w)
      (e_mem_adAgree P p j) ih

lemma nMinus_le_adAgree : nMinus P p ≤ adAgree P p := by
  refine Submodule.map_le_iff_le_comap.2 ((nPlus_le_iff P p).2 fun i w ↦ ?_)
  simp only [Submodule.mem_comap, AlgHom.toLinearMap_apply]
  induction w with
  | nil => simpa using f_mem_adAgree P p i
  | cons j w ih =>
    rw [omega_eLie_cons]
    exact superBracket_mem_adAgree (isHomog_f P p j) (isHomog_eLie P p i w).omega
      (f_mem_adAgree P p j) ih

lemma gTilde_le_adAgree : gTilde P p ≤ adAgree P p :=
  sup_le (sup_le (nMinus_le_adAgree P p) (by
    rintro _ ⟨a, rfl⟩; exact h_mem_adAgree P p a)) (nPlus_le_adAgree P p)

variable {P p} in
/-- On `G̃(A, τ)` the adjoint representation is the super commutator. -/
theorem adRep_of_mem_gTilde {x : 𝒰} (hx : x ∈ gTilde P p) (z : 𝒰) :
    adRep P p x z = superBracket P p x z := by
  rw [show adRep P p x = adLin P p x from gTilde_le_adAgree P p hx, adLin_apply]

/-! ### Stability of subspaces under the adjoint representation -/

variable {P p} in
/-- A subspace stable under the super commutators with the generators is stable under
`adRep`. -/
lemma adRep_mem_of_forall {N : Submodule K 𝒰}
    (he : ∀ i, ∀ z ∈ N, superBracket P p (e P p i) z ∈ N)
    (hf : ∀ i, ∀ z ∈ N, superBracket P p (f P p i) z ∈ N)
    (hh : ∀ a, ∀ z ∈ N, superBracket P p (h P p a) z ∈ N) (u : 𝒰) {z : 𝒰} (hz : z ∈ N) :
    adRep P p u z ∈ N := by
  refine induction_on (q := fun u ↦ ∀ z ∈ N, adRep P p u z ∈ N) u ?_ ?_ ?_ ?_ ?_ ?_ z hz
  · intro c z hz
    rw [AlgHom.commutes, Module.algebraMap_end_apply]
    exact N.smul_mem c hz
  · intro i z hz; rw [adRep_e]; exact he i z hz
  · intro i z hz; rw [adRep_f]; exact hf i z hz
  · intro a z hz; rw [adRep_h]; exact hh a z hz
  · intro x y hx hy z hz; rw [map_add, LinearMap.add_apply]; exact add_mem (hx z hz) (hy z hz)
  · intro x y hx hy z hz; rw [map_mul, Module.End.mul_apply]; exact hx _ (hy z hz)

variable {P p} in
lemma adRep_mem_gTilde (u : 𝒰) {z : 𝒰} (hz : z ∈ gTilde P p) : adRep P p u z ∈ gTilde P p :=
  adRep_mem_of_forall (fun i _ ↦ superBracket_e_mem_gTilde P p i)
    (fun i _ ↦ superBracket_f_mem_gTilde P p i) (fun a _ ↦ superBracket_h_mem_gTilde P p a) u hz

omit [CharZero K] in
lemma e_mem_gTilde (i : ι) : e P p i ∈ gTilde P p := nPlus_le_gTilde P p (e_mem_nPlus P p i)

omit [CharZero K] in
lemma f_mem_gTilde (i : ι) : f P p i ∈ gTilde P p := nMinus_le_gTilde P p (f_mem_nMinus P p i)

variable {P p} in
lemma adRep_mem_maxIdeal (u : 𝒰) {z : 𝒰} (hz : z ∈ maxIdeal P p) :
    adRep P p u z ∈ maxIdeal P p :=
  adRep_mem_of_forall
    (fun i _ hz ↦ (isIdeal_maxIdeal P p).superBracket_mem _ (e_mem_gTilde P p i) _ hz)
    (fun i _ hz ↦ (isIdeal_maxIdeal P p).superBracket_mem _ (f_mem_gTilde P p i) _ hz)
    (fun a _ hz ↦ (isIdeal_maxIdeal P p).superBracket_mem _ (h_mem_gTilde P p a) _ hz) u hz

/-! ### The adjoint module -/

/-- `U` regarded as a module over itself through the adjoint representation. -/
def Ad : Type _ := 𝒰

instance : AddCommGroup (Ad P p) := inferInstanceAs (AddCommGroup 𝒰)

instance : Module K (Ad P p) := inferInstanceAs (Module K 𝒰)

/-- The identity map `U → Ad`. -/
def toAd : 𝒰 ≃ₗ[K] Ad P p := LinearEquiv.refl K 𝒰

instance : Module 𝒰 (Ad P p) :=
  letI : Module (Module.End K 𝒰) (Ad P p) := Module.End.applyModule
  Module.compHom (Ad P p) (adRep P p : 𝒰 →+* Module.End K 𝒰)

lemma smul_toAd (u z : 𝒰) : u • toAd P p z = toAd P p (adRep P p u z) := rfl

instance : IsScalarTower K 𝒰 (Ad P p) where
  smul_assoc c u z := by
    obtain ⟨z, rfl⟩ := (toAd P p).surjective z
    rw [smul_toAd, smul_toAd, map_smul, LinearMap.smul_apply, map_smul]

/-- `G̃(A, τ)` as a submodule of the adjoint module. -/
def gTildeAd : Submodule 𝒰 (Ad P p) where
  carrier := toAd P p '' gTilde P p
  add_mem' := by
    rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩; exact ⟨x + y, add_mem hx hy, map_add _ _ _⟩
  zero_mem' := ⟨0, zero_mem _, map_zero _⟩
  smul_mem' u := by
    rintro _ ⟨z, hz, rfl⟩; exact ⟨_, adRep_mem_gTilde u hz, (smul_toAd P p u z).symm⟩

lemma toAd_mem_gTildeAd {z : 𝒰} : toAd P p z ∈ gTildeAd P p ↔ z ∈ gTilde P p :=
  (toAd P p).injective.mem_set_image

/-- `R` as a submodule of the adjoint module. -/
def maxIdealAd : Submodule 𝒰 (Ad P p) where
  carrier := toAd P p '' maxIdeal P p
  add_mem' := by
    rintro _ _ ⟨x, hx, rfl⟩ ⟨y, hy, rfl⟩; exact ⟨x + y, add_mem hx hy, map_add _ _ _⟩
  zero_mem' := ⟨0, zero_mem _, map_zero _⟩
  smul_mem' u := by
    rintro _ ⟨z, hz, rfl⟩; exact ⟨_, adRep_mem_maxIdeal u hz, (smul_toAd P p u z).symm⟩

lemma toAd_mem_maxIdealAd {z : 𝒰} : toAd P p z ∈ maxIdealAd P p ↔ z ∈ maxIdeal P p :=
  (toAd P p).injective.mem_set_image

/-- The submodule of the adjoint module generated by the Serre elements. -/
def serreAd : Submodule 𝒰 (Ad P p) :=
  Submodule.span 𝒰 (toAd P p '' {x | ∃ i j, i ≠ j ∧ (x = serreE P p i j ∨ x = serreF P p i j)})

lemma serreE_mem_serreAd {i j : ι} (hij : i ≠ j) : toAd P p (serreE P p i j) ∈ serreAd P p :=
  Submodule.subset_span ⟨_, ⟨i, j, hij, Or.inl rfl⟩, rfl⟩

lemma serreF_mem_serreAd {i j : ι} (hij : i ≠ j) : toAd P p (serreF P p i j) ∈ serreAd P p :=
  Submodule.subset_span ⟨_, ⟨i, j, hij, Or.inr rfl⟩, rfl⟩

lemma serreAd_le_gTildeAd : serreAd P p ≤ gTildeAd P p := by
  refine Submodule.span_le.2 ?_
  rintro _ ⟨x, ⟨i, j, -, rfl | rfl⟩, rfl⟩
  · exact (toAd_mem_gTildeAd P p).2 (serreE_mem_gTilde i j)
  · refine (toAd_mem_gTildeAd P p).2 ?_
    rw [← omega_serreE]
    exact omega_mem_gTilde P p (serreE_mem_gTilde i j)

/-! ### Iterated brackets with the generators -/

omit [CharZero K] in
lemma adE_add (i : ι) (m n : ℕ) (v : 𝒰) : adE P p i (m + n) v = adE P p i m (adE P p i n v) := by
  rw [adE, pow_add, Module.End.mul_apply]; rfl

omit [CharZero K] in
lemma adF_add (i : ι) (m n : ℕ) (v : 𝒰) : adF P p i (m + n) v = adF P p i m (adF P p i n v) := by
  rw [adF, pow_add, Module.End.mul_apply]; rfl

omit [CharZero K] in
lemma adE_eq_zero_of_le (i : ι) {k m : ℕ} (hkm : k ≤ m) {v : 𝒰} (hv : adE P p i k v = 0) :
    adE P p i m v = 0 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hkm
  rw [adE_add, hv]
  exact map_zero _

omit [CharZero K] in
lemma adF_eq_zero_of_le (i : ι) {k m : ℕ} (hkm : k ≤ m) {v : 𝒰} (hv : adF P p i k v = 0) :
    adF P p i m v = 0 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_of_le' hkm
  rw [adF_add, hv]
  exact map_zero _

lemma adRep_e_pow_apply (i : ι) (n : ℕ) (v : 𝒰) :
    (adRep P p (e P p i) ^ n) v = adE P p i n v := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ', Module.End.mul_apply, ih, adRep_e, adE_succ]

lemma adRep_f_pow_apply (i : ι) (n : ℕ) (v : 𝒰) :
    (adRep P p (f P p i) ^ n) v = adF P p i n v := by
  induction n with
  | zero => rfl
  | succ n ih => rw [pow_succ', Module.End.mul_apply, ih, adRep_f, adF_succ]

omit [CharZero K] in
lemma adE_one (i : ι) (v : 𝒰) : adE P p i 1 v = superBracket P p (e P p i) v := by
  rw [adE_succ, adE_zero]

lemma adE_e_self (i : ι) {m : ℕ} (hm : 2 ≤ m) : adE P p i m (e P p i) = 0 :=
  adE_eq_zero_of_le P p i hm (superBracket_e_superBracket_e_e P p i)

lemma adE_f_of_ne {i j : ι} (hij : i ≠ j) {m : ℕ} (hm : 1 ≤ m) : adE P p i m (f P p j) = 0 :=
  adE_eq_zero_of_le P p i hm (by rw [adE_one, superBracket_e_f]; simp [hij])

lemma adE_h (i : ι) (a : H) {m : ℕ} (hm : 3 ≤ m) : adE P p i m (h P p a) = 0 := by
  refine adE_eq_zero_of_le P p i hm ?_
  rw [adE_add P p i 2 1, adE_one, superBracket_e_h]
  have h2 := adE_e_self P p i (le_refl 2)
  simp only [adE] at h2 ⊢
  rw [map_neg, map_smul, h2, smul_zero, neg_zero]

lemma adE_f_self (i : ι) {m : ℕ} (hm : 4 ≤ m) : adE P p i m (f P p i) = 0 := by
  refine adE_eq_zero_of_le P p i hm ?_
  rw [adE_add P p i 3 1, adE_one, superBracket_e_f]
  simp only [ite_true]
  exact adE_h P p i _ le_rfl

omit [CharZero K] in
lemma adF_omega (i : ι) (n : ℕ) (v : 𝒰) :
    adF P p i n (omega P p v) = omega P p (adE P p i n v) := (omega_adE P p i n v).symm

lemma adF_f_self (i : ι) {m : ℕ} (hm : 2 ≤ m) : adF P p i m (f P p i) = 0 := by
  rw [← omega_e, adF_omega, adE_e_self P p i hm, map_zero]

omit [CharZero K] in
lemma paritySign_smul_omega_f (j : ι) : paritySign K p j • omega P p (f P p j) = e P p j := by
  rw [omega_f, smul_smul, paritySign_mul_self, one_smul]

lemma adF_e_of_ne {i j : ι} (hij : i ≠ j) {m : ℕ} (hm : 1 ≤ m) : adF P p i m (e P p j) = 0 := by
  rw [← paritySign_smul_omega_f P p j]
  simp only [adF] at *
  rw [map_smul]
  change paritySign K p j • adF P p i m (omega P p (f P p j)) = 0
  rw [adF_omega, adE_f_of_ne P p hij hm, map_zero, smul_zero]

lemma adF_e_self (i : ι) {m : ℕ} (hm : 4 ≤ m) : adF P p i m (e P p i) = 0 := by
  rw [← paritySign_smul_omega_f P p i]
  simp only [adF] at *
  rw [map_smul]
  change paritySign K p i • adF P p i m (omega P p (f P p i)) = 0
  rw [adF_omega, adE_f_self P p i hm, map_zero, smul_zero]

lemma adF_h (i : ι) (a : H) {m : ℕ} (hm : 3 ≤ m) : adF P p i m (h P p a) = 0 := by
  have : h P p a = -omega P p (h P p a) := by rw [omega_h, neg_neg]
  rw [this]
  simp only [adF] at *
  rw [map_neg]
  change -adF P p i m (omega P p (h P p a)) = 0
  rw [adF_omega, adE_h P p i a hm, map_zero, neg_zero]

variable {P p} in
lemma isHomog_adF (i : ι) (n : ℕ) {b : ZMod 2} {v : 𝒰} (hv : IsHomog P p b v) :
    IsHomog P p (n * p i + b) (adF P p i n v) := by
  induction n with
  | zero => simpa using hv
  | succ n ih =>
    rw [adF_succ, show ((n + 1 : ℕ) : ZMod 2) * p i + b = p i + (n * p i + b) by push_cast; ring]
    exact (isHomog_f P p i).superBracket ih

variable {P p} in
lemma adF_mem_gTilde (i : ι) (n : ℕ) {v : 𝒰} (hv : v ∈ gTilde P p) :
    adF P p i n v ∈ gTilde P p := by
  induction n with
  | zero => exact hv
  | succ n ih => rw [adF_succ]; exact superBracket_f_mem_gTilde P p i ih

/-! ### The adjoint action of the `𝔰𝔩₂`-generators -/

lemma superBracket_superBracket_of_odd {x : 𝒰} (hx : IsHomog P p 1 x) (z : 𝒰) :
    superBracket P p x (superBracket P p x z) = x ^ 2 * z - z * x ^ 2 := by
  refine induction_parity P p (N := ⊤) (fun _ _ => Submodule.mem_top)
    (q := fun z => superBracket P p x (superBracket P p x z) = x ^ 2 * z - z * x ^ 2)
    (fun c z _ hz => ?_) (fun z₁ z₂ h₁ h₂ => ?_) Submodule.mem_top
  · rw [superBracket_of_isHomog hx (hx.superBracket hz), superBracket_of_isHomog hx hz]
    rcases zmod_two_cases c with rfl | rfl
    · rw [show (1 : ZMod 2) * (1 + 0) = 1 from rfl, show (1 : ZMod 2) * 0 = 0 from rfl,
        zSign_one, zSign_zero]
      simp only [neg_smul, one_smul]
      noncomm_ring
    · rw [show (1 : ZMod 2) * (1 + 1) = 0 from rfl, show (1 : ZMod 2) * 1 = 1 from rfl,
        zSign_one, zSign_zero]
      simp only [neg_smul, one_smul]
      noncomm_ring
  · simp only [superBracket_add_right, h₁, h₂]
    noncomm_ring

lemma adRep_sl2E (i : ι) :
    adRep P p (sl2E P p i) = ((sl2Deg p i : K)⁻¹) • adRep P p (e P p i) ^ sl2Deg p i := by
  unfold sl2E sl2Deg
  split_ifs <;> simp

/-- The coefficient of `fᵢ^{dᵢ}` in `Fᵢ`. -/
def sl2FCoeff (i : ι) : K := if p i = 1 then -(2 : K)⁻¹ else 1

lemma adRep_sl2F (i : ι) :
    adRep P p (sl2F P p i) = sl2FCoeff (K := K) p i • adRep P p (f P p i) ^ sl2Deg p i := by
  unfold sl2F sl2Deg sl2FCoeff
  split_ifs <;> ext v <;> simp

lemma adRep_sl2E_pow_apply (i : ι) (k : ℕ) (v : 𝒰) :
    (adRep P p (sl2E P p i) ^ k) v = ((sl2Deg p i : K)⁻¹) ^ k • adE P p i (sl2Deg p i * k) v := by
  rw [adRep_sl2E, smul_pow, ← pow_mul, LinearMap.smul_apply, adRep_e_pow_apply]

lemma adRep_sl2F_pow_apply (i : ι) (k : ℕ) (v : 𝒰) :
    (adRep P p (sl2F P p i) ^ k) v = sl2FCoeff (K := K) p i ^ k • adF P p i (sl2Deg p i * k) v := by
  rw [adRep_sl2F, smul_pow, ← pow_mul, LinearMap.smul_apply, adRep_f_pow_apply]

lemma adRep_sl2E_apply (i : ι) (z : 𝒰) :
    adRep P p (sl2E P p i) z = sl2E P p i * z - z * sl2E P p i := by
  rcases zmod_two_cases (p i) with hi | hi
  · have he : IsEven P p (e P p i) := by
      have := isHomog_e P p i; rw [hi] at this; simpa [IsHomog, IsEven] using this
    rw [adRep_sl2E]; unfold sl2Deg sl2E
    simp only [hi, zero_ne_one, ite_false, Nat.cast_one, inv_one, pow_one, one_smul, adRep_e,
      superBracket_of_even_left P p he]
  · have he : IsHomog P p 1 (e P p i) := by rw [← hi]; exact isHomog_e P p i
    have h2 : (adRep P p (e P p i) ^ 2) z = e P p i ^ 2 * z - z * e P p i ^ 2 := by
      rw [sq, Module.End.mul_apply, adRep_e, adRep_e]
      exact superBracket_superBracket_of_odd P p he z
    rw [adRep_sl2E]; unfold sl2Deg sl2E
    simp only [hi, ite_true]
    rw [LinearMap.smul_apply, h2, smul_sub, smul_mul_assoc, mul_smul_comm]
    norm_num

lemma adRep_sl2F_apply (i : ι) (z : 𝒰) :
    adRep P p (sl2F P p i) z = sl2F P p i * z - z * sl2F P p i := by
  rcases zmod_two_cases (p i) with hi | hi
  · have hf : IsEven P p (f P p i) := by
      have := isHomog_f P p i; rw [hi] at this; simpa [IsHomog, IsEven] using this
    rw [adRep_sl2F]; unfold sl2Deg sl2F sl2FCoeff
    simp only [hi, zero_ne_one, ite_false, pow_one, one_smul, adRep_f,
      superBracket_of_even_left P p hf]
  · have hf : IsHomog P p 1 (f P p i) := by rw [← hi]; exact isHomog_f P p i
    have h2 : (adRep P p (f P p i) ^ 2) z = f P p i ^ 2 * z - z * f P p i ^ 2 := by
      rw [sq, Module.End.mul_apply, adRep_f, adRep_f]
      exact superBracket_superBracket_of_odd P p hf z
    rw [adRep_sl2F]; unfold sl2Deg sl2F sl2FCoeff
    simp only [hi, ite_true]
    rw [LinearMap.smul_apply, h2, neg_mul, mul_neg, smul_mul_assoc, mul_smul_comm, neg_smul,
      smul_sub]
    abel

/-! ### Local nilpotency modulo a submodule -/

instance : SMulCommClass K 𝒰 (Ad P p) where
  smul_comm c u z := by
    obtain ⟨z, rfl⟩ := (toAd P p).surjective z
    change c • adRep P p u z = adRep P p u (c • z)
    rw [map_smul]

/-- A homogeneous element of `G̃(A, τ)` whose image in the adjoint module lies in `N`. -/
def IsGood (N : Submodule 𝒰 (Ad P p)) (s : 𝒰) : Prop :=
  toAd P p s ∈ N ∧ s ∈ gTilde P p ∧ ∃ c, IsHomog P p c s

variable {P p}

lemma isGood_zero (N : Submodule 𝒰 (Ad P p)) : IsGood P p N 0 :=
  ⟨by rw [map_zero]; exact N.zero_mem, zero_mem _, 0, isHomog_zero 0⟩

lemma IsGood.smul {N : Submodule 𝒰 (Ad P p)} {s : 𝒰} (hs : IsGood P p N s) (c : K) :
    IsGood P p N (c • s) := by
  obtain ⟨h₁, h₂, a, h₃⟩ := hs
  exact ⟨by rw [map_smul]; exact N.smul_of_tower_mem c h₁, Submodule.smul_mem _ c h₂, a,
    h₃.smul c⟩

/-- If `s` is good, then `[s, w] ∈ N` for all `w ∈ G̃(A, τ)`. -/
lemma smul_mem_of_isGood {N : Submodule 𝒰 (Ad P p)} {s : 𝒰} (hs : IsGood P p N s) {w : 𝒰}
    (hw : w ∈ gTilde P p) : s • toAd P p w ∈ N := by
  obtain ⟨hsN, hsG, c, hsc⟩ := hs
  rw [smul_toAd, adRep_of_mem_gTilde hsG]
  refine induction_parity P p (N := gTilde P p) (fun _ hx ↦ parity_mem_gTilde P p hx)
    (q := fun w ↦ toAd P p (superBracket P p s w) ∈ N) (fun d w hw hwd ↦ ?_)
    (fun w₁ w₂ h₁ h₂ ↦ ?_) hw
  · rw [superBracket_swap hwd hsc, map_neg, map_smul, ← adRep_of_mem_gTilde hw, ← smul_toAd]
    exact N.neg_mem (N.smul_of_tower_mem _ (N.smul_mem w hsN))
  · rw [superBracket_add_right, map_add]; exact add_mem h₁ h₂

attribute [local instance] LieRing.ofAssociativeRing LieRingModule.ofAssociativeModule
  LieModule.ofAssociativeModule

/-- The Leibniz rule: if all `(ad x)^k g` with `k ≥ a` are good and `x^b [z] ∈ N`, then
`x^{a + b} [g, z] ∈ N`. -/
lemma pow_smul_smul_mem {N : Submodule 𝒰 (Ad P p)} {x g : 𝒰} {a b : ℕ}
    (hx : ∀ z, adRep P p x z = x * z - z * x)
    (hg : ∀ k, a ≤ k → IsGood P p N ((adRep P p x ^ k) g)) {z : 𝒰} (hz : z ∈ gTilde P p)
    (hzb : x ^ b • toAd P p z ∈ N) : x ^ (a + b) • (g • toAd P p z) ∈ N := by
  have had : ∀ k (y : 𝒰), (LieAlgebra.ad K 𝒰 x ^ k) y = (adRep P p x ^ k) y := by
    intro k
    induction k with
    | zero => intro y; rfl
    | succ k ih =>
      intro y
      rw [pow_succ', pow_succ', Module.End.mul_apply, Module.End.mul_apply, ih,
        LieAlgebra.ad_apply, Ring.lie_def, hx]
  have hgz : g • toAd P p z = ⁅g, toAd P p z⁆ := rfl
  rw [hgz, ← toEnd_pow_apply, LieModule.toEnd_pow_lie]
  refine Submodule.sum_mem _ fun ij hij ↦ nsmul_mem ?_ _
  rw [Finset.mem_antidiagonal] at hij
  rw [had, toEnd_pow_apply]
  change ((adRep P p x ^ ij.1) g) • (x ^ ij.2 • toAd P p z) ∈ N
  by_cases hi : a ≤ ij.1
  · rw [smul_toAd]; exact smul_mem_of_isGood (hg _ hi) (adRep_mem_gTilde _ hz)
  · obtain ⟨c, hc⟩ := Nat.exists_eq_add_of_le' (show b ≤ ij.2 by omega)
    rw [hc, pow_add, mul_smul]
    exact N.smul_mem _ (N.smul_mem _ hzb)

/-- If `x` acts on `U` by commutators and `ad x` is eventually good on the generators, then `x`
acts locally nilpotently on `G̃(A, τ)` modulo `N`. -/
lemma exists_pow_smul_mem {N : Submodule 𝒰 (Ad P p)} {x : 𝒰}
    (hx : ∀ z, adRep P p x z = x * z - z * x)
    (he : ∀ j, ∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p x ^ k) (e P p j)))
    (hf : ∀ j, ∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p x ^ k) (f P p j)))
    (hh : ∀ c, ∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p x ^ k) (h P p c)))
    {z : 𝒰} (hz : z ∈ gTilde P p) : ∃ n, x ^ n • toAd P p z ∈ N := by
  have hmono : ∀ {z : 𝒰} {n m : ℕ}, n ≤ m → x ^ n • toAd P p z ∈ N →
      x ^ m • toAd P p z ∈ N := by
    intro z n m hnm hn
    obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le' hnm
    rw [pow_add, mul_smul]; exact N.smul_mem _ hn
  let T : Submodule K 𝒰 :=
    { carrier := {z | z ∈ gTilde P p ∧ ∃ n, x ^ n • toAd P p z ∈ N}
      add_mem' := by
        rintro z₁ z₂ ⟨h₁, n₁, hn₁⟩ ⟨h₂, n₂, hn₂⟩
        refine ⟨add_mem h₁ h₂, n₁ + n₂, ?_⟩
        rw [map_add, smul_add]
        exact add_mem (hmono (Nat.le_add_right _ _) hn₁) (hmono (Nat.le_add_left _ _) hn₂)
      zero_mem' := ⟨zero_mem _, 0, by rw [map_zero, smul_zero]; exact N.zero_mem⟩
      smul_mem' := by
        rintro c z ⟨h₁, n, hn⟩
        refine ⟨Submodule.smul_mem _ c h₁, n, ?_⟩
        rw [map_smul, smul_comm]; exact N.smul_of_tower_mem c hn }
  have hgen : ∀ g, g ∈ gTilde P p → (∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p x ^ k) g)) →
      g ∈ T ∧ ∀ z ∈ T, superBracket P p g z ∈ T := by
    rintro g hgG ⟨a, ha⟩
    refine ⟨⟨hgG, a, ?_⟩, ?_⟩
    · rw [smul_toAd, map_pow]; exact (ha a le_rfl).1
    · rintro z ⟨hzG, b, hb⟩
      refine ⟨superBracket_mem_gTilde P p hgG hzG, a + b, ?_⟩
      rw [← adRep_of_mem_gTilde hgG, ← smul_toAd]
      exact pow_smul_smul_mem hx ha hzG hb
  have hP : nPlus P p ≤ T := by
    refine (nPlus_le_iff P p).2 fun i w ↦ ?_
    induction w with
    | nil => exact (hgen _ (e_mem_gTilde P p i) (he i)).1
    | cons j w ih => rw [eLie_cons]; exact (hgen _ (e_mem_gTilde P p j) (he j)).2 _ ih
  have hM : nMinus P p ≤ T := by
    refine Submodule.map_le_iff_le_comap.2 ((nPlus_le_iff P p).2 fun i w ↦ ?_)
    simp only [Submodule.mem_comap, AlgHom.toLinearMap_apply]
    induction w with
    | nil => simpa using (hgen _ (f_mem_gTilde P p i) (hf i)).1
    | cons j w ih =>
      rw [omega_eLie_cons]; exact (hgen _ (f_mem_gTilde P p j) (hf j)).2 _ ih
  have hH : LinearMap.range (h P p) ≤ T := by
    rintro _ ⟨c, rfl⟩; exact (hgen _ (h_mem_gTilde P p c) (hh c)).1
  exact (sup_le (sup_le hM hH) hP hz).2

/-! ### Integrability of `G̃(A, τ) / N` -/

lemma isGood_adE_of_eq_zero {N : Submodule 𝒰 (Ad P p)} (i : ι) {g : 𝒰} {n : ℕ}
    (hg : adE P p i n g = 0) : ∀ m, n ≤ m → IsGood P p N (adE P p i m g) := fun _ hm ↦ by
  rw [adE_eq_zero_of_le P p i hm hg]; exact isGood_zero N

lemma isGood_adF_of_eq_zero {N : Submodule 𝒰 (Ad P p)} (i : ι) {g : 𝒰} {n : ℕ}
    (hg : adF P p i n g = 0) : ∀ m, n ≤ m → IsGood P p N (adF P p i m g) := fun _ hm ↦ by
  rw [adF_eq_zero_of_le P p i hm hg]; exact isGood_zero N

lemma toAd_adE (i : ι) (n : ℕ) (v : 𝒰) : toAd P p (adE P p i n v) = e P p i ^ n • toAd P p v := by
  rw [smul_toAd, map_pow, adRep_e_pow_apply]

lemma toAd_adF (i : ι) (n : ℕ) (v : 𝒰) : toAd P p (adF P p i n v) = f P p i ^ n • toAd P p v := by
  rw [smul_toAd, map_pow, adRep_f_pow_apply]

lemma isGood_adE_e {N : Submodule 𝒰 (Ad P p)}
    (hS : ∀ i j, i ≠ j → toAd P p (serreE P p i j) ∈ N) (i j : ι) :
    ∃ n, ∀ m, n ≤ m → IsGood P p N (adE P p i m (e P p j)) := by
  by_cases hij : i = j
  · subst hij; exact ⟨2, isGood_adE_of_eq_zero i (adE_e_self P p i le_rfl)⟩
  refine ⟨(-A i j).toNat + 1, fun m hm ↦ ⟨?_, adE_mem_gTilde i m (e_mem_gTilde P p j), _,
    isHomog_adE i m (isHomog_e P p j)⟩⟩
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hm
  rw [add_comm, adE_add, toAd_adE]
  exact N.smul_mem _ (hS i j hij)

lemma isGood_adF_f {N : Submodule 𝒰 (Ad P p)}
    (hS : ∀ i j, i ≠ j → toAd P p (serreF P p i j) ∈ N) (i j : ι) :
    ∃ n, ∀ m, n ≤ m → IsGood P p N (adF P p i m (f P p j)) := by
  by_cases hij : i = j
  · subst hij; exact ⟨2, isGood_adF_of_eq_zero i (adF_f_self P p i le_rfl)⟩
  refine ⟨(-A i j).toNat + 1, fun m hm ↦ ⟨?_, adF_mem_gTilde i m (f_mem_gTilde P p j), _,
    isHomog_adF i m (isHomog_f P p j)⟩⟩
  obtain ⟨c, rfl⟩ := Nat.exists_eq_add_of_le hm
  rw [add_comm, adF_add, toAd_adF]
  exact N.smul_mem _ (hS i j hij)

omit [Fintype ι] [DecidableEq ι] in
lemma sl2Deg_mul_ge (i : ι) (k : ℕ) : k ≤ sl2Deg p i * k :=
  Nat.le_mul_of_pos_left k (sl2Deg_pos p i)

lemma exists_isGood_sl2E {N : Submodule 𝒰 (Ad P p)} (i : ι) {g : 𝒰}
    (hg : ∃ n, ∀ m, n ≤ m → IsGood P p N (adE P p i m g)) :
    ∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p (sl2E P p i) ^ k) g) := by
  obtain ⟨n, hn⟩ := hg
  refine ⟨n, fun k hk ↦ ?_⟩
  rw [adRep_sl2E_pow_apply]
  exact (hn _ (hk.trans (sl2Deg_mul_ge i k))).smul _

lemma exists_isGood_sl2F {N : Submodule 𝒰 (Ad P p)} (i : ι) {g : 𝒰}
    (hg : ∃ n, ∀ m, n ≤ m → IsGood P p N (adF P p i m g)) :
    ∃ a, ∀ k, a ≤ k → IsGood P p N ((adRep P p (sl2F P p i) ^ k) g) := by
  obtain ⟨n, hn⟩ := hg
  refine ⟨n, fun k hk ↦ ?_⟩
  rw [adRep_sl2F_pow_apply]
  exact (hn _ (hk.trans (sl2Deg_mul_ge i k))).smul _

lemma e_pow_sl2Deg_mul (i : ι) (n : ℕ) :
    e P p i ^ (sl2Deg p i * n) = ((sl2Deg p i : K) ^ n) • sl2E P p i ^ n := by
  unfold sl2Deg sl2E
  split_ifs
  · rw [smul_pow, smul_smul, ← mul_pow, pow_mul]; norm_num
  · simp

lemma f_pow_sl2Deg_mul (i : ι) (n : ℕ) :
    f P p i ^ (sl2Deg p i * n) = ((sl2FCoeff (K := K) p i)⁻¹ ^ n) • sl2F P p i ^ n := by
  unfold sl2Deg sl2F sl2FCoeff
  split_ifs
  · rw [← neg_smul, smul_pow, smul_smul, ← mul_pow, pow_mul]; norm_num
  · simp

/-- If `N` contains the positive Serre elements, then `Eᵢ` acts locally nilpotently on
`G̃(A, τ)` modulo `N`. -/
theorem exists_sl2E_pow_smul_mem (N : Submodule 𝒰 (Ad P p))
    (hSE : ∀ i j, i ≠ j → toAd P p (serreE P p i j) ∈ N) (i : ι) {z : 𝒰}
    (hz : z ∈ gTilde P p) : ∃ n, sl2E P p i ^ n • toAd P p z ∈ N :=
  exists_pow_smul_mem (adRep_sl2E_apply P p i)
    (fun j ↦ exists_isGood_sl2E i (isGood_adE_e hSE i j))
    (fun j ↦ exists_isGood_sl2E i (if hij : i = j then ⟨4, isGood_adE_of_eq_zero i
      (by subst hij; exact adE_f_self P p i le_rfl)⟩ else
      ⟨1, isGood_adE_of_eq_zero i (adE_f_of_ne P p hij le_rfl)⟩))
    (fun c ↦ exists_isGood_sl2E i ⟨3, isGood_adE_of_eq_zero i (adE_h P p i c le_rfl)⟩) hz

/-- If `N` contains the negative Serre elements, then `Fᵢ` acts locally nilpotently on
`G̃(A, τ)` modulo `N`. -/
theorem exists_sl2F_pow_smul_mem (N : Submodule 𝒰 (Ad P p))
    (hSF : ∀ i j, i ≠ j → toAd P p (serreF P p i j) ∈ N) (i : ι) {z : 𝒰}
    (hz : z ∈ gTilde P p) : ∃ n, sl2F P p i ^ n • toAd P p z ∈ N :=
  exists_pow_smul_mem (adRep_sl2F_apply P p i)
    (fun j ↦ exists_isGood_sl2F i (if hij : i = j then ⟨4, isGood_adF_of_eq_zero i
      (by subst hij; exact adF_e_self P p i le_rfl)⟩ else
      ⟨1, isGood_adF_of_eq_zero i (adF_e_of_ne P p hij le_rfl)⟩))
    (fun j ↦ exists_isGood_sl2F i (isGood_adF_f hSF i j))
    (fun c ↦ exists_isGood_sl2F i ⟨3, isGood_adF_of_eq_zero i (adF_h P p i c le_rfl)⟩) hz

/-- [Kac78] §1.4 (cf. [Kac] Lemma 3.5): if `N ⊆ G̃(A, τ)` is a submodule of the adjoint module
containing the Serre elements, then `G̃(A, τ) / N` is an integrable module. -/
theorem isIntegrable_quotient (N : Submodule 𝒰 (Ad P p))
    (hSE : ∀ i j, i ≠ j → toAd P p (serreE P p i j) ∈ N)
    (hSF : ∀ i j, i ≠ j → toAd P p (serreF P p i j) ∈ N) :
    IsIntegrable P p (↥(gTildeAd P p) ⧸ N.comap (gTildeAd P p).subtype) := by
  have hE : ∀ i z, z ∈ gTilde P p → ∃ n, e P p i ^ n • toAd P p z ∈ N := by
    intro i z hz
    obtain ⟨n, hn⟩ := exists_sl2E_pow_smul_mem N hSE i hz
    refine ⟨sl2Deg p i * n, ?_⟩
    rw [e_pow_sl2Deg_mul, smul_assoc]
    exact N.smul_of_tower_mem _ hn
  have hF : ∀ i z, z ∈ gTilde P p → ∃ n, f P p i ^ n • toAd P p z ∈ N := by
    intro i z hz
    obtain ⟨n, hn⟩ := exists_sl2F_pow_smul_mem N hSF i hz
    refine ⟨sl2Deg p i * n, ?_⟩
    rw [f_pow_sl2Deg_mul, smul_assoc]
    exact N.smul_of_tower_mem _ hn
  intro i v
  induction v using Submodule.Quotient.induction_on with
  | H w =>
    obtain ⟨_, z, hz, rfl⟩ := w
    obtain ⟨n, hn⟩ := hE i z hz
    obtain ⟨m, hm⟩ := hF i z hz
    refine ⟨⟨n, ?_⟩, ⟨m, ?_⟩⟩
    · rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]; exact hn
    · rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]; exact hm



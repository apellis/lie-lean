import LieLean.Algebra.Lie.KacMoody.Super.TensorRep

/-!
# Verma modules of `G̃(A, τ)`

For `Λ ∈ 𝔥*`, the Verma module `M(Λ)` of the auxiliary contragredient Lie superalgebra `G̃(A, τ)`
([Kac78] §2.1, where it is denoted `P(Λ)` and induced from the Borel subalgebra) is the quotient
of `U = U(G̃(A, τ))` by the left ideal generated by the `eᵢ` and the `h - Λ(h)`, `h ∈ 𝔥`. It is
generated by the image `v_Λ` of `1`, which has weight `Λ` and is killed by the `eᵢ`, and it has
the universal property of the induced module (`Verma.lift`).

The tensor-algebra representation identifies `M(Λ)` with the tensor algebra `T(V)`, `vᵢ ↦ fᵢ`
(`Verma.toTensorEquiv`): `M(Λ)` is free over the subalgebra generated by the `fᵢ`, which is free.
This is the part of [Kac78] Prop. 2.1 (c) used later (the character of `M(Λ)`); it needs no
Poincaré–Birkhoff–Witt theorem for Lie superalgebras.

## Main definitions

* `Matrix.Realization.SuperEnveloping.vermaIdeal`: the left ideal `U eᵢ + U (h - Λ(h))`.
* `Matrix.Realization.SuperEnveloping.Verma`: the Verma module `M(Λ) = U ⧸ vermaIdeal Λ`.
* `Matrix.Realization.SuperEnveloping.Verma.lift`: the universal property.
* `Matrix.Realization.SuperEnveloping.Verma.toTensorEquiv`: `M(Λ) ≃ T(V)`.

## Main results

* `Matrix.Realization.SuperEnveloping.exists_sub_fAlg_mem_vermaIdeal`:
  `U = fAlg(T(V)) + vermaIdeal Λ`.
* `Matrix.Realization.SuperEnveloping.Verma.toTensorEquiv_mk`: `M(Λ) ≃ T(V)` sends the class of
  `u` to `u • 1`.

## References

* [Kac78] V. G. Kac, *Infinite-dimensional algebras, Dedekind's η-function, classical Möbius
  function and the very strange formula*, Adv. Math. **30** (1978), 85–136, §2.1.
-/

open Module

noncomputable section

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H) (p : ι → ZMod 2)

namespace SuperEnveloping

/-- Induction over `U(G̃(A, τ))`: it is generated as an algebra by the `eᵢ`, the `fᵢ` and `𝔥`. -/
theorem induction {C : P.SuperEnveloping p → Prop} (algebraMap : ∀ c : K, C (algebraMap K _ c))
    (e : ∀ i, C (e P p i)) (f : ∀ i, C (f P p i)) (h : ∀ a, C (h P p a))
    (add : ∀ x y, C x → C y → C (x + y)) (mul : ∀ x y, C x → C y → C (x * y))
    (u : P.SuperEnveloping p) : C u := by
  obtain ⟨w, rfl⟩ := mk_surjective P p u
  induction w using FreeAlgebra.induction with
  | grade0 c => simpa using algebraMap c
  | grade1 g =>
    cases g with
    | e i => exact e i
    | f i => exact f i
    | h a => exact h a
  | add x y hx hy => simpa using add _ _ hx hy
  | mul x y hx hy => simpa using mul _ _ hx hy

variable (Λ : Dual K H)

/-- The left ideal of `U(G̃(A, τ))` generated by the `eᵢ` and the `h - Λ(h)`. -/
def vermaIdeal : Submodule (P.SuperEnveloping p) (P.SuperEnveloping p) :=
  Submodule.span _ (Set.range (e P p) ∪ Set.range fun a ↦ h P p a - algebraMap K _ (Λ a))

lemma e_mem_vermaIdeal (i : ι) : e P p i ∈ vermaIdeal P p Λ :=
  Submodule.subset_span (Or.inl ⟨i, rfl⟩)

lemma h_sub_mem_vermaIdeal (a : H) : h P p a - algebraMap K _ (Λ a) ∈ vermaIdeal P p Λ :=
  Submodule.subset_span (Or.inr ⟨a, rfl⟩)

lemma mul_mem_vermaIdeal (u : P.SuperEnveloping p) {x : P.SuperEnveloping p}
    (hx : x ∈ vermaIdeal P p Λ) : u * x ∈ vermaIdeal P p Λ :=
  (vermaIdeal P p Λ).smul_mem u hx

/-- The elements congruent modulo `vermaIdeal Λ` to an element of the subalgebra generated by the
`fᵢ`. -/
def fSpan : Submodule K (P.SuperEnveloping p) :=
  LinearMap.range (fAlg P p).toLinearMap ⊔ (vermaIdeal P p Λ).restrictScalars K

lemma mem_fSpan_iff {u : P.SuperEnveloping p} :
    u ∈ fSpan P p Λ ↔ ∃ x, u - fAlg P p x ∈ vermaIdeal P p Λ := by
  rw [fSpan, Submodule.mem_sup]
  constructor
  · rintro ⟨_, ⟨x, rfl⟩, y, hy, rfl⟩
    exact ⟨x, by simpa using hy⟩
  · rintro ⟨x, hx⟩
    exact ⟨_, ⟨x, rfl⟩, _, hx, add_sub_cancel _ _⟩

lemma fAlg_mem_fSpan (x : FreeAlgebra K ι) : fAlg P p x ∈ fSpan P p Λ :=
  (mem_fSpan_iff P p Λ).2 ⟨x, by simp⟩

lemma mem_fSpan_of_mem {u : P.SuperEnveloping p} (hu : u ∈ vermaIdeal P p Λ) :
    u ∈ fSpan P p Λ :=
  Submodule.mem_sup_right hu

lemma f_mul_mem_fSpan (i : ι) {u : P.SuperEnveloping p} (hu : u ∈ fSpan P p Λ) :
    f P p i * u ∈ fSpan P p Λ := by
  obtain ⟨x, hx⟩ := (mem_fSpan_iff P p Λ).1 hu
  refine (mem_fSpan_iff P p Λ).2 ⟨FreeAlgebra.ι K i * x, ?_⟩
  rw [map_mul, fAlg_ι, ← mul_sub]
  exact mul_mem_vermaIdeal P p Λ _ hx

lemma h_mem_fSpan (a : H) : h P p a ∈ fSpan P p Λ := by
  refine (mem_fSpan_iff P p Λ).2 ⟨algebraMap K _ (Λ a), ?_⟩
  rw [AlgHom.commutes]
  exact h_sub_mem_vermaIdeal P p Λ a

/-- The left action of the generators `eᵢ` and `h` preserves `fAlg(T(V)) + vermaIdeal Λ` on the
image of the words. -/
lemma gen_mul_fAlg_word_mem (w : List ι) :
    (∀ i, e P p i * fAlg P p (FreeAlgebra.word w) ∈ fSpan P p Λ) ∧
      ∀ a, h P p a * fAlg P p (FreeAlgebra.word w) ∈ fSpan P p Λ := by
  induction w with
  | nil =>
    simp only [FreeAlgebra.word_nil, map_one, mul_one]
    exact ⟨fun i ↦ mem_fSpan_of_mem P p Λ (e_mem_vermaIdeal P p Λ i), h_mem_fSpan P p Λ⟩
  | cons j w ih =>
    simp only [FreeAlgebra.word_cons, map_mul, fAlg_ι, ← mul_assoc]
    refine ⟨fun i ↦ ?_, fun a ↦ ?_⟩
    · rw [e_mul_f, add_mul, smul_mul_assoc, mul_assoc]
      refine add_mem (Submodule.smul_mem _ _ (f_mul_mem_fSpan P p Λ j (ih.1 i))) ?_
      split_ifs
      · exact ih.2 _
      · simp
    · rw [h_mul_f, sub_mul, smul_mul_assoc, mul_assoc]
      refine sub_mem (f_mul_mem_fSpan P p Λ j (ih.2 a)) (Submodule.smul_mem _ _ ?_)
      exact f_mul_mem_fSpan P p Λ j (fAlg_mem_fSpan P p Λ _)

lemma gen_mul_fAlg_mem (x : FreeAlgebra K ι) :
    (∀ i, e P p i * fAlg P p x ∈ fSpan P p Λ) ∧ ∀ a, h P p a * fAlg P p x ∈ fSpan P p Λ := by
  have hx : x ∈ Submodule.span K (Set.range (FreeAlgebra.basisFreeMonoid K ι)) := by
    rw [Basis.span_eq]; trivial
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨w, rfl⟩ := hy
    have := gen_mul_fAlg_word_mem P p Λ (FreeMonoid.toList w)
    simpa [FreeAlgebra.word] using this
  | zero => simp
  | add y z _ _ hy hz =>
    simp only [map_add, mul_add]
    exact ⟨fun i ↦ add_mem (hy.1 i) (hz.1 i), fun a ↦ add_mem (hy.2 a) (hz.2 a)⟩
  | smul c y _ hy =>
    simp only [map_smul, mul_smul_comm]
    exact ⟨fun i ↦ Submodule.smul_mem _ c (hy.1 i), fun a ↦ Submodule.smul_mem _ c (hy.2 a)⟩

/-- `fAlg(T(V)) + vermaIdeal Λ` is a left ideal. -/
lemma mul_mem_fSpan (u : P.SuperEnveloping p) {v : P.SuperEnveloping p}
    (hv : v ∈ fSpan P p Λ) : u * v ∈ fSpan P p Λ := by
  induction u using induction generalizing v with
  | algebraMap c => rw [Algebra.algebraMap_eq_smul_one, smul_mul_assoc, one_mul]; exact
      Submodule.smul_mem _ c hv
  | e i =>
    obtain ⟨x, hx⟩ := (mem_fSpan_iff P p Λ).1 hv
    have : e P p i * v = e P p i * fAlg P p x + e P p i * (v - fAlg P p x) := by
      rw [← mul_add, add_sub_cancel]
    rw [this]
    exact add_mem ((gen_mul_fAlg_mem P p Λ x).1 i)
      (mem_fSpan_of_mem P p Λ (mul_mem_vermaIdeal P p Λ _ hx))
  | f i => exact f_mul_mem_fSpan P p Λ i hv
  | h a =>
    obtain ⟨x, hx⟩ := (mem_fSpan_iff P p Λ).1 hv
    have : h P p a * v = h P p a * fAlg P p x + h P p a * (v - fAlg P p x) := by
      rw [← mul_add, add_sub_cancel]
    rw [this]
    exact add_mem ((gen_mul_fAlg_mem P p Λ x).2 a)
      (mem_fSpan_of_mem P p Λ (mul_mem_vermaIdeal P p Λ _ hx))
  | add x y hx hy => rw [add_mul]; exact add_mem (hx hv) (hy hv)
  | mul x y hx hy => rw [mul_assoc]; exact hx (hy hv)

/-- Every element of `U(G̃(A, τ))` is congruent modulo `vermaIdeal Λ` to an element of the
subalgebra generated by the `fᵢ`. -/
theorem exists_sub_fAlg_mem_vermaIdeal (u : P.SuperEnveloping p) :
    ∃ x, u - fAlg P p x ∈ vermaIdeal P p Λ := by
  rw [← mem_fSpan_iff, ← mul_one u]
  exact mul_mem_fSpan P p Λ u (by simpa using fAlg_mem_fSpan P p Λ 1)

/-- The Verma module `M(Λ)` of `G̃(A, τ)` ([Kac78] §2.1). -/
abbrev Verma : Type _ := P.SuperEnveloping p ⧸ vermaIdeal P p Λ

namespace Verma

/-- The highest weight vector `v_Λ`, the class of `1`. -/
def hwv : Verma P p Λ := Submodule.Quotient.mk 1

lemma mk_eq_smul_hwv (u : P.SuperEnveloping p) :
    (Submodule.Quotient.mk u : Verma P p Λ) = u • hwv P p Λ := by
  rw [hwv, ← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one]

lemma e_smul_hwv (i : ι) : e P p i • hwv P p Λ = 0 := by
  rw [← mk_eq_smul_hwv, Submodule.Quotient.mk_eq_zero]
  exact e_mem_vermaIdeal P p Λ i

lemma h_smul_hwv (a : H) : h P p a • hwv P p Λ = Λ a • hwv P p Λ := by
  rw [← mk_eq_smul_hwv, hwv, ← Submodule.Quotient.mk_smul, ← sub_eq_zero,
    ← Submodule.Quotient.mk_sub, Submodule.Quotient.mk_eq_zero, Algebra.smul_def, mul_one]
  exact h_sub_mem_vermaIdeal P p Λ a

/-- `M(Λ)` is generated by `v_Λ`. -/
lemma span_hwv : Submodule.span (P.SuperEnveloping p) {hwv P p Λ} = ⊤ := by
  refine eq_top_iff.2 fun v _ ↦ ?_
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  rw [mk_eq_smul_hwv]
  exact Submodule.smul_mem _ u (Submodule.mem_span_singleton_self _)

section lift

variable {M : Type*} [AddCommGroup M] [Module (P.SuperEnveloping p) M] (m : M)

/-- The kernel of `u ↦ u • m` contains `vermaIdeal Λ` when `m` is killed by the `eᵢ` and has
weight `Λ`. -/
lemma vermaIdeal_le_ker (he : ∀ i, e P p i • m = 0)
    (hh : ∀ a, h P p a • m = algebraMap K (P.SuperEnveloping p) (Λ a) • m) :
    vermaIdeal P p Λ ≤ LinearMap.ker (LinearMap.toSpanSingleton _ M m) := by
  rw [vermaIdeal, Submodule.span_le]
  rintro _ (⟨i, rfl⟩ | ⟨a, rfl⟩)
  · simpa using he i
  · simp [sub_smul, hh a]

/-- The universal property of the Verma module: a vector `m` killed by the `eᵢ` and of weight `Λ`
defines a module map `M(Λ) → M`, `v_Λ ↦ m`. -/
def lift (he : ∀ i, e P p i • m = 0)
    (hh : ∀ a, h P p a • m = algebraMap K (P.SuperEnveloping p) (Λ a) • m) :
    Verma P p Λ →ₗ[P.SuperEnveloping p] M :=
  (vermaIdeal P p Λ).liftQ (LinearMap.toSpanSingleton _ M m) (vermaIdeal_le_ker P p Λ m he hh)

@[simp] lemma lift_mk (he hh) (u : P.SuperEnveloping p) :
    lift P p Λ m he hh (Submodule.Quotient.mk u) = u • m := rfl

@[simp] lemma lift_hwv (he hh) : lift P p Λ m he hh (hwv P p Λ) = m := by
  simp [hwv]

lemma lift_unique (he hh) (φ : Verma P p Λ →ₗ[P.SuperEnveloping p] M) (hφ : φ (hwv P p Λ) = m) :
    φ = lift P p Λ m he hh := by
  refine LinearMap.ext fun v ↦ ?_
  obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ v
  rw [mk_eq_smul_hwv, map_smul, map_smul, hφ, lift_hwv]

end lift

/-- The map `U → T(V)`, `u ↦ u • 1` for the tensor-algebra representation. -/
def toTensorAux : P.SuperEnveloping p →ₗ[K] FreeAlgebra K ι :=
  LinearMap.applyₗ (R := K) (1 : FreeAlgebra K ι) ∘ₗ (tensorRep P p Λ).toLinearMap

@[simp] lemma toTensorAux_apply (u : P.SuperEnveloping p) :
    toTensorAux P p Λ u = tensorRep P p Λ u 1 := rfl

lemma vermaIdeal_le_ker_toTensorAux :
    (vermaIdeal P p Λ).restrictScalars K ≤ LinearMap.ker (toTensorAux P p Λ) := by
  intro u hu
  rw [Submodule.restrictScalars_mem] at hu
  induction hu using Submodule.span_induction with
  | mem x hx =>
    rcases hx with ⟨i, rfl⟩ | ⟨a, rfl⟩
    · simpa using tensorRep_e_one P p Λ i
    · simp [Algebra.algebraMap_eq_smul_one]
  | zero => simp
  | add x y _ _ hx hy => exact add_mem hx hy
  | smul u x _ hx =>
    simp only [LinearMap.mem_ker, toTensorAux_apply, smul_eq_mul, map_mul,
      Module.End.mul_apply] at hx ⊢
    rw [hx, map_zero]

/-- The linear map `M(Λ) → T(V)` induced by the tensor-algebra representation. -/
def toTensor : Verma P p Λ →ₗ[K] FreeAlgebra K ι :=
  ((vermaIdeal P p Λ).restrictScalars K).liftQ (toTensorAux P p Λ)
    (vermaIdeal_le_ker_toTensorAux P p Λ) ∘ₗ
      (Submodule.Quotient.restrictScalarsEquiv K (vermaIdeal P p Λ)).symm.toLinearMap

@[simp] lemma toTensor_mk (u : P.SuperEnveloping p) :
    toTensor P p Λ (Submodule.Quotient.mk u) = tensorRep P p Λ u 1 := rfl

lemma toTensor_mk_fAlg (x : FreeAlgebra K ι) :
    toTensor P p Λ (Submodule.Quotient.mk (fAlg P p x)) = x := by
  rw [toTensor_mk, tensorRep_fAlg_one]

/-- The Verma module `M(Λ)` is identified with the tensor algebra `T(V)`, `u • v_Λ ↦ u • 1`
(cf. [Kac78] Prop. 2.1 (c)). -/
def toTensorEquiv : Verma P p Λ ≃ₗ[K] FreeAlgebra K ι :=
  LinearEquiv.ofBijective (toTensor P p Λ) <| by
    refine ⟨fun v w hvw ↦ ?_, fun x ↦ ⟨_, toTensor_mk_fAlg P p Λ x⟩⟩
    obtain ⟨u, rfl⟩ := Submodule.Quotient.mk_surjective _ v
    obtain ⟨u', rfl⟩ := Submodule.Quotient.mk_surjective _ w
    obtain ⟨x, hx⟩ := exists_sub_fAlg_mem_vermaIdeal P p Λ u
    obtain ⟨x', hx'⟩ := exists_sub_fAlg_mem_vermaIdeal P p Λ u'
    rw [← Submodule.Quotient.eq] at hx hx'
    rw [hx, hx', toTensor_mk_fAlg, toTensor_mk_fAlg] at hvw
    rw [hx, hx', hvw]

@[simp] lemma toTensorEquiv_mk (u : P.SuperEnveloping p) :
    toTensorEquiv P p Λ (Submodule.Quotient.mk u) = tensorRep P p Λ u 1 := rfl

@[simp] lemma toTensorEquiv_hwv : toTensorEquiv P p Λ (hwv P p Λ) = 1 := by
  simp [hwv]

/-- The map `T(V) → M(Λ)`, `x ↦ fAlg x • v_Λ`, is a linear isomorphism. -/
lemma toTensorEquiv_symm_apply (x : FreeAlgebra K ι) :
    (toTensorEquiv P p Λ).symm x = fAlg P p x • hwv P p Λ := by
  rw [LinearEquiv.symm_apply_eq, ← mk_eq_smul_hwv, toTensorEquiv_mk, tensorRep_fAlg_one]

end Verma

end SuperEnveloping

end Matrix.Realization

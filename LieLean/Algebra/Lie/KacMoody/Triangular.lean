import LieLean.Algebra.Lie.KacMoody.Basic
import Mathlib.Algebra.Lie.Abelian
import Mathlib.LinearAlgebra.Projection

/-!
# The triangular subalgebras of `𝔤(A)`

For a Kac–Moody algebra `𝔤 = 𝔤(A)` we define the Lie subalgebras `𝔫₋`, `𝔥`, `𝔫₊` and the Borel
subalgebra `𝔟 = 𝔥 ⊕ 𝔫₊` of the triangular decomposition `𝔤 = 𝔫₋ ⊕ 𝔥 ⊕ 𝔫₊` ([Kac] §1.3).

## Main definitions

* `Matrix.Realization.KacMoodyAlgebra.nNeg`, `nPos`: the Lie subalgebras `𝔫₋` and `𝔫₊`
  generated by the `fᵢ` and by the `eᵢ`.
* `Matrix.Realization.KacMoodyAlgebra.cartan`: the abelian Lie subalgebra `𝔥`.
* `Matrix.Realization.KacMoodyAlgebra.borel`: the Borel subalgebra `𝔟 = 𝔥 ⊕ 𝔫₊`.
* `Matrix.Realization.KacMoodyAlgebra.cartanProj`: the projection `𝔤 → 𝔥` along `𝔫₋ ⊕ 𝔫₊`.

## Main results

* `Matrix.Realization.KacMoodyAlgebra.isCompl_nNeg_borel`: `𝔤 = 𝔫₋ ⊕ 𝔟`.
* `Matrix.Realization.KacMoodyAlgebra.isCompl_range_h_nNeg_sup_nPos`: `𝔤 = 𝔥 ⊕ (𝔫₋ ⊕ 𝔫₊)`.
* `Matrix.Realization.KacMoodyAlgebra.nPos_toSubmodule_eq`,
  `Matrix.Realization.KacMoodyAlgebra.nNeg_toSubmodule_eq`: `𝔫₊ = ⊕_{α > 0} 𝔤_α` and
  `𝔫₋ = ⊕_{α > 0} 𝔤_{-α}`.
* `Matrix.Realization.KacMoodyAlgebra.lie_mem_nPos_of_mem_borel`: `[𝔟, 𝔟] ⊆ 𝔫₊`.

## References

* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §1.3.
-/

open Module LieModule

noncomputable section

namespace Matrix.Realization.KacMoodyAlgebra

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H)

/-- The Lie subalgebra `𝔫₋` of `𝔤(A)` generated by the `fᵢ` ([Kac] §1.3). -/
def nNeg : LieSubalgebra K P.KacMoodyAlgebra := (fHom P).range

/-- The Lie subalgebra `𝔫₊` of `𝔤(A)` generated by the `eᵢ` ([Kac] §1.3). -/
def nPos : LieSubalgebra K P.KacMoodyAlgebra := (eHom P).range

lemma mem_nNeg {x : P.KacMoodyAlgebra} : x ∈ nNeg P ↔ ∃ y, fHom P y = x := Iff.rfl

lemma mem_nPos {x : P.KacMoodyAlgebra} : x ∈ nPos P ↔ ∃ z, eHom P z = x := Iff.rfl

lemma f_mem_nNeg (i : ι) : f P i ∈ nNeg P := ⟨FreeLieAlgebra.of K i, fHom_of P i⟩

lemma e_mem_nPos (i : ι) : e P i ∈ nPos P := ⟨FreeLieAlgebra.of K i, eHom_of P i⟩

/-- `𝔫₋` is stable under `ad 𝔥`. -/
lemma lie_h_mem_nNeg (a : H) {x : P.KacMoodyAlgebra} (hx : x ∈ nNeg P) : ⁅h P a, x⁆ ∈ nNeg P := by
  obtain ⟨y, rfl⟩ := hx
  obtain ⟨y', hy'⟩ := AuxLieAlgebra.lie_h_fHom P a y
  exact ⟨y', show π P _ = ⁅h P a, π P _⁆ by
    rw [← π_h, ← LieHom.map_lie]; exact congrArg (π P) hy'.symm⟩

/-- `𝔫₊` is stable under `ad 𝔥`. -/
lemma lie_h_mem_nPos (a : H) {x : P.KacMoodyAlgebra} (hx : x ∈ nPos P) : ⁅h P a, x⁆ ∈ nPos P := by
  obtain ⟨z, rfl⟩ := hx
  obtain ⟨z', hz'⟩ := AuxLieAlgebra.lie_h_eHom P a z
  exact ⟨z', show π P _ = ⁅h P a, π P _⁆ by
    rw [← π_h, ← LieHom.map_lie]; exact congrArg (π P) hz'.symm⟩

/-- The abelian Lie subalgebra `𝔥 ⊆ 𝔤(A)`. -/
def cartan : LieSubalgebra K P.KacMoodyAlgebra :=
  { LinearMap.range (h P) with
    lie_mem' := by
      rintro _ _ ⟨a, rfl⟩ ⟨b, rfl⟩
      rw [lie_h_h]
      exact (LinearMap.range (h P)).zero_mem }

lemma mem_cartan {x : P.KacMoodyAlgebra} : x ∈ cartan P ↔ ∃ a, h P a = x := Iff.rfl

@[simp] lemma cartan_toSubmodule : (cartan P).toSubmodule = LinearMap.range (h P) := rfl

instance : IsLieAbelian (cartan P) := by
  refine ⟨fun ⟨x, hx⟩ ⟨y, hy⟩ ↦ ?_⟩
  obtain ⟨a, rfl⟩ := hx
  obtain ⟨b, rfl⟩ := hy
  exact Subtype.ext (lie_h_h P a b)

/-- `[𝔥 + 𝔫₊, 𝔥 + 𝔫₊] ⊆ 𝔫₊`. -/
lemma lie_mem_nPos_of_mem_sup {x y : P.KacMoodyAlgebra}
    (hx : x ∈ LinearMap.range (h P) ⊔ (nPos P).toSubmodule)
    (hy : y ∈ LinearMap.range (h P) ⊔ (nPos P).toSubmodule) : ⁅x, y⁆ ∈ nPos P := by
  obtain ⟨_, ⟨a, rfl⟩, n, hn, rfl⟩ := Submodule.mem_sup.mp hx
  obtain ⟨_, ⟨b, rfl⟩, n', hn', rfl⟩ := Submodule.mem_sup.mp hy
  rw [add_lie, lie_add, lie_add, lie_h_h, zero_add, ← lie_skew n (h P b)]
  exact add_mem (lie_h_mem_nPos P a hn') (add_mem (neg_mem (lie_h_mem_nPos P b hn))
    ((nPos P).lie_mem hn hn'))

/-- The Borel subalgebra `𝔟 = 𝔥 ⊕ 𝔫₊` of `𝔤(A)`. -/
def borel : LieSubalgebra K P.KacMoodyAlgebra where
  toSubmodule := LinearMap.range (h P) ⊔ (nPos P).toSubmodule
  lie_mem' hx hy := Submodule.mem_sup_right (lie_mem_nPos_of_mem_sup P hx hy)

@[simp] lemma borel_toSubmodule :
    (borel P).toSubmodule = LinearMap.range (h P) ⊔ (nPos P).toSubmodule := rfl

lemma mem_borel {x : P.KacMoodyAlgebra} :
    x ∈ borel P ↔ ∃ a, ∃ n ∈ nPos P, h P a + n = x := by
  change x ∈ LinearMap.range (h P) ⊔ (nPos P).toSubmodule ↔ _
  rw [Submodule.mem_sup]
  simp only [LinearMap.mem_range, exists_exists_eq_and]
  rfl

lemma h_mem_borel (a : H) : h P a ∈ borel P :=
  Submodule.mem_sup_left (LinearMap.mem_range_self _ a)

lemma nPos_le_borel : nPos P ≤ borel P := fun _ hx ↦ Submodule.mem_sup_right hx

lemma cartan_le_borel : cartan P ≤ borel P := fun _ hx ↦ Submodule.mem_sup_left hx

lemma e_mem_borel (i : ι) : e P i ∈ borel P := nPos_le_borel P (e_mem_nPos P i)

/-- `[𝔟, 𝔟] ⊆ 𝔫₊`. -/
lemma lie_mem_nPos_of_mem_borel {x y : P.KacMoodyAlgebra} (hx : x ∈ borel P)
    (hy : y ∈ borel P) : ⁅x, y⁆ ∈ nPos P :=
  lie_mem_nPos_of_mem_sup P hx hy

/-! ### Complements -/

variable [CharZero K]

/-- The triangular decomposition in the form `𝔤 = 𝔫₋ ⊕ 𝔟` ([Kac] §1.3). -/
theorem isCompl_nNeg_borel : IsCompl (nNeg P).toSubmodule (borel P).toSubmodule := by
  refine ⟨Submodule.disjoint_def.mpr fun x hx hx' ↦ ?_,
    Submodule.codisjoint_iff_exists_add_eq.mpr fun x ↦ ?_⟩
  · obtain ⟨y, rfl⟩ := hx
    obtain ⟨a, _, ⟨z, rfl⟩, hyz⟩ := (mem_borel P).mp hx'
    change h P a + eHom P z = fHom P y at hyz
    have := triangular_eq_zero P (y := y) (a := -a) (z := -z) (by
      rw [map_neg, map_neg, ← hyz]; abel)
    exact this.1
  · obtain ⟨y, a, z, rfl⟩ := exists_triangular P x
    exact ⟨fHom P y, h P a + eHom P z, ⟨y, rfl⟩, (mem_borel P).mpr ⟨a, _, ⟨z, rfl⟩, rfl⟩,
      (add_assoc _ _ _).symm⟩

/-- The triangular decomposition in the form `𝔤 = 𝔥 ⊕ (𝔫₋ ⊕ 𝔫₊)` ([Kac] §1.3). -/
theorem isCompl_range_h_nNeg_sup_nPos :
    IsCompl (LinearMap.range (h P)) ((nNeg P).toSubmodule ⊔ (nPos P).toSubmodule) := by
  refine ⟨Submodule.disjoint_def.mpr fun x hx hx' ↦ ?_,
    Submodule.codisjoint_iff_exists_add_eq.mpr fun x ↦ ?_⟩
  · obtain ⟨a, rfl⟩ := hx
    obtain ⟨_, ⟨y, rfl⟩, _, ⟨z, rfl⟩, hyz⟩ := Submodule.mem_sup.mp hx'
    change fHom P y + eHom P z = h P a at hyz
    have := triangular_eq_zero P (y := y) (a := -a) (z := z) (by
      rw [map_neg, add_right_comm, hyz, add_neg_cancel])
    rw [neg_eq_zero.mp this.2.1, map_zero]
  · obtain ⟨y, a, z, rfl⟩ := exists_triangular P x
    exact ⟨h P a, fHom P y + eHom P z, ⟨a, rfl⟩,
      Submodule.add_mem_sup ⟨y, rfl⟩ ⟨z, rfl⟩, by abel⟩

/-- The projection `𝔤 → 𝔥` along `𝔫₋ ⊕ 𝔫₊`. -/
def cartanProj : P.KacMoodyAlgebra →ₗ[K] H :=
  (LinearEquiv.ofInjective (h P) (h_injective P)).symm.toLinearMap ∘ₗ
    Submodule.projectionOnto _ _ (isCompl_range_h_nNeg_sup_nPos P)

@[simp] lemma cartanProj_h (a : H) : cartanProj P (h P a) = a := by
  rw [cartanProj, LinearMap.comp_apply, Submodule.projectionOnto_apply_of_mem_left _
    (LinearMap.mem_range_self _ a), LinearEquiv.coe_coe, LinearEquiv.symm_apply_eq]
  rfl

lemma cartanProj_eq_zero {x : P.KacMoodyAlgebra}
    (hx : x ∈ (nNeg P).toSubmodule ⊔ (nPos P).toSubmodule) : cartanProj P x = 0 := by
  rw [cartanProj, LinearMap.comp_apply, Submodule.projectionOnto_apply_of_mem_right _ hx,
    map_zero]

lemma cartanProj_of_mem_nNeg {x : P.KacMoodyAlgebra} (hx : x ∈ nNeg P) : cartanProj P x = 0 :=
  cartanProj_eq_zero P (Submodule.mem_sup_left hx)

lemma cartanProj_of_mem_nPos {x : P.KacMoodyAlgebra} (hx : x ∈ nPos P) : cartanProj P x = 0 :=
  cartanProj_eq_zero P (Submodule.mem_sup_right hx)

/-! ### Root space decompositions of `𝔫₊` and `𝔫₋` -/

/-- `𝔫₊ = ⊕_{α ∈ Q₊ \ 0} 𝔤_α` ([Kac] §1.3). -/
theorem nPos_toSubmodule_eq : (nPos P).toSubmodule = ⨆ μ ∈ P.posWeights, rootSpace P μ := by
  refine le_antisymm ?_ (iSup₂_le fun μ hμ ↦ ?_)
  · rintro _ ⟨z, rfl⟩
    have := Submodule.mem_map_of_mem (f := (π P).toLinearMap) (AuxLieAlgebra.eHom_mem P z)
    simp_rw [Submodule.map_iSup, ← rootSpace_eq_map] at this
    exact this
  · rw [rootSpace_eq_map]
    refine (Submodule.map_mono (AuxLieAlgebra.rootSpace_pos_le P hμ)).trans ?_
    rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
    exact ⟨z, rfl⟩

/-- `𝔫₋ = ⊕_{α ∈ Q₊ \ 0} 𝔤_{-α}` ([Kac] §1.3). -/
theorem nNeg_toSubmodule_eq : (nNeg P).toSubmodule = ⨆ μ ∈ P.negWeights, rootSpace P μ := by
  refine le_antisymm ?_ (iSup₂_le fun μ hμ ↦ ?_)
  · rintro _ ⟨y, rfl⟩
    have := Submodule.mem_map_of_mem (f := (π P).toLinearMap) (AuxLieAlgebra.fHom_mem P y)
    simp_rw [Submodule.map_iSup, ← rootSpace_eq_map] at this
    exact this
  · rw [rootSpace_eq_map]
    refine (Submodule.map_mono (AuxLieAlgebra.rootSpace_neg_le P hμ)).trans ?_
    rintro _ ⟨_, ⟨y, rfl⟩, rfl⟩
    exact ⟨y, rfl⟩

end Matrix.Realization.KacMoodyAlgebra

end

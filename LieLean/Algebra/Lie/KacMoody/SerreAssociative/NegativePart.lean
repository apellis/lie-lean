import LieLean.Algebra.Lie.KacMoody.GabberKac
import LieLean.Algebra.Lie.KacMoody.SerreAssociative
import LieLean.Algebra.Lie.UniversalEnveloping.TensorDecomposition

/-!
# The associative Serre algebra is `U(𝔫₋)`

Let `A` be a generalized Cartan matrix, `K` a field of characteristic zero and `(𝔥, Π, Π^∨)` a
realization of `A`. Let `𝔤̃ = 𝔤̃(A)`, with `𝔫̃₋ ⊆ 𝔤̃` the subalgebra freely generated by the `fᵢ`
(the image of the injective map `fHom : FreeLieAlgebra K ι → 𝔤̃`), and let `𝔰 ⊆ 𝔤̃` be the ideal
generated by the Serre elements `(ad eᵢ)^{1-aᵢⱼ} eⱼ`, `(ad fᵢ)^{1-aᵢⱼ} fⱼ` (`i ≠ j`).

**Theorem** (`Matrix.Realization.AuxLieAlgebra.fHom_mem_serreIdeal_iff`). `𝔰 ∩ 𝔫̃₋` is the ideal
of `𝔫̃₋ ≅ FreeLieAlgebra K ι` generated by the negative Serre elements. Consequently the negative
part `𝔫̂₋` of the Serre-presented algebra `𝔤̂(A) = 𝔤̃/𝔰` is the Lie algebra
`Matrix.SerreLieAlgebra K A` generated by the `fᵢ` subject to the Serre relations
(`Matrix.Realization.SerrePresentedAlgebra.serreLieAlgebraEquivRangeFHom`), and, if `A` is
symmetrizable, by the Gabber–Kac theorem ([Kac] Thm. 9.11) so is the negative part `𝔫₋` of
`𝔤(A)` (`Matrix.Realization.KacMoodyAlgebra.serreLieAlgebraEquivNNeg`). Taking enveloping algebras,
the associative Serre algebra is `U(𝔫₋)`, via `θᵢ ↦ fᵢ`
(`Matrix.Realization.KacMoodyAlgebra.serreAssocAlgebraEquiv`).

## Proof

This is the statement that the Serre relations `(ad fᵢ)^{1-aᵢⱼ} fⱼ = 0` are defining relations
of `𝔫̂₋` (cf. [Kac] §1.2–1.3, §9.11, where the analogous statement for `𝔯` is proved).
The argument is standard; it is reconstructed and written out here. Let `S₊` be the span of the
`ad e_{k₁} ⋯ ad e_{kₘ} (ad eᵢ)^{1-aᵢⱼ} eⱼ`. It is stable under `ad eₖ` (clearly), `ad 𝔥` (it is
spanned by weight vectors) and `ad fₖ` (since `[fₖ, (ad eᵢ)^{1-aᵢⱼ} eⱼ] = 0`, [Kac] §3.3),
so it is an ideal of `𝔤̃` contained in `𝔫̃₊`. Its image `ω(S₊)` under the Chevalley involution is
an ideal contained in `fHom(J)`, where `J` is the ideal of `FreeLieAlgebra K ι` generated by the
Lie Serre elements. As `S₊ + ω(S₊)` is an ideal containing all Serre elements, `𝔰 ⊆ S₊ + ω(S₊)`,
and by the triangular decomposition `𝔰 ∩ 𝔫̃₋ ⊆ ω(S₊) ⊆ fHom(J)`. The converse inclusion is clear.

## Main definitions

* `UniversalEnvelopingAlgebra.mapEquiv`: the isomorphism `U(L) ≃ U(L')` induced by an
  isomorphism of Lie algebras `L ≃ L'`.
* `Matrix.SerreLieAlgebra.equivRangeOfKerEq`: `𝔫̂(A) ≃ range φ` if `ker φ` is the Serre ideal.
* `Matrix.Realization.SerrePresentedAlgebra.serreLieAlgebraEquivRangeFHom`: `𝔫̂(A) ≃ 𝔫̂₋`.
* `Matrix.Realization.SerrePresentedAlgebra.serreAssocAlgebraEquiv`:
  `SerreAssocAlgebra K A ≃ₐ[K] U(𝔫̂₋)`, `θᵢ ↦ fᵢ` (any generalized Cartan matrix).
* `Matrix.Realization.KacMoodyAlgebra.serreLieAlgebraEquivNNeg`: `𝔫̂(A) ≃ 𝔫₋` (symmetrizable `A`).
* `Matrix.Realization.KacMoodyAlgebra.serreAssocAlgebraEquiv`:
  `SerreAssocAlgebra K A ≃ₐ[K] U(𝔫₋)`, `θᵢ ↦ fᵢ` (symmetrizable `A`).

## Main results

* `Matrix.Realization.AuxLieAlgebra.fHom_mem_serreIdeal_iff`: `fHom y ∈ 𝔰 ↔ y ∈ J`.
* `Matrix.Realization.SerrePresentedAlgebra.ker_fHom`: the kernel of `FreeLieAlgebra K ι → 𝔤̂(A)`
  is `J`.
* `Matrix.Realization.KacMoodyAlgebra.ker_fHom`: the kernel of `FreeLieAlgebra K ι → 𝔤(A)` is `J`,
  for symmetrizable `A` (Gabber–Kac).

## References

* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §1.2–1.3, §3.3,
  §9.11.
-/

open Module LieModule LieAlgebra

noncomputable section

/-! ### Enveloping algebras of isomorphic Lie algebras -/

namespace UniversalEnvelopingAlgebra

attribute [local instance 100] LieRing.ofAssociativeRing

variable {R L L' : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [LieRing L']
  [LieAlgebra R L']

/-- An isomorphism of Lie algebras `L ≃ L'` induces an isomorphism of algebras `U(L) ≃ U(L')`. -/
def mapEquiv (e : L ≃ₗ⁅R⁆ L') :
    UniversalEnvelopingAlgebra R L ≃ₐ[R] UniversalEnvelopingAlgebra R L' :=
  AlgEquiv.ofAlgHom (map e.toLieHom) (map e.symm.toLieHom)
    (hom_ext R (LieHom.ext fun x ↦ by
      change map _ (map _ (ι R x)) = ι R x
      rw [map_ι, map_ι]
      simp))
    (hom_ext R (LieHom.ext fun x ↦ by
      change map _ (map _ (ι R x)) = ι R x
      rw [map_ι, map_ι]
      simp))

@[simp] lemma mapEquiv_ι (e : L ≃ₗ⁅R⁆ L') (x : L) : mapEquiv e (ι R x) = ι R (e x) :=
  map_ι _ x

@[simp] lemma mapEquiv_symm_ι (e : L ≃ₗ⁅R⁆ L') (x : L') :
    (mapEquiv e).symm (ι R x) = ι R (e.symm x) :=
  map_ι _ x

end UniversalEnvelopingAlgebra

/-! ### The exponent in the Serre relations -/

/-- For a generalized Cartan matrix and `i ≠ j`, the exponent `max(-aᵢⱼ, 0) + 1` used in
`Matrix.serreAssocElem` and `Matrix.serreLieElem` is `1 - aᵢⱼ`. -/
lemma Matrix.IsGeneralizedCartan.toNat_neg_add_one {ι : Type*} {A : Matrix ι ι ℤ}
    (hA : A.IsGeneralizedCartan) {i j : ι} (hij : i ≠ j) :
    (-A i j).toNat + 1 = (1 - A i j).toNat := by
  have := hA.toNat_neg_eq hij
  omega

/-! ### Quotients of the free Lie algebra by the Serre ideal -/

namespace Matrix.SerreLieAlgebra

variable {ι K : Type*} [CommRing K] {A : Matrix ι ι ℤ} {L' : Type*} [LieRing L'] [LieAlgebra K L']

private lemma ker_rangeRestrict {L : Type*} [LieRing L] [LieAlgebra K L] (φ : L →ₗ⁅K⁆ L') :
    φ.rangeRestrict.ker = φ.ker := by
  ext x
  simp [LieHom.mem_ker, Subtype.ext_iff, LieHom.rangeRestrict_apply]

/-- If the kernel of a morphism of Lie algebras `φ` out of the free Lie algebra is the ideal
generated by the Lie Serre elements, then `𝔫̂(A)` is isomorphic to the range of `φ`. -/
def equivRangeOfKerEq (φ : FreeLieAlgebra K ι →ₗ⁅K⁆ L') (hφ : φ.ker = serreLieIdeal K A) :
    SerreLieAlgebra K A ≃ₗ⁅K⁆ φ.range :=
  LieEquiv.ofBijective (lift φ.rangeRestrict fun i j hij ↦ by
      rw [← LieHom.mem_ker, ker_rangeRestrict, hφ]
      exact LieSubmodule.subset_lieSpan ⟨i, j, hij, rfl⟩)
    ⟨fun x y hxy ↦ by
      obtain ⟨x, rfl⟩ := mkHom_surjective K A x
      obtain ⟨y, rfl⟩ := mkHom_surjective K A y
      rw [lift_mkHom, lift_mkHom, ← sub_eq_zero, ← map_sub, ← LieHom.mem_ker,
        ker_rangeRestrict, hφ] at hxy
      rw [← sub_eq_zero, ← map_sub, mkHom_eq_zero_iff]
      exact hxy,
    fun ⟨_, y, hy⟩ ↦ ⟨mkHom K A y, Subtype.ext hy⟩⟩

@[simp] lemma equivRangeOfKerEq_θ (φ : FreeLieAlgebra K ι →ₗ⁅K⁆ L')
    (hφ : φ.ker = serreLieIdeal K A) (i : ι) :
    (equivRangeOfKerEq φ hφ (θ K A i) : L') = φ (FreeLieAlgebra.of K i) :=
  rfl

end Matrix.SerreLieAlgebra

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H)

namespace AuxLieAlgebra

lemma fHom_serreLieElem (i j : ι) : fHom P (serreLieElem K A i j) = serreF P i j := by
  rw [serreLieElem, LieHom.map_ad_pow, fHom_of, fHom_of, serreF, pow_succ, Module.End.mul_apply,
    ad_apply]

lemma eHom_serreLieElem (i j : ι) : eHom P (serreLieElem K A i j) = serreE P i j := by
  rw [serreLieElem, LieHom.map_ad_pow, eHom_of, eHom_of, serreE_eq]

/-- The ideal generated by the Lie Serre elements maps into the Serre ideal `𝔰` of `𝔤̃(A)`. -/
lemma serreLieIdeal_le_comap_fHom : serreLieIdeal K A ≤ (serreIdeal P).comap (fHom P) := by
  rw [serreLieIdeal, LieSubmodule.lieSpan_le]
  rintro _ ⟨i, j, hij, rfl⟩
  rw [SetLike.mem_coe, LieIdeal.mem_comap, fHom_serreLieElem]
  exact LieSubmodule.subset_lieSpan ⟨i, j, hij, Or.inr rfl⟩

omit [Fintype ι] [DecidableEq ι] in
private lemma iSup_stable {M : Type*} [AddCommGroup M] [Module K M] {κ : Type*}
    {S : κ → Submodule K M} (T : M →ₗ[K] M) (hS : ∀ k, ∀ y ∈ S k, T y ∈ S k) :
    ∀ y ∈ ⨆ k, S k, T y ∈ ⨆ k, S k := by
  intro y hy
  refine Submodule.iSup_induction S (motive := fun y ↦ T y ∈ ⨆ k, S k) hy
    (fun k y hy ↦ Submodule.mem_iSup_of_mem k (hS k y hy)) (by simp) fun y z hy hz ↦ ?_
  rw [map_add]
  exact add_mem hy hz

/-- The span `S₊` of the `ad e_{k₁} ⋯ ad e_{kₘ} (ad eᵢ)^{1-aᵢⱼ} eⱼ`, `i ≠ j`. -/
def serreESpan : Submodule K P.AuxLieAlgebra :=
  ⨆ p : {p : ι × ι // p.1 ≠ p.2}, eSpan P (serreE P p.1.1 p.1.2)

lemma serreE_mem_serreESpan {i j : ι} (hij : i ≠ j) : serreE P i j ∈ serreESpan P :=
  Submodule.mem_iSup_of_mem (⟨(i, j), hij⟩ : {p : ι × ι // p.1 ≠ p.2})
    (Submodule.subset_span ⟨[], rfl⟩)

lemma serreESpan_le_range_eHom :
    serreESpan P ≤ LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) :=
  iSup_le fun _ ↦ eSpan_le_range_eHom P (serreE_mem_range_eHom P _ _)

/-- The image of `S₊` under the Chevalley involution lies in the image under `fHom` of the ideal
generated by the Lie Serre elements. -/
lemma map_chevalleyInvolution_serreESpan_le :
    (serreESpan P).map (chevalleyInvolution P : P.AuxLieAlgebra →ₗ[K] P.AuxLieAlgebra) ≤
      (serreLieIdeal K A).toSubmodule.map
        (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) := by
  rw [serreESpan, Submodule.map_iSup, iSup_le_iff]
  rintro ⟨⟨i, j⟩, hij⟩
  rw [eSpan, Submodule.map_span, Submodule.span_le]
  rintro _ ⟨_, ⟨l, rfl⟩, rfl⟩
  induction l with
  | nil =>
    refine ⟨(-1 : K) ^ (-A i j).toNat • serreLieElem K A i j,
      (serreLieIdeal K A).smul_mem _ (LieSubmodule.subset_lieSpan ⟨i, j, hij, rfl⟩), ?_⟩
    simp [fHom_serreLieElem, chevalleyInvolution_serreE]
  | cons k l ih =>
    obtain ⟨y, hy, hy'⟩ := ih
    refine ⟨-⁅FreeLieAlgebra.of K k, y⁆, neg_mem ((serreLieIdeal K A).lie_mem hy), ?_⟩
    have hy'' : fHom P y = chevalleyInvolution P (adProd (l.map (e P)) (serreE P i j)) := hy'
    simp [hy'']

variable [CharZero K] (hA : A.IsGeneralizedCartan)
include hA

/-- `S₊` is an ideal of `𝔤̃(A)`. -/
def serreEIdeal : LieIdeal K P.AuxLieAlgebra :=
  idealOfGenerators (serreESpan P)
    (fun i ↦ iSup_stable (ad K _ (e P i)) fun _ ↦ lie_e_mem_eSpan P _ i)
    (fun i ↦ iSup_stable (ad K _ (f P i)) fun p ↦
      lie_f_mem_eSpan P (serreE_mem_rootSpace P _ _) (fun k ↦ lie_f_serreE P hA p.2 k) i)
    (fun a ↦ iSup_stable (ad K _ (h P a)) fun _ ↦
      lie_h_mem_eSpan P (serreE_mem_rootSpace P _ _) a)

omit hA [CharZero K] in
lemma serreF_eq_smul (i j : ι) :
    serreF P i j = (-1 : K) ^ (-A i j).toNat • chevalleyInvolution P (serreE P i j) := by
  rw [chevalleyInvolution_serreE, smul_smul, ← mul_pow, neg_one_mul, neg_neg, one_pow, one_smul]

/-- **The Serre relations generate the relations of `𝔫̂₋`**: for `y` in the free Lie algebra,
`fHom y` lies in the Serre ideal `𝔰` of `𝔤̃(A)` iff `y` lies in the ideal generated by the Lie
Serre elements `(ad fᵢ)^{1-aᵢⱼ} fⱼ`. (Standard; reconstructed, see the module docstring.) -/
theorem fHom_mem_serreIdeal_iff {y : FreeLieAlgebra K ι} :
    fHom P y ∈ serreIdeal P ↔ y ∈ serreLieIdeal K A := by
  refine ⟨fun hy ↦ ?_, fun hy ↦ serreLieIdeal_le_comap_fHom P hy⟩
  have hω : Function.Surjective (chevalleyInvolution P) := fun x ↦
    ⟨chevalleyInvolution P x, chevalleyInvolution_chevalleyInvolution P x⟩
  have hle : serreIdeal P ≤ serreEIdeal P hA ⊔ (serreEIdeal P hA).map (chevalleyInvolution P) := by
    rw [serreIdeal, LieSubmodule.lieSpan_le]
    rintro _ ⟨i, j, hij, rfl | rfl⟩
    · exact LieSubmodule.mem_sup_left (serreE_mem_serreESpan P hij)
    · refine LieSubmodule.mem_sup_right ?_
      rw [serreF_eq_smul]
      exact Submodule.smul_mem (LieSubmodule.toSubmodule _) _
        (LieIdeal.mem_map (serreE_mem_serreESpan P hij))
  have hx := hle hy
  rw [← LieSubmodule.mem_toSubmodule, LieSubmodule.sup_toSubmodule,
    LieIdeal.coe_map_of_surjective hω, Submodule.mem_sup] at hx
  obtain ⟨a, ha, b, hb, hab⟩ := hx
  obtain ⟨y', hy', rfl⟩ := map_chevalleyInvolution_serreESpan_le P hb
  have ha0 : a = 0 := by
    have hmem : a ∈ LinearMap.range (fHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) ⊓
        LinearMap.range (eHom P : FreeLieAlgebra K ι →ₗ[K] P.AuxLieAlgebra) :=
      ⟨⟨y - y', by rw [LieHom.coe_toLinearMap, map_sub, ← hab]; simp⟩,
        serreESpan_le_range_eHom P ha⟩
    rwa [range_fHom_inf_range_eHom, Submodule.mem_bot] at hmem
  rw [ha0, zero_add] at hab
  exact fHom_injective P hab ▸ hy'

/-- The preimage of the Serre ideal `𝔰` under `fHom : FreeLieAlgebra K ι → 𝔤̃(A)` is the ideal
generated by the Lie Serre elements. -/
theorem comap_fHom_serreIdeal : (serreIdeal P).comap (fHom P) = serreLieIdeal K A := by
  ext y
  rw [LieIdeal.mem_comap, fHom_mem_serreIdeal_iff P hA]

end AuxLieAlgebra

namespace SerrePresentedAlgebra

variable [CharZero K] (hA : A.IsGeneralizedCartan)
include hA

/-- The kernel of `FreeLieAlgebra K ι → 𝔤̂(A)`, `θᵢ ↦ fᵢ`, is the ideal generated by the Lie
Serre elements. -/
theorem ker_fHom : (fHom P).ker = serreLieIdeal K A := by
  ext y
  rw [LieHom.mem_ker, ← π_fHom, π_eq_zero_iff, AuxLieAlgebra.fHom_mem_serreIdeal_iff P hA]

/-- **The negative part `𝔫̂₋` of the Serre-presented algebra `𝔤̂(A)` is presented by the Serre
relations**: it is isomorphic to `𝔫̂(A)`, via `θᵢ ↦ fᵢ`. -/
def serreLieAlgebraEquivRangeFHom : SerreLieAlgebra K A ≃ₗ⁅K⁆ (fHom P).range :=
  SerreLieAlgebra.equivRangeOfKerEq (fHom P) (ker_fHom P hA)

@[simp] lemma serreLieAlgebraEquivRangeFHom_θ (i : ι) :
    (serreLieAlgebraEquivRangeFHom P hA (SerreLieAlgebra.θ K A i) : P.SerrePresentedAlgebra) =
      f P i :=
  fHom_of P i

/-- The associative Serre algebra is the enveloping algebra of the negative part `𝔫̂₋` of the
Serre-presented algebra `𝔤̂(A)`, via `θᵢ ↦ fᵢ`. -/
def serreAssocAlgebraEquiv :
    SerreAssocAlgebra K A ≃ₐ[K] UniversalEnvelopingAlgebra K (fHom P).range :=
  (SerreAssocAlgebra.equivUniversalEnveloping K A).trans
    (UniversalEnvelopingAlgebra.mapEquiv (serreLieAlgebraEquivRangeFHom P hA))

@[simp] lemma serreAssocAlgebraEquiv_θ (i : ι) :
    serreAssocAlgebraEquiv P hA (SerreAssocAlgebra.θ K A i) =
      UniversalEnvelopingAlgebra.ι K ⟨f P i, FreeLieAlgebra.of K i, fHom_of P i⟩ := by
  rw [serreAssocAlgebraEquiv, AlgEquiv.trans_apply,
    SerreAssocAlgebra.equivUniversalEnveloping_θ, UniversalEnvelopingAlgebra.mapEquiv_ι]
  exact congrArg _ (Subtype.ext (fHom_of P i))

end SerrePresentedAlgebra

namespace KacMoodyAlgebra

variable [CharZero K] (hA : A.IsGeneralizedCartan) (hS : A.IsSymmetrizable)
include hA hS

/-- For a symmetrizable generalized Cartan matrix, the kernel of `FreeLieAlgebra K ι → 𝔤(A)`,
`θᵢ ↦ fᵢ`, is the ideal generated by the Lie Serre elements (by the Gabber–Kac theorem,
[Kac] Thm. 9.11). -/
theorem ker_fHom : (fHom P).ker = serreLieIdeal K A := by
  ext y
  change π P (AuxLieAlgebra.fHom P y) = 0 ↔ _
  rw [π_eq_zero_iff, AuxLieAlgebra.maxIdeal_eq_serreIdeal P hA hS,
    AuxLieAlgebra.fHom_mem_serreIdeal_iff P hA]

/-- **The negative part `𝔫₋` of `𝔤(A)` is presented by the Serre relations** ([Kac] Thm. 9.11,
Gabber–Kac): for a symmetrizable generalized Cartan matrix `A`, `𝔫₋` is isomorphic to the Lie
algebra `𝔫̂(A)` generated by elements `θᵢ` subject to `(ad θᵢ)^{1-aᵢⱼ} θⱼ = 0` (`i ≠ j`), via
`θᵢ ↦ fᵢ`. -/
def serreLieAlgebraEquivNNeg : SerreLieAlgebra K A ≃ₗ⁅K⁆ nNeg P :=
  SerreLieAlgebra.equivRangeOfKerEq (fHom P) (ker_fHom P hA hS)

@[simp] lemma serreLieAlgebraEquivNNeg_θ (i : ι) :
    (serreLieAlgebraEquivNNeg P hA hS (SerreLieAlgebra.θ K A i) : P.KacMoodyAlgebra) = f P i :=
  fHom_of P i

/-- **The associative Serre algebra is `U(𝔫₋)`** ([Kac] Thm. 9.11, Gabber–Kac): for a
symmetrizable generalized Cartan matrix `A` over a field of characteristic zero and any
realization of `A`, the algebra generated by elements `θᵢ` subject to the associative Serre
relations `∑_{r+s=1-aᵢⱼ} (-1)^r (1-aᵢⱼ choose r) θᵢ^r θⱼ θᵢ^s = 0` (`i ≠ j`) is isomorphic to the
enveloping algebra of the negative part `𝔫₋` of `𝔤(A)`, via `θᵢ ↦ fᵢ`. -/
def serreAssocAlgebraEquiv : SerreAssocAlgebra K A ≃ₐ[K] UniversalEnvelopingAlgebra K (nNeg P) :=
  (SerreAssocAlgebra.equivUniversalEnveloping K A).trans
    (UniversalEnvelopingAlgebra.mapEquiv (serreLieAlgebraEquivNNeg P hA hS))

@[simp] lemma serreAssocAlgebraEquiv_θ (i : ι) :
    serreAssocAlgebraEquiv P hA hS (SerreAssocAlgebra.θ K A i) =
      UniversalEnvelopingAlgebra.ι K ⟨f P i, f_mem_nNeg P i⟩ := by
  rw [serreAssocAlgebraEquiv, AlgEquiv.trans_apply,
    SerreAssocAlgebra.equivUniversalEnveloping_θ, UniversalEnvelopingAlgebra.mapEquiv_ι]
  exact congrArg _ (Subtype.ext (fHom_of P i))

@[simp] lemma serreAssocAlgebraEquiv_symm_ι_f (i : ι) :
    (serreAssocAlgebraEquiv P hA hS).symm
        (UniversalEnvelopingAlgebra.ι K ⟨f P i, f_mem_nNeg P i⟩) =
      SerreAssocAlgebra.θ K A i := by
  rw [AlgEquiv.symm_apply_eq, serreAssocAlgebraEquiv_θ]

end KacMoodyAlgebra

end Matrix.Realization

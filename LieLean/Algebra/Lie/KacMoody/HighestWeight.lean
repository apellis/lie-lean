import LieLean.Algebra.Lie.KacMoody.CategoryO
import LieLean.Algebra.Lie.KacMoody.IntegrableWeyl
import LieLean.Algebra.Lie.LocallyNilpotent

/-!
# Integrable highest-weight modules

Let `A` be a generalized Cartan matrix, `K` a field of characteristic zero and `𝔤 = 𝔤(A)` the
Kac–Moody algebra. A weight `Λ ∈ 𝔥*` is *dominant integral* if `⟨Λ, αᵢ^∨⟩ ∈ ℕ` for all `i`. For
such `Λ`, with `nᵢ = ⟨Λ, αᵢ^∨⟩`, the vectors `fᵢ^{nᵢ+1} v_Λ` of the Verma module `M(Λ)` are
*singular*: they are killed by all `eⱼ`. Let `L̃(Λ)` be the quotient of `M(Λ)` by the submodule
generated by these vectors. We show that `L̃(Λ)` is integrable, and that `L(Λ)` is a quotient of
`L̃(Λ)`; hence `L(Λ)` is integrable. Conversely, if `L(Λ)` is integrable then `Λ` is dominant
integral ([Kac] Lemma 10.1).

## Main definitions

* `Matrix.Realization.IsDominantIntegral`: `⟨Λ, αᵢ^∨⟩ ∈ ℕ` for all `i`.
* `Matrix.Realization.KacMoodyAlgebra.VermaModule.fPowHwv`: the vector `fᵢ^{n+1} v_Λ` of `M(Λ)`.
* `Matrix.Realization.KacMoodyAlgebra.VermaModule.fPowSubmodule`: the submodule of `M(Λ)`
  generated by the vectors `fᵢ^{nᵢ+1} v_Λ`.
* `Matrix.Realization.KacMoodyAlgebra.FPowQuotient`: the quotient
  `L̃(Λ) = M(Λ) / ∑ᵢ U(𝔤) fᵢ^{nᵢ+1} v_Λ`.
* `Matrix.Realization.KacMoodyAlgebra.FPowQuotient.toIrreducibleModule`: the canonical
  surjection `L̃(Λ) → L(Λ)`.

## Main results

* `Matrix.Realization.KacMoodyAlgebra.VermaModule.lie_e_fPowHwv`: if `⟨Λ, αᵢ^∨⟩ = n ∈ ℕ`, then
  `fᵢ^{n+1} v_Λ` is killed by all `eⱼ`; it has weight `Λ - (n + 1) αᵢ`
  (`VermaModule.fPowHwv_mem_weightSpace`).
* `Matrix.Realization.KacMoodyAlgebra.VermaModule.fPowSubmodule_le_maxSubmodule`: these vectors
  lie in the maximal proper submodule of `M(Λ)`.
* `Matrix.Realization.KacMoodyAlgebra.isIntegrable_of_surjective`: a quotient of `M(Λ)` in which
  each `fᵢ` is nilpotent on the image of `v_Λ` is integrable.
* `Matrix.Realization.KacMoodyAlgebra.FPowQuotient.isIntegrable`: `L̃(Λ)` is integrable
  ([Kac] §10.1, remark before Lemma 10.1).
* `Matrix.Realization.KacMoodyAlgebra.isDominantIntegral_of_isIntegrable`: if an integrable
  module has a nonzero vector of weight `Λ` killed by all `eᵢ`, then `Λ` is dominant integral.
* `Matrix.Realization.KacMoodyAlgebra.IrreducibleModule.isIntegrable_iff`: `L(Λ)` is integrable
  iff `Λ` is dominant integral ([Kac] Lemma 10.1).

## Proof

The argument is the one of [Kac] §10.1, written out here as follows. For `j ≠ i`,
`eⱼ` commutes with `fᵢ` and kills `v_Λ`; and `eᵢ fᵢ^{n+1} v_Λ = (n + 1)(⟨Λ, αᵢ^∨⟩ - n) fᵢⁿ v_Λ`
by `𝔰𝔩₂`-theory (`IsSl2Triple.lie_e_pow_succ_toEnd_f_of_lie_h`). A vector `w ∈ M(Λ)` of weight
`μ` killed by all `eⱼ` is killed by `𝔫₊`, so it is the image of `v_μ` under a morphism
`M(μ) → M(Λ)`; the weights of its image lie in `μ - Q₊`, which does not contain `Λ` if
`μ = Λ - (n + 1) αᵢ`, so the image is proper and lies in the maximal proper submodule.

A quotient `V` of `M(Λ)` is generated by the image `v` of `v_Λ`. Since `ad eᵢ` and `ad fᵢ` are
locally nilpotent on `𝔤` (`isIntegrable_adjoint`), `eᵢ` (resp. `fᵢ`) acts locally nilpotently on
`V` as soon as it is nilpotent on `v` (`LieModule.exists_toEnd_pow_eq_zero_of_lieSpan`,
[Kac] Lemma 3.4 (b)). As `eᵢ v = 0` and, in `L̃(Λ)`, `fᵢ^{nᵢ+1} v = 0`, this gives
integrability; `𝔥`-diagonalizability holds for all quotients of `M(Λ)`.

Conversely, if `v ≠ 0` has weight `Λ`, is killed by `eᵢ` and `fᵢᵐ v = 0`, then by `𝔰𝔩₂`-theory
`0 = eᵢᵐ fᵢᵐ v = ∏_{j < m} (j + 1)(⟨Λ, αᵢ^∨⟩ - j) v`, so `⟨Λ, αᵢ^∨⟩ ∈ ℕ`.

## References

* [Kac] V. G. Kac, *Infinite dimensional Lie algebras*, 3rd ed., CUP 1990, §3.4, §9.2, §10.1.
-/

open Module LieModule LieAlgebra

noncomputable section

namespace Matrix.Realization

variable {ι K H : Type*} [Fintype ι] [DecidableEq ι] [Field K] [AddCommGroup H] [Module K H]
  {A : Matrix ι ι ℤ} (P : Realization A K H)

/-- A weight `Λ ∈ 𝔥*` is dominant integral if `⟨Λ, αᵢ^∨⟩ ∈ ℕ` for all `i` ([Kac] §10.1). -/
def IsDominantIntegral (Λ : Dual K H) : Prop := ∀ i, ∃ n : ℕ, Λ (P.coroot i) = n

namespace KacMoodyAlgebra

section Module

variable {P} {V : Type*} [AddCommGroup V] [Module K V] [LieRingModule P.KacMoodyAlgebra V]
  [LieModule K P.KacMoodyAlgebra V]

/-- A vector killed by all the `eᵢ` is killed by `𝔫₊`. -/
lemma lie_eq_zero_of_mem_nPos {v : V} (he : ∀ i, ⁅e P i, v⁆ = 0) {x : P.KacMoodyAlgebra}
    (hx : x ∈ nPos P) : ⁅x, v⁆ = 0 := by
  obtain ⟨y, rfl⟩ := (mem_nPos P).mp hx
  clear hx
  induction y using FreeLieAlgebra.induction_on with
  | of i => rw [eHom_of]; exact he i
  | zero => simp
  | add y z hy hz => rw [map_add, add_lie, hy, hz, add_zero]
  | smul a y hy => rw [map_smul, smul_lie, hy, smul_zero]
  | lie y z hy hz => rw [LieHom.map_lie, lie_lie, hy, hz, lie_zero, lie_zero, sub_zero]

/-- If `[x, y] = 0`, then `x` commutes with the powers of the action of `y`. -/
lemma lie_toEnd_pow_of_lie_eq_zero {x y : P.KacMoodyAlgebra} (hxy : ⁅x, y⁆ = 0) (m : ℕ) (v : V) :
    ⁅x, (toEnd K P.KacMoodyAlgebra V y ^ m) v⁆ = (toEnd K P.KacMoodyAlgebra V y ^ m) ⁅x, v⁆ := by
  induction m with
  | zero => simp
  | succ m ih =>
    rw [pow_succ', Module.End.mul_apply, Module.End.mul_apply, toEnd_apply_apply,
      toEnd_apply_apply, leibniz_lie, hxy, zero_lie, zero_add, ih]

omit [LieModule K P.KacMoodyAlgebra V] in
/-- The image of a morphism `M(Λ) → V` is the submodule generated by the image of `v_Λ`. -/
lemma VermaModule.range_eq_lieSpan {Λ : Dual K H}
    (φ : VermaModule P Λ →ₗ⁅K,P.KacMoodyAlgebra⁆ V) :
    φ.range = LieSubmodule.lieSpan K P.KacMoodyAlgebra {φ (VermaModule.hwv P Λ)} := by
  refine le_antisymm ?_ (LieSubmodule.lieSpan_le.mpr (by
    rintro _ rfl
    exact (LieModuleHom.mem_range φ _).mpr ⟨_, rfl⟩))
  have : (LieSubmodule.lieSpan K P.KacMoodyAlgebra {φ (VermaModule.hwv P Λ)}).comap φ = ⊤ :=
    VermaModule.eq_top_of_hwv_mem P Λ (LieSubmodule.subset_lieSpan rfl)
  rintro _ ⟨m, rfl⟩
  have hm : m ∈ (LieSubmodule.lieSpan K P.KacMoodyAlgebra {φ (VermaModule.hwv P Λ)}).comap φ :=
    this ▸ LieSubmodule.mem_top m
  exact hm

omit [LieModule K P.KacMoodyAlgebra V] in
/-- A quotient of `M(Λ)` is generated by the image of `v_Λ`. -/
lemma VermaModule.lieSpan_map_hwv_eq_top {Λ : Dual K H}
    (φ : VermaModule P Λ →ₗ⁅K,P.KacMoodyAlgebra⁆ V) (hφ : Function.Surjective φ) :
    LieSubmodule.lieSpan K P.KacMoodyAlgebra {φ (VermaModule.hwv P Λ)} = ⊤ := by
  rw [← VermaModule.range_eq_lieSpan, LieModuleHom.range_eq_top]
  exact hφ

variable [CharZero K] (hA : A.IsGeneralizedCartan)
include hA

/-- A quotient `V` of `M(Λ)` in which each `fᵢ` acts nilpotently on the image of `v_Λ` is
integrable ([Kac] §10.1). -/
theorem isIntegrable_of_surjective {Λ : Dual K H} (φ : VermaModule P Λ →ₗ⁅K,P.KacMoodyAlgebra⁆ V)
    (hφ : Function.Surjective φ)
    (hf : ∀ i, ∃ m, (toEnd K P.KacMoodyAlgebra V (f P i) ^ m) (φ (VermaModule.hwv P Λ)) = 0) :
    IsIntegrable P V where
  isHDiagonalizable := (IsCategoryO.of_surjective φ hφ).iSup_weightSpaceOfMap_eq_top
  exists_pow_e_eq_zero i := exists_toEnd_pow_eq_zero_of_lieSpan (exists_ad_e_pow_eq_zero P hA i)
    (VermaModule.lieSpan_map_hwv_eq_top φ hφ) (by
      rintro _ rfl
      refine ⟨1, ?_⟩
      rw [pow_one, toEnd_apply_apply, ← LieModuleHom.map_lie, VermaModule.lie_e_hwv, map_zero])
  exists_pow_f_eq_zero i := exists_toEnd_pow_eq_zero_of_lieSpan (exists_ad_f_pow_eq_zero P hA i)
    (VermaModule.lieSpan_map_hwv_eq_top φ hφ) (by rintro _ rfl; exact hf i)

/-- If an integrable module `V` has a nonzero vector of weight `Λ` killed by all the `eᵢ`, then
`Λ` is dominant integral ([Kac] (3.2.4), as in the proof of Lemma 10.1). -/
theorem isDominantIntegral_of_isIntegrable (hV : IsIntegrable P V) {Λ : Dual K H} {v : V}
    (hv : v ∈ weightSpace P V Λ) (he : ∀ i, ⁅e P i, v⁆ = 0) (hv0 : v ≠ 0) :
    P.IsDominantIntegral Λ := fun i ↦ by
  obtain ⟨m, hm⟩ := hV.exists_pow_f_eq_zero i v
  exact IsSl2Triple.HasPrimitiveVectorWith.exists_nat_of_exists_pow_eq_zero
    (t := isSl2Triple P hA i) ⟨hv0, hv _, he i⟩ ⟨m, hm⟩

end Module

namespace VermaModule

variable [CharZero K] (Λ : Dual K H)

/-- A vector `w ∈ M(Λ)` of weight `μ`, killed by all the `eⱼ`, lies in the maximal proper
submodule of `M(Λ)` if `Λ ∉ μ - Q₊`. -/
theorem mem_maxSubmodule_of_lie_e_eq_zero {μ : Dual K H} {w : VermaModule P Λ}
    (hw : w ∈ weightSpace P Λ μ) (he : ∀ j, ⁅e P j, w⁆ = 0) (hμ : Λ ∉ cone P μ) :
    w ∈ maxSubmodule P Λ := by
  let φ := lift P w (fun _ hx ↦ lie_eq_zero_of_mem_nPos he hx) hw
  have hle : φ.range ≤ maxSubmodule P Λ := by
    rw [le_maxSubmodule_iff]
    intro htop
    rw [LieModuleHom.range_eq_top] at htop
    exact hμ (exists_eq_sub_of_mem_weightSpace P μ φ htop (hwv_mem_weightSpace P Λ)
      (hwv_ne_zero P Λ))
  exact hle ((LieModuleHom.mem_range φ w).mpr ⟨hwv P μ, lift_hwv P w _ _⟩)

/-- The vector `fᵢ^{n+1} v_Λ` of `M(Λ)`. -/
abbrev fPowHwv (i : ι) (n : ℕ) : VermaModule P Λ :=
  (toEnd K P.KacMoodyAlgebra (VermaModule P Λ) (f P i) ^ (n + 1)) (hwv P Λ)

omit [CharZero K] in
/-- `fᵢ^{n+1} v_Λ` has weight `Λ - (n + 1) αᵢ`. -/
lemma fPowHwv_mem_weightSpace (i : ι) (n : ℕ) :
    fPowHwv P Λ i n ∈ weightSpace P Λ (Λ - (n + 1) • P.root i) :=
  toEnd_f_pow_mem_weightSpace i (hwv_mem_weightSpace P Λ) (n + 1)

variable (hA : A.IsGeneralizedCartan)
include hA

/-- **Singular vectors** ([Kac] §10.1): if `⟨Λ, αᵢ^∨⟩ = n ∈ ℕ`, then `fᵢ^{n+1} v_Λ` is
killed by all `eⱼ`. -/
theorem lie_e_fPowHwv {i : ι} {n : ℕ} (hn : Λ (P.coroot i) = n) (j : ι) :
    ⁅e P j, fPowHwv P Λ i n⁆ = 0 := by
  by_cases hij : j = i
  · subst hij
    rw [(isSl2Triple P hA j).lie_e_pow_succ_toEnd_f_of_lie_h n (lie_h_hwv P Λ _), lie_e_hwv,
      map_zero, zero_add, hn, sub_self, mul_zero, zero_smul]
  · rw [lie_toEnd_pow_of_lie_eq_zero (lie_e_f_of_ne P hij), lie_e_hwv, map_zero]

/-- If `⟨Λ, αᵢ^∨⟩ = n ∈ ℕ`, the singular vector `fᵢ^{n+1} v_Λ` lies in the maximal proper
submodule of `M(Λ)` ([Kac] §10.1). -/
theorem fPowHwv_mem_maxSubmodule {i : ι} {n : ℕ} (hn : Λ (P.coroot i) = n) :
    fPowHwv P Λ i n ∈ maxSubmodule P Λ := by
  refine mem_maxSubmodule_of_lie_e_eq_zero P Λ (fPowHwv_mem_weightSpace P Λ i n)
    (lie_e_fPowHwv P Λ hA hn) ?_
  rintro ⟨k, hk, hΛ⟩
  have h0 : P.rootOf ((n + 1 : ℕ) • Pi.single i 1 + k) = 0 := by
    rw [map_add, map_nsmul, rootOf_single]
    rw [eq_sub_iff_add_eq] at hΛ
    rw [← sub_eq_zero] at hΛ
    rw [← hΛ]
    abel
  have h1 := congrFun (P.rootOf_injective (h0.trans (map_zero _).symm)) i
  have h2 := hk i
  rw [Pi.add_apply, Pi.smul_apply, Pi.single_eq_same, nsmul_eq_mul, mul_one,
    Pi.zero_apply] at h1
  rw [Pi.zero_apply] at h2
  push_cast at h1
  linarith

/-- The submodule of `M(Λ)` generated by the vectors `fᵢ^{nᵢ+1} v_Λ`. By `VermaModule.smul_mem` it
is also the sum of the `U(𝔤) fᵢ^{nᵢ+1} v_Λ`. -/
def fPowSubmodule (n : ι → ℕ) : LieSubmodule K P.KacMoodyAlgebra (VermaModule P Λ) :=
  LieSubmodule.lieSpan K P.KacMoodyAlgebra (Set.range fun i ↦ fPowHwv P Λ i (n i))

/-- If `⟨Λ, αᵢ^∨⟩ = nᵢ ∈ ℕ` for all `i`, the submodule generated by the vectors `fᵢ^{nᵢ+1} v_Λ` is
a proper submodule of `M(Λ)` ([Kac] §10.1). -/
theorem fPowSubmodule_le_maxSubmodule {n : ι → ℕ} (hn : ∀ i, Λ (P.coroot i) = n i) :
    fPowSubmodule P Λ n ≤ maxSubmodule P Λ :=
  LieSubmodule.lieSpan_le.mpr (by
    rintro _ ⟨i, rfl⟩
    exact fPowHwv_mem_maxSubmodule P Λ hA (hn i))

end VermaModule

/-- The quotient `L̃(Λ) = M(Λ) / ∑ᵢ U(𝔤) fᵢ^{nᵢ+1} v_Λ` of the Verma module. For `Λ` dominant
integral and `nᵢ = ⟨Λ, αᵢ^∨⟩` it is integrable (`FPowQuotient.isIntegrable`); by [Kac]
Cor. 10.4 it is then isomorphic to `L(Λ)` if `A` is symmetrizable. -/
abbrev FPowQuotient (Λ : Dual K H) (n : ι → ℕ) : Type _ :=
  VermaModule P Λ ⧸ VermaModule.fPowSubmodule P Λ n

namespace FPowQuotient

variable (Λ : Dual K H) (n : ι → ℕ)

/-- The highest-weight vector of `L̃(Λ)`, the image of `v_Λ`. -/
def hwv : FPowQuotient P Λ n :=
  LieSubmodule.Quotient.mk' _ (VermaModule.hwv P Λ)

lemma hwv_mem_weightSpace : hwv P Λ n ∈ weightSpace P (FPowQuotient P Λ n) Λ :=
  map_mem_weightSpaceOfMap P _ (VermaModule.hwv_mem_weightSpace P Λ)

@[simp] lemma lie_e_hwv (i : ι) : ⁅e P i, hwv P Λ n⁆ = 0 := by
  rw [hwv, ← LieModuleHom.map_lie, VermaModule.lie_e_hwv, map_zero]

/-- `fᵢ^{nᵢ+1}` kills the highest-weight vector of `L̃(Λ)`. -/
lemma toEnd_f_pow_hwv (i : ι) :
    (toEnd K P.KacMoodyAlgebra (FPowQuotient P Λ n) (f P i) ^ (n i + 1)) (hwv P Λ n) = 0 := by
  rw [hwv, toEnd_pow_apply_map, LieSubmodule.Quotient.mk_eq_zero]
  exact LieSubmodule.subset_lieSpan ⟨i, rfl⟩

variable [CharZero K]

/-- `L̃(Λ)` lies in the category `𝒪`. -/
theorem isCategoryO : IsCategoryO P (FPowQuotient P Λ n) :=
  .of_surjective (LieSubmodule.Quotient.mk' _) (LieSubmodule.Quotient.surjective_mk' _)

variable (hA : A.IsGeneralizedCartan)
include hA

/-- `L̃(Λ)` is integrable ([Kac] §10.1, remark before Lemma 10.1). This holds for
every `n : ι → ℕ`; it is of
interest when `nᵢ = ⟨Λ, αᵢ^∨⟩`. -/
theorem isIntegrable : IsIntegrable P (FPowQuotient P Λ n) :=
  isIntegrable_of_surjective hA (LieSubmodule.Quotient.mk' _)
    (LieSubmodule.Quotient.surjective_mk' _) fun i ↦ ⟨n i + 1, toEnd_f_pow_hwv P Λ n i⟩

variable {Λ n} (hn : ∀ i, Λ (P.coroot i) = n i)

/-- The canonical surjection `L̃(Λ) → L(Λ)`, for `nᵢ = ⟨Λ, αᵢ^∨⟩`. -/
def toIrreducibleModule : FPowQuotient P Λ n →ₗ⁅K,P.KacMoodyAlgebra⁆ IrreducibleModule P Λ :=
  LieSubmodule.Quotient.lift _ (LieSubmodule.Quotient.mk' _) (by
    rw [LieSubmodule.Quotient.mk'_ker]
    exact VermaModule.fPowSubmodule_le_maxSubmodule P Λ hA hn)

@[simp] lemma toIrreducibleModule_hwv :
    toIrreducibleModule P hA hn (hwv P Λ n) = IrreducibleModule.hwv P Λ :=
  rfl

theorem toIrreducibleModule_surjective : Function.Surjective (toIrreducibleModule P hA hn) :=
  LieSubmodule.Quotient.lift_surjective _ _ _ (LieSubmodule.Quotient.surjective_mk' _)

include hn in
/-- The highest-weight vector of `L̃(Λ)` is nonzero, for `nᵢ = ⟨Λ, αᵢ^∨⟩`. -/
theorem hwv_ne_zero : hwv P Λ n ≠ 0 := fun h0 ↦
  IrreducibleModule.hwv_ne_zero P Λ (by rw [← toIrreducibleModule_hwv P hA hn, h0, map_zero])

end FPowQuotient

namespace IrreducibleModule

variable [CharZero K] (hA : A.IsGeneralizedCartan)
include hA

/-- `L(Λ)` is integrable iff `Λ` is dominant integral ([Kac] Lemma 10.1). -/
theorem isIntegrable_iff {Λ : Dual K H} :
    IsIntegrable P (IrreducibleModule P Λ) ↔ P.IsDominantIntegral Λ := by
  refine ⟨fun hV ↦ isDominantIntegral_of_isIntegrable hA hV (hwv_mem_weightSpace P Λ)
    (fun i ↦ ?_) (hwv_ne_zero P Λ), fun hΛ ↦ ?_⟩
  · rw [hwv, ← LieModuleHom.map_lie, VermaModule.lie_e_hwv, map_zero]
  · refine isIntegrable_of_surjective hA (LieSubmodule.Quotient.mk' _)
      (LieSubmodule.Quotient.surjective_mk' _) fun i ↦ ?_
    obtain ⟨n, hn⟩ := hΛ i
    refine ⟨n + 1, ?_⟩
    rw [toEnd_pow_apply_map, LieSubmodule.Quotient.mk_eq_zero]
    exact VermaModule.fPowHwv_mem_maxSubmodule P Λ hA hn

end IrreducibleModule

end KacMoodyAlgebra

end Matrix.Realization

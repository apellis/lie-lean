import Mathlib.Algebra.Lie.DirectSum
import Mathlib.Algebra.Lie.Quotient
import Mathlib.Algebra.Algebra.Opposite

/-!
# The functor `Hom(Q, −)` for a projective generator

For a Lie module `Q` over a Lie algebra `L` over a commutative ring `R`, let
`E = End_L(Q) = Q →ₗ⁅R,L⁆ Q`, a ring under composition (`LieModuleHom.instRing`, an `R`-algebra).
For every Lie module `M`, `Hom_L(Q, M)` is a right `E`-module, i.e. a module over `Eᵐᵒᵖ`, by
precomposition, and `f : M → N` induces the `Eᵐᵒᵖ`-linear map `LieModuleHom.homMap Q f`
(`φ ↦ f ∘ φ`).

## Main definitions

* `DirectSum.toLieModule`: the morphism `⊕ᵢ Mᵢ → N` of Lie modules defined by morphisms `Mᵢ → N`.
* `LieModuleHom.instRing`, `LieModuleHom.instAlgebra`: the endomorphism ring `End_L(M)`.
* `LieModuleHom.homMap Q f`: `Hom(Q, f) : Hom(Q, M) → Hom(Q, N)`, a map of right `End(Q)`-modules.
* `LieModuleHom.homDirectSumToModule Q x`: the map `Hom(Q, Qⁿ) → X` defined by `x : ι → X`.

## Main results

This file proves the two halves of the Morita-type statement "`Hom(Q, −)` is an equivalence onto
finitely presented right `E`-modules" for any class of modules in which `Q` is projective and
generating, in the following form, which does not need a bundled category:

* `LieModuleHom.homMap_bijective`: if `π : Qⁿ ↠ M` is surjective, every `Q → M` lifts along `π`, and
  `ker π` is generated by images of maps `Q → Qⁿ`, then `f ↦ Hom(Q, f)` is a bijection
  `Hom_L(M, N) → Hom_E(Hom(Q, M), Hom(Q, N))` for every `N` (full faithfulness).
* `LieModuleHom.nonempty_linearEquiv_homMap`: given a right `E`-module `X` with generators
  `x : ι → X` and generators `y : κ → Hom(Q, Qⁱ)` of the kernel of the induced map
  `Hom(Q, Qⁱ) → X`, the cokernel `M` of the corresponding map `Qᵏ → Qⁱ` has
  `Hom(Q, M) ≅ X`, provided `Q` is projective for the two maps `Qⁱ ↠ M`, `Qᵏ ↠ im` involved
  (essential surjectivity).

Here `Qⁿ = ⨁ _ : ι, Q` for a finite type `ι`.

## References

* H. Bass, *Algebraic K-theory*, Benjamin 1968 (the general Morita theorem for abelian categories
  with a projective generator, cited by Humphreys, GSM 94, §3.13, as Thm. II.1.3). The proof here
  is the standard one, by finite presentations and exactness of `Hom(Q, −)`.
-/

noncomputable section

open DirectSum MulOpposite

namespace DirectSum

variable {R ι L N : Type*} [CommRing R] [LieRing L] [LieAlgebra R L] [DecidableEq ι]
  {M : ι → Type*} [∀ i, AddCommGroup (M i)] [∀ i, Module R (M i)]
  [∀ i, LieRingModule L (M i)] [∀ i, LieModule R L (M i)]
  [AddCommGroup N] [Module R N] [LieRingModule L N] [LieModule R L N]

/-- The morphism of Lie modules `⊕ᵢ Mᵢ → N` defined by a family of morphisms `Mᵢ → N`. -/
def toLieModule (φ : ∀ i, M i →ₗ⁅R,L⁆ N) : (⨁ i, M i) →ₗ⁅R,L⁆ N where
  toLinearMap := DirectSum.toModule R ι N fun i ↦ (φ i : M i →ₗ[R] N)
  map_lie' {x m} := by
    let ψ : (⨁ i, M i) →ₗ[R] N := DirectSum.toModule R ι N fun i ↦ (φ i : M i →ₗ[R] N)
    change ψ ⁅x, m⁆ = ⁅x, ψ m⁆
    induction m using DirectSum.induction_on with
    | zero => rw [lie_zero, map_zero, lie_zero]
    | of i m =>
      have : ⁅x, DirectSum.of M i m⁆ = DirectSum.of M i ⁅x, m⁆ :=
        ((DirectSum.lieModuleOf R ι L M i).map_lie x m).symm
      rw [this, ← DirectSum.lof_eq_of R, ← DirectSum.lof_eq_of R, DirectSum.toModule_lof,
        DirectSum.toModule_lof]
      exact LieModuleHom.map_lie _ _ _
    | add m m' hm hm' => rw [lie_add, map_add, map_add, hm, hm', lie_add]

omit [LieAlgebra R L] [∀ i, LieModule R L (M i)] [LieModule R L N] in
@[simp] lemma toLieModule_of (φ : ∀ i, M i →ₗ⁅R,L⁆ N) (i : ι) (m : M i) :
    toLieModule φ (DirectSum.of M i m) = φ i m :=
  DirectSum.toModule_lof (M := M) R i m

omit [LieAlgebra R L] [∀ i, LieModule R L (M i)] [LieModule R L N] in
/-- The image of `⊕ᵢ Mᵢ → N` is the sum of the images of the `Mᵢ → N`. -/
theorem range_toLieModule (φ : ∀ i, M i →ₗ⁅R,L⁆ N) :
    (toLieModule φ).range = ⨆ i, (φ i).range := by
  refine le_antisymm ?_ (iSup_le fun i ↦ ?_)
  · rintro _ ⟨m, rfl⟩
    induction m using DirectSum.induction_on with
    | zero => rw [map_zero]; exact zero_mem _
    | of i m =>
      rw [toLieModule_of]
      exact LieSubmodule.mem_iSup_of_mem i ⟨m, rfl⟩
    | add m m' hm hm' => rw [map_add]; exact add_mem hm hm'
  · rintro _ ⟨m, rfl⟩
    exact ⟨DirectSum.of M i m, toLieModule_of φ i m⟩

end DirectSum

namespace LieModuleHom

variable {R L Q M N : Type*} [CommRing R] [LieRing L] [LieAlgebra R L]
  [AddCommGroup Q] [Module R Q] [LieRingModule L Q] [LieModule R L Q]
  [AddCommGroup M] [Module R M] [LieRingModule L M] [LieModule R L M]
  [AddCommGroup N] [Module R N] [LieRingModule L N] [LieModule R L N]

/-! ### The endomorphism ring -/

instance : Mul (M →ₗ⁅R,L⁆ M) := ⟨comp⟩

omit [LieAlgebra R L] [LieModule R L M] in
lemma mul_def (f g : M →ₗ⁅R,L⁆ M) : f * g = f.comp g := rfl

omit [LieAlgebra R L] [LieModule R L M] in
@[simp] lemma mul_apply (f g : M →ₗ⁅R,L⁆ M) (m : M) : (f * g) m = f (g m) := rfl

instance : NatCast (M →ₗ⁅R,L⁆ M) := ⟨fun n ↦ n • 1⟩

instance : IntCast (M →ₗ⁅R,L⁆ M) := ⟨fun n ↦ n • 1⟩

instance : Pow (M →ₗ⁅R,L⁆ M) ℕ := ⟨fun f n ↦ npowRec n f⟩

omit [LieAlgebra R L] [LieModule R L M] in
lemma coe_pow (f : M →ₗ⁅R,L⁆ M) (n : ℕ) :
    ((f ^ n : M →ₗ⁅R,L⁆ M) : M →ₗ[R] M) = (f : M →ₗ[R] M) ^ n := by
  induction n with
  | zero => rfl
  | succ n ih =>
    change ((npowRec n f * f : M →ₗ⁅R,L⁆ M) : M →ₗ[R] M) = _
    rw [pow_succ, ← ih]
    rfl

/-- The endomorphisms of a Lie module form a ring under composition. -/
instance instRing : Ring (M →ₗ⁅R,L⁆ M) :=
  Function.Injective.ring (fun f : M →ₗ⁅R,L⁆ M ↦ (f : M →ₗ[R] M)) coe_injective_toLinearMap
    rfl rfl (fun _ _ ↦ rfl) (fun _ _ ↦ rfl) (fun _ ↦ rfl) (fun _ _ ↦ rfl)
    (fun _ _ ↦ rfl) (fun _ _ ↦ rfl) coe_pow
    (fun n ↦ LinearMap.ext fun m ↦ by
      change (n • (1 : M →ₗ⁅R,L⁆ M)) m = (n : Module.End R M) m
      simp [Module.End.natCast_apply])
    (fun n ↦ LinearMap.ext fun m ↦ by
      change (n • (1 : M →ₗ⁅R,L⁆ M)) m = (n : Module.End R M) m
      simp [Module.End.intCast_apply])
  where coe_injective_toLinearMap := fun _ _ h ↦ LieModuleHom.ext fun m ↦ LinearMap.congr_fun h m

/-- The endomorphisms of a Lie module form an `R`-algebra. -/
instance instAlgebra : Algebra R (M →ₗ⁅R,L⁆ M) :=
  Algebra.ofModule (fun _ _ _ ↦ rfl) fun r f g ↦ LieModuleHom.ext fun m ↦ map_smul f r (g m)

omit [LieAlgebra R L] [LieModule R L M] in
@[simp] lemma one_apply' (m : M) : (1 : M →ₗ⁅R,L⁆ M) m = m := rfl

/-! ### `Hom(Q, M)` as a right `End(Q)`-module -/

/-- `Hom_L(Q, M)` is a right `End_L(Q)`-module by precomposition. -/
instance : SMul (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Q →ₗ⁅R,L⁆ M) := ⟨fun a φ ↦ φ.comp a.unop⟩

omit [LieAlgebra R L] [LieModule R L Q] [LieModule R L M] in
lemma op_smul_def (a : (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ) (φ : Q →ₗ⁅R,L⁆ M) : a • φ = φ.comp a.unop := rfl

omit [LieAlgebra R L] [LieModule R L Q] [LieModule R L M] in
@[simp] lemma op_smul_apply (a : (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ) (φ : Q →ₗ⁅R,L⁆ M) (q : Q) :
    (a • φ) q = φ (a.unop q) := rfl

instance : Module (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Q →ₗ⁅R,L⁆ M) where
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl
  add_smul _ _ φ := LieModuleHom.ext fun _ ↦ map_add φ _ _
  zero_smul φ := LieModuleHom.ext fun _ ↦ map_zero φ

instance : SMulCommClass R (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Q →ₗ⁅R,L⁆ M) where
  smul_comm _ _ _ := rfl

instance : SMulCommClass (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ R (Q →ₗ⁅R,L⁆ M) where
  smul_comm _ _ _ := rfl

instance : IsScalarTower R (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Q →ₗ⁅R,L⁆ M) where
  smul_assoc r a φ := LieModuleHom.ext fun q ↦ by
    change φ (r • a.unop q) = r • φ (a.unop q)
    exact map_smul φ r _

variable (Q) in
/-- `Hom(Q, f)`: postcomposition with `f : M → N`, a map of right `End(Q)`-modules. -/
def homMap (f : M →ₗ⁅R,L⁆ N) : (Q →ₗ⁅R,L⁆ M) →ₗ[(Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ] (Q →ₗ⁅R,L⁆ N) where
  toFun φ := f.comp φ
  map_add' _ _ := LieModuleHom.ext fun _ ↦ map_add f _ _
  map_smul' _ _ := LieModuleHom.ext fun _ ↦ rfl

omit [LieAlgebra R L] [LieModule R L Q] [LieModule R L M] [LieModule R L N] in
@[simp] lemma homMap_apply (f : M →ₗ⁅R,L⁆ N) (φ : Q →ₗ⁅R,L⁆ M) : homMap Q f φ = f.comp φ := rfl

variable (Q M N) in
/-- `f ↦ Hom(Q, f)` as an `R`-linear map. -/
def homMapₗ : (M →ₗ⁅R,L⁆ N) →ₗ[R] (Q →ₗ⁅R,L⁆ M) →ₗ[(Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ] (Q →ₗ⁅R,L⁆ N) where
  toFun := homMap Q
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [LieModule R L Q] [LieModule R L M] in
@[simp] lemma homMapₗ_apply (f : M →ₗ⁅R,L⁆ N) : homMapₗ Q M N f = homMap Q f := rfl

/-! ### Direct sums `Qⁿ` -/

omit [LieAlgebra R L] [LieModule R L N] in
lemma finsetSum_apply {α X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X]
    (s : Finset α) (f : α → X →ₗ⁅R,L⁆ N) (x : X) : (∑ a ∈ s, f a) x = ∑ a ∈ s, f a x := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert a s ha ih => rw [Finset.sum_insert ha, Finset.sum_insert ha, _root_.add_apply, ih]

section DirectSum

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

omit [LieModule R L Q] in
/-- `Σⱼ ιⱼ ∘ pⱼ ∘ ψ = ψ` for `ψ : X → Qⁿ`. -/
lemma sum_comp_component {X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X]
    [LieModule R L X] (ψ : X →ₗ⁅R,L⁆ ⨁ _ : ι, Q) :
    ∑ j, (lieModuleOf R ι L (fun _ ↦ Q) j).comp
      ((lieModuleComponent R ι L (fun _ ↦ Q) j).comp ψ) = ψ := by
  refine LieModuleHom.ext fun x ↦ ?_
  rw [finsetSum_apply]
  conv_rhs => rw [← DirectSum.sum_univ_of (ψ x)]
  rfl

omit [LieModule R L Q] [LieModule R L N] in
/-- `toLieModule (φⱼ) ∘ ψ = Σⱼ φⱼ ∘ pⱼ ∘ ψ`. -/
lemma toLieModule_comp {X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X]
    [LieModule R L X] (φ : ι → (Q →ₗ⁅R,L⁆ N)) (ψ : X →ₗ⁅R,L⁆ ⨁ _ : ι, Q) :
    (toLieModule φ).comp ψ =
      ∑ j, (φ j).comp ((lieModuleComponent R ι L (fun _ ↦ Q) j).comp ψ) := by
  conv_lhs => rw [← sum_comp_component ψ]
  refine LieModuleHom.ext fun x ↦ ?_
  simp only [LieModuleHom.comp_apply, finsetSum_apply, map_sum]
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  exact toLieModule_of φ j _

omit [LieModule R L M] in
/-- Over `End(Q)`, `π ∘ ψ = Σⱼ (pⱼ ∘ ψ) · (π ∘ ιⱼ)` for `π : Qⁿ → M`, `ψ : Q → Qⁿ`. -/
lemma comp_eq_sum_smul (π : (⨁ _ : ι, Q) →ₗ⁅R,L⁆ M) (ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q) :
    π.comp ψ = ∑ j, op ((lieModuleComponent R ι L (fun _ ↦ Q) j).comp ψ) •
      π.comp (lieModuleOf R ι L (fun _ ↦ Q) j) := by
  conv_lhs => rw [← sum_comp_component ψ]
  refine LieModuleHom.ext fun x ↦ ?_
  simp only [LieModuleHom.comp_apply, finsetSum_apply, map_sum,
    op_smul_apply, unop_op]

end DirectSum

/-! ### A lifting lemma -/

/-- A morphism `h : X → N` vanishing on the kernel of a surjection `π : X → M` factors through
`π`. -/
def liftOfSurjective {X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X]
    [LieModule R L X] (π : X →ₗ⁅R,L⁆ M) (hπ : Function.Surjective π) (h : X →ₗ⁅R,L⁆ N)
    (hle : π.ker ≤ h.ker) : M →ₗ⁅R,L⁆ N :=
  have key : ∀ x y, π x = π y → h x = h y := fun x y hxy ↦ by
    have : x - y ∈ π.ker := by rw [LieModuleHom.mem_ker, map_sub, hxy, sub_self]
    have := LieModuleHom.mem_ker.1 (hle this)
    rwa [map_sub, sub_eq_zero] at this
  { toFun := fun m ↦ h (hπ m).choose
    map_add' := fun m m' ↦ by
      rw [← map_add]
      exact key _ _ (by rw [map_add, (hπ m).choose_spec, (hπ m').choose_spec,
        (hπ (m + m')).choose_spec])
    map_smul' := fun r m ↦ by
      rw [RingHom.id_apply, ← map_smul]
      exact key _ _ (by rw [map_smul, (hπ m).choose_spec, (hπ (r • m)).choose_spec])
    map_lie' := fun {y m} ↦ by
      rw [← LieModuleHom.map_lie]
      exact key _ _ (by rw [LieModuleHom.map_lie, (hπ m).choose_spec, (hπ ⁅y, m⁆).choose_spec]) }

omit [LieModule R L M] [LieModule R L N] in
lemma liftOfSurjective_comp {X : Type*} [AddCommGroup X] [Module R X] [LieRingModule L X]
    [LieModule R L X] (π : X →ₗ⁅R,L⁆ M) (hπ : Function.Surjective π) (h : X →ₗ⁅R,L⁆ N)
    (hle : π.ker ≤ h.ker) : (liftOfSurjective π hπ h hle).comp π = h := by
  refine LieModuleHom.ext fun x ↦ ?_
  change h (hπ (π x)).choose = h x
  have : (hπ (π x)).choose - x ∈ π.ker := by
    rw [LieModuleHom.mem_ker, map_sub, (hπ (π x)).choose_spec, sub_self]
  have := LieModuleHom.mem_ker.1 (hle this)
  rwa [map_sub, sub_eq_zero] at this

/-! ### Full faithfulness -/

section Presentation

variable {ι : Type*} [Finite ι] (π : (⨁ _ : ι, Q) →ₗ⁅R,L⁆ M)

omit [LieAlgebra R L] [LieModule R L Q] [LieModule R L M] [LieModule R L N] [Finite ι] in
/-- `Hom(Q, −)` is faithful on modules that are quotients of some `Qⁿ`. -/
theorem homMap_injective (hπ : Function.Surjective π) :
    Function.Injective (homMap (R := R) (L := L) (M := M) (N := N) Q) := by
  classical
  intro f g hfg
  refine LieModuleHom.ext fun m ↦ ?_
  obtain ⟨x, rfl⟩ := hπ m
  induction x using DirectSum.induction_on with
  | zero => simp only [map_zero]
  | of j q =>
    exact LieModuleHom.congr_fun
      (LinearMap.congr_fun hfg (π.comp (lieModuleOf R ι L (fun _ ↦ Q) j))) q
  | add x y hx hy => rw [map_add, map_add, map_add, hx, hy]

omit [LieModule R L M] [LieModule R L N] in
/-- `Hom(Q, −)` is full on modules with a presentation by copies of `Q`: if `π : Qⁿ ↠ M`, every
`Q → M` lifts along `π`, and `ker π` is generated by images of maps `Q → Qⁿ`, then every map of
right `End(Q)`-modules `Hom(Q, M) → Hom(Q, N)` is `Hom(Q, f)` for some `f : M → N`. -/
theorem homMap_surjective (hπ : Function.Surjective π)
    (hlift : ∀ φ : Q →ₗ⁅R,L⁆ M, ∃ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q, π.comp ψ = φ)
    (hker : π.ker ≤ ⨆ (ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q) (_ : π.comp ψ = 0), ψ.range) :
    Function.Surjective (homMap (R := R) (L := L) (M := M) (N := N) Q) := by
  classical
  have := Fintype.ofFinite ι
  intro g
  set h := toLieModule fun j ↦ g (π.comp (lieModuleOf R ι L (fun _ ↦ Q) j))
  have hcomp : ∀ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q, h.comp ψ = g (π.comp ψ) := by
    intro ψ
    rw [toLieModule_comp, comp_eq_sum_smul π ψ, map_sum]
    exact Finset.sum_congr rfl fun j _ ↦ (g.map_smul _ _).symm
  have hle : π.ker ≤ h.ker := hker.trans (iSup₂_le fun ψ hψ ↦ by
    rintro _ ⟨q, rfl⟩
    rw [LieModuleHom.mem_ker, ← LieModuleHom.comp_apply, hcomp, hψ, map_zero]
    rfl)
  refine ⟨liftOfSurjective π hπ h hle, LinearMap.ext fun φ ↦ ?_⟩
  obtain ⟨ψ, rfl⟩ := hlift φ
  change ((liftOfSurjective π hπ h hle).comp π).comp ψ = g (π.comp ψ)
  rw [liftOfSurjective_comp, hcomp]

omit [LieModule R L M] [LieModule R L N] in
/-- **Full faithfulness of `Hom(Q, −)`** on modules with a presentation by copies of `Q`. -/
theorem homMap_bijective (hπ : Function.Surjective π)
    (hlift : ∀ φ : Q →ₗ⁅R,L⁆ M, ∃ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q, π.comp ψ = φ)
    (hker : π.ker ≤ ⨆ (ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q) (_ : π.comp ψ = 0), ψ.range) :
    Function.Bijective (homMap (R := R) (L := L) (M := M) (N := N) Q) :=
  ⟨homMap_injective π hπ, homMap_surjective π hπ hlift hker⟩

/-- Under the hypotheses of `homMap_bijective`, `f ↦ Hom(Q, f)` as an `R`-linear equivalence. -/
noncomputable def homMapEquiv (hπ : Function.Surjective π)
    (hlift : ∀ φ : Q →ₗ⁅R,L⁆ M, ∃ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q, π.comp ψ = φ)
    (hker : π.ker ≤ ⨆ (ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q) (_ : π.comp ψ = 0), ψ.range) :
    (M →ₗ⁅R,L⁆ N) ≃ₗ[R] ((Q →ₗ⁅R,L⁆ M) →ₗ[(Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ] (Q →ₗ⁅R,L⁆ N)) :=
  LinearEquiv.ofBijective (homMapₗ Q M N) (homMap_bijective π hπ hlift hker)

end Presentation

/-! ### Essential surjectivity -/

section Cokernel

variable {ι κ : Type*} [Fintype ι] [Finite κ] [DecidableEq κ]
  {X : Type*} [AddCommGroup X] [Module (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ X]

variable (Q) in
/-- The map `Hom(Q, Qⁱ) → X`, `φ ↦ Σⱼ (pⱼ ∘ φ) · xⱼ`, attached to elements `xⱼ` of a right
`End(Q)`-module. -/
def homDirectSumToModule (x : ι → X) :
    (Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q) →ₗ[(Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ] X where
  toFun φ := ∑ j, op ((lieModuleComponent R ι L (fun _ ↦ Q) j).comp φ) • x j
  map_add' φ φ' := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [← add_smul, ← op_add]
    rfl
  map_smul' a φ := by
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [RingHom.id_apply, smul_smul]
    rfl

omit [LieAlgebra R L] [LieModule R L Q] in
lemma homDirectSumToModule_lieModuleOf [DecidableEq ι] (x : ι → X) (j : ι) :
    homDirectSumToModule Q x (lieModuleOf R ι L (fun _ ↦ Q) j) = x j := by
  simp only [homDirectSumToModule, LinearMap.coe_mk, AddHom.coe_mk]
  rw [Finset.sum_eq_single j]
  · have h1 : (lieModuleComponent R ι L (fun _ ↦ Q) j).comp (lieModuleOf R ι L (fun _ ↦ Q) j) =
        1 := LieModuleHom.ext fun q ↦ DirectSum.of_eq_same _ _
    rw [h1, op_one, one_smul]
  · intro l _ hl
    have : (lieModuleComponent R ι L (fun _ ↦ Q) l).comp (lieModuleOf R ι L (fun _ ↦ Q) j) = 0 :=
      LieModuleHom.ext fun q ↦ DirectSum.of_eq_of_ne _ _ _ hl
    rw [this, op_zero, zero_smul]
  · simp

omit [LieAlgebra R L] [LieModule R L Q] in
lemma surjective_homDirectSumToModule {x : ι → X}
    (hx : Submodule.span (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Set.range x) = ⊤) :
    Function.Surjective (homDirectSumToModule (R := R) (L := L) Q x) := by
  classical
  rw [← LinearMap.range_eq_top, eq_top_iff, ← hx, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  exact ⟨_, homDirectSumToModule_lieModuleOf x j⟩

omit [Fintype ι] in
/-- `Hom(Q, α)` for `α = toLieModule y : Qᵏ → Qⁱ` has range the span of the `y k`. -/
lemma range_homMap_toLieModule (y : κ → (Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q)) :
    LinearMap.range (homMap Q (toLieModule y)) =
      Submodule.span (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Set.range y) := by
  have := Fintype.ofFinite κ
  apply le_antisymm
  · rintro _ ⟨ψ, rfl⟩
    rw [homMap_apply, toLieModule_comp]
    exact Submodule.sum_mem _ fun k _ ↦ Submodule.smul_mem _
      (op ((lieModuleComponent R κ L (fun _ ↦ Q) k).comp ψ)) (Submodule.subset_span ⟨k, rfl⟩)
  · rw [Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    exact ⟨lieModuleOf R κ L (fun _ ↦ Q) k, LieModuleHom.ext fun q ↦ toLieModule_of y k q⟩

/-- **Essential surjectivity of `Hom(Q, −)`.** Let `X` be a right `End(Q)`-module generated by
`x : ι → X`, and let `y : κ → Hom(Q, Qⁱ)` generate the kernel of `φ ↦ Σⱼ (pⱼ ∘ φ) · xⱼ`. Let
`α : Qᵏ → Qⁱ` be the map with components `y`, and `M = Qⁱ / im α`. If every `Q → M` lifts to `Qⁱ`
and every `Q → im α` lifts to `Qᵏ`, then `Hom(Q, M) ≅ X` as right `End(Q)`-modules. -/
theorem nonempty_linearEquiv_homMap (x : ι → X)
    (hx : Submodule.span (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Set.range x) = ⊤)
    (y : κ → (Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q))
    (hy : Submodule.span (Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ (Set.range y) =
      LinearMap.ker (homDirectSumToModule Q x))
    (hliftM : ∀ φ : Q →ₗ⁅R,L⁆ (⨁ _ : ι, Q) ⧸ (toLieModule y).range,
      ∃ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : ι, Q,
        (LieSubmodule.Quotient.mk' (toLieModule y).range).comp ψ = φ)
    (hliftα : ∀ φ : Q →ₗ⁅R,L⁆ (toLieModule y).range,
      ∃ ψ : Q →ₗ⁅R,L⁆ ⨁ _ : κ, Q, (LieModuleHom.codRestrict (toLieModule y).range (toLieModule y)
        fun m ↦ ⟨m, rfl⟩).comp ψ = φ) :
    Nonempty (X ≃ₗ[(Q →ₗ⁅R,L⁆ Q)ᵐᵒᵖ]
      (Q →ₗ⁅R,L⁆ (⨁ _ : ι, Q) ⧸ (toLieModule y).range)) := by
  set α := toLieModule y
  set mk := LieSubmodule.Quotient.mk' α.range
  set Φ := homMap Q mk
  have hΦ : Function.Surjective Φ := fun φ ↦ hliftM φ
  have hker : LinearMap.ker Φ = LinearMap.ker (homDirectSumToModule Q x) := by
    rw [← hy, ← range_homMap_toLieModule]
    apply le_antisymm
    · intro φ hφ
      have hle : ∀ q, φ q ∈ α.range := fun q ↦ by
        have := LieModuleHom.congr_fun (LinearMap.mem_ker.1 hφ) q
        rwa [homMap_apply, LieModuleHom.comp_apply, _root_.zero_apply,
          LieSubmodule.Quotient.mk'_apply, LieSubmodule.Quotient.mk_eq_zero'] at this
      obtain ⟨ψ, hψ⟩ := hliftα (LieModuleHom.codRestrict α.range φ hle)
      refine ⟨ψ, LieModuleHom.ext fun q ↦ ?_⟩
      have := congrArg Subtype.val (LieModuleHom.congr_fun hψ q)
      exact this
    · rintro _ ⟨ψ, rfl⟩
      refine LinearMap.mem_ker.2 (LieModuleHom.ext fun q ↦ ?_)
      rw [homMap_apply, homMap_apply, LieModuleHom.comp_apply, _root_.zero_apply,
        LieSubmodule.Quotient.mk'_apply, LieSubmodule.Quotient.mk_eq_zero']
      exact ⟨ψ q, rfl⟩
  exact ⟨((homDirectSumToModule Q x).quotKerEquivOfSurjective
    (surjective_homDirectSumToModule hx)).symm.trans
      ((Submodule.quotEquivOfEq _ _ hker.symm).trans (Φ.quotKerEquivOfSurjective hΦ))⟩

end Cokernel

end LieModuleHom

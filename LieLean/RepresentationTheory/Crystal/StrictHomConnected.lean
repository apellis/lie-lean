import LieLean.RepresentationTheory.Crystal.Path.Isomorphism

/-!
# Strict morphisms out of highest weight crystals

Hong–Kang, GSM 42, Proposition 4.5.8: a strict crystal morphism `Ψ : B(λ) → B` into a connected
crystal `B`, with `Ψ(B(λ)) ⊆ B`, is an isomorphism. The only properties of `B(λ)` used are that
it is generated by a highest weight element `u_λ` (every element is `f̃_{i₁} ⋯ f̃_{iₖ} u_λ`), so
the statement is proved for every such crystal. For the crystal of the crystal base of `L_q(λ)`
see `LieLean.QuantumGroup.GrandLoop.crystalHW_strictHom_bijective`.

In the library a strict morphism `Crystal.StrictHom` is a map `B₁ → B₂` (so the condition
`Ψ(B(λ)) ⊆ B` is built in) commuting with weights, `εᵢ`, `ẽᵢ` and `f̃ᵢ`; by
`Crystal.φ_eq` it also preserves `φᵢ`.

## Main results

* `Crystal.StrictHom.injective_of_fWord`: a strict morphism out of a crystal generated by a
  highest weight element is injective.
* `Crystal.StrictHom.bijective_of_fWord`: **Proposition 4.5.8**, as bijectivity.
* `Crystal.StrictHom.equivOfFWord`: the resulting isomorphism of crystals.

## References

* J. Hong, S.-J. Kang, *Introduction to quantum groups and crystal bases*, GSM 42, AMS 2002,
  Proposition 4.5.8.
-/

namespace Crystal

variable {ι X : Type*} [AddCommGroup X] {D : CartanDatum ι X} {B₁ B₂ : Type*}
  {C₁ : Crystal D B₁} {C₂ : Crystal D B₂}

namespace StrictHom

variable (ψ : StrictHom C₁ C₂) {b₀ : B₁}

/-- A strict morphism out of a crystal generated by a highest weight element `b₀` is injective.
If `ψ b = ψ b'` with `b = f̃ᵢ c`, then `ẽᵢ ψ b' = ψ c`, so `b' = f̃ᵢ c'` with `ψ c' = ψ c`;
induct on a word for `b`. -/
theorem injective_of_fWord (hb₀ : C₁.IsHighestWeight b₀)
    (hgen : ∀ b, ∃ l, C₁.fWord l b₀ = some b) : Function.Injective ψ := by
  intro a a' haa
  obtain ⟨l, hl⟩ := hgen a
  induction l generalizing a a' with
  | nil =>
    obtain rfl : a = b₀ := (Option.some_injective _ hl).symm
    have ha' : C₁.IsHighestWeight a' :=
      ψ.isHighestWeight_apply_iff.mp (haa ▸ ψ.isHighestWeight_apply_iff.mpr hb₀)
    exact (eq_of_isHighestWeight (hgen a') ha').symm
  | cons i l ih =>
    rw [fWord_cons] at hl
    obtain ⟨c, hc, hfc⟩ := Option.bind_eq_some_iff.mp hl
    have hec : C₁.e i a = some c := (C₁.f_eq_some_iff i c a).mp hfc
    have h1 : C₂.e i (ψ a') = some (ψ c) := by rw [← haa, ψ.e_apply, hec, Option.map_some]
    rw [ψ.e_apply] at h1
    obtain ⟨c', hc', hcc⟩ := Option.map_eq_some_iff.mp h1
    obtain rfl := ih hcc.symm hc
    exact C₁.e_injective hec hc'

/-- **Hong–Kang, Proposition 4.5.8.** A strict morphism from a crystal generated by a highest
weight element (such as the crystal `B(λ)` of `L_q(λ)`) to a connected crystal is bijective. -/
theorem bijective_of_fWord (hb₀ : C₁.IsHighestWeight b₀)
    (hgen : ∀ b, ∃ l, C₁.fWord l b₀ = some b) (hconn : ∀ x : B₂, C₂.closure {x} = Set.univ) :
    Function.Bijective ψ := by
  refine ⟨ψ.injective_of_fWord hb₀ hgen, fun y ↦ ?_⟩
  have hy : y ∈ Set.range ψ := by
    rw [ψ.range_eq_closure hgen, hconn]
    trivial
  exact hy

/-- The isomorphism of crystals given by Proposition 4.5.8. -/
noncomputable def equivOfFWord (hb₀ : C₁.IsHighestWeight b₀)
    (hgen : ∀ b, ∃ l, C₁.fWord l b₀ = some b) (hconn : ∀ x : B₂, C₂.closure {x} = Set.univ) :
    Crystal.Equiv C₁ C₂ where
  toEquiv := _root_.Equiv.ofBijective ψ (ψ.bijective_of_fWord hb₀ hgen hconn)
  wt_map := ψ.wt_map
  ε_map := ψ.ε_map
  e_map := ψ.e_map
  f_map := ψ.f_map

@[simp] lemma coe_equivOfFWord (hb₀ : C₁.IsHighestWeight b₀)
    (hgen : ∀ b, ∃ l, C₁.fWord l b₀ = some b) (hconn : ∀ x : B₂, C₂.closure {x} = Set.univ)
    (b : B₁) : ψ.equivOfFWord hb₀ hgen hconn b = ψ b := rfl

end StrictHom

end Crystal
